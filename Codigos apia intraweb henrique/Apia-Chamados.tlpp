#include "PROTHEUS.CH"
#include "TOPCONN.CH"
#include "TOTVS.CH"
#include "tlpp-core.th"
#INCLUDE 'tlpp-rest.th'

////////////////////////////////////////////////////////////////////////////////
// Apia-Chamados.tlpp (ex POUICNSA001.prw)
// API REST do portal PO-UI de Chamados (pouichamados) - espelha CNSA001.PRW
// (tela classica). Migrado de WSRESTFUL/WSMETHOD pra anotacoes TLPP (@Get/
// @Post) - mesmas URLs, mesmos verbos, mesmos parametros via querystring de
// sempre (zero mudanca de contrato pro front). Logica interna de todos os
// endpoints continua 100% igual a antes (mesmas Static Function CNSA_XXX que
// ja devolviam {nStatusHttp, cCorpoJson} - so o wrapper de rota mudou de
// WSRESTFUL/WSMETHOD/WSDATA/WSRECEIVE pra @Get/@Post + oRest).
//
// CNSACHAMADOS (listagem) consulta a ZA1 direto via BeginSql (Posicione pra
// enriquecer tecnico/cliente/projeto/tarefa) - nao usa mais o FwModel remoto
// (FWRest():New(CNSA_FWMODEL_HOST)/ZA1_PATH/ZA1_ID). Decisao consciente
// (Henrique): essa origem de dados nao deve mais ser usada.
// "oRest" e o nome reservado do objeto global do motor TLPP REST
// (oRest:getQueryRequest()/oRest:setStatusResponse()) - mantido o nome
// original em todas as outras rotinas (CNSA_TOKEN, CNSA_GERACHAM,
// CNSA_MARCARLIDO, CNSA_ENVIAEMAIL), que sao Static Function comuns (Local


////////////////////////////////////////////////////////////////////////////////
// LISTAGEM / VISUALIZAR / PESQUISAR
////////////////////////////////////////////////////////////////////////////////
@Get(endpoint="/CNSACHAMADOS")
User Function CNSA_CHAMADOS_LISTAR() As Logical
    Local jQuery           := oRest:getQueryRequest() As Json
    Local oJson            := JsonObject():New()
    Local aRetorno         := {}
    Local aTodos           := {}
    Local aFiltrado        := {}
    Local oLinha           := Nil
    Local cAlias           := GetNextAlias()
    Local nPagina          := 1
    Local nTamanho         := 10
    Local nStartIdx        := 1
    Local nTotal           := 0
    Local nI               := 0
    Local nMeuParam        := 0
    Local nSemRespParam    := 0
    Local cStatusParam     := ""
    Local cIdChParam       := ""
    Local cTextoParam      := ""
    Local cConsultorSessao := ""
    Local aCacheTec        := {}
    Local aCacheCli        := {}
    Local nPosCache        := 0
    Local cCodConsul       := ""
    Local cCodCli          := ""
    Local cLoja            := ""
    Local cNomeTec         := ""
    Local cNomeCli         := ""
    // FIX (Projeto/Tarefa "sumindo" toda vez que abre Editar): a listagem so
    // devolvia idCh/assunto/status/tecnico/cliente/data - nunca os codigos de
    // tipo/projeto/tarefa/email/cliente. O front (abrirEditar) sempre abria
    // esses campos em branco, e como Tarefa exige Projeto selecionado e
    // Projeto exige Cliente selecionado (cascata da lupa), o usuario era
    // obrigado a reselecionar Cliente -> Projeto -> Tarefa do zero em TODA
    // edicao, mesmo pra corrigir so o assunto. Mesma familia do bug ja
    // corrigido pra codConsultor - agora fechando os campos que faltavam.
    Local cTipo            := ""
    Local cProjeto         := ""
    Local cTarefa          := ""
    Local cEmailCli        := ""
    Local cNomeProj        := ""
    Local cNomeTaf         := ""
    Local aCacheProj       := {}
    Local aCacheTaf        := {}
    Local oErro            := Nil
    Local aStatusLista     := {}
    Local nAnoParam        := 0
    Local nMesParam        := 0
    Local dIni             := CToD("")
    Local dFimExclusivo    := CToD("")
    Local nMesFimCalc      := 0
    Local nAnoFimCalc      := 0
    // Flags/valores efetivos da consulta SQL - cada filtro opcional vira um
    // par (flag numerica "ativo" + valor), e a condicao no WHERE e sempre
    // "(%Exp:flag% <> 1 OR <comparacao com o valor>)" - assim o no-op depende
    // so da flag numerica (0/1), nunca de "string vazia == NULL" (truque que
    // so funciona em Oracle, quebra em outros bancos). Prioridade de sempre:
    // idCh > texto > (meus/semResponsavel/status/ano-mes combinados por AND).
    Local lTemIdCh         := .F.
    Local lTemTexto        := .F.
    Local lOutros          := .F.
    Local nIdChAtivo       := 0
    Local nTextoAtivo      := 0
    Local nConsulAtivo     := 0
    Local cIdChFiltro      := ""
    Local cTextoFiltro     := ""
    Local cConsulFiltro    := ""
    Local nSemRespFiltro   := 0
    Local nTemPeriodo      := 0
    Local dIniFiltro       := CToD("01/01/2000")
    Local dFimFiltro       := CToD("01/01/2000")
    Local cStatusCsv       := ""
    Local nMinRow          := 0
    Local nMaxRow          := 0
    Local nTotalSql        := 0

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    Begin Sequence

        nPagina       := CNSA_JSONNUM(jQuery, "pagina")
        nPagina       := If(nPagina < 1, 1, nPagina)
        nTamanho      := CNSA_JSONNUM(jQuery, "tamanho")
        nTamanho      := If(nTamanho < 1 .Or. nTamanho > 100, 10, nTamanho)
        nStartIdx     := (nPagina - 1) * nTamanho + 1
        nMeuParam     := CNSA_JSONNUM(jQuery, "meus")
        nSemRespParam := CNSA_JSONNUM(jQuery, "semResponsavel")
        cStatusParam  := AllTrim(CNSA_JSONSTR(jQuery,"status"))
        cIdChParam    := AllTrim(CNSA_JSONSTR(jQuery,"idCh"))
        nAnoParam     := CNSA_JSONNUM(jQuery, "ano")
        nMesParam     := CNSA_JSONNUM(jQuery, "mes")
        // FIX (busca por assunto acentuado nao batia): DecodeUTF8 no texto
        // da pesquisa livre antes de montar o LIKE.
        cTextoParam   := DecodeUTF8(AllTrim(CNSA_JSONSTR(jQuery,"texto")))

        If nMeuParam == 1
            cConsultorSessao := Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC")
        EndIf

        lTemIdCh  := !Empty(cIdChParam)
        lTemTexto := !lTemIdCh .And. !Empty(cTextoParam)
        lOutros   := !lTemIdCh .And. !lTemTexto

        nIdChAtivo    := If(lTemIdCh, 1, 0)
        cIdChFiltro   := If(lTemIdCh, cIdChParam, "")
        nTextoAtivo   := If(lTemTexto, 1, 0)
        cTextoFiltro  := If(lTemTexto, "%" + Upper(cTextoParam) + "%", "")
        nConsulAtivo  := If(lOutros .And. nMeuParam == 1 .And. !Empty(cConsultorSessao), 1, 0)
        cConsulFiltro := If(nConsulAtivo == 1, cConsultorSessao, "")
        nSemRespFiltro := If(lOutros .And. nSemRespParam == 1, 1, 0)
        // FIX: cada categoria de filtro (meus / semResponsavel / status) e uma
        // condicao PROPRIA, todas unidas por AND - so o OR acontece DENTRO da
        // lista de status (ex: "2,3"), aplicado em memoria apos o fetch (ver
        // abaixo). Antes (via FwModel remoto), tudo virava OR entre si, o que
        // fazia "meus=1&status=2" devolver TODOS os chamados com status 2 de
        // QUALQUER tecnico, em vez de somente os do tecnico logado.
        cStatusCsv := If(lOutros, cStatusParam, "")

        // Filtro por mes/ano (ZA1_DATA) - mesmo padrao do ano/mes que
        // CNSAAGENDAMENTOS ja usa pra Z6_DTAGE. So filtra se ano E mes
        // vierem preenchidos (mes sem ano ou vice-versa e ignorado).
        If lOutros .And. nAnoParam > 0 .And. nMesParam >= 1 .And. nMesParam <= 12
            dIni        := StoD(StrZero(nAnoParam,4) + StrZero(nMesParam,2) + "01")
            nMesFimCalc := nMesParam + 1
            nAnoFimCalc := nAnoParam
            If nMesFimCalc > 12
                nMesFimCalc := 1
                nAnoFimCalc++
            EndIf
            dFimExclusivo := StoD(StrZero(nAnoFimCalc,4) + StrZero(nMesFimCalc,2) + "01")
            nTemPeriodo   := 1
            dIniFiltro    := dIni
            dFimFiltro    := dFimExclusivo - 1
        EndIf
        // Sem ano/mes informado (Henrique, 2026-08-14): SEM filtro de data
        // nenhum, traz todos os chamados que existirem - nTemPeriodo fica 0
        // e o BETWEEN vira no-op no WHERE.

        // FIX (timeout/lentidao extrema, mesmo problema do Apia-OS.tlpp):
        // sem paginacao real, o SELECT varria a ZA1 inteira em cada request.
        // Paginacao real agora via ROWNUM (Oracle) - so busca no banco as
        // linhas da pagina pedida. Excecao: filtro de status (lista OR, so
        // da pra aplicar em memoria - ver bloco abaixo) busca tudo primeiro.
        If Empty(cStatusCsv)
            nMinRow := nStartIdx - 1
            nMaxRow := nStartIdx + nTamanho - 1
        Else
            nMinRow := 0
            nMaxRow := 999999999
        EndIf

        // Direto na ZA1 (sem mais depender do FwModel remoto - decisao do
        // Henrique/chefe: essa origem de dados nao deve mais ser usada).
        // %Exp: e bind de parametro de verdade (sem risco de injecao), entao
        // o texto livre nao precisa mais de escape manual de aspas.
        // FIX (total sempre 0 - suposicao anterior estava ERRADA, confirmado
        // via debug): ZA1_FILIAL grava BRANCO de verdade (101 chamados reais
        // com filial "  ") - ZA1 e tabela compartilhada entre filiais, nao
        // exclusiva feito a SZ1 (Apia-OS.tlpp). xFilial("ZA1") retornando
        // branco nesse ambiente ja era o valor CERTO - o "fix" anterior que
        // trocou pra cFilAnt ("01") que zerava a lista, revertido.
        //
        // FIX (pedido Henrique, 2026-08-14, mesmo padrao do Apia-OS.tlpp):
        // filtrando por ano+mes sem achar nenhum chamado no periodo, refaz a
        // MESMA consulta sem o filtro de data (nTemPeriodo:=0) em vez de
        // devolver tela vazia - mantem nMinRow/nMaxRow (paginacao real).
        Do While .T.
            BeginSql Alias cAlias
            SELECT * FROM (
                SELECT ZA1Q.*, ROWNUM AS ZA1_RNUM
                FROM (
                    SELECT ZA1_IDCH, ZA1_ASSUNT, ZA1_STATUS, ZA1_CONSUL, ZA1_CLIENT, ;
                        ZA1_LOJA, ZA1_TIPO, ZA1_PROJ, ZA1_TAREFA, ZA1_EMAIL, ZA1_DATA, ;
                        COUNT(*) OVER() AS ZA1_TOTAL
                    FROM %Table:ZA1% ZA1
                    WHERE ZA1_FILIAL = %xFilial:ZA1%
                      AND %NotDel%
                      AND (%Exp:nIdChAtivo% <> 1 OR ZA1_IDCH = %Exp:cIdChFiltro%)
                      AND (%Exp:nTextoAtivo% <> 1 OR UPPER(ZA1_ASSUNT) LIKE %Exp:cTextoFiltro%)
                      AND (%Exp:nConsulAtivo% <> 1 OR ZA1_CONSUL = %Exp:cConsulFiltro%)
                      AND (%Exp:nSemRespFiltro% <> 1 OR ZA1_CONSUL = ' ')
                      AND (%Exp:nTemPeriodo% <> 1 OR ZA1_DATA BETWEEN %Exp:dIniFiltro% AND %Exp:dFimFiltro%)
                    ORDER BY ZA1_IDCH DESC
                ) ZA1Q
                WHERE ROWNUM <= %Exp:nMaxRow%
            )
            WHERE ZA1_RNUM > %Exp:nMinRow%
        EndSql

        If !(cAlias)->(Eof())
            nTotalSql := (cAlias)->ZA1_TOTAL
        EndIf

        aTodos := {}
        While !(cAlias)->(Eof())
            AAdd(aTodos, {;
                AllTrim((cAlias)->ZA1_IDCH), ;
                AllTrim((cAlias)->ZA1_ASSUNT), ;
                AllTrim((cAlias)->ZA1_STATUS), ;
                AllTrim((cAlias)->ZA1_CONSUL), ;
                AllTrim((cAlias)->ZA1_CLIENT), ;
                AllTrim((cAlias)->ZA1_LOJA), ;
                AllTrim((cAlias)->ZA1_TIPO), ;
                AllTrim((cAlias)->ZA1_PROJ), ;
                AllTrim((cAlias)->ZA1_TAREFA), ;
                AllTrim((cAlias)->ZA1_EMAIL), ;
                (cAlias)->ZA1_DATA ;
            })
            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())

            If nTemPeriodo == 1 .And. nTotalSql == 0
                nTemPeriodo := 0
                aTodos      := {}
                Loop
            EndIf
            Exit
        EndDo

        // Lista de status (OR entre eles) - so entra em jogo no ramo "outros"
        // (idCh/texto tem prioridade e ignoram esse filtro), aplicado em
        // memoria porque e uma lista de tamanho variavel (nao da pra montar
        // IN (...) dinamico numa BeginSql, que e um template fixo).
        If !Empty(cStatusCsv)
            aStatusLista := StrTokArr(cStatusCsv, ",")
            aFiltrado    := {}
            For nI := 1 To Len(aTodos)
                If AScan(aStatusLista, {|x| AllTrim(x) == aTodos[nI][3]}) > 0
                    AAdd(aFiltrado, aTodos[nI])
                EndIf
            Next nI
            aTodos := aFiltrado
            nTotal := Len(aTodos)
        Else
            // Sem filtro de status: aTodos ja e so a pagina (ROWNUM no SQL) -
            // nTotal vem do COUNT(*) OVER() calculado no banco.
            nTotal := nTotalSql
        EndIf

        For nI := If(Empty(cStatusCsv), 1, nStartIdx) To If(Empty(cStatusCsv), Len(aTodos), Min(nStartIdx + nTamanho - 1, nTotal))
            cCodConsul := aTodos[nI][4]
            cCodCli    := aTodos[nI][5]
            cLoja      := aTodos[nI][6]

            nPosCache := AScan(aCacheTec, {|x| x[1] == cCodConsul})
            If nPosCache > 0
                cNomeTec := aCacheTec[nPosCache][2]
            ElseIf Empty(cCodConsul)
                cNomeTec := ""
            Else
                cNomeTec := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cCodConsul, "AA1_NOMTEC"))
                AAdd(aCacheTec, {cCodConsul, cNomeTec})
            EndIf

            nPosCache := AScan(aCacheCli, {|x| x[1] == cCodCli + cLoja})
            If nPosCache > 0
                cNomeCli := aCacheCli[nPosCache][2]
            ElseIf Empty(cCodCli)
                cNomeCli := ""
            Else
                cNomeCli := AllTrim(Posicione("SA1", 1, xFilial("SA1") + cCodCli + cLoja, "A1_NOME"))
                AAdd(aCacheCli, {cCodCli + cLoja, cNomeCli})
            EndIf

            cTipo     := aTodos[nI][7]
            cProjeto  := aTodos[nI][8]
            cTarefa   := aTodos[nI][9]
            cEmailCli := aTodos[nI][10]

            // ASSUNCAO A VALIDAR (Henrique, confere isso): estou usando
            // Posicione("AF8", 1, ...) e Posicione("AF9", 1, ...) assumindo
            // que a Ordem 1 dessas tabelas comeca por FILIAL+PROJETO (AF8) e
            // FILIAL+PROJETO+TAREFA (AF9), igual ja usado em CNSA_ASSUMIR
            // (AF8_FASE via Posicione AF8) e no CNSA_TARLUPA (ComponentesRest.prw,
            // filtra AF9 por AF9_PROJET). Se a ordem for outra, o Posicione so
            // devolve vazio (nao quebra) - nome do projeto/tarefa fica em
            // branco, mas o CODIGO (o que realmente importa pra nao perder
            // o vinculo) continua correto.
            nPosCache := AScan(aCacheProj, {|x| x[1] == cProjeto})
            If nPosCache > 0
                cNomeProj := aCacheProj[nPosCache][2]
            ElseIf Empty(cProjeto)
                cNomeProj := ""
            Else
                cNomeProj := AllTrim(Posicione("AF8", 1, xFilial("AF8") + cProjeto, "AF8_DESCRI"))
                AAdd(aCacheProj, {cProjeto, cNomeProj})
            EndIf

            nPosCache := AScan(aCacheTaf, {|x| x[1] == cProjeto + cTarefa})
            If nPosCache > 0
                cNomeTaf := aCacheTaf[nPosCache][2]
            ElseIf Empty(cTarefa)
                cNomeTaf := ""
            Else
                cNomeTaf := AllTrim(Posicione("AF9", 1, xFilial("AF9") + cProjeto + cTarefa, "AF9_DESCRI"))
                AAdd(aCacheTaf, {cProjeto + cTarefa, cNomeTaf})
            EndIf

            // FIX (acentos virando caractere de substituicao no front):
            // EncodeUtf8 em todo texto livre/nome antes do JSON - o WSRESTFUL
            // classico nao converte ANSI/CP1252 pra UTF-8 sozinho. Codigos
            // puros (idCh, status, codConsultor, codCliente, lojaCliente,
            // tipo, projeto, tarefa, emailCliente, data) nao precisam.
            oLinha := JsonObject():New()
            oLinha['idCh']         := aTodos[nI][1]
            oLinha['assunto']      := EncodeUtf8(aTodos[nI][2])
            oLinha['status']       := aTodos[nI][3]
            oLinha['tecnico']      := EncodeUtf8(cNomeTec)
            oLinha['codConsultor'] := cCodConsul
            oLinha['cliente']      := EncodeUtf8(cNomeCli)
            oLinha['codCliente']   := cCodCli
            oLinha['lojaCliente']  := cLoja
            oLinha['tipo']         := cTipo
            oLinha['projeto']      := cProjeto
            oLinha['nomeProjeto']  := EncodeUtf8(cNomeProj)
            oLinha['tarefa']       := cTarefa
            oLinha['nomeTarefa']   := EncodeUtf8(cNomeTaf)
            oLinha['emailCliente'] := cEmailCli
            // FIX (argument #0 error, expected D->C, function dtos):
            // ZA1_DATA vindo do cursor da consulta paginada (ROWNUM/subquery
            // aninhada) as vezes chega como Character em vez de Date - mesmo
            // problema ja tratado em Apia-OS.tlpp/CNSA_OS_DATA_ISO. DToS() so
            // aceita Date, entao so converte quando realmente for Date.
            oLinha['data']         := CNSA_DATA_ISO_ZA1(If(ValType(aTodos[nI][11]) == "D", DToS(aTodos[nI][11]), cValToChar(aTodos[nI][11])))
            AAdd(aRetorno, oLinha)
        Next nI

        oJson['total']        := nTotal
        oJson['totalPaginas'] := If(nTotal == 0, 0, Ceiling(nTotal / nTamanho))
        oJson['pagina']       := nPagina
        oJson['tamanho']      := nTamanho
        oJson['items']        := aRetorno

        Return oRest:setStatusResponse(200, oJson:ToJson())

    Recover Using oErro
        If oErro != Nil
            Return oRest:setStatusResponse(500, '{"erro":"' + CNSA_JSONESC(EncodeUtf8(oErro:Description)) + '"}')
        EndIf
    End Sequence

Return oRest:setStatusResponse(500, '{"erro":"Erro desconhecido."}')

////////////////////////////////////////////////////////////////////////////////
// ASSUMIR - @Post, mesma URL/querystring de sempre (POST /CNSACHAMADOSASSUMIR
// ?idCh=...). Logica real em CNSA_ASSUMIR, mais abaixo neste arquivo.
////////////////////////////////////////////////////////////////////////////////
@Post(endpoint="/CNSACHAMADOSASSUMIR")
User Function CNSA_CHAMADOS_ASSUMIR() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    aResultado := CNSA_ASSUMIR(AllTrim(CNSA_JSONSTR(jQuery,"idCh")))

Return oRest:setStatusResponse(aResultado[1], aResultado[2])

////////////////////////////////////////////////////////////////////////////////
Static Function CNSA_DATA_ISO_ZA1(cData)
    Local cAno := ""
    Local cMes := ""
    Local cDia := ""

    cData := AllTrim(cData)

    If Len(cData) == 8
        cAno := SubStr(cData, 1, 4)
        cMes := SubStr(cData, 5, 2)
        cDia := SubStr(cData, 7, 2)

        If Val(cMes) >= 1 .And. Val(cMes) <= 12 .And. Val(cDia) >= 1 .And. Val(cDia) <= 31
            Return cAno + "-" + cMes + "-" + cDia
        EndIf
    EndIf

Return ""


////////////////////////////////////////////////////////////////////////////////
Static Function CNSA_URLENC(cTexto)
    Local cRet := ""
    Local nI   := 0
    Local cCh  := ""

    For nI := 1 To Len(cTexto)
        cCh := SubStr(cTexto, nI, 1)
        If (cCh >= "A" .And. cCh <= "Z") .Or. ;
           (cCh >= "a" .And. cCh <= "z") .Or. ;
           (cCh >= "0" .And. cCh <= "9") .Or. ;
           (cCh $ "-_.~")
            cRet += cCh
        Else
            cRet += "%" + CNSA_HEX2(Asc(cCh))
        EndIf
    Next nI
Return cRet

////////////////////////////////////////////////////////////////////////////////
Static Function CNSA_HEX2(nVal)
    Local cHex := "0123456789ABCDEF"
Return SubStr(cHex, Int(nVal/16)+1, 1) + SubStr(cHex, (nVal % 16)+1, 1)

////////////////////////////////////////////////////////////////////////////////
Static Function CNSA_JSONESC(cTexto)
    Local cRet := cTexto
    cRet := StrTran(cRet, '\',  '\\')
    cRet := StrTran(cRet, '"',  '\"')
    cRet := StrTran(cRet, Chr(13)+Chr(10), '\n')
    cRet := StrTran(cRet, Chr(10), '\n')
    cRet := StrTran(cRet, Chr(13), '\n')
    cRet := StrTran(cRet, Chr(9),  '\t')
Return cRet

////////////////////////////////////////////////////////////////////////////////
// Helper compartilhado pelos endpoints @Get/@Post - le um parametro numerico
// da querystring (oRest:getQueryRequest()), mesmo padrao ja usado no
// Apia-OS.tlpp (CNSA002_JSONNUM).
////////////////////////////////////////////////////////////////////////////////
Static Function CNSA_JSONNUM(jDados, cCampo)
    Local xVal := jDados[cCampo]
    If xVal == Nil
        Return 0
    EndIf
Return Val(cValToChar(xVal))

////////////////////////////////////////////////////////////////////////////////
// FIX (total sempre 0 - causa raiz real, mesmo bug do Apia-OS.tlpp):
// CNSA_JSONSTR(jQuery,"campo") devolve a STRING literal "null" quando o
// parametro nao veio na querystring, em vez de string vazia -
// AllTrim(GetJsonText(...)) nunca fica Empty(). Indexacao direta
// jDados[cCampo] (mesmo padrao do CNSA_JSONNUM acima) devolve Nil de
// verdade pra campo ausente - usar sempre isso em vez de GetJsonText().
////////////////////////////////////////////////////////////////////////////////
Static Function CNSA_JSONSTR(jDados, cCampo)
    Local xVal := jDados[cCampo]
    If xVal == Nil .Or. ValType(xVal) != "C"
        Return ""
    EndIf
Return xVal

////////////////////////////////////////////////////////////////////////////////
// EXCLUIR - @Post, mesma URL/querystring de sempre (POST /CNSACHAMADOSEXCLUIR
// ?idCh=...&motivo=...). Logica real em CNSA_EXCLUIR, logo abaixo.
////////////////////////////////////////////////////////////////////////////////
@Post(endpoint="/CNSACHAMADOSEXCLUIR")
User Function CNSA_CHAMADOS_EXCLUIR() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // FIX (motivo com acento - ia corromper o e-mail de cancelamento, ver
    // CNSA_ENVIAEMAIL que faz EncodeUtf8 no corpo inteiro depois): DecodeUTF8
    // aqui deixa o motivo em ANSI igual ao resto do texto antes de montar
    // o corpo do e-mail em CNSA_CANCEL_FRONT.
    aResultado := CNSA_EXCLUIR(AllTrim(CNSA_JSONSTR(jQuery,"idCh")), DecodeUTF8(AllTrim(CNSA_JSONSTR(jQuery,"motivo"))))

Return oRest:setStatusResponse(aResultado[1], aResultado[2])

////////////////////////////////////////////////////////////////////////////////
// Logica real do Excluir - fora do @Post, devolve {nStatusHttp, cCorpoJson}.
//
// Cascata: 1) captura dados antes de apagar, 2) apaga o chamado, 3) remove
// TODOS os agendamentos vinculados na SZ6 (sem confirmacao individual - unica
// diferenca real do CNSA001 original, que perguntava um a um via MsgYesNo;
// numa chamada REST nao ha como perguntar no meio do caminho), 4) se tinha
// tecnico designado, envia e-mail de cancelamento pra ele.
////////////////////////////////////////////////////////////////////////////////
Static Function CNSA_EXCLUIR(cIdCh, cMotivo)
    Local cConsulAnterior  := ""
    Local cClienteAnterior := ""
    Local cLojaAnterior    := ""
    Local cNomeCli         := ""
    Local cNomeTec         := ""
    Local cEmailTec        := ""
    Local cExclPor         := ""
    Local cDataAge         := DToC(Date())
    Local cHmini           := "00:00"
    Local cHmfim           := "00:00"
    Local cCorpo           := ""
    Local cAlias           := ""
    Local nCham            := 0
    Local oJson            := JsonObject():New()
    Local oErro            := Nil

    Begin Sequence

        If Empty(cIdCh)
            Return {400, '{"erro":"Informe o idCh do chamado (?idCh=000031)."}'}
        EndIf

        dbSelectArea("ZA1")
        ZA1->(DbSetOrder(1))
        If !ZA1->(DbSeek(xFilial("ZA1") + cIdCh))
            Return {404, '{"erro":"Chamado nao encontrado."}'}
        EndIf

        cConsulAnterior  := AllTrim(ZA1->ZA1_CONSUL)
        cClienteAnterior := AllTrim(ZA1->ZA1_CLIENT)
        cLojaAnterior    := AllTrim(ZA1->ZA1_LOJA)

        // Motivo so e obrigatorio se tiver tecnico designado (precisa dele
        // pro corpo do e-mail) - sem tecnico, ninguem sera notificado.
        If !Empty(cConsulAnterior) .And. Empty(cMotivo)
            Return {400, '{"erro":"Informe o motivo do cancelamento - obrigatorio quando o chamado tem tecnico designado."}'}
        EndIf

        cExclPor := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_NOMTEC"))
        cNomeCli := AllTrim(Posicione("SA1", 1, xFilial("SA1") + cClienteAnterior + cLojaAnterior, "A1_NOME"))

        // Busca data/horario do agendamento mais recente, so pra contexto do e-mail
        nCham  := Val(cIdCh)
        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT Z6_DTAGE, Z6_HMINI, Z6_HMFIM
            FROM %Table:SZ6% SZ6
            WHERE Z6_FILIAL  = %xFilial:SZ6%
              AND Z6_CHAMADO = %Exp:nCham%
              AND %NotDel%
        EndSql
        If !(cAlias)->(Eof())
            If ValType((cAlias)->Z6_DTAGE) == "D"
                cDataAge := DToC((cAlias)->Z6_DTAGE)
            Else
                cDataAge := AllTrim((cAlias)->Z6_DTAGE)
                If Len(cDataAge) == 8
                    cDataAge := SubStr(cDataAge,7,2) + "/" + SubStr(cDataAge,5,2) + "/" + SubStr(cDataAge,1,4)
                EndIf
            EndIf
            cHmini := AllTrim((cAlias)->Z6_HMINI)
            cHmfim := AllTrim((cAlias)->Z6_HMFIM)
        EndIf
        (cAlias)->(DbCloseArea())

        If Empty(cHmini) ; cHmini := "00:00" ; EndIf
        If Empty(cHmfim) ; cHmfim := "00:00" ; EndIf

        // Apaga o chamado
        RecLock("ZA1", .F.)
            ZA1->(DbDelete())
        ZA1->(MsUnlock())

        // Remove TODOS os agendamentos vinculados (SZ6) - sem confirmacao
        // individual (adaptacao explicada acima)
        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT SZ6.R_E_C_N_O_ RECNO
            FROM %Table:SZ6% SZ6
            WHERE SZ6.Z6_FILIAL  = %xFilial:SZ6%
              AND SZ6.Z6_CHAMADO = %Exp:nCham%
              AND %NotDel%
        EndSql
        dbSelectArea("SZ6")
        While !(cAlias)->(Eof())
            SZ6->(DbGoto((cAlias)->RECNO))
            If !SZ6->(Eof())
                RecLock("SZ6", .F.)
                    SZ6->(DbDelete())
                SZ6->(MsUnlock())
            EndIf
            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())

        // Envia e-mail de cancelamento, so se tinha tecnico designado
        If !Empty(cConsulAnterior)
            cNomeTec  := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cConsulAnterior, "AA1_NOMTEC"))
            cEmailTec := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cConsulAnterior, "AA1_EMAIL"))

            If !Empty(cEmailTec)
                cCorpo := CNSA_CANCEL_FRONT(cNomeCli, cDataAge, cHmini, cHmfim, cIdCh, cMotivo, cExclPor)
                CNSA_ENVIAEMAIL(cEmailTec, "Cancelamento do Chamado " + cIdCh, cCorpo, "apia@apia.com.br")
            Else
                ConOut("CNSA_EXCLUIR: tecnico " + cConsulAnterior + " sem AA1_EMAIL cadastrado - e-mail de cancelamento nao enviado.")
            EndIf
        EndIf

        oJson['sucesso']  := .T.
        oJson['idCh']     := cIdCh
        oJson['mensagem'] := "Chamado excluido com sucesso."

        Return {200, oJson:ToJson()}

    Recover Using oErro
        Return {500, '{"erro":"' + CNSA_JSONESC(EncodeUtf8(oErro:Description)) + '"}'}
    End Sequence

Return {500, '{"erro":"Erro desconhecido."}'}

////////////////////////////////////////////////////////////////////////////////
// Autenticacao Microsoft Graph.
//
// FIX: tenant/client/secret NAO ficam mais hardcoded no fonte (risco de
// vazamento via repositorio/RPO). Seguem o mesmo padrao ja usado pra
// MV_CNSAAUT: parametros de sistema via GETMV. Cadastrar em Configurador:
//   MV_CNSATEN -> Tenant ID do Azure AD
//   MV_CNSACLI -> Client ID do App Registration
//   MV_CNSASEC -> Client Secret do App Registration
////////////////////////////////////////////////////////////////////////////////
Static Function CNSA_TOKEN()
    Local cTenant := AllTrim(GETMV("MV_CNSATEN"))
    Local cClient := AllTrim(GETMV("MV_CNSACLI"))
    Local cSecret := AllTrim(GETMV("MV_CNSASEC"))
    Local oRest, oJson, cBody, cToken := ""

    If Empty(cTenant) .Or. Empty(cClient) .Or. Empty(cSecret)
        ConOut("CNSA_TOKEN: MV_CNSATEN/MV_CNSACLI/MV_CNSASEC nao configurados no Configurador - e-mail nao sera enviado.")
        Return ""
    EndIf

    cBody := "grant_type=client_credentials"
    cBody += "&client_id="     + CNSA_URLENC(cClient)
    cBody += "&client_secret=" + CNSA_URLENC(cSecret)
    cBody += "&scope="         + CNSA_URLENC("https://graph.microsoft.com/.default")

    oRest := FWRest():New("https://login.microsoftonline.com")
    oRest:setPath("/" + cTenant + "/oauth2/v2.0/token")
    oRest:SetPostParams(cBody)
    If !oRest:Post({"Content-Type: application/x-www-form-urlencoded"})
        ConOut("CNSA_TOKEN: falha no POST de token (Azure AD): " + oRest:GetLastError())
        FreeObj(oRest)
        Return ""
    EndIf

    oJson := JsonObject():New()
    If Empty(oJson:FromJson(oRest:GetResult())) .And. ValType(oJson["access_token"]) == "C"
        cToken := oJson["access_token"]
    Else
        ConOut("CNSA_TOKEN: resposta do Azure AD sem access_token: " + oRest:GetResult())
    EndIf
    FreeObj(oJson)
    FreeObj(oRest)
Return cToken

////////////////////////////////////////////////////////////////////////////////
// JOB AGENDADO (Schedule/Agendador de Job do Protheus) - substitui o gatilho
// antigo do CNSA001 (rodava CNSA_GERACHAM toda vez que alguem abria a tela
// classica; aqui nao ha tela sendo aberta, entao precisa de um job de
// verdade). Cadastrar em SIGACFG > Ambiente > Schedule (ou no appserver.ini,
// secao [JOBSCHEDULER], dependendo da versao) apontando pra esta funcao,
// rodando a cada N minutos.
//
// ASSUNCAO A VALIDAR (Henrique, confere isso): estou assumindo que o
// FWRest():Patch() existe nesse build do TOTVS (usado em CNSA_MARCARLIDO
// pra marcar o e-mail como lido no Graph). Se nao existir/nao compilar, me
// avisa que troco pra outra forma de fazer o PATCH.
////////////////////////////////////////////////////////////////////////////////
User Function CNSA_JOB_SINCEMAIL()
    Local nCriados := CNSA_GERACHAM()
    ConOut("CNSA_JOB_SINCEMAIL: " + AllTrim(Str(nCriados)) + " chamado(s) criado(s) a partir de e-mail(s) novo(s) em apia@apia.com.br.")
Return

////////////////////////////////////////////////////////////////////////////////
// FIX PONTUAL (rodar 1 vez, depois apagar): corrige assunto (ZA1) e
// anotacoes (ZA2) dos chamados criados por e-mail ANTES do fix do
// DecodeUTF8 duplicado em CNSA_GERACHAM - texto ja gravado torto no banco
// (ex "NÃƒÂ£o" em vez de "Não"). DecodeUTF8() aplicado repetidamente
// enquanto o texto encolhe: texto ja correto nao muda de tamanho (para
// na 1a volta, no-op), texto corrompido em camadas encolhe a cada volta
// ate estabilizar no texto certo - seguro rodar em cima de registro que
// ja estava certo.
////////////////////////////////////////////////////////////////////////////////
Static Function CNSA_FIXUTF8_LOOP(cTexto)
    Local cAnterior   := ""
    Local cDecodado   := ""
    Local nTentativas := 0

    If Empty(cTexto)
        Return cTexto
    EndIf

    While nTentativas < 5
        cAnterior := cTexto
        cDecodado := DecodeUTF8(cTexto)
        If ValType(cDecodado) != "C" .Or. Empty(cDecodado) .Or. Len(cDecodado) >= Len(cAnterior)
            Exit
        EndIf
        cTexto := cDecodado
        nTentativas++
    EndDo

Return cTexto

@Post(endpoint="/CNSAFIXEMAILUTF8")
User Function CNSA_FIXEMAILUTF8() As Logical
    Local cAlias       := GetNextAlias()
    Local cAliasZA2    := ""
    Local aChamados    := {}
    Local aNotas       := {}
    Local nI           := 0
    Local nJ           := 0
    Local cAssuntoNovo := ""
    Local cDescriNovo  := ""
    Local cDescriEsc   := ""
    Local nFixAssunto  := 0
    Local nFixAnot     := 0
    Local nChamN       := 0
    Local oJson        := JsonObject():New()
    Local oErro        := Nil

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    Begin Sequence

        BeginSql Alias cAlias
            SELECT ZA1_IDCH, ZA1_ASSUNT
            FROM %Table:ZA1% ZA1
            WHERE ZA1_FILIAL = %xFilial:ZA1%
              AND ZA1_MAILID <> ' '
              AND %NotDel%
        EndSql

        While !(cAlias)->(Eof())
            AAdd(aChamados, {AllTrim((cAlias)->ZA1_IDCH), (cAlias)->ZA1_ASSUNT})
            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())

        For nI := 1 To Len(aChamados)
            cAssuntoNovo := CNSA_FIXUTF8_LOOP(aChamados[nI][2])
            If cAssuntoNovo != aChamados[nI][2]
                dbSelectArea("ZA1")
                ZA1->(DbSetOrder(1))
                If ZA1->(DbSeek(xFilial("ZA1") + aChamados[nI][1]))
                    RecLock("ZA1", .F.)
                        ZA1->ZA1_ASSUNT := cAssuntoNovo
                    ZA1->(MsUnlock())
                    nFixAssunto++
                EndIf
            EndIf

            // ZA2 nao tem precedente de DbSetOrder/DbSeek neste arquivo (so
            // BeginSql) - atualiza direto via TCSqlExec pela chave
            // FILIAL+IDCH+IDGRID vinda da propria consulta, sem depender de
            // qual e a ordem real do indice.
            nChamN    := Val(aChamados[nI][1])
            aNotas    := {}
            cAliasZA2 := GetNextAlias()
            BeginSql Alias cAliasZA2
                SELECT ZA2_IDGRID, ZA2_DESCRI
                FROM %Table:ZA2% ZA2
                WHERE ZA2_FILIAL = %xFilial:ZA2%
                  AND ZA2_IDCH   = %Exp:nChamN%
                  AND %NotDel%
            EndSql
            While !(cAliasZA2)->(Eof())
                AAdd(aNotas, {AllTrim((cAliasZA2)->ZA2_IDGRID), (cAliasZA2)->ZA2_DESCRI})
                (cAliasZA2)->(DbSkip())
            EndDo
            (cAliasZA2)->(DbCloseArea())

            For nJ := 1 To Len(aNotas)
                cDescriNovo := CNSA_FIXUTF8_LOOP(aNotas[nJ][2])
                If cDescriNovo != aNotas[nJ][2]
                    cDescriEsc := StrTran(cDescriNovo, "'", "''")
                    TcSqlExec("UPDATE " + RetSqlName("ZA2") + " SET ZA2_DESCRI = '" + cDescriEsc + "'" + ;
                        " WHERE ZA2_FILIAL = '" + xFilial("ZA2") + "'" + ;
                        " AND ZA2_IDCH = " + AllTrim(Str(nChamN)) + ;
                        " AND ZA2_IDGRID = '" + aNotas[nJ][1] + "'" + ;
                        " AND D_E_L_E_T_ = ' '")
                    nFixAnot++
                EndIf
            Next nJ
        Next nI

        oJson['sucesso']         := .T.
        oJson['totalChamados']   := Len(aChamados)
        oJson['assuntosCorrigidos'] := nFixAssunto
        oJson['anotacoesCorrigidas'] := nFixAnot

        Return oRest:setStatusResponse(200, oJson:ToJson())

    Recover Using oErro
        Return oRest:setStatusResponse(500, '{"erro":"' + CNSA_JSONESC(EncodeUtf8(oErro:Description)) + '"}')
    End Sequence

Return oRest:setStatusResponse(500, '{"erro":"Erro desconhecido."}')

////////////////////////////////////////////////////////////////////////////////
// Le a caixa apia@apia.com.br (Graph) e cria um chamado (ZA1) por e-mail nao
// lido ainda nao processado. Porte do CNSA_GERACHAM (CNSA001.PRW), com 1
// diferenca proposital: aqui SEMPRE marca o e-mail como lido no Graph depois
// de decidir o que fazer com ele (criar chamado OU pular por ja existir via
// ZA1_MAILID) - o original nunca fazia isso, entao o filtro isRead=false
// crescia pra sempre e, com mais de 50 nao lidos acumulados, e-mails novos
// podiam nunca ser vistos (o $top=50 sem $orderby nao garante pegar os mais
// recentes primeiro).
////////////////////////////////////////////////////////////////////////////////
Static Function CNSA_GERACHAM()
    Local cToken := CNSA_TOKEN()
    Local oRest, oJson, oArr, oMsg, oFrom, oEnd
    Local cPath, cId, cAssunto, cNome, cEmail, cNewId
    Local nI, nCriados := 0
    Local cDec     := ""
    Local cDecNome := ""
    Local aCliente := {}
    Local cCodCli  := ""
    Local cLojaCli := ""
    Local cCorpo   := ""
    Local oBody    := Nil

    If Empty(cToken)
        Return -1
    EndIf

    cPath := "/v1.0/users/apia@apia.com.br/mailFolders/inbox/messages"
    cPath += "?$filter=isRead%20eq%20false"
    cPath += "&$select=id,subject,from,receivedDateTime,body"
    cPath += "&$orderby=receivedDateTime%20desc"
    cPath += "&$top=50"

    oRest := FWRest():New("https://graph.microsoft.com")
    oRest:setPath(cPath)
    // FIX (pedido - sem o corpo o chamado auto-criado fica inutilizavel, so
    // com o assunto): "Prefer: outlook.body-content-type=text" pede pro
    // Graph devolver body.content ja em TEXTO PURO em vez de HTML - sem essa
    // header viria HTML completo (tags, estilos, assinatura), inviavel pra
    // um campo de anotacao de tamanho limitado.
    If !oRest:Get({"Authorization: Bearer " + cToken, "Accept: application/json", 'Prefer: outlook.body-content-type="text"'})
        ConOut("CNSA_GERACHAM: falha no GET de mensagens (Graph): " + oRest:GetLastError())
        Return -1
    EndIf

    oJson := JsonObject():New()
    If !Empty(oJson:FromJson(oRest:GetResult()))
        ConOut("CNSA_GERACHAM: resposta do Graph invalida: " + oRest:GetResult())
        FreeObj(oJson)
        Return -1
    EndIf

    oArr := oJson:GetJsonObject("value")
    If ValType(oArr) <> "A"
        FreeObj(oJson)
        Return -1
    EndIf

    For nI := 1 To Len(oArr)
        oMsg     := oArr[nI]
        cId      := ""
        cAssunto := "(sem assunto)"
        cNome    := ""
        cEmail   := ""
        cCodCli  := ""
        cLojaCli := ""
        cCorpo   := ""
        oBody    := Nil

        If ValType(oMsg:GetJsonObject("id")) == "C"
            cId := oMsg:GetJsonObject("id")
        EndIf

        If ValType(oMsg:GetJsonObject("subject")) == "C"
            // FIX (assunto/corpo/nome chegando com acento corrompido, tipo
            // "NÃƒÂ£o" em vez de "Não"): JsonObject:FromJson() ja decodifica
            // o UTF-8 do JSON do Graph pra ANSI sozinho - chamar DecodeUTF8()
            // de novo em cima de texto que ja esta em ANSI trata os bytes
            // ANSI como se ainda fossem UTF-8, corrompendo o acento. Usa o
            // valor direto do JSON, sem decodificar de novo.
            cAssunto := oMsg:GetJsonObject("subject")
            cAssunto := AllTrim(cAssunto)
            While .T.
                If Upper(Left(cAssunto, 4)) == "RES:" .Or. Upper(Left(cAssunto, 4)) == "ENC:" .Or. Upper(Left(cAssunto, 4)) == "FWD:"
                    cAssunto := AllTrim(SubStr(cAssunto, 5))
                ElseIf Upper(Left(cAssunto, 3)) == "RE:" .Or. Upper(Left(cAssunto, 3)) == "FW:"
                    cAssunto := AllTrim(SubStr(cAssunto, 4))
                Else
                    Exit
                EndIf
            EndDo
        EndIf

        // FIX (pedido - capturar o corpo do e-mail, senao o chamado nasce
        // inutilizavel so com o assunto): body.content ja vem em texto puro
        // gracas ao header Prefer acima. DecodeUTF8 mesmo tratamento do
        // assunto/nome. Truncado em CNSA_ZA2_GRAVAR/TamSX3 mais abaixo.
        oBody := oMsg:GetJsonObject("body")
        If ValType(oBody) $ "O|J" .And. ValType(oBody:GetJsonObject("content")) == "C"
            cCorpo := oBody:GetJsonObject("content")
            cDec   := DecodeUTF8(cCorpo)
            If ValType(cDec) == "C" .And. !Empty(cDec)
                cCorpo := cDec
            EndIf
            cCorpo := AllTrim(cCorpo)
        EndIf

        oFrom := Nil
        oEnd  := Nil
        oFrom := oMsg:GetJsonObject("from")
        If ValType(oFrom) $ "O|J"
            oEnd := oFrom:GetJsonObject("emailAddress")
            If ValType(oEnd) $ "O|J"
                If ValType(oEnd:GetJsonObject("name")) == "C"
                    cDecNome := DecodeUTF8(oEnd:GetJsonObject("name"))
                    If ValType(cDecNome) == "C" .And. !Empty(cDecNome)
                        cNome := cDecNome
                    Else
                        cNome := oEnd:GetJsonObject("name")
                    EndIf
                EndIf
                If ValType(oEnd:GetJsonObject("address")) == "C"
                    cEmail := oEnd:GetJsonObject("address")
                EndIf
                aCliente := CNSA_BUSCACLI(cEmail)
                cCodCli  := aCliente[1]
                cLojaCli := aCliente[2]
            EndIf
        EndIf

        If Empty(cId)
            Loop
        EndIf

        If CNSA_CHEXIST(cId)
            CNSA_MARCARLIDO(cToken, cId)
            Loop
        EndIf

        cNewId := GetSXENum("ZA1", "ZA1_IDCH")

        RecLock("ZA1", .T.)
            ZA1->ZA1_FILIAL := xFilial("ZA1")
            ZA1->ZA1_IDCH   := cNewId
            ZA1->ZA1_STATUS := "1"
            ZA1->ZA1_CONSUL := ""
            ZA1->ZA1_CLIENT := If(!Empty(cCodCli), cCodCli, "")
            ZA1->ZA1_LOJA   := If(!Empty(cCodCli), cLojaCli, "")
            ZA1->ZA1_EMAIL  := cEmail
            ZA1->ZA1_ASSUNT := cAssunto
            ZA1->ZA1_DATA   := Date()
            ZA1->ZA1_MAILID := cId
            ZA1->ZA1_MOD    := Date()
        ZA1->(MsUnlock())

        ConfirmSX8()

        // Corpo do e-mail vira a primeira anotacao (ZA2) do chamado - sem
        // tecnico designado ainda, entao ZA2_CONSUL fica vazio (nao e um
        // usuario logado gravando, e o job automatico).
        If !Empty(cCorpo)
            CNSA_ZA2_GRAVAR(Val(cNewId), "", SubStr(cCorpo, 1, TamSX3("ZA2_DESCRI")[1]))
        EndIf

        CNSA_MARCARLIDO(cToken, cId)
        nCriados++
    Next nI

    FreeObj(oJson)
Return nCriados

////////////////////////////////////////////////////////////////////////////////
// Marca uma mensagem como lida no Graph (PATCH), pra ela sair do filtro
// isRead=false na proxima execucao do job - sem isso a fila de nao-lidos so
// cresce e o $top=50 pode nunca alcancar e-mails novos.
////////////////////////////////////////////////////////////////////////////////
Static Function CNSA_MARCARLIDO(cToken, cMailId)
    Local oRest := FWRest():New("https://graph.microsoft.com")
    Local lOk   := .F.

    oRest:setPath("/v1.0/users/apia@apia.com.br/messages/" + cMailId)
    oRest:SetPostParams('{"isRead":true}')

    lOk := oRest:Patch({"Authorization: Bearer " + cToken, "Content-Type: application/json"})
    If !lOk
        ConOut("CNSA_MARCARLIDO: falha ao marcar mensagem " + cMailId + " como lida: " + oRest:GetLastError())
    EndIf
    FreeObj(oRest)
Return lOk

////////////////////////////////////////////////////////////////////////////////
Static Function CNSA_CHEXIST(cMailId)
    Local lExiste := .F.
    Local cAlias  := GetNextAlias()

    BeginSql Alias cAlias
        SELECT ZA1_IDCH
        FROM %Table:ZA1% ZA1
        WHERE ZA1_FILIAL = %xFilial:ZA1%
          AND ZA1_MAILID = %Exp:cMailId%
          AND %NotDel%
    EndSql

    lExiste := !(cAlias)->(Eof())
    (cAlias)->(DbCloseArea())
Return lExiste

////////////////////////////////////////////////////////////////////////////////
// Busca o cliente pelo e-mail do remetente. Porte identico do CNSA_BUSCACLI
// (CNSA001.PRW):
// 1) SU5 -> AC8 -> SA1 (contato oficial)
// 2) Fallback: SA1 por e-mail exato
// 3) Fallback: SA1 por dominio
////////////////////////////////////////////////////////////////////////////////
Static Function CNSA_BUSCACLI(cEmail)
    Local cAlias   := GetNextAlias()
    Local cCod     := ""
    Local cLoja    := ""
    Local cContat  := ""
    Local cDominio := ""
    Local nPos     := 0

    BeginSql Alias cAlias
        SELECT U5_CODCONT
        FROM %Table:SU5% SU5
        WHERE U5_EMAIL = %Exp:cEmail%
          AND %NotDel%
    EndSql
    If !(cAlias)->(Eof())
        cContat := AllTrim((cAlias)->U5_CODCONT)
    EndIf
    (cAlias)->(DbCloseArea())

    If !Empty(cContat)
        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT AC8_CODENT
            FROM %Table:AC8% AC8
            WHERE AC8_FILIAL = %xFilial:AC8%
              AND AC8_CODCON = %Exp:cContat%
              AND AC8_ENTIDA = 'SA1'
              AND %NotDel%
        EndSql
        If !(cAlias)->(Eof())
            cCod  := Left(AllTrim((cAlias)->AC8_CODENT), 6)
            cLoja := Right(AllTrim((cAlias)->AC8_CODENT), 2)
        EndIf
        (cAlias)->(DbCloseArea())

        If !Empty(cCod)
            Return {cCod, cLoja}
        EndIf
    EndIf

    cAlias := GetNextAlias()
    BeginSql Alias cAlias
        SELECT A1_COD, A1_LOJA
        FROM %Table:SA1% SA1
        WHERE A1_FILIAL = %xFilial:SA1%
          AND A1_EMAIL  = %Exp:cEmail%
          AND %NotDel%
        ORDER BY A1_COD, A1_LOJA
    EndSql
    If !(cAlias)->(Eof())
        cCod  := AllTrim((cAlias)->A1_COD)
        cLoja := AllTrim((cAlias)->A1_LOJA)
    EndIf
    (cAlias)->(DbCloseArea())

    If !Empty(cCod)
        Return {cCod, cLoja}
    EndIf

    nPos := At("@", cEmail)
    If nPos == 0
        Return {"", ""}
    EndIf
    cDominio := "%" + SubStr(cEmail, nPos)

    cAlias := GetNextAlias()
    BeginSql Alias cAlias
        SELECT A1_COD, A1_LOJA
        FROM %Table:SA1% SA1
        WHERE A1_FILIAL = %xFilial:SA1%
          AND A1_EMAIL  LIKE %Exp:cDominio%
          AND %NotDel%
        ORDER BY A1_COD, A1_LOJA
    EndSql
    If !(cAlias)->(Eof())
        cCod  := AllTrim((cAlias)->A1_COD)
        cLoja := AllTrim((cAlias)->A1_LOJA)
    EndIf
    (cAlias)->(DbCloseArea())

Return {cCod, cLoja}

////////////////////////////////////////////////////////////////////////////////
// FIX (item 4 do pedido "Verificacao e Envio de E-mails" - encode/decode
// UTF-8): o corpo HTML e o assunto sao montados com texto vindo direto de
// tabelas do Protheus (AA1_NOMTEC, A1_NOME, ZA1_ASSUNT etc.), que fica em
// ANSI (CP1252) na memoria do ADVPL. O Graph espera o JSON em UTF-8 - sem
// essa conversao, nome/assunto com acento (�, �, �...) chegam corrompidos
// no e-mail. EncodeUtf8() (funcao nativa AdvPL) faz a conversao ANSI -> UTF-8
// bytes antes do JSON-escape. Ponto unico de conversao (aqui), assim quem
// monta cCorpo/cAssunto (CNSA_EMAIL_FRONT, CNSA_CANCEL_FRONT) nao precisa se
// preocupar com encoding.
Static Function CNSA_ENVIAEMAIL(cPara, cAssunto, cCorpo, cDe)
    Local cToken  := CNSA_TOKEN()
    Local oRest   := Nil
    Local cJson   := ""
    Local aHeader := {}
    Local lOk      := .F.
    Local cAssuntoUtf8 := ""
    Local cCorpoUtf8    := ""

    If Empty(cToken) .Or. Empty(cPara)
        ConOut("CNSA_ENVIAEMAIL: nao enviado - " + If(Empty(cToken), "token vazio (ver CNSA_TOKEN)", "destinatario (cPara) vazio - AA1_EMAIL nao cadastrado?"))
        Return .F.
    EndIf

    cAssuntoUtf8 := EncodeUtf8(cAssunto)
    cCorpoUtf8   := EncodeUtf8(cCorpo)

    cJson := '{'
    cJson +=   '"message": {'
    cJson +=     '"subject": "' + CNSA_JSONESC(cAssuntoUtf8) + '",'
    cJson +=     '"body": {'
    cJson +=       '"contentType": "HTML",'
    cJson +=       '"content": "' + CNSA_JSONESC(cCorpoUtf8) + '"'
    cJson +=     '},'
    cJson +=     '"toRecipients": [{'
    cJson +=       '"emailAddress": {'
    cJson +=         '"address": "' + CNSA_JSONESC(cPara) + '"'
    cJson +=       '}'
    cJson +=     '}]'
    cJson +=   '},'
    cJson +=   '"saveToSentItems": "true"'
    cJson += '}'

    oRest := FWRest():New("https://graph.microsoft.com")
    oRest:setPath("/v1.0/users/" + cDe + "/sendMail")
    oRest:SetPostParams(cJson)

    aHeader := {}
    aAdd(aHeader, "Authorization: Bearer " + cToken)
    aAdd(aHeader, "Content-Type: application/json")

    oRest:Post(aHeader)

    lOk := (oRest:GetLastError() == "202 Accepted" .Or. Empty(oRest:GetLastError()))
    If !lOk
        ConOut("CNSA_ENVIAEMAIL: falha no POST sendMail (Graph) para " + cPara + ": " + oRest:GetLastError() + " | " + oRest:GetResult())
    EndIf
    FreeObj(oRest)

Return lOk

Static Function CNSA_ASSUMIR(cIdCh)
    Local cConsultorSessao := ""
    Local cFase            := ""
    Local cNomeTec         := ""
    Local oJson            := JsonObject():New()
    Local oErro            := Nil

    Begin Sequence

        If Empty(cIdCh)
            Return {400, '{"erro":"Informe o idCh do chamado (?idCh=000031)."}'}
        EndIf

        cConsultorSessao := Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC")
        If Empty(cConsultorSessao)
            // FIX: faltava o status HTTP (400) - o array so tinha 1 posicao
            // (a string do JSON), o que quebrava o SetStatus(aResultado[1])
            // no WSMETHOD, pois recebia a string inteira em vez de um numero.
            Return {400, '{"erro":"Seu usuario nao esta vinculado a nenhum consultor (AA1)."}'}
        EndIf

        dbSelectArea("ZA1")
        ZA1->(DbSetOrder(1))
        If !ZA1->(DbSeek(xFilial("ZA1") + cIdCh))
            Return {404, '{"erro":"Chamado nao encontrado."}'}
        EndIf

        If !Empty(AllTrim(ZA1->ZA1_CONSUL))
            Return {400, '{"erro":"Este chamado ja possui tecnico designado."}'}
        EndIf

        If ZA1->ZA1_STATUS == "4"
            Return {400, '{"erro":"Chamado fechado nao pode ser assumido."}'}
        EndIf

        If ZA1->ZA1_STATUS == "2" .Or. ZA1->ZA1_STATUS == "3"
            Return {400, '{"erro":"Chamado pendente nao pode ser assumido."}'}
        EndIf

        If Empty(AllTrim(ZA1->ZA1_CLIENT))
            Return {400, '{"erro":"O chamado precisa ter um cliente definido antes de ser assumido."}'}
        EndIf

        If Empty(AllTrim(ZA1->ZA1_PROJ))
            Return {400, '{"erro":"O chamado precisa ter um projeto definido antes de ser assumido."}'}
        EndIf

        cFase := Posicione("AF8", 1, xFilial("AF8") + AllTrim(ZA1->ZA1_PROJ), "AF8_FASE")
        If AllTrim(cFase) <> "03"
            Return {400, '{"erro":"O chamado so pode ser assumido com projeto em execucao (fase 03)."}'}
        EndIf

        If Empty(AllTrim(ZA1->ZA1_TAREFA))
            Return {400, '{"erro":"O chamado precisa ter uma tarefa definida antes de ser assumido."}'}
        EndIf

        RecLock("ZA1", .F.)
            ZA1->ZA1_CONSUL := cConsultorSessao
            ZA1->ZA1_STATUS := "2"
            ZA1->ZA1_MOD    := Date()
        ZA1->(MsUnlock())

        // E-mail de designacao pro proprio tecnico que assumiu (auto-atribuicao).
        // Regra unificada com Incluir/Alterar - ver CNSA_DISPARA_DESIGNACAO.
        cNomeTec := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cConsultorSessao, "AA1_NOMTEC"))
        CNSA_DISPARA_DESIGNACAO(cIdCh, cConsultorSessao)

        oJson['sucesso'] := .T.
        oJson['idCh']    := cIdCh
        oJson['status']  := "2"
        oJson['tecnico'] := EncodeUtf8(cNomeTec)

        Return {200, oJson:ToJson()}

    Recover Using oErro
        Return {500, '{"erro":"' + CNSA_JSONESC(EncodeUtf8(oErro:Description)) + '"}'}
    End Sequence

Return {500, '{"erro":"Erro desconhecido."}'}

