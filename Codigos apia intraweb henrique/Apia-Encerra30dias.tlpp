#include "PROTHEUS.CH"
#include "TOPCONN.CH"
#include "TOTVS.CH"
#include "tlpp-core.th"

/////////////////////////////////////////////////////////////////////////////
// Apia-Encerra30dias.tlpp (antigo CNSA_JOBFECHA30D.PRW) - job agendado
// (roda sozinho, sem usuario logado). FIX (nome errado no registro):
// arquivo/comentario antigo mandavam registrar como "CNSA_JOBFECHA30D",
// mas a User Function de verdade sempre se chamou CNSA_FECHA30D - com o
// nome errado, o Schedule nunca acha a funcao e o job nao roda.
//
// Regra (confirmada por Henrique): chamado com status "1" (Aberto) que nao
// teve ZA1_MOD alterado nos ultimos 30 dias e fechado automaticamente
// (ZA1_STATUS := "4"). So considera status "1" - "Aberto" literal, nao
// "Pendente Apia"/"Pendente Cliente" (status "2"/"3"), que sao estados
// diferentes e nao entram nessa regra. Reabertura depois e responsabilidade
// de outro endpoint (Alterar), nao deste job.
//
// cEmpAnt/cFilAnt "01"/"01" (2026-08-14): confirmado meses de debug ao vivo
// nesta sessao (Apia-OS.tlpp/Apia-Chamados.tlpp) que "01"/"01" e mesmo o
// codigo real de empresa/filial deste ambiente (ENV2510VLD) - deixou de ser
// placeholder as cegas. Se rodar em outro ambiente/empresa, confere de novo.
//
// Registro do job (feito fora do ADVPL, no ambiente): TOTVS SIGACFG ->
// Agendador de Tarefas (Schedule), aponta pra User Function CNSA_FECHA30D,
// frequencia diaria (ex: 1x por dia, de madrugada).
/////////////////////////////////////////////////////////////////////////////
User Function CNSA_FECHA30D()
    Local cEmpAnt      := "01"
    Local cFilAnt      := "01"
    Local dLimite      := Date() - 30
    Local nFechados    := 0
    Local cAlias       := "ZA1FECHA"

    RpcSetType(3)
    If !RpcSetEnv(cEmpAnt, cFilAnt, , , "SIGAAGL", , {"ZA1"})
        ConOut("CNSA_FECHA30D: falha no RpcSetEnv - job abortado.")
        Return
    EndIf

    Begin Sequence

        BeginSql Alias cAlias
            SELECT ZA1.R_E_C_N_O_ RECNO
            FROM %Table:ZA1% ZA1
            WHERE ZA1.ZA1_FILIAL = %xFilial:ZA1%
              AND ZA1.ZA1_STATUS = '1'
              AND ZA1.ZA1_MOD < %Exp:dLimite%
              AND ZA1.%NotDel%
        EndSql

        While !(cAlias)->(Eof())
            ZA1->(DbGoTo((cAlias)->RECNO))

            RecLock("ZA1", .F.)
                ZA1->ZA1_STATUS := "4"
                ZA1->ZA1_MOD    := Date()
            ZA1->(MsUnlock())

            nFechados++
            ConOut("CNSA_FECHA30D: chamado " + AllTrim(ZA1->ZA1_IDCH) + " fechado automaticamente (30 dias sem modificacao).")

            (cAlias)->(DbSkip())
        EndDo

        (cAlias)->(DbCloseArea())

    Recover
        ConOut("CNSA_FECHA30D: erro durante execucao - ver log acima.")
    End Sequence

    ConOut("CNSA_FECHA30D: finalizado - " + AllTrim(Str(nFechados)) + " chamado(s) fechado(s).")

    RpcClearEnv()

Return
