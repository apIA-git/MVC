#include "PROTHEUS.CH"
#include "TOTVS.CH"
#include "tlpp-core.th"
#INCLUDE 'tlpp-rest.th'


//-------------------------------------------------------------------
/*/{Protheus.doc} CNSLOGIN_VALIDAR
@Login do usuário no Protheus via REST
@author Henrique
@since 30/09/2026
@version P12
/*/
//-------------------------------------------------------------------
@Get(endpoint="/CNSLOGIN")
User Function CNSLOGIN_VALIDAR() As Logical
    Local oJson := JsonObject():New()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico da pagina do cliente (Aprovador-OS) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return oRest:setStatusResponse(403, '{"erro":"Usuario sem acesso a este recurso."}')
    EndIf

    oJson['codigo']  := __cUserId
    oJson['usuario'] := AllTrim(UsrRetName(__cUserId))
    oJson['nome']    := AllTrim(UsrFullName(__cUserId))

Return oRest:setStatusResponse(200, oJson:ToJson())
