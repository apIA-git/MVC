#Include "FWMVCDef.ch"
#Include "Totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"

Namespace apia.cnsa004

// CNSA004 - Aprovacao de OS: historico (SZA), regras (U_CNSAPR), e-mails, schedule e endpoints. Henrique, 10/2026.

/*/{Protheus.doc} CNS004
Historico de aprovacao de OS (SZA), so consulta - uma linha por evento. Com cOs, filtrado na OS.
@param  cOs   Numero da OS (opcional)
/*/
User Function CNS004(cOs)

    Local l_oBrowse := Nil
    Local aLeg      := HA_LEGS()
    Local nI        := 0
    Private aRotina := u_MenuDef()

    Default cOs := ""

    l_oBrowse := FWMBrowse():New()
    If l_oBrowse <> Nil

        l_oBrowse:SetDescription("Historico de Aprovacao de OS" + If(Empty(cOs), "", " - OS " + AllTrim(cOs)))
        l_oBrowse:SetAlias("SZA")

        If !Empty(cOs)
            l_oBrowse:SetFilterDefault("SZA->ZA_OS == '" + PadR(AllTrim(cOs), TamSX3("ZA_OS")[1]) + "'")
        EndIf

        For nI := 1 To Len(aLeg)
            l_oBrowse:AddLegend(aLeg[nI][1], aLeg[nI][2], aLeg[nI][4])
        Next nI

        l_oBrowse:Activate()

    EndIf

Return

/*/{Protheus.doc} MenuDef
Menu so de consulta - o historico nao e editado a mao.
@return aRotina   Array de opcoes de menu (ADD OPTION)
/*/
User Function MenuDef()

Local aRotina := {}

    ADD OPTION aRotina TITLE "Pesquisar"  ACTION "AxPesqui"                       OPERATION 1 ACCESS 0
    ADD OPTION aRotina TITLE "Visualizar" ACTION "apia.cnsa004.U_HA_VISUALIZAR"   OPERATION 2 ACCESS 0
    ADD OPTION aRotina TITLE "Legenda"    ACTION "apia.cnsa004.U_HA_LEGENDA"      OPERATION 0 ACCESS 0

Return aRotina

/*/{Protheus.doc} ModelDef
Modelo de dados do historico (so SZA).
@return oModel   Objeto MPFormModel
/*/
User Function ModelDef()
Return HA_MONTARMODEL()

/*/{Protheus.doc} ViewDef
View do historico (so SZA).
@return oView   Objeto FWFormView
/*/
User Function ViewDef()

    Local oView  := Nil
    // FWLoadModel nao acha o model dentro do Namespace: usa o ativo.
    Local oModel := FWModelActive()

    // Model ativo de outra rotina nao serve: monta o do historico.
    If oModel == Nil .Or. oModel:GetId() != "FCNS004"
        oModel := HA_MONTARMODEL()
    EndIf

    oView:=FWFormView():New()
    oView:SetModel(oModel)
    oView:AddField("VIEW_SZA", FWFormStruct(2, "SZA"), "SZAMASTER")
    oView:CreateHorizontalBox("TELA", 100)
    oView:SetOwnerView("VIEW_SZA", "TELA")
    oView:EnableTitleView("VIEW_SZA", "Resposta da OS")
    oView:SetCloseOnOk({|| .T.})

Return oView

/*/{Protheus.doc} HA_MONTARMODEL
Model da SZA. Com nOperAtivar tambem ativa, na mesma funcao (ver OS_MONTARMODEL no CNSA002).
@param  nOperAtivar   Operacao a ativar (0 = so monta)
@param  lSemTela      .T. = gravacao por REST/job (U_CNSAPR): tira campos virtuais e
                      troca X3_VALID/X3_WHEN por .T. (mesmo tratamento do OS_STRUCTHEADLESS)
@return oModel        Objeto MPFormModel
/*/
Static Function HA_MONTARMODEL(nOperAtivar, lSemTela)

    Local oModel   := MPFormModel():New("FCNS004")
    Local oStr     := FWFormStruct(1, "SZA")
    Local aCampos  := {}
    Local aVirtual := {}
    Local nI       := 0
    Local cVazio   := ""

    Default nOperAtivar := 0
    Default lSemTela    := .F.

    If lSemTela
        aCampos := oStr:GetFields()
        For nI := 1 To Len(aCampos)
            If aCampos[nI][MODEL_FIELD_VIRTUAL]
                AAdd(aVirtual, aCampos[nI][MODEL_FIELD_IDFIELD])
            Else
                oStr:SetProperty(aCampos[nI][MODEL_FIELD_IDFIELD], MODEL_FIELD_VALID,   {|| .T.})
                oStr:SetProperty(aCampos[nI][MODEL_FIELD_IDFIELD], MODEL_FIELD_WHEN,    {|| .T.})
                oStr:SetProperty(aCampos[nI][MODEL_FIELD_IDFIELD], MODEL_FIELD_OBRIGAT, .F.)
                // Inicializador vazio do tipo do campo (Nil da "Erro no inicializador padrao").
                cVazio := If(aCampos[nI][MODEL_FIELD_TIPO] == "D", 'CToD("")', ;
                          If(aCampos[nI][MODEL_FIELD_TIPO] == "N", "0", ;
                          If(aCampos[nI][MODEL_FIELD_TIPO] == "L", ".F.", '""')))
                oStr:SetProperty(aCampos[nI][MODEL_FIELD_IDFIELD], MODEL_FIELD_INIT, &("{|| " + cVazio + "}"))
            EndIf
        Next nI
        For nI := 1 To Len(aVirtual)
            oStr:RemoveField(aVirtual[nI])
        Next nI
    EndIf

    oModel:AddFields("SZAMASTER", NIL, oStr)
    oModel:SetPrimaryKey({"ZA_FILIAL", "ZA_OS", "ZA_SEQ"})
    oModel:SetDescription("Historico de Aprovacao de OS")
    oModel:GetModel("SZAMASTER"):SetDescription("Resposta da OS")

    If nOperAtivar > 0
        oModel:SetOperation(nOperAtivar)
        oModel:Activate()
    EndIf

Return oModel

/*/{Protheus.doc} HA_VISUALIZAR
Opcao "Visualizar": abre a resposta posicionada so para leitura.
/*/
User Function HA_VISUALIZAR()
    Local oModel := HA_MONTARMODEL(MODEL_OPERATION_VIEW)

    // Model desta tela como ativo (o ViewDef usa o ativo).
    FWModelActive(oModel)
    FWExecView("Historico de Aprovacao de OS", "apia.cnsa004.u_cns004", MODEL_OPERATION_VIEW, , {|| .T.}, NIL, NIL, NIL, NIL, NIL, NIL, oModel)
Return

/*/{Protheus.doc} HA_LEGENDA
Menu Legenda do historico.
/*/
User Function HA_LEGENDA()
    Local aLeg := HA_LEGS()
    Local aCor := {}
    Local nI   := 0

    For nI := 1 To Len(aLeg)
        AAdd(aCor, {aLeg[nI][3], aLeg[nI][4]})
    Next nI
    BrwLegenda("Legenda", "Evento", aCor)

Return

/*/{Protheus.doc} HA_LEGS
Legenda do evento da SZA (primeira que casar) - mesmos textos e cores da coluna Aprovacao do portal.
@return aRet  {{condicao, cor do browse, imagem, texto}}
/*/
Static Function HA_LEGS()
Return {{"!Empty(SZA->ZA_ENVDT)",                                                     "YELLOW", "BR_AMARELO", "Aguardando cliente"}, ;
        {"SZA->ZA_APROVAD=='S' .And. SZA->ZA_APVTIPO=='W'",                           "GREEN",  "BR_VERDE",   "Aprovada (cliente)"}, ;
        {"SZA->ZA_APROVAD=='S' .And. SZA->ZA_APVTIPO=='D'",                           "BLUE",   "BR_AZUL",    "Aprovada (prazo)"}, ;
        {"SZA->ZA_APROVAD=='S'",                                                      "BLUE",   "BR_AZUL",    "Aprovada (manual)"}, ;
        {"SZA->ZA_APROVAD=='A' .And. SZA->ZA_APVTIPO=='M'",                           "BLUE",   "BR_AZUL",    "Pre-aprovada (sem aprovacao do cliente)"}, ;
        {"SZA->ZA_APROVAD=='R' .And. SZA->ZA_APVTIPO=='M'",                           "BLACK",  "BR_PRETO",   "Pre-recusada (interna)"}, ;
        {"SZA->ZA_APROVAD=='R' .And. SZA->ZA_APVTIPO=='W'",                           "PINK",   "BR_PINK",    "Recusada (cliente)"}, ;
        {"SZA->ZA_APROVAD=='R'",                                                      "PINK",   "BR_PINK",    "Recusada (manual)"}, ;
        {"SZA->ZA_APROVAD=='P'",                                                      "YELLOW", "BR_AMARELO", "Aguardando pre-aprovacao interna"}, ;
        {"SZA->ZA_APROVAD=='N' .And. SZA->ZA_APVTIPO=='M'",                           "BLUE",   "BR_AZUL",    "Pre-aprovada, a enviar"}, ;
        {"SZA->ZA_APROVAD=='A'",                                                      "GRAY",   "BR_CINZA",   "Nao requer aprovacao"}, ;
        {".T.",                                                                       "BLUE",   "BR_AZUL",    "A enviar ao cliente"}}

// U_CNSAPR - unico ponto de regras da aprovacao (planilha aprovacao-os-transacoes.xlsx).
// SZ1 guarda o estado; SZA e o livro de eventos (uma linha por evento). SZA (model FCNS004)
// e SZ1 (model leve da OS, U_OS_APRPUB "GRAVAR") gravam na MESMA transacao.
// Transacoes (cTrans):
//   OS   (oModel, "", {fase})        evento do model da OS: VLD / ANT / GRV
//   PRE  (cOs, "M")                  P -> A (AF9_UM = VB) ou N   - so RESPMAN
//   PRR  (cOs, "M", {motivo})        P -> R                      - so RESPMAN
//   APR  (cOs, W|I|D, {ip})          N -> S        (I so RESPMAN; W/D sem checagem)
//   REC  (cOs, W|I, {motivo, ip})    N -> R        (I so RESPMAN; W sem checagem)
//   ENV  (cOs)                       so em N: token no link, so o SHA-256 na SZA - qualquer analista;
//                                    aRet[5] = "E-mail enviado para: ... Falhou para: ..." 
//   CNS  (cToken)                    link valido? devolve {lOk, cErro, jOs}
//   INV  (cOs, "", {motivo})         OS enviada (N) mudou (interacao nova/excluida): mata o link e avisa o cliente
//   LEG  ({aprovad, apvtipo, apvdata, envdt, dtdigit})   {cLegenda, cCor} (aba Legenda)
//   LEGS ()                                      todas as {cLegenda, cCor} (browse classico)
//   REG  (cOs ou {proj, rev, tarefa})           {cAprovad, cApvTipo} pela tarefa (AF9_APVMAN S/N, AF9_UM)
//   HIS  (cOs ou "")                            SZA completa (todas as OS ou so cOs) -> {aItens, aColunas {campo, titulo}}

/*/{Protheus.doc} CNSAPR
Aprovacao de OS - todas as transacoes (ver tabela acima).
@param  cTrans   Transacao
@param  xAlvo    oModel (OS), cOs, cToken (CNS) ou array (LEG/REG)
@param  cOrigem  Z1_APVTIPO resultante (W link, I manual, D prazo, M pre-aprovacao)
@param  jDados   JsonObject: motivo, ip, fase (OS), reabriu (OS/GRV)
@return aRet     {lOk, cErro, cAprovad, cApvTipo} - CNS: {lOk, cErro, jOs} - LEG/REG: ver tabela
/*/
User Function CNSAPR(cTrans, xAlvo, cOrigem, jDados)
    Local aRet     := {.F., "", "", ""}
    Local oModel   := Nil
    Local oSZ1     := Nil
    Local cOs      := ""
    Local cFase    := ""
    Local cAntes   := ""
    Local cMotivo  := ""
    Local cNovo    := ""
    Local cHash    := ""
    Local cToken   := ""
    Local cCliente := ""
    Local cEmail   := ""
    Local aReg     := {}
    Local aUsu     := {}
    Local aSZ1     := {}
    Local aSZA     := {}
    Local aPara    := {}
    Local aTaf     := {}
    Local nI       := 0
    Local nOper    := 0
    Local dHoje    := Date()
    Local cAgora   := Left(Time(), 5)
    Local lMudou   := .F.
    Local jOs      := Nil
    Local jInt     := Nil
    Local aJsInt   := {}
    Local cNomeCli := ""
    Local cAlias   := ""
    Local aEnv     := {}
    Local cMsgEnv  := ""
    Local cErro    := ""
    Local aCampos  := {}
    Local dValid   := CToD("")
    Local aLeg     := {}
    Local jLin     := Nil
    Local xVal     := Nil
    Local lUltima  := .F.
    Local cInval   := ""

    Default cOrigem := ""
    Default jDados  := JsonObject():New()

    cTrans  := Upper(AllTrim(cTrans))
    cMotivo := Left(AllTrim(AP_UTF8(AP_TXT(jDados, "motivo"))), 240)

    Do Case

    //--- Evento do model da OS (CNS002APR, CNSA002)
    Case cTrans == "OS"
        aRet   := {.T., "", "", "", .F., ""}
        If Type("__lA02Interno") == "L" .And. __lA02Interno
            Return aRet
        EndIf
        oModel := xAlvo
        oSZ1   := oModel:GetModel("SZ1MASTER")
        nOper  := oModel:GetOperation()
        cFase  := AP_TXT(jDados, "fase")
        cOs    := oSZ1:GetValue("Z1_OS")
        If (nOper == MODEL_OPERATION_UPDATE .Or. nOper == MODEL_OPERATION_DELETE) .And. AP_SZ1(cOs)
            cAntes := AllTrim(SZ1->Z1_APROVAD)
        EndIf

        Do Case
        Case cFase == "VLD"
            // OS aprovada/recusada: so RESPMAN altera (e a alteracao reabre).
            If (cAntes == "S" .Or. cAntes == "R") .And. !AP_RESPMAN()
                aRet := {.F., "OS " + If(cAntes == "S", "aprovada", "recusada") + ": somente o administrador pode " + ;
                    If(nOper == MODEL_OPERATION_DELETE, "excluir.", "alterar (a OS volta a aguardar aprovacao)."), cAntes, ""}
            EndIf

        Case cFase == "ANT"
            If nOper == MODEL_OPERATION_DELETE
                Return aRet
            EndIf
            If nOper == MODEL_OPERATION_UPDATE
                lMudou := AllTrim(oSZ1:GetValue("Z1_PROJET")) != AllTrim(SZ1->Z1_PROJET) .Or. ;
                          AllTrim(oSZ1:GetValue("Z1_REVISA")) != AllTrim(SZ1->Z1_REVISA) .Or. ;
                          AllTrim(oSZ1:GetValue("Z1_TAREFA")) != AllTrim(SZ1->Z1_TAREFA)
            EndIf
            If cAntes == "S" .Or. cAntes == "R"
                // Reabre: S/R -> N (tarefa trocada: regra da tarefa nova). A SZA sai na fase GRV.
                aReg := If(lMudou, U_CNSAPR("REG", {oSZ1:GetValue("Z1_PROJET"), oSZ1:GetValue("Z1_REVISA"), ;
                    oSZ1:GetValue("Z1_TAREFA")}), {"N", ""})
                aRet[5] := .T.
            ElseIf nOper == MODEL_OPERATION_INSERT .Or. lMudou .Or. ;
                    (nOper == MODEL_OPERATION_UPDATE .And. Empty(cAntes))
                // Inclusao, troca de tarefa ou OS antiga sem estado: regra da tarefa.
                aReg := U_CNSAPR("REG", {oSZ1:GetValue("Z1_PROJET"), oSZ1:GetValue("Z1_REVISA"), oSZ1:GetValue("Z1_TAREFA")})
                // OS ja enviada: evento na SZA mata o link (token so vale na ultima linha).
                If lMudou .And. !Empty(SZ1->Z1_ENVDT)
                    aRet[5] := .T.
                    aRet[6] := "troca de projeto/tarefa"
                EndIf
            ElseIf nOper == MODEL_OPERATION_UPDATE
                // Edicao comum: aprovacao como esta no banco (outro pode ter mudado com a tela aberta).
                aCampos := AP_ZERAR()
                AAdd(aCampos, "Z1_APROVAD")
                AAdd(aCampos, "Z1_APVTIPO")
                AAdd(aCampos, "Z1_OSENVCL")
                For nI := 1 To Len(aCampos)
                    oSZ1:LoadValue(aCampos[nI], SZ1->(FieldGet(FieldPos(aCampos[nI]))))
                Next nI
                // OS enviada e sem resposta com mudanca no que o cliente ve: o link morre (linha na SZA na
                // fase GRV) e a OS volta a "a enviar".
                cInval := AP_MUDOU(oSZ1)
                If AllTrim(SZ1->Z1_APROVAD) == "N" .And. !Empty(SZ1->Z1_ENVDT) .And. !Empty(cInval)
                    oSZ1:LoadValue("Z1_ENVDT", AP_VAL("Z1_ENVDT", ""))
                    oSZ1:LoadValue("Z1_ENVHR", AP_VAL("Z1_ENVHR", ""))
                    oSZ1:LoadValue("Z1_OSENVCL", "N")
                    aRet[5] := .T.
                    aRet[6] := "alteracao de " + cInval
                EndIf
            EndIf
            If !Empty(aReg)
                oSZ1:LoadValue("Z1_APROVAD", aReg[1])
                oSZ1:LoadValue("Z1_APVTIPO", AP_VAL("Z1_APVTIPO", aReg[2]))
                aCampos := AP_ZERAR()
                For nI := 1 To Len(aCampos)
                    oSZ1:LoadValue(aCampos[nI], AP_VAL(aCampos[nI], ""))
                Next nI
                oSZ1:LoadValue("Z1_OSENVCL", "N")
                aRet[3] := aReg[1]
                aRet[4] := aReg[2]
            EndIf

        Case cFase == "GRV"
            // Reabertura ou reavaliacao de OS enviada: linha com o estado novo (mata o link).
            If AP_TXT(jDados, "reabriu") == "S"
                aUsu := AP_USUARIO()
                // Link invalidado (OS enviada que mudou): linha de reabertura (tipo vazio) com o motivo.
                aSZA := {{"ZA_APROVAD", oSZ1:GetValue("Z1_APROVAD")}, ;
                    {"ZA_APVTIPO", If(Empty(cMotivo), oSZ1:GetValue("Z1_APVTIPO"), "")}, {"ZA_POR", aUsu[1]}, ;
                    {"ZA_EMAIL", aUsu[2]}, {"ZA_DTREC", dHoje}, {"ZA_HRREC", cAgora}}
                If !Empty(cMotivo)
                    AAdd(aSZA, {"ZA_DESCRI", "Link invalidado: " + cMotivo})
                EndIf
                aRet := AP_GRAVASZA(cOs, aSZA)
                If !aRet[1]
                    ConOut("CNSAPR: historico da OS " + AllTrim(cOs) + " nao gravado - gravacao desfeita: " + aRet[2])
                    DisarmTransaction()
                    UserException("Historico de aprovacao da OS nao gravado: " + aRet[2])
                EndIf
                If !Empty(cMotivo)
                    AP_AVISAR("INV", cOs, aUsu[1], cMotivo)
                EndIf
            EndIf
        EndCase

    //--- Pre-aprova / pre-recusa (so RESPMAN, so em P)
    Case cTrans == "PRE" .Or. cTrans == "PRR"
        cOs := xAlvo
        If !AP_RESPMAN()
            Return {.F., "Somente o administrador pode " + If(cTrans == "PRE", "pre-aprovar", "pre-recusar") + " a OS.", "", ""}
        EndIf
        If cTrans == "PRR" .And. Empty(cMotivo)
            Return {.F., "Informe o motivo da pre-recusa.", "", ""}
        EndIf
        cErro := AP_PEGAR(cOs, "P", "A OS nao esta aguardando pre-aprovacao.")
        If !Empty(cErro)
            Return {.F., cErro, "", ""}
        EndIf
        aUsu := AP_USUARIO()
        If cTrans == "PRE"
            aTaf  := AP_TAREFA(SZ1->Z1_PROJET, SZ1->Z1_REVISA, SZ1->Z1_TAREFA)
            cNovo := If(aTaf[2] == "VB", "A", "N")
            aSZ1  := {{"Z1_APROVAD", cNovo}, {"Z1_APVTIPO", "M"}, ;
                      {"Z1_APVDATA", ""}, {"Z1_APVHORA", ""}, {"Z1_APVIP", ""}}
            aSZA  := {{"ZA_APROVAD", cNovo}, {"ZA_APVTIPO", "M"}, {"ZA_POR", aUsu[1]}, {"ZA_EMAIL", aUsu[2]}, ;
                      {"ZA_DTREC", dHoje}, {"ZA_HRREC", cAgora}}
        Else
            cNovo := "R"
            aSZ1  := {{"Z1_APROVAD", "R"}, {"Z1_APVTIPO", "M"}, {"Z1_APVDOR", aUsu[1]}, {"Z1_APVMAIL", aUsu[2]}, ;
                      {"Z1_APVDATA", dHoje}, {"Z1_APVHORA", cAgora}, {"Z1_APVIP", ""}, {"Z1_APVOBS", cMotivo}}
            aSZA  := {{"ZA_APROVAD", "R"}, {"ZA_APVTIPO", "M"}, {"ZA_POR", aUsu[1]}, {"ZA_EMAIL", aUsu[2]}, ;
                      {"ZA_DTREC", dHoje}, {"ZA_HRREC", cAgora}, {"ZA_DESCRI", cMotivo}}
        EndIf
        aRet := AP_GRAVAR(SZ1->Z1_OS, aSZ1, aSZA)
        AP_DESTRAVAR(cOs)
        If aRet[1]
            aRet := {.T., "", cNovo, "M"}
        EndIf

    //--- Aprova / recusa (link W, manual I ou prazo D)
    Case cTrans == "APR" .Or. cTrans == "REC"
        cOs := xAlvo
        If !(cOrigem $ "W|I|D") .Or. Empty(cOrigem) .Or. (cTrans == "REC" .And. cOrigem == "D")
            Return {.F., "Origem invalida para " + cTrans + ".", "", ""}
        EndIf
        If cOrigem == "I" .And. !AP_RESPMAN()
            Return {.F., "Somente o administrador pode " + If(cTrans == "APR", "aprovar", "recusar") + " a OS manualmente.", "", ""}
        EndIf
        If cTrans == "REC" .And. Empty(cMotivo)
            Return {.F., "Informe o motivo da recusa.", "", ""}
        EndIf
        // Dentro da trava: o segundo ve a OS ja decidida.
        cErro := AP_PEGAR(cOs, "N", "Esta OS ja foi decidida.")
        If !Empty(cErro)
            Return {.F., cErro, "", ""}
        EndIf
        aUsu     := AP_USUARIO()
        cCliente := AllTrim(Posicione("SA1", 1, xFilial("SA1") + SZ1->Z1_CLI + SZ1->Z1_LOJA, "A1_NOME"))
        Do Case
        Case cOrigem == "W"
            aUsu := {cCliente, AllTrim(SZ1->Z1_APVMAIL)}
        Case cOrigem == "D"
            aUsu := {"Aprovacao automatica", ""}
        EndCase
        cNovo := If(cTrans == "APR", "S", "R")
        aSZ1  := {{"Z1_APROVAD", cNovo}, {"Z1_APVTIPO", cOrigem}, {"Z1_APVDATA", dHoje}, {"Z1_APVHORA", cAgora}, ;
                  {"Z1_APVIP", If(cOrigem == "W", AP_TXT(jDados, "ip"), "")}, {"Z1_APVMAIL", aUsu[2]}, ;
                  {"Z1_APVDOR", aUsu[1]}}
        aSZA  := {{"ZA_APROVAD", cNovo}, {"ZA_APVTIPO", cOrigem}, {"ZA_POR", aUsu[1]}, {"ZA_EMAIL", aUsu[2]}, ;
                  {"ZA_IP", If(cOrigem == "W", AP_TXT(jDados, "ip"), "")}, {"ZA_DTREC", dHoje}, {"ZA_HRREC", cAgora}}
        // Motivo da recusa (obrigatorio) ou observacao da aprovacao (opcional).
        If !Empty(cMotivo)
            AAdd(aSZ1, {"Z1_APVOBS", cMotivo})
            AAdd(aSZA, {"ZA_DESCRI", cMotivo})
        EndIf
        cOs  := SZ1->Z1_OS
        aRet := AP_GRAVAR(cOs, aSZ1, aSZA)
        AP_DESTRAVAR(cOs)
        If aRet[1]
            AP_AVISAR(cTrans, cOs, aUsu[1], cMotivo)
            aRet := {.T., "", cNovo, cOrigem}
        EndIf

    //--- Envia ao cliente (link com token) - so em N
    Case cTrans == "ENV"
        cOs := xAlvo
        // Qualquer analista (tecnico AA1) envia; o usuario de servico nao.
        If Empty(AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC")))
            Return {.F., "Somente analista cadastrado (tecnico) pode enviar a OS ao cliente.", "", ""}
        EndIf
        cErro := AP_PEGAR(cOs, "N", "So OS aguardando aprovacao do cliente pode ser enviada.")
        If !Empty(cErro)
            Return {.F., cErro, "", ""}
        EndIf
        cOs   := SZ1->Z1_OS
        cNovo := AllTrim(SZ1->Z1_APVTIPO)
        aPara := apia.cnsa002.U_OS_APRPUB("DESTINO", cOs)
        If Empty(aPara)
            AP_DESTRAVAR(cOs)
            Return {.F., "Cliente sem e-mail no chamado da OS nem no cadastro.", "", ""}
        EndIf
        // Token: 64 hexa (2 UUID v4) so no link; na SZA so o SHA-256.
        cToken := Lower(StrTran(FWUUIDV4(), "-", "") + StrTran(FWUUIDV4(), "-", ""))
        cHash  := AP_HASH(cToken)
        aUsu   := AP_USUARIO()
        dValid := dHoje + SuperGetMV("MV_CNSAVLD", .F., 2)
        // So enderecos validos; a OS e gravada ANTES do e-mail (o link so sai se o token ja existe).
        aEnv := {}
        For nI := 1 To Len(aPara)
            If AP_EMAILOK(AllTrim(aPara[nI]))
                AAdd(aEnv, AllTrim(aPara[nI]))
            EndIf
        Next nI
        If Empty(aEnv)
            AP_DESTRAVAR(cOs)
            Return {.F., "Nenhum e-mail valido do cliente (" + AP_JUNTA(aPara, ", ") + "). Confira o e-mail " + ;
                "do chamado da OS ou do cadastro do cliente. A OS nao foi marcada como enviada.", "", ""}
        EndIf
        cEmail := AP_JUNTA(aEnv, ";")
        aSZ1   := {{"Z1_APVMAIL", cEmail}, {"Z1_ENVDT", dHoje}, {"Z1_ENVHR", cAgora}, {"Z1_OSENVCL", "S"}, ;
                   {"Z1_APVDOR", AllTrim(Posicione("SA1", 1, xFilial("SA1") + SZ1->Z1_CLI + SZ1->Z1_LOJA, "A1_NOME"))}, ;
                   {"Z1_APVDATA", ""}, {"Z1_APVHORA", ""}, {"Z1_APVIP", ""}}
        aSZA   := {{"ZA_APROVAD", "N"}, {"ZA_APVTIPO", cNovo}, {"ZA_HASH", cHash}, ;
                   {"ZA_ENVDT", dHoje}, {"ZA_ENVHR", cAgora}, {"ZA_PRAZO", dHoje + SuperGetMV("MV_CNSAPRZ", .F., 2)}, ;
                   {"ZA_VALID", dValid}, {"ZA_EMAIL", cEmail}, {"ZA_POR", aUsu[1]}}
        aRet := AP_GRAVAR(cOs, aSZ1, aSZA)
        If !aRet[1]
            AP_DESTRAVAR(cOs)
            Return {.F., "A OS nao foi enviada (nada saiu para o cliente): " + aRet[2], "", ""}
        EndIf
        aEnv := AP_ENVIAR(cOs, aEnv, cToken, dValid)
        If Empty(aEnv[1])
            // Nenhum e-mail saiu: o envio e desfeito (linha na SZA mata o token) e a OS volta a "a enviar".
            AP_GRAVAR(cOs, {{"Z1_ENVDT", ""}, {"Z1_ENVHR", ""}, {"Z1_OSENVCL", "N"}, {"Z1_APVDOR", ""}, {"Z1_APVMAIL", ""}}, ;
                {{"ZA_APROVAD", "N"}, {"ZA_APVTIPO", ""}, {"ZA_POR", aUsu[1]}, {"ZA_EMAIL", aUsu[2]}, ;
                 {"ZA_DTREC", dHoje}, {"ZA_HRREC", cAgora}, {"ZA_DESCRI", "Envio cancelado: nenhum e-mail saiu"}})
            AP_DESTRAVAR(cOs)
            Return {.F., "Nenhum e-mail foi enviado ao cliente (" + AP_JUNTA(aEnv[2], ", ") + "). " + ;
                "A OS continua a enviar - confira o e-mail e envie de novo.", "", ""}
        EndIf
        AP_DESTRAVAR(cOs)
        cMsgEnv := "E-mail enviado para: " + AP_JUNTA(aEnv[1], ", ") + ;
            If(Empty(aEnv[2]), "", ". Falhou para: " + AP_JUNTA(aEnv[2], ", ")) + "."
        aRet := {.T., "", "N", cNovo, cMsgEnv}

    //--- Invalida o link: OS enviada e sem resposta mudou (interacao nova/excluida) - volta a "a enviar"
    Case cTrans == "INV"
        cOs  := xAlvo
        aRet := {.T., "", "", ""}
        If !AP_SZ1(cOs) .Or. Empty(SZ1->Z1_ENVDT) .Or. !Empty(AP_PEGAR(cOs, "N", "x"))
            Return aRet
        EndIf
        aUsu := AP_USUARIO()
        aRet := AP_GRAVAR(SZ1->Z1_OS, {{"Z1_ENVDT", ""}, {"Z1_ENVHR", ""}, {"Z1_OSENVCL", "N"}}, ;
            {{"ZA_APROVAD", "N"}, {"ZA_APVTIPO", ""}, {"ZA_POR", aUsu[1]}, {"ZA_EMAIL", aUsu[2]}, ;
             {"ZA_DTREC", dHoje}, {"ZA_HRREC", cAgora}, {"ZA_DESCRI", "Link invalidado: " + cMotivo}})
        AP_DESTRAVAR(cOs)
        If aRet[1]
            AP_AVISAR("INV", cOs, aUsu[1], cMotivo)
            aRet := {.T., "", "N", ""}
        EndIf

    //--- Consulta do link (pagina do cliente)
    Case cTrans == "CNS"
        aRet   := {.F., "INVALIDO", Nil}
        cToken := Lower(AllTrim(cValToChar(xAlvo)))
        If Len(cToken) != 64
            Return aRet
        EndIf
        cHash  := AP_HASH(cToken)
        cAlias := GetNextAlias()
        // Token da OS; vale se a linha dele for a ULTIMA da OS e ZA_VALID nao venceu.
        BeginSql Alias cAlias
            SELECT ZA.ZA_OS, ZA.ZA_VALID, ZA.ZA_SEQ,
                   (SELECT MAX(ZB.ZA_SEQ) FROM %Table:SZA% ZB
                     WHERE ZB.ZA_FILIAL = ZA.ZA_FILIAL AND ZB.ZA_OS = ZA.ZA_OS AND ZB.%NotDel%) ULTSEQ
            FROM %Table:SZA% ZA
            WHERE ZA.ZA_FILIAL = %xFilial:SZA%
              AND ZA.ZA_HASH = %Exp:cHash%
              AND ZA.%NotDel%
        EndSql
        If !(cAlias)->(Eof())
            cOs     := (cAlias)->ZA_OS
            lUltima := (cAlias)->ZA_SEQ == (cAlias)->ULTSEQ .And. SToD((cAlias)->ZA_VALID) >= dHoje
        EndIf
        (cAlias)->(DbCloseArea())
        If Empty(cOs) .Or. !AP_SZ1(cOs)
            Return aRet
        EndIf
        // Pela SZ1 primeiro (vale tambem pra OS do sistema antigo): link ja respondido = decidida (409).
        If AllTrim(SZ1->Z1_APROVAD) $ "S|R|A" .And. !Empty(SZ1->Z1_APROVAD)
            Return {.F., "DECIDIDA", Nil}
        EndIf
        If !lUltima
            Return aRet
        EndIf
        jOs := JsonObject():New()
        jOs["os"]        := AllTrim(SZ1->Z1_OS)
        // Mesmo nome do e-mail: reduzido, senao o completo.
        cNomeCli := AllTrim(Posicione("SA1", 1, xFilial("SA1") + SZ1->Z1_CLI + SZ1->Z1_LOJA, "A1_NREDUZ"))
        If Empty(cNomeCli)
            cNomeCli := AllTrim(Posicione("SA1", 1, xFilial("SA1") + SZ1->Z1_CLI + SZ1->Z1_LOJA, "A1_NOME"))
        EndIf
        jOs["cliente"]   := cNomeCli + " (Loja " + AllTrim(SZ1->Z1_LOJA) + ")"
        jOs["data"]      := DToC(SZ1->Z1_DTOS)
        jOs["horario"]   := apia.cnsa002.U_OS_APRPUB("HORARIO", SZ1->Z1_OS)   // "09:00 as 11:00" (a tela poe o acento)
        jOs["horas"]     := apia.cnsa002.U_OS_APRPUB("HORAS", SZ1->Z1_OS)
        jOs["analista"]  := AllTrim(Posicione("AA1", 1, xFilial("AA1") + SZ1->Z1_TEC, "AA1_NOMTEC"))
        jOs["projeto"]   := If(Empty(SZ1->Z1_PROJET), "", AllTrim(SZ1->Z1_PROJET) + " - " + AllTrim(Posicione("AF8", 1, xFilial("AF8") + SZ1->Z1_PROJET, "AF8_DESCRI")))
        jOs["tarefa"]    := apia.cnsa002.U_OS_APRPUB("TAREFA", SZ1->Z1_OS)
        jOs["chamadoCliente"] := AllTrim(SZ1->Z1_CHCLI)
        jOs["chamados"]  := apia.cnsa002.U_OS_APRPUB("CHAMADOS", SZ1->Z1_OS)
        jOs["descricao"] := apia.cnsa002.U_OS_APRPUB("DESCRICAO", SZ1->Z1_OS)
        // Interacoes desta OS (mais antiga primeiro).
        aCampos := apia.cnsa002.U_OS_APRPUB("INTERACOES", SZ1->Z1_OS)
        aJsInt  := {}
        For nI := 1 To Len(aCampos)
            jInt := JsonObject():New()
            jInt["data"]      := aCampos[nI][1]
            jInt["hora"]      := aCampos[nI][2]
            jInt["consultor"] := aCampos[nI][3]
            jInt["texto"]     := aCampos[nI][4]
            AAdd(aJsInt, jInt)
        Next nI
        jOs["interacoes"] := aJsInt
        aRet := {.T., "", jOs}

    //--- Legenda (aba Legenda - primeira que casar)
    Case cTrans == "LEG"
        aRet  := AP_LEGENDA(xAlvo)

    //--- Todas as legendas, na ordem - mesmos textos do AP_LEGENDA (o browse compara o texto)
    Case cTrans == "LEGS"
        aRet := {{"Aprovada (sistema antigo)", "verde"}, {"Enviada (sistema antigo)", "amarelo"}, ;
                 {"Nao requer aprovacao", "cinza"}, {"Pre-aprovada (sem aprovacao do cliente)", "azul"}, ;
                 {"Aguardando pre-aprovacao interna", "amarelo"}, {"Pre-recusada (interna)", "cinzaEscuro"}, ;
                 {"Recusada (cliente)", "rosa"}, ;
                 {"Recusada (manual)", "rosa"}, {"Recusada (legado)", "rosa"}, ;
                 {"Pre-aprovada, a enviar", "azul"}, {"A enviar ao cliente", "azul"}, ;
                 {"Aguardando cliente", "amarelo"}, {"Prazo vencido", "rosa"}, ;
                 {"Aprovada (cliente)", "verde"}, {"Aprovada (prazo)", "azul"}, ;
                 {"Aprovada (manual)", "azul"}, {"Aprovada", "verde"}}

    //--- Historico: a SZA inteira (todas as OS; com cOs, so ela) - todos os campos menos filial e hash
    //    do token, mais o evento pela mesma legenda do browse do historico (HA_LEGS) -> {aItens, aColunas}
    Case cTrans == "HIS"
        aRet   := {{}, {}}
        cOs    := AllTrim(cValToChar(xAlvo))
        // Oracle trata '' como NULL: flag "S" = todas as OS.
        cNovo  := If(Empty(cOs), "S", "N")
        cOs    := AP_VAL("ZA_OS", cOs)
        aLeg   := HA_LEGS()
        DbSelectArea("SZA")
        For nI := 1 To SZA->(FCount())
            If !(SZA->(FieldName(nI)) $ "ZA_FILIAL|ZA_HASH")
                AAdd(aRet[2], {SZA->(FieldName(nI)), AllTrim(GetSX3Cache(SZA->(FieldName(nI)), "X3_TITULO"))})
            EndIf
        Next nI
        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT ZA.R_E_C_N_O_ REC
            FROM %Table:SZA% ZA
            WHERE ZA.ZA_FILIAL = %xFilial:SZA%
              AND (%Exp:cNovo% = 'S' OR ZA.ZA_OS = %Exp:cOs%)
              AND ZA.%NotDel%
            ORDER BY ZA.ZA_OS DESC, ZA.ZA_SEQ
        EndSql
        While !(cAlias)->(Eof())
            SZA->(DbGoto((cAlias)->REC))
            jLin := JsonObject():New()
            jLin["evento"] := ""
            For nI := 1 To Len(aLeg)
                If &(aLeg[nI][1])
                    jLin["evento"] := aLeg[nI][4]
                    Exit
                EndIf
            Next nI
            For nI := 1 To Len(aRet[2])
                xVal := SZA->(FieldGet(FieldPos(aRet[2][nI][1])))
                jLin[aRet[2][nI][1]] := If(ValType(xVal) == "D", DToC(xVal), If(ValType(xVal) == "C", AllTrim(xVal), xVal))
            Next nI
            AAdd(aRet[1], jLin)
            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())

    //--- Estado que a regra daria (nao grava)
    Case cTrans == "REG"
        If ValType(xAlvo) == "C"
            If !AP_SZ1(xAlvo)
                Return {"N", ""}
            EndIf
            xAlvo := {SZ1->Z1_PROJET, SZ1->Z1_REVISA, SZ1->Z1_TAREFA}
        EndIf
        aTaf := AP_TAREFA(xAlvo[1], xAlvo[2], xAlvo[3])
        Do Case
        Case aTaf[1] == "S"   // AF9_APVMAN = S: pre-aprovacao interna
            aRet := {"P", "M"}
        Case aTaf[2] == "VB"
            aRet := {"A", ""}
        Otherwise
            aRet := {"N", ""}
        EndCase

    Otherwise
        aRet := {.F., "Transacao invalida: " + cTrans, "", ""}
    EndCase

Return aRet

/*/{Protheus.doc} AP_GRAVAR
Grava SZA (evento) e SZ1 (estado) na MESMA transacao - falhou uma, desfaz as duas.
@param  cOs    OS
@param  aSZ1   {{campo, valor}} da SZ1
@param  aSZA   {{campo, valor}} da linha nova da SZA
@return aRet   {lOk, cErro}
/*/
Static Function AP_GRAVAR(cOs, aSZ1, aSZA)
    Local aRet   := {.F., ""}
    Local bErro  := ErrorBlock({|e| Break(e)})
    Local oErro  := Nil
    Private __lA02Interno := .T.

    // Erro de execucao vira retorno (transacao desfeita; quem chamou destrava a OS).
    Begin Transaction
        Begin Sequence
            aRet := AP_GRAVASZA(cOs, aSZA)
            If aRet[1]
                aRet := apia.cnsa002.U_OS_APRPUB("GRAVAR", cOs, AP_VALORES(aSZ1))
            EndIf
        Recover Using oErro
            aRet := {.F., "Erro ao gravar a aprovacao: " + If(oErro != Nil, oErro:Description, "")}
        End Sequence
        If !aRet[1]
            DisarmTransaction()
        EndIf
    End Transaction
    ErrorBlock(bErro)

Return aRet

/*/{Protheus.doc} AP_GRAVASZA
Inclui uma linha na SZA pelo model FCNS004 (sem tela), com ZA_SEQ proximo da OS.
@param  cOs    OS
@param  aSZA   {{campo, valor}}
@return aRet   {lOk, cErro}
/*/
Static Function AP_GRAVASZA(cOs, aSZA)
    Local oAtivo := FWModelActive()
    Local oModel := HA_MONTARMODEL(MODEL_OPERATION_INSERT, .T.)
    Local oSZA   := oModel:GetModel("SZAMASTER")
    Local aVal   := AP_VALORES(aSZA)
    Local aRet   := {.T., ""}
    Local xErro  := Nil
    Local nI     := 0

    oSZA:LoadValue("ZA_FILIAL", xFilial("SZA"))
    oSZA:LoadValue("ZA_OS", AP_VAL("ZA_OS", AllTrim(cOs)))
    oSZA:LoadValue("ZA_SEQ", AP_PROXSEQ(cOs))
    For nI := 1 To Len(aVal)
        oSZA:LoadValue(aVal[nI][1], aVal[nI][2])
    Next nI

    If !(oModel:VldData() .And. oModel:CommitData())
        xErro := oModel:GetErrorMessage()
        aRet  := {.F., "Historico (SZA): " + If(ValType(xErro) == "A", FwJsonSerialize(xErro), cValToChar(xErro))}
    EndIf
    oModel:DeActivate()
    If oAtivo != Nil
        FWModelActive(oAtivo)
    EndIf

Return aRet

/*/{Protheus.doc} AP_VALORES
Ajusta cada {campo, valor} ao tipo/tamanho do dicionario (data, caractere).
@param  aCampos  {{campo, valor}}
@return aRet     {{campo, valor ajustado}}
/*/
Static Function AP_VALORES(aCampos)
    Local aRet := {}
    Local nI   := 0
    For nI := 1 To Len(aCampos)
        AAdd(aRet, {aCampos[nI][1], AP_VAL(aCampos[nI][1], aCampos[nI][2])})
    Next nI
Return aRet

/*/{Protheus.doc} AP_VAL
Valor no tipo e tamanho do campo: data vazia/texto, caractere cortado no tamanho.
/*/
Static Function AP_VAL(cCampo, xVal)
    Local cTipo := GetSX3Cache(cCampo, "X3_TIPO")
    Local nTam  := TamSX3(cCampo)[1]

    Do Case
    Case cTipo == "D"
        If ValType(xVal) == "C"
            xVal := If(Empty(xVal), CToD(""), SToD(xVal))
        EndIf
    Case cTipo == "N"
        xVal := If(ValType(xVal) == "N", xVal, Val(cValToChar(xVal)))
    Case cTipo == "C"
        xVal := If(ValType(xVal) == "D", DToS(xVal), cValToChar(xVal))
        If nTam < 5 .And. Len(AllTrim(xVal)) == 5 .And. SubStr(AllTrim(xVal), 3, 1) == ":"
            xVal := StrTran(AllTrim(xVal), ":", "")
        EndIf
        xVal := PadR(Left(xVal, nTam), nTam)
    EndCase

Return xVal

/*/{Protheus.doc} AP_ZERAR
Campos da aprovacao zerados na inclusao, na reavaliacao e na reabertura.
/*/
Static Function AP_ZERAR()
Return {"Z1_APVDOR", "Z1_APVMAIL", "Z1_APVIP", "Z1_APVDATA", "Z1_APVHORA", "Z1_ENVDT", "Z1_ENVHR", "Z1_APVOBS"}

/*/{Protheus.doc} AP_MUDOU
Campo que o cliente ve (e-mail e tela de aprovacao) e que o model mudou em relacao a SZ1 gravada.
@return cCampo  titulo do 1o campo alterado ("" se nenhum)
/*/
Static Function AP_MUDOU(oSZ1)
    Local aCampos := {"Z1_SERV", "Z1_DTOS", "Z1_HRINI", "Z1_HRFIM", "Z1_HRTOT", "Z1_TOTAL", "Z1_TRANS", "Z1_ALMOCO", ;
                      "Z1_CLI", "Z1_LOJA", "Z1_IDCH", "Z1_CHCLI", "Z1_TEC"}
    Local xNovo   := Nil
    Local xAntes  := Nil
    Local nI      := 0

    For nI := 1 To Len(aCampos)
        If SZ1->(FieldPos(aCampos[nI])) > 0 .And. oSZ1:GetStruct():HasField(aCampos[nI])
            xNovo  := oSZ1:GetValue(aCampos[nI])
            xAntes := SZ1->(FieldGet(FieldPos(aCampos[nI])))
            If If(ValType(xNovo) == "C", AllTrim(xNovo) != AllTrim(xAntes), xNovo != xAntes)
                Return AllTrim(GetSX3Cache(aCampos[nI], "X3_TITULO"))
            EndIf
        EndIf
    Next nI

Return ""

/*/{Protheus.doc} AP_UTF8
Acento UTF-8 que chega quebrado em 2 caracteres CP1252 (igual ao CH_DECODESAFE do CNSA001).
/*/
Static Function AP_UTF8(cTexto)
    Local cRet := ""
    Local nLen := Len(cTexto)
    Local nI   := 1
    Local nB1  := 0
    Local nB2  := 0

    While nI <= nLen
        nB1 := Asc(SubStr(cTexto, nI, 1))
        If (nB1 == 195 .Or. nB1 == 194) .And. nI < nLen
            nB2 := Asc(SubStr(cTexto, nI + 1, 1))
            If nB2 >= 128 .And. nB2 <= 191
                cRet += Chr(((nB1 - 192) * 64) + (nB2 - 128))
                nI   += 2
                Loop
            EndIf
        EndIf
        cRet += SubStr(cTexto, nI, 1)
        nI++
    EndDo

Return cRet

/*/{Protheus.doc} AP_SZ1
Posiciona a SZ1 na OS.
/*/
Static Function AP_SZ1(cOs)
    SZ1->(DbSetOrder(1))
Return !Empty(cOs) .And. SZ1->(DbSeek(cFilAnt + PadR(AllTrim(cOs), TamSX3("Z1_OS")[1])))

/*/{Protheus.doc} AP_RESPMAN
Administrador (AA1_RSPMNT = 1) - mesma regra do CH_TEMACESSOGRUPO (CNSA001).
/*/
Static Function AP_RESPMAN()
Return AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_RSPMNT")) == "1"

/*/{Protheus.doc} AP_USUARIO
Nome e e-mail do usuario logado (AA1; sem tecnico, o nome do usuario).
@return aRet  {cNome, cEmail}
/*/
Static Function AP_USUARIO()
    Local cNome := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_NOMTEC"))
    Local cMail := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_EMAIL"))
Return {If(Empty(cNome), AllTrim(UsrRetName(__cUserId)), cNome), cMail}

/*/{Protheus.doc} AP_TAREFA
AF9_APVMAN e AF9_UM da tarefa da OS.
@return aRet  {cApvMan, cUM}
/*/
Static Function AP_TAREFA(cProj, cRev, cTaf)
    Local cChave := xFilial("AF9") + PadR(AllTrim(cProj), TamSX3("AF9_PROJET")[1]) + ;
                    PadR(AllTrim(cRev), TamSX3("AF9_REVISA")[1]) + PadR(AllTrim(cTaf), TamSX3("AF9_TAREFA")[1])
    AF9->(DbSetOrder(1))
    If Empty(cTaf) .Or. !AF9->(DbSeek(cChave))
        Return {"", ""}
    EndIf
Return {Upper(AllTrim(AF9->AF9_APVMAN)), Upper(AllTrim(AF9->AF9_UM))}

/*/{Protheus.doc} AP_PROXSEQ
Proxima ZA_SEQ da OS (001, 002...).
/*/
Static Function AP_PROXSEQ(cOs)
    Local cAlias := GetNextAlias()
    Local cOsSZA := AP_VAL("ZA_OS", AllTrim(cOs))
    Local nSeq   := 0

    BeginSql Alias cAlias
        SELECT MAX(ZA_SEQ) SEQ
        FROM %Table:SZA% ZA
        WHERE ZA.ZA_FILIAL = %xFilial:SZA%
          AND ZA.ZA_OS = %Exp:cOsSZA%
          AND ZA.%NotDel%
    EndSql
    If !(cAlias)->(Eof())
        nSeq := Val(AllTrim((cAlias)->SEQ))
    EndIf
    (cAlias)->(DbCloseArea())

Return StrZero(nSeq + 1, TamSX3("ZA_SEQ")[1])

/*/{Protheus.doc} AP_PEGAR
Trava a OS (LockByName, ate ~5 s) e posiciona a SZ1 com Z1_APROVAD = cEstado; senao destrava.
@return cErro  "" se pegou; senao a mensagem
/*/
Static Function AP_PEGAR(cOs, cEstado, cMsg)
    Local nI := 0

    For nI := 1 To 25
        If LockByName("CNSAPR_" + AllTrim(cOs), .T., .F.)
            Exit
        EndIf
        Sleep(200)
    Next nI
    If nI > 25
        Return "OS em uso por outra aprovacao. Tente novamente."
    EndIf
    If !AP_SZ1(cOs) .Or. AllTrim(SZ1->Z1_APROVAD) != cEstado
        AP_DESTRAVAR(cOs)
        Return cMsg
    EndIf

Return ""

Static Function AP_DESTRAVAR(cOs)
    UnLockByName("CNSAPR_" + AllTrim(cOs), .T., .F.)
Return

/*/{Protheus.doc} AP_TXT
Texto de um JsonObject (vazio se nao veio).
/*/
Static Function AP_TXT(jDados, cChave)
    Local xVal := Nil
    If ValType(jDados) != "J" .And. ValType(jDados) != "O"
        Return ""
    EndIf
    xVal := jDados[cChave]
Return If(xVal == Nil, "", AllTrim(cValToChar(xVal)))

/*/{Protheus.doc} AP_ERRO
Resposta de erro dos endpoints: {"erro": cMsg}.
/*/
Static Function AP_ERRO(nStatus, cMsg)
    Local oJson := JsonObject():New()

    oJson["erro"] := cMsg
Return oRest:setStatusResponse(nStatus, oJson:ToJson())

/*/{Protheus.doc} AP_HASH
SHA-256 em hexa minusculo (igual ao hash('sha256') do PHP).
/*/
Static Function AP_HASH(cTexto)
    Local cRet  := SHA256(cTexto)
    Local cHex  := ""
    Local nI    := 0
    Local nByte := 0

    // Se vier binario (32 bytes), converte pra hexa.
    If Len(cRet) != 64
        For nI := 1 To Len(cRet)
            nByte := Asc(SubStr(cRet, nI, 1))
            cHex  += SubStr("0123456789abcdef", Int(nByte / 16) + 1, 1) + SubStr("0123456789abcdef", (nByte % 16) + 1, 1)
        Next nI
        cRet := cHex
    EndIf

Return Lower(cRet)

/*/{Protheus.doc} AP_LEGENDA
Legenda da OS (aba Legenda, primeira que casar). Prazo = envio + MV_CNSAPRZ. OS digitada antes
de MV_CNSAINI segue o significado antigo ("A" aprovada, N com envio = enviada pelo sistema antigo).
@param  aDados  {cAprovad, cApvTipo, xApvData, xEnvDt, xDtDigit}
@return aRet    {cLegenda, cCor}
/*/
Static Function AP_LEGENDA(aDados)
    Local cAp   := AllTrim(cValToChar(aDados[1]))
    Local cTp   := AllTrim(cValToChar(aDados[2]))
    Local lApv  := !Empty(aDados[3])
    Local dEnv  := If(ValType(aDados[4]) == "D", aDados[4], SToD(AllTrim(cValToChar(aDados[4]))))
    Local xDig  := If(Len(aDados) >= 5, aDados[5], "")
    Local cDig  := If(ValType(xDig) == "D", DToS(xDig), AllTrim(cValToChar(xDig)))
    Local lAnt  := !Empty(cDig) .And. cDig < AllTrim(SuperGetMV("MV_CNSAINI", .F., "20261014"))

    Do Case
    Case lAnt .And. cAp == "A"
        Return {"Aprovada (sistema antigo)", "verde"}
    Case lAnt .And. cAp == "N" .And. !lApv .And. !Empty(dEnv)
        Return {"Enviada (sistema antigo)", "amarelo"}
    Case cAp == "A" .And. Empty(cTp)
        Return {"Nao requer aprovacao", "cinza"}
    Case cAp == "A" .And. cTp == "M"
        Return {"Pre-aprovada (sem aprovacao do cliente)", "azul"}
    Case cAp == "P"
        Return {"Aguardando pre-aprovacao interna", "amarelo"}
    // Pre-recusa (M) = interna (aba Legenda, linha 4); recusa pelo link (W) = cliente; manual (I) = manual.
    Case cAp == "R" .And. cTp == "M" .And. lApv
        Return {"Pre-recusada (interna)", "cinzaEscuro"}
    Case cAp == "R" .And. cTp == "W" .And. lApv
        Return {"Recusada (cliente)", "rosa"}
    Case cAp == "R" .And. cTp == "I" .And. lApv
        Return {"Recusada (manual)", "rosa"}
    Case cAp == "N" .And. lApv
        Return {"Recusada (legado)", "rosa"}
    Case cAp == "N" .And. cTp == "M" .And. Empty(dEnv)
        Return {"Pre-aprovada, a enviar", "azul"}
    Case cAp == "N" .And. Empty(cTp) .And. Empty(dEnv)
        Return {"A enviar ao cliente", "azul"}
    Case cAp == "N" .And. Date() <= dEnv + SuperGetMV("MV_CNSAPRZ", .F., 2)
        Return {"Aguardando cliente", "amarelo"}
    Case cAp == "N"
        Return {"Prazo vencido", "rosa"}
    Case cAp == "S" .And. cTp == "W"
        Return {"Aprovada (cliente)", "verde"}
    Case cAp == "S" .And. cTp == "D"
        Return {"Aprovada (prazo)", "azul"}
    Case cAp == "S" .And. cTp == "I"
        Return {"Aprovada (manual)", "azul"}
    Case cAp == "S"
        Return {"Aprovada", "verde"}
    EndCase

Return {"", ""}

/*/{Protheus.doc} AP_ENVIAR
E-mail do envio: resumo da OS + botao com o link. Endereco invalido nem vai pro Graph.
@return aRet  {aEnviados, aFalhas} - falha vem com o motivo: "x (e-mail invalido)"
/*/
Static Function AP_ENVIAR(cOs, aPara, cToken, dValid)
    Local aOk   := {}
    Local aErro := {}
    Local cPara := ""
    Local aLin  := apia.cnsa002.U_OS_APRPUB("RESUMO", cOs)
    Local cDesc := AP_DESCHTML(cOs)
    Local cUrl  := AllTrim(SuperGetMV("MV_CNSAURL", .F., "https://www.apia.com.br/Aprovador-OS"))
    Local cLink := ""
    Local cObs  := ""
    Local nI    := 0

    // Sem a barra final; MV_CNSAURL .../aprovacao -> .../aprovacao/<token>, outra pagina -> ?t=<token>.
    While Right(cUrl, 1) == "/"
        cUrl := Left(cUrl, Len(cUrl) - 1)
    EndDo
    cLink := cUrl + If("/aprovacao" $ Lower(cUrl), "/", "/?t=") + cToken
    cObs := '<div style="text-align:center;margin:8px 0 16px">' + ;
        '<a href="' + cLink + '" style="display:inline-block;background-color:#1a7fc1;color:#ffffff;' + ;
        'font-size:15px;font-weight:bold;padding:12px 28px;border-radius:6px;text-decoration:none">' + ;
        'Aprovar ou recusar a OS</a><br><span style="font-size:12px;color:#6b7280">Link v&aacute;lido at&eacute; ' + ;
        DToC(dValid) + '</span></div>Qualquer d&uacute;vida, entre em contato: <b>pericles@apia.com.br</b>'

    For nI := 1 To Len(aPara)
        cPara := AllTrim(aPara[nI])
        If !AP_EMAILOK(cPara)
            AAdd(aErro, cPara + " (e-mail invalido)")
        ElseIf apia.cnsa001.U_CH_MAILPUB(cPara, "Aprovacao da Ordem de Servico " + AllTrim(cOs), ;
                apia.cnsa001.U_CH_HTMLPUB("", "Aprova&ccedil;&atilde;o da Ordem de Servi&ccedil;o " + AllTrim(cOs), "", ;
                    "Segue o resumo do atendimento realizado. Confira e responda pelo bot&atilde;o abaixo.", ;
                    aLin, "Descri&ccedil;&atilde;o", cDesc, cObs))
            AAdd(aOk, cPara)
        Else
            AAdd(aErro, cPara + " (falha no envio)")
        EndIf
    Next nI

Return {aOk, aErro}

/*/{Protheus.doc} AP_DESCHTML
Descricao da OS e, depois dela, as interacoes (mais antiga primeiro) - corpo dos e-mails ao cliente.
/*/
Static Function AP_DESCHTML(cOs)
    Local cDesc := U_CNSOUTL("TEXTO", apia.cnsa002.U_OS_APRPUB("DESCRICAO", cOs))
    Local aInt  := apia.cnsa002.U_OS_APRPUB("INTERACOES", cOs)
    Local nI    := 0

    For nI := 1 To Len(aInt)
        cDesc += If(nI == 1, '<div style="color:#0d5a8a;font-size:18px;font-weight:bold;padding:16px 0 8px">Intera&ccedil;&otilde;es</div>', "") + ;
            '<div style="padding-bottom:10px"><b>' + aInt[nI][1] + " " + aInt[nI][2] + " - " + U_CNSOUTL("TEXTO", aInt[nI][3]) + '</b><br>' + ;
            StrTran(StrTran(U_CNSOUTL("TEXTO", aInt[nI][4]), Chr(13) + Chr(10), "<br>"), Chr(10), "<br>") + '</div>'
    Next nI

Return cDesc

/*/{Protheus.doc} AP_EMAILOK
Formato minimo de e-mail: algo@dominio.ext, sem espaco.
/*/
Static Function AP_EMAILOK(cEmail)
    Local nArr := At("@", cEmail)
Return nArr > 1 .And. !(" " $ cEmail) .And. "." $ SubStr(cEmail, nArr + 2) .And. Right(cEmail, 1) != "."

/*/{Protheus.doc} AP_JUNTA
Junta um array de texto com o separador.
/*/
Static Function AP_JUNTA(aLista, cSep)
    Local cRet := ""
    Local nI   := 0
    For nI := 1 To Len(aLista)
        cRet += If(nI > 1, cSep, "") + aLista[nI]
    Next nI
Return cRet

/*/{Protheus.doc} AP_AVISAR
E-mail da decisao (APR/REC) ao cliente, tecnico e MV_CNSACCO. Falha de e-mail nao desfaz nada.
/*/
Static Function AP_AVISAR(cTrans, cOs, cQuem, cMotivo)
    Local aPara    := {}
    Local aCco     := {}
    Local aLin     := {}
    Local cCliente := ""
    Local cAcao    := If(cTrans == "APR", "aprovada", "recusada")
    Local cCorpo   := ""
    Local nI       := 0

    If !AP_SZ1(cOs)
        Return
    EndIf
    cCliente := AllTrim(Posicione("SA1", 1, xFilial("SA1") + SZ1->Z1_CLI + SZ1->Z1_LOJA, "A1_NOME"))
    aLin     := apia.cnsa002.U_OS_APRPUB("RESUMO", cOs)

    // Link invalidado: so o cliente (e o controle) - ele vai receber um link novo.
    If cTrans == "INV"
        aPara := apia.cnsa002.U_OS_APRPUB("DESTINO", cOs)
        aCco  := StrTokArr2(AllTrim(SuperGetMV("MV_CNSACCO", .F., "")), ";", .F.)
        For nI := 1 To Len(aCco)
            AAdd(aPara, AllTrim(aCco[nI]))
        Next nI
        For nI := 1 To Len(aPara)
            If !Empty(aPara[nI]) .And. AScan(aPara, aPara[nI]) == nI
                apia.cnsa001.U_CH_MAILPUB(aPara[nI], FwNoAccent(cCliente) + " - Alterada O.S. n. " + AllTrim(cOs), ;
                    apia.cnsa001.U_CH_HTMLPUB("", "OS " + AllTrim(cOs) + " alterada", "", ;
                        "A ordem de servi&ccedil;o foi alterada depois do envio para aprova&ccedil;&atilde;o. " + ;
                        "O link enviado antes n&atilde;o vale mais: voc&ecirc; vai receber um novo link.", aLin, "", "", ""))
            EndIf
        Next nI
        Return
    EndIf
    AAdd(aLin, {If(cTrans == "APR", "Aprovada por", "Recusada por"), U_CNSOUTL("TEXTO", cQuem)})
    AAdd(aLin, {"Em", DToC(Date()) + " &agrave;s " + Left(Time(), 5)})

    // Motivo (quando tem) e depois a descricao com as interacoes, igual ao e-mail do envio.
    If !Empty(cMotivo)
        cCorpo := '<b>' + If(cTrans == "REC", "Motivo da recusa", "Observa&ccedil;&atilde;o do cliente") + ':</b> ' + ;
            U_CNSOUTL("TEXTO", cMotivo) + '<br><br>'
    EndIf
    cCorpo += AP_DESCHTML(cOs)

    aPara := apia.cnsa002.U_OS_APRPUB("DESTINO", cOs)
    AAdd(aPara, AllTrim(Posicione("AA1", 1, xFilial("AA1") + SZ1->Z1_TEC, "AA1_EMAIL")))
    aCco := StrTokArr2(AllTrim(SuperGetMV("MV_CNSACCO", .F., "")), ";", .F.)
    For nI := 1 To Len(aCco)
        AAdd(aPara, AllTrim(aCco[nI]))
    Next nI

    For nI := 1 To Len(aPara)
        If !Empty(aPara[nI]) .And. AScan(aPara, aPara[nI]) == nI
            apia.cnsa001.U_CH_MAILPUB(aPara[nI], FwNoAccent(cCliente) + " - " + If(cTrans == "APR", "Aprovada", "Recusada") + ;
                " O.S. n. " + AllTrim(cOs), ;
                apia.cnsa001.U_CH_HTMLPUB("", "OS " + AllTrim(cOs) + " " + cAcao, "", ;
                    "A ordem de servi&ccedil;o foi " + cAcao + ".", aLin, "Descri&ccedil;&atilde;o", cCorpo, ""))
        EndIf
    Next nI

Return

/*/{Protheus.doc} CNSAPJOB
Schedule (apia.cnsa004.U_CNSAPJOB): OS em N cuja ultima linha da SZA e envio com prazo vencido
(ZA_PRAZO < hoje) -> U_CNSAPR("APR", cOs, "D").
/*/
User Function CNSAPJOB()
    Local cAlias := ""
    Local cHoje  := ""
    Local aRet   := {}
    Local nOk    := 0
    // Pelo Schedule o ambiente ja vem aberto: so abre (e fecha) rodando a mao.
    Local lAbriu := Select("SX6") == 0

    If lAbriu
        RpcSetType(3)
        If !RpcSetEnv("01", "01", , , "SIGAFAT", , {"SZ1", "SZA"})
            ConOut("CNSAPJOB: falha no RpcSetEnv - job abortado.")
            Return
        EndIf
    EndIf

    cHoje  := DToS(Date())
    cAlias := GetNextAlias()
    BeginSql Alias cAlias
        SELECT ZA.ZA_OS
        FROM %Table:SZA% ZA
        INNER JOIN %Table:SZ1% Z1
                ON Z1.Z1_FILIAL = %xFilial:SZ1%
               AND TRIM(Z1.Z1_OS) = TRIM(ZA.ZA_OS)
               AND Z1.Z1_APROVAD = 'N'
               AND Z1.%NotDel%
        WHERE ZA.ZA_FILIAL = %xFilial:SZA%
          AND ZA.%NotDel%
          AND TRIM(ZA.ZA_ENVDT) IS NOT NULL
          AND ZA.ZA_PRAZO < %Exp:cHoje%
          AND ZA.ZA_SEQ = (SELECT MAX(ZB.ZA_SEQ) FROM %Table:SZA% ZB
                           WHERE ZB.ZA_FILIAL = ZA.ZA_FILIAL AND ZB.ZA_OS = ZA.ZA_OS AND ZB.%NotDel%)
    EndSql
    While !(cAlias)->(Eof())
        aRet := U_CNSAPR("APR", (cAlias)->ZA_OS, "D")
        If aRet[1]
            nOk++
        Else
            ConOut("CNSAPJOB: OS " + AllTrim((cAlias)->ZA_OS) + " nao aprovada por prazo: " + aRet[2])
        EndIf
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

    ConOut("CNSAPJOB: " + cValToChar(nOk) + " OS aprovada(s) por prazo.")
    If lAbriu
        RpcClearEnv()
    EndIf

Return

/*/{Protheus.doc} CNSAP_API
POST /CNSAPR?os=&trans=PRE|PRR|APR|REC|ENV&motivo= (usuario logado, Basic).
Origem: PRE/PRR = M; APR/REC = I (manual).
/*/
@Post(endpoint="/CNSAPR")
User Function CNSAP_API() As Logical
    Local jQuery := oRest:getQueryRequest() As Json
    Local cTrans := Upper(AP_TXT(jQuery, "trans"))
    Local cOs    := AP_TXT(jQuery, "os")
    Local jDados := JsonObject():New()
    Local aRet   := {}
    Local oJson  := JsonObject():New()

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return AP_ERRO(403, "Usuario sem acesso a este recurso.")
    EndIf

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    If !(cTrans $ "PRE|PRR|APR|REC|ENV") .Or. Len(cTrans) != 3 .Or. Empty(cOs)
        Return AP_ERRO(400, "Informe os e trans (PRE, PRR, APR, REC ou ENV).")
    EndIf
    jDados["motivo"] := AP_TXT(jQuery, "motivo")

    aRet := U_CNSAPR(cTrans, cOs, If(cTrans $ "PRE|PRR", "M", If(cTrans == "ENV", "", "I")), jDados)
    If !aRet[1]
        Return AP_ERRO(400, aRet[2])
    EndIf
    oJson["sucesso"] := .T.
    oJson["os"]      := cOs
    oJson["aprovad"] := aRet[3]
    oJson["apvtipo"] := aRet[4]
    // ENV: "E-mail enviado para: ... Falhou para: ..."
    If Len(aRet) >= 5
        oJson["mensagem"] := aRet[5]
    EndIf

Return oRest:setStatusResponse(200, oJson:ToJson())

/*/{Protheus.doc} CNSAP_HIS
GET /CNSAPR[?os=] - SZA completa (todas as OS, ou so a informada) para o portal: items + colunas {campo, titulo}.
/*/
@Get(endpoint="/CNSAPR")
User Function CNSAP_HIS() As Logical
    Local jQuery := oRest:getQueryRequest() As Json
    Local cOs    := AP_TXT(jQuery, "os")
    Local oJson  := JsonObject():New()
    Local jCol   := Nil
    Local aCols  := {}
    Local aRet   := {}
    Local nI     := 0

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return AP_ERRO(403, "Usuario sem acesso a este recurso.")
    EndIf
    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    // Sem os: a SZA inteira (todas as OS).
    aRet := U_CNSAPR("HIS", cOs)
    oJson["os"]      := cOs
    oJson["items"]   := aRet[1]
    For nI := 1 To Len(aRet[2])
        jCol := JsonObject():New()
        jCol["campo"]  := aRet[2][nI][1]
        jCol["titulo"] := aRet[2][nI][2]
        AAdd(aCols, jCol)
    Next nI
    oJson["colunas"] := aCols

Return oRest:setStatusResponse(200, oJson:ToJson())

/*/{Protheus.doc} CNSAAP_GET
GET /CNSAAPROVA?token= - pagina do cliente (Aprovador-OS) consulta o link.
404 = invalido/expirado/usado (resposta generica); 409 = OS ja decidida.
/*/
@Get(endpoint="/CNSAAPROVA")
User Function CNSAAP_GET() As Logical
    Local jQuery := oRest:getQueryRequest() As Json
    Local aRet   := U_CNSAPR("CNS", AP_TXT(jQuery, "token"))

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    If !aRet[1]
        Return AP_ERRO(If(aRet[2] == "DECIDIDA", 409, 404), aRet[2])
    EndIf

Return oRest:setStatusResponse(200, aRet[3]:ToJson())

/*/{Protheus.doc} CNSAAP_POST
POST /CNSAAPROVA?token=&decisao=APR|REC&motivo= - resposta do cliente (origem W).
IP: X-Forwarded-For / X-Real-IP, senao oRest:getClientIP(); nunca da query (o navegador mandaria qualquer valor).
/*/
@Post(endpoint="/CNSAAPROVA")
User Function CNSAAP_POST() As Logical
    Local jQuery   := oRest:getQueryRequest() As Json
    Local cDecisao := Upper(AP_TXT(jQuery, "decisao"))
    Local aCns     := U_CNSAPR("CNS", AP_TXT(jQuery, "token"))
    Local jDados   := JsonObject():New()
    Local jHead    := oRest:getHeaderRequest()
    Local aNomes   := {}
    Local aIps     := {}
    Local aRet     := {}
    Local nI       := 0
    Local oJson    := JsonObject():New()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    If !aCns[1]
        Return AP_ERRO(If(aCns[2] == "DECIDIDA", 409, 404), aCns[2])
    EndIf
    If cDecisao != "APR" .And. cDecisao != "REC"
        Return AP_ERRO(400, "Decisao invalida.")
    EndIf

    jDados["motivo"] := AP_TXT(jQuery, "motivo")
    jDados["ip"]     := ""
    If ValType(jHead) == "J" .Or. ValType(jHead) == "O"
        aNomes := jHead:GetNames()
        For nI := 1 To Len(aNomes)
            If (Lower(aNomes[nI]) == "x-forwarded-for" .Or. Lower(aNomes[nI]) == "x-real-ip") .And. ;
                    !Empty(jHead[aNomes[nI]]) .And. Empty(jDados["ip"])
                aIps := StrTokArr2(cValToChar(jHead[aNomes[nI]]), ",", .F.)
                jDados["ip"] := AllTrim(aIps[1])
            EndIf
        Next nI
    EndIf
    If Empty(jDados["ip"])
        jDados["ip"] := AllTrim(cValToChar(oRest:getClientIP()))
    EndIf

    aRet := U_CNSAPR(cDecisao, aCns[3]["os"], "W", jDados)
    If !aRet[1]
        Return AP_ERRO(If("decidida" $ aRet[2], 409, 400), aRet[2])
    EndIf
    oJson["sucesso"] := .T.
    oJson["os"]      := aCns[3]["os"]
    oJson["aprovad"] := aRet[3]

Return oRest:setStatusResponse(200, oJson:ToJson())
