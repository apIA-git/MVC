#Include "FWMVCDef.ch"
#Include "Totvs.ch"
#Include "TopConn.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"

// Marcador de bloco de interacao no Memo Z1_SERV.
#Define OS_MARCA "=== INTERACAO "

Namespace apia.cnsa002

// CNSA002 - Ordem de servico (SZ1): tela classica, REST do portal e aprovacao. Henrique, 09-10/2026.

/*/{Protheus.doc} CNS002
Browse da OS (SZ1) com a legenda da aprovacao.
/*/
User Function CNS002()

    Local l_oBrowse := Nil
    Local aLeg      := apia.cnsa004.U_CNSAPR("LEGS")
    Local nI        := 0
    // Mesmo namespace: precisa do prefixo "u_".
    Private aRotina := u_MenuDef()

    l_oBrowse := FWMBrowse():New()
    If l_oBrowse <> Nil

        l_oBrowse:SetDescription("OS - APIA")
        l_oBrowse:SetAlias("SZ1")

        // Legenda da aprovacao = coluna Aprovacao do portal (U_CNSAPR "LEG").
        For nI := 1 To Len(aLeg)
            l_oBrowse:AddLegend("apia.cnsa004.U_CNSAPR('LEG',{SZ1->Z1_APROVAD,SZ1->Z1_APVTIPO,SZ1->Z1_APVDATA,SZ1->Z1_ENVDT,SZ1->Z1_DTDIGIT})[1]=='" + ;
                aLeg[nI][1] + "'", OS_CORAPR(aLeg[nI][2])[1], aLeg[nI][1])
        Next nI
        l_oBrowse:AddLegend(".T.", "WHITE", "Sem aprovacao (legado)")

        l_oBrowse:Activate()

    EndIf

Return

/*/{Protheus.doc} MenuDef
Menu do browse da OS.
@return aRotina   Array de opcoes de menu (ADD OPTION)
/*/
User Function MenuDef()

Local aRotina  := {}

    ADD OPTION aRotina TITLE "Pesquisar"    ACTION "AxPesqui"                        OPERATION 1 ACCESS 0
    ADD OPTION aRotina TITLE "Visualizar"   ACTION "apia.cnsa002.U_OS_TELA(1)"       OPERATION 2 ACCESS 0
    ADD OPTION aRotina TITLE "Incluir"      ACTION "apia.cnsa002.U_OS_TELA(3)"       OPERATION 3 ACCESS 0
    ADD OPTION aRotina TITLE "Alterar"      ACTION "apia.cnsa002.U_OS_TELA(4)"       OPERATION 4 ACCESS 0
    ADD OPTION aRotina TITLE "Excluir"      ACTION "apia.cnsa002.U_OS_TELA(5)"       OPERATION 5 ACCESS 0
    ADD OPTION aRotina TITLE "Copiar"       ACTION "apia.cnsa002.U_OS_COPIARTELA"    OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Legenda"      ACTION "apia.cnsa002.U_OS_LEGENDA"       OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Historico Aprovacao" ACTION "apia.cnsa004.U_CNS004(SZ1->Z1_OS)" OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Enviar ao cliente" ACTION "apia.cnsa002.U_OS_APRTELA('ENV')" OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Pre-aprovar"       ACTION "apia.cnsa002.U_OS_APRTELA('PRE')" OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Pre-recusar"       ACTION "apia.cnsa002.U_OS_APRTELA('PRR')" OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Aprovar OS"        ACTION "apia.cnsa002.U_OS_APRTELA('APR')" OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Recusar OS"        ACTION "apia.cnsa002.U_OS_APRTELA('REC')" OPERATION 0 ACCESS 0

Return aRotina

/*/{Protheus.doc} ViewDef
View da OS: cabecalho SZ1 e grid SZ2 (horas contratadas).
@return l_oView   Objeto FWFormView montado (ou Nil se o Model nao carregar)
/*/
User Function ViewDef()

    Local l_oView    := Nil
    // FWLoadModel nao acha o model dentro do Namespace: usa o ativo.
    Local l_oModel   := FWModelActive()
    Local l_oStruSZ1 := FWFormStruct(2, "SZ1")
    Local l_oStruSZ2 := FWFormStruct(2, "SZ2")

    // Sem model ativo, ou ativo de outra rotina: monta o da OS (Nil = "Undefined View").
    If l_oModel == Nil .Or. l_oModel:GetId() != "FCNS002"
        l_oModel := OS_MONTARMODEL()
    EndIf

    l_oView := FWFormView():New()
    l_oView:SetModel(l_oModel)

    l_oView:AddField("VIEW_SZ1", l_oStruSZ1, "SZ1MASTER")
    l_oView:AddGrid("VIEW_SZ2",  l_oStruSZ2, "SZ2DETAIL")

    l_oView:CreateHorizontalBox("CABEC", 60)
    l_oView:CreateHorizontalBox("GRID",  40)

    l_oView:SetOwnerView("VIEW_SZ1", "CABEC")
    l_oView:SetOwnerView("VIEW_SZ2", "GRID")

    l_oView:EnableTitleView("VIEW_SZ1", "Dados da OS")
    l_oView:EnableTitleView("VIEW_SZ2", "Horas Contratadas")

    l_oView:SetCloseOnOk({||.T.})

Return l_oView

/*/{Protheus.doc} ModelDef
Model da OS - ver OS_MONTARMODEL.
/*/
User Function ModelDef()

Return OS_MONTARMODEL()

/*/{Protheus.doc} OS_MONTARMODEL
Model da OS (SZ1 + SZ2). Com nOperAtivar tambem ativa, NA MESMA funcao: ativar em
outro frame quebra o INITVALUE com "owner private environment not found".
@param  nOperAtivar    Operacao pra ja ativar (MODEL_OPERATION_*) - vazio = so monta
@param  bTela          Tela (FWExecView) aberta AQUI, depois de ativar: o FWInitCpo so funciona enquanto a
                       funcao que instanciou o model esta na pilha (TDN DSFIN-4587, igual ao CH_MONTARMODEL)
@return l_oModel       Objeto MPFormModel montado
/*/
Static Function OS_MONTARMODEL(nOperAtivar, bTela)

    Local l_oModel  := Nil
    Local l_oStrSZ1 := FWFormStruct(1, "SZ1")
    Local l_oStrSZ2 := FWFormStruct(1, "SZ2")
    Local aRelSZ2   := {}
    Local cTec      := ""

    Default nOperAtivar := 0

    // Representante, descricao e analista opcionais, mesmo se o dicionario marcar obrigatorio.
    l_oStrSZ1:SetProperty("Z1_USR", MODEL_FIELD_OBRIGAT, .F.)
    l_oStrSZ1:SetProperty("Z1_SERV", MODEL_FIELD_OBRIGAT, .F.)
    l_oStrSZ1:SetProperty("Z1_TEC", MODEL_FIELD_OBRIGAT, .F.)

    // OS_PREVALIDA na pos-validacao (ao confirmar), nao no bPre: o bPre roda a cada SetValue, antes do valor
    // entrar, e a lupa do cliente recusava o proprio campo ("Informe o cliente e o site do cliente").
    l_oModel := MPFormModel():New(;
        "FCNS002",;
        NIL,;
        {|oModel| OS_PREVALIDA(oModel) .And. OS_VALIDACOBRAR(oModel)})

    // Sem validacao por campo na tela (igual ao chamado): o OS_VALIDACAMPO recusava campo obrigatorio vazio a
    // cada acao do campo e a lupa nao pesquisava. Obrigatorios: dicionario + OS_PREVALIDA ao confirmar.
    l_oModel:AddFields(;
        "SZ1MASTER",;
        NIL,;
        l_oStrSZ1,;
        NIL,;
        NIL)

    // SZ2 (horas contratadas) e relacionada por CLIENTE, nao por OS.
    l_oModel:AddGrid("SZ2DETAIL", "SZ1MASTER", l_oStrSZ2)
    aAdd(aRelSZ2, {"Z2_CODCLI", "Z1_CLI"})
    aAdd(aRelSZ2, {"Z2_LOJA",   "Z1_LOJA"})
    l_oModel:SetRelation("SZ2DETAIL", aRelSZ2, SZ2->(IndexKey(2)))

    l_oModel:SetPrimaryKey({"Z1_FILIAL","Z1_OS"})
    l_oModel:InstallEvent("CNS002APR", /*cOwner*/, CNS002APR():New())

    If nOperAtivar > 0
        l_oModel:SetOperation(nOperAtivar)
        l_oModel:Activate()
        // Numero AA + sequencia do ano no lugar do inicializador (LoadValue: Z1_OS nao e editavel).
        If nOperAtivar == 3
            l_oModel:GetModel("SZ1MASTER"):LoadValue("Z1_OS", OS_PROXIMONUM())
            // Analista = tecnico do usuario logado (pode trocar na tela).
            cTec := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC"))
            If !Empty(cTec)
                l_oModel:GetModel("SZ1MASTER"):LoadValue("Z1_TEC", cTec)
                // Mesmo nome do dicionario (AA1_NOMRED), no tamanho exato do campo (senao FWNOWIDTH).
                l_oModel:GetModel("SZ1MASTER"):LoadValue("Z1_NMTEC", PadR(Left(AllTrim(Posicione("AA1", 1, xFilial("AA1") + PadR(cTec, TamSX3("AA1_CODTEC")[1]), "AA1_NOMRED")), TamSX3("Z1_NMTEC")[1]), TamSX3("Z1_NMTEC")[1]))
            EndIf
        EndIf
        If bTela <> Nil
            Eval(bTela, l_oModel)
        EndIf
    EndIf

Return l_oModel

/*/{Protheus.doc} OS_VALIDACAMPO
Pos-validacao dos campos da SZ1: obrigatorio vazio reprova.
@param  p_oField   Objeto do campo (FormField) que disparou a validacao
@param  p_sAcao    Acao/evento que disparou a validacao
@param  p_sCampo   Nome do campo (SX3) sendo validado
@param  p_vValor   Valor atual do campo
@return l_bOk      .T. se valido, .F. se o campo obrigatorio estiver vazio
/*/
Static Function OS_VALIDACAMPO(p_oField, p_sAcao, p_sCampo, p_vValor)
    Local l_bOk := .T.
    // Z1_USR, Z1_SERV e Z1_TEC sao opcionais.
    Local aObrigatorios := {"Z1_CLI", "Z1_LOJA", "Z1_MODULO", "Z1_MOTIV", ;
        "Z1_TIPO", "Z1_DTOS", "Z1_INI", "Z1_FIM", "Z1_TOTAL"}

    // Gravacao da aprovacao (U_CNSAPR): nao barra por campo antigo vazio.
    If Type("__lA02Interno") == "L" .And. __lA02Interno
        Return .T.
    EndIf

    If AScan(aObrigatorios, p_sCampo) > 0 .And. Empty(p_vValor)
        l_bOk := .F.
    EndIf

Return l_bOk

/*/{Protheus.doc} OS_PREVALIDA
Inclusao: confere os obrigatorios. Chamado TOTVS exige
Chamado Cliente ou Chamado Apia (incluir e alterar).
@param  p_oModel   Objeto do Model (FormModel) sendo validado
@return lOk        .T. se valido
/*/
Static Function OS_PREVALIDA(p_oModel)
    Local oModelSZ1 := p_oModel:GetModel("SZ1MASTER")
    Local aCampos   := {{"Z1_MODULO", "Informe o modulo."}, {"Z1_MOTIV", "Informe o motivo."}, ;
                        {"Z1_TIPO", "Informe o codigo do servico."}, {"Z1_DTOS", "Informe a data da OS."}}
    Local nI        := 0

    // Chamado TOTVS so com Chamado Cliente ou Chamado Apia (gravacao da aprovacao nao barra).
    If (p_oModel:GetOperation() == 3 .Or. p_oModel:GetOperation() == 4) .And. ;
            !(Type("__lA02Interno") == "L" .And. __lA02Interno) .And. !Empty(oModelSZ1:GetValue("Z1_CHTOTVS")) .And. ;
            Empty(oModelSZ1:GetValue("Z1_IDCH")) .And. Empty(oModelSZ1:GetValue("Z1_CHPSD"))
        p_oModel:SetErrorMessage("SZ1MASTER", "Z1_CHTOTVS", "SZ1", "Z1_CHTOTVS", "CNSA002", "Chamado TOTVS exige Chamado Cliente ou Chamado Apia.")
        Return .F.
    EndIf
    If p_oModel:GetOperation() != 3
        Return .T.
    EndIf
    If Empty(oModelSZ1:GetValue("Z1_CLI")) .Or. Empty(oModelSZ1:GetValue("Z1_LOJA"))
        p_oModel:SetErrorMessage("SZ1MASTER", "Z1_CLI", "SZ1", "Z1_CLI", "CNSA002", "Informe o cliente e o site do cliente.")
        Return .F.
    EndIf
    For nI := 1 To Len(aCampos)
        If Empty(oModelSZ1:GetValue(aCampos[nI][1]))
            p_oModel:SetErrorMessage("SZ1MASTER", aCampos[nI][1], "SZ1", aCampos[nI][1], "CNSA002", aCampos[nI][2])
            Return .F.
        EndIf
    Next nI

Return .T.

/*/{Protheus.doc} OS_VALIDACOBRAR
Agendamento "Nao Cobrar" (Z6_COBRAR) so aceita Cod Servico de hora nao cobravel (BM_TIPGRU = 2).
@param  p_oModel   Objeto do Model
@return lOk        .T. se pode gravar
/*/
Static Function OS_VALIDACOBRAR(p_oModel)
    Local nOper     := p_oModel:GetOperation()
    Local oModelSZ1 := Nil
    Local cTipo     := ""
    Local cGrupo    := ""
    Local cTipGru   := ""

    If nOper != 3 .And. nOper != 4
        Return .T.
    EndIf
    // Gravacao da aprovacao (U_CNSAPR): nao barra por regra de cobranca da OS.
    If Type("__lA02Interno") == "L" .And. __lA02Interno
        Return .T.
    EndIf

    oModelSZ1 := p_oModel:GetModel("SZ1MASTER")
    If oModelSZ1 == Nil
        Return .T.
    EndIf

    cTipo := AllTrim(oModelSZ1:GetValue("Z1_TIPO"))
    If Empty(cTipo)
        Return .T.
    EndIf

    If !U_CNSOUTL("NAOCOBRA", oModelSZ1:GetValue("Z1_TEC"), oModelSZ1:GetValue("Z1_CLI"), oModelSZ1:GetValue("Z1_LOJA"), ;
            DToS(oModelSZ1:GetValue("Z1_DTOS")), oModelSZ1:GetValue("Z1_HRINI"), oModelSZ1:GetValue("Z1_HRFIM"))
        Return .T.
    EndIf

    cGrupo  := Posicione("SB1", 1, xFilial("SB1") + cTipo, "B1_GRUPO")
    cTipGru := AllTrim(Posicione("SBM", 1, xFilial("SBM") + cGrupo, "BM_TIPGRU"))
    If cTipGru != "2"
        p_oModel:SetErrorMessage("SZ1MASTER", "Z1_TIPO", "SZ1", "Z1_TIPO", "CNSA002", ;
            "O agendamento desta OS esta marcado como Nao Cobrar - o Cod Servico precisa ser de hora nao cobravel.", ;
            "Escolha um servico nao cobravel (grupo com tipo 2).")
        Return .F.
    EndIf

Return .T.

/*/{Protheus.doc} OS_MODELLEVE
Model leve (so SZ1, sem o grid SZ2) do REST e da aprovacao - monta E ativa aqui (ver OS_MONTARMODEL).
@param  nOper    MODEL_OPERATION_INSERT, UPDATE ou DELETE
@return oModel   Model ativo
/*/
Static Function OS_MODELLEVE(nOper)
    Local oModel  := Nil
    Local oStrSZ1 := FWFormStruct(1, "SZ1")

    OS_STRUCTHEADLESS(oStrSZ1)

    oModel := MPFormModel():New("FCNS002REST", NIL, {|o| OS_PREVALIDA(o) .And. OS_VALIDACOBRAR(o)}, NIL, NIL)
    oModel:AddFields("SZ1MASTER", NIL, oStrSZ1, {|_f,_a,_c,_v| OS_VALIDACAMPO(_f,_a,_c,_v)}, NIL)
    oModel:SetPrimaryKey({"Z1_FILIAL", "Z1_OS"})
    oModel:InstallEvent("CNS002APR", /*cOwner*/, CNS002APR():New())
    oModel:SetOperation(nOper)
    oModel:Activate()

Return oModel

/*/{Protheus.doc} OS_STRUCTHEADLESS
SZ1 para model sem tela: sem M-> o X3_VALID e o X3_RELACAO quebram - remove os virtuais e
troca VALID/WHEN por .T. (obrigatorios ficam com OS_VALIDACAMPO/OS_PREVALIDA).
@param  oStrSZ1   Estrutura FWFormStruct(1, "SZ1") a ajustar
/*/
Static Function OS_STRUCTHEADLESS(oStrSZ1)
    Local aCampos   := oStrSZ1:GetFields()
    Local aVirtuais := {}
    Local nI        := 0

    oStrSZ1:SetProperty("Z1_USR", MODEL_FIELD_OBRIGAT, .F.)
    oStrSZ1:SetProperty("Z1_SERV", MODEL_FIELD_OBRIGAT, .F.)
    oStrSZ1:SetProperty("Z1_TEC", MODEL_FIELD_OBRIGAT, .F.)

    For nI := 1 To Len(aCampos)
        If aCampos[nI][MODEL_FIELD_VIRTUAL]
            AAdd(aVirtuais, aCampos[nI][MODEL_FIELD_IDFIELD])
        Else
            oStrSZ1:SetProperty(aCampos[nI][MODEL_FIELD_IDFIELD], MODEL_FIELD_VALID, {|| .T.})
            oStrSZ1:SetProperty(aCampos[nI][MODEL_FIELD_IDFIELD], MODEL_FIELD_WHEN,  {|| .T.})
        EndIf
    Next nI

    For nI := 1 To Len(aVirtuais)
        oStrSZ1:RemoveField(aVirtuais[nI])
    Next nI

Return

/*/{Protheus.doc} OS_NUCLEOCOPIAR
Copia a OS (tela e REST): todos os campos menos chave, digitacao, aprovacao e faturamento.
@param  cOsOrigem   Numero (Z1_OS) da OS a ser copiada
@return aRet        Array {lOk, cErro, cOsNova}
/*/
Static Function OS_NUCLEOCOPIAR(cOsOrigem)
    Local aFields    := {}
    Local nI         := 0
    Local cOsNova    := ""
    Local aFixos     := {"Z1_OS", "Z1_FILIAL", "Z1_DTDIGIT", "Z1_APROVAD", "Z1_FATURAR", ;
        "Z1_APVDOR", "Z1_APVMAIL", "Z1_APVIP", "Z1_APVDATA", "Z1_APVHORA", ;
        "D_E_L_E_T_", "R_E_C_N_O_", "R_E_C_D_E_L_"}
    Local oModel     := Nil
    Local oModelSZ1  := Nil
    Local lOk        := .F.
    Local cErro      := ""
    Local oErroExcpt := Nil
    Local bErro      := Nil
    Local jFase      := JsonObject():New()
    Local cIdCh      := ""

    If Empty(cOsOrigem)
        Return {.F., "Informe o numero da OS a copiar.", ""}
    EndIf

    DbSelectArea("SZ1")
    SZ1->(DbSetOrder(1))
    If !SZ1->(DbSeek(cFilAnt + PadR(cOsOrigem, TamSX3("Z1_OS")[1])))
        Return {.F., "OS nao encontrada.", ""}
    EndIf
    cIdCh := AllTrim(SZ1->Z1_IDCH)

    For nI := 1 To SZ1->(FCount())
        If AScan(aFixos, SZ1->(FieldName(nI))) == 0
            AAdd(aFields, {SZ1->(FieldName(nI)), SZ1->(FieldGet(nI))})
        EndIf
    Next nI

    // Sem o ErrorBlock o erro nao cai no Recover.
    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        cOsNova := OS_PROXIMONUM()

        oModel    := OS_MODELLEVE(MODEL_OPERATION_INSERT)
        oModelSZ1 := oModel:GetModel("SZ1MASTER")

        For nI := 1 To Len(aFields)
            oModelSZ1:SetValue(aFields[nI][1], aFields[nI][2])
        Next nI

        oModelSZ1:SetValue("Z1_FILIAL",  cFilAnt)
        // LoadValue: o X3_VALID do Z1_OS quebra fora da tela.
        oModelSZ1:LoadValue("Z1_OS", cOsNova)
        oModelSZ1:SetValue("Z1_DTDIGIT", Date())
        oModelSZ1:SetValue("Z1_APROVAD", "N")
        oModelSZ1:SetValue("Z1_FATURAR", "N")
        oModelSZ1:SetValue("Z1_APVDOR",  "")
        oModelSZ1:SetValue("Z1_APVMAIL", "")
        oModelSZ1:SetValue("Z1_APVIP",   "")
        // Copia leva os 3 chamados (Apia, Cliente e TOTVS).
        oModelSZ1:LoadValue("Z1_IDCH",   cIdCh)
        oModelSZ1:SetValue("Z1_APVDATA", CtoD(""))
        oModelSZ1:SetValue("Z1_APVHORA", "")

        If oModel:VldData()
            lOk := oModel:CommitData()
        EndIf

        If !lOk
            cErro := OS_ERROMODEL(oModel, "Falha ao copiar a OS.")
            // Commit nao gravou (o AfterTTS nao roda): solta a trava da aprovacao e descarta o aviso.
            jFase["fase"]   := "DEP"
            jFase["falhou"] := "S"
            apia.cnsa004.U_CNSAPR("OS", oModel, "", jFase)
        EndIf

        oModel:DeActivate(lOk)

        // Como o OS_NUCLEOINCLUIR: descricao com o chamado da OS nova.
        If lOk .And. !Empty(cIdCh)
            OS_ZA3("DESCRICAO", cOsNova)
        EndIf

    Recover Using oErroExcpt
        lOk   := .F.
        cErro := "Erro interno: " + oErroExcpt:Description
        If oModel <> Nil
            // Erro no meio do commit nao passa pelo AfterTTS: solta a trava da aprovacao e descarta o aviso.
            jFase["fase"]   := "DEP"
            jFase["falhou"] := "S"
            apia.cnsa004.U_CNSAPR("OS", oModel, "", jFase)
            oModel:DeActivate()
        EndIf
    End Sequence
    ErrorBlock(bErro)

    // Solta a reserva do numero (OS_PROXIMONUM): gravada ou nao, nao precisa mais.
    If !Empty(cOsNova)
        Leave1Code("CNSA002_OS" + xFilial("SZ1") + cOsNova)
    EndIf

    If !lOk
        Return {.F., cErro, ""}
    EndIf

Return {.T., "", cOsNova}

/*/{Protheus.doc} OS_TELA
Menu Visualizar/Incluir/Alterar/Excluir: monta e ativa o model e abre a View dentro do OS_MONTARMODEL.
@param  nOper  MODEL_OPERATION_VIEW (1), INSERT (3), UPDATE (4) ou DELETE (5)
/*/
User Function OS_TELA(nOper)
    Local lGrava   := nOper == MODEL_OPERATION_INSERT .Or. nOper == MODEL_OPERATION_UPDATE
    Local lGravou  := .F.
    Local oModel   := Nil
    Local cOs      := SZ1->Z1_OS
    Local aCpos    := {}
    Local cCpo     := ""
    Local nI       := 0

    // M->Z1_* no frame que fica vivo com a tela aberta (lupas/F3). Pelo dicionario (.T.): inclui os campos
    // virtuais (nome do cliente etc.) - sem eles o fechamento da lupa fazia LoadValue com Nil.
    If lGrava
        RegToMemory("SZ1", nOper == MODEL_OPERATION_INSERT, .T.)
        // Campo que ficou sem M-> (ou com Nil, ex.: inicializador que nao devolve nada) quebrava o
        // fechamento da lupa (FWCloseCpo: LoadValue com Nil) - cria vazio do tipo do campo e avisa no console.
        aCpos := FWFormStruct(1, "SZ1"):GetFields()
        For nI := 1 To Len(aCpos)
            cCpo := aCpos[nI][MODEL_FIELD_IDFIELD]
            If Type("M->" + cCpo) == "U"
                ConOut("OS_TELA: M->" + cCpo + " sem valor (Nil) - criado vazio")
                &("M->" + cCpo) := CriaVar(cCpo, .F.)
            EndIf
        Next nI
    EndIf
    // A tela abre DENTRO do OS_MONTARMODEL (bTela): fora dele o FWInitCpo dava "owner private environment not found".
    // Model desta tela como ativo (o ViewDef usa o ativo). FWExecView devolve 0 quando confirma.
    oModel := OS_MONTARMODEL(nOper, {|o| cOs := If(nOper == MODEL_OPERATION_INSERT, o:GetModel("SZ1MASTER"):GetValue("Z1_OS"), cOs), ;
        FWModelActive(o), ;
        lGravou := FWExecView("Ordem de Servico", "apia.cnsa002.u_cns002", nOper, , {|| .T.}, NIL, NIL, NIL, NIL, NIL, NIL, o) == 0})
    // Fecha o model desta tela: senao ele fica ativo (FWModelActive) depois que a tela fechou.
    oModel:DeActivate()
    // Inclusao: solta a reserva do numero (OS_PROXIMONUM), gravada ou cancelada.
    If nOper == MODEL_OPERATION_INSERT
        Leave1Code("CNSA002_OS" + xFilial("SZ1") + AllTrim(cOs))
    EndIf

    Do Case
    Case lGravou .And. lGrava
        OS_ZA3("DESCRICAO", cOs)
        OS_EMAIL("TELA", cOs)
    EndCase
Return

/*/{Protheus.doc} OS_COPIARTELA
Menu Copiar.
/*/
User Function OS_COPIARTELA()
    Local cOs       := ""
    Local aResultado := {}

    If SZ1->(Eof())
        MsgStop("Selecione uma OS para copiar.", "Copiar OS")
        Return
    EndIf

    cOs := AllTrim(SZ1->Z1_OS)

    If !MsgYesNo("Deseja copiar a OS " + cOs + "?", "Copiar OS")
        Return
    EndIf

    aResultado := OS_NUCLEOCOPIAR(cOs)

    If aResultado[1]
        MsgInfo("OS copiada com sucesso! Nova OS: " + aResultado[3], "Copiar OS")
    Else
        MsgStop("Erro ao copiar a OS: " + aResultado[2], "Copiar OS")
    EndIf

Return

/*/{Protheus.doc} OS_LEGENDA
Menu Legenda: a legenda da aprovacao (U_CNSAPR "LEGS").
/*/
User Function OS_LEGENDA()

    Local aLeg := apia.cnsa004.U_CNSAPR("LEGS")
    Local aCor := {}
    Local nI   := 0

    For nI := 1 To Len(aLeg)
        AAdd(aCor, {OS_CORAPR(aLeg[nI][2])[2], aLeg[nI][1]})
    Next nI
    AAdd(aCor, {"BR_BRANCO", "Sem aprovacao (legado)"})
    BrwLegenda("Legenda de Aprovacao", "Aprovacao da OS", aCor)

Return

/*/{Protheus.doc} OS_CORAPR
Cor da legenda do U_CNSAPR "LEG" -> cor do browse e imagem da legenda.
@return aRet  {cCorBrowse, cImagem}
/*/
Static Function OS_CORAPR(cCor)
    Do Case
    Case cCor == "verde"
        Return {"GREEN", "BR_VERDE"}
    Case cCor == "azul"
        Return {"BLUE", "BR_AZUL"}
    Case cCor == "amarelo"
        Return {"YELLOW", "BR_AMARELO"}
    Case cCor == "rosa"
        Return {"PINK", "BR_PINK"}
    Case cCor == "cinzaEscuro"
        Return {"BLACK", "BR_PRETO"}
    EndCase
Return {"GRAY", "BR_CINZA"}

/*/{Protheus.doc} OS_NUCLEOINCLUIR
Inclui a OS pelos parametros da query.
@param  jQuery   Objeto Json com os parametros da query string
@return aRet     Array {lOk, cErro, cOs}
/*/
Static Function OS_NUCLEOINCLUIR(jQuery)
    Local oModel     := Nil
    Local oModelSZ1  := Nil
    Local lOk        := .F.
    Local cErro      := ""
    Local oErroExcpt := Nil
    Local cOs        := ""
    Local cVal       := ""
    Local cDtDigit   := AllTrim(OS_LERJSONTXT(jQuery, "dtDigitacao"))
    Local cCli       := AllTrim(OS_LERJSONTXT(jQuery, "codCliente"))
    Local cLoja      := AllTrim(OS_LERJSONTXT(jQuery, "lojaCliente"))
    Local aHrIni     := OS_LERHORA(jQuery, "horaInicial", "horaInicialDec")
    Local aHrFim     := OS_LERHORA(jQuery, "horaFinal", "horaFinalDec")
    Local aParCh     := OS_ZA3("PARAM", jQuery)
    Local cMsgCh     := OS_ZA3("VALIDAR", "", aParCh[2], cCli, If(Empty(cLoja), "01", cLoja))
    Local bErro      := Nil
    Local jFase      := JsonObject():New()

    If !Empty(cMsgCh)
        Return {.F., cMsgCh, ""}
    EndIf

    // Sem o ErrorBlock o erro nao cai no Recover.
    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        oModel    := OS_MODELLEVE(MODEL_OPERATION_INSERT)
        oModelSZ1 := oModel:GetModel("SZ1MASTER")

        cOs := OS_PROXIMONUM()

        oModelSZ1:SetValue("Z1_FILIAL",  cFilAnt)
        // LoadValue: o X3_VALID do Z1_OS quebra fora da tela.
        oModelSZ1:LoadValue("Z1_OS", cOs)
        oModelSZ1:SetValue("Z1_DTDIGIT", If(Empty(cDtDigit), Date(), STOD(StrTran(cDtDigit,"-",""))))
        oModelSZ1:SetValue("Z1_CLI",     cCli)
        oModelSZ1:SetValue("Z1_LOJA",    cLoja)
        oModelSZ1:SetValue("Z1_USR",     AllTrim(OS_LERJSONTXT(jQuery,"usuario")))
        oModelSZ1:SetValue("Z1_MODULO",  AllTrim(OS_LERJSONTXT(jQuery,"modulo")))
        oModelSZ1:SetValue("Z1_MOTIV",   AllTrim(OS_LERJSONTXT(jQuery,"motivo")))
        oModelSZ1:SetValue("Z1_SERV",    AllTrim(OS_LERJSONTXT(jQuery,"descricao")))
        oModelSZ1:SetValue("Z1_TIPO",    AllTrim(OS_LERJSONTXT(jQuery,"codServico")))
        oModelSZ1:SetValue("Z1_DTOS",    STOD(StrTran(AllTrim(OS_LERJSONTXT(jQuery,"dataOs")), "-", "")))
        oModelSZ1:SetValue("Z1_INI",     aHrIni[1])
        oModelSZ1:SetValue("Z1_FIM",     aHrFim[1])
        oModelSZ1:LoadValue("Z1_HRINI",  OS_HORACAMPO(aHrIni[2], "Z1_HRINI"))
        oModelSZ1:LoadValue("Z1_HRFIM",  OS_HORACAMPO(aHrFim[2], "Z1_HRFIM"))
        oModelSZ1:SetValue("Z1_TOTAL",   If(OS_LERJSONNUM(jQuery,"horasTiDec") <> 0, OS_LERJSONNUM(jQuery,"horasTiDec"), Round(aHrFim[1] - aHrIni[1], 2)))
        // Analista so se veio (vazio pode cair no VALID do dicionario).
        OS_SETOPC(oModelSZ1, jQuery, {{"codAnalista", "Z1_TEC"}})
        oModelSZ1:SetValue("Z1_APROVAD", "N")
        oModelSZ1:SetValue("Z1_FATURAR", "N")

        cVal := AllTrim(OS_LERJSONTXT(jQuery,"osInterna"))
        oModelSZ1:SetValue("Z1_INTERNO", If(Empty(cVal), "N", cVal))
        // Opcionais: so se vierem preenchidos.
        OS_SETOPC(oModelSZ1, jQuery, {{"local", "Z1_LOCAL"}, {"horasTranDec", "Z1_TRANS", .T.}, {"prevPmt", "Z1_PREVIST"}, ;
            {"numProposta", "Z1_NUMPRO"}, {"pedVenda", "Z1_PV"}, {"hrAlmoco", "Z1_ALMOCO", .T.}, {"projeto", "Z1_PROJET"}, ;
            {"revisao", "Z1_REVISA"}, {"tarefa", "Z1_TAREFA"}, {"chamadoHpsd", "Z1_CHPSD"}, {"chamadoTotvs", "Z1_CHTOTVS"}})
        // Z1_IDCH = o chamado da OS.
        If Len(aParCh[2]) > 0
            oModelSZ1:LoadValue("Z1_IDCH", aParCh[2][1])
        EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"osDesenv"))
        oModelSZ1:SetValue("Z1_OSDESE", If(Empty(cVal), "N", cVal))
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"osEnviada"))
        oModelSZ1:SetValue("Z1_OSENVCL", If(Empty(cVal), "N", cVal))
        OS_SETOPC(oModelSZ1, jQuery, {{"linhaPv", "Z1_LIN"}, {"valorHora", "Z1_VLRHR", .T.}})

        If oModel:VldData()
            lOk := oModel:CommitData()
        EndIf

        If !lOk
            cErro := OS_ERROMODEL(oModel, "Falha ao validar/gravar a OS.")
            // Commit nao gravou (o AfterTTS nao roda): solta a trava da aprovacao e descarta o aviso.
            jFase["fase"]   := "DEP"
            jFase["falhou"] := "S"
            apia.cnsa004.U_CNSAPR("OS", oModel, "", jFase)
        EndIf

        oModel:DeActivate(lOk)

        If lOk
            OS_ZA3("DESCRICAO", cOs)
        EndIf

    Recover Using oErroExcpt
        lOk   := .F.
        cErro := "Erro interno: " + oErroExcpt:Description
        If oModel <> Nil
            // Erro no meio do commit nao passa pelo AfterTTS: solta a trava da aprovacao e descarta o aviso.
            jFase["fase"]   := "DEP"
            jFase["falhou"] := "S"
            apia.cnsa004.U_CNSAPR("OS", oModel, "", jFase)
            oModel:DeActivate()
        EndIf
    End Sequence
    ErrorBlock(bErro)

    // Solta a reserva do numero (OS_PROXIMONUM): gravada ou nao, nao precisa mais.
    If !Empty(cOs)
        Leave1Code("CNSA002_OS" + xFilial("SZ1") + cOs)
    EndIf

Return {lOk, cErro, cOs}

/*/{Protheus.doc} OS_APIINCLUIR
POST /CNSAOSINCLUIR - inclui a OS.
@return lOk   .T./.F. via oRest:setStatusResponse (200 com a OS gerada, ou 400 com o erro)
/*/
@Post(endpoint="/CNSAOSINCLUIR")
User Function OS_APIINCLUIR() As Logical
    Local jQuery     := OS_PARAMS() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return OS_ERRO(403, "Usuario sem acesso a este recurso.")
    EndIf

    aResultado := OS_NUCLEOINCLUIR(jQuery)

    If !aResultado[1]
        Return OS_ERRO(400, aResultado[2])
    EndIf

Return oRest:setStatusResponse(200, OS_RESPOSTAOK(aResultado[3], "OS incluida com sucesso."))

/*/{Protheus.doc} OS_NUCLEOALTERAR
Altera a OS - so os campos que vieram na query.
@param  jQuery   Objeto Json com os parametros da query string (inclui "os")
@return aRet     Array {lOk, cErro, cOs}
/*/
Static Function OS_NUCLEOALTERAR(jQuery)
    Local oModel     := Nil
    Local oModelSZ1  := Nil
    Local lOk        := .F.
    Local cErro      := ""
    Local oErroExcpt := Nil
    Local cOs        := AllTrim(OS_LERJSONTXT(jQuery,"os"))
    Local cVal       := ""
    Local aHrIni     := OS_LERHORA(jQuery, "horaInicial", "horaInicialDec")
    Local aHrFim     := OS_LERHORA(jQuery, "horaFinal", "horaFinalDec")
    Local aParCh     := OS_ZA3("PARAM", jQuery)
    Local cMsgCh     := ""
    Local bErro      := Nil
    Local jFase      := JsonObject():New()

    If Empty(cOs)
        Return {.F., "Informe o numero da OS (?os=000001).", ""}
    EndIf

    DbSelectArea("SZ1")
    SZ1->(DbSetOrder(1))
    If !SZ1->(DbSeek(cFilAnt + PadR(cOs, TamSX3("Z1_OS")[1])))
        Return {.F., "OS nao encontrada.", cOs}
    EndIf

    // Chamado (so se veio): um so, do mesmo cliente/loja.
    If aParCh[1]
        cMsgCh := OS_ZA3("VALIDAR", cOs, aParCh[2], ;
            If(Empty(AllTrim(OS_LERJSONTXT(jQuery, "codCliente"))), SZ1->Z1_CLI, AllTrim(OS_LERJSONTXT(jQuery, "codCliente"))), ;
            If(Empty(AllTrim(OS_LERJSONTXT(jQuery, "lojaCliente"))), SZ1->Z1_LOJA, AllTrim(OS_LERJSONTXT(jQuery, "lojaCliente"))))
        If !Empty(cMsgCh)
            Return {.F., cMsgCh, cOs}
        EndIf
        SZ1->(DbSeek(cFilAnt + PadR(cOs, TamSX3("Z1_OS")[1])))
    EndIf

    // Sem o ErrorBlock o erro nao cai no Recover.
    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        oModel    := OS_MODELLEVE(MODEL_OPERATION_UPDATE)
        oModelSZ1 := oModel:GetModel("SZ1MASTER")

        cVal := AllTrim(OS_LERJSONTXT(jQuery,"codCliente"))
        If !Empty(cVal)
            oModelSZ1:SetValue("Z1_CLI", cVal)
            cVal := AllTrim(OS_LERJSONTXT(jQuery,"lojaCliente"))
            oModelSZ1:SetValue("Z1_LOJA", If(Empty(cVal), "01", cVal))
        EndIf
        OS_SETOPC(oModelSZ1, jQuery, {{"usuario", "Z1_USR"}, {"modulo", "Z1_MODULO"}, {"motivo", "Z1_MOTIV"}})
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"descricao"))
        // Troca so a descricao: os blocos de interacao do Memo ficam.
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_SERV", cVal + OS_BLOCOSINTERACAO(oModelSZ1:GetValue("Z1_SERV"))) ; EndIf
        OS_SETOPC(oModelSZ1, jQuery, {{"codServico", "Z1_TIPO"}})
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"dataOs"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_DTOS", STOD(StrTran(cVal,"-",""))) ; EndIf
        If !Empty(aHrIni[2])
            oModelSZ1:SetValue("Z1_INI", aHrIni[1])
            oModelSZ1:LoadValue("Z1_HRINI", OS_HORACAMPO(aHrIni[2], "Z1_HRINI"))
        EndIf
        If !Empty(aHrFim[2])
            oModelSZ1:SetValue("Z1_FIM", aHrFim[1])
            oModelSZ1:LoadValue("Z1_HRFIM", OS_HORACAMPO(aHrFim[2], "Z1_HRFIM"))
        EndIf
        If OS_LERJSONNUM(jQuery,"horasTiDec") == 0 .And. !Empty(aHrIni[2]) .And. !Empty(aHrFim[2])
            oModelSZ1:SetValue("Z1_TOTAL", Round(aHrFim[1] - aHrIni[1], 2))
        EndIf
        OS_SETOPC(oModelSZ1, jQuery, {{"horasTranDec", "Z1_TRANS", .T.}, {"horasTiDec", "Z1_TOTAL", .T.}, ;
            {"codAnalista", "Z1_TEC"}, {"osInterna", "Z1_INTERNO"}, {"local", "Z1_LOCAL"}, {"prevPmt", "Z1_PREVIST"}, ;
            {"numProposta", "Z1_NUMPRO"}, {"pedVenda", "Z1_PV"}, {"hrAlmoco", "Z1_ALMOCO", .T.}, {"projeto", "Z1_PROJET"}, ;
            {"revisao", "Z1_REVISA"}, {"tarefa", "Z1_TAREFA"}})
        // Chamado Cliente/TOTVS: chave presente (mesmo vazia) grava - permite limpar.
        If jQuery["chamadoHpsd"] != Nil
            oModelSZ1:SetValue("Z1_CHPSD", AllTrim(OS_LERJSONTXT(jQuery, "chamadoHpsd")))
        EndIf
        If jQuery["chamadoTotvs"] != Nil
            oModelSZ1:SetValue("Z1_CHTOTVS", AllTrim(OS_LERJSONTXT(jQuery, "chamadoTotvs")))
        EndIf
        // Z1_IDCH = o chamado atual (trocar tira o anterior; as interacoes dele pela OS ficam na ZA2).
        If aParCh[1]
            oModelSZ1:LoadValue("Z1_IDCH", If(Len(aParCh[2]) > 0, aParCh[2][1], ""))
        EndIf
        OS_SETOPC(oModelSZ1, jQuery, {{"osDesenv", "Z1_OSDESE"}})
        // Z1_OSENVCL e obrigatorio e as OS antigas estao vazias.
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"osEnviada"))
        If !Empty(cVal)
            oModelSZ1:SetValue("Z1_OSENVCL", cVal)
        ElseIf Empty(oModelSZ1:GetValue("Z1_OSENVCL"))
            oModelSZ1:SetValue("Z1_OSENVCL", "N")
        EndIf
        OS_SETOPC(oModelSZ1, jQuery, {{"linhaPv", "Z1_LIN"}, {"valorHora", "Z1_VLRHR", .T.}})

        If oModel:VldData()
            lOk := oModel:CommitData()
        EndIf

        If !lOk
            cErro := OS_ERROMODEL(oModel, "Falha ao validar/gravar a alteracao.")
            // Commit nao gravou (o AfterTTS nao roda): solta a trava da aprovacao e descarta o aviso.
            jFase["fase"]   := "DEP"
            jFase["falhou"] := "S"
            apia.cnsa004.U_CNSAPR("OS", oModel, "", jFase)
        EndIf

        oModel:DeActivate(lOk)

        // OS legada com blocos de interacao no Memo e chamado: os blocos passam pra ZA2.
        If lOk
            OS_MIGRARINTERACOES(cOs)
            OS_ZA3("DESCRICAO", cOs)
        EndIf

    Recover Using oErroExcpt
        lOk   := .F.
        cErro := "Erro interno: " + oErroExcpt:Description
        If oModel <> Nil
            // Erro no meio do commit nao passa pelo AfterTTS: solta a trava da aprovacao e descarta o aviso.
            jFase["fase"]   := "DEP"
            jFase["falhou"] := "S"
            apia.cnsa004.U_CNSAPR("OS", oModel, "", jFase)
            oModel:DeActivate()
        EndIf
    End Sequence
    ErrorBlock(bErro)

Return {lOk, cErro, cOs}

/*/{Protheus.doc} OS_APIALTERAR
POST /CNSAOSALTERAR - alteracao parcial (404 se a OS nao existe).
@return lOk   .T./.F. via oRest:setStatusResponse (200 com a OS alterada, ou 400/404 com o erro)
/*/
@Post(endpoint="/CNSAOSALTERAR")
User Function OS_APIALTERAR() As Logical
    Local jQuery     := OS_PARAMS() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return OS_ERRO(403, "Usuario sem acesso a este recurso.")
    EndIf

    aResultado := OS_NUCLEOALTERAR(jQuery)

    If !aResultado[1]
        Return OS_ERRO(If(aResultado[2] == "OS nao encontrada.", 404, 400), aResultado[2])
    EndIf

Return oRest:setStatusResponse(200, OS_RESPOSTAOK(aResultado[3], "OS alterada com sucesso."))

/*/{Protheus.doc} OS_SETOPC
Grava, na ordem, os campos que vieram na query: texto preenchido ou numero <> 0.
@param  oModelSZ1  Submodel SZ1MASTER
@param  jQuery     Parametros da requisicao
@param  aMapa      {{parametro, campo[, .T. = numerico]}}
/*/
Static Function OS_SETOPC(oModelSZ1, jQuery, aMapa)
    Local xVal := Nil
    Local nI   := 0

    For nI := 1 To Len(aMapa)
        xVal := If(Len(aMapa[nI]) > 2, OS_LERJSONNUM(jQuery, aMapa[nI][1]), AllTrim(OS_LERJSONTXT(jQuery, aMapa[nI][1])))
        If !Empty(xVal)
            oModelSZ1:SetValue(aMapa[nI][2], xVal)
        EndIf
    Next nI

Return

/*/{Protheus.doc} OS_LERHORA
Hora do parametro ("08:30" ou "0830") -> {decimal, "HH:MM"}; sem ela, o decimal antigo.
@param  jQuery   Parametros da requisicao
@param  cTexto   Nome do parametro com a hora "HH:MM"
@param  cDec     Nome do parametro com a hora decimal (compatibilidade)
@return aRet     {nDecimal, cHoraHHMM} - {0, ""} se nada veio
/*/
Static Function OS_LERHORA(jQuery, cTexto, cDec)
    Local cDig  := StrTran(StrTran(AllTrim(OS_LERJSONTXT(jQuery, cTexto)), ":", ""), ".", "")
    Local nDec  := 0
    Local nHora := 0
    Local nMin  := 0

    If !Empty(cDig)
        cDig  := PadL(Right(cDig, 4), 4, "0")
        nHora := Val(Left(cDig, 2))
        nMin  := Val(Right(cDig, 2))
        Return {Round(nHora + nMin / 60, 2), StrZero(nHora, 2) + ":" + StrZero(nMin, 2)}
    EndIf

    nDec := OS_LERJSONNUM(jQuery, cDec)
    If nDec == 0
        Return {0, ""}
    EndIf

    nHora := Int(nDec)
    nMin  := Round((nDec - nHora) * 60, 0)
    If nMin >= 60
        nHora++
        nMin -= 60
    EndIf

Return {nDec, StrZero(nHora, 2) + ":" + StrZero(nMin, 2)}

/*/{Protheus.doc} OS_HHMM
Hora para exibir: "0900" -> "09:00".
/*/
Static Function OS_HHMM(cHora)
    Local cRet := AllTrim(cValToChar(cHora))
    If Len(cRet) == 4 .And. !(":" $ cRet)
        cRet := Left(cRet, 2) + ":" + Right(cRet, 2)
    EndIf
Return cRet

// "HH:MM" no tamanho do campo (sem ":" se couber menos de 5) - senao FWNOWIDTH.
Static Function OS_HORACAMPO(cHora, cCampo)
    Local nTam := TamSX3(cCampo)[1]
    Local cRet := cHora

    If nTam < 5
        cRet := StrTran(cRet, ":", "")
    EndIf

Return PadR(Left(cRet, nTam), nTam)

/*/{Protheus.doc} OS_ERROMODEL
Mensagem de erro do model (texto, objeto ou array).
@param  oModel    Model que falhou
@param  cPadrao   Mensagem quando o Model nao informa nada
@return cErro     Mensagem de erro
/*/
Static Function OS_ERROMODEL(oModel, cPadrao)
    Local xErro := oModel:GetErrorMessage()

    Do Case
        Case ValType(xErro) == "C"
            Return xErro
        Case ValType(xErro) == "O"
            Return xErro:GetMessage()
        // Array do MVC: [6] = mensagem do SetErrorMessage.
        Case ValType(xErro) == "A" .And. Len(xErro) >= 6 .And. !Empty(xErro[6])
            Return AllTrim(cValToChar(xErro[6]))
        Case ValType(xErro) == "A"
            Return FwJsonSerialize(xErro)
    EndCase

Return cPadrao

/*/{Protheus.doc} OS_DESC
Z1_SERV (Memo) da OS - o cursor do BeginSql nao traz Memo.
@param  cOs    Numero (Z1_OS) da OS
@return cDesc  Texto da descricao (ou "" se cOs vazio)
/*/
Static Function OS_DESC(cOs)
    If Empty(cOs)
        Return ""
    EndIf
Return AllTrim(Posicione("SZ1", 1, cFilAnt + cOs, "Z1_SERV"))

/*/{Protheus.doc} OS_NOMECLI
Nome reduzido do cliente (sem ele, o nome).
@param  cCodCliente   Codigo do cliente (A1_COD)
@param  cLoja         Loja do cliente (A1_LOJA)
@return cNome         Nome reduzido do cliente (ou "" se cCodCliente vazio)
/*/
Static Function OS_NOMECLI(cCodCliente, cLoja)
    Local cChave := ""
    Local cNome  := ""

    If Empty(cCodCliente)
        Return ""
    EndIf

    // Chave no tamanho exato dos campos (codigo/loja chegam com AllTrim).
    cChave := xFilial("SA1") + PadR(cCodCliente, TamSX3("A1_COD")[1]) + PadR(cLoja, TamSX3("A1_LOJA")[1])
    cNome  := AllTrim(Posicione("SA1", 1, cChave, "A1_NREDUZ"))
    If Empty(cNome)
        cNome := AllTrim(Posicione("SA1", 1, cChave, "A1_NOME"))
    EndIf

Return cNome

/*/{Protheus.doc} OS_NOMEGEN
Descricao da tabela generica SX5 (Z2 = modulo, Z1 = motivo).
@param  cTabela   Tipo da tabela generica SX5 (ex: "Z1", "Z2")
@param  cChave    Chave (codigo) dentro da tabela generica
@return cDesc     Descricao (X5_DESCRI) ou "" se cChave vazio
/*/
Static Function OS_NOMEGEN(cTabela, cChave)
    If Empty(cChave)
        Return ""
    EndIf
Return AllTrim(Posicione("SX5", 1, xFilial("SX5") + cTabela + cChave, "X5_DESCRI"))

/*/{Protheus.doc} OS_NOMEPROJ
Descricao do projeto (AF8).
@param  cProjeto   Codigo do projeto (AF8_PROJET)
@return cDesc      Descricao (AF8_DESCRI) ou "" se cProjeto vazio
/*/
Static Function OS_NOMEPROJ(cProjeto)
    If Empty(cProjeto)
        Return ""
    EndIf
Return AllTrim(Posicione("AF8", 1, xFilial("AF8") + cProjeto, "AF8_DESCRI"))

/*/{Protheus.doc} OS_NOMETAREFA
Descricao da tarefa (AF9).
@param  cProjeto   Codigo do projeto
@param  cTarefa    Codigo da tarefa dentro do projeto
@return cDesc      Descricao (AF9_DESCRI) ou "" se cTarefa vazio
/*/
Static Function OS_NOMETAREFA(cProjeto, cTarefa, cRevisa)
    Local cDesc  := ""
    Local cAlias := ""

    If Empty(cTarefa)
        Return ""
    EndIf
    cDesc := AllTrim(Posicione("AF9", 1, xFilial("AF9") + PadR(AllTrim(cProjeto), TamSX3("AF9_PROJET")[1]) + ;
        PadR(AllTrim(cRevisa), TamSX3("AF9_REVISA")[1]) + PadR(AllTrim(cTarefa), TamSX3("AF9_TAREFA")[1]), "AF9_DESCRI"))
    // Sem revisao, ou revisao sem a tarefa: a revisao mais recente que tenha a tarefa.
    If Empty(cDesc)
        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT AF9_DESCRI
            FROM %Table:AF9% AF9
            WHERE AF9_FILIAL = %xFilial:AF9%
              AND TRIM(AF9_PROJET) = %Exp:AllTrim(cProjeto)%
              AND TRIM(AF9_TAREFA) = %Exp:AllTrim(cTarefa)%
              AND AF9.%NotDel%
            ORDER BY AF9_REVISA DESC
        EndSql
        If !(cAlias)->(Eof())
            cDesc := AllTrim((cAlias)->AF9_DESCRI)
        EndIf
        (cAlias)->(DbCloseArea())
    EndIf
Return cDesc

// Z1_NMTEC/Z1_NMTIPO nao sao coluna fisica (so gatilho de tela): nome sempre calculado aqui.
/*/{Protheus.doc} OS_NOMESERV
Descricao do servico (SB1).
@param  cCodServico   Codigo do servico (B1_COD)
@return cDesc         Descricao (B1_DESC) ou "" se cCodServico vazio
/*/
Static Function OS_NOMESERV(cCodServico)
    If Empty(cCodServico)
        Return ""
    EndIf
Return AllTrim(Posicione("SB1", 1, xFilial("SB1") + cCodServico, "B1_DESC"))

/*/{Protheus.doc} OS_NOMETEC
Nome do tecnico (AA1).
@param  cCodAnalista   Codigo do analista (AA1_COD)
@return cNome          Nome do tecnico (AA1_NOMTEC) ou "" se cCodAnalista vazio
/*/
Static Function OS_NOMETEC(cCodAnalista)
    If Empty(cCodAnalista)
        Return ""
    EndIf
Return AllTrim(Posicione("AA1", 1, xFilial("AA1") + PadR(cCodAnalista, TamSX3("AA1_CODTEC")[1]), "AA1_NOMTEC"))

/*/{Protheus.doc} OS_STATUSCALC
Status da OS no portal.
@param  cAprovad   Valor de Z1_APROVAD ("S"/"A"/outro)
@param  cFaturar   Valor de Z1_FATURAR ("S"/outro)
@param  cTec       Codigo do tecnico (Z1_TEC) responsavel
@return cStatus    "aprovada_faturada", "faturada_sem_aprovacao", "aprovada", "recusada", "aguardando_aprovacao" ou "negada"
/*/
Static Function OS_STATUSCALC(cAprovad, cFaturar, cTec)
    Local lAprovada := cAprovad == "S" .Or. cAprovad == "A"

    If lAprovada .And. cFaturar == "S"
        Return "aprovada_faturada"
    ElseIf cFaturar == "S" .And. !lAprovada
        Return "faturada_sem_aprovacao"
    ElseIf lAprovada
        Return "aprovada"
    ElseIf cAprovad == "R"   // recusada (cliente, manual ou pre-recusa) - nao esta aguardando
        Return "recusada"
    ElseIf !Empty(cTec)
        Return "aguardando_aprovacao"
    EndIf
Return "negada"

/*/{Protheus.doc} OS_DATAISO
Data (Date ou AAAAMMDD) -> "AAAA-MM-DD" ("" se vazia).
@param  dData    Data (tipo Date ou Character/AAAAMMDD)
@return cData    Data no formato "AAAA-MM-DD", ou "" se invalida/vazia
/*/
Static Function OS_DATAISO(dData)
    Local cData := If(ValType(dData) == "D", AllTrim(DToS(dData)), If(ValType(dData) == "C", AllTrim(dData), ""))

    If Len(cData) != 8
        Return ""
    EndIf
Return Left(cData, 4) + "-" + SubStr(cData, 5, 2) + "-" + Right(cData, 2)

/*/{Protheus.doc} OS_LERJSONNUM
Campo numerico do Json (0 se ausente).
@param  jDados   Objeto Json (query string ou corpo)
@param  cCampo   Nome do campo a ler
@return nVal     Valor numerico do campo, ou 0 se ausente
/*/
Static Function OS_LERJSONNUM(jDados, cCampo)
    Local xVal := jDados[cCampo]
    If xVal == Nil
        Return 0
    EndIf
Return Val(cValToChar(xVal))

/*/{Protheus.doc} OS_PROXIMONUM
Proximo numero: ano (2 digitos) + sequencia do ano (26000001...). Conta as excluidas e
reserva com MayIUseCode.
@return cOs   Numero da OS (8 posicoes)
/*/
Static Function OS_PROXIMONUM()
    Local cAno   := Right(cValToChar(Year(Date())), 2)
    Local cAlias := GetNextAlias()
    Local nSeq   := 0
    Local cOs    := ""

    // "%" nao vai dentro do %Exp% (colide com a macro do BeginSql).
    BeginSql Alias cAlias
        SELECT MAX(Z1_OS) MAXOS
        FROM %Table:SZ1% SZ1
        WHERE Z1_FILIAL = %xFilial:SZ1%
          AND Z1_OS LIKE %Exp:cAno% || '%'
    EndSql
    If !(cAlias)->(Eof()) .And. !Empty(AllTrim((cAlias)->MAXOS))
        nSeq := Val(SubStr(AllTrim((cAlias)->MAXOS), 3))
    EndIf
    (cAlias)->(DbCloseArea())

    DbSelectArea("SZ1")
    SZ1->(DbSetOrder(1))
    Do While .T.
        nSeq++
        cOs := cAno + StrZero(nSeq, 6)
        If !SZ1->(DbSeek(xFilial("SZ1") + cOs)) .And. MayIUseCode("CNSA002_OS" + xFilial("SZ1") + cOs)
            Exit
        EndIf
    EndDo

Return cOs

/*/{Protheus.doc} OS_LERJSONTXT
Campo texto do Json, com U_CNSOUTL "UTF8" ("" se ausente).
@param  jDados   Objeto Json (query string ou corpo)
@param  cCampo   Nome do campo a ler
@return cVal     Valor texto decodificado, ou "" se ausente/nao-texto
/*/
Static Function OS_LERJSONTXT(jDados, cCampo)
    Local xVal := jDados[cCampo]
    If xVal == Nil .Or. ValType(xVal) != "C"
        Return ""
    EndIf
Return U_CNSOUTL("UTF8", xVal)

/*/{Protheus.doc} OS_ERRO
Resposta de erro dos endpoints: {"erro": cMsg}.
/*/
Static Function OS_ERRO(nStatus, cMsg)
    Local oJson := JsonObject():New()

    oJson["erro"] := cMsg
Return oRest:setStatusResponse(nStatus, oJson:ToJson())

/*/{Protheus.doc} OS_PARAMS
Parametros do POST: query string e, por cima, o corpo JSON (mesmas chaves) - aceita os dois.
@return jParam   JsonObject com os parametros (numero do corpo vira texto, como na query)
/*/
Static Function OS_PARAMS()
    Local jParam := JsonObject():New()
    Local jCorpo := JsonObject():New()
    Local cCorpo := oRest:getBodyRequest()
    Local aFonte := {oRest:getQueryRequest()}
    Local jFonte := Nil
    Local aNomes := {}
    Local xVal   := Nil
    Local nI     := 0
    Local nJ     := 0

    // Corpo so se for JSON valido (FromJson devolve Nil quando parseou).
    If ValType(cCorpo) == "C" .And. !Empty(cCorpo) .And. Empty(jCorpo:FromJson(cCorpo))
        AAdd(aFonte, jCorpo)
    EndIf
    For nI := 1 To Len(aFonte)
        jFonte := aFonte[nI]
        If ValType(jFonte) == "J"
            aNomes := jFonte:GetNames()
            For nJ := 1 To Len(aNomes)
                xVal := jFonte[aNomes[nJ]]
                // Logico/numero do corpo vira texto como na query ("1"/"0"), igual ao CH_PARAMS.
                jParam[aNomes[nJ]] := If(ValType(xVal) == "L", If(xVal, "1", "0"), If(ValType(xVal) == "N", cValToChar(xVal), xVal))
            Next nJ
        EndIf
    Next nI

Return jParam

/*/{Protheus.doc} OS_RESPOSTAOK
JSON de sucesso: sucesso, os, mensagem, aprovad e interna.
@param  cOs     Numero da OS
@param  cMsg    Mensagem de sucesso
@return cJson   JSON serializado da resposta
/*/
Static Function OS_RESPOSTAOK(cOs, cMsg)
    Local oJson := JsonObject():New()
    oJson["sucesso"]  := .T.
    oJson["os"]       := cOs
    oJson["mensagem"] := cMsg
    SZ1->(DbSetOrder(1))
    If SZ1->(DbSeek(cFilAnt + PadR(AllTrim(cOs), TamSX3("Z1_OS")[1])))
        oJson["aprovad"] := AllTrim(SZ1->Z1_APROVAD)
        oJson["interna"] := AllTrim(SZ1->Z1_INTERNO) == "S"
    EndIf
Return oJson:ToJson()

/*/{Protheus.doc} OS_APILISTAR
GET /CNSAOS - lista paginada (ROWNUM). Filtros: texto, tecnico, cliente, dataDe, dataAte, aprovad.
@return lOk   JSON via oRest:setStatusResponse (200 com {total,totalPaginas,pagina,tamanho,items}, ou 500 em erro)
/*/
@Get(endpoint="/CNSAOS")
User Function OS_APILISTAR() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local oJson      := JsonObject():New()
    Local aRetorno   := {}
    Local oLinha     := Nil
    Local nPagina    := 1
    Local nTamanho   := 10
    Local nTotal     := 0
    Local nMinRow    := 0
    Local nMaxRow    := 0
    Local oErro      := Nil
    Local cAlias     := GetNextAlias()
    Local cOsAtual   := ""
    Local cCliAtual  := ""
    Local cLojaAtual := ""
    Local cProjAtual := ""
    Local cTecAtual  := ""
    Local cTextoUp   := ""
    Local cFTec      := ""
    Local cFCli      := ""
    Local cFDataDe   := ""
    Local cFDataAte  := ""
    Local cSemTec    := ""
    Local cSemCli    := ""
    Local cSemDe     := ""
    Local cSemAte    := ""
    Local cFApv      := ""
    Local cSemApv    := ""
    Local bErro      := Nil

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return OS_ERRO(403, "Usuario sem acesso a este recurso.")
    EndIf

    // Sem o ErrorBlock o erro nao cai no Recover. Restaurado em toda saida.
    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        nPagina   := OS_LERJSONNUM(jQuery, "pagina")
        nPagina   := If(nPagina < 1, 1, nPagina)
        nTamanho  := OS_LERJSONNUM(jQuery, "tamanho")
        nTamanho  := If(nTamanho < 1 .Or. nTamanho > 100, 10, nTamanho)
        nMinRow   := (nPagina - 1) * nTamanho
        nMaxRow   := nMinRow + nTamanho

        // Busca livre (numero, cliente, tecnico, Chamado Cliente ou TOTVS) e Busca avancada ficam no SQL: a lista e paginada.
        cTextoUp := Upper(AllTrim(OS_LERJSONTXT(jQuery, "texto")))

        cFTec     := AllTrim(OS_LERJSONTXT(jQuery, "tecnico"))
        cFCli     := AllTrim(OS_LERJSONTXT(jQuery, "cliente"))
        cFDataDe  := StrTran(AllTrim(OS_LERJSONTXT(jQuery, "dataDe")), "-", "")
        cFDataAte := StrTran(AllTrim(OS_LERJSONTXT(jQuery, "dataAte")), "-", "")
        // Oracle trata '' como NULL: flag "S" = sem filtro no lugar de testar string vazia.
        cSemTec := If(Empty(cFTec),     "S", "N")
        cSemCli := If(Empty(cFCli),     "S", "N")
        cSemDe  := If(Empty(cFDataDe),  "S", "N")
        cSemAte := If(Empty(cFDataAte), "S", "N")
        // Estado da aprovacao (Z1_APROVAD), um ou mais: aprovad=P,N -> ",P,N,".
        cFApv   := StrTran(Upper(AllTrim(OS_LERJSONTXT(jQuery, "aprovad"))), " ", "")
        cSemApv := If(Empty(cFApv), "S", "N")
        cFApv   := "," + cFApv + ","

        BeginSql Alias cAlias
            SELECT * FROM (
                SELECT SZ1Q.*, ROWNUM AS SZ1_RNUM
                FROM (
                    SELECT Z1_OS, Z1_DTDIGIT, Z1_CLI, Z1_LOJA, Z1_USR, Z1_MODULO, Z1_MOTIV, Z1_TIPO, ;
                        Z1_DTOS, Z1_INTERNO, Z1_LOCAL, Z1_HRINI, Z1_INI, Z1_HRFIM, Z1_FIM, Z1_TRANS, Z1_PREVIST, ;
                        Z1_HRTOT, Z1_TOTAL, Z1_TEC, Z1_NUMPRO, Z1_PV, Z1_ALMOCO, Z1_PROJET, Z1_REVISA, ;
                        Z1_TAREFA, Z1_CHPSD, Z1_CHTOTVS, Z1_CHHDK, Z1_IDCH, Z1_OSDESE, Z1_OSENVCL, Z1_LIN, Z1_VLRHR, Z1_APROVAD, Z1_FATURAR, ;
                        Z1_APVTIPO, Z1_APVDATA, Z1_ENVDT, ;
                        COUNT(*) OVER() AS SZ1_TOTAL
                    FROM %Table:SZ1% SZ1
                    WHERE Z1_FILIAL = %xFilial:SZ1%
                      AND %NotDel%
                      AND (%Exp:cSemTec% = 'S' OR Z1_TEC = %Exp:cFTec%)
                      AND (%Exp:cSemCli% = 'S' OR Z1_CLI = %Exp:cFCli%)
                      AND (%Exp:cSemDe% = 'S' OR Z1_DTOS >= %Exp:cFDataDe%)
                      AND (%Exp:cSemAte% = 'S' OR Z1_DTOS <= %Exp:cFDataAte%)
                      AND (%Exp:cSemApv% = 'S' OR INSTR(%Exp:cFApv%, ',' || Z1_APROVAD || ',') > 0)
                      AND (
                            %Exp:cTextoUp% = ''
                            OR UPPER(Z1_OS) LIKE '%'||%Exp:cTextoUp%||'%'
                            OR UPPER(Z1_CHPSD) LIKE '%'||%Exp:cTextoUp%||'%'
                            OR UPPER(Z1_CHTOTVS) LIKE '%'||%Exp:cTextoUp%||'%'
                            OR EXISTS (
                                SELECT 1 FROM %Table:SA1% SA1
                                WHERE SA1.A1_FILIAL = %xFilial:SA1% AND SA1.A1_COD = Z1_CLI AND SA1.A1_LOJA = Z1_LOJA
                                  AND SA1.D_E_L_E_T_ = ' ' AND (UPPER(SA1.A1_NOME) LIKE '%'||%Exp:cTextoUp%||'%' OR UPPER(SA1.A1_NREDUZ) LIKE '%'||%Exp:cTextoUp%||'%')
                            )
                            OR EXISTS (
                                SELECT 1 FROM %Table:AA1% AA1
                                WHERE AA1.AA1_FILIAL = %xFilial:AA1% AND AA1.AA1_CODTEC = Z1_TEC
                                  AND AA1.D_E_L_E_T_ = ' ' AND UPPER(AA1.AA1_NOMTEC) LIKE '%'||%Exp:cTextoUp%||'%'
                            )
                          )
                    ORDER BY Z1_OS DESC
                ) SZ1Q
                WHERE ROWNUM <= %Exp:nMaxRow%
            )
            WHERE SZ1_RNUM > %Exp:nMinRow%
        EndSql

        If !(cAlias)->(Eof())
            nTotal := (cAlias)->SZ1_TOTAL
        EndIf

        While !(cAlias)->(Eof())
            cOsAtual   := AllTrim((cAlias)->Z1_OS)
            cCliAtual  := AllTrim((cAlias)->Z1_CLI)
            cLojaAtual := AllTrim((cAlias)->Z1_LOJA)
            cProjAtual := AllTrim((cAlias)->Z1_PROJET)
            cTecAtual  := AllTrim((cAlias)->Z1_TEC)

            oLinha := JsonObject():New()
            oLinha['os']             := cOsAtual
            oLinha['dtDigitacao']    := OS_DATAISO((cAlias)->Z1_DTDIGIT)
            oLinha['codCliente']     := cCliAtual
            oLinha['lojaCliente']    := cLojaAtual
            oLinha['nomeCliente']    := OS_NOMECLI(cCliAtual, cLojaAtual)
            oLinha['usuario']        := AllTrim((cAlias)->Z1_USR)
            oLinha['modulo']         := AllTrim((cAlias)->Z1_MODULO)
            oLinha['nomeModulo']     := OS_NOMEGEN("Z2", AllTrim((cAlias)->Z1_MODULO))
            oLinha['motivo']         := AllTrim((cAlias)->Z1_MOTIV)
            oLinha['nomeMotivo']     := OS_NOMEGEN("Z1", AllTrim((cAlias)->Z1_MOTIV))
            // So a descricao (interacoes vao pelo CNSAOSINTERACOES).
            oLinha['descricao']      := OS_SEPARAINTERACOES(OS_DESC(cOsAtual))[1]
            oLinha['codServico']     := AllTrim((cAlias)->Z1_TIPO)
            oLinha['nomeServico']    := OS_NOMESERV(AllTrim((cAlias)->Z1_TIPO))
            oLinha['dataOs']         := OS_DATAISO((cAlias)->Z1_DTOS)
            oLinha['osInterna']      := AllTrim((cAlias)->Z1_INTERNO)
            oLinha['local']          := AllTrim((cAlias)->Z1_LOCAL)
            oLinha['horaInicial']    := AllTrim((cAlias)->Z1_HRINI)
            oLinha['horaInicialDec'] := (cAlias)->Z1_INI
            oLinha['horaFinal']      := AllTrim((cAlias)->Z1_HRFIM)
            oLinha['horaFinalDec']   := (cAlias)->Z1_FIM
            oLinha['horasTranDec']   := (cAlias)->Z1_TRANS
            oLinha['prevPmt']        := AllTrim((cAlias)->Z1_PREVIST)
            oLinha['totalHoras']     := AllTrim((cAlias)->Z1_HRTOT)
            oLinha['horasTiDec']     := (cAlias)->Z1_TOTAL
            oLinha['codAnalista']    := cTecAtual
            oLinha['nomeAnalista']   := OS_NOMETEC(cTecAtual)
            oLinha['numProposta']    := AllTrim((cAlias)->Z1_NUMPRO)
            oLinha['pedVenda']       := AllTrim((cAlias)->Z1_PV)
            oLinha['hrAlmoco']       := (cAlias)->Z1_ALMOCO
            oLinha['projeto']        := cProjAtual
            oLinha['nomeProjeto']    := OS_NOMEPROJ(cProjAtual)
            oLinha['revisao']        := AllTrim((cAlias)->Z1_REVISA)
            oLinha['tarefa']         := AllTrim((cAlias)->Z1_TAREFA)
            oLinha['nomeTarefa']     := OS_NOMETAREFA(cProjAtual, AllTrim((cAlias)->Z1_TAREFA), AllTrim((cAlias)->Z1_REVISA))
            oLinha['chamadoHpsd']    := AllTrim((cAlias)->Z1_CHPSD)
            oLinha['chamadoTotvs']   := AllTrim((cAlias)->Z1_CHTOTVS)
            oLinha['chamado']        := AllTrim((cAlias)->Z1_IDCH)
            oLinha['chamados']       := OS_ZA3("LER", cOsAtual, (cAlias)->Z1_IDCH)
            oLinha['qtdChamados']    := Len(oLinha['chamados'])
            oLinha['osDesenv']       := AllTrim((cAlias)->Z1_OSDESE)
            oLinha['osEnviada']      := AllTrim((cAlias)->Z1_OSENVCL)
            oLinha['linhaPv']        := AllTrim((cAlias)->Z1_LIN)
            oLinha['valorHora']      := (cAlias)->Z1_VLRHR
            oLinha['status']         := OS_STATUSCALC(AllTrim((cAlias)->Z1_APROVAD), AllTrim((cAlias)->Z1_FATURAR), cTecAtual)
            oLinha['aprovad']        := AllTrim((cAlias)->Z1_APROVAD)
            oLinha['apvtipo']        := AllTrim((cAlias)->Z1_APVTIPO)
            oLinha['aprovacao']      := apia.cnsa004.U_CNSAPR("LEG", {(cAlias)->Z1_APROVAD, (cAlias)->Z1_APVTIPO, ;
                                            (cAlias)->Z1_APVDATA, (cAlias)->Z1_ENVDT, (cAlias)->Z1_DTDIGIT})[1]
            AAdd(aRetorno, oLinha)

            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())

        oJson['total']        := nTotal
        oJson['totalPaginas'] := If(nTotal == 0, 0, Ceiling(nTotal / nTamanho))
        oJson['pagina']       := nPagina
        oJson['tamanho']      := nTamanho
        oJson['items']        := aRetorno

        ErrorBlock(bErro)
        Return oRest:setStatusResponse(200, oJson:ToJson())

    Recover Using oErro
        ErrorBlock(bErro)
        If oErro != Nil
            Return OS_ERRO(500, oErro:Description)
        EndIf
    End Sequence
    ErrorBlock(bErro)

Return OS_ERRO(500, "Erro desconhecido.")

/*/{Protheus.doc} OS_APIEXCLUIR
POST /CNSAOSEXCLUIR - exclui a OS.
@return lOk   JSON via oRest:setStatusResponse (200 se excluiu, 404 se a OS nao existir, 400/500 em erro)
/*/
@Post(endpoint="/CNSAOSEXCLUIR")
User Function OS_APIEXCLUIR() As Logical
    Local jQuery     := OS_PARAMS() As Json
    Local cOs        := AllTrim(OS_LERJSONTXT(jQuery,"os")) As Character
    Local oErro      := Nil
    Local oModel     := Nil
    Local lOk        := .F.
    Local cErro      := ""
    Local bErro      := Nil
    Local jFase      := JsonObject():New()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return OS_ERRO(403, "Usuario sem acesso a este recurso.")
    EndIf

    // Sem o ErrorBlock o erro nao cai no Recover. Restaurado em toda saida.
    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        If Empty(cOs)
            ErrorBlock(bErro)
            Return OS_ERRO(400, "Informe o numero da OS.")
        EndIf

        DbSelectArea("SZ1")
        SZ1->(DbSetOrder(1))
        If !SZ1->(DbSeek(cFilAnt + PadR(cOs, TamSX3("Z1_OS")[1])))
            ErrorBlock(bErro)
            Return OS_ERRO(404, "OS nao encontrada.")
        EndIf

        oModel := OS_MODELLEVE(MODEL_OPERATION_DELETE)

        If oModel:VldData()
            lOk := oModel:CommitData()
        EndIf

        If !lOk
            cErro := OS_ERROMODEL(oModel, "Falha ao excluir a OS.")
            // Commit nao gravou (o AfterTTS nao roda): solta a trava da aprovacao e descarta o aviso.
            jFase["fase"]   := "DEP"
            jFase["falhou"] := "S"
            apia.cnsa004.U_CNSAPR("OS", oModel, "", jFase)
        EndIf

        oModel:DeActivate(lOk)

        If !lOk
            ErrorBlock(bErro)
            Return OS_ERRO(400, cErro)
        EndIf

        ErrorBlock(bErro)
        Return oRest:setStatusResponse(200, OS_RESPOSTAOK(cOs, "OS excluida com sucesso."))

    Recover Using oErro
        ErrorBlock(bErro)
        If oModel <> Nil
            jFase["fase"]   := "DEP"
            jFase["falhou"] := "S"
            apia.cnsa004.U_CNSAPR("OS", oModel, "", jFase)
        EndIf
        Return OS_ERRO(500, oErro:Description)
    End Sequence
    ErrorBlock(bErro)

Return OS_ERRO(500, "Erro desconhecido.")

/*/{Protheus.doc} OS_APICOPIAR
POST /CNSAOSCOPIAR - copia a OS.
@return lOk   JSON via oRest:setStatusResponse (200 com {osOriginal,osNova}, 404 se a OS nao existir, 400/500 em erro)
/*/
@Post(endpoint="/CNSAOSCOPIAR")
User Function OS_APICOPIAR() As Logical
    Local jQuery    := OS_PARAMS() As Json
    Local cOsOrigem := AllTrim(OS_LERJSONTXT(jQuery,"os")) As Character
    Local oJson     := JsonObject():New()
    Local oErro     := Nil
    Local aResultado := {}
    Local bErro      := Nil

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return OS_ERRO(403, "Usuario sem acesso a este recurso.")
    EndIf

    // Sem o ErrorBlock o erro nao cai no Recover. Restaurado em toda saida.
    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        aResultado := OS_NUCLEOCOPIAR(cOsOrigem)

        If !aResultado[1]
            ErrorBlock(bErro)
            Return OS_ERRO(If(aResultado[2] == "OS nao encontrada.", 404, 400), aResultado[2])
        EndIf

        oJson['sucesso']    := .T.
        oJson['osOriginal'] := cOsOrigem
        oJson['osNova']     := aResultado[3]
        oJson['mensagem']   := "OS copiada com sucesso."

        ErrorBlock(bErro)
        Return oRest:setStatusResponse(200, oJson:ToJson())

    Recover Using oErro
        ErrorBlock(bErro)
        Return OS_ERRO(500, oErro:Description)
    End Sequence
    ErrorBlock(bErro)

Return OS_ERRO(500, "Erro desconhecido.")

// Interacao de OS sem chamado: bloco no fim do Memo Z1_SERV (antes do 1o bloco = descricao):
//   === INTERACAO 24/09/2026 10:30 | 000123 | NOME DO CONSULTOR ===
//   texto da interacao

/*/{Protheus.doc} OS_LIMPABORDAS
Tira espaco, tab e quebra de linha das bordas.
@param  cTexto   Texto a limpar
@return cRet     Texto sem espacos/quebras nas bordas
/*/
Static Function OS_LIMPABORDAS(cTexto)
    Local cRet    := cTexto
    Local cBordas := " " + Chr(9) + Chr(10) + Chr(13)

    While Len(cRet) > 0 .And. Left(cRet, 1) $ cBordas
        cRet := SubStr(cRet, 2)
    EndDo
    While Len(cRet) > 0 .And. Right(cRet, 1) $ cBordas
        cRet := Left(cRet, Len(cRet) - 1)
    EndDo

Return cRet

/*/{Protheus.doc} OS_SEPARAINTERACOES
Separa o Memo Z1_SERV em descricao e blocos de interacao.
@param  cMemo   Conteudo do Z1_SERV
@return aRet    {cDescricao, aBlocos} - cada bloco {cData (DD/MM/AAAA), cHora, cConsultor, cNome, cTexto}
/*/
Static Function OS_SEPARAINTERACOES(cMemo)
    Local cMarca    := OS_MARCA
    Local nPos      := At(cMarca, cMemo)
    Local cDesc     := ""
    Local cResto    := ""
    Local cBloco    := ""
    Local cCab      := ""
    Local nFimCab   := 0
    Local aCab      := {}
    Local aBlocos   := {}

    If nPos == 0
        Return {OS_LIMPABORDAS(cMemo), {}}
    EndIf

    cDesc  := OS_LIMPABORDAS(Left(cMemo, nPos - 1))
    cResto := SubStr(cMemo, nPos + Len(cMarca))

    While !Empty(cResto)
        nPos := At(cMarca, cResto)
        If nPos > 0
            cBloco := Left(cResto, nPos - 1)
            cResto := SubStr(cResto, nPos + Len(cMarca))
        Else
            cBloco := cResto
            cResto := ""
        EndIf

        nFimCab := At(" ===", cBloco)
        If nFimCab == 0
            Loop
        EndIf
        cCab := Left(cBloco, nFimCab - 1)
        aCab := StrTokArr2(cCab, "|", .T.)
        // aCab[1] = "DD/MM/AAAA HH:MM", aCab[2] = codigo, aCab[3] = nome
        AAdd(aBlocos, { ;
            Left(AllTrim(aCab[1]), 10), ;
            AllTrim(SubStr(AllTrim(aCab[1]), 12)), ;
            If(Len(aCab) >= 2, AllTrim(aCab[2]), ""), ;
            If(Len(aCab) >= 3, AllTrim(aCab[3]), ""), ;
            OS_LIMPABORDAS(SubStr(cBloco, nFimCab + 4)) ;
        })
    EndDo

Return {cDesc, aBlocos}

/*/{Protheus.doc} OS_BLOCOSINTERACAO
So os blocos de interacao do Memo (para trocar a descricao sem perder o historico).
@param  cMemo   Conteudo do Z1_SERV
@return cBlocos Parte de interacoes (ou "" se nao houver)
/*/
Static Function OS_BLOCOSINTERACAO(cMemo)
    Local nPos := At(OS_MARCA, cMemo)
    If nPos == 0
        Return ""
    EndIf
Return Chr(13) + Chr(10) + Chr(13) + Chr(10) + SubStr(cMemo, nPos)

/*/{Protheus.doc} OS_MIGRARINTERACOES
OS legada (de antes do chamado na OS) com blocos de interacao no Memo e chamado: os blocos vao para
a ZA2 do chamado e o Memo fica so com a descricao.
@param  cOs   Numero da OS (Z1_OS)
/*/
Static Function OS_MIGRARINTERACOES(cOs)
    Local cIdCh   := ""
    Local aSep    := {}
    Local aBloco  := {}
    Local cAlias  := ""
    Local nSeq    := 1
    Local nI      := 0
    Local cData   := ""

    DbSelectArea("SZ1")
    SZ1->(DbSetOrder(1))
    If !SZ1->(DbSeek(cFilAnt + PadR(cOs, TamSX3("Z1_OS")[1])))
        Return
    EndIf

    cIdCh := AllTrim(SZ1->Z1_IDCH)
    If Empty(cIdCh)
        Return
    EndIf

    aSep := OS_SEPARAINTERACOES(SZ1->Z1_SERV)
    If Len(aSep[2]) == 0
        Return
    EndIf

    // Proxima sequencia da ZA2 (ZA2_IDCH e Character - ORA-01722).
    cAlias := GetNextAlias()
    BeginSql Alias cAlias
        SELECT MAX(ZA2_IDGRID) MAXGRID
        FROM %Table:ZA2% ZA2
        WHERE ZA2_FILIAL = %xFilial:ZA2%
          AND ZA2_IDCH   = %Exp:cIdCh%
          AND %NotDel%
    EndSql
    If !(cAlias)->(Eof()) .And. !Empty(AllTrim((cAlias)->MAXGRID))
        nSeq := Val(AllTrim((cAlias)->MAXGRID)) + 1
    EndIf
    (cAlias)->(DbCloseArea())

    Begin Transaction

        For nI := 1 To Len(aSep[2])
            aBloco := aSep[2][nI]
            cData  := SubStr(aBloco[1], 7, 4) + SubStr(aBloco[1], 4, 2) + SubStr(aBloco[1], 1, 2)

            RecLock("ZA2", .T.)
                ZA2->ZA2_FILIAL := xFilial("ZA2")
                ZA2->ZA2_IDCH   := cIdCh
                ZA2->ZA2_IDGRID := StrZero(nSeq, 3)
                ZA2->ZA2_CONSUL := aBloco[3]
                ZA2->ZA2_DATA   := SToD(cData)
                ZA2->ZA2_HORA   := aBloco[2]
                ZA2->ZA2_DESCRI := aBloco[5]
                ZA2->ZA2_OS     := cOs
            ZA2->(MsUnlock())
            nSeq++
        Next nI

        RecLock("SZ1", .F.)
            SZ1->Z1_SERV := aSep[1]
        SZ1->(MsUnlock())

    End Transaction

Return

/*/{Protheus.doc} OS_APILISTAINTERACOES
GET /CNSAOSINTERACOES - interacoes da OS (Memo e ZA2 com ZA2_OS) e os chamados dela.
@return Logical - resposta HTTP com o JSON de interacoes
/*/
@Get(endpoint="/CNSAOSINTERACOES")
User Function OS_APILISTAINTERACOES() As Logical
    Local jQuery  := oRest:getQueryRequest() As Json
    Local cOs     := AllTrim(OS_LERJSONTXT(jQuery,"os"))
    Local oJson   := JsonObject():New()
    Local oLinha  := Nil
    Local aItens  := {}
    Local aSep    := {}
    Local aBloco  := {}
    Local aOrdem  := {}
    Local nI      := 0
    Local oErro   := Nil
    Local cAlias  := ""
    Local cData   := ""
    Local aCh     := {}
    Local cChCli  := ""
    Local aDesc   := {}
    Local lZA2Os  := .F.
    Local bErro   := Nil

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return OS_ERRO(403, "Usuario sem acesso a este recurso.")
    EndIf

    // Sem o ErrorBlock o erro nao cai no Recover. Restaurado em toda saida.
    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        If Empty(cOs)
            ErrorBlock(bErro)
            Return OS_ERRO(400, "Informe o numero da OS.")
        EndIf

        DbSelectArea("SZ1")
        SZ1->(DbSetOrder(1))
        If !SZ1->(DbSeek(cFilAnt + PadR(cOs, TamSX3("Z1_OS")[1])))
            ErrorBlock(bErro)
            Return OS_ERRO(404, "OS nao encontrada.")
        EndIf

        aSep   := OS_SEPARAINTERACOES(SZ1->Z1_SERV)
        // Chamado do cliente (Z1_CHPSD): o mesmo em todas as interacoes desta OS.
        cChCli := AllTrim(SZ1->Z1_CHPSD)

        // OS sem chamado: a descricao vai como item unico.
        If Empty(AllTrim(SZ1->Z1_IDCH))
            If !Empty(aSep[1])
                cData  := OS_DATAISO(SZ1->Z1_DTOS)
                oLinha := JsonObject():New()
                oLinha['seq']       := "OS-DESC"
                oLinha['consultor'] := OS_NOMETEC(AllTrim(SZ1->Z1_TEC))
                oLinha['data']      := cData
                oLinha['hora']      := ""
                oLinha['texto']     := aSep[1]
                oLinha['os']        := cOs
                oLinha['chamadoCliente'] := cChCli
                oLinha['idCh']      := ""
                oLinha['descricao'] := .T.
                // So entra se a OS nao tiver interacao propria na ZA2 (a 1a vira a descricao).
                aDesc := {cData, oLinha}
            EndIf
        Else
            // Com chamado: blocos do Memo ainda nao migrados pra ZA2.
            For nI := 1 To Len(aSep[2])
                aBloco := aSep[2][nI]
                cData  := SubStr(aBloco[1], 7, 4) + "-" + SubStr(aBloco[1], 4, 2) + "-" + SubStr(aBloco[1], 1, 2)
                oLinha := JsonObject():New()
                oLinha['seq']       := "OS-" + StrZero(nI, 3)
                oLinha['consultor'] := aBloco[4]
                oLinha['data']      := cData
                oLinha['hora']      := aBloco[2]
                oLinha['texto']     := aBloco[5]
                oLinha['os']        := cOs
                oLinha['chamadoCliente'] := cChCli
                oLinha['idCh']      := ""
                AAdd(aOrdem, {cData + aBloco[2], oLinha})
            Next nI
        EndIf

        // ZA2 desta OS, em qualquer chamado. ZA2_DESCRI (Memo) tem que ser a ultima coluna.
        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT ZA2_IDCH, ZA2_IDGRID, ZA2_CONSUL, ZA2_DATA, ZA2_HORA, ZA2_DESCRI
            FROM %Table:ZA2% ZA2
            WHERE ZA2_FILIAL = %xFilial:ZA2%
              AND ZA2_OS     = %Exp:cOs%
              AND %NotDel%
        EndSql

        While !(cAlias)->(Eof())
            cData := OS_DATAISO((cAlias)->ZA2_DATA)

            oLinha := JsonObject():New()
            // Interacao da OS sem chamado (ZA2_IDCH vazio): seq = so a ZA2_IDGRID.
            oLinha['seq']       := If(Empty(AllTrim((cAlias)->ZA2_IDCH)), "", AllTrim((cAlias)->ZA2_IDCH) + "-") + AllTrim((cAlias)->ZA2_IDGRID)
            oLinha['consultor'] := OS_NOMETEC(AllTrim((cAlias)->ZA2_CONSUL))
            oLinha['data']      := cData
            oLinha['hora']      := AllTrim((cAlias)->ZA2_HORA)
            oLinha['texto']     := U_CNSOUTL("UTF8", AllTrim((cAlias)->ZA2_DESCRI))
            oLinha['os']        := cOs
            oLinha['chamadoCliente'] := cChCli
            oLinha['idCh']      := AllTrim((cAlias)->ZA2_IDCH)
            // Chave vazia no Posicione traria o assunto do 1o chamado.
            oLinha['assunto']   := If(Empty(AllTrim((cAlias)->ZA2_IDCH)), "", ;
                U_CNSOUTL("UTF8", AllTrim(Posicione("ZA1", 1, xFilial("ZA1") + AllTrim((cAlias)->ZA2_IDCH), "ZA1_ASSUNT"))))
            AAdd(aOrdem, {cData + AllTrim((cAlias)->ZA2_HORA), oLinha})
            If Empty(AllTrim((cAlias)->ZA2_IDCH))
                lZA2Os := .T.
            EndIf

            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())
        If !Empty(aDesc) .And. !lZA2Os
            AAdd(aOrdem, aDesc)
        EndIf

        ASort(aOrdem, , , {|x, y| x[1] > y[1]})
        For nI := 1 To Len(aOrdem)
            AAdd(aItens, aOrdem[nI][2])
        Next nI

        oJson['os']    := cOs
        oJson['items'] := aItens
        // So no portal interno (nao vai pro e-mail nem pra pagina do cliente).
        oJson['chamadoTotvs'] := AllTrim(SZ1->Z1_CHTOTVS)

        aCh := OS_ZA3("LER", cOs, SZ1->Z1_IDCH)
        ZA1->(DbSetOrder(1))
        For nI := 1 To Len(aCh)
            ZA1->(DbSeek(xFilial("ZA1") + aCh[nI]))
            oLinha := JsonObject():New()
            oLinha['idCh']    := aCh[nI]
            oLinha['assunto'] := U_CNSOUTL("UTF8", AllTrim(ZA1->ZA1_ASSUNT))
            oLinha['status']  := AllTrim(ZA1->ZA1_STATUS)
            oLinha['data']    := OS_DATAISO(ZA1->ZA1_DATA)   // abertura - ordem cronologica
            aCh[nI] := oLinha
        Next nI
        oJson['chamados'] := aCh

        ErrorBlock(bErro)
        Return oRest:setStatusResponse(200, oJson:ToJson())

    Recover Using oErro
        ErrorBlock(bErro)
        Return OS_ERRO(500, oErro:Description)
    End Sequence
    ErrorBlock(bErro)

Return OS_ERRO(500, "Erro desconhecido.")

/*/{Protheus.doc} OS_APINOVAINTERACAO
POST /CNSAOSINTERACOESINCLUIR - OS sem chamado: interacao nova na ZA2 (ZA2_IDCH vazio, ZA2_OS = a OS).
A 1a interacao vira a descricao (Z1_SERV vazio). OS aprovada/recusada: so o admin interage, e ela reabre.
@return Logical - resposta HTTP com o resultado da inclusao
/*/
@Post(endpoint="/CNSAOSINTERACOESINCLUIR")
User Function OS_APINOVAINTERACAO() As Logical
    Local jQuery     := OS_PARAMS() As Json
    Local cOs        := AllTrim(OS_LERJSONTXT(jQuery,"os"))
    Local cTexto     := U_CNSOUTL("TEXTOPURO", OS_LERJSONTXT(jQuery,"texto"))
    Local oJson      := JsonObject():New()
    Local oErro      := Nil
    Local jMot       := JsonObject():New()
    Local aInv       := {}
    Local cAlias     := ""
    Local cSeq       := ""
    Local lTrava     := .F.
    Local nI         := 0
    Local bErro      := Nil

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return OS_ERRO(403, "Usuario sem acesso a este recurso.")
    EndIf

    // Sem o ErrorBlock o erro nao cai no Recover. Restaurado em toda saida.
    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        If Empty(cOs)
            ErrorBlock(bErro)
            Return OS_ERRO(400, "Informe o numero da OS.")
        EndIf
        If Empty(cTexto)
            ErrorBlock(bErro)
            Return OS_ERRO(400, "Escreva o texto da interacao.")
        EndIf

        DbSelectArea("SZ1")
        SZ1->(DbSetOrder(1))
        If !SZ1->(DbSeek(cFilAnt + PadR(cOs, TamSX3("Z1_OS")[1])))
            ErrorBlock(bErro)
            Return OS_ERRO(404, "OS nao encontrada.")
        EndIf

        If !Empty(AllTrim(SZ1->Z1_IDCH))
            ErrorBlock(bErro)
            Return OS_ERRO(400, "OS vinculada ao chamado " + AllTrim(SZ1->Z1_IDCH) + " - a interacao deve ser gravada no chamado.")
        EndIf

        // OS aprovada/recusada: so o admin interage (reabre no INV depois de gravar).
        jMot["etapa"] := "CHECAR"
        aInv := apia.cnsa004.U_CNSAPR("INV", cOs, "", jMot)
        If !aInv[1]
            ErrorBlock(bErro)
            Return OS_ERRO(403, aInv[2])
        EndIf

        // ZA2_IDGRID unica entre as interacoes sem chamado (chave FILIAL+IDCH+IDGRID): MAX+1 sob trava (ate ~5 s).
        For nI := 1 To 25
            If LockByName("CNSAZA2_OS", .T., .F.)
                lTrava := .T.
                Exit
            EndIf
            Sleep(200)
        Next nI
        If !lTrava
            ErrorBlock(bErro)
            Return OS_ERRO(400, "Interacao em uso por outro usuario. Tente novamente.")
        EndIf

        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT MAX(ZA2_IDGRID) MAXGRID
            FROM %Table:ZA2% ZA2
            WHERE ZA2_FILIAL = %xFilial:ZA2%
              AND TRIM(ZA2_IDCH) IS NULL
              AND %NotDel%
        EndSql
        cSeq := AllTrim((cAlias)->MAXGRID)
        (cAlias)->(DbCloseArea())
        // Soma1: 999 -> A00.
        cSeq := If(Empty(cSeq), StrZero(1, 3), Soma1(PadL(cSeq, 3, "0")))

        DbSelectArea("ZA2")
        RecLock("ZA2", .T.)
            ZA2->ZA2_FILIAL := xFilial("ZA2")
            ZA2->ZA2_IDCH   := ""
            ZA2->ZA2_IDGRID := cSeq
            ZA2->ZA2_OS     := cOs
            ZA2->ZA2_CONSUL := Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC")
            ZA2->ZA2_DATA   := Date()
            ZA2->ZA2_HORA   := Left(Time(), 5)
            ZA2->ZA2_DESCRI := cTexto
        ZA2->(MsUnlock())
        UnLockByName("CNSAZA2_OS", .T., .F.)
        lTrava := .F.

        // Descricao vazia: a 1a interacao vira a descricao (blocos "=== INTERACAO" antigos ficam).
        If Empty(OS_SEPARAINTERACOES(SZ1->Z1_SERV)[1]) .And. RecLock("SZ1", .F.)
            SZ1->Z1_SERV := cTexto + OS_BLOCOSINTERACAO(SZ1->Z1_SERV)
            SZ1->(MsUnlock())
        EndIf

        // OS enviada e sem resposta perde o link; aprovada/recusada (admin) reabre.
        jMot := JsonObject():New()
        jMot["motivo"] := "interacao nova"
        aInv := apia.cnsa004.U_CNSAPR("INV", cOs, "", jMot)

        oJson['sucesso']  := .T.
        oJson['os']       := cOs
        oJson['seq']      := cSeq
        oJson['mensagem'] := If(aInv[1], "Interacao adicionada com sucesso.", "Interacao adicionada, mas a aprovacao nao foi atualizada: " + aInv[2])

        ErrorBlock(bErro)
        Return oRest:setStatusResponse(200, oJson:ToJson())

    Recover Using oErro
        ErrorBlock(bErro)
        If lTrava
            UnLockByName("CNSAZA2_OS", .T., .F.)
        EndIf
        Return OS_ERRO(500, oErro:Description)
    End Sequence
    ErrorBlock(bErro)

Return OS_ERRO(500, "Erro desconhecido.")

/*/{Protheus.doc} OS_APIEXCLUIRINTERACAO
POST /CNSAOSINTERACOESEXCLUIR - exclui interacao da OS sem chamado (ZA2_IDCH vazio): so o autor ou o admin
(mesma regra do CH_NUCLEOEXCLUIRINTERACAO). OS aprovada/recusada: so o admin, e ela reabre.
@return Logical - resposta HTTP com o resultado da exclusao
/*/
@Post(endpoint="/CNSAOSINTERACOESEXCLUIR")
User Function OS_APIEXCLUIRINTERACAO() As Logical
    Local jQuery     := OS_PARAMS() As Json
    Local cOs        := AllTrim(OS_LERJSONTXT(jQuery,"os"))
    Local cSeq       := AllTrim(OS_LERJSONTXT(jQuery,"seq"))
    Local oJson      := JsonObject():New()
    Local oErro      := Nil
    Local jMot       := JsonObject():New()
    Local aInv       := {}
    Local cAlias     := ""
    Local nRecno     := 0
    Local cAutor     := ""
    Local bErro      := Nil

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return OS_ERRO(403, "Usuario sem acesso a este recurso.")
    EndIf

    // Sem o ErrorBlock o erro nao cai no Recover. Restaurado em toda saida.
    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        If Empty(cOs) .Or. Empty(cSeq)
            ErrorBlock(bErro)
            Return OS_ERRO(400, "Informe a OS e a sequencia da interacao.")
        EndIf

        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT ZA2.R_E_C_N_O_ RECNO, ZA2_CONSUL
            FROM %Table:ZA2% ZA2
            WHERE ZA2_FILIAL = %xFilial:ZA2%
              AND ZA2_OS     = %Exp:cOs%
              AND TRIM(ZA2_IDCH) IS NULL
              AND ZA2_IDGRID = %Exp:cSeq%
              AND %NotDel%
        EndSql
        If !(cAlias)->(Eof())
            nRecno := (cAlias)->RECNO
            cAutor := AllTrim((cAlias)->ZA2_CONSUL)
        EndIf
        (cAlias)->(DbCloseArea())

        If nRecno == 0
            ErrorBlock(bErro)
            Return OS_ERRO(404, "Interacao nao encontrada.")
        EndIf
        // Autor ou admin (AA1_RSPMNT = 1).
        If cAutor <> AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC")) .And. ;
                AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_RSPMNT")) != "1"
            ErrorBlock(bErro)
            Return OS_ERRO(403, "Voce nao tem permissao para excluir esta interacao.")
        EndIf

        // OS aprovada/recusada: so o admin exclui (reabre no INV depois).
        jMot["etapa"] := "CHECAR"
        aInv := apia.cnsa004.U_CNSAPR("INV", cOs, "", jMot)
        If !aInv[1]
            ErrorBlock(bErro)
            Return OS_ERRO(403, aInv[2])
        EndIf

        DbSelectArea("ZA2")
        ZA2->(DbGoTo(nRecno))
        If !RecLock("ZA2", .F.)
            ErrorBlock(bErro)
            Return OS_ERRO(409, "Interacao em uso por outro usuario. Tente novamente.")
        EndIf
        ZA2->(DbDelete())
        ZA2->(MsUnlock())

        // OS enviada e sem resposta perde o link; aprovada/recusada (admin) reabre.
        jMot := JsonObject():New()
        jMot["motivo"] := "interacao excluida"
        apia.cnsa004.U_CNSAPR("INV", cOs, "", jMot)

        oJson['sucesso']  := .T.
        oJson['os']       := cOs
        oJson['mensagem'] := "Interacao excluida com sucesso."

        ErrorBlock(bErro)
        Return oRest:setStatusResponse(200, oJson:ToJson())

    Recover Using oErro
        ErrorBlock(bErro)
        Return OS_ERRO(500, oErro:Description)
    End Sequence
    ErrorBlock(bErro)

Return OS_ERRO(500, "Erro desconhecido.")

/*/{Protheus.doc} OS_ZA3
Chamados da OS - um por vez (Z1_IDCH = o atual); os anteriores saem das interacoes da OS (ZA2_OS):
  LER     (cOs, cIdChAtual)        atual + chamados das interacoes da OS -> array (todos os chamados da OS)
  PARAM   (jQuery)                 "chamados" (CSV) ou "chamado" -> {lVeio, aCodigos}
  VALIDAR (cOs, aCh, cCli, cLoja)  "" ou a mensagem (um chamado so, do mesmo cliente/loja)
  DESCRICAO (cOs)                  OS com chamado e descricao vazia (ou a automatica): grava
                                   "Referente ao(s) chamado(s) #..." com todos os chamados da OS
/*/
Static Function OS_ZA3(cAcao, x1, x2, x3, x4)
    Local xRet   := Nil
    Local aCh    := {}
    Local aLista := {}
    Local cAlias := ""
    Local cCod   := ""
    Local cOs    := ""
    Local nI     := 0

    Do Case

    Case cAcao == "LER"
        cOs    := AllTrim(x1)
        cCod   := AllTrim(cValToChar(x2))
        If !Empty(cCod)
            AAdd(aCh, cCod)
        EndIf
        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT DISTINCT ZA2_IDCH
            FROM %Table:ZA2% ZA2
            WHERE ZA2_FILIAL = %xFilial:ZA2%
              AND ZA2_OS     = %Exp:cOs%
              AND ZA2_IDCH  <> ' '
              AND %NotDel%
            ORDER BY ZA2_IDCH
        EndSql
        While !(cAlias)->(Eof())
            If AScan(aCh, AllTrim((cAlias)->ZA2_IDCH)) == 0
                AAdd(aCh, AllTrim((cAlias)->ZA2_IDCH))
            EndIf
            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())
        xRet := aCh

    Case cAcao == "PARAM"
        xRet   := {x1["chamados"] != Nil .Or. x1["chamado"] != Nil, {}}
        aLista := StrTokArr2(AllTrim(If(x1["chamados"] != Nil, OS_LERJSONTXT(x1, "chamados"), OS_LERJSONTXT(x1, "chamado"))), ",", .F.)
        For nI := 1 To Len(aLista)
            cCod := AllTrim(aLista[nI])
            If !Empty(cCod) .And. AScan(xRet[2], cCod) == 0
                AAdd(xRet[2], cCod)
            EndIf
        Next nI

    Case cAcao == "VALIDAR"
        xRet := ""
        // Um chamado por vez: trocar de chamado tira o anterior da OS (as interacoes dele ficam no historico).
        If Len(x2) > 1
            Return "Informe so um chamado por vez."
        EndIf
        ZA1->(DbSetOrder(1))
        For nI := 1 To Len(x2)
            If !ZA1->(DbSeek(xFilial("ZA1") + x2[nI]))
                Return "Chamado #" + x2[nI] + " nao encontrado."
            EndIf
            If AllTrim(ZA1->ZA1_CLIENT) != AllTrim(x3) .Or. AllTrim(ZA1->ZA1_LOJA) != AllTrim(x4)
                Return "Chamado #" + x2[nI] + " nao e do cliente da OS."
            EndIf
        Next nI

    Case cAcao == "DESCRICAO"
        cOs := PadR(AllTrim(x1), TamSX3("Z1_OS")[1])
        SZ1->(DbSetOrder(1))
        If SZ1->(DbSeek(cFilAnt + PadR(cOs, TamSX3("Z1_OS")[1]))) .And. !Empty(SZ1->Z1_IDCH)
            // So mexe na descricao vazia ou na automatica: texto digitado fica.
            cCod := U_CNSOUTL("TEXTOPURO", OS_SEPARAINTERACOES(SZ1->Z1_SERV)[1])
            If Empty(cCod) .Or. Left(cCod, 12) == "Referente ao"
                aCh  := OS_ZA3("LER", cOs, SZ1->Z1_IDCH)
                cCod := If(Len(aCh) == 1, "Referente ao chamado ", "Referente aos chamados ")
                ZA1->(DbSetOrder(1))
                For nI := 1 To Len(aCh)
                    cCod += If(nI > 1, ", ", "") + "#" + aCh[nI] + ;
                        If(ZA1->(DbSeek(xFilial("ZA1") + aCh[nI])), " - " + AllTrim(ZA1->ZA1_ASSUNT), "")
                Next nI
                RecLock("SZ1", .F.)
                    SZ1->Z1_SERV := cCod + OS_BLOCOSINTERACAO(SZ1->Z1_SERV)
                SZ1->(MsUnlock())
            EndIf
        EndIf

    EndCase

Return xRet

/*/{Protheus.doc} OS_EMAIL
E-mail e tela de envio da OS (o envio e do U_CNSAPR "ENV"):
  TELA      (cOs)  "Deseja enviar ao cliente?" -> U_CNSAPR("ENV")
  RESUMO    ()     linhas do cartao do e-mail (SZ1 posicionada)
  HORARIO   ()     "09:00 as 11:00"
  HORAS     ()     total "02:00"
  TAREFA    ()     "codigo - descricao" da tarefa ("" sem tarefa)
  DESCRICAO (cOs)  descricao em texto puro
  CHAMADOS  ()     {"#id - assunto"}
  DESTINO   ()     e-mails do cliente: chamados da OS, senao A1_EMAIL
  INTERACOES()     interacoes desta OS {data DD/MM/AAAA, hora, consultor, texto}, mais antiga primeiro
@param  cAcao   TELA, RESUMO, DESCRICAO, CHAMADOS, DESTINO ou INTERACOES
@param  x1      Parametro da acao (ver tabela acima)
@return xRet    Conforme a acao
/*/
Static Function OS_EMAIL(cAcao, x1)
    Local xRet    := Nil
    Local cOs     := ""
    Local cEmail  := ""
    Local cTexto  := ""
    Local aCh     := {}
    Local aResp   := {}
    Local cAlias  := ""
    Local xData   := Nil
    Local nI      := 0
    Local nJ      := 0

    Do Case

    Case cAcao == "TELA"
        cOs := PadR(AllTrim(cValToChar(x1)), TamSX3("Z1_OS")[1])
        SZ1->(DbSetOrder(1))
        If !Empty(cOs) .And. SZ1->(DbSeek(cFilAnt + PadR(cOs, TamSX3("Z1_OS")[1])))
            If MsgYesNo("Deseja enviar ao cliente? Ele recebe por e-mail o link para aprovar ou recusar a OS " + ;
                    AllTrim(cOs) + " (valido por " + cValToChar(SuperGetMV("MV_CNSAVLD", .F., 2)) + " dias).", "OS " + AllTrim(cOs))
                aResp := apia.cnsa004.U_CNSAPR("ENV", cOs)
                If aResp[1]
                    MsgInfo("OS " + AllTrim(cOs) + " enviada ao cliente." + CRLF + aResp[5], "OS " + AllTrim(cOs))
                Else
                    MsgAlert(aResp[2], "OS " + AllTrim(cOs))
                EndIf
            EndIf
        EndIf

    Case cAcao == "RESUMO"
        xRet := {}
        AAdd(xRet, {"OS", '<span style="color:#1a7fc1">' + AllTrim(SZ1->Z1_OS) + '</span>'})
        AAdd(xRet, {"Cliente", U_CNSOUTL("TEXTO", OS_NOMECLI(AllTrim(SZ1->Z1_CLI), AllTrim(SZ1->Z1_LOJA))) + " (Loja " + AllTrim(SZ1->Z1_LOJA) + ")"})
        AAdd(xRet, {"Data", DToC(SZ1->Z1_DTOS)})
        AAdd(xRet, {"Hor&aacute;rio", StrTran(OS_EMAIL("HORARIO"), " as ", " &agrave;s ")})
        AAdd(xRet, {"Total de horas", OS_EMAIL("HORAS")})
        AAdd(xRet, {"Analista", U_CNSOUTL("TEXTO", OS_NOMETEC(AllTrim(SZ1->Z1_TEC)))})
        If !Empty(SZ1->Z1_PROJET)
            AAdd(xRet, {"Projeto", AllTrim(SZ1->Z1_PROJET) + " - " + U_CNSOUTL("TEXTO", OS_NOMEPROJ(AllTrim(SZ1->Z1_PROJET)))})
        EndIf
        If !Empty(SZ1->Z1_TAREFA)
            AAdd(xRet, {"Tarefa", U_CNSOUTL("TEXTO", OS_EMAIL("TAREFA"))})
        EndIf
        If !Empty(SZ1->Z1_CHPSD)
            AAdd(xRet, {"Chamado Cliente", U_CNSOUTL("TEXTO", AllTrim(SZ1->Z1_CHPSD))})
        EndIf
        aCh := OS_ZA3("LER", AllTrim(SZ1->Z1_OS), AllTrim(SZ1->Z1_IDCH))
        If Len(aCh) > 0
            cTexto := ""
            For nI := 1 To Len(aCh)
                cTexto += If(nI > 1, "<br>", "") + "#" + aCh[nI] + " - " + ;
                    U_CNSOUTL("TEXTO", Posicione("ZA1", 1, xFilial("ZA1") + aCh[nI], "ZA1_ASSUNT"))
            Next nI
            AAdd(xRet, {"Chamados &Aacute;pia", cTexto})
        EndIf

    Case cAcao == "HORARIO"
        xRet := OS_HHMM(SZ1->Z1_HRINI) + " as " + OS_HHMM(SZ1->Z1_HRFIM)

    Case cAcao == "TAREFA"
        xRet := ""
        If !Empty(SZ1->Z1_TAREFA)
            cTexto := OS_NOMETAREFA(AllTrim(SZ1->Z1_PROJET), AllTrim(SZ1->Z1_TAREFA), AllTrim(SZ1->Z1_REVISA))
            xRet   := AllTrim(SZ1->Z1_TAREFA) + If(Empty(cTexto), "", " - " + cTexto)
        EndIf

    Case cAcao == "HORAS"
        If !Empty(AllTrim(SZ1->Z1_HRTOT))
            xRet := OS_HHMM(SZ1->Z1_HRTOT)
        ElseIf SZ1->Z1_TOTAL > 0
            xRet := StrZero(Int(SZ1->Z1_TOTAL), 2) + ":" + StrZero(Round((SZ1->Z1_TOTAL - Int(SZ1->Z1_TOTAL)) * 60, 0), 2)
        Else
            xRet := ""
        EndIf

    Case cAcao == "DESCRICAO"
        xRet := U_CNSOUTL("TEXTOPURO", OS_SEPARAINTERACOES(OS_DESC(x1))[1])

    Case cAcao == "CHAMADOS"
        xRet := {}
        aCh  := OS_ZA3("LER", AllTrim(SZ1->Z1_OS), AllTrim(SZ1->Z1_IDCH))
        For nI := 1 To Len(aCh)
            AAdd(xRet, "#" + aCh[nI] + " - " + AllTrim(Posicione("ZA1", 1, xFilial("ZA1") + aCh[nI], "ZA1_ASSUNT")))
        Next nI

    Case cAcao == "DESTINO"
        xRet := {}
        aCh  := OS_ZA3("LER", AllTrim(SZ1->Z1_OS), AllTrim(SZ1->Z1_IDCH))
        // E-mails dos chamados numa string so; sem nenhum, o do cliente.
        cTexto := ""
        For nI := 1 To Len(aCh)
            cTexto += ";" + Posicione("ZA1", 1, xFilial("ZA1") + aCh[nI], "ZA1_EMAIL")
        Next nI
        If !("@" $ cTexto)
            cTexto := Posicione("SA1", 1, xFilial("SA1") + SZ1->Z1_CLI + SZ1->Z1_LOJA, "A1_EMAIL")
        EndIf
        aResp := StrTokArr2(StrTran(cTexto, ",", ";"), ";", .F.)
        For nJ := 1 To Len(aResp)
            cEmail := Lower(AllTrim(aResp[nJ]))
            If "@" $ cEmail .And. AScan(xRet, cEmail) == 0
                AAdd(xRet, cEmail)
            EndIf
        Next nJ

    Case cAcao == "INTERACOES"
        xRet := {}
        cOs  := AllTrim(SZ1->Z1_OS)
        // Blocos do Memo (de quando a OS nao tinha chamado); sem chamado o Memo e so a descricao.
        If !Empty(AllTrim(SZ1->Z1_IDCH))
            aCh := OS_SEPARAINTERACOES(SZ1->Z1_SERV)[2]
            For nI := 1 To Len(aCh)
                AAdd(xRet, {aCh[nI][1], aCh[nI][2], aCh[nI][4], aCh[nI][5]})
            Next nI
        EndIf
        // ZA2 desta OS. ZA2_DESCRI (Memo) tem que ser a ultima coluna.
        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT ZA2_DATA, ZA2_HORA, ZA2_CONSUL, ZA2_DESCRI
            FROM %Table:ZA2% ZA2
            WHERE ZA2_FILIAL = %xFilial:ZA2%
              AND ZA2_OS     = %Exp:cOs%
              AND %NotDel%
            ORDER BY ZA2_DATA, ZA2_HORA
        EndSql
        While !(cAlias)->(Eof())
            xData := (cAlias)->ZA2_DATA
            AAdd(xRet, {DToC(If(ValType(xData) == "D", xData, SToD(AllTrim(xData)))), AllTrim((cAlias)->ZA2_HORA), ;
                OS_NOMETEC(AllTrim((cAlias)->ZA2_CONSUL)), U_CNSOUTL("UTF8", AllTrim((cAlias)->ZA2_DESCRI))})
            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())

    EndCase

Return xRet

/*/{Protheus.doc} OS_APRPUB
Expoe ao CNSA004 (U_CNSAPR) o que e Static aqui:
  GRAVAR (cOs, {{campo, valor}})  grava a SZ1 pelo model leve -> {lOk, cErro}
  RESUMO, DESTINO, DESCRICAO, CHAMADOS, HORARIO, HORAS, TAREFA, INTERACOES (cOs)  ver OS_EMAIL
/*/
User Function OS_APRPUB(cAcao, x1, x2)
    Local xRet   := Nil
    Local cOs    := PadR(AllTrim(cValToChar(x1)), TamSX3("Z1_OS")[1])
    Local oModel := Nil
    Local oSZ1   := Nil
    Local nI     := 0

    SZ1->(DbSetOrder(1))
    If !SZ1->(DbSeek(cFilAnt + PadR(cOs, TamSX3("Z1_OS")[1])))
        Return If(cAcao == "GRAVAR", {.F., "OS nao encontrada."}, If(cAcao $ "DESCRICAO|HORARIO|HORAS|TAREFA", "", {}))
    EndIf

    Do Case
    Case cAcao == "GRAVAR"
        oModel := OS_MODELLEVE(MODEL_OPERATION_UPDATE)
        oSZ1 := oModel:GetModel("SZ1MASTER")
        // SetValue (LoadValue nao marca o model como alterado e o CommitData nao grava).
        For nI := 1 To Len(x2)
            If !oSZ1:SetValue(x2[nI][1], x2[nI][2])
                xRet := {.F., OS_ERROMODEL(oModel, "Campo " + x2[nI][1] + " nao aceitou o valor.")}
                oModel:DeActivate()
                Return xRet
            EndIf
        Next nI
        If oModel:VldData() .And. oModel:CommitData()
            xRet := {.T., ""}
        Else
            xRet := {.F., OS_ERROMODEL(oModel, "Falha ao gravar a aprovacao na OS.")}
        EndIf
        oModel:DeActivate()

    Case cAcao == "DESCRICAO"
        xRet := OS_EMAIL("DESCRICAO", cOs)

    Otherwise   // RESUMO, DESTINO, CHAMADOS, HORARIO, HORAS, TAREFA, INTERACOES (SZ1 posicionada)
        xRet := OS_EMAIL(cAcao)
    EndCase

Return xRet

/*/{Protheus.doc} CNS002APR
Evento de aprovacao do model da OS (U_CNSAPR "OS"):
  ModelPosVld = fase VLD (permissao), BeforeTTS = ANT (calcula Z1_APROVAD/Z1_APVTIPO),
  InTTS = GRV (grava a reabertura na SZA), AfterTTS = DEP (pos-commit, fora da transacao)
/*/
// TLPP: membro sem visibilidade e PRIVATE.
Class CNS002APR From FWModelEvent
    Public Data lReabriu
    Public Data cInval
    Public Method New() Constructor
    Public Method ModelPosVld(oModel, cModelId)
    Public Method BeforeTTS(oModel, cModelId)
    Public Method InTTS(oModel, cModelId)
    Public Method AfterTTS(oModel, cModelId)
EndClass

Method New() Class CNS002APR
    ::lReabriu := .F.
    ::cInval   := ""
Return Self

Method ModelPosVld(oModel, cModelId) Class CNS002APR
    Local jFase := JsonObject():New()
    Local aRet  := {}

    jFase["fase"] := "VLD"
    aRet := apia.cnsa004.U_CNSAPR("OS", oModel, "", jFase)
    If !aRet[1]
        oModel:SetErrorMessage("SZ1MASTER", "Z1_APROVAD", "SZ1MASTER", "Z1_APROVAD", "CNS002APR", aRet[2])
    EndIf

Return aRet[1]

Method BeforeTTS(oModel, cModelId) Class CNS002APR
    Local jFase := JsonObject():New()
    Local aRet  := {}

    jFase["fase"] := "ANT"
    aRet := apia.cnsa004.U_CNSAPR("OS", oModel, "", jFase)
    ::lReabriu := Len(aRet) >= 5 .And. aRet[5]
    // OS enviada que mudou: motivo da invalidacao do link (vai pra SZA e pro e-mail ao cliente).
    ::cInval   := If(Len(aRet) >= 6, aRet[6], "")

Return

Method InTTS(oModel, cModelId) Class CNS002APR
    Local jFase := JsonObject():New()

    If ::lReabriu
        jFase["fase"]    := "GRV"
        jFase["reabriu"] := "S"
        jFase["motivo"]  := ::cInval
        apia.cnsa004.U_CNSAPR("OS", oModel, "", jFase)
        ::lReabriu := .F.
    EndIf

Return

// Depois do commit: e-mail pendente da invalidacao do link e libera a trava da aprovacao (U_CNSAPR).
Method AfterTTS(oModel, cModelId) Class CNS002APR
    Local jFase := JsonObject():New()

    jFase["fase"] := "DEP"
    apia.cnsa004.U_CNSAPR("OS", oModel, "", jFase)

Return

/*/{Protheus.doc} OS_APRTELA
Menu de aprovacao da tela classica (regra, estado e e-mails no U_CNSAPR):
  ENV enviar ao cliente, PRE/PRR pre-aprovar/pre-recusar (M), APR/REC aprovar/recusar (I)
@param  cTrans  Transacao do U_CNSAPR
/*/
User Function OS_APRTELA(cTrans)
    Local cOs     := AllTrim(SZ1->Z1_OS)
    Local jDados  := JsonObject():New()
    Local aRet    := {}
    Local cTexto  := ""
    Local cOrigem := ""
    Local oDlg    := Nil
    Local oBtnOk  := Nil
    Local cMotAprov := Space(240)
    Local lMotConf  := .F.

    If SZ1->(Eof()) .Or. SZ1->(Bof()) .Or. Empty(cOs)
        MsgAlert("Nenhuma OS selecionada.", "Aprovacao de OS")
        Return
    EndIf

    Do Case
    Case cTrans == "ENV"
        cTexto  := "Enviar a OS " + cOs + " ao cliente? Ele recebe por e-mail o link para aprovar ou recusar (valido por " + ;
                   cValToChar(SuperGetMV("MV_CNSAVLD", .F., 2)) + " dias)."
    Case cTrans == "PRE"
        cTexto  := "Pre-aprovar a OS " + cOs + "?"
        cOrigem := "M"
    Case cTrans == "PRR"
        cTexto  := "Pre-recusar a OS " + cOs + "?"
        cOrigem := "M"
    Case cTrans == "APR"
        cTexto  := "Aprovar manualmente a OS " + cOs + "?"
        cOrigem := "I"
    Case cTrans == "REC"
        cTexto  := "Recusar manualmente a OS " + cOs + "?"
        cOrigem := "I"
    EndCase

    If cTrans == "PRR" .Or. cTrans == "REC"
        DEFINE MSDIALOG oDlg TITLE cTexto FROM 0,0 TO 220,460 PIXEL
            @ 08,10 SAY "Motivo (obrigatorio):" SIZE 200,10 PIXEL OF oDlg
            @ 20,10 GET cMotAprov MEMO SIZE 210,60 PIXEL OF oDlg
            oBtnOk := TButton():New(88, 160, "Confirmar", oDlg, {|| lMotConf := .T., oDlg:End()}, 60,14,,,.F.,.T.,.F.,,.F.,,,.F.)
        ACTIVATE MSDIALOG oDlg CENTERED
        If !lMotConf
            Return
        EndIf
        jDados["motivo"] := AllTrim(cMotAprov)
    ElseIf !MsgYesNo(cTexto, "Aprovacao de OS")
        Return
    EndIf

    aRet := apia.cnsa004.U_CNSAPR(cTrans, cOs, cOrigem, jDados)
    If aRet[1]
        MsgInfo("OS " + cOs + ": feito." + If(Len(aRet) >= 5, CRLF + aRet[5], ""), "Aprovacao de OS")
    Else
        MsgAlert(aRet[2], "Aprovacao de OS")
    EndIf

Return
