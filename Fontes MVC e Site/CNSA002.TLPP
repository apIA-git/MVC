//-------------------------------------------------------------------
/*/{Protheus.doc} OS_MODELLEVE
Monta um Model leve, so com a tabela SZ1 (sem o grid SZ2DETAIL) -
usado por Incluir/Alterar/Copiar em vez de FWLoadModel("CNS002"), ja
que SZ2DETAIL e relacionado por CLIENTE (nao por OS) e traria risco de
cascata (ver aviso no topo do arquivo). Pluga OS_VALIDACAMPO como
PosValidacao dos campos da SZ1.
@return oModel   Objeto MPFormModel leve (so SZ1MASTER) montado
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_MODELLEVE()
    Local oModel  := Nil
    Local oStrSZ1 := FWFormStruct(1, "SZ1")

    OS_STRUCTHEADLESS(oStrSZ1)

    // Pos-validacao: agendamento "Nao Cobrar" so aceita servico nao cobravel.
    oModel := MPFormModel():New("FCNS002REST", NIL, {|o| OS_VALIDACOBRAR(o)}, NIL, NIL)
    // FIX: faltava plugar OS_VALIDACAMPO como PosValidacao (4o parametro) -
    // sem isso, Incluir/Alterar via Class oRestOS aceitava OS sem cliente/
    // tecnico/nada, sem erro (a validacao dos 12 campos obrigatorios so
    // existia no ModelDef002 completo da tela classica, nunca rodava aqui).
    oModel:AddFields("SZ1MASTER", NIL, oStrSZ1, {|_f,_a,_c,_v| OS_VALIDACAMPO(_f,_a,_c,_v)}, NIL)
    oModel:SetPrimaryKey({"Z1_FILIAL", "Z1_OS"})

Return oModel

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_STRUCTHEADLESS
Ajusta a estrutura da SZ1 dos models headless (OS_MODELLEVE/
OS_MODELINSERT - REST e Copiar). Fora da tela nao existe o ambiente de
variaveis de memoria (M->) que o dicionario usa: X3_VALID (ex:
existcpo("SA1") no Z1_CLI, ExistChav("SZ1") no Z1_OS) quebra com
"type mismatch on +" e o X3_RELACAO dos campos virtuais (ex: FDESC do
nome do cliente) quebra no Activate com "_SetNamedPrvt: owner private
environment not found". Remove os campos virtuais (nao usados aqui - nomes
vem por SQL) e troca VALID/WHEN do dicionario por .T.; obrigatorios
continuam validados por OS_VALIDACAMPO/OS_PREVALIDA.
@param  oStrSZ1   Estrutura FWFormStruct(1, "SZ1") a ajustar
@author Henrique
@since 23/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_STRUCTHEADLESS(oStrSZ1)
    Local aCampos   := oStrSZ1:GetFields()
    Local aVirtuais := {}
    Local nI        := 0

    // Representante opcional (REST) mesmo se o dicionario marcar obrigatorio.
    oStrSZ1:SetProperty("Z1_USR", MODEL_FIELD_OBRIGAT, .F.)
    oStrSZ1:SetProperty("Z1_SERV", MODEL_FIELD_OBRIGAT, .F.)
    oStrSZ1:SetProperty("Z1_TEC", MODEL_FIELD_OBRIGAT, .F.)

    For nI := 1 To Len(aCampos)
        If aCampos[nI][MODEL_FIELD_VIRTUAL]
            AAdd(aVirtuais, aCampos[nI][MODEL_FIELD_IDFIELD])
        Else
            oStrSZ1:SetProperty(aCampos[nI][MODEL_FIELD_IDFIELD], MODEL_FIELD_VALID, {|| .T.})
            oStrSZ1:SetProperty(aCampos[nI][MODEL_FIELD_IDFIELD], MODEL_FIELD_WHEN,  {|| .T.})
        EndIf
    Next nI

    For nI := 1 To Len(aVirtuais)
        oStrSZ1:RemoveField(aVirtuais[nI])
    Next nI

Return

// Monta E ativa o model de Insert na MESMA funcao (nao chama OS_MODELLEVE()
// e ativa depois na funcao chamadora) - mesmo bug/fix do CH_MODELINSERT em
// CNSA001.TLPP: FWInitCpo prende o "owner private environment" ao stack
// frame de quem monta o model (New/AddFields); se o Activate() de Insert
// roda numa funcao diferente de quem montou, INITVALUE quebra com
// "_SetNamedPrvt: owner private environment not found" (campo Data do SZ1
// - Z1_DTOS/Z1_DTDIGIT - dispara o calculo de valor inicial em branco).
// So afeta Insert (Update/Delete carregam valor existente, nunca disparam
// INITVALUE) - por isso a montagem esta duplicada aqui em vez de reusar
// OS_MODELLEVE(). Uso exclusivo dos fluxos de Insert headless
// (OS_NUCLEOCOPIAR, SaveData Incluir, OS_NUCLEOINCLUIR).
//-------------------------------------------------------------------
Static Function OS_MODELINSERT()
    Local oModel  := Nil
    Local oStrSZ1 := FWFormStruct(1, "SZ1")

    OS_STRUCTHEADLESS(oStrSZ1)

    // Pos-validacao com os mesmos obrigatorios da tela classica (OS_PREVALIDA,
    // bloco nOper == 3) - antes o REST so dependia do formulario do front.
    oModel := MPFormModel():New("FCNS002REST", NIL, {|o| OS_PREVALIDA(o) .And. OS_VALIDACOBRAR(o)}, NIL, NIL)
    oModel:AddFields("SZ1MASTER", NIL, oStrSZ1, {|_f,_a,_c,_v| OS_VALIDACAMPO(_f,_a,_c,_v)}, NIL)
    oModel:SetPrimaryKey({"Z1_FILIAL", "Z1_OS"})

    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

Return oModel

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_NUCLEOCOPIAR
Nucleo de copia de OS - usado pela tela (OS_COPIARTELA) e pelo REST
(OS_APICOPIAR). Le a OS de origem, copia todos os campos (exceto os
fixos: chave, digitacao, aprovacao/faturamento) para uma OS nova via
Model leve (OS_MODELLEVE), dentro de Begin Sequence/Recover para nao
deixar o model pendurado em caso de excecao.
@param  cOsOrigem   Numero (Z1_OS) da OS a ser copiada
@return aRet        Array {lOk, cErro, cOsNova}
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_NUCLEOCOPIAR(cOsOrigem)
    Local aFields    := {}
    Local nI         := 0
    Local cOsNova    := ""
    Local aFixos     := {"Z1_OS", "Z1_FILIAL", "Z1_DTDIGIT", "Z1_APROVAD", "Z1_FATURAR", ;
        "Z1_APVDOR", "Z1_APVMAIL", "Z1_APVIP", "Z1_APVDATA", "Z1_APVHORA", ;
        "D_E_L_E_T_", "R_E_C_N_O_", "R_E_C_D_E_L_"}
    Local oModel     := Nil
    Local oModelSZ1  := Nil
    Local lOk        := .F.
    Local cErro      := ""
    Local cErroModel := Nil
    Local oErroExcpt := Nil

    If Empty(cOsOrigem)
        Return {.F., "Informe o numero da OS a copiar.", ""}
    EndIf

    DbSelectArea("SZ1")
    SZ1->(DbSetOrder(1))
    If !SZ1->(DbSeek(cFilAnt + cOsOrigem))
        Return {.F., "OS nao encontrada.", ""}
    EndIf

    For nI := 1 To SZ1->(FCount())
        If AScan(aFixos, SZ1->(FieldName(nI))) == 0
            AAdd(aFields, {SZ1->(FieldName(nI)), SZ1->(FieldGet(nI))})
        EndIf
    Next nI

    // FIX: sem Begin Sequence/Recover, uma excecao real entre Activate() e
    // DeActivate() deixava o model pendurado pra sempre (mesma classe de bug
    // ja corrigida no CH_GRAVARAGENDA do CNS001.TLPP).
    Begin Sequence

        cOsNova := OS_PROXIMONUM()

        // OS_MODELINSERT (nao OS_MODELLEVE + Activate separado): monta e
        // ativa na MESMA funcao, senao "_SetNamedPrvt: owner private
        // environment not found" no INITVALUE do Insert.
        oModel    := OS_MODELINSERT()
        oModelSZ1 := oModel:GetModel("SZ1MASTER")

        For nI := 1 To Len(aFields)
            oModelSZ1:SetValue(aFields[nI][1], aFields[nI][2])
        Next nI

        // Campos que devem ser diferentes na copia
        oModelSZ1:SetValue("Z1_FILIAL",  cFilAnt)
        // LoadValue (nao SetValue): X3_VALID do Z1_OS (ExistChav("SZ1")) quebra
        // com type mismatch fora da tela (rota REST, sem M->Z1_OS). Numero ja
        // vem unico do OS_PROXIMONUM.
        oModelSZ1:LoadValue("Z1_OS", cOsNova)
        oModelSZ1:SetValue("Z1_DTDIGIT", Date())
        oModelSZ1:SetValue("Z1_APROVAD", "N")
        oModelSZ1:SetValue("Z1_FATURAR", "N")
        oModelSZ1:SetValue("Z1_APVDOR",  "")
        oModelSZ1:SetValue("Z1_APVMAIL", "")
        oModelSZ1:SetValue("Z1_APVIP",   "")
        // Copia e outro atendimento: nasce sem chamados (ZA3 nao e copiada).
        oModelSZ1:LoadValue("Z1_IDCH",   "")
        oModelSZ1:SetValue("Z1_APVDATA", CtoD(""))
        oModelSZ1:SetValue("Z1_APVHORA", "")

        If oModel:VldData()
            lOk := oModel:CommitData()
        EndIf

        If !lOk
            cErroModel := oModel:GetErrorMessage()
            Do Case
                Case ValType(cErroModel) == "C"
                    cErro := cErroModel
                Case ValType(cErroModel) == "O"
                    cErro := cErroModel:GetMessage()
                Case ValType(cErroModel) == "A"
                    cErro := FwJsonSerialize(cErroModel)
                Otherwise
                    cErro := "Falha ao copiar a OS."
            EndCase
        EndIf

        oModel:DeActivate(lOk)

    Recover Using oErroExcpt
        lOk   := .F.
        cErro := "Erro interno: " + oErroExcpt:Description
        If oModel <> Nil
            oModel:DeActivate()
        EndIf
    End Sequence

    If !lOk
        ConfirmSX8(.F.)
        Return {.F., cErro, ""}
    EndIf

    ConfirmSX8()

Return {.T., "", cOsNova}

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_VISUALIZARTELA
Opcao de menu "Visualizar" da tela classica: abre a View em modo consulta.
Mesmo padrao do CH_VISUALIZARTELA (CNSA001).
@author Henrique
@since 28/09/2026
@version P12
/*/
//-------------------------------------------------------------------
User Function OS_VISUALIZARTELA()
    // MODEL_OPERATION_VIEW e 1, nao 2 - "2" e so o codigo do botao no ADD
    // OPTION (Browse), FWFormModel:SetOperation so aceita {1,3,4,5,6}.
    // Model montado e ativado AQUI (ver OS_MONTARMODEL) - sem isso o INITVALUE
    // dos campos virtuais quebra com "owner private environment not found".
    Local oModel := OS_MONTARMODEL(MODEL_OPERATION_VIEW)

    FWExecView("Ordem de Servico", "apia.cnsa002.u_cns002", MODEL_OPERATION_VIEW, , {|| .T.}, NIL, NIL, NIL, NIL, NIL, NIL, oModel)
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_INCLUIRTELA
Opcao de menu "Incluir" da tela classica: monta e ativa o Model em
inclusao aqui (OS_MONTARMODEL(MODEL_OPERATION_INSERT)) e abre a View com ele. Mesmo padrao
do CH_INCLUIRTELA (CNSA001).
@author Henrique
@since 28/09/2026
@version P12
/*/
//-------------------------------------------------------------------
User Function OS_INCLUIRTELA()
    Local oModel := Nil
    Local cOs    := ""

    // M->Z1_* no frame que fica vivo com a tela aberta (lupas/F3 - ver
    // CH_INCLUIRTELA no CNSA001, mesmo problema).
    RegToMemory("SZ1", .T., .F.)
    oModel := OS_MONTARMODEL(MODEL_OPERATION_INSERT)
    cOs    := oModel:GetModel("SZ1MASTER"):GetValue("Z1_OS")

    // FWExecView devolve 0 quando grava: pergunta cliente/tecnico (OS_EMAIL "TELA").
    If FWExecView("Ordem de Servico", "apia.cnsa002.u_cns002", MODEL_OPERATION_INSERT, , {|| .T.}, NIL, NIL, NIL, NIL, NIL, NIL, oModel) == 0
        OS_EMAIL("TELA", cOs)
    EndIf
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_ALTERARTELA
Opcao de menu "Alterar" da tela classica: abre a View em modo alteracao
da OS posicionada. Mesmo padrao do CH_ALTERARTELA (CNSA001), sem o gate
de administrador (a OS nao tem essa regra).
@author Henrique
@since 28/09/2026
@version P12
/*/
//-------------------------------------------------------------------
User Function OS_ALTERARTELA()
    // Model montado e ativado AQUI (ver OS_MONTARMODEL / OS_VISUALIZARTELA).
    Local oModel := Nil
    Local cOs    := SZ1->Z1_OS

    // M->Z1_* no frame que fica vivo com a tela aberta (lupas/F3).
    RegToMemory("SZ1", .F., .F.)
    oModel := OS_MONTARMODEL(MODEL_OPERATION_UPDATE)

    // FWExecView devolve 0 quando grava: pergunta cliente/tecnico (OS_EMAIL "TELA").
    If FWExecView("Ordem de Servico", "apia.cnsa002.u_cns002", MODEL_OPERATION_UPDATE, , {|| .T.}, NIL, NIL, NIL, NIL, NIL, NIL, oModel) == 0
        OS_EMAIL("TELA", cOs)
    EndIf
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_EXCLUIRTELA
Opcao de menu "Excluir" da tela classica: abre a View em modo exclusao da
OS posicionada, com o Model montado e ativado aqui (ver OS_MONTARMODEL) -
mesmo padrao do OS_VISUALIZARTELA/OS_ALTERARTELA.
@author Henrique
@since 28/09/2026
@version P12
/*/
//-------------------------------------------------------------------
User Function OS_EXCLUIRTELA()
    Local oModel := OS_MONTARMODEL(MODEL_OPERATION_DELETE)

    FWExecView("Ordem de Servico", "apia.cnsa002.u_cns002", MODEL_OPERATION_DELETE, , {|| .T.}, NIL, NIL, NIL, NIL, NIL, NIL, oModel)
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_COPIARTELA
Copiar OS a partir do item de menu da tela classica - mesmo dialogo do
COPIAR_OS original, agora chamando o nucleo compartilhado
(OS_NUCLEOCOPIAR, via Model leve) em vez de RecLock direto.
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
User Function OS_COPIARTELA()
    Local cOs       := ""
    Local aResultado := {}

    If SZ1->(Eof())
        MsgStop("Selecione uma OS para copiar.", "Copiar OS")
        Return
    EndIf

    cOs := AllTrim(SZ1->Z1_OS)

    If !MsgYesNo("Deseja copiar a OS " + cOs + "?", "Copiar OS")
        Return
    EndIf

    aResultado := OS_NUCLEOCOPIAR(cOs)

    If aResultado[1]
        MsgInfo("OS copiada com sucesso! Nova OS: " + aResultado[3], "Copiar OS")
    Else
        MsgStop("Erro ao copiar a OS: " + aResultado[2], "Copiar OS")
    EndIf

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_LEGENDA
Exibe a legenda de status da OS (BrwLegenda) - identico a funcao
LEGENDA original.
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
User Function OS_LEGENDA()

    BrwLegenda("Legenda de Status", "Status da OS", ;
        { ;
            { "BR_VERDE",     "Faturada e Aprovada"    }, ;
            { "BR_PINK",      "Faturada sem Aprovacao" }, ;
            { "BR_AZUL",      "Aprovada"               }, ;
            { "BR_AMARELO",   "Aguardando Aprovacao"   }, ;
            { "BR_PRETO",     "Negada"                 }  ;
        })

Return

////////////////////////////////////////////////////////////////////////////////////////////////
//                                                                                              //
//                       CLASS REST GENERICA - Incluir/Alterar/Visualizar                      //
//                                                                                              //
////////////////////////////////////////////////////////////////////////////////////////////////
Class oRestOS From FwRestModel

Method SaveData(cPK, cData, cError)

EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} SaveData
Implementacao generica de gravacao exigida pelo PUBLISH MODEL REST
(Class oRestOS From FwRestModel). CODIGO MORTO do ponto de vista do
front real (apia-po-cnshub): confirmado lendo os-serv.ts que
Incluir/Alterar mandam tudo via QUERY STRING com corpo POST sempre
`null` (nunca JSON body) - mesmo problema ja corrigido no CNS001.TLPP
para o front de Chamados. Os endpoints DE VERDADE usados pelo front
sao OS_APIINCLUIR/OS_APIALTERAR (@Post custom lendo query string).
Mantido aqui so porque o PUBLISH MODEL REST exige a Class existir -
nunca chamado por esse front. NUNCA delega pro `_Super` (ver aviso no
topo do arquivo sobre risco de cascata no SZ2DETAIL relacionado por
cliente), caso algum dia alguem chame o generico de verdade.
@param  cPK      Chave primaria (vazia = Incluir, preenchida = Alterar)
@param  cData    Corpo JSON da requisicao (nunca usado por este front)
@param  cError   Variavel de saida com a mensagem de erro (por referencia)
@return lOk      .T. se gravou com sucesso, .F. caso contrario
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Method SaveData(cPK, cData, cError) Class oRestOS
Local jBody      := Nil
Local oModel     := Nil
Local oModelSZ1  := Nil
Local lOk        := .F.
Local cErro      := ""
Local cErroModel := Nil
Local oErroExcpt := Nil
Local cOs        := ""
Local lIncluir   := Empty(cPK)

    Begin Sequence
        jBody := JsonObject():New()
        jBody:fromJson(cData)
        If jBody == Nil
            cError := "Corpo da requisicao invalido (JSON malformado)."
            lOk    := .F.
        Else
            If lIncluir
                // OS_MODELINSERT (nao OS_MODELLEVE + Activate separado):
                // monta e ativa na MESMA funcao, senao "_SetNamedPrvt:
                // owner private environment not found" no INITVALUE do
                // Insert.
                oModel    := OS_MODELINSERT()
                oModelSZ1 := oModel:GetModel("SZ1MASTER")

                cOs := OS_PROXIMONUM()
                oModelSZ1:SetValue("Z1_FILIAL",  cFilAnt)
                // LoadValue (nao SetValue): X3_VALID do Z1_OS (ExistChav("SZ1")) quebra
                // com type mismatch fora da tela (rota REST, sem M->Z1_OS). Numero ja
                // vem unico do OS_PROXIMONUM.
                oModelSZ1:LoadValue("Z1_OS", cOs)
                oModelSZ1:SetValue("Z1_APROVAD", "N")
                oModelSZ1:SetValue("Z1_FATURAR", "N")
            Else
                cOs := cPK
                DbSelectArea("SZ1")
                SZ1->(DbSetOrder(1))
                If !SZ1->(DbSeek(cFilAnt + cOs))
                    cError := "OS nao encontrada."
                    Return .F.
                EndIf
                oModel := OS_MODELLEVE()
                oModel:SetOperation(MODEL_OPERATION_UPDATE)
                oModel:Activate()
                oModelSZ1 := oModel:GetModel("SZ1MASTER")
            EndIf

            // Mapeamento generico: qualquer campo Z1_* que vier no JSON e
            // setado - Incluir grava tudo, Alterar so o que veio (parcial).
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_CLI")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_LOJA")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_USR")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_MODULO")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_MOTIV")
            OS_SETTEXTOUTF8(oModelSZ1, jBody, "Z1_SERV")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_TIPO")
            OS_SETDATAOS(oModelSZ1, jBody, "Z1_DTOS")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_INTERNO")
            OS_SETNUM(oModelSZ1, jBody, "Z1_INI")
            OS_SETNUM(oModelSZ1, jBody, "Z1_FIM")
            OS_SETNUM(oModelSZ1, jBody, "Z1_TRANS")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_PREVIST")
            OS_SETNUM(oModelSZ1, jBody, "Z1_TOTAL")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_TEC")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_NUMPRO")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_PV")
            OS_SETNUM(oModelSZ1, jBody, "Z1_ALMOCO")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_PROJET")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_REVISA")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_TAREFA")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_CHPSD")
            OS_SETNUM(oModelSZ1, jBody, "Z1_CHHDK")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_OSDESE")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_OSENVCL")
            OS_SETSEFICOU(oModelSZ1, jBody, "Z1_LIN")
            OS_SETNUM(oModelSZ1, jBody, "Z1_VLRHR")

            // Z1_LOJA NAO recebe default silencioso: e campo obrigatorio
            // (aObrigatorios em OS_VALIDACAMPO) - se faltar, VldData() reprova
            // com erro, igual o original exigia explicitamente.
            If lIncluir .And. Empty(oModelSZ1:GetValue("Z1_INTERNO"))
                oModelSZ1:SetValue("Z1_INTERNO", "N")
            EndIf
            If lIncluir .And. Empty(oModelSZ1:GetValue("Z1_OSDESE"))
                oModelSZ1:SetValue("Z1_OSDESE", "N")
            EndIf
            // Z1_OSENVCL (OS Enviada, S/N) e obrigatorio - OS antigas estao
            // vazias, entao preenche "N" tambem no Alterar.
            If Empty(oModelSZ1:GetValue("Z1_OSENVCL"))
                oModelSZ1:SetValue("Z1_OSENVCL", "N")
            EndIf
            If lIncluir .And. Empty(oModelSZ1:GetValue("Z1_DTDIGIT"))
                oModelSZ1:SetValue("Z1_DTDIGIT", Date())
            EndIf

            If oModel:VldData()
                lOk := oModel:CommitData()
            Else
                lOk := .F.
            EndIf

            If !lOk
                cErroModel := oModel:GetErrorMessage()
                Do Case
                    Case ValType(cErroModel) == "C"
                        cErro := cErroModel
                    Case ValType(cErroModel) == "O"
                        cErro := cErroModel:GetMessage()
                    Case ValType(cErroModel) == "A"
                        cErro := FwJsonSerialize(cErroModel)
                    Otherwise
                        cErro := "Falha ao validar/gravar a OS."
                EndCase
                cError := cErro
            EndIf

            oModel:DeActivate(lOk)

            If lIncluir
                If lOk
                    ConfirmSX8()
                Else
                    ConfirmSX8(.F.)
                EndIf
            EndIf
        EndIf
    Recover Using oErroExcpt
        lOk    := .F.
        cError := "Erro interno: " + oErroExcpt:Description
        If lIncluir
            ConfirmSX8(.F.)
        EndIf
        If oModel <> Nil
            oModel:DeActivate()
        EndIf
    End Sequence

////////////////////////////////////////////////////////////////////////////////////////////////
//                                                                                              //
//                    INCLUIR/ALTERAR - endpoints REAIS usados pelo front                     //
//                    (query string, corpo POST sempre null - confirmado                       //
//                    lendo os-serv.ts)                                                        //
//                                                                                              //
////////////////////////////////////////////////////////////////////////////////////////////////

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_NUCLEOINCLUIR
Nucleo de inclusao de OS - usado por OS_APIINCLUIR. Le os campos vindos
na query string (cliente, usuario, modulo, motivo, descricao, servico,
datas, horas, tecnico, etc), grava via Model leve (OS_MODELLEVE) dentro
de Begin Sequence/Recover. Campo obrigatorio nao valida mais aqui -
front-end valida antes de chamar, e OS_PREVALIDA (Model) cobre via
SetErrorMessage.
@param  jQuery   Objeto Json com os parametros da query string
@return aRet     Array {lOk, cErro, cOs}
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_NUCLEOINCLUIR(jQuery)
    Local oModel     := Nil
    Local oModelSZ1  := Nil
    Local lOk        := .F.
    Local cErro      := ""
    Local cErroModel := Nil
    Local oErroExcpt := Nil
    Local cOs        := ""
    Local cDtDigit   := AllTrim(OS_LERJSONTXT(jQuery, "dtDigitacao"))
    Local aHrIni     := OS_LERHORA(jQuery, "horaInicial", "horaInicialDec")
    Local aHrFim     := OS_LERHORA(jQuery, "horaFinal", "horaFinalDec")
    // Chamados da OS (ZA3) - so do mesmo cliente/loja da OS.
    Local aParCh     := OS_ZA3("PARAM", jQuery)
    Local cMsgCh     := OS_ZA3("VALIDAR", "", aParCh[2], AllTrim(OS_LERJSONTXT(jQuery, "codCliente")), ;
                            If(Empty(AllTrim(OS_LERJSONTXT(jQuery, "lojaCliente"))), "01", AllTrim(OS_LERJSONTXT(jQuery, "lojaCliente"))))

    If !Empty(cMsgCh)
        Return {.F., cMsgCh, ""}
    EndIf

    // Campo obrigatorio nao valida mais aqui - front-end valida antes de
    // chamar, e OS_PREVALIDA (Model) cobre via SetErrorMessage.

    Begin Sequence

        // OS_MODELINSERT (nao OS_MODELLEVE + Activate separado): monta e
        // ativa na MESMA funcao, senao "_SetNamedPrvt: owner private
        // environment not found" no INITVALUE do Insert.
        oModel    := OS_MODELINSERT()
        oModelSZ1 := oModel:GetModel("SZ1MASTER")

        cOs := OS_PROXIMONUM()

        oModelSZ1:SetValue("Z1_FILIAL",  cFilAnt)
        // LoadValue (nao SetValue): X3_VALID do Z1_OS (ExistChav("SZ1")) quebra
        // com type mismatch fora da tela (rota REST, sem M->Z1_OS). Numero ja
        // vem unico do OS_PROXIMONUM.
        oModelSZ1:LoadValue("Z1_OS", cOs)
        oModelSZ1:SetValue("Z1_DTDIGIT", If(Empty(cDtDigit), Date(), STOD(StrTran(cDtDigit,"-",""))))
        oModelSZ1:SetValue("Z1_CLI",     AllTrim(OS_LERJSONTXT(jQuery,"codCliente")))
        oModelSZ1:SetValue("Z1_LOJA",    AllTrim(OS_LERJSONTXT(jQuery,"lojaCliente")))
        oModelSZ1:SetValue("Z1_USR",     AllTrim(OS_LERJSONTXT(jQuery,"usuario")))
        oModelSZ1:SetValue("Z1_MODULO",  AllTrim(OS_LERJSONTXT(jQuery,"modulo")))
        oModelSZ1:SetValue("Z1_MOTIV",   AllTrim(OS_LERJSONTXT(jQuery,"motivo")))
        oModelSZ1:SetValue("Z1_SERV",    AllTrim(OS_LERJSONTXT(jQuery,"descricao")))
        oModelSZ1:SetValue("Z1_TIPO",    AllTrim(OS_LERJSONTXT(jQuery,"codServico")))
        oModelSZ1:SetValue("Z1_DTOS",    STOD(StrTran(AllTrim(OS_LERJSONTXT(jQuery,"dataOs")), "-", "")))
        oModelSZ1:SetValue("Z1_INI",     aHrIni[1])
        oModelSZ1:SetValue("Z1_FIM",     aHrFim[1])
        oModelSZ1:LoadValue("Z1_HRINI",  OS_HORACAMPO(aHrIni[2], "Z1_HRINI"))
        oModelSZ1:LoadValue("Z1_HRFIM",  OS_HORACAMPO(aHrFim[2], "Z1_HRFIM"))
        oModelSZ1:SetValue("Z1_TOTAL",   If(OS_LERJSONNUM(jQuery,"horasTiDec") <> 0, OS_LERJSONNUM(jQuery,"horasTiDec"), Round(aHrFim[1] - aHrIni[1], 2)))
        // Analista opcional - so seta se veio (vazio no SetValue pode cair no VALID do dicionario).
        If !Empty(AllTrim(OS_LERJSONTXT(jQuery,"codAnalista")))
            oModelSZ1:SetValue("Z1_TEC", AllTrim(OS_LERJSONTXT(jQuery,"codAnalista")))
        EndIf
        oModelSZ1:SetValue("Z1_APROVAD", "N")
        oModelSZ1:SetValue("Z1_FATURAR", "N")

        // Opcionais - so seta se vier preenchido (evita sobrescrever default
        // do Model com vazio quando o front simplesmente nao manda o campo).
        If !Empty(AllTrim(OS_LERJSONTXT(jQuery,"osInterna")))
            oModelSZ1:SetValue("Z1_INTERNO", AllTrim(OS_LERJSONTXT(jQuery,"osInterna")))
        Else
            oModelSZ1:SetValue("Z1_INTERNO", "N")
        EndIf
        // Z1_LOCAL (1-Remoto, 2-Presencial, 3-Apia) - opcional
        If !Empty(AllTrim(OS_LERJSONTXT(jQuery,"local")))
            oModelSZ1:SetValue("Z1_LOCAL", AllTrim(OS_LERJSONTXT(jQuery,"local")))
        EndIf
        If OS_LERJSONNUM(jQuery,"horasTranDec") <> 0
            oModelSZ1:SetValue("Z1_TRANS", OS_LERJSONNUM(jQuery,"horasTranDec"))
        EndIf
        If !Empty(AllTrim(OS_LERJSONTXT(jQuery,"prevPmt")))
            oModelSZ1:SetValue("Z1_PREVIST", AllTrim(OS_LERJSONTXT(jQuery,"prevPmt")))
        EndIf
        If !Empty(AllTrim(OS_LERJSONTXT(jQuery,"numProposta")))
            oModelSZ1:SetValue("Z1_NUMPRO", AllTrim(OS_LERJSONTXT(jQuery,"numProposta")))
        EndIf
        If !Empty(AllTrim(OS_LERJSONTXT(jQuery,"pedVenda")))
            oModelSZ1:SetValue("Z1_PV", AllTrim(OS_LERJSONTXT(jQuery,"pedVenda")))
        EndIf
        If OS_LERJSONNUM(jQuery,"hrAlmoco") <> 0
            oModelSZ1:SetValue("Z1_ALMOCO", OS_LERJSONNUM(jQuery,"hrAlmoco"))
        EndIf
        If !Empty(AllTrim(OS_LERJSONTXT(jQuery,"projeto")))
            oModelSZ1:SetValue("Z1_PROJET", AllTrim(OS_LERJSONTXT(jQuery,"projeto")))
        EndIf
        If !Empty(AllTrim(OS_LERJSONTXT(jQuery,"revisao")))
            oModelSZ1:SetValue("Z1_REVISA", AllTrim(OS_LERJSONTXT(jQuery,"revisao")))
        EndIf
        If !Empty(AllTrim(OS_LERJSONTXT(jQuery,"tarefa")))
            oModelSZ1:SetValue("Z1_TAREFA", AllTrim(OS_LERJSONTXT(jQuery,"tarefa")))
        EndIf
        If !Empty(AllTrim(OS_LERJSONTXT(jQuery,"chamadoHpsd")))
            oModelSZ1:SetValue("Z1_CHPSD", AllTrim(OS_LERJSONTXT(jQuery,"chamadoHpsd")))
        EndIf
        // Z1_IDCH = chamado principal (primeiro da lista); a lista toda vai pra ZA3.
        If Len(aParCh[2]) > 0
            oModelSZ1:LoadValue("Z1_IDCH", aParCh[2][1])
        EndIf
        If !Empty(AllTrim(OS_LERJSONTXT(jQuery,"osDesenv")))
            oModelSZ1:SetValue("Z1_OSDESE", AllTrim(OS_LERJSONTXT(jQuery,"osDesenv")))
        Else
            oModelSZ1:SetValue("Z1_OSDESE", "N")
        EndIf
        If !Empty(AllTrim(OS_LERJSONTXT(jQuery,"osEnviada")))
            oModelSZ1:SetValue("Z1_OSENVCL", AllTrim(OS_LERJSONTXT(jQuery,"osEnviada")))
        Else
            oModelSZ1:SetValue("Z1_OSENVCL", "N")
        EndIf
        If !Empty(AllTrim(OS_LERJSONTXT(jQuery,"linhaPv")))
            oModelSZ1:SetValue("Z1_LIN", AllTrim(OS_LERJSONTXT(jQuery,"linhaPv")))
        EndIf
        If OS_LERJSONNUM(jQuery,"valorHora") <> 0
            oModelSZ1:SetValue("Z1_VLRHR", OS_LERJSONNUM(jQuery,"valorHora"))
        EndIf

        If oModel:VldData()
            lOk := oModel:CommitData()
        Else
            lOk := .F.
        EndIf

        If !lOk
            cErroModel := oModel:GetErrorMessage()
            Do Case
                Case ValType(cErroModel) == "C"
                    cErro := cErroModel
                Case ValType(cErroModel) == "O"
                    cErro := cErroModel:GetMessage()
                Case ValType(cErroModel) == "A"
                    cErro := FwJsonSerialize(cErroModel)
                Otherwise
                    cErro := "Falha ao validar/gravar a OS."
            EndCase
        EndIf

        oModel:DeActivate(lOk)

        If lOk
            OS_ZA3("GRAVAR", cOs, aParCh[2])
            ConfirmSX8()
        Else
            ConfirmSX8(.F.)
        EndIf

    Recover Using oErroExcpt
        lOk   := .F.
        cErro := "Erro interno: " + oErroExcpt:Description
        ConfirmSX8(.F.)
        If oModel <> Nil
            oModel:DeActivate()
        EndIf
    End Sequence

Return {lOk, cErro, cOs}

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_APIINCLUIR
Endpoint REST (POST /CNSAOSINCLUIR) de inclusao de OS - endpoint REAL
usado pelo front (query string, corpo POST sempre null - confirmado
lendo os-serv.ts). Chama o nucleo OS_NUCLEOINCLUIR e devolve o
resultado em JSON.
@return lOk   .T./.F. via oRest:setStatusResponse (200 com a OS gerada, ou 400 com o erro)
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
@Post(endpoint="/CNSAOSINCLUIR")
User Function OS_APIINCLUIR() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    aResultado := OS_NUCLEOINCLUIR(jQuery)

    If !aResultado[1]
        Return oRest:setStatusResponse(400, '{"erro":"' + OS_ESCAPARJSON(aResultado[2]) + '"}')
    EndIf

Return oRest:setStatusResponse(200, OS_RESPOSTAOK(aResultado[3], "OS incluida com sucesso."))

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_NUCLEOALTERAR
Nucleo de alteracao de OS - alteracao PARCIAL (so grava o campo que
veio na query string, os demais permanecem como estavam). Usado por
OS_APIALTERAR. Localiza a OS pela chave (Z1_OS), grava via Model leve
(OS_MODELLEVE) dentro de Begin Sequence/Recover.
@param  jQuery   Objeto Json com os parametros da query string (inclui "os")
@return aRet     Array {lOk, cErro, cOs}
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_NUCLEOALTERAR(jQuery)
    Local oModel     := Nil
    Local oModelSZ1  := Nil
    Local lOk        := .F.
    Local cErro      := ""
    Local cErroModel := Nil
    Local oErroExcpt := Nil
    Local cOs        := AllTrim(OS_LERJSONTXT(jQuery,"os"))
    Local cVal       := ""
    Local aHrIni     := OS_LERHORA(jQuery, "horaInicial", "horaInicialDec")
    Local aHrFim     := OS_LERHORA(jQuery, "horaFinal", "horaFinalDec")
    Local aParCh     := OS_ZA3("PARAM", jQuery)
    Local cMsgCh     := ""

    If Empty(cOs)
        Return {.F., "Informe o numero da OS (?os=000001).", ""}
    EndIf

    DbSelectArea("SZ1")
    SZ1->(DbSetOrder(1))
    If !SZ1->(DbSeek(cFilAnt + cOs))
        Return {.F., "OS nao encontrada.", cOs}
    EndIf

    // Chamados (so se o portal mandou a lista): mesmo cliente/loja e sem tirar
    // chamado que ja tem interacao desta OS.
    If aParCh[1]
        cMsgCh := OS_ZA3("VALIDAR", cOs, aParCh[2], ;
            If(Empty(AllTrim(OS_LERJSONTXT(jQuery, "codCliente"))), SZ1->Z1_CLI, AllTrim(OS_LERJSONTXT(jQuery, "codCliente"))), ;
            If(Empty(AllTrim(OS_LERJSONTXT(jQuery, "lojaCliente"))), SZ1->Z1_LOJA, AllTrim(OS_LERJSONTXT(jQuery, "lojaCliente"))))
        If !Empty(cMsgCh)
            Return {.F., cMsgCh, cOs}
        EndIf
        SZ1->(DbSeek(cFilAnt + cOs))
    EndIf

    Begin Sequence

        oModel    := OS_MODELLEVE()
        oModel:SetOperation(MODEL_OPERATION_UPDATE)
        oModel:Activate()
        oModelSZ1 := oModel:GetModel("SZ1MASTER")

        cVal := AllTrim(OS_LERJSONTXT(jQuery,"codCliente"))
        If !Empty(cVal)
            oModelSZ1:SetValue("Z1_CLI", cVal)
            cVal := AllTrim(OS_LERJSONTXT(jQuery,"lojaCliente"))
            oModelSZ1:SetValue("Z1_LOJA", If(Empty(cVal), "01", cVal))
        EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"usuario"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_USR", cVal) ; EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"modulo"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_MODULO", cVal) ; EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"motivo"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_MOTIV", cVal) ; EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"descricao"))
        // Troca so a descricao - mantem os blocos de interacao ja gravados no
        // Memo (OS sem chamado, ver OS_SEPARAINTERACOES). O front recebe e
        // devolve so a descricao (OS_APILISTAR).
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_SERV", cVal + OS_BLOCOSINTERACAO(oModelSZ1:GetValue("Z1_SERV"))) ; EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"codServico"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_TIPO", cVal) ; EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"dataOs"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_DTOS", STOD(StrTran(cVal,"-",""))) ; EndIf
        // Hora "pura" (HH:MM) vale; decimais calculados a partir dela (OS_LERHORA).
        If !Empty(aHrIni[2])
            oModelSZ1:SetValue("Z1_INI", aHrIni[1])
            oModelSZ1:LoadValue("Z1_HRINI", OS_HORACAMPO(aHrIni[2], "Z1_HRINI"))
        EndIf
        If !Empty(aHrFim[2])
            oModelSZ1:SetValue("Z1_FIM", aHrFim[1])
            oModelSZ1:LoadValue("Z1_HRFIM", OS_HORACAMPO(aHrFim[2], "Z1_HRFIM"))
        EndIf
        If OS_LERJSONNUM(jQuery,"horasTiDec") == 0 .And. !Empty(aHrIni[2]) .And. !Empty(aHrFim[2])
            oModelSZ1:SetValue("Z1_TOTAL", Round(aHrFim[1] - aHrIni[1], 2))
        EndIf
        If OS_LERJSONNUM(jQuery,"horasTranDec") <> 0
            oModelSZ1:SetValue("Z1_TRANS", OS_LERJSONNUM(jQuery,"horasTranDec"))
        EndIf
        If OS_LERJSONNUM(jQuery,"horasTiDec") <> 0
            oModelSZ1:SetValue("Z1_TOTAL", OS_LERJSONNUM(jQuery,"horasTiDec"))
        EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"codAnalista"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_TEC", cVal) ; EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"osInterna"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_INTERNO", cVal) ; EndIf
        // Z1_LOCAL (1-Remoto, 2-Presencial, 3-Apia)
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"local"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_LOCAL", cVal) ; EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"prevPmt"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_PREVIST", cVal) ; EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"numProposta"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_NUMPRO", cVal) ; EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"pedVenda"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_PV", cVal) ; EndIf
        If OS_LERJSONNUM(jQuery,"hrAlmoco") <> 0
            oModelSZ1:SetValue("Z1_ALMOCO", OS_LERJSONNUM(jQuery,"hrAlmoco"))
        EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"projeto"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_PROJET", cVal) ; EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"revisao"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_REVISA", cVal) ; EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"tarefa"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_TAREFA", cVal) ; EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"chamadoHpsd"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_CHPSD", cVal) ; EndIf
        // Z1_IDCH = chamado principal (primeiro da lista); a lista toda vai pra ZA3.
        If aParCh[1]
            oModelSZ1:LoadValue("Z1_IDCH", If(Len(aParCh[2]) > 0, aParCh[2][1], ""))
        EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"osDesenv"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_OSDESE", cVal) ; EndIf
        // Z1_OSENVCL (OS Enviada, S/N) e obrigatorio - OS antigas estao vazias.
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"osEnviada"))
        If !Empty(cVal)
            oModelSZ1:SetValue("Z1_OSENVCL", cVal)
        ElseIf Empty(oModelSZ1:GetValue("Z1_OSENVCL"))
            oModelSZ1:SetValue("Z1_OSENVCL", "N")
        EndIf
        cVal := AllTrim(OS_LERJSONTXT(jQuery,"linhaPv"))
        If !Empty(cVal) ; oModelSZ1:SetValue("Z1_LIN", cVal) ; EndIf
        If OS_LERJSONNUM(jQuery,"valorHora") <> 0
            oModelSZ1:SetValue("Z1_VLRHR", OS_LERJSONNUM(jQuery,"valorHora"))
        EndIf

        If oModel:VldData()
            lOk := oModel:CommitData()
        Else
            lOk := .F.
        EndIf

        If !lOk
            cErroModel := oModel:GetErrorMessage()
            Do Case
                Case ValType(cErroModel) == "C"
                    cErro := cErroModel
                Case ValType(cErroModel) == "O"
                    cErro := cErroModel:GetMessage()
                Case ValType(cErroModel) == "A"
                    cErro := FwJsonSerialize(cErroModel)
                Otherwise
                    cErro := "Falha ao validar/gravar a alteracao."
            EndCase
        EndIf

        oModel:DeActivate(lOk)

        // OS acabou de ganhar chamado: interacoes que estavam no Memo
        // (Z1_SERV) passam pra ZA2 do chamado.
        If lOk
            If aParCh[1]
                OS_ZA3("GRAVAR", cOs, aParCh[2])
            EndIf
            OS_MIGRARINTERACOES(cOs)
        EndIf

    Recover Using oErroExcpt
        lOk   := .F.
        cErro := "Erro interno: " + oErroExcpt:Description
        If oModel <> Nil
            oModel:DeActivate()
        EndIf
    End Sequence

Return {lOk, cErro, cOs}

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_APIALTERAR
Endpoint REST (POST /CNSAOSALTERAR) de alteracao parcial de OS -
endpoint REAL usado pelo front (query string). Chama o nucleo
OS_NUCLEOALTERAR e devolve o resultado em JSON (404 se a OS nao for
encontrada, 400 para os demais erros).
@return lOk   .T./.F. via oRest:setStatusResponse (200 com a OS alterada, ou 400/404 com o erro)
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
@Post(endpoint="/CNSAOSALTERAR")
User Function OS_APIALTERAR() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    aResultado := OS_NUCLEOALTERAR(jQuery)

    If !aResultado[1]
        If aResultado[2] == "OS nao encontrada."
            Return oRest:setStatusResponse(404, '{"erro":"' + OS_ESCAPARJSON(aResultado[2]) + '"}')
        EndIf
        Return oRest:setStatusResponse(400, '{"erro":"' + OS_ESCAPARJSON(aResultado[2]) + '"}')
    EndIf

Return oRest:setStatusResponse(200, OS_RESPOSTAOK(aResultado[3], "OS alterada com sucesso."))

Return lOk

// Helpers do SaveData - setam campo so se veio no JSON (Alterar parcial) ou
// sempre (Incluir, jBody[cCampo]==Nil vira valor vazio, igual campo omitido).
//-------------------------------------------------------------------
/*/{Protheus.doc} OS_SETSEFICOU
Seta um campo texto generico do Model (SZ1MASTER) a partir do JSON, so
se o campo veio no corpo (jBody[cCampo] != Nil).
@param  oModelSZ1   Sub-model da SZ1MASTER (FormModel)
@param  jBody       Objeto Json com o corpo da requisicao
@param  cCampo      Nome do campo (SX3) a setar
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_SETSEFICOU(oModelSZ1, jBody, cCampo)
    Local xVal := jBody[cCampo]
    If xVal != Nil
        oModelSZ1:SetValue(cCampo, AllTrim(cValToChar(xVal)))
    EndIf
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_SETTEXTOUTF8
Seta um campo texto do Model (SZ1MASTER) a partir do JSON, so se o
campo veio no corpo (jBody[cCampo] != Nil).
@param  oModelSZ1   Sub-model da SZ1MASTER (FormModel)
@param  jBody       Objeto Json com o corpo da requisicao
@param  cCampo      Nome do campo (SX3) a setar
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_SETTEXTOUTF8(oModelSZ1, jBody, cCampo)
    Local xVal := jBody[cCampo]
    If xVal != Nil
        oModelSZ1:SetValue(cCampo, AllTrim(cValToChar(xVal)))
    EndIf
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_LERHORA
Le a hora "pura" do parametro de texto (ex: horaInicial = "08:30" ou
"0830") e devolve tambem o decimal equivalente (8.5) pros campos
Z1_INI/Z1_FIM. Se o texto nao vier, aceita o decimal antigo (ex:
horaInicialDec) e monta o texto a partir dele.
@param  jQuery   Parametros da requisicao
@param  cTexto   Nome do parametro com a hora "HH:MM"
@param  cDec     Nome do parametro com a hora decimal (compatibilidade)
@return aRet     {nDecimal, cHoraHHMM} - {0, ""} se nada veio
@author Henrique
@since 25/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_LERHORA(jQuery, cTexto, cDec)
    Local cDig  := StrTran(StrTran(AllTrim(OS_LERJSONTXT(jQuery, cTexto)), ":", ""), ".", "")
    Local nDec  := 0
    Local nHora := 0
    Local nMin  := 0

    If !Empty(cDig)
        cDig  := PadL(Right(cDig, 4), 4, "0")
        nHora := Val(Left(cDig, 2))
        nMin  := Val(Right(cDig, 2))
        Return {Round(nHora + nMin / 60, 2), StrZero(nHora, 2) + ":" + StrZero(nMin, 2)}
    EndIf

    nDec := OS_LERJSONNUM(jQuery, cDec)
    If nDec == 0
        Return {0, ""}
    EndIf

    nHora := Int(nDec)
    nMin  := Round((nDec - nHora) * 60, 0)
    If nMin >= 60
        nHora++
        nMin -= 60
    EndIf

Return {nDec, StrZero(nHora, 2) + ":" + StrZero(nMin, 2)}

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_HORACAMPO
Ajusta a hora "HH:MM" ao tamanho do campo no dicionario (Z1_HRINI/
Z1_HRFIM): "08:30" se couber 5 caracteres, "0830" se o campo for menor.
Tamanho diferente dava FWNOWIDTH ("Valor atribuido difere do tamanho
do campo").
@param  cHora   Hora no formato "HH:MM"
@param  cCampo  Campo de destino
@return cRet    Hora no tamanho exato do campo
@author Henrique
@since 25/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_HORACAMPO(cHora, cCampo)
    Local nTam := TamSX3(cCampo)[1]
    Local cRet := cHora

    If nTam < 5
        cRet := StrTran(cRet, ":", "")
    EndIf

Return PadR(Left(cRet, nTam), nTam)

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_SETNUM
Seta um campo numerico do Model (SZ1MASTER) a partir do JSON, so se o
campo veio no corpo (jBody[cCampo] != Nil).
@param  oModelSZ1   Sub-model da SZ1MASTER (FormModel)
@param  jBody       Objeto Json com o corpo da requisicao
@param  cCampo      Nome do campo (SX3) a setar
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_SETNUM(oModelSZ1, jBody, cCampo)
    Local xVal := jBody[cCampo]
    If xVal != Nil
        oModelSZ1:SetValue(cCampo, Val(cValToChar(xVal)))
    EndIf
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_SETDATAOS
Seta um campo data do Model (SZ1MASTER) a partir do JSON (formato
"AAAA-MM-DD"), so se o campo veio no corpo e nao estiver vazio.
@param  oModelSZ1   Sub-model da SZ1MASTER (FormModel)
@param  jBody       Objeto Json com o corpo da requisicao
@param  cCampo      Nome do campo (SX3) a setar
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_SETDATAOS(oModelSZ1, jBody, cCampo)
    Local xVal := jBody[cCampo]
    If xVal != Nil .And. !Empty(cValToChar(xVal))
        oModelSZ1:SetValue(cCampo, STOD(StrTran(cValToChar(xVal), "-", "")))
    EndIf
Return

////////////////////////////////////////////////////////////////////////////////////////////////
//                                                                                              //
//                       HELPERS DE LEITURA (nomes derivados via Posicione)                    //
//                                                                                              //
////////////////////////////////////////////////////////////////////////////////////////////////

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_DESC
Le a descricao (Z1_SERV, campo Memo) da OS via Posicione - acesso
nativo na tabela, ja que o cursor virtual do BeginSql nao expoe coluna
Memo pelo nome.
@param  cOs    Numero (Z1_OS) da OS
@return cDesc  Texto da descricao (ou "" se cOs vazio)
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_DESC(cOs)
    If Empty(cOs)
        Return ""
    EndIf
Return AllTrim(Posicione("SZ1", 1, cFilAnt + cOs, "Z1_SERV"))

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_NOMECLI
Le o nome reduzido do cliente (SA1->A1_NREDUZ) via Posicione, a partir do
codigo e loja - mesmo nome usado no chamado (ZA1_NOME) e na agenda (Z6_NOMCLI).
@param  cCodCliente   Codigo do cliente (A1_COD)
@param  cLoja         Loja do cliente (A1_LOJA)
@return cNome         Nome reduzido do cliente (ou "" se cCodCliente vazio)
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_NOMECLI(cCodCliente, cLoja)
    Local cChave := ""
    Local cNome  := ""

    If Empty(cCodCliente)
        Return ""
    EndIf

    // Chave no tamanho exato dos campos - codigo/loja chegam com AllTrim e,
    // mais curtos que A1_COD/A1_LOJA, desalinhavam a chave (nome vinha vazio).
    cChave := xFilial("SA1") + PadR(cCodCliente, TamSX3("A1_COD")[1]) + PadR(cLoja, TamSX3("A1_LOJA")[1])
    cNome  := AllTrim(Posicione("SA1", 1, cChave, "A1_NREDUZ"))
    // Cadastro sem nome reduzido: usa o nome completo.
    If Empty(cNome)
        cNome := AllTrim(Posicione("SA1", 1, cChave, "A1_NOME"))
    EndIf

Return cNome

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_NOMEGEN
Le a descricao de uma tabela generica (SX5) via Posicione - usado para
Modulo (tipo "Z2") e Motivo (tipo "Z1").
@param  cTabela   Tipo da tabela generica SX5 (ex: "Z1", "Z2")
@param  cChave    Chave (codigo) dentro da tabela generica
@return cDesc     Descricao (X5_DESCRI) ou "" se cChave vazio
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_NOMEGEN(cTabela, cChave)
    If Empty(cChave)
        Return ""
    EndIf
Return AllTrim(Posicione("SX5", 1, xFilial("SX5") + cTabela + cChave, "X5_DESCRI"))

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_NOMEPROJ
Le a descricao do projeto (AF8) via Posicione.
@param  cProjeto   Codigo do projeto (AF8_PROJET)
@return cDesc      Descricao (AF8_DESCRI) ou "" se cProjeto vazio
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_NOMEPROJ(cProjeto)
    If Empty(cProjeto)
        Return ""
    EndIf
Return AllTrim(Posicione("AF8", 1, xFilial("AF8") + cProjeto, "AF8_DESCRI"))

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_NOMETAREFA
Le a descricao da tarefa do projeto (AF9) via Posicione.
@param  cProjeto   Codigo do projeto
@param  cTarefa    Codigo da tarefa dentro do projeto
@return cDesc      Descricao (AF9_DESCRI) ou "" se cTarefa vazio
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_NOMETAREFA(cProjeto, cTarefa)
    If Empty(cTarefa)
        Return ""
    EndIf
Return AllTrim(Posicione("AF9", 1, xFilial("AF9") + cProjeto + cTarefa, "AF9_DESCRI"))

// Nome do servico (SB1) e do analista (AA1) - Z1_NMTEC/Z1_NMTIPO existem no
// dicionario (SX3) mas NAO sao coluna fisica na SZ1 (gatilho so-tela, nunca
// gravado) - nunca ler direto da tabela, sempre calcular ao vivo aqui.
//-------------------------------------------------------------------
/*/{Protheus.doc} OS_NOMESERV
Le a descricao do servico (SB1) via Posicione.
@param  cCodServico   Codigo do servico (B1_COD)
@return cDesc         Descricao (B1_DESC) ou "" se cCodServico vazio
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_NOMESERV(cCodServico)
    If Empty(cCodServico)
        Return ""
    EndIf
Return AllTrim(Posicione("SB1", 1, xFilial("SB1") + cCodServico, "B1_DESC"))

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_NOMETEC
Le o nome do analista/tecnico (AA1) via Posicione.
@param  cCodAnalista   Codigo do analista (AA1_COD)
@return cNome          Nome do tecnico (AA1_NOMTEC) ou "" se cCodAnalista vazio
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_NOMETEC(cCodAnalista)
    If Empty(cCodAnalista)
        Return ""
    EndIf
    // Chave no tamanho exato do AA1_CODTEC (mesmo motivo do OS_NOMECLI).
Return AllTrim(Posicione("AA1", 1, xFilial("AA1") + PadR(cCodAnalista, TamSX3("AA1_CODTEC")[1]), "AA1_NOMTEC"))

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_STATUSCALC
Calcula o status derivado da OS, com a mesma regra das 5 legendas
(AddLegend) da tela classica (aprovada/faturada/negada/aguardando).
@param  cAprovad   Valor de Z1_APROVAD ("S"/"A"/outro)
@param  cFaturar   Valor de Z1_FATURAR ("S"/outro)
@param  cTec       Codigo do tecnico (Z1_TEC) responsavel
@return cStatus    "aprovada_faturada", "faturada_sem_aprovacao", "aprovada", "aguardando_aprovacao" ou "negada"
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_STATUSCALC(cAprovad, cFaturar, cTec)
    Local lAprovada := cAprovad == "S" .Or. cAprovad == "A"

    If lAprovada .And. cFaturar == "S"
        Return "aprovada_faturada"
    ElseIf cFaturar == "S" .And. !lAprovada
        Return "faturada_sem_aprovacao"
    ElseIf lAprovada
        Return "aprovada"
    ElseIf !Empty(cTec)
        Return "aguardando_aprovacao"
    EndIf
Return "negada"

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_DATAISO
Converte uma data para o formato ISO "AAAA-MM-DD" - trata tanto Date
quanto Character, ja que o cursor do BeginSql pode devolver os dois
dependendo do banco/driver.
@param  dData    Data (tipo Date ou Character/AAAAMMDD)
@return cData    Data no formato "AAAA-MM-DD", ou "" se invalida/vazia
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_DATAISO(dData)
    Local cData := ""

    If ValType(dData) == "D"
        If Empty(dData)
            Return ""
        EndIf
        cData := DToS(dData)
    ElseIf ValType(dData) == "C"
        cData := AllTrim(dData)
    Else
        Return ""
    EndIf

    If Len(cData) == 8
        Return SubStr(cData, 1, 4) + "-" + SubStr(cData, 5, 2) + "-" + SubStr(cData, 7, 2)
    EndIf
Return ""

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_ESCAPARJSON
Escapa um texto para uso seguro dentro de uma string JSON (barra
invertida, aspas, quebras de linha e tab).
@param  cTexto   Texto a escapar
@return cRet     Texto escapado, pronto para JSON
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_ESCAPARJSON(cTexto)
    Local cRet := cTexto
    cRet := StrTran(cRet, '\',  '\\')
    cRet := StrTran(cRet, '"',  '\"')
    cRet := StrTran(cRet, Chr(13)+Chr(10), '\n')
    cRet := StrTran(cRet, Chr(10), '\n')
    cRet := StrTran(cRet, Chr(13), '\n')
    cRet := StrTran(cRet, Chr(9),  '\t')
Return cRet

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_LERJSONNUM
Le um campo numerico de um objeto Json (helper compartilhado pelos
endpoints @Get/@Post). FIX ja existente no original (nao usa
GetJsonText): indexacao direta jDados[cCampo] devolve Nil de verdade
pra campo ausente, enquanto GetJsonText devolvia a string literal
"null".
@param  jDados   Objeto Json (query string ou corpo)
@param  cCampo   Nome do campo a ler
@return nVal     Valor numerico do campo, ou 0 se ausente
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_LERJSONNUM(jDados, cCampo)
    Local xVal := jDados[cCampo]
    If xVal == Nil
        Return 0
    EndIf
Return Val(cValToChar(xVal))

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_DECODESAFE
FIX (caracteres acentuados bugados na descricao/texto/etc): o campo
chega via querystring (nao corpo JSON - OsServ.ts manda tudo na URL,
POST com body null). Faz reconstrucao manual byte a byte (mesmo
algoritmo do CH_DECODESAFE em CNS001.TLPP) em vez de confiar no
DecodeUTF8 nativo - remonta o par de bytes UTF-8 (0xC2/0xC3 +
continuacao) que apareceu como 2 chars CP1252 separados. Nunca lanca
erro (so usa Asc/Chr/SubStr).
@param  cTexto   Texto possivelmente com bytes UTF-8 quebrados em CP1252
@return cRet     Texto reconstruido/decodificado
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_DECODESAFE(cTexto)
    Local cRet  := ""
    Local nLen  := Len(cTexto)
    Local nI    := 1
    Local nB1, nB2

    While nI <= nLen
        nB1 := Asc(SubStr(cTexto, nI, 1))
        If (nB1 == 195 .Or. nB1 == 194) .And. nI < nLen
            nB2 := Asc(SubStr(cTexto, nI + 1, 1))
            If nB2 >= 128 .And. nB2 <= 191
                cRet += Chr(((nB1 - 192) * 64) + (nB2 - 128))
                nI   += 2
                Loop
            EndIf
        EndIf
        cRet += SubStr(cTexto, nI, 1)
        nI++
    EndDo

Return cRet

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_PROXIMONUM
Proximo numero de OS: ano atual com 2 digitos + sequencia de 6 digitos que
recomeca todo ano (2026 = 26000001, 26000002...; 2027 = 27000001...).
Substitui o GetSxeNum (sequencia simples, sem ano). A sequencia e a maior
OS do ano + 1 - conta tambem as excluidas, pra nunca reaproveitar numero.
MayIUseCode reserva o numero entre usuarios simultaneos ate a gravacao.
@return cOs   Numero da OS (8 posicoes)
@author Henrique
@since 05/10/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_PROXIMONUM()
    Local cAno   := Right(cValToChar(Year(Date())), 2)
    Local cAlias := GetNextAlias()
    Local nSeq   := 0
    Local cOs    := ""

    // "%" nao vai dentro do %Exp% (colide com a macro do BeginSql) - o
    // curinga e montado no SQL.
    BeginSql Alias cAlias
        SELECT MAX(Z1_OS) MAXOS
        FROM %Table:SZ1% SZ1
        WHERE Z1_FILIAL = %xFilial:SZ1%
          AND Z1_OS LIKE %Exp:cAno% || '%'
    EndSql
    If !(cAlias)->(Eof()) .And. !Empty(AllTrim((cAlias)->MAXOS))
        nSeq := Val(SubStr(AllTrim((cAlias)->MAXOS), 3))
    EndIf
    (cAlias)->(DbCloseArea())

    DbSelectArea("SZ1")
    SZ1->(DbSetOrder(1))
    Do While .T.
        nSeq++
        cOs := cAno + StrZero(nSeq, 6)
        If !SZ1->(DbSeek(xFilial("SZ1") + cOs)) .And. MayIUseCode("CNSA002_OS" + xFilial("SZ1") + cOs)
            Exit
        EndIf
    EndDo

Return cOs

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_LERJSONTXT
Le um campo texto de um objeto Json (helper compartilhado pelos
endpoints @Get/@Post), aplicando OS_DECODESAFE para corrigir
acentuacao vinda da query string.
@param  jDados   Objeto Json (query string ou corpo)
@param  cCampo   Nome do campo a ler
@return cVal     Valor texto decodificado, ou "" se ausente/nao-texto
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_LERJSONTXT(jDados, cCampo)
    Local xVal := jDados[cCampo]
    If xVal == Nil .Or. ValType(xVal) != "C"
        Return ""
    EndIf
Return OS_DECODESAFE(xVal)

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_RESPOSTAOK
Monta a resposta JSON padrao de sucesso ({sucesso, os, mensagem}) dos
endpoints REST de OS.
@param  cOs     Numero da OS
@param  cMsg    Mensagem de sucesso
@return cJson   JSON serializado da resposta
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_RESPOSTAOK(cOs, cMsg)
    Local oJson := JsonObject():New()
    oJson["sucesso"]  := .T.
    oJson["os"]       := cOs
    oJson["mensagem"] := cMsg
Return oJson:ToJson()

// LISTAGEM / VISUALIZAR / PESQUISAR - fica custom (SQL direto por performance,
// nao cabe no generico).
//
// FIX (travava "sending" pra sempre, mesmo compilado): a versao anterior desta
// funcao trocou SQL por navegacao nativa (DbSeek/DbSkip), copiando cegamente o
// padrao do CH_APICHAMADOS - mas SZ1 (OS) e historicamente MUITO maior que ZA1
// (chamados), e ler a tabela INTEIRA pra memoria a cada request nao escala (ao
// contrario de ZA1, que e pequena). O comentario original deste endpoint ja
// avisava "SQL direto por performance" - volta a usar SQL com paginacao real
// (ROWNUM), SEM filtro de negocio nenhum no WHERE (so filial+NotDel) -
// paginacao tecnica nao e filtro. Z1_SERV (descricao) e Memo - cursor de
// BeginSql nao expoe Memo por nome, por isso continua vindo via
// OS_DESC()/Posicione, so que agora so pras poucas linhas da pagina pedida
// (nao mais pra tabela inteira).
//-------------------------------------------------------------------
/*/{Protheus.doc} OS_APILISTAR
Endpoint REST (GET /CNSAOS) de listagem/pesquisa de OS, paginado via
SQL (ROWNUM). Contrato consumido pelo os-serv.ts. Filtros opcionais na
query (vazio = nao filtra): texto (busca livre), tecnico (Z1_TEC),
cliente (Z1_CLI, todas as lojas), dataDe/dataAte (Z1_DTOS, AAAA-MM-DD).
Status continua filtrado no front.
@return lOk   JSON via oRest:setStatusResponse (200 com {total,totalPaginas,pagina,tamanho,items}, ou 500 em erro)
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
@Get(endpoint="/CNSAOS")
User Function OS_APILISTAR() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local oJson      := JsonObject():New()
    Local aRetorno   := {}
    Local oLinha     := Nil
    Local nPagina    := 1
    Local nTamanho   := 10
    Local nStartIdx  := 1
    Local nTotal     := 0
    Local nMinRow    := 0
    Local nMaxRow    := 0
    Local oErro      := Nil
    Local cAlias     := GetNextAlias()
    Local cOsAtual   := ""
    Local cCliAtual  := ""
    Local cLojaAtual := ""
    Local cProjAtual := ""
    Local cTecAtual  := ""
    Local cTextoUp   := ""
    Local cFTec      := ""
    Local cFCli      := ""
    Local cFDataDe   := ""
    Local cFDataAte  := ""
    Local cSemTec    := ""
    Local cSemCli    := ""
    Local cSemDe     := ""
    Local cSemAte    := ""

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    Begin Sequence

        nPagina   := OS_LERJSONNUM(jQuery, "pagina")
        nPagina   := If(nPagina < 1, 1, nPagina)
        nTamanho  := OS_LERJSONNUM(jQuery, "tamanho")
        nTamanho  := If(nTamanho < 1 .Or. nTamanho > 100, 10, nTamanho)
        nStartIdx := (nPagina - 1) * nTamanho + 1
        nMinRow   := nStartIdx - 1
        nMaxRow   := nStartIdx + nTamanho - 1

        // Unica excecao a regra "sem filtro de negocio no backend": busca livre
        // (caixa de pesquisa) por numero da OS, nome do cliente ou nome do
        // tecnico. Diferente de status/data/etc (filtro real, front-end), aqui
        // e so o mecanismo tecnico da caixa "Pesquisar" - inviavel fazer no
        // front porque a SZ1 tem 100k+ linhas (ver historico do bug de
        // "carregar tudo" que travava a tela). `cTextoUp = ''` no OR faz o
        // filtro virar no-op quando a caixa esta vazia.
        cTextoUp := Upper(AllTrim(OS_LERJSONTXT(jQuery, "texto")))

        // Filtros da Busca avancada (tecnico/cliente/periodo da Data OS) - no
        // backend porque a lista e paginada: filtrar so o carregado escondia
        // OS das paginas seguintes. Mesmo esquema "'' = no-op" do texto.
        cFTec     := AllTrim(OS_LERJSONTXT(jQuery, "tecnico"))
        cFCli     := AllTrim(OS_LERJSONTXT(jQuery, "cliente"))
        cFDataDe  := StrTran(AllTrim(OS_LERJSONTXT(jQuery, "dataDe")), "-", "")
        cFDataAte := StrTran(AllTrim(OS_LERJSONTXT(jQuery, "dataAte")), "-", "")
        // Oracle trata '' como NULL: "'' = ''" NAO e verdadeiro e o filtro vazio
        // excluia TODAS as OS. Flag S/N ("S" = sem filtro) no lugar do teste
        // de string vazia.
        cSemTec := If(Empty(cFTec),     "S", "N")
        cSemCli := If(Empty(cFCli),     "S", "N")
        cSemDe  := If(Empty(cFDataDe),  "S", "N")
        cSemAte := If(Empty(cFDataAte), "S", "N")

        BeginSql Alias cAlias
            SELECT * FROM (
                SELECT SZ1Q.*, ROWNUM AS SZ1_RNUM
                FROM (
                    SELECT Z1_OS, Z1_DTDIGIT, Z1_CLI, Z1_LOJA, Z1_USR, Z1_MODULO, Z1_MOTIV, Z1_TIPO, ;
                        Z1_DTOS, Z1_INTERNO, Z1_LOCAL, Z1_HRINI, Z1_INI, Z1_HRFIM, Z1_FIM, Z1_TRANS, Z1_PREVIST, ;
                        Z1_HRTOT, Z1_TOTAL, Z1_TEC, Z1_NUMPRO, Z1_PV, Z1_ALMOCO, Z1_PROJET, Z1_REVISA, ;
                        Z1_TAREFA, Z1_CHPSD, Z1_CHHDK, Z1_IDCH, Z1_OSDESE, Z1_OSENVCL, Z1_LIN, Z1_VLRHR, Z1_APROVAD, Z1_FATURAR, ;
                        COUNT(*) OVER() AS SZ1_TOTAL
                    FROM %Table:SZ1% SZ1
                    WHERE Z1_FILIAL = %xFilial:SZ1%
                      AND %NotDel%
                      AND (%Exp:cSemTec% = 'S' OR Z1_TEC = %Exp:cFTec%)
                      AND (%Exp:cSemCli% = 'S' OR Z1_CLI = %Exp:cFCli%)
                      AND (%Exp:cSemDe% = 'S' OR Z1_DTOS >= %Exp:cFDataDe%)
                      AND (%Exp:cSemAte% = 'S' OR Z1_DTOS <= %Exp:cFDataAte%)
                      AND (
                            %Exp:cTextoUp% = ''
                            OR UPPER(Z1_OS) LIKE '%'||%Exp:cTextoUp%||'%'
                            OR EXISTS (
                                SELECT 1 FROM %Table:SA1% SA1
                                WHERE SA1.A1_FILIAL = Z1_FILIAL AND SA1.A1_COD = Z1_CLI AND SA1.A1_LOJA = Z1_LOJA
                                  AND SA1.D_E_L_E_T_ = ' ' AND (UPPER(SA1.A1_NOME) LIKE '%'||%Exp:cTextoUp%||'%' OR UPPER(SA1.A1_NREDUZ) LIKE '%'||%Exp:cTextoUp%||'%')
                            )
                            OR EXISTS (
                                SELECT 1 FROM %Table:AA1% AA1
                                WHERE AA1.AA1_FILIAL = Z1_FILIAL AND AA1.AA1_CODTEC = Z1_TEC
                                  AND AA1.D_E_L_E_T_ = ' ' AND UPPER(AA1.AA1_NOMTEC) LIKE '%'||%Exp:cTextoUp%||'%'
                            )
                          )
                    ORDER BY Z1_OS DESC
                ) SZ1Q
                WHERE ROWNUM <= %Exp:nMaxRow%
            )
            WHERE SZ1_RNUM > %Exp:nMinRow%
        EndSql

        If !(cAlias)->(Eof())
            nTotal := (cAlias)->SZ1_TOTAL
        EndIf

        While !(cAlias)->(Eof())
            cOsAtual   := AllTrim((cAlias)->Z1_OS)
            cCliAtual  := AllTrim((cAlias)->Z1_CLI)
            cLojaAtual := AllTrim((cAlias)->Z1_LOJA)
            cProjAtual := AllTrim((cAlias)->Z1_PROJET)
            cTecAtual  := AllTrim((cAlias)->Z1_TEC)

            oLinha := JsonObject():New()
            oLinha['os']             := cOsAtual
            oLinha['dtDigitacao']    := OS_DATAISO((cAlias)->Z1_DTDIGIT)
            oLinha['codCliente']     := cCliAtual
            oLinha['lojaCliente']    := cLojaAtual
            oLinha['nomeCliente']    := OS_NOMECLI(cCliAtual, cLojaAtual)
            oLinha['usuario']        := AllTrim((cAlias)->Z1_USR)
            oLinha['modulo']         := AllTrim((cAlias)->Z1_MODULO)
            oLinha['nomeModulo']     := OS_NOMEGEN("Z2", AllTrim((cAlias)->Z1_MODULO))
            oLinha['motivo']         := AllTrim((cAlias)->Z1_MOTIV)
            oLinha['nomeMotivo']     := OS_NOMEGEN("Z1", AllTrim((cAlias)->Z1_MOTIV))
            // So a descricao - os blocos de interacao do Memo vao pelo CNSAOSINTERACOES.
            oLinha['descricao']      := OS_SEPARAINTERACOES(OS_DESC(cOsAtual))[1]
            oLinha['codServico']     := AllTrim((cAlias)->Z1_TIPO)
            oLinha['nomeServico']    := OS_NOMESERV(AllTrim((cAlias)->Z1_TIPO))
            oLinha['dataOs']         := OS_DATAISO((cAlias)->Z1_DTOS)
            oLinha['osInterna']      := AllTrim((cAlias)->Z1_INTERNO)
            oLinha['local']          := AllTrim((cAlias)->Z1_LOCAL)
            oLinha['horaInicial']    := AllTrim((cAlias)->Z1_HRINI)
            oLinha['horaInicialDec'] := (cAlias)->Z1_INI
            oLinha['horaFinal']      := AllTrim((cAlias)->Z1_HRFIM)
            oLinha['horaFinalDec']   := (cAlias)->Z1_FIM
            oLinha['horasTranDec']   := (cAlias)->Z1_TRANS
            oLinha['prevPmt']        := AllTrim((cAlias)->Z1_PREVIST)
            oLinha['totalHoras']     := AllTrim((cAlias)->Z1_HRTOT)
            oLinha['horasTiDec']     := (cAlias)->Z1_TOTAL
            oLinha['codAnalista']    := cTecAtual
            oLinha['nomeAnalista']   := OS_NOMETEC(cTecAtual)
            oLinha['numProposta']    := AllTrim((cAlias)->Z1_NUMPRO)
            oLinha['pedVenda']       := AllTrim((cAlias)->Z1_PV)
            oLinha['hrAlmoco']       := (cAlias)->Z1_ALMOCO
            oLinha['projeto']        := cProjAtual
            oLinha['nomeProjeto']    := OS_NOMEPROJ(cProjAtual)
            oLinha['revisao']        := AllTrim((cAlias)->Z1_REVISA)
            oLinha['tarefa']         := AllTrim((cAlias)->Z1_TAREFA)
            oLinha['nomeTarefa']     := OS_NOMETAREFA(cProjAtual, AllTrim((cAlias)->Z1_TAREFA))
            oLinha['chamadoHpsd']    := AllTrim((cAlias)->Z1_CHPSD)
            // Z1_IDCH (caractere) - chamado novo (ZA1_IDCH); Z1_CHHDK segue
            // intocado (legado do HPSD, sem uso novo).
            oLinha['chamado']        := AllTrim((cAlias)->Z1_IDCH)
            // Todos os chamados da OS (ZA3 + principal) e a quantidade.
            oLinha['chamados']       := OS_ZA3("LER", cOsAtual, (cAlias)->Z1_IDCH)
            oLinha['qtdChamados']    := Len(oLinha['chamados'])
            oLinha['osDesenv']       := AllTrim((cAlias)->Z1_OSDESE)
            oLinha['osEnviada']      := AllTrim((cAlias)->Z1_OSENVCL)
            oLinha['linhaPv']        := AllTrim((cAlias)->Z1_LIN)
            oLinha['valorHora']      := (cAlias)->Z1_VLRHR
            oLinha['status']         := OS_STATUSCALC(AllTrim((cAlias)->Z1_APROVAD), AllTrim((cAlias)->Z1_FATURAR), cTecAtual)
            AAdd(aRetorno, oLinha)

            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())

        oJson['total']        := nTotal
        oJson['totalPaginas'] := If(nTotal == 0, 0, Ceiling(nTotal / nTamanho))
        oJson['pagina']       := nPagina
        oJson['tamanho']      := nTamanho
        oJson['items']        := aRetorno

        Return oRest:setStatusResponse(200, oJson:ToJson())

    Recover Using oErro
        If oErro != Nil
            Return oRest:setStatusResponse(500, '{"erro":"' + OS_ESCAPARJSON(oErro:Description) + '"}')
        EndIf
    End Sequence

Return oRest:setStatusResponse(500, '{"erro":"Erro desconhecido."}')

// EXCLUIR - fica custom (mesma decisao do CNS001: incerteza sobre hook exato
// de delete do FwRestModel).
//-------------------------------------------------------------------
/*/{Protheus.doc} OS_APIEXCLUIR
Endpoint REST (POST /CNSAOSEXCLUIR) de exclusao de OS. Localiza a OS
pela chave e exclui via Model leve (OS_MODELLEVE, MODEL_OPERATION_DELETE).
@return lOk   JSON via oRest:setStatusResponse (200 se excluiu, 404 se a OS nao existir, 400/500 em erro)
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
@Post(endpoint="/CNSAOSEXCLUIR")
User Function OS_APIEXCLUIR() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local cOs        := AllTrim(OS_LERJSONTXT(jQuery,"os")) As Character
    Local oErro      := Nil
    Local oModel     := Nil
    Local lOk        := .F.
    Local cErro      := ""
    Local cErroModel := Nil

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    Begin Sequence

        If Empty(cOs)
            Return oRest:setStatusResponse(400, '{"erro":"Informe o numero da OS."}')
        EndIf

        DbSelectArea("SZ1")
        SZ1->(DbSetOrder(1))
        If !SZ1->(DbSeek(cFilAnt + cOs))
            Return oRest:setStatusResponse(404, '{"erro":"OS nao encontrada."}')
        EndIf

        oModel := OS_MODELLEVE()
        oModel:SetOperation(MODEL_OPERATION_DELETE)
        oModel:Activate()

        If oModel:VldData()
            lOk := oModel:CommitData()
        EndIf

        If !lOk
            cErroModel := oModel:GetErrorMessage()
            Do Case
                Case ValType(cErroModel) == "C"
                    cErro := cErroModel
                Case ValType(cErroModel) == "O"
                    cErro := cErroModel:GetMessage()
                Case ValType(cErroModel) == "A"
                    cErro := FwJsonSerialize(cErroModel)
                Otherwise
                    cErro := "Falha ao excluir a OS."
            EndCase
        EndIf

        oModel:DeActivate(lOk)

        // Chamados ligados (ZA3) saem junto.
        If lOk
            OS_ZA3("GRAVAR", cOs, {})
        EndIf

        If !lOk
            Return oRest:setStatusResponse(400, '{"erro":"' + OS_ESCAPARJSON(cErro) + '"}')
        EndIf

        Return oRest:setStatusResponse(200, OS_RESPOSTAOK(cOs, "OS excluida com sucesso."))

    Recover Using oErro
        Return oRest:setStatusResponse(500, '{"erro":"' + OS_ESCAPARJSON(oErro:Description) + '"}')
    End Sequence

Return oRest:setStatusResponse(500, '{"erro":"Erro desconhecido."}')

// COPIAR - fica custom (nao e CRUD simples).
//-------------------------------------------------------------------
/*/{Protheus.doc} OS_APICOPIAR
Endpoint REST (POST /CNSAOSCOPIAR) de copia de OS. Chama o nucleo
OS_NUCLEOCOPIAR e devolve o resultado em JSON.
@return lOk   JSON via oRest:setStatusResponse (200 com {osOriginal,osNova}, 404 se a OS nao existir, 400/500 em erro)
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
@Post(endpoint="/CNSAOSCOPIAR")
User Function OS_APICOPIAR() As Logical
    Local jQuery    := oRest:getQueryRequest() As Json
    Local cOsOrigem := AllTrim(OS_LERJSONTXT(jQuery,"os")) As Character
    Local oJson     := JsonObject():New()
    Local oErro     := Nil
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    Begin Sequence

        aResultado := OS_NUCLEOCOPIAR(cOsOrigem)

        If !aResultado[1]
            If aResultado[2] == "OS nao encontrada."
                Return oRest:setStatusResponse(404, '{"erro":"' + OS_ESCAPARJSON(aResultado[2]) + '"}')
            EndIf
            Return oRest:setStatusResponse(400, '{"erro":"' + OS_ESCAPARJSON(aResultado[2]) + '"}')
        EndIf

        oJson['sucesso']    := .T.
        oJson['osOriginal'] := cOsOrigem
        oJson['osNova']     := aResultado[3]
        oJson['mensagem']   := "OS copiada com sucesso."

        Return oRest:setStatusResponse(200, oJson:ToJson())

    Recover Using oErro
        Return oRest:setStatusResponse(500, '{"erro":"' + OS_ESCAPARJSON(oErro:Description) + '"}')
    End Sequence

Return oRest:setStatusResponse(500, '{"erro":"Erro desconhecido."}')

////////////////////////////////////////////////////////////////////////////////////////////////
//                                                                                              //
//        INTERACOES DA OS SEM CHAMADO (blocos acumulados no Memo Z1_SERV)                     //
//                                                                                              //
////////////////////////////////////////////////////////////////////////////////////////////////
// OS com chamado (Z1_IDCH) grava interacao na ZA2 (CNSA001, CNSACHAMADOSINTERACOES*).
// OS sem chamado acumula cada interacao no fim do Memo Z1_SERV, num bloco:
//   === INTERACAO 24/09/2026 10:30 | 000123 | NOME DO CONSULTOR ===
//   texto da interacao
// Tudo antes do primeiro bloco e a descricao da OS. Quando a OS ganha
// chamado (OS_NUCLEOALTERAR), os blocos migram pra ZA2 e saem do Memo -
// a descricao fica.

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_MARCAINTERACAO
Marcador de inicio de bloco de interacao dentro do Memo Z1_SERV.
@return cMarca   Texto do marcador
@author Henrique
@since 24/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_MARCAINTERACAO()
Return "=== INTERACAO "

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_LIMPABORDAS
Remove espacos, tabs e quebras de linha do inicio e do fim do texto
(AllTrim so remove espaco).
@param  cTexto   Texto a limpar
@return cRet     Texto sem espacos/quebras nas bordas
@author Henrique
@since 24/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_LIMPABORDAS(cTexto)
    Local cRet    := cTexto
    Local cBordas := " " + Chr(9) + Chr(10) + Chr(13)

    While Len(cRet) > 0 .And. Left(cRet, 1) $ cBordas
        cRet := SubStr(cRet, 2)
    EndDo
    While Len(cRet) > 0 .And. Right(cRet, 1) $ cBordas
        cRet := Left(cRet, Len(cRet) - 1)
    EndDo

Return cRet

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_TEXTOPURO
Converte o HTML do editor (po-rich-text) em texto puro pra gravar no
Memo Z1_SERV: quebra de linha no lugar de <br>/</p>/</div>/</li>,
remove as demais tags e decodifica as entidades mais comuns.
@param  cHtml   Texto em HTML
@return cRet    Texto puro
@author Henrique
@since 24/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_TEXTOPURO(cHtml)
    Local cRet  := cHtml
    Local cCRLF := Chr(13) + Chr(10)
    Local nIni  := 0
    Local nFim  := 0

    cRet := StrTran(cRet, "<br>",   cCRLF)
    cRet := StrTran(cRet, "<br/>",  cCRLF)
    cRet := StrTran(cRet, "<br />", cCRLF)
    cRet := StrTran(cRet, "</p>",   cCRLF)
    cRet := StrTran(cRet, "</div>", cCRLF)
    cRet := StrTran(cRet, "</li>",  cCRLF)

    nIni := At("<", cRet)
    While nIni > 0
        nFim := At(">", SubStr(cRet, nIni))
        If nFim == 0
            Exit
        EndIf
        cRet := Left(cRet, nIni - 1) + SubStr(cRet, nIni + nFim)
        nIni := At("<", cRet)
    EndDo

    cRet := StrTran(cRet, "&nbsp;", " ")
    cRet := StrTran(cRet, "&lt;",   "<")
    cRet := StrTran(cRet, "&gt;",   ">")
    cRet := StrTran(cRet, "&quot;", '"')
    cRet := StrTran(cRet, "&#39;",  "'")
    cRet := StrTran(cRet, "&amp;",  "&")

Return OS_LIMPABORDAS(cRet)

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_SEPARAINTERACOES
Separa o Memo Z1_SERV em descricao (texto antes do primeiro bloco) e
blocos de interacao.
@param  cMemo   Conteudo do Z1_SERV
@return aRet    {cDescricao, aBlocos} - cada bloco {cData (DD/MM/AAAA), cHora, cConsultor, cNome, cTexto}
@author Henrique
@since 24/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_SEPARAINTERACOES(cMemo)
    Local cMarca    := OS_MARCAINTERACAO()
    Local nPos      := At(cMarca, cMemo)
    Local cDesc     := ""
    Local cResto    := ""
    Local cBloco    := ""
    Local cCab      := ""
    Local nFimCab   := 0
    Local aCab      := {}
    Local aBlocos   := {}

    If nPos == 0
        Return {OS_LIMPABORDAS(cMemo), {}}
    EndIf

    cDesc  := OS_LIMPABORDAS(Left(cMemo, nPos - 1))
    cResto := SubStr(cMemo, nPos + Len(cMarca))

    While !Empty(cResto)
        nPos := At(cMarca, cResto)
        If nPos > 0
            cBloco := Left(cResto, nPos - 1)
            cResto := SubStr(cResto, nPos + Len(cMarca))
        Else
            cBloco := cResto
            cResto := ""
        EndIf

        nFimCab := At(" ===", cBloco)
        If nFimCab == 0
            Loop
        EndIf
        cCab := Left(cBloco, nFimCab - 1)
        aCab := StrTokArr2(cCab, "|", .T.)
        // aCab[1] = "DD/MM/AAAA HH:MM", aCab[2] = codigo, aCab[3] = nome
        AAdd(aBlocos, { ;
            Left(AllTrim(aCab[1]), 10), ;
            AllTrim(SubStr(AllTrim(aCab[1]), 12)), ;
            If(Len(aCab) >= 2, AllTrim(aCab[2]), ""), ;
            If(Len(aCab) >= 3, AllTrim(aCab[3]), ""), ;
            OS_LIMPABORDAS(SubStr(cBloco, nFimCab + 4)) ;
        })
    EndDo

Return {cDesc, aBlocos}

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_BLOCOSINTERACAO
Devolve so a parte de blocos de interacao do Memo (do primeiro marcador
ate o fim), ja com a quebra de linha que separa da descricao - usado no
Alterar pra trocar a descricao sem perder o historico.
@param  cMemo   Conteudo do Z1_SERV
@return cBlocos Parte de interacoes (ou "" se nao houver)
@author Henrique
@since 24/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_BLOCOSINTERACAO(cMemo)
    Local nPos := At(OS_MARCAINTERACAO(), cMemo)
    If nPos == 0
        Return ""
    EndIf
Return Chr(13) + Chr(10) + Chr(13) + Chr(10) + SubStr(cMemo, nPos)

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_MIGRARINTERACOES
Quando a OS tem chamado (Z1_IDCH) e ainda guarda blocos de interacao no
Memo Z1_SERV (gravados enquanto nao tinha chamado), copia cada bloco
para a ZA2 do chamado (com ZA2_OS) e deixa no Memo so a descricao.
@param  cOs   Numero da OS (Z1_OS)
@author Henrique
@since 24/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_MIGRARINTERACOES(cOs)
    Local cIdCh   := ""
    Local aSep    := {}
    Local aBloco  := {}
    Local cAlias  := ""
    Local nSeq    := 1
    Local nI      := 0
    Local cData   := ""

    DbSelectArea("SZ1")
    SZ1->(DbSetOrder(1))
    If !SZ1->(DbSeek(cFilAnt + cOs))
        Return
    EndIf

    cIdCh := AllTrim(SZ1->Z1_IDCH)
    If Empty(cIdCh)
        Return
    EndIf

    aSep := OS_SEPARAINTERACOES(SZ1->Z1_SERV)
    If Len(aSep[2]) == 0
        Return
    EndIf

    // Proxima sequencia da ZA2 do chamado - ZA2_IDCH e Character, comparar
    // com Character (ver FIX ORA-01722 em CH_GRAVARINTERACAO, CNSA001).
    cAlias := GetNextAlias()
    BeginSql Alias cAlias
        SELECT MAX(ZA2_IDGRID) MAXGRID
        FROM %Table:ZA2% ZA2
        WHERE ZA2_FILIAL = %xFilial:ZA2%
          AND ZA2_IDCH   = %Exp:cIdCh%
          AND %NotDel%
    EndSql
    If !(cAlias)->(Eof()) .And. !Empty(AllTrim((cAlias)->MAXGRID))
        nSeq := Val(AllTrim((cAlias)->MAXGRID)) + 1
    EndIf
    (cAlias)->(DbCloseArea())

    Begin Transaction

        For nI := 1 To Len(aSep[2])
            aBloco := aSep[2][nI]
            // DD/MM/AAAA -> AAAAMMDD (nao depende do SET DATE)
            cData  := SubStr(aBloco[1], 7, 4) + SubStr(aBloco[1], 4, 2) + SubStr(aBloco[1], 1, 2)

            RecLock("ZA2", .T.)
                ZA2->ZA2_FILIAL := xFilial("ZA2")
                ZA2->ZA2_IDCH   := cIdCh
                ZA2->ZA2_IDGRID := StrZero(nSeq, 3)
                ZA2->ZA2_CONSUL := aBloco[3]
                ZA2->ZA2_DATA   := SToD(cData)
                ZA2->ZA2_HORA   := aBloco[2]
                ZA2->ZA2_DESCRI := aBloco[5]
                ZA2->ZA2_OS     := cOs
            ZA2->(MsUnlock())
            nSeq++
        Next nI

        RecLock("SZ1", .F.)
            SZ1->Z1_SERV := aSep[1]
        SZ1->(MsUnlock())

    End Transaction

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_APILISTAINTERACOES
Endpoint REST GET /CNSAOSINTERACOES: lista todas as interacoes feitas
por uma OS (os via query) - as do Memo Z1_SERV (OS sem chamado) e as da
ZA2 gravadas com ZA2_OS desta OS (em qualquer chamado, com idCh).
Mesmo formato de item do CNSACHAMADOSINTERACOES (seq/consultor/data/
hora/texto/os + idCh), ordenado por data/hora.
@return Logical - resposta HTTP com o JSON de interacoes
@author Henrique
@since 24/09/2026
@version P12
/*/
//-------------------------------------------------------------------
@Get(endpoint="/CNSAOSINTERACOES")
User Function OS_APILISTAINTERACOES() As Logical
    Local jQuery  := oRest:getQueryRequest() As Json
    Local cOs     := AllTrim(OS_LERJSONTXT(jQuery,"os"))
    Local oJson   := JsonObject():New()
    Local oLinha  := Nil
    Local aItens  := {}
    Local aSep    := {}
    Local aBloco  := {}
    Local aOrdem  := {}
    Local nI      := 0
    Local oErro   := Nil
    Local cAlias  := ""
    Local cData   := ""
    Local cConsul := ""
    Local aCh     := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    Begin Sequence

        If Empty(cOs)
            Return oRest:setStatusResponse(400, '{"erro":"Informe o numero da OS."}')
        EndIf

        DbSelectArea("SZ1")
        SZ1->(DbSetOrder(1))
        If !SZ1->(DbSeek(cFilAnt + cOs))
            Return oRest:setStatusResponse(404, '{"erro":"OS nao encontrada."}')
        EndIf

        // 1) Memo da OS (interacoes de quando ela nao tinha chamado)
        aSep := OS_SEPARAINTERACOES(SZ1->Z1_SERV)

        // OS sem chamado: existe UMA descricao so (editada pela janela do
        // editor no portal) - vai como item unico, marcado como Descricao.
        // Sem descricao = lista vazia.
        If Empty(AllTrim(SZ1->Z1_IDCH))
            If !Empty(aSep[1])
                cData  := DToS(SZ1->Z1_DTOS)
                If Len(cData) == 8
                    cData := SubStr(cData, 1, 4) + "-" + SubStr(cData, 5, 2) + "-" + SubStr(cData, 7, 2)
                EndIf
                oLinha := JsonObject():New()
                oLinha['seq']       := "OS-DESC"
                oLinha['consultor'] := OS_NOMETEC(AllTrim(SZ1->Z1_TEC))
                oLinha['data']      := cData
                oLinha['hora']      := ""
                oLinha['texto']     := aSep[1]
                oLinha['os']        := cOs
                oLinha['idCh']      := ""
                oLinha['descricao'] := .T.
                AAdd(aOrdem, {cData, oLinha})
            EndIf
        Else
            // Com chamado: blocos antigos do Memo ainda nao migrados pra ZA2.
            For nI := 1 To Len(aSep[2])
                aBloco := aSep[2][nI]
                cData  := SubStr(aBloco[1], 7, 4) + "-" + SubStr(aBloco[1], 4, 2) + "-" + SubStr(aBloco[1], 1, 2)
                oLinha := JsonObject():New()
                // seq unico na lista toda (front usa como track) - "OS-nnn" pro Memo
                oLinha['seq']       := "OS-" + StrZero(nI, 3)
                oLinha['consultor'] := aBloco[4]
                oLinha['data']      := cData
                oLinha['hora']      := aBloco[2]
                oLinha['texto']     := aBloco[5]
                oLinha['os']        := cOs
                oLinha['idCh']      := ""
                AAdd(aOrdem, {cData + aBloco[2], oLinha})
            Next nI
        EndIf

        // 2) ZA2 gravadas por esta OS (ZA2_OS), em qualquer chamado.
        // ZA2_DESCRI (Memo) precisa ser a ULTIMA coluna do SELECT (DBAccess).
        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT ZA2_IDCH, ZA2_IDGRID, ZA2_CONSUL, ZA2_DATA, ZA2_HORA, ZA2_DESCRI
            FROM %Table:ZA2% ZA2
            WHERE ZA2_FILIAL = %xFilial:ZA2%
              AND ZA2_OS     = %Exp:cOs%
              AND %NotDel%
        EndSql

        While !(cAlias)->(Eof())
            If ValType((cAlias)->ZA2_DATA) == "D"
                cData := DToS((cAlias)->ZA2_DATA)
            Else
                cData := AllTrim((cAlias)->ZA2_DATA)
            EndIf
            If Len(cData) == 8
                cData := SubStr(cData, 1, 4) + "-" + SubStr(cData, 5, 2) + "-" + SubStr(cData, 7, 2)
            EndIf
            cConsul := AllTrim((cAlias)->ZA2_CONSUL)

            oLinha := JsonObject():New()
            oLinha['seq']       := AllTrim((cAlias)->ZA2_IDCH) + "-" + AllTrim((cAlias)->ZA2_IDGRID)
            oLinha['consultor'] := If(Empty(cConsul), "", AllTrim(Posicione("AA1", 1, xFilial("AA1") + cConsul, "AA1_NOMTEC")))
            oLinha['data']      := cData
            oLinha['hora']      := AllTrim((cAlias)->ZA2_HORA)
            oLinha['texto']     := OS_DECODESAFE(AllTrim((cAlias)->ZA2_DESCRI))
            oLinha['os']        := cOs
            oLinha['idCh']      := AllTrim((cAlias)->ZA2_IDCH)
            oLinha['assunto']   := OS_DECODESAFE(AllTrim(Posicione("ZA1", 1, xFilial("ZA1") + AllTrim((cAlias)->ZA2_IDCH), "ZA1_ASSUNT")))
            AAdd(aOrdem, {cData + AllTrim((cAlias)->ZA2_HORA), oLinha})

            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())

        // Mais recente primeiro
        ASort(aOrdem, , , {|x, y| x[1] > y[1]})
        For nI := 1 To Len(aOrdem)
            AAdd(aItens, aOrdem[nI][2])
        Next nI

        oJson['os']    := cOs
        oJson['items'] := aItens

        // Chamados da OS (ZA3 + principal) - janela "Visualizar chamados" e o
        // campo "Chamado" obrigatorio da interacao no portal.
        aCh := OS_ZA3("LER", cOs, SZ1->Z1_IDCH)
        For nI := 1 To Len(aCh)
            oLinha := JsonObject():New()
            oLinha['idCh']    := aCh[nI]
            oLinha['assunto'] := OS_DECODESAFE(AllTrim(Posicione("ZA1", 1, xFilial("ZA1") + aCh[nI], "ZA1_ASSUNT")))
            oLinha['status']  := AllTrim(Posicione("ZA1", 1, xFilial("ZA1") + aCh[nI], "ZA1_STATUS"))
            oLinha['data']    := OS_DATAISO(Posicione("ZA1", 1, xFilial("ZA1") + aCh[nI], "ZA1_DATA"))   // abertura - ordem cronologica
            aCh[nI] := oLinha
        Next nI
        oJson['chamados'] := aCh

        Return oRest:setStatusResponse(200, oJson:ToJson())

    Recover Using oErro
        Return oRest:setStatusResponse(500, '{"erro":"' + OS_ESCAPARJSON(oErro:Description) + '"}')
    End Sequence

Return oRest:setStatusResponse(500, '{"erro":"Erro desconhecido."}')

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_APINOVAINTERACAO
Endpoint REST POST /CNSAOSINTERACOESINCLUIR: grava a descricao (os/texto
via query) de uma OS SEM chamado. OS sem chamado tem UMA descricao so - o
portal edita pela janela do editor (ja aberta com o texto atual) e o texto
novo SUBSTITUI o Z1_SERV inteiro. OS com chamado grava na ZA2
(CNSACHAMADOSINTERACOESINCLUIR) - devolve 400.
@return Logical - resposta HTTP com o resultado da inclusao
@author Henrique
@since 24/09/2026
@version P12
/*/
//-------------------------------------------------------------------
@Post(endpoint="/CNSAOSINTERACOESINCLUIR")
User Function OS_APINOVAINTERACAO() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local cOs        := AllTrim(OS_LERJSONTXT(jQuery,"os"))
    Local cTexto     := OS_TEXTOPURO(OS_LERJSONTXT(jQuery,"texto"))
    Local oJson      := JsonObject():New()
    Local oErro      := Nil

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    Begin Sequence

        If Empty(cOs)
            Return oRest:setStatusResponse(400, '{"erro":"Informe o numero da OS."}')
        EndIf
        If Empty(cTexto)
            Return oRest:setStatusResponse(400, '{"erro":"Escreva o texto da interacao."}')
        EndIf

        DbSelectArea("SZ1")
        SZ1->(DbSetOrder(1))
        If !SZ1->(DbSeek(cFilAnt + cOs))
            Return oRest:setStatusResponse(404, '{"erro":"OS nao encontrada."}')
        EndIf

        If !Empty(AllTrim(SZ1->Z1_IDCH))
            Return oRest:setStatusResponse(400, '{"erro":"OS vinculada ao chamado ' + AllTrim(SZ1->Z1_IDCH) + ' - a interacao deve ser gravada no chamado."}')
        EndIf

        // OS sem chamado: uma descricao so - o texto novo substitui tudo.
        RecLock("SZ1", .F.)
            SZ1->Z1_SERV := cTexto
        SZ1->(MsUnlock())

        oJson['sucesso']   := .T.
        oJson['os']        := cOs
        oJson['descricao'] := cTexto
        oJson['mensagem'] := "Interacao adicionada com sucesso."

        Return oRest:setStatusResponse(200, oJson:ToJson())

    Recover Using oErro
        Return oRest:setStatusResponse(500, '{"erro":"' + OS_ESCAPARJSON(oErro:Description) + '"}')
    End Sequence

Return oRest:setStatusResponse(500, '{"erro":"Erro desconhecido."}')

////////////////////////////////////////////////////////////////////////////////
// OS LIGADA A VARIOS CHAMADOS (tabela ZA3)
// Henrique - 07/10/2026 - spec docs/superpowers/specs/2026-10-07-os-n-chamados-design.md
// ZA3: ZA3_FILIAL + ZA3_OS + ZA3_IDCH (indice 1). Z1_IDCH segue como chamado
// principal (primeiro da lista) - Agenda, tela classica e a regra "OS sem
// chamado" continuam olhando ele.
////////////////////////////////////////////////////////////////////////////////

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_ZA3
Chamados da OS - uma funcao, uma opcao por acao:
  LER     (cOs, cIdChPrincipal)    chamados da OS: principal + ZA3 -> array
  PARAM   (jQuery)                 le "chamados" (CSV) ou "chamado" -> {lVeio, aCodigos}
  VALIDAR (cOs, aCh, cCli, cLoja)  "" se ok; senao a mensagem (mesmo cliente/loja
                                   e nao tirar chamado com interacao desta OS)
  GRAVAR  (cOs, aCh)               grava a lista na ZA3 (substitui a anterior)
@author Henrique
@since 07/10/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_ZA3(cAcao, x1, x2, x3, x4)
    Local xRet   := Nil
    Local aCh    := {}
    Local aAntes := {}
    Local aLista := {}
    Local cAlias := ""
    Local cCod   := ""
    Local cOs    := ""
    Local nQtd   := 0
    Local nI     := 0

    Do Case

    //--- Chamados da OS: principal (Z1_IDCH) primeiro + os da ZA3 ---------------
    Case cAcao == "LER"
        cOs    := AllTrim(x1)
        cCod   := AllTrim(cValToChar(x2))
        If !Empty(cCod)
            AAdd(aCh, cCod)
        EndIf
        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT ZA3_IDCH
            FROM %Table:ZA3% ZA3
            WHERE ZA3_FILIAL = %xFilial:ZA3%
              AND ZA3_OS     = %Exp:cOs%
              AND %NotDel%
            ORDER BY ZA3_IDCH
        EndSql
        While !(cAlias)->(Eof())
            If AScan(aCh, AllTrim((cAlias)->ZA3_IDCH)) == 0
                AAdd(aCh, AllTrim((cAlias)->ZA3_IDCH))
            EndIf
            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())
        xRet := aCh

    //--- Parametro do portal: "chamados" (CSV) ou o antigo "chamado" ----------
    Case cAcao == "PARAM"
        xRet   := {x1["chamados"] != Nil .Or. x1["chamado"] != Nil, {}}
        aLista := StrTokArr2(AllTrim(If(x1["chamados"] != Nil, OS_LERJSONTXT(x1, "chamados"), OS_LERJSONTXT(x1, "chamado"))), ",", .F.)
        For nI := 1 To Len(aLista)
            cCod := AllTrim(aLista[nI])
            If !Empty(cCod) .And. AScan(xRet[2], cCod) == 0
                AAdd(xRet[2], cCod)
            EndIf
        Next nI

    //--- Mesmo cliente/loja e nao tirar chamado com interacao desta OS ---------
    Case cAcao == "VALIDAR"
        cOs  := AllTrim(x1)
        xRet := ""
        ZA1->(DbSetOrder(1))
        For nI := 1 To Len(x2)
            If !ZA1->(DbSeek(xFilial("ZA1") + x2[nI]))
                Return "Chamado #" + x2[nI] + " nao encontrado."
            EndIf
            If AllTrim(ZA1->ZA1_CLIENT) != AllTrim(x3) .Or. AllTrim(ZA1->ZA1_LOJA) != AllTrim(x4)
                Return "Chamado #" + x2[nI] + " nao e do cliente da OS."
            EndIf
        Next nI

        If !Empty(cOs)
            aAntes := OS_ZA3("LER", cOs, Posicione("SZ1", 1, xFilial("SZ1") + cOs, "Z1_IDCH"))
            For nI := 1 To Len(aAntes)
                If AScan(x2, aAntes[nI]) == 0
                    cCod   := aAntes[nI]
                    cAlias := GetNextAlias()
                    BeginSql Alias cAlias
                        SELECT COUNT(*) QTD
                        FROM %Table:ZA2% ZA2
                        WHERE ZA2_FILIAL = %xFilial:ZA2%
                          AND ZA2_IDCH   = %Exp:cCod%
                          AND ZA2_OS     = %Exp:cOs%
                          AND %NotDel%
                    EndSql
                    nQtd := (cAlias)->QTD
                    (cAlias)->(DbCloseArea())
                    If nQtd > 0
                        Return "Chamado #" + cCod + " ja tem interacao desta OS - nao pode ser removido."
                    EndIf
                EndIf
            Next nI
        EndIf

    //--- Grava a lista da OS na ZA3 (lista vazia = so apaga) ------------------
    Case cAcao == "GRAVAR"
        cOs := PadR(AllTrim(x1), TamSX3("ZA3_OS")[1])
        ZA3->(DbSetOrder(1))
        While ZA3->(DbSeek(xFilial("ZA3") + cOs))
            RecLock("ZA3", .F.)
                ZA3->(DbDelete())
            ZA3->(MsUnlock())
        EndDo
        For nI := 1 To Len(x2)
            RecLock("ZA3", .T.)
                ZA3->ZA3_FILIAL := xFilial("ZA3")
                ZA3->ZA3_OS     := cOs
                ZA3->ZA3_IDCH   := x2[nI]
            ZA3->(MsUnlock())
        Next nI

    EndCase

Return xRet

////////////////////////////////////////////////////////////////////////////////
//                                                                            //
//              E-MAIL DA OS AO CLIENTE E AO TECNICO (OS_EMAIL)               //
//                                                                            //
////////////////////////////////////////////////////////////////////////////////
// Quem grava a OS escolhe avisar o cliente e/ou o tecnico (portal: switches;
// tela classica: janela de checkboxes do CNSA001). Portal chama o endpoint
// POST /CNSAOSEMAIL depois de gravar (OS_APIEMAIL). Layout e envio do CNSA001
// (apia.cnsa001.U_CH_HTMLPUB / U_CH_MAILPUB); acentos via U_CNSOUTL("TEXTO").
// Falha no e-mail nunca desfaz a OS.
//
//   ENVIAR  (cOs, lCliente, lTecnico)  envia o resumo; ao cliente marca Z1_OSENVCL/Z1_ENVDT/Z1_ENVHR;
//                                      devolve {qtd e-mails ao cliente, enviou ao tecnico}
//   TELA    (cOs)                      tela classica: pergunta e chama ENVIAR
//   RESUMO  ()                         linhas do cartao (SZ1 posicionada)
//   DESTINO ()                         e-mails do cliente: chamados da OS, senao A1_EMAIL
////////////////////////////////////////////////////////////////////////////////

/*/{Protheus.doc} OS_APIEMAIL
Endpoint REST POST /CNSAOSEMAIL?os=&cliente=1&tecnico=1 - envia o resumo da OS
ao cliente e/ou ao tecnico (OS_EMAIL "ENVIAR"). O portal chama depois de gravar
a OS; separado da gravacao pra nao atrasar o Salvar e poder reenviar.
@return lOk   200 {sucesso, os, emailsCliente, emailTecnico} ou 404
@author Henrique
@since 08/10/2026
@version P12
/*/
@Post(endpoint="/CNSAOSEMAIL")
User Function OS_APIEMAIL() As Logical
    Local jQuery := oRest:getQueryRequest() As Json
    Local cOs    := AllTrim(OS_LERJSONTXT(jQuery, "os"))
    Local aEnvio := {}
    Local oJson  := JsonObject():New()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    SZ1->(DbSetOrder(1))
    If Empty(cOs) .Or. !SZ1->(DbSeek(cFilAnt + PadR(cOs, TamSX3("Z1_OS")[1])))
        Return oRest:setStatusResponse(404, '{"erro":"OS nao encontrada."}')
    EndIf

    aEnvio := OS_EMAIL("ENVIAR", cOs, OS_LERJSONTXT(jQuery, "cliente") == "1", OS_LERJSONTXT(jQuery, "tecnico") == "1")

    oJson["sucesso"]      := .T.
    oJson["os"]           := cOs
    oJson["emailsCliente"] := aEnvio[1]
    oJson["emailTecnico"] := aEnvio[2]

Return oRest:setStatusResponse(200, oJson:ToJson())

/*/{Protheus.doc} OS_EMAIL
E-mail da OS ao cliente e/ou ao tecnico - uma funcao, uma acao por Case.
@param  cAcao   ENVIAR, TELA, RESUMO ou DESTINO
@param  x1..x3  Parametros da acao (ver tabela acima)
@return xRet    Conforme a acao
@author Henrique
@since 08/10/2026
@version P12
/*/
Static Function OS_EMAIL(cAcao, x1, x2, x3)
    Local xRet    := Nil
    Local cOs     := ""
    Local cEmail  := ""
    Local cTexto  := ""
    Local aLin    := {}
    Local aCh     := {}
    Local aResp   := {}
    Local nI      := 0
    Local nJ      := 0
    Local lEnviou := .F.

    Do Case

    //--- Envia o resumo da OS ao cliente e/ou ao tecnico ---------------------
    Case cAcao == "ENVIAR"
        xRet := {0, .F.}
        cOs  := PadR(AllTrim(cValToChar(x1)), TamSX3("Z1_OS")[1])
        SZ1->(DbSetOrder(1))
        If !(x2 .Or. x3) .Or. Empty(cOs) .Or. !SZ1->(DbSeek(cFilAnt + cOs))
            Return xRet
        EndIf

        aLin := OS_EMAIL("RESUMO")
        // Descricao sem as interacoes do Memo e sem tags (editor do portal manda HTML).
        cTexto := OS_SEPARAINTERACOES(OS_DESC(cOs))[1]
        cTexto := StrTran(StrTran(StrTran(cTexto, "</p>", Chr(10)), "<br>", Chr(10)), "<br/>", Chr(10))
        While At("<", cTexto) > 0 .And. At(">", cTexto) > At("<", cTexto)
            cTexto := Stuff(cTexto, At("<", cTexto), At(">", cTexto) - At("<", cTexto) + 1, "")
        EndDo
        cTexto := U_CNSOUTL("TEXTO", StrTran(cTexto, "&nbsp;", " "))

        If x3
            cEmail := AllTrim(Posicione("AA1", 1, xFilial("AA1") + PadR(AllTrim(SZ1->Z1_TEC), TamSX3("AA1_CODTEC")[1]), "AA1_EMAIL"))
            If !Empty(cEmail)
                xRet[2] := apia.cnsa001.U_CH_MAILPUB(cEmail, "OS " + AllTrim(cOs) + " registrada", ;
                    apia.cnsa001.U_CH_HTMLPUB("", "OS " + AllTrim(cOs), U_CNSOUTL("TEXTO", OS_NOMETEC(AllTrim(SZ1->Z1_TEC))), ;
                        "Uma OS foi registrada em seu nome. Confira o resumo abaixo.", aLin, "Descri&ccedil;&atilde;o", cTexto, ""))
            EndIf
        EndIf

        // OS Interna nao vai pro cliente.
        If x2 .And. AllTrim(SZ1->Z1_INTERNO) != "S"
            aResp := OS_EMAIL("DESTINO")
            For nI := 1 To Len(aResp)
                If apia.cnsa001.U_CH_MAILPUB(aResp[nI], "Ordem de Servico " + AllTrim(cOs), ;
                        apia.cnsa001.U_CH_HTMLPUB("", "Ordem de Servi&ccedil;o " + AllTrim(cOs), "", ;
                            "Segue o resumo do atendimento realizado.", aLin, "Descri&ccedil;&atilde;o", cTexto, ;
                            "Qualquer d&uacute;vida, entre em contato: <b>pericles@apia.com.br</b>"))
                    xRet[1]++
                    lEnviou := .T.
                EndIf
            Next nI
            If lEnviou
                SZ1->(DbSeek(cFilAnt + cOs))
                RecLock("SZ1", .F.)
                    SZ1->Z1_OSENVCL := "S"
                    SZ1->Z1_ENVDT   := Date()
                    SZ1->Z1_ENVHR   := OS_HORACAMPO(Left(Time(), 5), "Z1_ENVHR")
                SZ1->(MsUnlock())
            EndIf
        EndIf

    //--- Tela classica: pergunta (janela do CNSA001) e envia -----------------
    Case cAcao == "TELA"
        cOs := PadR(AllTrim(cValToChar(x1)), TamSX3("Z1_OS")[1])
        SZ1->(DbSetOrder(1))
        If !Empty(cOs) .And. SZ1->(DbSeek(cFilAnt + cOs))
            aResp := apia.cnsa001.U_CH_PERGUNTAPUB("OS " + AllTrim(cOs), ;
                AllTrim(SZ1->Z1_INTERNO) != "S", !Empty(AllTrim(SZ1->Z1_TEC)))
            xRet := OS_EMAIL("ENVIAR", cOs, aResp[1], aResp[2])
        EndIf

    //--- Linhas do cartao do e-mail (SZ1 posicionada) ------------------------
    Case cAcao == "RESUMO"
        xRet := {}
        AAdd(xRet, {"OS", '<span style="color:#1a7fc1">' + AllTrim(SZ1->Z1_OS) + '</span>'})
        AAdd(xRet, {"Cliente", U_CNSOUTL("TEXTO", OS_NOMECLI(AllTrim(SZ1->Z1_CLI), AllTrim(SZ1->Z1_LOJA))) + " (Loja " + AllTrim(SZ1->Z1_LOJA) + ")"})
        AAdd(xRet, {"Data", DToC(SZ1->Z1_DTOS)})
        AAdd(xRet, {"Hor&aacute;rio", AllTrim(SZ1->Z1_HRINI) + " &agrave;s " + AllTrim(SZ1->Z1_HRFIM)})
        AAdd(xRet, {"Total de horas", AllTrim(SZ1->Z1_HRTOT)})
        AAdd(xRet, {"Analista", U_CNSOUTL("TEXTO", OS_NOMETEC(AllTrim(SZ1->Z1_TEC)))})
        If !Empty(SZ1->Z1_PROJET)
            AAdd(xRet, {"Projeto", AllTrim(SZ1->Z1_PROJET) + " - " + U_CNSOUTL("TEXTO", OS_NOMEPROJ(AllTrim(SZ1->Z1_PROJET)))})
        EndIf
        If !Empty(SZ1->Z1_TAREFA)
            AAdd(xRet, {"Tarefa", AllTrim(SZ1->Z1_TAREFA) + " - " + U_CNSOUTL("TEXTO", OS_NOMETAREFA(AllTrim(SZ1->Z1_PROJET), AllTrim(SZ1->Z1_TAREFA)))})
        EndIf
        aCh := OS_ZA3("LER", AllTrim(SZ1->Z1_OS), AllTrim(SZ1->Z1_IDCH))
        If Len(aCh) > 0
            cTexto := ""
            For nI := 1 To Len(aCh)
                cTexto += If(nI > 1, "<br>", "") + "#" + aCh[nI] + " - " + ;
                    U_CNSOUTL("TEXTO", Posicione("ZA1", 1, xFilial("ZA1") + aCh[nI], "ZA1_ASSUNT"))
            Next nI
            AAdd(xRet, {"Chamados", cTexto})
        EndIf

    //--- E-mails do cliente: chamados da OS (sem repetir), senao A1_EMAIL ---------
    Case cAcao == "DESTINO"
        xRet := {}
        aCh  := OS_ZA3("LER", AllTrim(SZ1->Z1_OS), AllTrim(SZ1->Z1_IDCH))
        For nI := 1 To Len(aCh)
            aResp := StrTokArr2(StrTran(Posicione("ZA1", 1, xFilial("ZA1") + aCh[nI], "ZA1_EMAIL"), ",", ";"), ";", .F.)
            For nJ := 1 To Len(aResp)
                cEmail := Lower(AllTrim(aResp[nJ]))
                If "@" $ cEmail .And. AScan(xRet, cEmail) == 0
                    AAdd(xRet, cEmail)
                EndIf
            Next nJ
        Next nI
        If Len(xRet) == 0
            aResp := StrTokArr2(StrTran(Posicione("SA1", 1, xFilial("SA1") + SZ1->Z1_CLI + SZ1->Z1_LOJA, "A1_EMAIL"), ",", ";"), ";", .F.)
            For nJ := 1 To Len(aResp)
                cEmail := Lower(AllTrim(aResp[nJ]))
                If "@" $ cEmail .And. AScan(xRet, cEmail) == 0
                    AAdd(xRet, cEmail)
                EndIf
            Next nJ
        EndIf

    EndCase

Return xRet
