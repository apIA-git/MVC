#Include "FWMVCDef.ch"
#Include "Totvs.ch"
#Include "TopConn.ch"
#Include "RwMake.ch"
#Include "Colors.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"


Namespace apia.cnsa002

PUBLISH MODEL REST NAME OS RESOURCE OBJECT oRestOS


//-------------------------------------------------------------------
/*/{Protheus.doc} CNS002
Funcao principal - ponto de entrada da tela de Browse de Ordem de
Servico (OS). Monta o menu (MenuDef) e ativa o FWMBrowse na tabela
SZ1, com as legendas de status (aprovada/faturada/negada/etc).
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
User Function CNS002()

    Local l_oBrowse := Nil
    // FIX: User Function precisa ser chamada com prefixo "u_" mesmo dentro do
    // mesmo arquivo/namespace (mesmo problema real confirmado no CNS001.TLPP).
    Private aRotina := u_MenuDef()

    l_oBrowse := FWMBrowse():New()
    If l_oBrowse <> Nil

        l_oBrowse:SetDescription("OS - APIA")
        l_oBrowse:SetAlias("SZ1")

        // Mesmas cores do portal (shared/paleta-status.ts): verde=concluido,
        // rosa=pendencia, azul=aprovado, amarelo=aguardando, preto=negada.
        l_oBrowse:AddLegend("(SZ1->Z1_APROVAD=='S'.OR.SZ1->Z1_APROVAD=='A').AND.SZ1->Z1_FATURAR=='S'",   "GREEN",    "Aprovada e Faturada")
        l_oBrowse:AddLegend("SZ1->Z1_FATURAR=='S'.AND.SZ1->Z1_APROVAD!='S'.AND.SZ1->Z1_APROVAD!='A'",    "PINK",     "Faturada sem Aprovacao")
        l_oBrowse:AddLegend("(SZ1->Z1_APROVAD=='S'.OR.SZ1->Z1_APROVAD=='A').AND.SZ1->Z1_FATURAR!='S'",   "BLUE",     "Aprovada")
        l_oBrowse:AddLegend("SZ1->Z1_APROVAD!='S'.AND.SZ1->Z1_APROVAD!='A'.AND.!Empty(SZ1->Z1_TEC)",     "YELLOW",   "Aguardando Aprovacao")
        l_oBrowse:AddLegend("SZ1->Z1_APROVAD!='S'.AND.SZ1->Z1_APROVAD!='A'.AND.Empty(SZ1->Z1_TEC)",      "BLACK",    "Negada")

        l_oBrowse:Activate()

    EndIf

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} MenuDef
Monta o array de opcoes de menu (aRotina) da tela CNS002 - Pesquisar,
Visualizar, Incluir, Alterar, Excluir, Copiar e Legenda.
@return aRotina   Array de opcoes de menu (ADD OPTION)
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
User Function MenuDef()

Local aRotina  := {}

    ADD OPTION aRotina TITLE "Pesquisar"    ACTION "AxPesqui"                        OPERATION 1 ACCESS 0
    // Mesmo padrao do CNSA001 (Chamado): ACTION "ViewDef.<fonte>" nao dispara
    // nada dentro do Namespace - cada opcao chama uma User Function que abre a
    // View via FWExecView com o identificador do namespace.
    ADD OPTION aRotina TITLE "Visualizar"   ACTION "apia.cnsa002.U_OS_VISUALIZARTELA" OPERATION 2 ACCESS 0
    ADD OPTION aRotina TITLE "Incluir"      ACTION "apia.cnsa002.U_OS_INCLUIRTELA"    OPERATION 3 ACCESS 0
    ADD OPTION aRotina TITLE "Alterar"      ACTION "apia.cnsa002.U_OS_ALTERARTELA"    OPERATION 4 ACCESS 0
    ADD OPTION aRotina TITLE "Excluir"      ACTION "apia.cnsa002.U_OS_EXCLUIRTELA"    OPERATION 5 ACCESS 0
    ADD OPTION aRotina TITLE "Copiar"       ACTION "apia.cnsa002.U_OS_COPIARTELA"    OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Legenda"      ACTION "apia.cnsa002.U_OS_LEGENDA"       OPERATION 0 ACCESS 0

Return aRotina

//-------------------------------------------------------------------
/*/{Protheus.doc} ViewDef
Monta a view (FWFormView) da tela CNS002 - cabecalho SZ1 (dados da
OS) e grid SZ2 (horas contratadas). Identico ao ViewDef do CNSA002.PRW
classico, so troca o modelo carregado por "CNS002".
@return l_oView   Objeto FWFormView montado (ou Nil se o Model nao carregar)
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
User Function ViewDef()

    Local l_oView    := Nil
    // Model ativo (montado pelo FWExecView / OS_MONTARMODEL) - FWLoadModel("CNS002")
    // nao acha o modelo dentro do Namespace. Mesmo padrao do ViewDef do CNSA001.
    Local l_oModel   := FWModelActive()
    Local l_oStruSZ1 := FWFormStruct(2, "SZ1")
    Local l_oStruSZ2 := FWFormStruct(2, "SZ2")

    // Sem Model ativo (FWExecView sem oModel): monta aqui em vez de devolver
    // Nil - Nil vira "Undefined View for apia.cnsa002.u_cns002".
    If l_oModel == Nil
        l_oModel := OS_MONTARMODEL()
    EndIf

    l_oView := FWFormView():New()
    l_oView:SetModel(l_oModel)

    l_oView:AddField("VIEW_SZ1", l_oStruSZ1, "SZ1MASTER")
    l_oView:AddGrid("VIEW_SZ2",  l_oStruSZ2, "SZ2DETAIL")

    l_oView:CreateHorizontalBox("CABEC", 60)
    l_oView:CreateHorizontalBox("GRID",  40)

    l_oView:SetOwnerView("VIEW_SZ1", "CABEC")
    l_oView:SetOwnerView("VIEW_SZ2", "GRID")

    l_oView:EnableTitleView("VIEW_SZ1", "Dados da OS")
    l_oView:EnableTitleView("VIEW_SZ2", "Horas Contratadas")

    l_oView:SetCloseOnOk({||.T.})

Return l_oView

//-------------------------------------------------------------------
/*/{Protheus.doc
Monta o modelo de dados (MPFormModel) da tela CNS002 - tabela pai SZ1
(OS) e tabela filha SZ2 (horas contratadas, relacionada por CLIENTE,
nao por OS). Identico ao ModelDef do CNSA002.PRW classico (mesmas
tabelas/relacoes).
@return l_oModel   Objeto MPFormModel montado
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
User Function ModelDef()

Return OS_MONTARMODEL()

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_MONTARMODEL
Monta o Model da tela CNS002 (SZ1 + grid SZ2). Com nOperAtivar
informado tambem define a operacao e ativa, NA MESMA funcao - mesmo
motivo do CH_MONTARMODEL (CNSA001): FWInitCpo prende o "owner private
environment" ao frame que montou o Model; ativar em outro frame quebra o
INITVALUE do Insert com "_SetNamedPrvt: owner private environment not
found". Vale pra Incluir, Visualizar e Alterar: o INITVALUE dos campos
virtuais da SZ1 (ex: FDESC do nome do cliente) roda no Activate.
@param  nOperAtivar    Operacao pra ja ativar (MODEL_OPERATION_*) - vazio = so monta
@return l_oModel       Objeto MPFormModel montado
@author Henrique
@since 28/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_MONTARMODEL(nOperAtivar)

    Local l_oModel  := Nil
    Local l_oStrSZ1 := FWFormStruct(1, "SZ1")
    Local l_oStrSZ2 := FWFormStruct(1, "SZ2")
    Local aRelSZ2   := {}

    Default nOperAtivar := 0

    // Representante opcional mesmo se o dicionario marcar obrigatorio (X3_OBRIGAT).
    l_oStrSZ1:SetProperty("Z1_USR", MODEL_FIELD_OBRIGAT, .F.)
    l_oStrSZ1:SetProperty("Z1_SERV", MODEL_FIELD_OBRIGAT, .F.)
    l_oStrSZ1:SetProperty("Z1_TEC", MODEL_FIELD_OBRIGAT, .F.)

    // Pos-validacao: + OS_VALIDACOBRAR (agendamento "Nao Cobrar" so aceita
    // servico nao cobravel) - roda so ao confirmar, nao a cada campo.
    l_oModel := MPFormModel():New(;
        "FCNS002",;
        {|oModel| OS_PREVALIDA(oModel)},;
        {|oModel| OS_VALIDACANCELA(oModel) .And. OS_VALIDACOBRAR(oModel)})

    // Tabela pai: SZ1 (OS)
    l_oModel:AddFields(;
        "SZ1MASTER",;
        NIL,;
        l_oStrSZ1,;
        {|_f,_a,_c,_v| OS_VALIDACAMPO(_f,_a,_c,_v)},;
        NIL)

    // Tabela filha 1: SZ2 (horas contratadas) - relacao por CLIENTE, nao por
    // OS (ver aviso no topo do arquivo sobre risco de cascata).
    l_oModel:AddGrid("SZ2DETAIL", "SZ1MASTER", l_oStrSZ2)
    aAdd(aRelSZ2, {"Z2_CODCLI", "Z1_CLI"})
    aAdd(aRelSZ2, {"Z2_LOJA",   "Z1_LOJA"})
    l_oModel:SetRelation("SZ2DETAIL", aRelSZ2, SZ2->(IndexKey(2)))

    l_oModel:SetPrimaryKey({"Z1_FILIAL","Z1_OS"})

    If nOperAtivar > 0
        l_oModel:SetOperation(nOperAtivar)
        l_oModel:Activate()
        // Incluir na tela classica: numero AA + sequencia do ano (OS_PROXIMONUM),
        // no lugar do inicializador do dicionario. LoadValue - Z1_OS nao e editavel.
        If nOperAtivar == 3
            l_oModel:GetModel("SZ1MASTER"):LoadValue("Z1_OS", OS_PROXIMONUM())
        EndIf
    EndIf

Return l_oModel

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_VALIDACAMPO
Valida os campos do cabecalho (tabela SZ1) - identico ao FSZ1PosValid
original. Reprova quando um campo obrigatorio (aObrigatorios) chega
vazio.
@param  p_oField   Objeto do campo (FormField) que disparou a validacao
@param  p_sAcao    Acao/evento que disparou a validacao
@param  p_sCampo   Nome do campo (SX3) sendo validado
@param  p_vValor   Valor atual do campo
@return l_bOk      .T. se valido, .F. se o campo obrigatorio estiver vazio
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_VALIDACAMPO(p_oField, p_sAcao, p_sCampo, p_vValor)
    Local l_bOk := .T.
    // Z1_USR (Representante) nao e mais obrigatorio - saiu da tela do portal e
    // vem do contato do cliente (A1_CONTATO), que pode estar vazio.
    // Z1_SERV (Descricao) tambem nao - OS sem chamado usa ela pra interacao.
    // Z1_TEC (Analista) tambem nao - OS pode ser criada sem tecnico.
    Local aObrigatorios := {"Z1_CLI", "Z1_LOJA", "Z1_MODULO", "Z1_MOTIV", ;
        "Z1_TIPO", "Z1_DTOS", "Z1_INI", "Z1_FIM", "Z1_TOTAL"}

    If AScan(aObrigatorios, p_sCampo) > 0 .And. Empty(p_vValor)
        l_bOk := .F.
    EndIf

Return l_bOk

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_PREVALIDA
Pre-validacao do Model (PreValidacao) - na inclusao (operacao 3),
confere se cliente/site, usuario, modulo, motivo, descricao e data da
OS estao preenchidos, reportando via SetErrorMessage (canal correto do
Model) em vez do antigo Return{.F.,"..."} ad-hoc no nucleo (mesmo
padrao aplicado em CH_PREVALIDA no CNS001.TLPP).
@param  p_oModel   Objeto do Model (FormModel) sendo validado
@return l_bOk      .T. se valido, .F. se algum campo obrigatorio faltar
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_PREVALIDA(p_oModel)
    Local l_bOk     := .T.
    Local nOper     := p_oModel:GetOperation()
    Local oModelSZ1 := Nil

    If nOper == 3
        oModelSZ1 := p_oModel:GetModel("SZ1MASTER")
        If oModelSZ1 <> Nil

            If Empty(AllTrim(oModelSZ1:GetValue("Z1_CLI"))) .Or. Empty(AllTrim(oModelSZ1:GetValue("Z1_LOJA")))
                p_oModel:SetErrorMessage("SZ1MASTER", "Z1_CLI", "SZ1", "Z1_CLI", "CNSA002", "Informe o cliente e o site do cliente.")
                Return .F.
            EndIf

            // Representante (Z1_USR) nao e mais obrigatorio (ver aObrigatorios em OS_VALIDACAMPO).

            If Empty(AllTrim(oModelSZ1:GetValue("Z1_MODULO")))
                p_oModel:SetErrorMessage("SZ1MASTER", "Z1_MODULO", "SZ1", "Z1_MODULO", "CNSA002", "Informe o modulo.")
                Return .F.
            EndIf

            If Empty(AllTrim(oModelSZ1:GetValue("Z1_MOTIV")))
                p_oModel:SetErrorMessage("SZ1MASTER", "Z1_MOTIV", "SZ1", "Z1_MOTIV", "CNSA002", "Informe o motivo.")
                Return .F.
            EndIf

            // Descricao (Z1_SERV) nao e mais obrigatoria (ver aObrigatorios em OS_VALIDACAMPO).

            If Empty(AllTrim(oModelSZ1:GetValue("Z1_TIPO")))
                p_oModel:SetErrorMessage("SZ1MASTER", "Z1_TIPO", "SZ1", "Z1_TIPO", "CNSA002", "Informe o codigo do servico.")
                Return .F.
            EndIf

            If Empty(oModelSZ1:GetValue("Z1_DTOS"))
                p_oModel:SetErrorMessage("SZ1MASTER", "Z1_DTOS", "SZ1", "Z1_DTOS", "CNSA002", "Informe a data da OS.")
                Return .F.
            EndIf

        EndIf
    EndIf

Return l_bOk

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_VALIDACOBRAR
Pos-validacao (Incluir/Alterar, tela e REST): se o agendamento da OS esta
marcado como "Nao Cobrar" (Z6_COBRAR, ver OS_AGENDANAOCOBRA), o Cod Servico
(Z1_TIPO) tem que ser de hora NAO cobravel - grupo do produto com
BM_TIPGRU = "2". Senao recusa com mensagem.
@param  p_oModel   Objeto do Model
@return lOk        .T. se pode gravar
@author Henrique
@since 05/10/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_VALIDACOBRAR(p_oModel)
    Local nOper     := p_oModel:GetOperation()
    Local oModelSZ1 := Nil
    Local cTipo     := ""
    Local cGrupo    := ""
    Local cTipGru   := ""

    If nOper != 3 .And. nOper != 4
        Return .T.
    EndIf

    oModelSZ1 := p_oModel:GetModel("SZ1MASTER")
    If oModelSZ1 == Nil
        Return .T.
    EndIf

    cTipo := AllTrim(oModelSZ1:GetValue("Z1_TIPO"))
    If Empty(cTipo)
        Return .T.
    EndIf

    If !OS_AGENDANAOCOBRA(oModelSZ1:GetValue("Z1_TEC"), oModelSZ1:GetValue("Z1_CLI"), oModelSZ1:GetValue("Z1_LOJA"), ;
            DToS(oModelSZ1:GetValue("Z1_DTOS")), oModelSZ1:GetValue("Z1_HRINI"), oModelSZ1:GetValue("Z1_HRFIM"))
        Return .T.
    EndIf

    cGrupo  := Posicione("SB1", 1, xFilial("SB1") + cTipo, "B1_GRUPO")
    cTipGru := AllTrim(Posicione("SBM", 1, xFilial("SBM") + cGrupo, "BM_TIPGRU"))
    If cTipGru != "2"
        p_oModel:SetErrorMessage("SZ1MASTER", "Z1_TIPO", "SZ1", "Z1_TIPO", "CNSA002", ;
            "O agendamento desta OS esta marcado como Nao Cobrar - o Cod Servico precisa ser de hora nao cobravel.", ;
            "Escolha um servico nao cobravel (grupo com tipo 2).")
        Return .F.
    EndIf

Return .T.

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_AGENDANAOCOBRA
Diz se o agendamento (SZ6) que corresponde a uma OS esta marcado como
"Nao Cobrar" (Z6_COBRAR = "NAO"). Casa OS x agendamento pelo mesmo criterio
do Z6_TEMOS / localizarPorAgendamento do portal: tecnico + cliente (+ loja,
se informada) + data + horario inicial e final com tolerancia de 15 min.
Mesma regra de CNS001_AGENDANAOCOBRA (cnslib.tlpp, lupa de Cod Servico).
@param  cTec     Tecnico (AA1_CODTEC)
@param  cCli     Cliente (A1_COD)
@param  cLoja    Loja do cliente (vazia = qualquer loja)
@param  cData    Data AAAAMMDD
@param  cHrIni   Hora inicial (HH:MM ou HHMM)
@param  cHrFim   Hora final (HH:MM ou HHMM)
@return lNaoCob  .T. se achou agendamento correspondente com Z6_COBRAR = "NAO"
@author Henrique
@since 05/10/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_AGENDANAOCOBRA(cTec, cCli, cLoja, cData, cHrIni, cHrFim)
    Local cAlias  := ""
    Local lNaoCob := .F.
    Local nIni    := 0
    Local nFim    := 0

    cTec   := AllTrim(cTec)
    cCli   := AllTrim(cCli)
    cLoja  := AllTrim(cLoja)
    cData  := AllTrim(cData)
    nIni   := OS_AGENDANAOCOBRA_MIN(cHrIni)
    nFim   := OS_AGENDANAOCOBRA_MIN(cHrFim)

    If Empty(cTec) .Or. Empty(cCli) .Or. Len(cData) != 8 .Or. nIni < 0 .Or. nFim < 0
        Return .F.
    EndIf

    cAlias := GetNextAlias()
    BeginSql Alias cAlias
        SELECT Z6_LOJA, Z6_HMINI, Z6_HMFIM, Z6_COBRAR
        FROM %Table:SZ6% SZ6
        WHERE Z6_FILIAL  = %xFilial:SZ6%
          AND Z6_TECNICO = %Exp:cTec%
          AND Z6_CLIENTE = %Exp:cCli%
          AND Z6_DTAGE   = %Exp:cData%
          AND %NotDel%
    EndSql
    While !(cAlias)->(Eof())
        If (Empty(cLoja) .Or. Empty(AllTrim((cAlias)->Z6_LOJA)) .Or. AllTrim((cAlias)->Z6_LOJA) == cLoja) .And. ;
                Abs(OS_AGENDANAOCOBRA_MIN((cAlias)->Z6_HMINI) - nIni) <= 15 .And. ;
                Abs(OS_AGENDANAOCOBRA_MIN((cAlias)->Z6_HMFIM) - nFim) <= 15
            If Upper(AllTrim((cAlias)->Z6_COBRAR)) == "NAO"
                lNaoCob := .T.
                Exit
            EndIf
        EndIf
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

Return lNaoCob

// "HH:MM"/"HHMM" -> minutos do dia (-1 se invalido)
Static Function OS_AGENDANAOCOBRA_MIN(cHora)
    Local cDig := ""
    Local nI   := 0

    cHora := AllTrim(cHora)
    For nI := 1 To Len(cHora)
        If IsDigit(SubStr(cHora, nI, 1))
            cDig += SubStr(cHora, nI, 1)
        EndIf
    Next nI
    If Len(cDig) < 3
        Return -1
    EndIf
    cDig := PadL(cDig, 4, "0")

Return Val(Left(cDig, 2)) * 60 + Val(SubStr(cDig, 3, 2))

//-------------------------------------------------------------------
/*/{Protheus.doc} OS_VALIDACANCELA
Validacao de cancelamento do Model - sempre permite cancelar (nao ha
regra de bloqueio de cancelamento na tela CNS002).
@param  p_oModel   Objeto do Model (FormModel) sendo cancelado
@return lOk        Sempre .T.
@author Henrique
@since 02/09/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function OS_VALIDACANCELA(p_oModel)
Return .T.

