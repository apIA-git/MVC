/*/{Protheus.doc} CNS001
Ponto de entrada da tela de Chamados (Browse). Processa a caixa de e-mail
apia@apia.com.br em busca de chamados novos (CH_CRIARCHAMADOEMAIL) e
ativa o Browse de Registro de Chamados (ZA1).
Browse principal - ponto de entrada da tela.
@author Henrique
@since 02/09/2026
@version P12
/*/
User Function CNS001()

    Local l_oBrowse := Nil
    Local nCriados  := 0
    Private aRotina := u_MenuDef()
    Private cConsultor := " "

    cConsultor := Posicione("AA1",4,xFilial("AA1")+__cUserId,"AA1_CODTEC")

    nCriados := CH_CRIARCHAMADOEMAIL()
    If nCriados < 0
        MsgAlert("Nao foi possivel verificar a caixa apia@apia.com.br no momento.", "E-mails")
    ElseIf nCriados == 0
        MsgInfo("Sem e-mails novos em apia@apia.com.br.", "E-mails")
    Else
        MsgAlert("Foram abertos " + cValToChar(nCriados) + " chamado(s) a partir de e-mail(s) novo(s).", "Novos Chamados")
    EndIf

    l_oBrowse := FWMBrowse():New()
    If l_oBrowse <> Nil

        l_oBrowse:SetDescription("Registro de Chamados - OS")
        l_oBrowse:SetAlias("ZA1")

        // Mesmas cores do portal (shared/paleta-status.ts): azul=aberto,
        // amarelo=aguardando, rosa=pendencia, verde=concluido, cinza=incompleto.
        l_oBrowse:AddLegend( "ZA1->ZA1_STATUS == '1'", "BLUE",   "Aberto" )
        l_oBrowse:AddLegend( "ZA1->ZA1_STATUS == '2'", "YELLOW", "Pendente Apia" )
        l_oBrowse:AddLegend( "ZA1->ZA1_STATUS == '3'", "PINK",   "Pendente Cli." )
        l_oBrowse:AddLegend( "ZA1->ZA1_STATUS == '4'", "GREEN",  "Fechado" )
        l_oBrowse:AddLegend( "ZA1->ZA1_STATUS == '5'", "GRAY",   "Incompleto" )
        l_oBrowse:Activate()

    EndIf

Return

/*/{Protheus.doc} MenuDef
Monta o menu de opcoes (aRotina) da tela de Chamados.
Reusa direto as rotinas antigas que nao mudam de mecanismo.
@return aRotina   Array de opcoes do menu
@author Henrique
@since 02/09/2026
@version P12
/*/
User Function MenuDef()

    Local aRotina := {}

    ADD OPTION aRotina TITLE "Pesquisar"        ACTION "AxPesqui"                            OPERATION 1 ACCESS 0
    ADD OPTION aRotina TITLE "Visualizar"       ACTION "apia.cnsa001.U_CH_VISUALIZARTELA"    OPERATION 2 ACCESS 0
    ADD OPTION aRotina TITLE "Incluir"          ACTION "apia.cnsa001.U_CH_INCLUIRTELA"       OPERATION 3 ACCESS 0
    ADD OPTION aRotina TITLE "Alterar"          ACTION "apia.cnsa001.U_CH_ALTERARTELA"       OPERATION 4 ACCESS 0
    ADD OPTION aRotina TITLE "Excluir"          ACTION "apia.cnsa001.U_CH_EXCLUIRTELA"       OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Ver Agendas"      ACTION "apia.cnsa001.U_PROTHEUS_ABREAGENDA"  OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Agendar"          ACTION "apia.cnsa001.U_CNSA_CRIAAGENDA"      OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Assumir"          ACTION "apia.cnsa001.U_CH_ASSUMIRTELA"       OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Interação"        ACTION "apia.cnsa001.U_CNSA_INTERAGIR"       OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Excluir Interacao" ACTION "apia.cnsa001.U_CH_EXCLUIRINTERACAOTELA"   OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Legenda"          ACTION "apia.cnsa001.U_CNSA_LEG"             OPERATION 0 ACCESS 0

Return aRotina

/*/{Protheus.doc} ViewDef
Monta a View (FWFormView) da tela de Chamados, com o campo mestre ZA1 e
os grids de Interacoes (ZA2) e Agendamento (SZ6).
Identico ao CNSA001.PRW, so troca o modelo carregado por "CNS001".
@return l_oView   Objeto FWFormView montado, ou Nil se o Model nao carregou
@author Henrique
@since 02/09/2026
@version P12
/*/
User Function ViewDef()

    Local l_oView    := Nil
    Local l_oModel   := FWModelActive()
    Local l_oStruZA1 := FWFormStruct(2, "ZA1")
    Local l_oStruZA2 := FWFormStruct(2, "ZA2")
    Local l_oStruSZ6 := FWFormStruct(2, "SZ6")

    l_oView := FWFormView():New()
    l_oView:SetModel(l_oModel)

    l_oView:AddField("VIEW_ZA1", l_oStruZA1, "ZA1MASTER")
    l_oView:AddGrid("VIEW_ZA2",  l_oStruZA2, "ZA2DETAIL")
    l_oView:AddGrid("VIEW_SZ6",  l_oStruSZ6, "SZ6DETAIL")

    l_oView:CreateHorizontalBox("CABEC",  70)
    l_oView:CreateHorizontalBox("ABAIXO", 30)

    l_oView:CreateVerticalBox("GRID",    50, "ABAIXO")
    l_oView:CreateVerticalBox("GRIDAGE", 50, "ABAIXO")

    l_oView:SetOwnerView("VIEW_ZA1", "CABEC")
    l_oView:SetOwnerView("VIEW_ZA2", "GRID")
    l_oView:SetOwnerView("VIEW_SZ6", "GRIDAGE")

    l_oView:EnableTitleView("VIEW_ZA1", "Dados do Chamado")
    l_oView:EnableTitleView("VIEW_ZA2", "Interacoes")
    l_oView:EnableTitleView("VIEW_SZ6", "Agendamento")

    l_oView:SetCloseOnOk({||.T.})

Return l_oView

/*/{Protheus.doc} ModelDef
Monta o Model (MPFormModel) da tela de Chamados, com o mestre ZA1MASTER e
os grids ZA2DETAIL (interacoes) e SZ6DETAIL (agendamento).
Identica ao CNSA001.PRW (mesmas tabelas/relacoes)
@return l_oModel   Objeto MPFormModel montado
@author Henrique
@since 02/09/2026
@version P12
@update 09/09/2026 - ZA2DETAIL/SZ6DETAIL viraram SetOptional (evita EMPTYFORM no VldData em Job Thread/REST, sem uso obrigatorio real hoje)
@update 14/09/2026 - Unificado com o extinto CH_MODELINSERT (ver comentario em CH_MONTARMODEL)
/*/
User Function ModelDef()

Return CH_MONTARMODEL()

Static Function CH_MONTARMODEL(lAtivarInsert)
    Local l_oModel  := Nil
    Local l_oStrZA1 := FWFormStruct(1, "ZA1")
    Local l_oStrZA2 := FWFormStruct(1, "ZA2")
    Local l_oStrSZ6 := FWFormStruct(1, "SZ6")
    Local aRelZA2   := {}
    Local aRelSZ6   := {}
    
    Local oGridSZ6  := Nil

    Default lAtivarInsert := .F.
    l_oStrZA1:SetProperty("ZA1_CLIENT", MODEL_FIELD_OBRIGAT, .F.)
    l_oStrZA1:SetProperty("ZA1_LOJA",   MODEL_FIELD_OBRIGAT, .F.)
    l_oStrZA1:SetProperty("ZA1_CONSUL", MODEL_FIELD_OBRIGAT, .F.)

    l_oModel := MPFormModel():New(;
        "FCNS001",;
        {|oModel| CH_PREVALIDA(oModel)},;
        {|oModel| CH_POSGRAVACAO(oModel)},;
        NIL,;
        {|oModel| CH_VALIDACANCELA(oModel)})

    l_oModel:AddFields(;
        "ZA1MASTER",;
        NIL,;
        l_oStrZA1,;
        {|_f,_a,_c,_v| CH_VALIDACAMPO(_f,_a,_c,_v)},;
        NIL)

    l_oModel:AddGrid("ZA2DETAIL", "ZA1MASTER", l_oStrZA2)
    aAdd(aRelZA2, {"ZA2_IDCH", "ZA1_IDCH"})
    l_oModel:SetRelation("ZA2DETAIL", aRelZA2, ZA2->(IndexKey(1)))
    l_oModel:GetModel("ZA2DETAIL"):SetOptional(.T.)

    l_oModel:AddGrid("SZ6DETAIL", "ZA1MASTER", l_oStrSZ6)
    aAdd(aRelSZ6, {"Z6_CHAMADO", "Val(ZA1->ZA1_IDCH)"})
    l_oModel:SetRelation("SZ6DETAIL", aRelSZ6, SZ6->(IndexKey(2)))

    oGridSZ6 := l_oModel:GetModel("SZ6DETAIL")
    If oGridSZ6 <> Nil
        oGridSZ6:SetNoInsertLine(.T.)
        oGridSZ6:SetNoDeleteLine(.T.)
        oGridSZ6:SetNoUpdateLine(.T.)
        oGridSZ6:SetOptional(.T.)
    EndIf

    l_oModel:SetPrimaryKey({"ZA1_FILIAL","ZA1_IDCH"})

    If lAtivarInsert
        l_oModel:SetOperation(MODEL_OPERATION_INSERT)
        l_oModel:Activate()
    EndIf

Return l_oModel



/*/{Protheus.doc} CH_VALIDACAMPO
Validacao de campo do Model (stub) - sempre retorna .T., sem regra de
campo implementada.
@param  p_oModel   Model da tela de Chamados
@param  p_sAcao    Acao disparada (Get/Set/etc)
@param  p_sCampo   Nome do campo validado
@param  p_vValor   Valor do campo
@return l_bOk      Sempre .T.
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_VALIDACAMPO(p_oModel, p_sAcao, p_sCampo, p_vValor)
    Local l_bOk := .T.
Return l_bOk


/*/{Protheus.doc} CH_PREVALIDA
Pre-validacao do Model (Incluir/Alterar): exige assunto/tipo/projeto/
tarefa na Inclusao, bloqueia Alterar sem grupo de acesso ou em chamado
fechado, e valida a elegibilidade especifica do fluxo Assumir (gatilho
lCnsaAssumindo) via SetErrorMessage.
@param  p_oModel   Model da tela de Chamados
@return l_bOk      .T. se pode prosseguir, .F. se bloqueado (erro setado via SetErrorMessage)
@author Henrique
@since 02/09/2026
@version P12
@update 17/09/2026 - Chamado fechado libera Alterar quando e troca explicita de status via CH_NUCLEOALTERAR (lCnsaAlterandoStatus, restrita a admin)
/*/
Static Function CH_PREVALIDA(p_oModel)
    Local l_bOk  := .T.
    Local nOper  := p_oModel:GetOperation()
    Local oModelZA1 := Nil

   
    If nOper == 3
        oModelZA1 := p_oModel:GetModel("ZA1MASTER")
        If oModelZA1 <> Nil

            If Empty(AllTrim(oModelZA1:GetValue("ZA1_ASSUNT")))
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_ASSUNT", "ZA1", "ZA1_ASSUNT", "Informe o assunto do chamado.")
                Return .F.
            EndIf

            If !(Type("lCnsaIncluirIncompleto") == "L" .And. lCnsaIncluirIncompleto)

                If Empty(AllTrim(oModelZA1:GetValue("ZA1_TIPO")))
                    p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_TIPO", "ZA1", "ZA1_TIPO", "Informe o tipo do chamado.")
                    Return .F.
                EndIf

                If Empty(AllTrim(oModelZA1:GetValue("ZA1_PROJ")))
                    p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_PROJ", "ZA1", "ZA1_PROJ", "Informe o projeto.")
                    Return .F.
                EndIf

                If Empty(AllTrim(oModelZA1:GetValue("ZA1_TAREFA")))
                    p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_TAREFA", "ZA1", "ZA1_TAREFA", "Informe a tarefa.")
                    Return .F.
                EndIf

            EndIf
        EndIf
    EndIf

    If nOper == 4 .And. !CH_TEMACESSOGRUPO()
        p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_STATUS", "ZA1", "ZA1_STATUS", "Voce nao tem permissao para alterar chamados. Utilize a opcao Interagir.")
        Return .F.
    EndIf

    If nOper == 4
        oModelZA1 := p_oModel:GetModel("ZA1MASTER")

        // Chamado fechado normalmente bloqueia qualquer Alterar - excecao:
        // troca de status pedida explicitamente via CH_NUCLEOALTERAR
        // (lCnsaAlterandoStatus), ja restrita a admin (CH_TEMACESSOGRUPO) la
        // na origem - admin pode reabrir/fechar manualmente mesmo com o
        // chamado ja fechado.
        If oModelZA1 <> Nil .And. AllTrim(oModelZA1:GetValue("ZA1_STATUS")) == "4" .And. ;
            !(Type("lCnsaAlterandoStatus") == "L" .And. lCnsaAlterandoStatus)
            p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_STATUS", "ZA1", "ZA1_STATUS", "Chamado fechado nao pode ser alterado.")
            Return .F.
        EndIf


        If Type("lCnsaAssumindo") == "L" .And. lCnsaAssumindo .And. oModelZA1 <> Nil

            If !Empty(cAssumirConsulAnt)
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_CONSUL", "ZA1", "ZA1_CONSUL", "Este chamado ja esta atribuido. Para redesignar use a opcao Alterar.")
                Return .F.
            EndIf

            If cAssumirStatusAnt == "4"
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_STATUS", "ZA1", "ZA1_STATUS", "Chamado fechado nao pode ser assumido.")
                Return .F.
            EndIf

            If cAssumirStatusAnt == "2" .Or. cAssumirStatusAnt == "3"
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_STATUS", "ZA1", "ZA1_STATUS", "Chamado pendente nao pode ser assumido.")
                Return .F.
            EndIf

            If Empty(AllTrim(oModelZA1:GetValue("ZA1_PROJ")))
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_PROJ", "ZA1", "ZA1_PROJ", "O chamado precisa ter um projeto definido antes de ser assumido.")
                Return .F.
            EndIf

            If AllTrim(Posicione("AF8", 1, xFilial("AF8") + AllTrim(oModelZA1:GetValue("ZA1_PROJ")), "AF8_FASE")) <> "03"
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_PROJ", "ZA1", "ZA1_PROJ", "O chamado so pode ser assumido com projeto em execucao (fase 03).")
                Return .F.
            EndIf

            If Empty(AllTrim(oModelZA1:GetValue("ZA1_TAREFA")))
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_TAREFA", "ZA1", "ZA1_TAREFA", "O chamado precisa ter uma tarefa definida antes de ser assumido.")
                Return .F.
            EndIf

        EndIf
    EndIf

    If Type("cConsulAnterior") <> "C"
        Public cConsulAnterior  := ""
    EndIf
    If Type("cMotivoExclusao") <> "C"
        Public cMotivoExclusao  := ""
    EndIf
    If Type("lExclusaoConfirm") <> "L"
        Public lExclusaoConfirm := .F.
    EndIf
    If Type("cIdChAnterior") <> "C"
        Public cIdChAnterior    := ""
    EndIf
    If Type("cClienteAnterior") <> "C"
        Public cClienteAnterior := ""
    EndIf
    If Type("cLojaAnterior") <> "C"
        Public cLojaAnterior    := ""
    EndIf
    // Snapshot pre-commit dos demais campos rastreados pro e-mail de
    // "alteracao" ao cliente (CH_NOTIFICARALTERACAO, ver CH_POSGRAVACAO) -
    // mesmo truque do cConsulAnterior: ZA1-> ainda reflete o valor em disco
    // aqui, antes do CommitData.
    If Type("cStatusAnteriorAlt") <> "C"
        Public cStatusAnteriorAlt  := ""
    EndIf
    If Type("cAssuntoAnterior") <> "C"
        Public cAssuntoAnterior := ""
    EndIf
    If Type("cTipoAnterior") <> "C"
        Public cTipoAnterior    := ""
    EndIf
    If Type("cProjAnterior") <> "C"
        Public cProjAnterior    := ""
    EndIf
    If Type("cTarefaAnterior") <> "C"
        Public cTarefaAnterior  := ""
    EndIf
    If Type("cDataAnterior") <> "C"
        Public cDataAnterior    := ""
    EndIf

    If (nOper == 4)
        cConsulAnterior  := AllTrim(ZA1->ZA1_CONSUL)
        cIdChAnterior    := AllTrim(ZA1->ZA1_IDCH)
        cClienteAnterior := AllTrim(ZA1->ZA1_CLIENT)
        cLojaAnterior    := AllTrim(ZA1->ZA1_LOJA)
        cStatusAnteriorAlt := AllTrim(ZA1->ZA1_STATUS)
        cAssuntoAnterior := AllTrim(ZA1->ZA1_ASSUNT)
        cTipoAnterior    := AllTrim(ZA1->ZA1_TIPO)
        cProjAnterior    := AllTrim(ZA1->ZA1_PROJ)
        cTarefaAnterior  := AllTrim(ZA1->ZA1_TAREFA)
        cDataAnterior    := If(ValType(ZA1->ZA1_DATA) == "D", DToC(ZA1->ZA1_DATA), AllTrim(ZA1->ZA1_DATA))
    EndIf

Return l_bOk

/*/{Protheus.doc} CH_VALIDACANCELA
Validacao de cancelamento do Model (stub) - sempre retorna .T., exclusao
real e feita fora do Model, em CH_NUCLEOEXCLUIR.
Fica stub (.T.) de proposito: exclusao "de verdade" via MODEL_OPERATION_DELETE foi avaliada e descartada (cascata automatica do Model sobre os grids filhos nao e confirmada). Exclusao real fica em CH_NUCLEOEXCLUIR (chamada por tela e REST), fora do ciclo do Model.
@param  p_oModel   Model da tela de Chamados
@return .T. sempre
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_VALIDACANCELA(p_oModel)
Return .T.

/*/{Protheus.doc} CH_POSGRAVACAO
Pos-gravacao do Model: em Alterar (nOper==4), notifica por e-mail o
tecnico removido (quando substituido) e o novo tecnico designado. Em
Incluir/Alterar com tecnico definido, oferece (ou cria automaticamente via
REST) uma agenda para o chamado.
Pos-commit portado de CNSA_APOSCOMMIT - flag lCnsaViaRest pula o MsgYesNo quando a chamada vem do REST (responde "sim" automatico).
@param  p_oModel   Model da tela de Chamados
@return .T. sempre
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_POSGRAVACAO(p_oModel)
    Local nOper       := p_oModel:GetOperation()
    Local lViaRest    := (Type("lCnsaViaRest") == "L" .And. lCnsaViaRest)
    Local cConsulNovo := ""
    Local cNomeAnt    := ""
    Local cEmailAnt   := ""
    Local cCliente    := ""
    Local cIdCh       := ""
    Local cAssunto    := ""
    Local cExclPor    := ""
    Local cDataAge    := DToC(Date())
    Local cHmini      := ""
    Local cHmfim      := ""
    Local cCorpo      := ""
    Local cAlias      := GetNextAlias()
    Local nCham       := 0
    Local cClienteAp  := ""
    Local cLojaAp     := ""
    Local cProjAp     := ""
    Local cTarefaAp   := ""
    Local cTecnicoAp  := ""
    Local nQtdAgenda  := 0
    Local cPergAgenda := ""
    Local cHoraAtual  := ""
    Local cHoraFim    := ""
    Local cEmailCli   := ""
    Local cStatusNovo := ""
    Local cTipoNovo   := ""
    Local cProjNovo   := ""
    Local cTarefaNovo := ""
    Local cDataNovo   := ""
    Local aMudancas   := {}
    Local lNotificarCliente := .F.
    Local lNotificarTecnico := .T.

    If Type("cConsulAnterior") <> "C"
        Public cConsulAnterior := ""
    EndIf
    If Type("lCnsaNotificarCliente") <> "L"
        Public lCnsaNotificarCliente := .F.
    EndIf

    cExclPor := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_NOMTEC"))

    If nOper == 4

        cConsulNovo := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_CONSUL"))
        cIdCh       := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_IDCH"))
        cCliente    := AllTrim(Posicione("SA1",1,xFilial("SA1")+;
                            AllTrim(p_oModel:GetValue("ZA1MASTER","ZA1_CLIENT"))+;
                            AllTrim(p_oModel:GetValue("ZA1MASTER","ZA1_LOJA")),"A1_NREDUZ"))
        cAssunto    := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_ASSUNT"))
        cEmailCli   := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_EMAIL"))
        cStatusNovo := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_STATUS"))
        cTipoNovo   := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_TIPO"))
        cProjNovo   := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_PROJ"))
        cTarefaNovo := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_TAREFA"))
        cDataNovo   := If(ValType(p_oModel:GetValue("ZA1MASTER", "ZA1_DATA")) == "D", ;
                            DToC(p_oModel:GetValue("ZA1MASTER", "ZA1_DATA")), ;
                            AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_DATA")))
        nCham       := Val(cIdCh)

        BeginSql Alias cAlias
            SELECT Z6_DTAGE, Z6_HMINI, Z6_HMFIM
            FROM %Table:SZ6% SZ6
            WHERE Z6_FILIAL  = %xFilial:SZ6%
              AND Z6_CHAMADO = %Exp:nCham%
              AND %NotDel%
        EndSql
        If !(cAlias)->(Eof())
            If ValType((cAlias)->Z6_DTAGE) == "D"
                cDataAge := DToC((cAlias)->Z6_DTAGE)
            Else
                cDataAge := AllTrim((cAlias)->Z6_DTAGE)
                If Len(cDataAge) == 8
                    cDataAge := SubStr(cDataAge,7,2)+"/"+SubStr(cDataAge,5,2)+"/"+SubStr(cDataAge,1,4)
                EndIf
            EndIf
            cHmini := AllTrim((cAlias)->Z6_HMINI)
            cHmfim := AllTrim((cAlias)->Z6_HMFIM)
        EndIf
        (cAlias)->(DbCloseArea())

        If Empty(cHmini) ; cHmini := "00:00" ; EndIf
        If Empty(cHmfim) ; cHmfim := "00:00" ; EndIf

        // Monta a lista de campos que mudaram (De/Para) pro e-mail generico
        // de alteracao (CH_NOTIFICARALTERACAO) - tecnico fica de fora daqui,
        // ja tem e-mail proprio mais detalhado (CH_NOTIFICARDESIGNA) logo
        // abaixo. Comparado contra o snapshot pre-commit (CH_PREVALIDA).
        // Status tambem fica de fora quando a mudanca veio do Assumir
        // (lCnsaAssumindo) - o proprio e-mail de designacao ja avisa que o
        // chamado esta em atendimento, sem precisar duplicar com o e-mail
        // generico de alteracao so por causa do status ter ido junto.
        If Type("cStatusAnteriorAlt") == "C" .And. cStatusAnteriorAlt <> cStatusNovo .And. ;
            !(Type("lCnsaAssumindo") == "L" .And. lCnsaAssumindo)
            AAdd(aMudancas, {"Status", CH_STATUSLABEL(cStatusAnteriorAlt), CH_STATUSLABEL(cStatusNovo)})
        EndIf
        If Type("cAssuntoAnterior") == "C" .And. cAssuntoAnterior <> cAssunto
            AAdd(aMudancas, {"Assunto", cAssuntoAnterior, cAssunto})
        EndIf
        If Type("cTipoAnterior") == "C" .And. cTipoAnterior <> cTipoNovo
            AAdd(aMudancas, {"Tipo", cTipoAnterior, cTipoNovo})
        EndIf
        If Type("cProjAnterior") == "C" .And. cProjAnterior <> cProjNovo
            AAdd(aMudancas, {"Projeto", cProjAnterior, cProjNovo})
        EndIf
        If Type("cTarefaAnterior") == "C" .And. cTarefaAnterior <> cTarefaNovo
            AAdd(aMudancas, {"Tarefa", cTarefaAnterior, cTarefaNovo})
        EndIf
        If Type("cDataAnterior") == "C" .And. cDataAnterior <> cDataNovo
            AAdd(aMudancas, {"Data", cDataAnterior, cDataNovo})
        EndIf

        // "Deseja informar o cliente?" - tela classica pergunta na hora
        // (MsgYesNo); REST usa a decisao ja informada pelo chamador
        // (lCnsaNotificarCliente, setada em CH_NUCLEOALTERAR/CH_NUCLEOASSUMIR
        // a partir do parametro "notificarCliente"). So pergunta se ha
        // mesmo alguma mudanca relevante (campo ou tecnico) e cliente tem
        // e-mail cadastrado.
        If !Empty(cEmailCli) .And. (Len(aMudancas) > 0 .Or. (!Empty(cConsulNovo) .And. cConsulNovo <> cConsulAnterior))
            If lViaRest
                lNotificarCliente := lCnsaNotificarCliente
            Else
                lNotificarCliente := MsgYesNo("Deseja informar o cliente sobre esta alteracao?", "Notificar Cliente")
            EndIf
        EndIf

        // "Enviar e-mail ao analista?" - mesma regra do cliente: tela classica
        // pergunta, REST usa lCnsaNotificarTecnico (parametro notificarTecnico,
        // default envia). Vale pro e-mail de Remocao (analista anterior) e de
        // Designacao (analista novo).
        If cConsulNovo <> cConsulAnterior
            If lViaRest
                lNotificarTecnico := (Type("lCnsaNotificarTecnico") <> "L" .Or. lCnsaNotificarTecnico)
            Else
                lNotificarTecnico := MsgYesNo("Deseja enviar e-mail ao analista sobre esta designacao?", "Notificar Analista")
            EndIf
        EndIf

        If lNotificarTecnico .And. !Empty(cConsulAnterior) .And. cConsulAnterior <> cConsulNovo

            cNomeAnt  := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cConsulAnterior, "AA1_NOMTEC"))
            cEmailAnt := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cConsulAnterior, "AA1_EMAIL"))

            cCorpo := CH_HTMLCANCELA(cCliente, cDataAge, cHmini, cHmfim, ;
                        cIdCh, "Tecnico substituido no chamado", cExclPor)

            CH_ENVIAREMAIL(cEmailAnt, ;
                "Remocao do Chamado " + cIdCh, ;
                cCorpo, ;
                "apia@apia.com.br")

        EndIf

        If !Empty(cConsulNovo) .And. cConsulNovo <> cConsulAnterior
            CH_NOTIFICARDESIGNA(cIdCh, cConsulNovo, lNotificarCliente, lNotificarTecnico)
        EndIf

        If lNotificarCliente .And. Len(aMudancas) > 0
            CH_NOTIFICARALTERACAO(cEmailCli, cIdCh, aMudancas)
        EndIf
    EndIf

    If nOper == 3 .Or. nOper == 4
        cIdCh      := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_IDCH"))
        cTecnicoAp := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_CONSUL"))

        If !Empty(cTecnicoAp)

            nCham := Val(cIdCh)

            nQtdAgenda := 0
            BeginSql Alias cAlias
                SELECT COUNT(*) AS QTD
                FROM %Table:SZ6% SZ6
                WHERE Z6_FILIAL  = %xFilial:SZ6%
                  AND Z6_CHAMADO = %Exp:nCham%
                  AND %NotDel%
            EndSql
            If !(cAlias)->(Eof())
                nQtdAgenda := (cAlias)->QTD
            EndIf
            (cAlias)->(DbCloseArea())

            cPergAgenda := IIf(nQtdAgenda == 0, ;
                "Este chamado nao possui agendamento. Deseja criar uma agenda para ele agora?", ;
                "Este chamado ja possui " + cValToChar(nQtdAgenda) + " agendamento(s). Deseja criar mais um agora?")

            If lViaRest .Or. MsgYesNo(cPergAgenda, "Agendar Chamado")

                cClienteAp := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_CLIENT"))
                cLojaAp    := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_LOJA"))
                cAssunto   := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_ASSUNT"))
                cProjAp    := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_PROJ"))
                cTarefaAp  := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_TAREFA"))

                cHoraAtual := Left(Time(), 5)
                cHoraFim   := StrZero(Val(Left(cHoraAtual, 2)) + 1, 2) + ":" + Right(cHoraAtual, 2)
                If Val(Left(cHoraFim, 2)) >= 24
                    cHoraFim := "23:59"
                EndIf

                U_CH_CRIARAGENDATELA(cTecnicoAp, Date(), cHoraAtual, cHoraFim, ;
                    cClienteAp, cLojaAp, cAssunto, cProjAp, cTarefaAp, cIdCh, lViaRest)
            EndIf
        EndIf
    EndIf

Return .T.

/*/{Protheus.doc} CH_TEMACESSOGRUPO
Verifica se o tecnico (AA1) vinculado ao usuario logado e responsavel pela
manutencao (AA1_RSPMNT == "1") - regra de administrador que substituiu a
antiga checagem de grupo (MV_CNSAGRP).
Regra trocada de grupo (MV_CNSAGRP) pra AA1_RSPMNT - pedido do usuario (responsavel pela manutencao vira admin, nao mais quem esta num grupo especifico). Nome da funcao mantido (chamada em 3 lugares neste fonte).
@return .T. se o tecnico e responsavel (AA1_RSPMNT == "1"), .F. caso contrario
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_TEMACESSOGRUPO()
    Local cRspMnt := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_RSPMNT"))

Return cRspMnt == "1"

/*/{Protheus.doc} CH_ALTERARTELA
Opcao de menu "Alterar" da tela classica: abre a View de edicao completa
se o usuario tem acesso de grupo, senao redireciona para Interagir
(CNSA_INTERAGIR).
Alterar - gate de grupo (identico a CNSA_ALT, so aponta pra VIEWDEF001.CNS001)
@author Henrique
@since 02/09/2026
@version P12
/*/
User Function CH_ALTERARTELA()

    If CH_TEMACESSOGRUPO()
        // Identificador e so o namespace (sem sufixo) - ModelDef/ViewDef sao
        // bare dentro do Namespace (doc oficial TOTVS).
        FWExecView("Registro de Chamados", "apia.cnsa001.u_cns001", 4)
        Return
    EndIf

    CNSA_INTERAGIR()

Return

/*/{Protheus.doc} CH_VISUALIZARTELA
Opcao de menu "Visualizar" da tela classica: abre a View em modo consulta.
Visualizar/Incluir - ACTION "VIEWDEF.CNSA001" nao dispara nada dentro do Namespace (confirmado via debug: zero log ao clicar). Troca pro mesmo caminho FWExecView que ja funciona em CH_ALTERARTELA (comprovado por log).
@author Henrique
@since 14/09/2026
@version P12
/*/
User Function CH_VISUALIZARTELA()
    // MODEL_OPERATION_VIEW e 1, nao 2 - "2" e so o codigo do botao no ADD
    // OPTION (Browse), FWFormModel:SetOperation so aceita {1,3,4,5,6}.
    FWExecView("Registro de Chamados", "apia.cnsa001.u_cns001", MODEL_OPERATION_VIEW)
Return

/*/{Protheus.doc} CH_INCLUIRTELA
Opcao de menu "Incluir" da tela classica: abre a View em modo inclusao.
@author Henrique
@since 14/09/2026
@version P12
/*/
User Function CH_INCLUIRTELA()
    Local oModel := Nil

    // Monta E ativa o Model AQUI (mesma funcao) - igual padrao ja usado em
    // CNSA_INTERAGIR/CH_MONTAAGENDA. Necessario pro Insert: FWInitCpo prende
    // o "owner private environment" ao stack frame de quem monta o model
    // (AddFields/AddGrid/SetRelation); se o framework ativa em outro frame
    // (fluxo padrao ModelDef->FWExecView), INITVALUE quebra com
    // "_SetNamedPrvt: owner private environment not found" (so no Insert,
    // Update/View carregam valor existente e nao chamam INITVALUE).
    oModel := CH_MONTARMODEL(.T.)

    FWExecView("Registro de Chamados", "apia.cnsa001.u_cns001", MODEL_OPERATION_INSERT, , {|| .T.}, NIL, NIL, NIL, NIL, NIL, NIL, oModel)
Return

/*/{Protheus.doc} GETIDGRID
Calcula a proxima sequencia de linha (nao deletada) do grid ZA2DETAIL do
Model ativo, para numerar uma nova interacao.
Funcoes movidas de CNSA001.PRW (unico fonte compilado agora). GETIDGRID/CNSA_CLIENTE/CNSA_TECNICO mantem nome exato de proposito - sao chamadas pelo dicionario (SX7/SX3), que guarda o nome como texto.
@return Sequencia formatada em 3 digitos (StrZero)
@author Henrique
@since 02/09/2026
@version P12
/*/
User Function GETIDGRID()
    Local oModel  := FWModelActive()
    Local l_oZA2  := Nil
    Local nLines  := 0
    Local nLinAtu := 0
    Local nI      := 0
    Local nSeq    := 1

    If oModel == Nil
        Return StrZero(1, 3)
    EndIf

    l_oZA2 := oModel:GetModel("ZA2DETAIL")

    If l_oZA2 == Nil
        Return StrZero(1, 3)
    EndIf

    nLines  := l_oZA2:Length()
    nLinAtu := l_oZA2:GetLine()

    For nI := 1 To nLines
        l_oZA2:GoLine(nI)
        If !l_oZA2:IsDeleted()
            nSeq++
        EndIf
    Next nI

    l_oZA2:GoLine(nLinAtu)
Return StrZero(nSeq, 3)

/*/{Protheus.doc} CNSA_LEG
Exibe a legenda de cores/status do chamado (BrwLegenda).
@author Henrique
@since 02/09/2026
@version P12
/*/
User Function CNSA_LEG()
    BrwLegenda("Legenda de Status", "Status do Chamado", ;
        { ;
            { "BR_AZUL",      "Aberto"        }, ;
            { "BR_AMARELO",   "Pendente Apia" }, ;
            { "BR_PINK",      "Pendente Cli." }, ;
            { "BR_VERDE",     "Fechado"       }, ;
            { "BR_CINZA",     "Incompleto"    }  ;
        })
Return

/*/{Protheus.doc} CNSA_CRIAAGENDA
Opcao de menu "Agendar" da tela classica: valida o chamado selecionado
(precisa ter tecnico designado) e cria uma agenda padrao (08:00-09:00,
hoje) via CH_MONTAAGENDA.
Agendar (item de menu classico) - chama o mesmo nucleo CH_MONTAAGENDA que o caminho REST usa (evita duplicar a montagem do Model CNSA003).
@author Henrique
@since 02/09/2026
@version P12
/*/
User Function CNSA_CRIAAGENDA()
    Local cIdCh    := AllTrim(ZA1->ZA1_IDCH)
    Local cTecnico := AllTrim(ZA1->ZA1_CONSUL)
    Local cCliente := AllTrim(ZA1->ZA1_CLIENT)
    Local cLoja    := AllTrim(ZA1->ZA1_LOJA)
    Local aAgenda  := {}

    If ZA1->(Eof()) .Or. ZA1->(Bof())
        MsgAlert("Nenhum chamado selecionado.", "Agendar")
        Return
    EndIf

    If Empty(cTecnico)
        MsgAlert("O chamado precisa ter um tecnico designado antes de agendar.", "Agendar")
        Return
    EndIf

    aAgenda := CH_MONTAAGENDA(cTecnico, Date(), "08:00", "09:00", ;
        cCliente, cLoja, ;
        AllTrim(ZA1->ZA1_ASSUNT), AllTrim(ZA1->ZA1_PROJ), ;
        AllTrim(ZA1->ZA1_TAREFA), cIdCh)

    If aAgenda[1] .And. MsgYesNo("Deseja enviar e-mail ao analista sobre o agendamento?", "Notificar Analista")
        CH_NOTIFICARAGENDAMENTO(cIdCh, cTecnico, DToC(aAgenda[2]), aAgenda[3], aAgenda[4], AllTrim(ZA1->ZA1_ASSUNT))
    EndIf

Return

/*/{Protheus.doc} CNSA_INTERAGIR
Opcao de menu "Interagir" da tela classica: valida o chamado selecionado
(nao fechado, com tecnico e cliente definidos, usuario com permissao) e
abre a View de inclusao de interacao (CNSAZA2VIEW).
Interagir (item de menu classico) - abre CNSAZA2VIEW (model separado, nao consolidado aqui). CNSA_NOGRUPO trocado pelo equivalente local CH_TEMACESSOGRUPO.
@author Henrique
@since 02/09/2026
@version P12
@update 17/09/2026 - Apos salvar, pergunta "deseja informar o cliente?" e envia o texto da interacao por e-mail (CNSAZA2VIEW e um Model separado, sem CH_POSGRAVACAO - checa se a interacao foi mesmo gravada via requery)
/*/
User Function CNSA_INTERAGIR()
    Local cConsul    := AllTrim(ZA1->ZA1_CONSUL)
    Local cStatus    := AllTrim(ZA1->ZA1_STATUS)
    Local cCliente   := AllTrim(ZA1->ZA1_CLIENT)
    Local cIdCh      := AllTrim(ZA1->ZA1_IDCH)
    Local cEmailCli  := AllTrim(ZA1->ZA1_EMAIL)
    Local oModel     := Nil
    Local cAlias     := GetNextAlias()
    Local nSeq       := 1
    Local cSeqGrav   := ""
    Local cTextoInteracao := ""

    If ZA1->(Eof()) .Or. ZA1->(Bof())
        MsgAlert("Nenhum chamado selecionado.", "Interagir")
        Return
    EndIf

    If cStatus == "4"
        MsgAlert("Chamado fechado nao pode receber interacoes.", "Interagir")
        Return
    EndIf

    If Empty(cConsul)
        MsgAlert("O chamado precisa ter um tecnico designado para Interagir.", "Interagir")
        Return
    EndIf

    If Empty(cCliente)
        MsgAlert("O chamado precisa ter um cliente designado para Interagir.", "Interagir")
        Return
    EndIf

    If AllTrim(cConsul) <> AllTrim(cConsultor) .And. !CH_TEMACESSOGRUPO()
        MsgAlert("Voce nao tem permissao para interagir neste chamado.", "Interagir")
        Return
    EndIf

    BeginSql Alias cAlias
        SELECT MAX(ZA2_IDGRID) AS MAXGRID
        FROM %Table:ZA2% ZA2
        WHERE ZA2_FILIAL = %xFilial:ZA2%
          AND ZA2_IDCH   = %Exp:cIdCh%
          AND %NotDel%
    EndSql

    If !(cAlias)->(Eof()) .And. !Empty(AllTrim((cAlias)->MAXGRID))
        nSeq := Val(AllTrim((cAlias)->MAXGRID)) + 1
    EndIf
    (cAlias)->(DbCloseArea())

    oModel := FWLoadModel("CNSAZA2VIEW")
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    oModel:SetValue("ZA2MASTER", "ZA2_IDCH",   cIdCh)
    oModel:SetValue("ZA2MASTER", "ZA2_CONSUL", cConsultor)
    oModel:SetValue("ZA2MASTER", "ZA2_DATA",   CToD(DToC(Date())))
    oModel:SetValue("ZA2MASTER", "ZA2_IDGRID", StrZero(nSeq, 3))

    FWExecView("Nova Interacao - Chamado " + cIdCh, ;
               "CNSAZA2VIEW", ;
               MODEL_OPERATION_INSERT, ;
               , ;
               {|| .T.}, ;
               NIL, NIL, NIL, NIL, NIL, NIL, ;
               oModel)

    oModel:DeActivate()

    // CNSAZA2VIEW e um Model separado (sem CH_POSGRAVACAO) e FWExecView nao
    // devolve se o usuario salvou ou cancelou - requery pra confirmar que a
    // interacao foi mesmo gravada antes de perguntar/notificar.
    cSeqGrav := StrZero(nSeq, 3)
    cAlias   := GetNextAlias()
    BeginSql Alias cAlias
        SELECT ZA2_DESCRI
        FROM %Table:ZA2% ZA2
        WHERE ZA2_FILIAL = %xFilial:ZA2%
          AND ZA2_IDCH   = %Exp:cIdCh%
          AND ZA2_IDGRID = %Exp:cSeqGrav%
          AND %NotDel%
    EndSql
    If !(cAlias)->(Eof())
        cTextoInteracao := CH_DECODESAFE(AllTrim((cAlias)->ZA2_DESCRI))
    EndIf
    (cAlias)->(DbCloseArea())

    If !Empty(cTextoInteracao) .And. !Empty(cEmailCli)
        If MsgYesNo("Deseja informar o cliente sobre esta interacao?", "Notificar Cliente")
            CH_NOTIFICARINTERACAO(cEmailCli, cIdCh, cTextoInteracao, "incluida", "Nova Interacao")
        EndIf
    EndIf

Return

/*/{Protheus.doc} CNSA_CLIENTE
Gatilho SX7 do campo ZA1_CLIENT: busca o nome do cliente (SA1) e grava em
ZA1_NOME no Model ativo.
Gatilho SX7 pra ZA1_CLIENT - NOME EXATO mantido (ver aviso acima).
@return cNome   Nome do cliente encontrado (ou vazio)
@author Henrique
@since 02/09/2026
@version P12
/*/
User Function CNSA_CLIENTE()
    Local oModel := FWModelActive()
    Local cCod   := ""
    Local cLoja  := ""
    Local cNome  := ""

    cCod  := AllTrim(oModel:GetValue("ZA1MASTER", "ZA1_CLIENT"))
    cLoja := AllTrim(oModel:GetValue("ZA1MASTER", "ZA1_LOJA"))

    // FIX: mesmo bug do soft-seek ja corrigido em U_CNSA_TECNICO/CH_LISTARINTERACOES -
    // Posicione("SA1",1,xFilial("SA1")+"","A1_NREDUZ") com codigo vazio cai no
    // primeiro registro da SA1 (ex.: GE CELMA) em vez de devolver vazio. So
    // aparecia na tela classica do Protheus (gatilho SX7 so dispara nela) -
    // ZA1_CLIENT no banco continuava vazio de verdade (site/REST batia certo).
    If Empty(cCod)
        cNome := ""
    Else
        cNome := Posicione("SA1", 1, xFilial("SA1") + cCod + cLoja, "A1_NREDUZ")
    EndIf

    oModel:LoadValue("ZA1MASTER", "ZA1_NOME", SubStr(cNome, 1, TamSX3("ZA1_NOME")[1]))

Return cNome

/*/{Protheus.doc} CNSA_TECNICO
Gatilho SX7 do campo ZA1_CONSUL: busca o nome do tecnico (AA1) e grava em
ZA1_NOMTEC no Model ativo.
Gatilho SX7 pra ZA1_CONSUL - NOME EXATO mantido (ver aviso acima).
@return cNome   Nome do tecnico encontrado (ou vazio)
@author Henrique
@since 02/09/2026
@version P12
/*/
User Function CNSA_TECNICO()
    Local oModel := FWModelActive()
    Local cCod   := ""
    Local cNome  := ""

    cCod  := AllTrim(oModel:GetValue("ZA1MASTER", "ZA1_CONSUL"))
    cNome := Posicione("AA1", 1, xFilial("AA1") + cCod, "AA1_NOMTEC")

    oModel:LoadValue("ZA1MASTER", "ZA1_NOMTEC", SubStr(cNome, 1, TamSX3("ZA1_NOMTEC")[1]))

Return cNome

/*/{Protheus.doc} ABREAGENDA
Opcao de menu "Ver Agendas" da tela classica: abre a rotina do model de
Agenda (CNSA003).
Ver Agendas (item de menu classico) - troca app externo "cnsaagenda" pela rotina real do model de Agenda (CNSA003, ja usada aqui em CH_MONTAAGENDA via FWLoadModel), evitando app separado.
@author Henrique
@since 02/09/2026
@version P12
/*/
User Function ABREAGENDA()
    FWLoadModel("CNSA003")
Return

User Function PROTHEUS_ABREAGENDA()
    Local oBrowse := Nil
    Local cIdCh   := AllTrim(ZA1->ZA1_IDCH)
    Private aRotina := FWMVCMenu('CNSA003')

    oBrowse := FWMBrowse():New()
    oBrowse:SetDescription("Agendas do Chamado " + cIdCh)
    oBrowse:SetAlias('SZ6')
    oBrowse:SetFilterDefault("Z6_CHAMADO == " + cValToChar(Val(cIdCh)))
    oBrowse:Activate()
Return


/*/{Protheus.doc} CH_MONTAAGENDA
Monta e grava um agendamento (SZ6) via Model CNSA003, usado tanto pela
tela classica quanto pelo caminho REST headless.
Monta e grava uma agenda (CNSA003) - usada pela tela classica e pelo REST headless.
@param  cTecnico   Codigo do tecnico (AA1)
@param  dData      Data do agendamento
@param  cHmini     Hora inicial (HH:MM)
@param  cHmfim     Hora final (HH:MM)
@param  cCliente   Codigo do cliente (SA1)
@param  cLoja      Loja do cliente
@param  cDescri    Descricao/servico do agendamento
@param  cProjeto   Codigo do projeto
@param  cTarefa    Codigo da tarefa
@param  cChamado   Id do chamado (ZA1_IDCH)
@return aRet       {lGravou, dData, cHmini, cHmfim} - valores que ficaram gravados (usuario pode mudar na tela)
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_MONTAAGENDA(cTecnico, dData, cHmini, cHmfim, ;
                                 cCliente, cLoja, cDescri, cProjeto, ;
                                 cTarefa, cChamado, lViaRest)
    Local oModel := Nil
    // FIX: original lia "cConsultor" via Private setado so pela tela classica -
    // via REST headless esse Private nunca existe. Calcula direto do usuario.
    Local cCodConsultorSessao := Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC")
    Local cNomeGravou := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cCodConsultorSessao, "AA1_NOMTEC"))
    Local lGravou     := .F.
    Local aRet        := {}

    Default lViaRest := .F.

    oModel := FWLoadModel("CNSA003")
    If oModel == Nil
        MsgAlert("Nao foi possivel carregar o modelo CNSA003.", "Agenda")
        Return {.F., dData, cHmini, cHmfim}
    EndIf

    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    // FWExecView abre janela de verdade - Job Thread/REST nao suporta
    // ("JOB threads doesn't support remote/visual components"). LoadValue
    // (nao dispara Val. Usuario/Inic. Padrao, mesmo motivo dos outros
    // nucleos REST) + VldData/CommitData direto no caminho REST.
    If lViaRest
        oModel:LoadValue("ModelSZ6_Main", "Z6_FILIAL",  xFilial("SZ6"))
        oModel:LoadValue("ModelSZ6_Main", "Z6_DTAGE",   dData)
        oModel:LoadValue("ModelSZ6_Main", "Z6_TECNICO", cTecnico)
        oModel:LoadValue("ModelSZ6_Main", "Z6_HMINI",   cHmini)
        oModel:LoadValue("ModelSZ6_Main", "Z6_HMFIM",   cHmfim)
        oModel:LoadValue("ModelSZ6_Main", "Z6_CLIENTE", cCliente)
        oModel:LoadValue("ModelSZ6_Main", "Z6_LOJA",    cLoja)
        oModel:LoadValue("ModelSZ6_Main", "Z6_SERVICO", cDescri)
        oModel:LoadValue("ModelSZ6_Main", "Z6_PROJET",  cProjeto)
        oModel:LoadValue("ModelSZ6_Main", "Z6_TAREFA",  cTarefa)
        oModel:LoadValue("ModelSZ6_Main", "Z6_CHAMADO", Val(cChamado))
        oModel:LoadValue("ModelSZ6_Main", "Z6_QGRAVOU", cNomeGravou)

        If oModel:VldData()
            lGravou := oModel:CommitData()
        EndIf

        oModel:DeActivate()
        Return {lGravou, dData, cHmini, cHmfim}
    EndIf

    oModel:SetValue("ModelSZ6_Main", "Z6_FILIAL",  xFilial("SZ6"))
    oModel:SetValue("ModelSZ6_Main", "Z6_DTAGE",   dData)
    oModel:SetValue("ModelSZ6_Main", "Z6_TECNICO", cTecnico)
    oModel:SetValue("ModelSZ6_Main", "Z6_HMINI",   cHmini)
    oModel:SetValue("ModelSZ6_Main", "Z6_HMFIM",   cHmfim)
    oModel:SetValue("ModelSZ6_Main", "Z6_CLIENTE", cCliente)
    oModel:SetValue("ModelSZ6_Main", "Z6_LOJA",    cLoja)
    oModel:SetValue("ModelSZ6_Main", "Z6_SERVICO", cDescri)
    oModel:SetValue("ModelSZ6_Main", "Z6_PROJET",  cProjeto)
    oModel:SetValue("ModelSZ6_Main", "Z6_TAREFA",  cTarefa)
    oModel:SetValue("ModelSZ6_Main", "Z6_CHAMADO", Val(cChamado))
    oModel:SetValue("ModelSZ6_Main", "Z6_QGRAVOU", cNomeGravou)

    // FWExecView devolve 0 quando o usuario confirma (OK) e grava.
    lGravou := FWExecView("Nova Agenda - Chamado " + cChamado, ;
               "CNSA003", ;
               MODEL_OPERATION_INSERT, ;
               , ;
               {|| .T.}, ;
               NIL, NIL, NIL, NIL, NIL, NIL, ;
               oModel) == 0

    aRet := {lGravou, ;
             oModel:GetValue("ModelSZ6_Main", "Z6_DTAGE"), ;
             AllTrim(oModel:GetValue("ModelSZ6_Main", "Z6_HMINI")), ;
             AllTrim(oModel:GetValue("ModelSZ6_Main", "Z6_HMFIM"))}

    oModel:DeActivate()

Return aRet

/*/{Protheus.doc} CH_CRIARAGENDATELA
Ponte headless chamada por CH_POSGRAVACAO quando o chamado e salvo via
REST com tecnico definido - cria o agendamento sem interacao de tela,
repassando os parametros para CH_MONTAAGENDA.
@param  cTecnico   Codigo do tecnico (AA1)
@param  dData      Data do agendamento
@param  cHmini     Hora inicial (HH:MM)
@param  cHmfim     Hora final (HH:MM)
@param  cCliente   Codigo do cliente (SA1)
@param  cLoja      Loja do cliente
@param  cDescri    Descricao/servico do agendamento
@param  cProjeto   Codigo do projeto
@param  cTarefa    Codigo da tarefa
@param  cChamado   Id do chamado (ZA1_IDCH)
@author Henrique
@since 02/09/2026
@version P12
/*/
User Function CH_CRIARAGENDATELA(cTecnico, dData, cHmini, cHmfim, ;
    cCliente, cLoja, cDescri, cProjeto, cTarefa, cChamado, lViaRest)
Return CH_MONTAAGENDA(cTecnico, dData, cHmini, cHmfim, cCliente, cLoja, cDescri, cProjeto, cTarefa, cChamado, lViaRest)


/*/{Protheus.doc} CH_ASSUMIRTELA
Opcao de menu "Assumir" da tela classica: confirma com o usuario e chama
o nucleo compartilhado CH_NUCLEOASSUMIR para o chamado selecionado.
Assumir - item de menu da tela classica.
@author Henrique
@since 02/09/2026
@version P12
@update 17/09/2026 - Pergunta "deseja informar o cliente?" aqui (CH_NUCLEOASSUMIR forca lCnsaViaRest, entao o MsgYesNo generico do CH_POSGRAVACAO nao dispara nesse fluxo)
/*/
User Function CH_ASSUMIRTELA()
    Local aResultado      := {}
    Local lNotificarCliente := .F.
    Local lNotificarTecnico := .F.

    If ZA1->(Eof()) .Or. ZA1->(Bof())
        MsgAlert("Nenhum chamado selecionado.", "Assumir")
        Return
    EndIf

    If !MsgYesNo("Deseja assumir o chamado " + AllTrim(ZA1->ZA1_IDCH) + "?", "Assumir Chamado")
        Return
    EndIf

    lNotificarCliente := MsgYesNo("Deseja informar o cliente sobre esta alteracao?", "Notificar Cliente")
    lNotificarTecnico := MsgYesNo("Deseja enviar e-mail ao analista sobre esta designacao?", "Notificar Analista")

    aResultado := CH_NUCLEOASSUMIR(AllTrim(ZA1->ZA1_IDCH), lNotificarCliente, lNotificarTecnico)

    If aResultado[1] == 200
        MsgInfo("Chamado assumido com sucesso!", "Assumir Chamado")
    Else
        MsgAlert(aResultado[2], "Assumir")
    EndIf

Return

/*/{Protheus.doc} CH_EXCLUIRTELA
Opcao de menu "Excluir" da tela classica: pede o motivo do cancelamento
(via dialogo, quando o chamado ja tem tecnico) e chama o nucleo
compartilhado CH_NUCLEOEXCLUIR.
Excluir - item de menu da tela classica (mantem o MSDIALOG de motivo)
@author Henrique
@since 02/09/2026
@version P12
/*/
User Function CH_EXCLUIRTELA()
    Local oDialog        := Nil
    Local oBtnOk         := Nil
    Local oBtnCan        := Nil
    Local oGetMotivo     := Nil
    Local cIdCh          := ""
    Local cMotivo        := ""
    Local aResultado     := {}
    Local lNotificarCliente := .F.

    If ZA1->(Eof()) .Or. ZA1->(Bof())
        MsgAlert("Nenhum chamado selecionado.", "Excluir")
        Return
    EndIf

    cIdCh := AllTrim(ZA1->ZA1_IDCH)

    If !Empty(AllTrim(ZA1->ZA1_EMAIL))
        lNotificarCliente := MsgYesNo("Deseja informar o cliente sobre o encerramento?", "Notificar Cliente")
    EndIf

    If Empty(AllTrim(ZA1->ZA1_CONSUL))
        aResultado := CH_NUCLEOEXCLUIR(cIdCh, "", lNotificarCliente, .F.)
        If aResultado[1] != 200
            MsgAlert(aResultado[2], "Excluir")
        EndIf
        Return
    EndIf

    Private aMotivos := {"Encerramento pela Apia", "Encerramento pelo Cliente", "Outro motivo"}
    Private cMotivoSel := aMotivos[1]
    Private cOutroMotivo := Space(100)
    Private lMotConfirm  := .F.

    DEFINE MSDIALOG oDialog TITLE "Motivo da Exclusao" FROM 0,0 TO 300,600 PIXEL

        @ 10,10  SAY "Selecione o motivo do Encerramento:" SIZE 250,12 PIXEL OF oDialog
        @ 25,10  COMBOBOX oCombo VAR cMotivoSel ITEMS aMotivos SIZE 250,12 PIXEL OF oDialog

        @ 60,10  SAY "Descricao: " SIZE 300,12 PIXEL OF oDialog
        @ 75,10  MSGET oGetMotivo VAR cOutroMotivo PICTURE "@!" SIZE 240,12 PIXEL OF oDialog

        oBtnOk  := TButton():New(100, 90,  "OK",       oDialog, {|| lMotConfirm:=.T., oDialog:End()}, 50,14,,,.F.,.T.,.F.,,.F.,,,.F.)
        oBtnCan := TButton():New(100, 145, "Cancelar", oDialog, {|| oDialog:End()},                   50,14,,,.F.,.T.,.F.,,.F.,,,.F.)

    ACTIVATE MSDIALOG oDialog CENTERED

    If !lMotConfirm
        Return
    EndIf

    Do Case
        Case cMotivoSel == "Encerramento pela Apia"
            cMotivo := If(Empty(AllTrim(cOutroMotivo)), "Encerramento pela Apia", "Encerramento pela Apia - " + AllTrim(cOutroMotivo))
        Case cMotivoSel == "Encerramento pelo Cliente"
            cMotivo := If(Empty(AllTrim(cOutroMotivo)), "Encerramento pelo Cliente", "Encerramento pelo Cliente - " + AllTrim(cOutroMotivo))
        Case cMotivoSel == "Outro motivo"
            If Empty(AllTrim(cOutroMotivo))
                MsgAlert("Informe o motivo para a opcao 'Outro'.", "Motivo")
                Return
            EndIf
            cMotivo := AllTrim(cOutroMotivo)
    EndCase

    aResultado := CH_NUCLEOEXCLUIR(cIdCh, cMotivo, lNotificarCliente, ;
        MsgYesNo("Deseja enviar e-mail ao analista sobre o encerramento?", "Notificar Analista"))
    If aResultado[1] != 200
        MsgAlert(aResultado[2], "Excluir")
    EndIf

Return

/*/{Protheus.doc} CH_EXCLUIRINTERACAOTELA
Opcao de menu "Excluir Interacao" da tela classica: lista as interacoes do
chamado selecionado num AChoice, confirma a exclusao e pergunta se deve
informar o cliente, chamando o nucleo compartilhado CH_NUCLEOEXCLUIRINTERACAO.
@author Henrique
@since 17/09/2026
@version P12
/*/
User Function CH_EXCLUIRINTERACAOTELA()
    Local cIdCh      := ""
    Local cAlias     := GetNextAlias()
    Local aSeqs      := {}
    Local aExibicao  := {}
    Local nOpcao     := 0
    Local lNotificar := .F.
    Local aResultado := {}

    If ZA1->(Eof()) .Or. ZA1->(Bof())
        MsgAlert("Nenhum chamado selecionado.", "Excluir Interação")
        Return
    EndIf

    cIdCh := AllTrim(ZA1->ZA1_IDCH)

    BeginSql Alias cAlias
        SELECT ZA2_IDGRID, ZA2_DESCRI
        FROM %Table:ZA2% ZA2
        WHERE ZA2_FILIAL = %xFilial:ZA2%
          AND ZA2_IDCH   = %Exp:cIdCh%
          AND %NotDel%
        ORDER BY ZA2_IDGRID
    EndSql

    While !(cAlias)->(Eof())
        AAdd(aSeqs, AllTrim((cAlias)->ZA2_IDGRID))
        AAdd(aExibicao, AllTrim((cAlias)->ZA2_IDGRID) + " - " + Left(CH_DECODESAFE(AllTrim((cAlias)->ZA2_DESCRI)), 60))
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

    If Len(aSeqs) == 0
        MsgAlert("Este chamado nao tem interacoes.", "Excluir Interação")
        Return
    EndIf

    nOpcao := AChoice("Excluir Interação - Chamado " + cIdCh, aExibicao)
    If nOpcao == 0
        Return
    EndIf

    If !MsgYesNo("Confirma excluir a Interação " + aSeqs[nOpcao] + "?", "Excluir Interação")
        Return
    EndIf

    lNotificar := MsgYesNo("Deseja informar o cliente sobre esta alteracao?", "Notificar Cliente")

    aResultado := CH_NUCLEOEXCLUIRINTERACAO(cIdCh, aSeqs[nOpcao], lNotificar)

    If aResultado[1] == 200
        MsgInfo("Interação excluida com sucesso!", "Excluir Interação")
    Else
        MsgAlert(aResultado[2], "Excluir Interação")
    EndIf

Return

/*%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%*/
// BLOCO 2 - ORDEM LOGICA (NUCLEO + API)
/*%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%*/

/*/{Protheus.doc} CH_NUCLEOINCLUIR
Nucleo unico de inclusao de chamado (tela + REST + importacao por e-mail),
via Model MVC (FCNS001). Dispara os gatilhos de
cliente/tecnico manualmente e, quando sucesso, notifica por e-mail se ja
nasce com tecnico atribuido.
INCLUIR/ALTERAR - endpoints REST customizados. Front manda tudo via query string (body sempre null); a Class oRestChamados abaixo so existe porque o PUBLISH MODEL REST exige, fica como caminho generico /rest/FwModel/chamado sem uso real hoje. Gravacao real e 100% aqui, via RecLock direto (portada de CNS001Rest.tlpp). Nucleo de Incluir unificado com o Model MVC (FCNS001) - era a 3a copia da mesma acao (RecLock direto), junto com o ModelDef/ViewDef da tela classica e o SaveData manual do oRestChamados (que agora so chama este nucleo). Chamado nasce SEMPRE sem tecnico (regra de negocio: tecnico so e preenchido quando alguem Assume ou um chefe atribui via Alterar) - por isso cCodConsultor NAO leva mais default pro usuario da sessao.
@param  cAssunto           Assunto do chamado
@param  cDtAbertura        Data de abertura (AAAAMMDD ou AAAA-MM-DD)
@param  cTipo              Tipo do chamado
@param  cCodCliente        Codigo do cliente (SA1)
@param  cLojaCliente       Loja do cliente (default "01")
@param  cEmailCliente      E-mail do cliente
@param  cCodConsultor      Codigo do tecnico (AA1), se ja nascer atribuido
@param  cProjeto           Codigo do projeto
@param  cTarefa            Codigo da tarefa
@param  cMailId             Id do e-mail de origem (importacao Graph), dedup
@param  lExigirCompletos   Exige tipo/projeto/tarefa preenchidos (.F. no caminho de e-mail)
@param  lNotificarTecnico  .F. pra NAO enviar o e-mail de designacao ao analista (default .T.)
@param  cDescricao         Descricao do chamado (ZA1_ANOT, cortada no tamanho do campo)
@return Array {nStatusHTTP, cCorpoJsonOuMensagem, cIdCh}
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_NUCLEOINCLUIR(cAssunto, cDtAbertura, cTipo, cCodCliente, cLojaCliente, cEmailCliente, cCodConsultor, cProjeto, cTarefa, cMailId, lExigirCompletos, lNotificarTecnico, cDescricao)
    Local cIdCh       := ""
    Local oJson       := JsonObject():New()
    Local oErro       := Nil
    Local oModel      := Nil
    Local oModelZA1   := Nil
    Local oErroModel  := Nil
    Local lOk         := .F.

    Default cMailId          := ""
    Default lExigirCompletos := .T.
    Default lNotificarTecnico := .T.
    Default cDescricao        := ""

    Begin Sequence

        // Campo obrigatorio (assunto/tipo/projeto/tarefa) nao valida mais
        // aqui - front-end valida antes de chamar. CH_PREVALIDA (Model)
        // cobre via SetErrorMessage, com lCnsaIncluirIncompleto liberando
        // tipo/projeto/tarefa pro caminho de e-mail.
        Default cLojaCliente := "01"

        If Empty(cDtAbertura)
            cDtAbertura := DTOS(Date())
        Else
            cDtAbertura := StrTran(cDtAbertura, "-", "")
        EndIf

        cIdCh := GetSxeNum("ZA1", "ZA1_IDCH")

        Public lCnsaViaRest          := .T.
        Public lCnsaIncluirIncompleto := !lExigirCompletos

        // CH_MONTARMODEL(.T.): monta e ativa na MESMA funcao, senao
        // "_SetNamedPrvt: owner private environment not found" no INITVALUE
        // do Insert - ver comentario em CH_MONTARMODEL.
        oModel := CH_MONTARMODEL(.T.)

        oModelZA1 := oModel:GetModel("ZA1MASTER")

        oModelZA1:LoadValue("ZA1_FILIAL", xFilial("ZA1"))
        oModelZA1:LoadValue("ZA1_IDCH",   cIdCh)
        // FIX: assunto de e-mail pode vir bem mais longo que um assunto
        // digitado a mao - ZA1_ASSUNT e Caractere (tamanho real, diferente
        // de ZA2_DESCRI que e Memo). Sem truncar pelo tamanho do campo (SX3),
        // LoadValue de string maior travava VldData/CommitData com erro
        // generico vazio.
        oModelZA1:LoadValue("ZA1_ASSUNT", SubStr(cAssunto, 1, TamSX3("ZA1_ASSUNT")[1]))
        oModelZA1:LoadValue("ZA1_DATA",   STOD(cDtAbertura))
        // FIX: chamado sem cliente vinculado nasce Incompleto (status "5",
        // ver STATUS_INCOMPLETO no front apia-po-cnshub) em vez de Aberto -
        // status fixo em "1" fazia o e-mail sem cliente encontrado (SA1)
        // nunca cair no status Incompleto, mesmo o front ja tratando isso.
        oModelZA1:LoadValue("ZA1_STATUS", If(Empty(cCodCliente), "5", "1"))
        oModelZA1:LoadValue("ZA1_TIPO",   cTipo)

        // Ordem importa (mesmo padrao do oRestChamados original): cliente
        // precisa estar no model ANTES de disparar o gatilho CNSA_CLIENTE -
        // motor API/REST nao dispara gatilho SX7 sozinho, chamamos explicito.
        oModelZA1:LoadValue("ZA1_CLIENT", cCodCliente)
        oModelZA1:LoadValue("ZA1_LOJA",   cLojaCliente)
        U_CNSA_CLIENTE()

        oModelZA1:LoadValue("ZA1_EMAIL",  cEmailCliente)
        // FIX: ZA1_CONSUL tem Inicial Padrao (SX3) que auto-preenche com o
        // tecnico do usuario logado no Activate() (INITVALUE) - sem o Else
        // aqui, chamado sem consultor explicito (caso normal do e-mail)
        // nascia atribuido a quem abriu a tela, em vez de ficar sem tecnico.
        If !Empty(cCodConsultor)
            oModelZA1:LoadValue("ZA1_CONSUL", cCodConsultor)
            U_CNSA_TECNICO()
        Else
            // FIX: U_CNSA_TECNICO() com codigo vazio nao devolve vazio -
            // Posicione("AA1",1,xFilial("AA1")+"",...) cai no primeiro
            // registro da AA1 (seek "soft") e traz o nome dele (ex: Luiz
            // Muller) em vez de branco. Sem consultor, limpa o nome direto,
            // sem chamar o gatilho.
            oModelZA1:LoadValue("ZA1_CONSUL", "")
            oModelZA1:LoadValue("ZA1_NOMTEC", "")
        EndIf

        oModelZA1:LoadValue("ZA1_PROJ",   cProjeto)
        oModelZA1:LoadValue("ZA1_TAREFA", cTarefa)
        If !Empty(cDescricao)
            oModelZA1:LoadValue("ZA1_ANOT", SubStr(cDescricao, 1, TamSX3("ZA1_ANOT")[1]))
        EndIf
        oModelZA1:LoadValue("ZA1_MOD",    Date())
        If !Empty(cMailId)
            oModelZA1:LoadValue("ZA1_MAILID", cMailId)
        EndIf

        If oModel:VldData()
            lOk := oModel:CommitData()
        Else
            lOk := .F.
        EndIf

        oModel:DeActivate(lOk)
        lCnsaViaRest          := .F.
        lCnsaIncluirIncompleto := .F.

        If !lOk
            oErroModel := oModel:GetErrorMessage()
            RollBackSX8()
            Return {400, '{"erro":"' + CH_ESCAPARJSON(FwJsonSerialize(oErroModel)) + '"}'}
        EndIf

        ConfirmSX8()

        // E-mail de designacao - so dispara se o chamado ja nasce com tecnico
        // (atribuicao manual no Incluir, caso raro; fluxo normal e vazio).
        If !Empty(cCodConsultor)
            CH_NOTIFICARDESIGNA(cIdCh, cCodConsultor, .F., lNotificarTecnico)
        EndIf

        oJson['sucesso']  := .T.
        oJson['idCh']     := cIdCh
        oJson['mensagem'] := "Chamado incluido com sucesso."

        Return {200, oJson:ToJson(), cIdCh}

    Recover Using oErro
        lCnsaViaRest          := .F.
        lCnsaIncluirIncompleto := .F.
        RollBackSX8()
        If oModel <> Nil
            oModel:DeActivate()
        EndIf
        Return {500, '{"erro":"' + CH_ESCAPARJSON(oErro:Description) + '"}'}
    End Sequence

Return {500, '{"erro":"Erro desconhecido."}'}

/*/{Protheus.doc} CH_APIINCLUIR
Endpoint REST POST /CNSACHAMADOSINCLUIR: inclui um chamado a partir dos
parametros da query string, chamando CH_NUCLEOINCLUIR.
@return Logical - resposta HTTP com o resultado da inclusao
@author Henrique
@since 02/09/2026
@version P12
/*/
@Post(endpoint="/CNSACHAMADOSINCLUIR")
User Function CH_APIINCLUIR() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    aResultado := CH_NUCLEOINCLUIR(AllTrim(CH_LERJSONTXT(jQuery,"assunto")), AllTrim(CH_LERJSONTXT(jQuery,"dtAbertura")), AllTrim(CH_LERJSONTXT(jQuery,"tipo")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"codCliente")), AllTrim(CH_LERJSONTXT(jQuery,"lojaCliente")), AllTrim(CH_LERJSONTXT(jQuery,"emailCliente")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"codConsultor")), AllTrim(CH_LERJSONTXT(jQuery,"projeto")), AllTrim(CH_LERJSONTXT(jQuery,"tarefa")), ;
        "", .T., AllTrim(CH_LERJSONTXT(jQuery,"notificarTecnico")) != "0", AllTrim(CH_LERJSONTXT(jQuery,"descricao")))

Return oRest:setStatusResponse(aResultado[1], aResultado[2])

/*/{Protheus.doc} CH_NUCLEOALTERAR
Nucleo unico de alteracao de chamado (tela + REST), via Model MVC
(FCNS001) - mesmo caminho da tela classica, garantindo que
CH_PREVALIDA/CH_POSGRAVACAO sempre disparem (inclusive e-mail de
redesignacao e oferta de agenda quando o tecnico muda).
Nucleo de Alterar unificado com o Model MVC (FCNS001) - mesmo caminho da tela classica (CH_ALTERARTELA -> FWExecView operacao 4), evita reimplementar a alteracao via RecLock direto (bypassava CH_PREVALIDA/ CH_POSGRAVACAO). Efeito ja esperado (nao e bug novo, e a acao de verdade): designar tecnico aqui dispara e-mail de redesignacao/oferta de agenda, igual a tela classica sempre fez. Campo obrigatorio/estado (idCh vazio, nenhum campo informado, chamado fechado) nao valida mais aqui - front-end valida antes de chamar. "Chamado fechado" fica coberto automaticamente por CH_PREVALIDA (SetErrorMessage, dispara pra qualquer Update via este Model, Alterar incluso).
@param  cIdCh               Id do chamado a alterar
@param  cAssunto            Novo assunto (vazio = nao altera)
@param  cDtAbertura         Nova data de abertura (vazio = nao altera)
@param  cTipo               Novo tipo (vazio = nao altera)
@param  cCodCliente         Novo codigo do cliente (vazio = nao altera)
@param  cLojaCliente        Nova loja do cliente
@param  cEmailCliente       Novo e-mail do cliente (vazio = nao altera)
@param  cCodConsultor       Novo codigo do tecnico (vazio = nao altera)
@param  cProjeto            Novo projeto (vazio = nao altera)
@param  cTarefa             Nova tarefa (vazio = nao altera)
@param  lLimparCliente      Limpa o cliente do chamado
@param  lLimparConsultor    Limpa o tecnico do chamado
@param  cStatus             Novo status (1/2/3/4/5, vazio = nao altera) - so admin (CH_TEMACESSOGRUPO), inclusive pra reabrir/fechar chamado ja fechado
@param  lNotificarCliente   .T. pra tambem enviar e-mail ao cliente sobre as mudancas (ver CH_POSGRAVACAO/CH_NOTIFICARALTERACAO/CH_NOTIFICARDESIGNA) - decisao do front (dialogo "deseja informar o cliente?")
@return Array {nStatusHTTP, cCorpoJsonOuMensagem}
@author Henrique
@since 02/09/2026
@version P12
@param  lNotificarTecnico   .F. pra NAO enviar os e-mails de designacao/remocao ao analista (default .T.)
@param  cDescricao          Nova descricao (ZA1_ANOT, vazio = nao altera) - Alterar ja e restrito a admin (CH_PREVALIDA)
@param  lLimparDescricao    Limpa a descricao do chamado
@update 17/09/2026 - Adiciona cStatus (troca manual de status, so admin, mesmo em chamado fechado) e lNotificarCliente
/*/
Static Function CH_NUCLEOALTERAR(cIdCh, cAssunto, cDtAbertura, cTipo, cCodCliente, cLojaCliente, ;
    cEmailCliente, cCodConsultor, cProjeto, cTarefa, lLimparCliente, lLimparConsultor, cStatus, lNotificarCliente, lNotificarTecnico, cDescricao, lLimparDescricao)
    Local oJson              := JsonObject():New()
    Local oErro              := Nil
    Local oErroModel         := Nil
    Local oModel             := Nil
    Local oModelZA1          := Nil
    Local lOk                := .F.
    Local cStatusAtual       := ""

    Default cStatus := ""
    Default lNotificarCliente := .F.
    Default lNotificarTecnico := .T.
    Default cDescricao        := ""
    Default lLimparDescricao  := .F.

    Begin Sequence

        If !Empty(cStatus)
            If Len(cStatus) != 1 .Or. !(cStatus $ "12345")
                Return {400, '{"erro":"Status invalido."}'}
            EndIf
            If !CH_TEMACESSOGRUPO()
                Return {403, '{"erro":"Somente administradores podem alterar o status do chamado."}'}
            EndIf
        EndIf

        dbSelectArea("ZA1")
        ZA1->(DbSetOrder(1))
        If !ZA1->(DbSeek(xFilial("ZA1") + cIdCh))
            Return {404, '{"erro":"Chamado nao encontrado."}'}
        EndIf

        cStatusAtual := AllTrim(ZA1->ZA1_STATUS)

        Public lCnsaViaRest := .T.
        // Gatilho pra CH_PREVALIDA liberar Alterar em chamado ja fechado
        // (status "4") somente quando a troca de status foi pedida explicita
        // aqui - qualquer outro campo continua bloqueado em chamado fechado.
        Public lCnsaAlterandoStatus := !Empty(cStatus)
        // Decisao "deseja informar o cliente?" vinda do REST - CH_POSGRAVACAO
        // usa isso no lugar do MsgYesNo (que so faz sentido na tela classica).
        Public lCnsaNotificarCliente := lNotificarCliente
        Public lCnsaNotificarTecnico := lNotificarTecnico

        oModel := apia.cnsa001.U_ModelDef()
        oModel:SetOperation(MODEL_OPERATION_UPDATE)
        oModel:Activate()

        oModelZA1 := oModel:GetModel("ZA1MASTER")

        If !Empty(cAssunto)
            oModelZA1:LoadValue("ZA1_ASSUNT", cAssunto)
        EndIf
        If !Empty(cDtAbertura)
            oModelZA1:LoadValue("ZA1_DATA", STOD(StrTran(cDtAbertura, "-", "")))
        EndIf
        If !Empty(cTipo)
            oModelZA1:LoadValue("ZA1_TIPO", cTipo)
        EndIf

        If lLimparCliente
            oModelZA1:LoadValue("ZA1_CLIENT", "")
            oModelZA1:LoadValue("ZA1_LOJA",   "")
        ElseIf !Empty(cCodCliente)
            oModelZA1:LoadValue("ZA1_CLIENT", cCodCliente)
            oModelZA1:LoadValue("ZA1_LOJA",   If(Empty(cLojaCliente), "01", cLojaCliente))
            U_CNSA_CLIENTE()

            // FIX: chamado Incompleto (status "5", ver CH_NUCLEOINCLUIR) que
            // ganha cliente aqui no Alterar sai do Incompleto - senao ficava
            // Incompleto pra sempre, mesmo depois de completar o cliente.
            If cStatusAtual == "5"
                oModelZA1:LoadValue("ZA1_STATUS", "1")
            EndIf
        EndIf

        If !Empty(cEmailCliente)
            oModelZA1:LoadValue("ZA1_EMAIL", cEmailCliente)
        EndIf

        If lLimparConsultor
            oModelZA1:LoadValue("ZA1_CONSUL", "")
        ElseIf !Empty(cCodConsultor)
            oModelZA1:LoadValue("ZA1_CONSUL", cCodConsultor)
            U_CNSA_TECNICO()
        EndIf

        If !Empty(cProjeto)
            oModelZA1:LoadValue("ZA1_PROJ", cProjeto)
        EndIf
        If !Empty(cTarefa)
            oModelZA1:LoadValue("ZA1_TAREFA", cTarefa)
        EndIf

        If lLimparDescricao
            oModelZA1:LoadValue("ZA1_ANOT", "")
        ElseIf !Empty(cDescricao)
            oModelZA1:LoadValue("ZA1_ANOT", SubStr(cDescricao, 1, TamSX3("ZA1_ANOT")[1]))
        EndIf

        // Troca explicita de status (admin, ja validado no topo da funcao) -
        // depois do ajuste automatico "5"->"1" acima, pra prevalecer sobre
        // ele quando o admin pede outro valor especifico.
        If !Empty(cStatus)
            oModelZA1:LoadValue("ZA1_STATUS", cStatus)
        EndIf

        oModelZA1:LoadValue("ZA1_MOD", Date())

        If oModel:VldData()
            lOk := oModel:CommitData()
        Else
            lOk := .F.
        EndIf

        oModel:DeActivate(lOk)
        lCnsaViaRest         := .F.
        lCnsaAlterandoStatus := .F.
        lCnsaNotificarCliente := .F.
        lCnsaNotificarTecnico := .T.

        If !lOk
            oErroModel := oModel:GetErrorMessage()
            Return {400, '{"erro":"' + CH_ESCAPARJSON(FwJsonSerialize(oErroModel)) + '"}'}
        EndIf

        // CH_POSGRAVACAO ja cuida do e-mail de redesignacao (quando o
        // consultor muda de verdade) e do e-mail de alteracao de campos -
        // nao chamar de novo aqui (evita duplicar o envio).

        oJson['sucesso']  := .T.
        oJson['idCh']     := cIdCh
        oJson['mensagem'] := "Chamado alterado com sucesso."

        Return {200, oJson:ToJson()}

    Recover Using oErro
        lCnsaViaRest         := .F.
        lCnsaAlterandoStatus := .F.
        lCnsaNotificarCliente := .F.
        lCnsaNotificarTecnico := .T.
        If oModel <> Nil
            oModel:DeActivate()
        EndIf
        Return {500, '{"erro":"' + CH_ESCAPARJSON(oErro:Description) + '"}'}
    End Sequence

Return {500, '{"erro":"Erro desconhecido."}'}

/*/{Protheus.doc} CH_APIALTERAR
Endpoint REST POST /CNSACHAMADOSALTERAR: altera um chamado a partir dos
parametros da query string, chamando CH_NUCLEOALTERAR.
@return Logical - resposta HTTP com o resultado da alteracao
@author Henrique
@since 02/09/2026
@version P12
/*/
@Post(endpoint="/CNSACHAMADOSALTERAR")
User Function CH_APIALTERAR() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    aResultado := CH_NUCLEOALTERAR(AllTrim(CH_LERJSONTXT(jQuery,"idCh")), AllTrim(CH_LERJSONTXT(jQuery,"assunto")), AllTrim(CH_LERJSONTXT(jQuery,"dtAbertura")), AllTrim(CH_LERJSONTXT(jQuery,"tipo")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"codCliente")), AllTrim(CH_LERJSONTXT(jQuery,"lojaCliente")), AllTrim(CH_LERJSONTXT(jQuery,"emailCliente")), AllTrim(CH_LERJSONTXT(jQuery,"codConsultor")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"projeto")), AllTrim(CH_LERJSONTXT(jQuery,"tarefa")), AllTrim(CH_LERJSONTXT(jQuery,"limparCliente")) == "1", AllTrim(CH_LERJSONTXT(jQuery,"limparConsultor")) == "1", ;
        AllTrim(CH_LERJSONTXT(jQuery,"status")), AllTrim(CH_LERJSONTXT(jQuery,"notificarCliente")) == "1", ;
        AllTrim(CH_LERJSONTXT(jQuery,"notificarTecnico")) != "0", ;
        AllTrim(CH_LERJSONTXT(jQuery,"descricao")), AllTrim(CH_LERJSONTXT(jQuery,"limparDescricao")) == "1")

Return oRest:setStatusResponse(aResultado[1], aResultado[2])

// Class oRestChamados movida pra fora do Namespace (topo do arquivo) -
// GETOBJECT(FWRESTMODEL.PRX) nao resolve classe declarada dentro de
// Namespace ("Classe oRestChamados nao existe!"). Ver definicao no topo.


/*/{Protheus.doc} CH_NUCLEOASSUMIR
Nucleo compartilhado (tela + REST) de "Assumir chamado": atribui o
consultor da sessao logada ao chamado e muda o status para "2" (Pendente
Apia), via FWLoadModel/CommitData. Elegibilidade de negocio e validada em
CH_PREVALIDA (gatilho lCnsaAssumindo); aqui so ficam as checagens que so o
backend pode saber (usuario sem consultor vinculado, chamado inexistente).
ASSUMIR - nucleo compartilhado (tela + REST), via FWLoadModel/CommitData em vez de RecLock direto. Elegibilidade pra Assumir (ja designado/fechado/pendente/sem cliente- projeto-tarefa/fase do projeto) NAO fica mais aqui como Return ad-hoc - migrou pra CH_PREVALIDA via SetErrorMessage (gatilho lCnsaAssumindo), canal correto do Model MVC. So o que o backend realmente so pode saber (usuario sem consultor vinculado, chamado nao encontrado) fica aqui.
@param  cIdCh               Id do chamado (ZA1_IDCH)
@param  lNotificarCliente   .T. pra tambem enviar e-mail ao cliente sobre o tecnico designado (ver CH_POSGRAVACAO/CH_NOTIFICARDESIGNA) - decisao do front (dialogo "deseja informar o cliente?")
@return Array {nStatusHTTP, cMensagemErro, cNomeTecnico}
@author Henrique
@since 02/09/2026
@version P12
@update 09/09/2026 - Chama U_CNSA_TECNICO apos SetValue(ZA1_CONSUL): ZA1_NOMTEC agora e campo real, gatilho SX7 nao dispara sozinho em Job Thread/REST
@param  lNotificarTecnico   .F. pra NAO enviar o e-mail de designacao/remocao ao analista (default .T.)
@update 17/09/2026 - Adiciona lNotificarCliente
/*/
Static Function CH_NUCLEOASSUMIR(cIdCh, lNotificarCliente, lNotificarTecnico)
    Local cConsultorSessao := ""
    Local cNomeTec         := ""
    Local oModel           := Nil
    Local lOk              := .F.
    Local oErroModel       := Nil
    Local oErroExcpt       := Nil
    Local cErro            := ""

    Default lNotificarCliente := .F.
    Default lNotificarTecnico := .T.

    Begin Sequence

        // AllTrim() necessario - Posicione() devolve o valor no tamanho
        // cheio do campo (AA1_CODTEC), preenchido com espaco; sem isso
        // SetValue("ZA1_CONSUL", ...) dava FWNOWIDTH ("Valor atribuido
        // difere do tamanho do campo") sempre que ZA1_CONSUL tem tamanho
        // diferente de AA1_CODTEC no dicionario.
        cConsultorSessao := AllTrim(Posicione("AA1",4,xFilial("AA1")+__cUserId,"AA1_CODTEC"))
        If Empty(cConsultorSessao)
            Return {400, "Seu usuario nao esta vinculado a nenhum consultor (AA1).", ""}
        EndIf

        dbSelectArea("ZA1")
        ZA1->(DbSetOrder(1))
        If !ZA1->(DbSeek(xFilial("ZA1") + cIdCh))
            Return {404, "Chamado nao encontrado.", ""}
        EndIf

        // Capturado da workarea (pre-Model) porque ZA1_CONSUL/ZA1_STATUS sao
        // justamente os campos que este nucleo vai sobrescrever a seguir -
        // CH_PREVALIDA (via Model) so enxergaria o valor NOVO, nao o atual.
        Public cAssumirConsulAnt := AllTrim(ZA1->ZA1_CONSUL)
        Public cAssumirStatusAnt := AllTrim(ZA1->ZA1_STATUS)
        Public lCnsaAssumindo    := .T.
        Public lCnsaViaRest      := .T.
        Public lCnsaNotificarCliente := lNotificarCliente
        Public lCnsaNotificarTecnico := lNotificarTecnico

        oModel := apia.cnsa001.U_ModelDef()
        oModel:SetOperation(MODEL_OPERATION_UPDATE)
        oModel:Activate()

        oModel:GetModel("ZA1MASTER"):LoadValue("ZA1_CONSUL", cConsultorSessao)
        oModel:GetModel("ZA1MASTER"):LoadValue("ZA1_STATUS", "2")
        U_CNSA_TECNICO()

        If oModel:VldData()
            lOk := oModel:CommitData()
        Else
            lOk := .F.
        EndIf

        If !lOk
            oErroModel := oModel:GetErrorMessage()
            cErro := FwJsonSerialize(oErroModel)
        EndIf

        oModel:DeActivate(lOk)
        lCnsaViaRest          := .F.
        lCnsaAssumindo        := .F.
        lCnsaNotificarCliente := .F.
        lCnsaNotificarTecnico := .T.

        If !lOk
            Return {400, "Falha ao assumir o chamado: " + cErro, ""}
        EndIf

        cNomeTec := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cConsultorSessao, "AA1_NOMTEC"))

        // CH_POSGRAVACAO ja dispara e-mail de designacao nativamente -
        // NAO chamar CH_NOTIFICARDESIGNA aqui de novo (evita duplicar).

        Return {200, "", cNomeTec}

    Recover Using oErroExcpt
        lCnsaViaRest          := .F.
        lCnsaAssumindo        := .F.
        lCnsaNotificarCliente := .F.
        lCnsaNotificarTecnico := .T.
        If oModel <> Nil
            oModel:DeActivate()
        EndIf
        Return {500, "Erro interno: " + oErroExcpt:Description, ""}
    End Sequence

Return {500, "Erro desconhecido.", ""}

/*/{Protheus.doc} CH_APIASSUMIR
Endpoint REST POST /CNSACHAMADOSASSUMIR: assume o chamado (idCh via query)
para o consultor da sessao, chamando CH_NUCLEOASSUMIR.
Assumir - endpoint REST (mesmo path que CNS001Rest.tlpp - ver aviso de colisao)
@return Logical - resposta HTTP (200 com idCh/status/tecnico, ou erro)
@author Henrique
@since 02/09/2026
@version P12
/*/
@Post(endpoint="/CNSACHAMADOSASSUMIR")
User Function CH_APIASSUMIR() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local cIdCh      := AllTrim(CH_LERJSONTXT(jQuery,"idCh"))
    Local aResultado := {}
    Local oJson      := JsonObject():New()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    aResultado := CH_NUCLEOASSUMIR(cIdCh, AllTrim(CH_LERJSONTXT(jQuery,"notificarCliente")) == "1", AllTrim(CH_LERJSONTXT(jQuery,"notificarTecnico")) != "0")

    If aResultado[1] == 200
        // FIX: faltava "idCh" na resposta (AssumirResposta do front exige).
        oJson['sucesso'] := .T.
        oJson['idCh']    := cIdCh
        oJson['status']  := "2"
        oJson['tecnico'] := aResultado[3]
        Return oRest:setStatusResponse(200, oJson:ToJson())
    EndIf

Return oRest:setStatusResponse(aResultado[1], '{"erro":"' + CH_ESCAPARJSON(aResultado[2]) + '"}')


/*/{Protheus.doc} CH_NUCLEOEXCLUIR
Nucleo compartilhado (tela + REST) de exclusao de chamado: apaga o
registro ZA1 e os agendamentos (SZ6) relacionados via RecLock direto (sem
Model, ver CH_VALIDACANCELA), e notifica por e-mail o tecnico designado.
EXCLUIR - nucleo compartilhado (tela + REST)
@param  cIdCh     Id do chamado (ZA1_IDCH)
@param  cMotivo   Motivo do cancelamento (usado no e-mail de notificacao)
@return Array {nStatusHTTP, cMensagem}
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_NUCLEOEXCLUIR(cIdCh, cMotivo, lNotificarCliente, lNotificarTecnico)
    Local cConsulAnt  := ""
    Local cClienteAnt := ""
    Local cLojaAnt    := ""
    Local cNomeCli    := ""
    Local cNomeTec    := ""
    Local cEmailTec   := ""
    Local cEmailCli   := ""
    Local cExclPor    := ""
    Local cDataAge    := DToC(Date())
    Local cHmini      := "00:00"
    Local cHmfim      := "00:00"
    Local cCorpo      := ""
    Local cAlias      := ""
    Local nCham       := 0
    Local oErro       := Nil

    Default lNotificarCliente := .F.
    Default lNotificarTecnico := .T.

    Begin Sequence

        // Sem Model neste nucleo (RecLock direto, de proposito - ver
        // CH_VALIDACANCELA) - SetErrorMessage nao se aplica aqui. Campo
        // obrigatorio (idCh/motivo) vira help no front, sem checagem no
        // backend.
        dbSelectArea("ZA1")
        ZA1->(DbSetOrder(1))
        If !ZA1->(DbSeek(xFilial("ZA1") + cIdCh))
            Return {404, "Chamado nao encontrado."}
        EndIf

        cConsulAnt  := AllTrim(ZA1->ZA1_CONSUL)
        cClienteAnt := AllTrim(ZA1->ZA1_CLIENT)
        cLojaAnt    := AllTrim(ZA1->ZA1_LOJA)
        // E-mail do chamado (ZA1_EMAIL), igual aos demais e-mails ao cliente -
        // cai pro cadastro (A1_EMAIL) so se o chamado nao tiver.
        cEmailCli   := AllTrim(ZA1->ZA1_EMAIL)
        If Empty(cEmailCli) .And. !Empty(cClienteAnt)
            cEmailCli := AllTrim(Posicione("SA1", 1, xFilial("SA1") + cClienteAnt + cLojaAnt, "A1_EMAIL"))
        EndIf

        cExclPor := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_NOMTEC"))
        cNomeCli := AllTrim(Posicione("SA1", 1, xFilial("SA1") + cClienteAnt + cLojaAnt, "A1_NREDUZ"))

        nCham  := Val(cIdCh)
        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT Z6_DTAGE, Z6_HMINI, Z6_HMFIM
            FROM %Table:SZ6% SZ6
            WHERE Z6_FILIAL  = %xFilial:SZ6%
              AND Z6_CHAMADO = %Exp:nCham%
              AND %NotDel%
        EndSql
        If !(cAlias)->(Eof())
            If ValType((cAlias)->Z6_DTAGE) == "D"
                cDataAge := DToC((cAlias)->Z6_DTAGE)
            Else
                cDataAge := AllTrim((cAlias)->Z6_DTAGE)
                If Len(cDataAge) == 8
                    cDataAge := SubStr(cDataAge,7,2) + "/" + SubStr(cDataAge,5,2) + "/" + SubStr(cDataAge,1,4)
                EndIf
            EndIf
            cHmini := AllTrim((cAlias)->Z6_HMINI)
            cHmfim := AllTrim((cAlias)->Z6_HMFIM)
        EndIf
        (cAlias)->(DbCloseArea())

        If Empty(cHmini) ; cHmini := "00:00" ; EndIf
        If Empty(cHmfim) ; cHmfim := "00:00" ; EndIf

        RecLock("ZA1", .F.)
            ZA1->(DbDelete())
        ZA1->(MsUnlock())

        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT SZ6.R_E_C_N_O_ RECNO
            FROM %Table:SZ6% SZ6
            WHERE SZ6.Z6_FILIAL  = %xFilial:SZ6%
              AND SZ6.Z6_CHAMADO = %Exp:nCham%
              AND %NotDel%
        EndSql
        dbSelectArea("SZ6")
        While !(cAlias)->(Eof())
            SZ6->(DbGoto((cAlias)->RECNO))
            If !SZ6->(Eof())
                RecLock("SZ6", .F.)
                    SZ6->(DbDelete())
                SZ6->(MsUnlock())
            EndIf
            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())

        // Analista e cliente sao independentes: cada um so recebe se o usuario
        // escolheu enviar (antes o cliente so recebia se o analista tivesse
        // AA1_EMAIL, e sem perguntar).
        cCorpo := CH_HTMLENCERRAMENTO(cNomeCli, cDataAge, cHmini, cHmfim, cIdCh, cMotivo, cExclPor)
        If lNotificarTecnico .And. !Empty(cConsulAnt)
            cNomeTec  := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cConsulAnt, "AA1_NOMTEC"))
            cEmailTec := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cConsulAnt, "AA1_EMAIL"))
            If !Empty(cEmailTec)
                CH_ENVIAREMAIL(cEmailTec, "Encerramento do Chamado " + cIdCh, cCorpo, "apia@apia.com.br")
            EndIf
        EndIf
        If lNotificarCliente .And. !Empty(cEmailCli)
            CH_ENVIAREMAIL(cEmailCli, "Encerramento do Chamado " + cIdCh, cCorpo, "apia@apia.com.br")
        EndIf

        Return {200, "Chamado excluido com sucesso."}

    Recover Using oErro
        Return {500, "Erro interno: " + oErro:Description}
    End Sequence

Return {500, "Erro desconhecido."}

/*/{Protheus.doc} CH_APIEXCLUIR
Endpoint REST POST /CNSACHAMADOSEXCLUIR: exclui o chamado (idCh/motivo via
query), chamando CH_NUCLEOEXCLUIR.
Excluir - endpoint REST (mesmo path que CNS001Rest.tlpp)
@return Logical - resposta HTTP (200 com idCh/mensagem, ou erro)
@author Henrique
@since 02/09/2026
@version P12
/*/
@Post(endpoint="/CNSACHAMADOSEXCLUIR")
User Function CH_APIEXCLUIR() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local cIdCh      := AllTrim(CH_LERJSONTXT(jQuery,"idCh"))
    Local aResultado := {}
    Local oJson      := JsonObject():New()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    aResultado := CH_NUCLEOEXCLUIR(cIdCh, AllTrim(CH_LERJSONTXT(jQuery,"motivo")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"notificarCliente")) == "1", AllTrim(CH_LERJSONTXT(jQuery,"notificarTecnico")) != "0")

    If aResultado[1] == 200
        // FIX: faltava "idCh" na resposta (ExcluirResposta do front exige).
        oJson['sucesso']  := .T.
        oJson['idCh']     := cIdCh
        oJson['mensagem'] := aResultado[2]
        Return oRest:setStatusResponse(200, oJson:ToJson())
    EndIf

Return oRest:setStatusResponse(aResultado[1], '{"erro":"' + CH_ESCAPARJSON(aResultado[2]) + '"}')


/*/{Protheus.doc} CH_DATAISOZA1
Converte uma data no formato AAAAMMDD (Character) para o formato ISO
AAAA-MM-DD, usado na resposta JSON dos endpoints REST.
Data ISO (AAAA-MM-DD) a partir de AAAAMMDD - ZA1_DATA pode vir Character (cursor paginado)
@param  cData   Data no formato AAAAMMDD
@return Data no formato ISO (AAAA-MM-DD), ou "" se invalida
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_DATAISOZA1(cData)
    Local cAno := ""
    Local cMes := ""
    Local cDia := ""

    cData := AllTrim(cData)

    If Len(cData) == 8
        cAno := SubStr(cData, 1, 4)
        cMes := SubStr(cData, 5, 2)
        cDia := SubStr(cData, 7, 2)

        If Val(cMes) >= 1 .And. Val(cMes) <= 12 .And. Val(cDia) >= 1 .And. Val(cDia) <= 31
            Return cAno + "-" + cMes + "-" + cDia
        EndIf
    EndIf

Return ""

/*/{Protheus.doc} CH_APICHAMADOS
Endpoint REST GET /CNSACHAMADOS: lista os chamados (ZA1) paginados, com
tecnico/cliente/projeto/tarefa resolvidos por nome, ordenados do mais
recente para o mais antigo. Sem filtro de negocio no backend, exceto
"texto" (busca livre por idCh/assunto/nome cliente/nome tecnico - regra:
o resto do filtro e responsabilidade do front-end).
LISTAGEM/VISUALIZAR/PESQUISAR - endpoint REST que faltava por completo. Contrato confirmado no front (apia-po-cnshub/chamado-serv.ts): path "/rest/CNSACHAMADOS". Sem filtro de NEGOCIO no backend de proposito - status/meus chamados/sem responsavel/periodo sao responsabilidade do front (regra do usuario: filtro fica so na tela). "texto" e a UNICA excecao (busca livre da caixa "Pesquisar") - com a ZA1 na casa dos milhares de linhas e a listagem paginada de verdade (04/09/2026, front parou de carregar tudo de uma vez), o front so tem a pagina atual em memoria pra filtrar. Navegacao nativa (DbSeek/DbSkip na ZA1, ordem 1 = FILIAL+IDCH), sem SQL - igual o Browse do CNSA003 (FWMBrowse:SetAlias, sem query propria). So mantem paginacao tecnica (pagina/tamanho) + busca "texto", que nao sao filtro de negocio, sao mecanismo da tela.
@return Logical - resposta HTTP 200 com JSON paginado (total/items), ou erro
@author Henrique
@since 02/09/2026
@version P12
/*/
@Get(endpoint="/CNSACHAMADOS")
User Function CH_APICHAMADOS() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local oJson      := JsonObject():New()
    Local aTodos     := {}
    Local aRetorno   := {}
    Local oLinha     := Nil
    Local nPagina    := 1
    Local nTamanho   := 10
    Local nStartIdx  := 1
    Local nTotal     := 0
    Local nI         := 0
    Local nFim       := 0
    Local aCacheTec  := {}
    Local aCacheCli  := {}
    Local aCacheProj := {}
    Local aCacheTaf  := {}
    Local nPosCache  := 0
    Local cCodConsul := ""
    Local cCodCli    := ""
    Local cLoja      := ""
    Local cNomeTec   := ""
    Local cNomeCli   := ""
    Local cTipo      := ""
    Local cProjeto   := ""
    Local cTarefa    := ""
    Local cEmailCli  := ""
    Local cNomeProj  := ""
    Local cNomeTaf   := ""
    Local oErro      := Nil
    Local cFilAtu    := xFilial("ZA1")
    Local cIdChParam := ""
    Local cTextoParam := ""
    Local lIncluirLinha := .T.

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    Begin Sequence

        nPagina   := CH_LERJSONNUM(jQuery, "pagina")
        nPagina   := If(nPagina < 1, 1, nPagina)
        nTamanho  := CH_LERJSONNUM(jQuery, "tamanho")
        nTamanho  := If(nTamanho < 1 .Or. nTamanho > 100, 10, nTamanho)
        nStartIdx := (nPagina - 1) * nTamanho + 1

        // idCh tem prioridade absoluta (documentado no cabecalho da funcao,
        // mas nunca implementado - o Get sempre devolvia a pagina inteira e
        // ignorava esse parametro). Usado por ChamadoServ.buscarPorId() (front)
        // pra "Visualizar" e pra resolver a lupa de Chamado do CNS009 - sem
        // esse filtro, tamanho=1 sempre devolvia so o chamado mais recente,
        // nunca o idCh pedido.
        cIdChParam  := AllTrim(CH_LERJSONTXT(jQuery, "idCh"))
        // Busca livre (caixa "Pesquisar" do front) - unica excecao a regra
        // "sem filtro de negocio no backend": inviavel filtrar no front
        // quando a ZA1 tem milhares de linhas e a listagem e paginada (o
        // front so tem a pagina atual carregada). Mesma logica/motivo da
        // busca da OS (OS_APILISTAR) - so que aqui via loop nativo (ZA1 nao
        // tem SQL nesta funcao), resolvendo nome de cliente/tecnico so das
        // linhas varridas, e so quando o parametro vem preenchido.
        cTextoParam := Upper(AllTrim(CH_LERJSONTXT(jQuery, "texto")))

        dbSelectArea("ZA1")
        ZA1->(DbSetOrder(1))
        If !Empty(cIdChParam)
            If ZA1->(DbSeek(cFilAtu + cIdChParam))
                AAdd(aTodos, {;
                    AllTrim(ZA1->ZA1_IDCH), ;
                    CH_DECODESAFE(AllTrim(ZA1->ZA1_ASSUNT)), ;
                    AllTrim(ZA1->ZA1_STATUS), ;
                    AllTrim(ZA1->ZA1_CONSUL), ;
                    AllTrim(ZA1->ZA1_CLIENT), ;
                    AllTrim(ZA1->ZA1_LOJA), ;
                    AllTrim(ZA1->ZA1_TIPO), ;
                    AllTrim(ZA1->ZA1_PROJ), ;
                    AllTrim(ZA1->ZA1_TAREFA), ;
                    AllTrim(ZA1->ZA1_EMAIL), ;
                    ZA1->ZA1_DATA, ;
                    CH_DECODESAFE(AllTrim(ZA1->ZA1_ANOT)) ;
                })
            EndIf
        ElseIf ZA1->(DbSeek(cFilAtu))
            While !ZA1->(Eof()) .And. ZA1->ZA1_FILIAL == cFilAtu
                lIncluirLinha := .T.

                If !Empty(cTextoParam)
                    cCodConsul := AllTrim(ZA1->ZA1_CONSUL)
                    cCodCli    := AllTrim(ZA1->ZA1_CLIENT)
                    cNomeTec   := If(Empty(cCodConsul), "", AllTrim(Posicione("AA1", 1, xFilial("AA1") + cCodConsul, "AA1_NOMTEC")))
                    cNomeCli   := If(Empty(cCodCli), "", AllTrim(Posicione("SA1", 1, xFilial("SA1") + cCodCli + AllTrim(ZA1->ZA1_LOJA), "A1_NREDUZ")))

                    lIncluirLinha := (cTextoParam $ Upper(AllTrim(ZA1->ZA1_IDCH))) .Or. ;
                        (cTextoParam $ Upper(CH_DECODESAFE(AllTrim(ZA1->ZA1_ASSUNT)))) .Or. ;
                        (cTextoParam $ Upper(cNomeCli)) .Or. ;
                        (cTextoParam $ Upper(cNomeTec))
                EndIf

                If lIncluirLinha
                    AAdd(aTodos, {;
                        AllTrim(ZA1->ZA1_IDCH), ;
                        CH_DECODESAFE(AllTrim(ZA1->ZA1_ASSUNT)), ;
                        AllTrim(ZA1->ZA1_STATUS), ;
                        AllTrim(ZA1->ZA1_CONSUL), ;
                        AllTrim(ZA1->ZA1_CLIENT), ;
                        AllTrim(ZA1->ZA1_LOJA), ;
                        AllTrim(ZA1->ZA1_TIPO), ;
                        AllTrim(ZA1->ZA1_PROJ), ;
                        AllTrim(ZA1->ZA1_TAREFA), ;
                        AllTrim(ZA1->ZA1_EMAIL), ;
                        ZA1->ZA1_DATA, ;
                        CH_DECODESAFE(AllTrim(ZA1->ZA1_ANOT)) ;
                    })
                EndIf

                ZA1->(DbSkip())
            EndDo
        EndIf

        nTotal := Len(aTodos)

        // Ordem 1 (FILIAL+IDCH) e ascendente - percorre o array de tras pra
        // frente na pagina pedida pra manter "mais recente primeiro".
        nI   := nTotal - nStartIdx + 1
        nFim := Max(nTotal - (nStartIdx + nTamanho - 1) + 1, 1)

        While nI >= nFim .And. nI >= 1
            cCodConsul := aTodos[nI][4]
            cCodCli    := aTodos[nI][5]
            cLoja      := aTodos[nI][6]

            nPosCache := AScan(aCacheTec, {|x| x[1] == cCodConsul})
            If nPosCache > 0
                cNomeTec := aCacheTec[nPosCache][2]
            ElseIf Empty(cCodConsul)
                cNomeTec := ""
            Else
                cNomeTec := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cCodConsul, "AA1_NOMTEC"))
                AAdd(aCacheTec, {cCodConsul, cNomeTec})
            EndIf

            nPosCache := AScan(aCacheCli, {|x| x[1] == cCodCli + cLoja})
            If nPosCache > 0
                cNomeCli := aCacheCli[nPosCache][2]
            ElseIf Empty(cCodCli)
                cNomeCli := ""
            Else
                cNomeCli := AllTrim(Posicione("SA1", 1, xFilial("SA1") + cCodCli + cLoja, "A1_NREDUZ"))
                AAdd(aCacheCli, {cCodCli + cLoja, cNomeCli})
            EndIf

            cTipo     := aTodos[nI][7]
            cProjeto  := aTodos[nI][8]
            cTarefa   := aTodos[nI][9]
            cEmailCli := aTodos[nI][10]

            nPosCache := AScan(aCacheProj, {|x| x[1] == cProjeto})
            If nPosCache > 0
                cNomeProj := aCacheProj[nPosCache][2]
            ElseIf Empty(cProjeto)
                cNomeProj := ""
            Else
                cNomeProj := AllTrim(Posicione("AF8", 1, xFilial("AF8") + cProjeto, "AF8_DESCRI"))
                AAdd(aCacheProj, {cProjeto, cNomeProj})
            EndIf

            nPosCache := AScan(aCacheTaf, {|x| x[1] == cProjeto + cTarefa})
            If nPosCache > 0
                cNomeTaf := aCacheTaf[nPosCache][2]
            ElseIf Empty(cTarefa)
                cNomeTaf := ""
            Else
                cNomeTaf := AllTrim(Posicione("AF9", 1, xFilial("AF9") + cProjeto + cTarefa, "AF9_DESCRI"))
                AAdd(aCacheTaf, {cProjeto + cTarefa, cNomeTaf})
            EndIf

            oLinha := JsonObject():New()
            oLinha['idCh']         := aTodos[nI][1]
            oLinha['assunto']      := aTodos[nI][2]
            oLinha['status']       := aTodos[nI][3]
            oLinha['tecnico']      := cNomeTec
            oLinha['codConsultor'] := cCodConsul
            oLinha['cliente']      := cNomeCli
            oLinha['codCliente']   := cCodCli
            oLinha['lojaCliente']  := cLoja
            oLinha['tipo']         := cTipo
            oLinha['projeto']      := cProjeto
            oLinha['nomeProjeto']  := cNomeProj
            oLinha['tarefa']       := cTarefa
            oLinha['nomeTarefa']   := cNomeTaf
            oLinha['emailCliente'] := cEmailCli
            // Descricao do chamado - reaproveita ZA1_ANOT (Caractere 200, antigas
            // anotacoes, substituidas pelo historico ZA2).
            oLinha['descricao']    := aTodos[nI][12]
            oLinha['data']         := CH_DATAISOZA1(If(ValType(aTodos[nI][11]) == "D", DToS(aTodos[nI][11]), cValToChar(aTodos[nI][11])))
            AAdd(aRetorno, oLinha)

            nI--
        EndDo

        oJson['total']        := nTotal
        oJson['totalPaginas'] := If(nTotal == 0, 0, Ceiling(nTotal / nTamanho))
        oJson['pagina']       := nPagina
        oJson['tamanho']      := nTamanho
        // Front usa pra habilitar/desabilitar o controle de status - so
        // administrador (AA1_RSPMNT) pode alterar status (ver CH_NUCLEOALTERAR/
        // CH_PREVALIDA, que tambem bloqueiam no backend independente disso).
        oJson['podeAlterarStatus'] := CH_TEMACESSOGRUPO()
        oJson['items']        := aRetorno

        Return oRest:setStatusResponse(200, oJson:ToJson())

    Recover Using oErro
        If oErro != Nil
            Return oRest:setStatusResponse(500, '{"erro":"' + CH_ESCAPARJSON(oErro:Description) + '"}')
        EndIf
    End Sequence

Return oRest:setStatusResponse(500, '{"erro":"Erro desconhecido."}')

/*/{Protheus.doc} CH_PROXIMASEQ
Calcula a proxima sequencia (Z6_SEQ) de agendamento de um tecnico numa
data especifica.
AGENDAR - orquestracao do REST (nao existe na tela classica: intervalo de dias, lock, sobreposicao, retry). Valor agregado, mantido como esta.
@param  cTecnico   Codigo do tecnico (AA1)
@param  dData      Data do agendamento
@return Sequencia formatada em 3 digitos
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_PROXIMASEQ(cTecnico, dData)
    Local cAlias := GetNextAlias()
    Local nSeq   := 1

    BeginSql Alias cAlias
        SELECT MAX(SZ6.Z6_SEQ) MAXSEQ
        FROM %Table:SZ6% SZ6
        WHERE SZ6.Z6_FILIAL  = %xFilial:SZ6%
          AND SZ6.Z6_TECNICO = %Exp:cTecnico%
          AND SZ6.Z6_DTAGE   = %Exp:dData%
          AND %NotDel%
    EndSql

    If !(cAlias)->(Eof()) .And. !Empty((cAlias)->MAXSEQ)
        nSeq := Val((cAlias)->MAXSEQ) + 1
    EndIf
    (cAlias)->(DbCloseArea())

Return PadL(AllTrim(Str(nSeq)), 3, "0")

/*/{Protheus.doc} CH_GRAVARAGENDA
Grava um dia de agenda via Model (CNSA003) em vez de RecLock direto na SZ6. LockByName/UnLockByName: assinatura pode variar por build do TOTVS.
@param  cIdCh              Id do chamado (ZA1_IDCH)
@param  cDataIni           Data inicial do intervalo (AAAA-MM-DD)
@param  cDataFim           Data final do intervalo (AAAA-MM-DD, default = cDataIni)
@param  cCodTecnico        Codigo do tecnico (AA1)
@param  cHoraIni           Hora inicial (HH:MM)
@param  cHoraFim           Hora final (HH:MM)
@param  cCodCliente        Codigo do cliente (SA1)
@param  cLojaCliente       Loja do cliente (default "01")
@param  cDescricao         Descricao/servico do agendamento
@param  cConfirmacao       Confirmacao do agendamento
@param  cTurno             Turno do agendamento
@param  cAgInterna         Agenda interna (SIM/NAO)
@param  cAgCobravel        Agenda cobravel (SIM/NAO)
@param  cTipoAgenda        Tipo de agenda
@param  cProjeto           Codigo do projeto
@param  cRevisao           Revisao do projeto
@param  cTarefa            Codigo da tarefa
@param  cTipoHora          Tipo de hora
@param  cCodAgendador      Codigo de quem esta agendando (default: usuario da sessao)
@param  lNotificarTecnico  .T. pra enviar ao analista o e-mail de agendamento (default .T.)
@return Array {nStatusHTTP, cCorpoJson}
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_GRAVARAGENDA(cIdCh, cDataIni, cDataFim, cCodTecnico, cHoraIni, cHoraFim, cCodCliente, ;
    cLojaCliente, cDescricao, cConfirmacao, cTurno, cAgInterna, cAgCobravel, cTipoAgenda, cProjeto, ;
    cRevisao, cTarefa, cTipoHora, cCodAgendador, lNotificarTecnico)
    Local nCham       := 0
    Local dDataIni    := CToD("")
    Local dDataFim    := CToD("")
    Local dAtual      := CToD("")
    Local cDataIso    := ""
    Local nCriados    := 0
    Local nTotalDias  := 0
    Local cSeq        := ""
    Local oJson       := JsonObject():New()
    Local oErro       := Nil
    Local oErroLoop   := Nil
    Local oErroDia    := Nil
    Local cLockKey    := ""
    Local lLockOk     := .F.
    Local aFalhas     := {}
    Local oFalha      := Nil
    Local nTentativa  := 0
    Local lGravouDia  := .F.
    Local oModel      := Nil
    Local oModelSZ6   := Nil
    Local lOkModel    := .F.

    Begin Sequence

        // Campo obrigatorio (idCh/data/tecnico/horario/cliente) e "data final
        // antes da inicial" nao validam mais aqui - front-end valida antes de
        // chamar (sem Model do lado da ZA1 neste nucleo, SetErrorMessage nao
        // se aplica). Ficam so protecoes tecnicas: "chamado nao encontrado"
        // (so o backend sabe), "data invalida" (parse de STOD, evita
        // downstream com data vazia) e o teto de 730 dias (protege o
        // servidor de uma chamada que gere agenda pra um intervalo absurdo).
        Default cDataFim := cDataIni
        Default cLojaCliente := "01"
        Default lNotificarTecnico := .T.

        dbSelectArea("ZA1")
        ZA1->(DbSetOrder(1))
        If !ZA1->(DbSeek(xFilial("ZA1") + cIdCh))
            Return {404, '{"erro":"Chamado nao encontrado."}'}
        EndIf

        nCham := Val(cIdCh)

        dDataIni := STOD(StrTran(cDataIni, "-", ""))
        dDataFim := STOD(StrTran(cDataFim, "-", ""))

        If Empty(dDataIni) .Or. Empty(dDataFim)
            Return {400, '{"erro":"Data invalida."}'}
        EndIf

        If (dDataFim - dDataIni) > 730
            Return {400, '{"erro":"Intervalo maximo de 2 anos (730 dias) por agendamento."}'}
        EndIf

        If Empty(cCodAgendador)
            cCodAgendador := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_NOMTEC"))
        EndIf

        nTotalDias := (dDataFim - dDataIni) + 1

        cLockKey := "CNS001_AGENDA_" + cCodTecnico
        lLockOk  := LockByName(cLockKey, .F., .T., 10)
        If !lLockOk
            Return {423, '{"erro":"Outro agendamento para este tecnico esta em andamento. Tente novamente."}'}
        EndIf

        Begin Sequence

            dAtual := dDataIni
            While dAtual <= dDataFim
                cDataIso := SubStr(DTOS(dAtual), 1, 4) + "-" + SubStr(DTOS(dAtual), 5, 2) + "-" + SubStr(DTOS(dAtual), 7, 2)

                lGravouDia := .F.
                oErroDia   := Nil
                For nTentativa := 1 To 3
                    Begin Sequence
                        cSeq := CH_PROXIMASEQ(cCodTecnico, dAtual)

                        oModel := FWLoadModel("CNSA003")
                        oModel:SetOperation(MODEL_OPERATION_INSERT)
                        oModel:Activate()
                        oModelSZ6 := oModel:GetModel("ModelSZ6_Main")

                        oModelSZ6:SetValue("Z6_FILIAL",  xFilial("SZ6"))
                        oModelSZ6:SetValue("Z6_CHAMADO", nCham)
                        oModelSZ6:SetValue("Z6_DTAGE",   dAtual)
                        oModelSZ6:SetValue("Z6_TECNICO", cCodTecnico)
                        oModelSZ6:SetValue("Z6_SEQ",     cSeq)
                        oModelSZ6:SetValue("Z6_HMINI",   cHoraIni)
                        oModelSZ6:SetValue("Z6_HMFIM",   cHoraFim)
                        oModelSZ6:SetValue("Z6_CLIENTE", cCodCliente)
                        oModelSZ6:SetValue("Z6_LOJA",    cLojaCliente)
                        oModelSZ6:SetValue("Z6_SERVICO", cDescricao)
                        oModelSZ6:SetValue("Z6_CONFIRM", If(Empty(cConfirmacao), "NAO", cConfirmacao))
                        oModelSZ6:SetValue("Z6_TURNO",   Val(cTurno))
                        oModelSZ6:SetValue("Z6_INTERNO", If(Empty(cAgInterna), "NAO", cAgInterna))
                        oModelSZ6:SetValue("Z6_COBRAR",  If(Empty(cAgCobravel), "NAO", cAgCobravel))
                        oModelSZ6:SetValue("Z6_TIPOAG",  cTipoAgenda)
                        oModelSZ6:SetValue("Z6_PROJET",  cProjeto)
                        oModelSZ6:SetValue("Z6_REVISA",  cRevisao)
                        oModelSZ6:SetValue("Z6_TAREFA",  cTarefa)
                        oModelSZ6:SetValue("Z6_TIPO_HR", cTipoHora)
                        oModelSZ6:SetValue("Z6_QGRAVOU", cCodAgendador)

                        If oModel:VldData()
                            lOkModel := oModel:CommitData()
                        Else
                            lOkModel := .F.
                        EndIf
                        oModel:DeActivate(lOkModel)

                        lGravouDia := lOkModel
                        If !lGravouDia
                            oErroDia := ErrorNew()
                            oErroDia:Description := "Falha de validacao/gravacao do Model CNSA003"
                        EndIf
                    Recover Using oErroDia
                        lGravouDia := .F.
                        // FIX: excecao real (nao so VldData==.F.) antes da linha
                        // DeActivate() acima deixava o model de CNSA003 pendurado
                        // entre tentativas do retry - desativa aqui tambem.
                        If oModel <> Nil
                            oModel:DeActivate()
                        EndIf
                    End Sequence

                    If lGravouDia
                        Exit
                    EndIf
                Next nTentativa

                If lGravouDia
                    nCriados++
                Else
                    oFalha := JsonObject():New()
                    oFalha['data'] := cDataIso
                    oFalha['erro'] := "Falha ao gravar apos 3 tentativas: " + If(oErroDia != Nil, oErroDia:Description, "erro desconhecido")
                    AAdd(aFalhas, oFalha)
                EndIf

                dAtual := dAtual + 1
            EndDo

        Recover Using oErroLoop
        End Sequence

        UnLockByName(cLockKey, .T.)

        If oErroLoop != Nil
            Return {500, '{"erro":"' + CH_ESCAPARJSON(oErroLoop:Description) + '"}'}
        EndIf

        If nCriados > 0 .And. lNotificarTecnico
            CH_NOTIFICARAGENDAMENTO(cIdCh, cCodTecnico, ;
                DToC(dDataIni) + If(dDataFim > dDataIni, " a " + DToC(dDataFim), ""), cHoraIni, cHoraFim, cDescricao)
        EndIf

        oJson['sucesso']    := nCriados > 0
        oJson['idCh']       := cIdCh
        oJson['quantidade'] := nCriados
        oJson['falhas']     := aFalhas
        oJson['mensagem']   := AllTrim(Str(nCriados)) + " de " + AllTrim(Str(nTotalDias)) + " dia(s) criado(s) com sucesso."

        Return {If(nCriados > 0, 200, 500), oJson:ToJson()}

    Recover Using oErro
        Return {500, '{"erro":"' + CH_ESCAPARJSON(oErro:Description) + '"}'}
    End Sequence

Return {500, '{"erro":"Erro desconhecido."}'}

/*/{Protheus.doc} CH_APIAGENDAR
Endpoint REST POST /CNSACHAMADOSAGENDAR: cria agendamento(s) para um
chamado a partir dos parametros da query string, chamando CH_GRAVARAGENDA.
Agendar - endpoint REST (mesmo path que CNS001Rest.tlpp)
@return Logical - resposta HTTP com o resultado do agendamento
@author Henrique
@since 02/09/2026
@version P12
/*/
@Post(endpoint="/CNSACHAMADOSAGENDAR")
User Function CH_APIAGENDAR() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    aResultado := CH_GRAVARAGENDA(AllTrim(CH_LERJSONTXT(jQuery,"idCh")), AllTrim(CH_LERJSONTXT(jQuery,"dataInicio")), AllTrim(CH_LERJSONTXT(jQuery,"dataFim")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"codTecnico")), AllTrim(CH_LERJSONTXT(jQuery,"horaInicio")), AllTrim(CH_LERJSONTXT(jQuery,"horaFim")), AllTrim(CH_LERJSONTXT(jQuery,"codCliente")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"lojaCliente")), AllTrim(CH_LERJSONTXT(jQuery,"descricao")), AllTrim(CH_LERJSONTXT(jQuery,"confirmacao")), AllTrim(CH_LERJSONTXT(jQuery,"turno")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"agInterna")), AllTrim(CH_LERJSONTXT(jQuery,"agCobravel")), AllTrim(CH_LERJSONTXT(jQuery,"tipoAgenda")), AllTrim(CH_LERJSONTXT(jQuery,"projeto")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"revisao")), AllTrim(CH_LERJSONTXT(jQuery,"tarefa")), AllTrim(CH_LERJSONTXT(jQuery,"tipoHora")), AllTrim(CH_LERJSONTXT(jQuery,"codAgendador")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"notificarTecnico")) != "0")

Return oRest:setStatusResponse(aResultado[1], aResultado[2])

/*/{Protheus.doc} CH_AGENDAJSON
Monta o JSON com os agendamentos (SZ6) de um chamado, ordenados por
data/hora, com tecnico/cliente resolvidos por nome.
Ver Agenda - endpoint REST (mesmo path que CNS001Rest.tlpp)
@param  cIdCh   Id do chamado (ZA1_IDCH)
@return Array {nStatusHTTP, cCorpoJson}
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_AGENDAJSON(cIdCh)
    Local cAlias   := ""
    Local oJson    := JsonObject():New()
    Local aItens   := {}
    Local oLinha   := Nil
    Local cDataIso := ""
    Local cCodCli  := ""
    Local cLoja    := ""
    Local oErro    := Nil
    // FIX: Z6_CHAMADO e Numeric - comparar com a string cIdCh direto nunca
    // bate no Oracle, endpoint sempre devolvia lista vazia. Ja foi corrigido
    // 1x antes e revertido por edicao concorrente - NAO REVERTER de novo.
    Local nCham    := Val(cIdCh)

    Begin Sequence

        dbSelectArea("ZA1")
        ZA1->(DbSetOrder(1))
        If !ZA1->(DbSeek(xFilial("ZA1") + cIdCh))
            Return {404, '{"erro":"Chamado nao encontrado."}'}
        EndIf

        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT Z6_DTAGE, Z6_HMINI, Z6_HMFIM, Z6_TECNICO, Z6_CLIENTE, Z6_LOJA, Z6_SERVICO
            FROM %Table:SZ6% SZ6
            WHERE Z6_FILIAL  = %xFilial:SZ6%
              AND Z6_CHAMADO = %Exp:nCham%
              AND %NotDel%
            ORDER BY Z6_DTAGE, Z6_HMINI
        EndSql

        While !(cAlias)->(Eof())
            If ValType((cAlias)->Z6_DTAGE) == "D"
                cDataIso := DToS((cAlias)->Z6_DTAGE)
            Else
                cDataIso := AllTrim((cAlias)->Z6_DTAGE)
            EndIf
            If Len(cDataIso) == 8
                cDataIso := SubStr(cDataIso, 1, 4) + "-" + SubStr(cDataIso, 5, 2) + "-" + SubStr(cDataIso, 7, 2)
            EndIf

            cCodCli := AllTrim((cAlias)->Z6_CLIENTE)
            cLoja   := AllTrim((cAlias)->Z6_LOJA)

            oLinha := JsonObject():New()
            oLinha['data']       := cDataIso
            oLinha['horaInicio'] := AllTrim((cAlias)->Z6_HMINI)
            oLinha['horaFim']    := AllTrim((cAlias)->Z6_HMFIM)
            oLinha['tecnico']    := AllTrim(Posicione("AA1", 1, xFilial("AA1") + AllTrim((cAlias)->Z6_TECNICO), "AA1_NOMTEC"))
            oLinha['cliente']    := AllTrim(Posicione("SA1", 1, xFilial("SA1") + cCodCli + cLoja, "A1_NREDUZ"))
            oLinha['descricao']  := CH_DECODESAFE(AllTrim((cAlias)->Z6_SERVICO))
            AAdd(aItens, oLinha)

            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())

        oJson['idCh']  := cIdCh
        oJson['items'] := aItens

        Return {200, oJson:ToJson()}

    Recover Using oErro
        Return {500, '{"erro":"' + CH_ESCAPARJSON(oErro:Description) + '"}'}
    End Sequence

Return {500, '{"erro":"Erro desconhecido."}'}

/*/{Protheus.doc} CH_APIMEUCONSULTOR
Endpoint REST GET /CNSACHAMADOSMEU: devolve o codigo e nome do consultor
(AA1) vinculado ao usuario da sessao logada.
Consultor da sessao logada (AA1_CODTEC) - o filtro "Meus chamados" e 100% front-end (regra do usuario/chefe), mas o front precisa saber quem e o usuario pra comparar contra ZA1_CONSUL. Nao existia nenhum endpoint que devolvesse isso.
@return Logical - resposta HTTP 200 com codConsultor/nomeTecnico
@author Henrique
@since 02/09/2026
@version P12
/*/
@Get(endpoint="/CNSACHAMADOSMEU")
User Function CH_APIMEUCONSULTOR() As Logical
    Local oJson      := JsonObject():New()
    Local cConsultor := Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC")
    Local cNomeTec   := ""

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If !Empty(cConsultor)
        cNomeTec := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cConsultor, "AA1_NOMTEC"))
    EndIf

    oJson['codConsultor'] := AllTrim(cConsultor)
    oJson['nomeTecnico']  := cNomeTec

Return oRest:setStatusResponse(200, oJson:ToJson())

/*/{Protheus.doc} CH_APIVERAGENDA
Endpoint REST GET /CNSACHAMADOSVERAGENDA: lista os agendamentos de um
chamado (idCh via query), chamando CH_AGENDAJSON.
@return Logical - resposta HTTP com o JSON de agendamentos
@author Henrique
@since 02/09/2026
@version P12
/*/
@Get(endpoint="/CNSACHAMADOSVERAGENDA")
User Function CH_APIVERAGENDA() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    aResultado := CH_AGENDAJSON(AllTrim(CH_LERJSONTXT(jQuery,"idCh")))

Return oRest:setStatusResponse(aResultado[1], aResultado[2])


/*/{Protheus.doc} CH_GRAVARINTERACAO
Grava uma interacao (ZA2) para um chamado, via Model CNSAZA2VIEW - mesmo
caminho usado pela tela classica (CNSA_INTERAGIR).
INTERACOES (ZA2) - historico, endpoints REST (mesmos paths). Substitui ZA1_ANOT. Unificado com o Model ja usado pela tela classica (CNSA_INTERAGIR -> FWLoadModel("CNSAZA2VIEW")) - evita reimplementar a inclusao via RecLock direto (2a copia da mesma acao).
@param  cIdCh        Id do chamado (ZA1_IDCH)
@param  cConsultor   Codigo do consultor autor da interacao
@param  cTexto       Texto da interacao
@param  cOs          Numero da OS que gerou a interacao (ZA2_OS) - opcional
@param  cErro        (referencia) mensagem de erro do Model quando a gravacao falha
@return cSeq   Sequencia (3 digitos) da interacao gravada - vazio se falhou
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_GRAVARINTERACAO(cIdCh, cConsultor, cTexto, cOs, cErro)
    Local cAlias      := GetNextAlias()
    Local nSeq        := 1
    Local oModel      := Nil
    Local oModelZA2   := Nil
    Local lOk         := .F.
    Local oErroModel  := Nil

    Default cOs := ""

    cErro := ""

    // FIX: ZA2_IDCH e Character. O filtro SQL abaixo precisa comparar
    // Character com Character - usar numero aqui (%Exp:nChamN%) da
    // ORA-01722 "invalid number" (confirmado em producao: Oracle tenta
    // converter a coluna Character pra number pra comparar, e quebra).
    // NAO usar Val() aqui.

    BeginSql Alias cAlias
        SELECT MAX(ZA2_IDGRID) MAXGRID
        FROM %Table:ZA2% ZA2
        WHERE ZA2_FILIAL = %xFilial:ZA2%
          AND ZA2_IDCH   = %Exp:cIdCh%
          AND %NotDel%
    EndSql
    If !(cAlias)->(Eof()) .And. !Empty(AllTrim((cAlias)->MAXGRID))
        nSeq := Val(AllTrim((cAlias)->MAXGRID)) + 1
    EndIf
    (cAlias)->(DbCloseArea())

    oModel := FWLoadModel("CNSAZA2VIEW")
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()
    oModelZA2 := oModel:GetModel("ZA2MASTER")

    oModelZA2:SetValue("ZA2_IDCH",   cIdCh)
    oModelZA2:SetValue("ZA2_CONSUL", cConsultor)
    oModelZA2:SetValue("ZA2_DATA",   Date())
    oModelZA2:SetValue("ZA2_IDGRID", StrZero(nSeq, 3))
    oModelZA2:SetValue("ZA2_HORA",   Left(Time(), 5))
    oModelZA2:SetValue("ZA2_DESCRI", cTexto)
    If !Empty(cOs)
        oModelZA2:SetValue("ZA2_OS", cOs)
    EndIf

    If oModel:VldData()
        lOk := oModel:CommitData()
    Else
        lOk := .F.
    EndIf

    If !lOk
        oErroModel := oModel:GetErrorMessage()
        ConOut("CH_GRAVARINTERACAO: falha ao gravar via Model CNSAZA2VIEW: " + FwJsonSerialize(oErroModel))
        // FIX: antes devolvia a sequencia mesmo com falha e o REST respondia
        // "Interacao adicionada com sucesso" sem ter gravado nada.
        If ValType(oErroModel) == "A" .And. Len(oErroModel) >= 6 .And. !Empty(oErroModel[6])
            cErro := AllTrim(cValToChar(oErroModel[6]))
        Else
            cErro := "Falha ao gravar a interacao."
        EndIf
    EndIf

    oModel:DeActivate(lOk)

Return If(lOk, StrZero(nSeq, 3), "")

/*/{Protheus.doc} CH_LISTARINTERACOES
Monta o JSON com as interacoes (ZA2) de um chamado, ordenadas por
sequencia, com consultor resolvido por nome.
@param  cIdCh   Id do chamado (ZA1_IDCH)
@return Array {nStatusHTTP, cCorpoJson}
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_LISTARINTERACOES(cIdCh)
    Local oJson     := JsonObject():New()
    Local aItens    := {}
    Local oLinha    := Nil
    Local cAlias    := ""
    Local cNomeCons := ""
    Local cDataIso  := ""
    Local oErro     := Nil

    Begin Sequence

        dbSelectArea("ZA1")
        ZA1->(DbSetOrder(1))
        If !ZA1->(DbSeek(xFilial("ZA1") + cIdCh))
            Return {404, '{"erro":"Chamado nao encontrado."}'}
        EndIf

        cAlias := GetNextAlias()

        // ZA2_DESCRI (Memo) precisa ser a ULTIMA coluna do SELECT - o DBAccess
        // nao traz campo LOB que nao esteja no fim (invalid field name).
        BeginSql Alias cAlias
            SELECT ZA2_IDGRID, ZA2_CONSUL, ZA2_DATA, ZA2_HORA, ZA2_OS, ZA2_DESCRI
            FROM %Table:ZA2% ZA2
            WHERE ZA2_FILIAL = %xFilial:ZA2%
              AND ZA2_IDCH   = %Exp:cIdCh%
              AND %NotDel%
            ORDER BY ZA2_IDGRID
        EndSql

        While !(cAlias)->(Eof())
            If ValType((cAlias)->ZA2_DATA) == "D"
                cDataIso := DToS((cAlias)->ZA2_DATA)
            Else
                cDataIso := AllTrim((cAlias)->ZA2_DATA)
            EndIf
            If Len(cDataIso) == 8
                cDataIso := SubStr(cDataIso, 1, 4) + "-" + SubStr(cDataIso, 5, 2) + "-" + SubStr(cDataIso, 7, 2)
            EndIf

            // FIX: mesmo bug do soft-seek do ZA1_CONSUL (ver CH_NUCLEOINCLUIR) -
            // Posicione com codigo vazio cai no primeiro registro da AA1 (Luiz
            // Muller) em vez de devolver vazio. Interacao do e-mail nasce sem
            // consultor (CH_GRAVARINTERACAO chamado com cConsultor="").
            If Empty(AllTrim((cAlias)->ZA2_CONSUL))
                cNomeCons := ""
            Else
                cNomeCons := AllTrim(Posicione("AA1", 1, xFilial("AA1") + AllTrim((cAlias)->ZA2_CONSUL), "AA1_NOMTEC"))
            EndIf

            oLinha := JsonObject():New()
            oLinha['seq']       := AllTrim((cAlias)->ZA2_IDGRID)
            oLinha['consultor'] := cNomeCons
            oLinha['data']      := cDataIso
            oLinha['hora']      := AllTrim((cAlias)->ZA2_HORA)
            oLinha['texto']     := CH_DECODESAFE(AllTrim((cAlias)->ZA2_DESCRI))
            oLinha['os']        := AllTrim((cAlias)->ZA2_OS)
            AAdd(aItens, oLinha)

            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())

        oJson['idCh']  := cIdCh
        oJson['items'] := aItens

        Return {200, oJson:ToJson()}

    Recover Using oErro
        Return {500, '{"erro":"' + CH_ESCAPARJSON(oErro:Description) + '"}'}
    End Sequence

Return {500, '{"erro":"Erro desconhecido."}'}

/*/{Protheus.doc} CH_APILISTAINTERACOES
Endpoint REST GET /CNSACHAMADOSINTERACOES: lista as interacoes de um
chamado (idCh via query), chamando CH_LISTARINTERACOES.
@return Logical - resposta HTTP com o JSON de interacoes
@author Henrique
@since 02/09/2026
@version P12
/*/
@Get(endpoint="/CNSACHAMADOSINTERACOES")
User Function CH_APILISTAINTERACOES() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    aResultado := CH_LISTARINTERACOES(AllTrim(CH_LERJSONTXT(jQuery,"idCh")))

Return oRest:setStatusResponse(aResultado[1], aResultado[2])

/*/{Protheus.doc} CH_INCLUIRINTERACAO
Inclui uma interacao para um chamado (usado pelo endpoint REST), validando
tamanho maximo do campo e chamando CH_GRAVARINTERACAO com o consultor da sessao.
Notifica o cliente (ZA1_EMAIL) quando lNotificarCliente for .T.
@param  cIdCh               Id do chamado (ZA1_IDCH)
@param  cTexto              Texto da interacao
@param  lNotificarCliente   .T. pra tambem enviar e-mail ao cliente sobre a interacao
@param  cOs                 Numero da OS que gerou a interacao (ZA2_OS) - opcional
@return Array {nStatusHTTP, cCorpoJson}
@author Henrique
@since 02/09/2026
@version P12
@update 17/09/2026 - Adiciona lNotificarCliente (e-mail ao cliente com o texto da interacao)
/*/
Static Function CH_INCLUIRINTERACAO(cIdCh, cTexto, lNotificarCliente, cOs)
    Local oJson      := JsonObject():New()
    Local oErro      := Nil
    Local cConsultor := ""
    Local cSeq       := ""
    Local cEmailCli  := ""
    Local cErroGrv   := ""

    Default lNotificarCliente := .F.
    Default cOs               := ""

    cTexto := AllTrim(cTexto)

    Begin Sequence

        dbSelectArea("ZA1")
        ZA1->(DbSetOrder(1))
        If !ZA1->(DbSeek(xFilial("ZA1") + cIdCh))
            Return {404, '{"erro":"Chamado nao encontrado."}'}
        EndIf

        cEmailCli := AllTrim(ZA1->ZA1_EMAIL)

        // FIX: ZA2_DESCRI e Memo (TamSX3 devolve 10 - tamanho do ponteiro,
        // NAO limite real de conteudo). Validacao de tamanho contra TamSX3
        // rejeitava qualquer interacao com mais de 10 caracteres. Memo nao
        // tem limite de negocio conhecido - checagem removida.

        cConsultor := Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC")
        cSeq       := CH_GRAVARINTERACAO(cIdCh, cConsultor, cTexto, cOs, @cErroGrv)

        If Empty(cSeq)
            Return {500, '{"erro":"Interacao nao gravada: ' + CH_ESCAPARJSON(cErroGrv) + '"}'}
        EndIf

        If lNotificarCliente .And. !Empty(cEmailCli)
            CH_NOTIFICARINTERACAO(cEmailCli, cIdCh, cTexto, "incluida", "Nova Interacao")
        EndIf

        oJson['sucesso']  := .T.
        oJson['idCh']     := cIdCh
        oJson['seq']      := cSeq
        oJson['mensagem'] := "Interacao adicionada com sucesso."

        Return {200, oJson:ToJson()}

    Recover Using oErro
        Return {500, '{"erro":"' + CH_ESCAPARJSON(oErro:Description) + '"}'}
    End Sequence

Return {500, '{"erro":"Erro desconhecido."}'}

/*/{Protheus.doc} CH_APINOVAINTERACAO
Endpoint REST POST /CNSACHAMADOSINTERACOESINCLUIR: inclui uma interacao
para um chamado (idCh/texto via query), chamando CH_INCLUIRINTERACAO.
@return Logical - resposta HTTP com o resultado da inclusao
@author Henrique
@since 02/09/2026
@version P12
/*/
@Post(endpoint="/CNSACHAMADOSINTERACOESINCLUIR")
User Function CH_APINOVAINTERACAO() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    aResultado := CH_INCLUIRINTERACAO(AllTrim(CH_LERJSONTXT(jQuery,"idCh")), CH_LERJSONTXT(jQuery,"texto"), AllTrim(CH_LERJSONTXT(jQuery,"notificarCliente")) == "1", AllTrim(CH_LERJSONTXT(jQuery,"os")))

Return oRest:setStatusResponse(aResultado[1], aResultado[2])

/*/{Protheus.doc} CH_NUCLEOEXCLUIRINTERACAO
Nucleo compartilhado (tela + REST) de exclusao de interacao (ZA2): apaga o
registro via RecLock direto (sem Model, mesmo padrao de CH_NUCLEOEXCLUIR
pro chamado). So o autor da interacao ou administrador (CH_TEMACESSOGRUPO)
pode excluir; chamado fechado bloqueia. Notifica o cliente (ZA1_EMAIL)
com o texto da interacao removida quando lNotificarCliente for .T.
@param  cIdCh               Id do chamado (ZA1_IDCH)
@param  cSeq                Sequencia da interacao (ZA2_IDGRID, 3 digitos)
@param  lNotificarCliente   .T. pra tambem enviar e-mail ao cliente avisando da remocao
@return Array {nStatusHTTP, cMensagem}
@author Henrique
@since 17/09/2026
@version P12
/*/
Static Function CH_NUCLEOEXCLUIRINTERACAO(cIdCh, cSeq, lNotificarCliente)
    Local oErro      := Nil
    Local cAlias     := ""
    Local nRecno     := 0
    Local cConsultor := ""
    Local cAutorInteracao := ""
    Local cTexto     := ""
    Local cEmailCli  := ""
    Local cStatusCh  := ""

    Default lNotificarCliente := .F.

    Begin Sequence

        dbSelectArea("ZA1")
        ZA1->(DbSetOrder(1))
        If !ZA1->(DbSeek(xFilial("ZA1") + cIdCh))
            Return {404, "Chamado nao encontrado."}
        EndIf

        cStatusCh := AllTrim(ZA1->ZA1_STATUS)
        cEmailCli := AllTrim(ZA1->ZA1_EMAIL)

        If cStatusCh == "4"
            Return {400, "Chamado fechado nao pode ter interacoes excluidas."}
        EndIf

        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT ZA2.R_E_C_N_O_ RECNO, ZA2_CONSUL, ZA2_DESCRI
            FROM %Table:ZA2% ZA2
            WHERE ZA2.ZA2_FILIAL = %xFilial:ZA2%
              AND ZA2.ZA2_IDCH   = %Exp:cIdCh%
              AND ZA2.ZA2_IDGRID = %Exp:cSeq%
              AND %NotDel%
        EndSql

        If (cAlias)->(Eof())
            (cAlias)->(DbCloseArea())
            Return {404, "Interacao nao encontrada."}
        EndIf

        nRecno     := (cAlias)->RECNO
        cAutorInteracao := AllTrim((cAlias)->ZA2_CONSUL)
        cTexto     := CH_DECODESAFE(AllTrim((cAlias)->ZA2_DESCRI))
        (cAlias)->(DbCloseArea())

        cConsultor := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC"))

        If cAutorInteracao <> cConsultor .And. !CH_TEMACESSOGRUPO()
            Return {403, "Voce nao tem permissao para excluir esta interacao."}
        EndIf

        dbSelectArea("ZA2")
        ZA2->(DbGoTo(nRecno))
        RecLock("ZA2", .F.)
            ZA2->(DbDelete())
        ZA2->(MsUnlock())

        If lNotificarCliente .And. !Empty(cEmailCli)
            CH_NOTIFICARINTERACAO(cEmailCli, cIdCh, cTexto, "removida", "Interacao Removida")
        EndIf

        Return {200, "Interacao excluida com sucesso."}

    Recover Using oErro
        Return {500, "Erro interno: " + oErro:Description}
    End Sequence

Return {500, "Erro desconhecido."}

/*/{Protheus.doc} CH_APIEXCLUIRINTERACAO
Endpoint REST POST /CNSACHAMADOSINTERACOESEXCLUIR: exclui uma interacao de
um chamado (idCh/seq via query), chamando CH_NUCLEOEXCLUIRINTERACAO.
@return Logical - resposta HTTP com o resultado da exclusao
@author Henrique
@since 17/09/2026
@version P12
/*/
@Post(endpoint="/CNSACHAMADOSINTERACOESEXCLUIR")
User Function CH_APIEXCLUIRINTERACAO() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local cIdCh      := AllTrim(CH_LERJSONTXT(jQuery,"idCh"))
    Local cSeq       := AllTrim(CH_LERJSONTXT(jQuery,"seq"))
    Local aResultado := {}
    Local oJson      := JsonObject():New()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    aResultado := CH_NUCLEOEXCLUIRINTERACAO(cIdCh, cSeq, AllTrim(CH_LERJSONTXT(jQuery,"notificarCliente")) == "1")

    If aResultado[1] == 200
        oJson['sucesso']  := .T.
        oJson['idCh']     := cIdCh
        oJson['seq']      := cSeq
        oJson['mensagem'] := aResultado[2]
        Return oRest:setStatusResponse(200, oJson:ToJson())
    EndIf

Return oRest:setStatusResponse(aResultado[1], '{"erro":"' + CH_ESCAPARJSON(aResultado[2]) + '"}')

/*/{Protheus.doc} CH_ESCAPARJSON
Escapa caracteres especiais (barra invertida, aspas, quebras de linha,
tabulacao) de um texto para uso seguro dentro de uma string JSON.
@param  cTexto   Texto a escapar
@return cRet   Texto com os caracteres especiais escapados
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_ESCAPARJSON(cTexto)
    Local cRet := cTexto
    cRet := StrTran(cRet, '\',  '\\')
    cRet := StrTran(cRet, '"',  '\"')
    cRet := StrTran(cRet, Chr(13)+Chr(10), '\n')
    cRet := StrTran(cRet, Chr(10), '\n')
    cRet := StrTran(cRet, Chr(13), '\n')
    cRet := StrTran(cRet, Chr(9),  '\t')
Return cRet

/*/{Protheus.doc} CH_LERJSONNUM
Le um campo numerico de um JsonObject, com fallback seguro para 0 quando
o campo esta ausente.
@param  jDados   JsonObject de origem (ex: query string da requisicao)
@param  cCampo   Nome do campo a ler
@return Valor numerico do campo, ou 0 se ausente
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_LERJSONNUM(jDados, cCampo)
    Local xVal := jDados[cCampo]
    If xVal == Nil
        Return 0
    EndIf
Return Val(cValToChar(xVal))

/*/{Protheus.doc} CH_LERJSONTXT
Le um campo texto de um JsonObject (query string) ja decodificado de
UTF-8 (via CH_DECODESAFE), com fallback seguro para "" quando o campo
esta ausente ou nao e texto.
FIX (caracteres acentuados bugados no assunto/interacao/etc): campo de texto chega via querystring (nao corpo JSON - ver ChamadoServ.ts, todo POST manda body null), mesmo caminho da lupa (CNS001_LUPA_JSONSTR em cnslib.tlpp), que ja precisava de DecodeUTF8 pra bater certo. Centralizado aqui pra garantir exatamente 1 decodificacao por campo (decode duplicado em call sites separados foi o que bugou da ultima vez que isso foi tentado).
@param  jDados   JsonObject de origem (ex: query string da requisicao)
@param  cCampo   Nome do campo a ler
@return cTexto   Valor do campo, decodificado, ou "" se ausente/invalido
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_LERJSONTXT(jDados, cCampo)
    Local xVal := jDados[cCampo]
    If xVal == Nil .Or. ValType(xVal) != "C"
        Return ""
    EndIf
Return CH_DECODESAFE(xVal)

/*/{Protheus.doc} CH_DECODESAFE
Reconstroi manualmente (byte a byte) sequencias UTF-8 de 2 bytes lidas
como 2 chars CP1252 separados, devolvendo o caractere acentuado original.
Nunca lanca erro - texto fora do padrao passa inalterado.
FIX (Error -100 "Fail to write response" derrubando CNSACHAMADOS inteiro, e comportamento incerto do DecodeUTF8 nativo/2o parametro nesse ambiente): reconstrucao manual byte a byte em vez de confiar no DecodeUTF8 nativo. O bug classico "UTF-8 lido como CP1252": um char UTF-8 de 2 bytes (ex "ï¿½" = bytes 0xC3 0xA7) acaba armazenado/lido como 2 CHARS CP1252 separados ("ï¿½"= byte 195 + "ï¿½"=byte 167). Aqui remonta o par de bytes na formula padrao UTF-8 2-bytes (110xxxxx 10yyyyyy -> codepoint) e devolve o char original via Chr() - cobre toda a faixa Latin-1 acentuada (byte lider 0xC2/0xC3, que e exatamente U+0080-U+00FF, onde CP1252 e Unicode coincidem). Char que nao bate o padrao passa direto, sem alterar - nunca lanca erro (so Asc/Chr/SubStr), seguro mesmo com lixo/emoji misturado no texto.
@param  cTexto   Texto potencialmente com UTF-8 mal interpretado como CP1252
@return cRet   Texto com os pares de bytes UTF-8 decodificados
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_DECODESAFE(cTexto)
    Local cRet  := ""
    Local nLen  := Len(cTexto)
    Local nI    := 1
    Local nB1, nB2

    While nI <= nLen
        nB1 := Asc(SubStr(cTexto, nI, 1))
        If (nB1 == 195 .Or. nB1 == 194) .And. nI < nLen
            nB2 := Asc(SubStr(cTexto, nI + 1, 1))
            If nB2 >= 128 .And. nB2 <= 191
                cRet += Chr(((nB1 - 192) * 64) + (nB2 - 128))
                nI   += 2
                Loop
            EndIf
        EndIf
        cRet += SubStr(cTexto, nI, 1)
        nI++
    EndDo

Return cRet

/*/{Protheus.doc} CH_BACKFILLNOMES
Rotina de execucao unica: preenche ZA1_NOME/ZA1_NOMTEC de todos os
chamados (ZA1) ja existentes, agora que os dois viraram campo real (antes
eram virtuais, sem coluna fisica, por isso ficam vazios na conversao).
Mesma formula dos gatilhos CNSA_CLIENTE/CNSA_TECNICO; roda uma vez, antes
de tirar o Inic. Padrao/Browse do dicionario (SX3) desses dois campos.
@author Henrique
@since 09/09/2026
@version P12
/*/
User Function CH_BACKFILLNOMES()
    Local cCli      := ""
    Local cLoja     := ""
    Local cCons     := ""
    Local cNomeCli  := ""
    Local cNomeTec  := ""

    dbSelectArea("ZA1")
    ZA1->(DbGoTop())
    While !ZA1->(Eof())
        cCli  := AllTrim(ZA1->ZA1_CLIENT)
        cLoja := AllTrim(ZA1->ZA1_LOJA)
        cCons := AllTrim(ZA1->ZA1_CONSUL)

        cNomeCli := If(Empty(cCli), "", AllTrim(Posicione("SA1", 1, xFilial("SA1") + cCli + cLoja, "A1_NREDUZ")))
        cNomeTec := If(Empty(cCons), "", AllTrim(Posicione("AA1", 1, xFilial("AA1") + cCons, "AA1_NOMTEC")))

        If AllTrim(ZA1->ZA1_NOME) != cNomeCli .Or. AllTrim(ZA1->ZA1_NOMTEC) != cNomeTec
            RecLock("ZA1", .F.)
            ZA1->ZA1_NOME   := cNomeCli
            ZA1->ZA1_NOMTEC := cNomeTec
            ZA1->(MsUnlock())
        EndIf

        ZA1->(DbSkip())
    EndDo

Return

/*/{Protheus.doc} CH_JOBFECHA30
Job agendado (Schedule): abre ambiente RPC proprio e fecha automaticamente
(ZA1_STATUS="4") os chamados em status "1" (Aberto) sem modificacao
(ZA1_MOD) ha 30 dias ou mais.
Job agendado (Schedule) - fecha chamado status "1" sem modificacao (ZA1_MOD) ha 30+ dias.
@author Henrique
@since 02/09/2026
@version P12
/*/
User Function CH_JOBFECHA30()
    Local cEmpAnt      := "01"
    Local cFilAnt      := "01"
    Local dLimite      := Date() - 30
    Local nFechados    := 0
    Local cAlias       := "ZA1FECHA"

    RpcSetType(3)
    If !RpcSetEnv(cEmpAnt, cFilAnt, , , "SIGAFAT", , {"ZA1"})
        ConOut("CH_JOBFECHA30: falha no RpcSetEnv - job abortado.")
        Return
    EndIf

    Begin Sequence

        BeginSql Alias cAlias
            SELECT ZA1.R_E_C_N_O_ RECNO
            FROM %Table:ZA1% ZA1
            WHERE ZA1.ZA1_FILIAL = %xFilial:ZA1%
              AND ZA1.ZA1_STATUS = '1'
              AND ZA1.ZA1_MOD < %Exp:dLimite%
              AND ZA1.%NotDel%
        EndSql

        While !(cAlias)->(Eof())
            ZA1->(DbGoTo((cAlias)->RECNO))

            RecLock("ZA1", .F.)
                ZA1->ZA1_STATUS := "4"
                ZA1->ZA1_MOD    := Date()
            ZA1->(MsUnlock())

            nFechados++
            ConOut("CH_JOBFECHA30: chamado " + AllTrim(ZA1->ZA1_IDCH) + " fechado automaticamente (30 dias sem modificacao).")

            If !Empty(AllTrim(ZA1->ZA1_EMAIL))
                CH_NOTIFICARENCERRADO(AllTrim(ZA1->ZA1_EMAIL), AllTrim(ZA1->ZA1_IDCH), AllTrim(ZA1->ZA1_ASSUNT))
            EndIf

            (cAlias)->(DbSkip())
        EndDo

        (cAlias)->(DbCloseArea())

    Recover
        ConOut("CH_JOBFECHA30: erro durante execucao - ver log acima.")
    End Sequence

    ConOut("CH_JOBFECHA30: finalizado - " + AllTrim(Str(nFechados)) + " chamado(s) fechado(s).")

    RpcClearEnv()

Return

/*%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%*/
// BLOCO 3 - E-MAIL
/*%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%*/

/*/{Protheus.doc} CH_TOKENGRAPH
Obtem um access_token do Azure AD (Microsoft Graph) via OAuth2 client
credentials, usando os parametros MV_CNSATEN/MV_CNSACLI/MV_CNSASEC.
GERACHAM - importacao de chamado por e-mail (Graph). Nao e CRUD nativo do Protheus - portado da versao mais completa/corrigida (CNS001Rest.tlpp).
@return cToken   Access token do Graph, ou "" em falha/configuracao ausente
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_TOKENGRAPH()
    Local cTenant := AllTrim(GETMV("MV_CNSATEN"))
    Local cClient := AllTrim(GETMV("MV_CNSACLI"))
    Local cSecret := AllTrim(GETMV("MV_CNSASEC"))
    Local oRest, oJson, cBody, cToken := ""

    If Empty(cTenant) .Or. Empty(cClient) .Or. Empty(cSecret)
        ConOut("CH_TOKENGRAPH: MV_CNSATEN/MV_CNSACLI/MV_CNSASEC nao configurados no Configurador - e-mail nao sera enviado.")
        Return ""
    EndIf

    cBody := "grant_type=client_credentials"
    cBody += "&client_id="     + CH_CODIFICARURL(cClient)
    cBody += "&client_secret=" + CH_CODIFICARURL(cSecret)
    cBody += "&scope="         + CH_CODIFICARURL("https://graph.microsoft.com/.default")

    oRest := FWRest():New("https://login.microsoftonline.com")
    oRest:setPath("/" + cTenant + "/oauth2/v2.0/token")
    oRest:SetPostParams(cBody)
    If !oRest:Post({"Content-Type: application/x-www-form-urlencoded"})
        ConOut("CH_TOKENGRAPH: falha no POST de token (Azure AD): " + oRest:GetLastError())
        FreeObj(oRest)
        Return ""
    EndIf

    oJson := JsonObject():New()
    If Empty(oJson:FromJson(oRest:GetResult())) .And. ValType(oJson["access_token"]) == "C"
        cToken := oJson["access_token"]
    Else
        ConOut("CH_TOKENGRAPH: resposta do Azure AD sem access_token: " + oRest:GetResult())
    EndIf
    FreeObj(oJson)
    FreeObj(oRest)
Return cToken

/*/{Protheus.doc} CH_CODIFICARURL
Codifica um texto em percent-encoding (application/x-www-form-urlencoded),
usado para montar o corpo da requisicao de token do Azure AD.
@param  cTexto   Texto a codificar
@return cRet   Texto codificado em URL
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_CODIFICARURL(cTexto)
    Local cRet := ""
    Local nI   := 0
    Local cCh  := ""

    For nI := 1 To Len(cTexto)
        cCh := SubStr(cTexto, nI, 1)
        If (cCh >= "A" .And. cCh <= "Z") .Or. ;
           (cCh >= "a" .And. cCh <= "z") .Or. ;
           (cCh >= "0" .And. cCh <= "9") .Or. ;
           (cCh $ "-_.~")
            cRet += cCh
        Else
            cRet += "%" + CH_HEXDOISDIG(Asc(cCh))
        EndIf
    Next nI
Return cRet

/*/{Protheus.doc} CH_HEXDOISDIG
Converte um valor numerico (0-255) para 2 digitos hexadecimais, usado
pela codificacao percent-encoding (CH_CODIFICARURL).
@param  nVal   Valor numerico a converter
@return String hexadecimal de 2 digitos
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_HEXDOISDIG(nVal)
    Local cHex := "0123456789ABCDEF"
Return SubStr(cHex, Int(nVal/16)+1, 1) + SubStr(cHex, (nVal % 16)+1, 1)

/*/{Protheus.doc} CH_ENVIAREMAIL
Envia um e-mail HTML via Microsoft Graph (sendMail), obtendo o token de
acesso via CH_TOKENGRAPH.
@param  cPara       E-mail do destinatario
@param  cAssunto    Assunto do e-mail
@param  cCorpo      Corpo HTML do e-mail
@param  cDe         Caixa remetente (mailbox do Graph)
@return lOk   .T. se o envio teve sucesso, .F. caso contrario
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_ENVIAREMAIL(cPara, cAssunto, cCorpo, cDe)
    Local cToken  := CH_TOKENGRAPH()
    Local oRest   := Nil
    Local cJson   := ""
    Local aHeader := {}
    Local lOk      := .F.

    If Empty(cToken) .Or. Empty(cPara)
        ConOut("CH_ENVIAREMAIL: nao enviado - " + If(Empty(cToken), "token vazio", "destinatario (cPara) vazio - AA1_EMAIL nao cadastrado?"))
        Return .F.
    EndIf

    cJson := '{'
    cJson +=   '"message": {'
    cJson +=     '"subject": "' + CH_ESCAPARJSON(cAssunto) + '",'
    cJson +=     '"body": {'
    cJson +=       '"contentType": "HTML",'
    cJson +=       '"content": "' + CH_ESCAPARJSON(cCorpo) + '"'
    cJson +=     '},'
    cJson +=     '"toRecipients": [{'
    cJson +=       '"emailAddress": {'
    cJson +=         '"address": "' + CH_ESCAPARJSON(cPara) + '"'
    cJson +=       '}'
    cJson +=     '}]'
    cJson +=   '},'
    cJson +=   '"saveToSentItems": "true"'
    cJson += '}'

    oRest := FWRest():New("https://graph.microsoft.com")
    oRest:setPath("/v1.0/users/" + cDe + "/sendMail")
    oRest:SetPostParams(cJson)

    aHeader := {}
    aAdd(aHeader, "Authorization: Bearer " + cToken)
    aAdd(aHeader, "Content-Type: application/json")

    oRest:Post(aHeader)

    lOk := (oRest:GetLastError() == "202 Accepted" .Or. Empty(oRest:GetLastError()))
    If !lOk
        ConOut("CH_ENVIAREMAIL: falha no POST sendMail (Graph) para " + cPara + ": " + oRest:GetLastError() + " | " + oRest:GetResult())
    EndIf
    FreeObj(oRest)

Return lOk

/*/{Protheus.doc} CH_HTMLEMAIL
Layout unico dos e-mails do chamado (identidade da Apia): logo + selo com o
numero do chamado, alerta em vermelho centralizado, saudacao, cartao com os
dados (rotulo/valor), bloco opcional de texto (descricao, interacao, motivo)
e rodape. Tabelas + estilo inline (Outlook nao aplica CSS externo); acentos
como entidade HTML (fonte em CP1252).
@param  cIdCh        Numero do chamado (vazio = sem selo)
@param  cAlerta      Texto do alerta em vermelho
@param  cNome        Nome pra saudacao ("Ola, <nome>,") - vazio = "Ola,"
@param  cIntro       Frase de introducao
@param  aLinhas      Array de {rotulo, valorHtml} do cartao (vazio = sem cartao)
@param  cTituloTexto Titulo do bloco de texto (ex: "Descricao")
@param  cTexto       Texto do bloco (vazio = sem bloco)
@param  cObs         Linha extra antes do rodape (ex: contato) - opcional
@return cHtml   Corpo HTML do e-mail
@author Henrique
@since 25/09/2026
@version P12
/*/
Static Function CH_HTMLEMAIL(cIdCh, cAlerta, cNome, cIntro, aLinhas, cTituloTexto, cTexto, cObs)
    Local cHtml   := ""
    Local nI      := 0
    Local cBorda  := "border-bottom:1px solid #e6e9ef;"
    Local cRot    := ""
    Local cVal    := ""

    Default cIdCh        := ""
    Default cNome        := ""
    Default aLinhas      := {}
    Default cTituloTexto := ""
    Default cTexto       := ""
    Default cObs         := ""

    cHtml := '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f9;font-family:Arial,Helvetica,sans-serif">'
    cHtml += '<tr><td align="center" style="padding:16px 8px">'
    cHtml += '<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background-color:#ffffff">'

    // Cabecalho branco: logo da Apia (publicado no portal) + selo com o numero do chamado
    cHtml += '<tr><td style="background-color:#ffffff;padding:18px 28px">'
    cHtml += '<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>'
    cHtml += '<td align="left"><img src="https://www.apia.com.br/apia_cs/logo-apia-completa.png" alt="&Aacute;pia Consultoria e Sistemas" height="48" style="display:block;border:0;height:48px"></td>'
    If !Empty(cIdCh)
        cHtml += '<td align="right"><span style="display:inline-block;background-color:#1a7fc1;color:#ffffff;font-size:14px;font-weight:bold;letter-spacing:1px;padding:8px 14px;border-radius:6px">CHAMADO #' + cIdCh + '</span></td>'
    EndIf
    cHtml += '</tr></table>'
    cHtml += '</td></tr>'
    cHtml += '<tr><td style="background-color:#1a7fc1;height:4px;line-height:4px;font-size:0">&nbsp;</td></tr>'

    // Alerta: sem fundo, texto em vermelho, centralizado
    cHtml += '<tr><td align="center" style="background-color:#ffffff;padding:16px 28px;color:#c62828;font-size:16px;font-weight:bold;text-align:center">&#9888; ' + cAlerta + '</td></tr>'

    // Saudacao
    cHtml += '<tr><td style="background-color:#f4f6f9;padding:24px 28px 8px 28px">'
    cHtml += '<div style="color:#374151;font-size:15px;line-height:1.5">Ol&aacute;' + If(Empty(cNome), "", ", " + cNome) + ',<br>' + cIntro + '</div>'
    cHtml += '</td></tr>'

    // Cartao com os dados + bloco de texto
    If Len(aLinhas) > 0 .Or. !Empty(cTexto)
        cHtml += '<tr><td style="background-color:#f4f6f9;padding:12px 28px">'
        cHtml += '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#ffffff">'
        If Len(aLinhas) > 0
            cHtml += '<tr><td style="padding:20px 28px 4px 28px"><div style="color:#0d5a8a;font-size:18px;font-weight:bold;padding-bottom:12px;border-bottom:1px solid #e6e9ef">Chamado</div>'
            cHtml += '<table role="presentation" width="100%" cellpadding="0" cellspacing="0">'
            For nI := 1 To Len(aLinhas)
                // ultima linha sem borda embaixo
                cRot := 'style="padding:14px 0;' + If(nI < Len(aLinhas), cBorda, "") + 'color:#6b7280;font-size:14px;width:38%;vertical-align:top"'
                cVal := 'style="padding:14px 0;' + If(nI < Len(aLinhas), cBorda, "") + 'color:#111827;font-size:15px;font-weight:bold;vertical-align:top"'
                cHtml += '<tr><td ' + cRot + '>' + aLinhas[nI][1] + '</td><td ' + cVal + '>' + aLinhas[nI][2] + '</td></tr>'
            Next nI
            cHtml += '</table>'
            cHtml += '</td></tr>'
        EndIf
        If !Empty(cTexto)
            cHtml += '<tr><td style="padding:18px 28px 20px 28px;' + If(Len(aLinhas) > 0, 'border-top:1px solid #e6e9ef', '') + '">'
            If !Empty(cTituloTexto)
                cHtml += '<div style="color:#0d5a8a;font-size:18px;font-weight:bold;padding-bottom:8px">' + cTituloTexto + '</div>'
            EndIf
            cHtml += '<div style="color:#374151;font-size:15px;line-height:1.5">' + cTexto + '</div>'
            cHtml += '</td></tr>'
        EndIf
        cHtml += '</table>'
        cHtml += '</td></tr>'
    EndIf

    If !Empty(cObs)
        cHtml += '<tr><td align="center" style="background-color:#f4f6f9;padding:12px 28px 0 28px;color:#374151;font-size:14px">' + cObs + '</td></tr>'
    EndIf

    cHtml += '<tr><td align="center" style="background-color:#f4f6f9;padding:16px 28px 20px 28px;color:#9ca3af;font-size:13px">--- Mensagem autom&aacute;tica, por favor n&atilde;o responda ---</td></tr>'

    // Rodape no padrao da Apia
    cHtml += '<tr><td align="center" style="background-color:#0d5a8a;padding:12px 28px;color:#ffffff;font-size:12px">&Aacute;pia Consultoria e Sistemas - TOTVS Business Partner</td></tr>'

    cHtml += '</table>'
    cHtml += '</td></tr>'
    cHtml += '</table>'

Return cHtml

/*/{Protheus.doc} CH_HTMLCANCELA
Monta o corpo HTML do e-mail ao analista removido de um chamado (tecnico
substituido no Alterar - ver CH_POSGRAVACAO).
@param  cCliente     Nome do cliente
@param  cDataAge     Data do agendamento (formatada)
@param  cHmini       Hora inicial
@param  cHmfim       Hora final
@param  cIdCh        Id do chamado
@param  cMotivo      Motivo da remocao
@param  cAlteradoPor Nome de quem fez a troca
@return cHtml   Corpo HTML do e-mail
@author Henrique
@since 25/09/2026
@version P12
/*/
Static Function CH_HTMLCANCELA(cCliente, cDataAge, cHmini, cHmfim, cIdCh, cMotivo, cAlteradoPor)
    Local aLinhas := {}

    AAdd(aLinhas, {"N&uacute;mero", '<span style="color:#1a7fc1">' + cIdCh + '</span>'})
    AAdd(aLinhas, {"Cliente", cCliente})
    AAdd(aLinhas, {"Data", cDataAge})
    AAdd(aLinhas, {"Hor&aacute;rio", cHmini + " &agrave;s " + cHmfim})
    AAdd(aLinhas, {"Alterado por", cAlteradoPor})

Return CH_HTMLEMAIL(cIdCh, "Voc&ecirc; foi removido de um chamado", "", ;
    "Este chamado foi designado para outro analista.", ;
    aLinhas, "Motivo", cMotivo, "")

/*/{Protheus.doc} CH_HTMLENCERRAMENTO
Monta o corpo HTML do e-mail de encerramento de um agendamento
ou chamado.
@param  cCliente        Nome do cliente
@param  cDataAge        Data do agendamento (formatada)
@param  cHmini          Hora inicial do agendamento
@param  cHmfim          Hora final do agendamento
@param  cChamado        Id do chamado
@param  cMotivo         Motivo do encerramento
@param  cExcluidoPor    Nome de quem encerrou
@return cHtml   Corpo HTML do e-mail
@author Henrique
@since 02/09/2026
@version P12
/*/
Static Function CH_HTMLENCERRAMENTO(cCliente, cDataAge, cHmini, cHmfim, cChamado, cMotivo, cExcluidoPor)
    Local cHtml := ""

    Local aLinhas := {}

    AAdd(aLinhas, {"N&uacute;mero", '<span style="color:#1a7fc1">' + cChamado + '</span>'})
    AAdd(aLinhas, {"Cliente", cCliente})
    AAdd(aLinhas, {"Data", cDataAge})
    AAdd(aLinhas, {"Hor&aacute;rio", cHmini + " &agrave;s " + cHmfim})
    AAdd(aLinhas, {"Encerrado por", cExcluidoPor})

    cHtml := CH_HTMLEMAIL(cChamado, "Chamado encerrado", "", ;
        "Este chamado foi encerrado e o agendamento vinculado a ele foi removido.", ;
        aLinhas, "Motivo", cMotivo, "")

Return cHtml

/*/{Protheus.doc} CH_NOTIFICARDESIGNA
Notifica por e-mail o tecnico designado a um chamado, buscando os dados
do chamado (ZA1) e do agendamento (SZ6) mais recente para montar o corpo.
Notifica tambem o cliente (ZA1_EMAIL), quando cadastrado E quando
lNotificarCliente for .T., com os mesmos dados (tecnico, chamado,
servico, data/hora).
E-mail de designacao - unico (Incluir/Alterar/Assumir chamam esta quando resultam num tecnico definido/alterado)
@param  cIdCh                 Id do chamado (ZA1_IDCH)
@param  cCodConsultorNovo     Codigo do tecnico designado (AA1)
@param  lNotificarCliente     .T. pra tambem enviar ao cliente (ZA1_EMAIL) - decisao do usuario (MsgYesNo na tela classica ou flag no REST, ver CH_POSGRAVACAO)
@param  lNotificarTecnico     .F. pra NAO enviar ao analista - decisao do usuario (default .T.)
@return .T./.F. indicando sucesso no envio ao tecnico (via CH_ENVIAREMAIL)
@author Henrique
@since 02/09/2026
@version P12
@update 17/09/2026 - Notifica tambem o cliente (ZA1_EMAIL) com os dados do tecnico/agendamento, condicionado a lNotificarCliente
/*/
Static Function CH_NOTIFICARDESIGNA(cIdCh, cCodConsultorNovo, lNotificarCliente, lNotificarTecnico)
    Local cNomeTec   := ""
    Local cEmailTec  := ""
    Local cNomeCli   := ""
    Local cEmailCli  := ""
    Local cAssunto   := ""
    Local cDataAge   := DToC(Date())
    Local cHmini     := "00:00"
    Local cHmfim     := "00:00"
    Local cNomeDe    := ""
    Local cCorpo     := ""
    Local cCorpoCli  := ""
    Local cDescricao := ""
    Local lOk        := .F.
    Local cAlias     := GetNextAlias()
    Local nCham      := Val(cIdCh)

    Default lNotificarCliente := .F.
    Default lNotificarTecnico := .T.

    If Empty(cCodConsultorNovo)
        Return .F.
    EndIf

    cNomeTec  := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cCodConsultorNovo, "AA1_NOMTEC"))
    cEmailTec := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cCodConsultorNovo, "AA1_EMAIL"))
    // FIX (JA CORRIGIDO E REVERTIDO POR EDICAO CONCORRENTE - NAO REVERTER):
    // "designado por" e quem esta executando a acao (usuario logado), nao o
    // proprio tecnico sendo designado - mesmo padrao de cExclPor em
    // CH_POSGRAVACAO/CH_NUCLEOASSUMIR.
    cNomeDe   := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_NOMTEC"))

    If Empty(cEmailTec)
        ConOut("CH_NOTIFICARDESIGNA: tecnico " + cCodConsultorNovo + " sem AA1_EMAIL cadastrado - e-mail de designacao nao enviado ao tecnico.")
    EndIf

    dbSelectArea("ZA1")
    ZA1->(DbSetOrder(1))
    If ZA1->(DbSeek(xFilial("ZA1") + cIdCh))
        cAssunto := AllTrim(ZA1->ZA1_ASSUNT)
        cEmailCli := AllTrim(ZA1->ZA1_EMAIL)
        cDescricao := AllTrim(ZA1->ZA1_ANOT)
        cNomeCli := AllTrim(Posicione("SA1", 1, xFilial("SA1") + AllTrim(ZA1->ZA1_CLIENT) + AllTrim(ZA1->ZA1_LOJA), "A1_NREDUZ"))
        If ValType(ZA1->ZA1_DATA) == "D" .And. !Empty(ZA1->ZA1_DATA)
            cDataAge := DToC(ZA1->ZA1_DATA)
        ElseIf ValType(ZA1->ZA1_DATA) == "C" .And. Len(AllTrim(ZA1->ZA1_DATA)) == 8
            cDataAge := DToC(STOD(AllTrim(ZA1->ZA1_DATA)))
        EndIf
    EndIf

    // FIX (JA CORRIGIDO E REVERTIDO POR EDICAO CONCORRENTE - NAO REVERTER):
    // horario vinha fixo/vazio - busca o agendamento (SZ6) real do chamado,
    // mesmo padrao usado em CH_POSGRAVACAO (nOper==4).
    BeginSql Alias cAlias
        SELECT Z6_DTAGE, Z6_HMINI, Z6_HMFIM
        FROM %Table:SZ6% SZ6
        WHERE Z6_FILIAL  = %xFilial:SZ6%
          AND Z6_CHAMADO = %Exp:nCham%
          AND %NotDel%
    EndSql
    If !(cAlias)->(Eof())
        If ValType((cAlias)->Z6_DTAGE) == "D"
            cDataAge := DToC((cAlias)->Z6_DTAGE)
        Else
            cDataAge := AllTrim((cAlias)->Z6_DTAGE)
            If Len(cDataAge) == 8
                cDataAge := SubStr(cDataAge,7,2)+"/"+SubStr(cDataAge,5,2)+"/"+SubStr(cDataAge,1,4)
            EndIf
        EndIf
        cHmini := AllTrim((cAlias)->Z6_HMINI)
        cHmfim := AllTrim((cAlias)->Z6_HMFIM)
    EndIf
    (cAlias)->(DbCloseArea())

    If Empty(cHmini) ; cHmini := "00:00" ; EndIf
    If Empty(cHmfim) ; cHmfim := "00:00" ; EndIf

    // Cliente so recebe se tiver e-mail cadastrado no chamado (ZA1_EMAIL) E
    // se o usuario pediu pra notificar (lNotificarCliente) - independente do
    // tecnico ter ou nao AA1_EMAIL cadastrado.
    If lNotificarCliente .And. !Empty(cEmailCli)
        cCorpoCli := CH_HTMLDESIGNACLIENTE(cNomeTec, cIdCh, cAssunto, cDataAge, cHmini, cHmfim)
        CH_ENVIAREMAIL(cEmailCli, "Tecnico Designado - Chamado " + cIdCh, cCorpoCli, "apia@apia.com.br")
    EndIf

    If !lNotificarTecnico .Or. Empty(cEmailTec)
        Return .F.
    EndIf

    cCorpo := CH_HTMLDESIGNA(cNomeTec, cIdCh, cNomeCli, cAssunto, cDataAge, cHmini, cHmfim, cNomeDe, "DESIGNACAO", cEmailCli, cDescricao)

    lOk := CH_ENVIAREMAIL(cEmailTec, "Chamado Designado " + cIdCh, cCorpo, "apia@apia.com.br")

Return lOk

/*/{Protheus.doc} CH_HTMLDESIGNA
Monta o corpo HTML do e-mail ao analista (designacao ou agendamento de um
chamado) - layout "ticket": cabecalho com o numero do chamado, faixa de
acao, cartao com os dados do chamado, detalhes (descricao). Tabelas + estilo inline (Outlook nao aplica CSS externo);
acentos como entidade HTML (fonte em CP1252).
@param  cNomeTec    Nome do analista
@param  cIdCh       Id do chamado
@param  cCliente    Nome (reduzido) do cliente
@param  cAssunto    Assunto do chamado
@param  cDataAge    Data (ou periodo) do agendamento, ja formatada
@param  cHmini      Hora inicial
@param  cHmfim      Hora final
@param  cNomeDe     Nome de quem designou/agendou
@param  cTipo       "DESIGNACAO" (default) ou "AGENDAMENTO"
@param  cEmailCli   E-mail do cliente (opcional, aparece embaixo do nome)
@param  cDescricao  Descricao do chamado (ZA1_ANOT, opcional)
@return cHtml   Corpo HTML do e-mail
@author Henrique
@since 02/09/2026
@version P12
@update 25/09/2026 - Novo layout (ticket) com a identidade da Apia, e-mail do cliente e descricao
/*/
Static Function CH_HTMLDESIGNA(cNomeTec, cIdCh, cCliente, cAssunto, cDataAge, cHmini, cHmfim, cNomeDe, cTipo, cEmailCli, cDescricao)
    Local cHtml := ""

    Local lAgenda    := AllTrim(Upper(cValToChar(cTipo))) == "AGENDAMENTO"
    Local aLinhas    := {}
    Local cCliLinha  := cCliente

    Default cEmailCli  := ""
    Default cDescricao := ""

    If !Empty(cEmailCli)
        cCliLinha += '<br><span style="font-size:13px;font-weight:normal;color:#1a7fc1">' + cEmailCli + '</span>'
    EndIf

    AAdd(aLinhas, {"N&uacute;mero", '<span style="color:#1a7fc1">' + cIdCh + '</span>'})
    AAdd(aLinhas, {"Cliente", cCliLinha})
    AAdd(aLinhas, {"Data", cDataAge})
    AAdd(aLinhas, {"Hor&aacute;rio", cHmini + " &agrave;s " + cHmfim})
    AAdd(aLinhas, {If(lAgenda, "Agendado por", "Designado por"), cNomeDe})

    If lAgenda
        cHtml := CH_HTMLEMAIL(cIdCh, "Voc&ecirc; tem um atendimento agendado", cNomeTec, ;
            "Um atendimento foi agendado para voc&ecirc; neste chamado. Confira a data e o hor&aacute;rio abaixo.", ;
            aLinhas, "Descri&ccedil;&atilde;o", cDescricao, "")
    Else
        cHtml := CH_HTMLEMAIL(cIdCh, "Voc&ecirc; foi designado para um chamado", cNomeTec, ;
            "Um chamado foi designado para voc&ecirc;. Verifique os dados abaixo e acompanhe o atendimento.", ;
            aLinhas, "Descri&ccedil;&atilde;o", cDescricao, "")
    EndIf

Return cHtml

/*/{Protheus.doc} CH_NOTIFICARAGENDAMENTO
Envia ao analista o e-mail de agendamento criado a partir do chamado
(mesmo layout do e-mail de designacao, tipo "AGENDAMENTO").
@param  cIdCh      Id do chamado (ZA1_IDCH)
@param  cCodTec    Codigo do analista (AA1)
@param  cPeriodo   Data (ou intervalo "dd/mm/aaaa a dd/mm/aaaa") ja formatado
@param  cHmini     Hora inicial
@param  cHmfim     Hora final
@param  cServico   Descricao/servico do agendamento
@return .T./.F. indicando sucesso no envio (via CH_ENVIAREMAIL)
@author Henrique
@since 24/09/2026
@version P12
/*/
Static Function CH_NOTIFICARAGENDAMENTO(cIdCh, cCodTec, cPeriodo, cHmini, cHmfim, cServico)
    Local cEmailTec := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cCodTec, "AA1_EMAIL"))
    Local cNomeTec  := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cCodTec, "AA1_NOMTEC"))
    Local cNomeDe   := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_NOMTEC"))
    Local cNomeCli  := ""
    Local cEmailCli := ""
    Local cDescricao := ""
    Local cCorpo    := ""

    If Empty(cEmailTec)
        ConOut("CH_NOTIFICARAGENDAMENTO: tecnico " + cCodTec + " sem AA1_EMAIL cadastrado - e-mail de agendamento nao enviado.")
        Return .F.
    EndIf

    dbSelectArea("ZA1")
    ZA1->(DbSetOrder(1))
    If ZA1->(DbSeek(xFilial("ZA1") + cIdCh))
        cNomeCli := AllTrim(Posicione("SA1", 1, xFilial("SA1") + AllTrim(ZA1->ZA1_CLIENT) + AllTrim(ZA1->ZA1_LOJA), "A1_NREDUZ"))
        cEmailCli := AllTrim(ZA1->ZA1_EMAIL)
        cDescricao := AllTrim(ZA1->ZA1_ANOT)
    EndIf

    cCorpo := CH_HTMLDESIGNA(cNomeTec, cIdCh, cNomeCli, cServico, cPeriodo, cHmini, cHmfim, cNomeDe, "AGENDAMENTO", cEmailCli, cDescricao)

Return CH_ENVIAREMAIL(cEmailTec, "Agendamento - Chamado " + cIdCh, cCorpo, "apia@apia.com.br")

/*/{Protheus.doc} CH_HTMLDESIGNACLIENTE
Monta o corpo HTML do e-mail ao cliente informando que um tecnico foi
designado para o chamado, com o horario do atendimento.
@param  cNomeTec   Nome do tecnico designado
@param  cIdCh      Id do chamado
@param  cAssunto   Assunto/servico do chamado
@param  cDataAge   Data do agendamento (formatada)
@param  cHmini     Hora inicial do agendamento
@param  cHmfim     Hora final do agendamento
@return cHtml   Corpo HTML do e-mail
@author Henrique
@since 17/09/2026
@version P12
/*/
Static Function CH_HTMLDESIGNACLIENTE(cNomeTec, cIdCh, cAssunto, cDataAge, cHmini, cHmfim)
    Local cHtml := ""

    Local aLinhas := {}

    AAdd(aLinhas, {"N&uacute;mero", '<span style="color:#1a7fc1">' + cIdCh + '</span>'})
    AAdd(aLinhas, {"T&eacute;cnico", cNomeTec})
    AAdd(aLinhas, {"Assunto", cAssunto})
    AAdd(aLinhas, {"Data", cDataAge})
    AAdd(aLinhas, {"Hor&aacute;rio", cHmini + " &agrave;s " + cHmfim})

    cHtml := CH_HTMLEMAIL(cIdCh, "Um t&eacute;cnico foi designado para o seu chamado", "", ;
        "Seu chamado j&aacute; tem um t&eacute;cnico respons&aacute;vel. Confira os dados do atendimento abaixo.", ;
        aLinhas, "", "", "Qualquer d&uacute;vida, entre em contato: <b>pericles@apia.com.br</b>")

Return cHtml

/*/{Protheus.doc} CH_STATUSLABEL
Traduz o codigo de status (ZA1_STATUS) pro rotulo exibido na legenda da
tela classica (ver AddLegend no BrowseDef).
@param  cStatus   Codigo do status (1 a 5)
@return cLabel    Rotulo do status, ou o proprio codigo se desconhecido
@author Henrique
@since 17/09/2026
@version P12
/*/
Static Function CH_STATUSLABEL(cStatus)
    Local cLabel := cStatus

    Do Case
        Case cStatus == "1" ; cLabel := "Aberto"
        Case cStatus == "2" ; cLabel := "Pendente Apia"
        Case cStatus == "3" ; cLabel := "Pendente Cliente"
        Case cStatus == "4" ; cLabel := "Fechado"
        Case cStatus == "5" ; cLabel := "Incompleto"
    EndCase

Return cLabel

/*/{Protheus.doc} CH_NOTIFICARALTERACAO
Notifica por e-mail o cliente sobre uma ou mais mudancas de campo num
chamado (status, assunto, tipo, projeto, tarefa, data), listando de/para.
Nao cobre mudanca de tecnico (ja tem e-mail dedicado em CH_NOTIFICARDESIGNA).
@param  cEmail      E-mail do cliente (destino)
@param  cIdCh       Id do chamado
@param  aMudancas   Array de {rotulo, valorAntigo, valorNovo}
@return .T./.F. indicando sucesso no envio (via CH_ENVIAREMAIL)
@author Henrique
@since 17/09/2026
@version P12
/*/
Static Function CH_NOTIFICARALTERACAO(cEmail, cIdCh, aMudancas)
    Local cCorpo := ""

    If Empty(cEmail) .Or. Len(aMudancas) == 0
        Return .F.
    EndIf

    cCorpo := CH_HTMLALTERACAO(cIdCh, aMudancas)

Return CH_ENVIAREMAIL(cEmail, "Chamado Alterado " + cIdCh, cCorpo, "apia@apia.com.br")

/*/{Protheus.doc} CH_HTMLALTERACAO
Monta o corpo HTML do e-mail de alteracao de chamado, listando cada campo
mudado (de/para) numa tabela.
@param  cIdCh       Id do chamado
@param  aMudancas   Array de {rotulo, valorAntigo, valorNovo}
@return cHtml   Corpo HTML do e-mail
@author Henrique
@since 17/09/2026
@version P12
/*/
Static Function CH_HTMLALTERACAO(cIdCh, aMudancas)
    Local cHtml := ""

    Local aLinhas := {}
    Local nI      := 0

    AAdd(aLinhas, {"N&uacute;mero", '<span style="color:#1a7fc1">' + cIdCh + '</span>'})
    // De -> Para: valor antigo riscado em cinza, novo em destaque
    For nI := 1 To Len(aMudancas)
        AAdd(aLinhas, {aMudancas[nI][1], ;
            '<span style="color:#9ca3af;font-weight:normal;text-decoration:line-through">' + aMudancas[nI][2] + '</span>' + ;
            ' &rarr; ' + aMudancas[nI][3]})
    Next nI

    cHtml := CH_HTMLEMAIL(cIdCh, "Seu chamado foi alterado", "", ;
        "As informa&ccedil;&otilde;es abaixo foram atualizadas no seu chamado.", ;
        aLinhas, "", "", "Qualquer d&uacute;vida, entre em contato: <b>pericles@apia.com.br</b>")

Return cHtml

/*/{Protheus.doc} CH_NOTIFICARINTERACAO
Notifica por e-mail o cliente sobre uma interacao incluida ou removida de
um chamado.
@param  cEmail        E-mail do cliente (destino)
@param  cIdCh         Id do chamado
