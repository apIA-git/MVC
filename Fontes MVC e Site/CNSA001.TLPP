Return CH_ENVIAREMAIL(cEmail, cAssuntoBase + " - Chamado " + cIdCh, cCorpo, "apia@apia.com.br")

/*/{Protheus.doc} CH_HTMLINTERACAO
Monta o corpo HTML do e-mail de interacao incluida/removida de um chamado.
@param  cIdCh        Id do chamado
@param  cTexto       Texto da interacao
