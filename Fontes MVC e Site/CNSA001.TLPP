#Include "Protheus.ch"
#Include "FWMVCDef.ch"
#Include "Totvs.ch"
#Include "TopConn.ch"
#Include "FileIO.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"

Namespace apia.cnsa001

// CNSA001 - Chamados (ZA1/ZA2): tela classica, REST do portal, e-mails e importacao da caixa apia@. Henrique, 09-10/2026.

/*/{Protheus.doc} CNS001
Browse de chamados (ZA1): importa a caixa apia@ (CH_CRIARCHAMADOEMAIL) e abre o browse.
/*/
User Function CNS001()

    Local l_oBrowse := Nil
    Local nCriados  := 0
    Private aRotina := u_MenuDef()
    Private cConsultor := " "

    cConsultor := Posicione("AA1",4,xFilial("AA1")+__cUserId,"AA1_CODTEC")

    nCriados := CH_CRIARCHAMADOEMAIL()
    If nCriados < 0
        MsgAlert("Nao foi possivel verificar a caixa apia@apia.com.br no momento.", "E-mails")
    ElseIf nCriados == 0
        MsgInfo("Sem e-mails novos em apia@apia.com.br.", "E-mails")
    Else
        MsgAlert("Foram abertos " + cValToChar(nCriados) + " chamado(s) a partir de e-mail(s) novo(s).", "Novos Chamados")
    EndIf

    l_oBrowse := FWMBrowse():New()
    If l_oBrowse <> Nil

        l_oBrowse:SetDescription("Registro de Chamados - OS")
        l_oBrowse:SetAlias("ZA1")

        // Quem nao e admin so ve os seus chamados e os sem tecnico (pra assumir).
        If !CH_TEMACESSOGRUPO()
            l_oBrowse:SetFilterDefault("Empty(ZA1->ZA1_CONSUL) .Or. AllTrim(ZA1->ZA1_CONSUL) == '" + AllTrim(cConsultor) + "'")
        EndIf

        // Mesmas cores do portal (shared/paleta-status.ts).
        l_oBrowse:AddLegend( "ZA1->ZA1_STATUS == '1'", "BLUE",   "Aberto" )
        l_oBrowse:AddLegend( "ZA1->ZA1_STATUS == '2'", "YELLOW", "Pendente Apia" )
        l_oBrowse:AddLegend( "ZA1->ZA1_STATUS == '3'", "PINK",   "Pendente Cli." )
        l_oBrowse:AddLegend( "ZA1->ZA1_STATUS == '4'", "GREEN",  "Fechado" )
        l_oBrowse:AddLegend( "ZA1->ZA1_STATUS == '5'", "GRAY",   "Incompleto" )
        l_oBrowse:Activate()

    EndIf

Return

/*/{Protheus.doc} MenuDef
Monta o menu de opcoes (aRotina) da tela de Chamados.
Reusa direto as rotinas antigas que nao mudam de mecanismo.
@return aRotina   Array de opcoes do menu
/*/
User Function MenuDef()

    Local aRotina := {}

    ADD OPTION aRotina TITLE "Pesquisar"        ACTION "AxPesqui"                            OPERATION 1 ACCESS 0
    ADD OPTION aRotina TITLE "Visualizar"       ACTION "apia.cnsa001.U_CH_TELA(1)"           OPERATION 2 ACCESS 0
    ADD OPTION aRotina TITLE "Incluir"          ACTION "apia.cnsa001.U_CH_TELA(3)"           OPERATION 3 ACCESS 0
    // Admin altera qualquer chamado; quem nao e admin, so os proprios (CH_TELA + CH_PREVALIDA).
    ADD OPTION aRotina TITLE "Alterar"          ACTION "apia.cnsa001.U_CH_TELA(4)"           OPERATION 4 ACCESS 0
    ADD OPTION aRotina TITLE "Excluir"          ACTION "apia.cnsa001.U_CH_TELA(5)"           OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Ver Agendas"      ACTION "apia.cnsa001.U_PROTHEUS_ABREAGENDA"  OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Agendar"          ACTION "apia.cnsa001.U_CNSA_CRIAAGENDA"      OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Assumir"          ACTION "apia.cnsa001.U_CH_ASSUMIRTELA"       OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Interação"        ACTION "apia.cnsa001.U_CNSA_INTERAGIR"       OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Excluir Interacao" ACTION "apia.cnsa001.U_CH_EXCLUIRINTERACAOTELA"   OPERATION 0 ACCESS 0
    ADD OPTION aRotina TITLE "Legenda"          ACTION "apia.cnsa001.U_CNSA_LEG"             OPERATION 0 ACCESS 0

Return aRotina

/*/{Protheus.doc} ViewDef
View do chamado: ZA1 com os grids de interacoes (ZA2) e agendamento (SZ6).
@return l_oView   Objeto FWFormView montado, ou Nil se o Model nao carregou
/*/
User Function ViewDef()

    Local l_oView    := Nil
    Local l_oModel   := FWModelActive()
    Local l_oStruZA1 := FWFormStruct(2, "ZA1")
    Local l_oStruZA2 := FWFormStruct(2, "ZA2")
    Local l_oStruSZ6 := FWFormStruct(2, "SZ6")

    // Model ativo de outra rotina nao serve (sem o grid ZA2DETAIL): monta o do chamado.
    If l_oModel == Nil .Or. l_oModel:GetId() != "FCNS001"
        l_oModel := CH_MONTARMODEL()
    EndIf

    l_oView := FWFormView():New()
    l_oView:SetModel(l_oModel)

    l_oView:AddField("VIEW_ZA1", l_oStruZA1, "ZA1MASTER")
    l_oView:AddGrid("VIEW_ZA2",  l_oStruZA2, "ZA2DETAIL")
    l_oView:AddGrid("VIEW_SZ6",  l_oStruSZ6, "SZ6DETAIL")

    l_oView:CreateHorizontalBox("CABEC",  70)
    l_oView:CreateHorizontalBox("ABAIXO", 30)

    l_oView:CreateVerticalBox("GRID",    50, "ABAIXO")
    l_oView:CreateVerticalBox("GRIDAGE", 50, "ABAIXO")

    l_oView:SetOwnerView("VIEW_ZA1", "CABEC")
    l_oView:SetOwnerView("VIEW_ZA2", "GRID")
    l_oView:SetOwnerView("VIEW_SZ6", "GRIDAGE")

    l_oView:EnableTitleView("VIEW_ZA1", "Dados do Chamado")
    l_oView:EnableTitleView("VIEW_ZA2", "Interacoes")
    l_oView:EnableTitleView("VIEW_SZ6", "Agendamento")

    l_oView:SetCloseOnOk({||.T.})

Return l_oView

/*/{Protheus.doc} ModelDef
Model do chamado (ZA1 + ZA2 + SZ6) - ver CH_MONTARMODEL.
@return l_oModel   Objeto MPFormModel montado
/*/
User Function ModelDef()

Return CH_MONTARMODEL()

/*/{Protheus.doc} CH_MONTARMODEL
Model do chamado (ZA1 + ZA2 + SZ6). Com nOperAtivar tambem ativa, NA MESMA funcao: ativar em
outro frame quebra o INITVALUE com "owner private environment not found".
@param  nOperAtivar    Operacao pra ja ativar (MODEL_OPERATION_*) - vazio = so monta
@param  bTela          Tela (FWExecView) aberta AQUI, depois de ativar: o FWInitCpo (validacao, lupa e
                       inicializador de campo) so funciona enquanto a funcao que instanciou o model esta na
                       pilha - TDN DSFIN-4587 ("owner private environment not found")
@return l_oModel       Objeto MPFormModel montado
/*/
Static Function CH_MONTARMODEL(nOperAtivar, bTela)
    Local l_oModel  := Nil
    Local l_oStrZA1 := FWFormStruct(1, "ZA1")
    Local l_oStrZA2 := FWFormStruct(1, "ZA2")
    Local l_oStrSZ6 := FWFormStruct(1, "SZ6")
    Local aRelZA2   := {}
    Local aRelSZ6   := {}

    Local oGridSZ6  := Nil

    Default nOperAtivar := 0
    l_oStrZA1:SetProperty("ZA1_CLIENT", MODEL_FIELD_OBRIGAT, .F.)
    l_oStrZA1:SetProperty("ZA1_LOJA",   MODEL_FIELD_OBRIGAT, .F.)
    l_oStrZA1:SetProperty("ZA1_CONSUL", MODEL_FIELD_OBRIGAT, .F.)

    // CH_PREVALIDA na pos-validacao (VldData), nao no bPre: o bPre roda a cada SetValue e recusava o proprio campo.
    l_oModel := MPFormModel():New(;
        "FCNS001",;
        NIL,;
        {|oModel| CH_PREVALIDA(oModel)},;
        NIL,;
        NIL)

    l_oModel:AddFields(;
        "ZA1MASTER",;
        NIL,;
        l_oStrZA1,;
        NIL,;
        NIL)

    l_oModel:AddGrid("ZA2DETAIL", "ZA1MASTER", l_oStrZA2)
    aAdd(aRelZA2, {"ZA2_IDCH", "ZA1_IDCH"})
    l_oModel:SetRelation("ZA2DETAIL", aRelZA2, ZA2->(IndexKey(1)))
    l_oModel:GetModel("ZA2DETAIL"):SetOptional(.T.)

    l_oModel:AddGrid("SZ6DETAIL", "ZA1MASTER", l_oStrSZ6)
    aAdd(aRelSZ6, {"Z6_CHAMADO", "Val(ZA1->ZA1_IDCH)"})
    l_oModel:SetRelation("SZ6DETAIL", aRelSZ6, SZ6->(IndexKey(2)))

    oGridSZ6 := l_oModel:GetModel("SZ6DETAIL")
    If oGridSZ6 <> Nil
        oGridSZ6:SetNoInsertLine(.T.)
        oGridSZ6:SetNoDeleteLine(.T.)
        oGridSZ6:SetNoUpdateLine(.T.)
        oGridSZ6:SetOptional(.T.)
    EndIf

    l_oModel:SetPrimaryKey({"ZA1_FILIAL","ZA1_IDCH"})
    // E-mails e oferta de agenda depois de gravar (se a gravacao falhar, nada sai).
    l_oModel:InstallEvent("CNS001POS", /*cOwner*/, CNS001POS():New())

    If nOperAtivar > 0
        l_oModel:SetOperation(nOperAtivar)
        l_oModel:Activate()
        If bTela <> Nil
            Eval(bTela, l_oModel)
        EndIf
    EndIf

Return l_oModel

/*/{Protheus.doc} CH_PREVALIDA
Pos-validacao do model (Incluir/Alterar/Assumir): obrigatorios, permissao, chamado fechado e regras do
Assumir (lCnsaAssumindo), via SetErrorMessage. Guarda o snapshot pre-commit usado no CH_POSGRAVACAO.
@param  p_oModel   Model da tela de Chamados
@return l_bOk      .T. se pode prosseguir, .F. se bloqueado (erro setado via SetErrorMessage)
/*/
Static Function CH_PREVALIDA(p_oModel)
    Local l_bOk  := .T.
    Local nOper  := p_oModel:GetOperation()
    Local oModelZA1 := Nil

    If nOper == 3
        oModelZA1 := p_oModel:GetModel("ZA1MASTER")
        If oModelZA1 <> Nil

            If Empty(AllTrim(oModelZA1:GetValue("ZA1_ASSUNT")))
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_ASSUNT", "ZA1", "ZA1_ASSUNT", "CNSA001", "Informe o assunto do chamado.")
                Return .F.
            EndIf

            If !(Type("lCnsaIncluirIncompleto") == "L" .And. lCnsaIncluirIncompleto)

                If Empty(AllTrim(oModelZA1:GetValue("ZA1_TIPO")))
                    p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_TIPO", "ZA1", "ZA1_TIPO", "CNSA001", "Informe o tipo do chamado.")
                    Return .F.
                EndIf

                If Empty(AllTrim(oModelZA1:GetValue("ZA1_PROJ")))
                    p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_PROJ", "ZA1", "ZA1_PROJ", "CNSA001", "Informe o projeto.")
                    Return .F.
                EndIf

                If Empty(AllTrim(oModelZA1:GetValue("ZA1_TAREFA")))
                    p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_TAREFA", "ZA1", "ZA1_TAREFA", "CNSA001", "Informe a tarefa.")
                    Return .F.
                EndIf

            EndIf
        EndIf
    EndIf

    // Quem nao e admin so altera o proprio chamado, sem trocar status, descricao nem tecnico (Assumir fica de fora).
    // ZA1-> ainda tem o valor gravado (antes do CommitData).
    If nOper == 4 .And. !CH_TEMACESSOGRUPO() .And. !(Type("lCnsaAssumindo") == "L" .And. lCnsaAssumindo)
        oModelZA1 := p_oModel:GetModel("ZA1MASTER")
        If AllTrim(ZA1->ZA1_CONSUL) <> AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC")) .Or. Empty(AllTrim(ZA1->ZA1_CONSUL))
            p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_CONSUL", "ZA1", "ZA1_CONSUL", "CNSA001", "Voce so pode alterar os seus chamados.")
            Return .F.
        EndIf
        If oModelZA1 <> Nil
            If AllTrim(oModelZA1:GetValue("ZA1_STATUS")) <> AllTrim(ZA1->ZA1_STATUS)
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_STATUS", "ZA1", "ZA1_STATUS", "CNSA001", "Somente administradores podem alterar o status do chamado.")
                Return .F.
            EndIf
            If AllTrim(oModelZA1:GetValue("ZA1_ANOT")) <> AllTrim(ZA1->ZA1_ANOT)
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_ANOT", "ZA1", "ZA1_ANOT", "CNSA001", "Somente administradores podem alterar a descricao do chamado.")
                Return .F.
            EndIf
            If AllTrim(oModelZA1:GetValue("ZA1_CONSUL")) <> AllTrim(ZA1->ZA1_CONSUL)
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_CONSUL", "ZA1", "ZA1_CONSUL", "CNSA001", "Somente administradores podem trocar o tecnico do chamado.")
                Return .F.
            EndIf
        EndIf
    EndIf

    If nOper == 4
        oModelZA1 := p_oModel:GetModel("ZA1MASTER")

        // Fechado (em disco) so aceita alteracao que o reabra; fechar um chamado aberto e permitido.
        // Excecao: troca de status pedida pelo admin no portal (lCnsaAlterandoStatus).
        If oModelZA1 <> Nil .And. AllTrim(ZA1->ZA1_STATUS) == "4" .And. ;
            AllTrim(oModelZA1:GetValue("ZA1_STATUS")) == "4" .And. ;
            !(Type("lCnsaAlterandoStatus") == "L" .And. lCnsaAlterandoStatus)
            p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_STATUS", "ZA1", "ZA1_STATUS", "CNSA001", "Chamado fechado nao pode ser alterado.")
            Return .F.
        EndIf

        If Type("lCnsaAssumindo") == "L" .And. lCnsaAssumindo .And. oModelZA1 <> Nil

            If !Empty(cAssumirConsulAnt)
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_CONSUL", "ZA1", "ZA1_CONSUL", "CNSA001", "Este chamado ja esta atribuido. Para redesignar use a opcao Alterar.")
                Return .F.
            EndIf

            If cAssumirStatusAnt == "4"
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_STATUS", "ZA1", "ZA1_STATUS", "CNSA001", "Chamado fechado nao pode ser assumido.")
                Return .F.
            EndIf

            If cAssumirStatusAnt == "2" .Or. cAssumirStatusAnt == "3"
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_STATUS", "ZA1", "ZA1_STATUS", "CNSA001", "Chamado pendente nao pode ser assumido.")
                Return .F.
            EndIf

            If Empty(AllTrim(oModelZA1:GetValue("ZA1_PROJ")))
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_PROJ", "ZA1", "ZA1_PROJ", "CNSA001", "O chamado precisa ter um projeto definido antes de ser assumido.")
                Return .F.
            EndIf

            If AllTrim(Posicione("AF8", 1, xFilial("AF8") + AllTrim(oModelZA1:GetValue("ZA1_PROJ")), "AF8_FASE")) <> "03"
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_PROJ", "ZA1", "ZA1_PROJ", "CNSA001", "O chamado so pode ser assumido com projeto em execucao (fase 03).")
                Return .F.
            EndIf

            If Empty(AllTrim(oModelZA1:GetValue("ZA1_TAREFA")))
                p_oModel:SetErrorMessage("ZA1MASTER", "ZA1_TAREFA", "ZA1", "ZA1_TAREFA", "CNSA001", "O chamado precisa ter uma tarefa definida antes de ser assumido.")
                Return .F.
            EndIf

        EndIf
    EndIf

    If Type("cConsulAnterior") <> "C"
        Public cConsulAnterior  := ""
    EndIf
    // Snapshot pre-commit dos campos do e-mail de alteracao (ZA1-> ainda tem o valor em disco).
    If Type("cStatusAnteriorAlt") <> "C"
        Public cStatusAnteriorAlt  := ""
    EndIf
    If Type("cAssuntoAnterior") <> "C"
        Public cAssuntoAnterior := ""
    EndIf
    If Type("cTipoAnterior") <> "C"
        Public cTipoAnterior    := ""
    EndIf
    If Type("cProjAnterior") <> "C"
        Public cProjAnterior    := ""
    EndIf
    If Type("cTarefaAnterior") <> "C"
        Public cTarefaAnterior  := ""
    EndIf
    If Type("cDataAnterior") <> "C"
        Public cDataAnterior    := ""
    EndIf

    If (nOper == 4)
        cConsulAnterior  := AllTrim(ZA1->ZA1_CONSUL)
        cStatusAnteriorAlt := AllTrim(ZA1->ZA1_STATUS)
        cAssuntoAnterior := AllTrim(ZA1->ZA1_ASSUNT)
        cTipoAnterior    := AllTrim(ZA1->ZA1_TIPO)
        cProjAnterior    := AllTrim(ZA1->ZA1_PROJ)
        cTarefaAnterior  := AllTrim(ZA1->ZA1_TAREFA)
        cDataAnterior    := If(ValType(ZA1->ZA1_DATA) == "D", DToC(ZA1->ZA1_DATA), AllTrim(ZA1->ZA1_DATA))
    EndIf

Return l_bOk

/*/{Protheus.doc} CH_POSGRAVACAO
Depois de gravar (evento CNS001POS): e-mails de alteracao/remocao/designacao e oferta de agenda (tela).
@param  p_oModel   Model da tela de Chamados
@return .T. sempre
/*/
Static Function CH_POSGRAVACAO(p_oModel)
    Local nOper       := p_oModel:GetOperation()
    Local lViaRest    := (Type("lCnsaViaRest") == "L" .And. lCnsaViaRest)
    Local cConsulNovo := ""
    Local cEmailAnt   := ""
    Local cCliente    := ""
    Local cIdCh       := ""
    Local cAssunto    := ""
    Local cExclPor    := ""
    Local cAlias      := GetNextAlias()
    Local nCham       := 0
    Local cClienteAp  := ""
    Local cLojaAp     := ""
    Local cProjAp     := ""
    Local cTarefaAp   := ""
    Local cTecnicoAp  := ""
    Local nQtdAgenda  := 0
    Local cPergAgenda := ""
    Local cHoraAtual  := ""
    Local cHoraFim    := ""
    Local cEmailCli   := ""
    Local cStatusNovo := ""
    Local cTipoNovo   := ""
    Local cProjNovo   := ""
    Local cTarefaNovo := ""
    Local cDataNovo   := ""
    Local aMudancas   := {}
    Local lNotificarCliente := .F.
    Local lNotificarTecnico := .T.
    Local lOfereceCli := .F.
    Local lOfereceTec := .F.
    Local aEnvio      := {}

    If Type("cConsulAnterior") <> "C"
        Public cConsulAnterior := ""
    EndIf
    If Type("lCnsaNotificarCliente") <> "L"
        Public lCnsaNotificarCliente := .F.
    EndIf

    cExclPor := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_NOMTEC"))

    If nOper == 4

        cConsulNovo := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_CONSUL"))
        cIdCh       := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_IDCH"))
        // Cliente vazio: Posicione cairia no 1o registro da SA1.
        cCliente    := AllTrim(p_oModel:GetValue("ZA1MASTER","ZA1_CLIENT"))
        cCliente    := If(Empty(cCliente), "", AllTrim(Posicione("SA1",1,xFilial("SA1")+;
                            cCliente+AllTrim(p_oModel:GetValue("ZA1MASTER","ZA1_LOJA")),"A1_NREDUZ")))
        cAssunto    := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_ASSUNT"))
        cEmailCli   := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_EMAIL"))
        cStatusNovo := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_STATUS"))
        cTipoNovo   := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_TIPO"))
        cProjNovo   := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_PROJ"))
        cTarefaNovo := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_TAREFA"))
        cDataNovo   := If(ValType(p_oModel:GetValue("ZA1MASTER", "ZA1_DATA")) == "D", ;
                            DToC(p_oModel:GetValue("ZA1MASTER", "ZA1_DATA")), ;
                            AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_DATA")))
        nCham       := Val(cIdCh)

        // Campos alterados (De/Para) pro e-mail de alteracao - sem o tecnico (tem e-mail proprio) e sem o status
        // quando veio do Assumir (o e-mail de designacao ja avisa).
        If Type("cStatusAnteriorAlt") == "C" .And. cStatusAnteriorAlt <> cStatusNovo .And. ;
            !(Type("lCnsaAssumindo") == "L" .And. lCnsaAssumindo)
            AAdd(aMudancas, {"Status", CH_STATUSLABEL(cStatusAnteriorAlt), CH_STATUSLABEL(cStatusNovo)})
        EndIf
        If Type("cAssuntoAnterior") == "C" .And. cAssuntoAnterior <> cAssunto
            AAdd(aMudancas, {"Assunto", cAssuntoAnterior, cAssunto})
        EndIf
        If Type("cTipoAnterior") == "C" .And. cTipoAnterior <> cTipoNovo
            AAdd(aMudancas, {"Tipo", cTipoAnterior, cTipoNovo})
        EndIf
        If Type("cProjAnterior") == "C" .And. cProjAnterior <> cProjNovo
            AAdd(aMudancas, {"Projeto", cProjAnterior, cProjNovo})
        EndIf
        If Type("cTarefaAnterior") == "C" .And. cTarefaAnterior <> cTarefaNovo
            AAdd(aMudancas, {"Tarefa", cTarefaAnterior, cTarefaNovo})
        EndIf
        If Type("cDataAnterior") == "C" .And. cDataAnterior <> cDataNovo
            AAdd(aMudancas, {"Data", cDataAnterior, cDataNovo})
        EndIf

        // Quem recebe: a tela pergunta (CH_PERGUNTAEMAIL); o REST usa as flags notificarCliente/notificarTecnico.
        lOfereceCli := !Empty(cEmailCli) .And. (Len(aMudancas) > 0 .Or. (!Empty(cConsulNovo) .And. cConsulNovo <> cConsulAnterior))
        lOfereceTec := cConsulNovo <> cConsulAnterior
        If lViaRest
            If lOfereceCli
                lNotificarCliente := lCnsaNotificarCliente
            EndIf
            If lOfereceTec
                lNotificarTecnico := (Type("lCnsaNotificarTecnico") <> "L" .Or. lCnsaNotificarTecnico)
            EndIf
        ElseIf lOfereceCli .Or. lOfereceTec
            aEnvio := CH_PERGUNTAEMAIL("Alteracao do Chamado " + cIdCh, lOfereceCli, lOfereceTec)
            lNotificarCliente := aEnvio[1]
            If lOfereceTec
                lNotificarTecnico := aEnvio[2]
            EndIf
        EndIf

        If lNotificarTecnico .And. !Empty(cConsulAnterior) .And. cConsulAnterior <> cConsulNovo
            cEmailAnt := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cConsulAnterior, "AA1_EMAIL"))
            CH_EMAIL("CANCELA", cEmailAnt, cIdCh, cCliente, CH_CONSULTA("AGENDA", nCham, DToC(Date())), ;
                "Tecnico substituido no chamado", cExclPor)
        EndIf

        If !Empty(cConsulNovo) .And. cConsulNovo <> cConsulAnterior
            CH_EMAIL("DESIGNA", "", cIdCh, cConsulNovo, lNotificarCliente, lNotificarTecnico)
        EndIf

        If lNotificarCliente .And. Len(aMudancas) > 0
            CH_EMAIL("ALTERACAO", cEmailCli, cIdCh, aMudancas)
        EndIf
    EndIf

    If nOper == 3 .Or. nOper == 4
        cIdCh      := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_IDCH"))
        cTecnicoAp := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_CONSUL"))

        // Pelo portal nunca cria agenda sozinho (agenda so pela acao "Criar Agenda"): nem conta a SZ6.
        If !Empty(cTecnicoAp) .And. !lViaRest .And. !IsBlind()

            nCham := Val(cIdCh)

            nQtdAgenda := 0
            BeginSql Alias cAlias
                SELECT COUNT(*) AS QTD
                FROM %Table:SZ6% SZ6
                WHERE Z6_FILIAL  = %xFilial:SZ6%
                  AND Z6_CHAMADO = %Exp:nCham%
                  AND %NotDel%
            EndSql
            If !(cAlias)->(Eof())
                nQtdAgenda := (cAlias)->QTD
            EndIf
            (cAlias)->(DbCloseArea())

            cPergAgenda := IIf(nQtdAgenda == 0, ;
                "Este chamado nao possui agendamento. Deseja criar uma agenda para ele agora?", ;
                "Este chamado ja possui " + cValToChar(nQtdAgenda) + " agendamento(s). Deseja criar mais um agora?")

            If MsgYesNo(cPergAgenda, "Agendar Chamado")

                cClienteAp := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_CLIENT"))
                cLojaAp    := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_LOJA"))
                cAssunto   := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_ASSUNT"))
                cProjAp    := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_PROJ"))
                cTarefaAp  := AllTrim(p_oModel:GetValue("ZA1MASTER", "ZA1_TAREFA"))

                cHoraAtual := Left(Time(), 5)
                cHoraFim   := StrZero(Val(Left(cHoraAtual, 2)) + 1, 2) + ":" + Right(cHoraAtual, 2)
                If Val(Left(cHoraFim, 2)) >= 24
                    cHoraFim := "23:59"
                EndIf

                CH_MONTAAGENDA(cTecnicoAp, Date(), cHoraAtual, cHoraFim, ;
                    cClienteAp, cLojaAp, cAssunto, cProjAp, cTarefaAp, cIdCh)
            EndIf
        EndIf
    EndIf

Return .T.

/*/{Protheus.doc} CH_LIMPAFLAGS
Volta ao padrao as flags Public que os nucleos REST ligam (so as que existem).
/*/
Static Function CH_LIMPAFLAGS()
    If Type("lCnsaViaRest") == "L"
        lCnsaViaRest := .F.
    EndIf
    If Type("lCnsaIncluirIncompleto") == "L"
        lCnsaIncluirIncompleto := .F.
    EndIf
    If Type("lCnsaAlterandoStatus") == "L"
        lCnsaAlterandoStatus := .F.
    EndIf
    If Type("lCnsaAssumindo") == "L"
        lCnsaAssumindo := .F.
    EndIf
    If Type("lCnsaNotificarCliente") == "L"
        lCnsaNotificarCliente := .F.
    EndIf
    If Type("lCnsaNotificarTecnico") == "L"
        lCnsaNotificarTecnico := .T.
    EndIf
Return

/*/{Protheus.doc} CH_ACHARZA1
Posiciona a ZA1 no chamado.
@return lAchou
/*/
Static Function CH_ACHARZA1(cIdCh)
    DbSelectArea("ZA1")
    ZA1->(DbSetOrder(1))
// Vazio ou sem PadR casava chave parcial (idCh vazio achava o 1o chamado da filial).
Return !Empty(AllTrim(cIdCh)) .And. ZA1->(DbSeek(xFilial("ZA1") + PadR(AllTrim(cIdCh), TamSX3("ZA1_IDCH")[1])))

/*/{Protheus.doc} CH_PROXZA2
Proxima ZA2_IDGRID do chamado (1 se nao tem interacao). ZA2_IDCH e Character: nao usar Val() (ORA-01722).
@return nSeq
/*/
Static Function CH_PROXZA2(cIdCh)
    Local cAlias := GetNextAlias()
    Local nSeq   := 1

    BeginSql Alias cAlias
        SELECT MAX(ZA2_IDGRID) MAXGRID
        FROM %Table:ZA2% ZA2
        WHERE ZA2_FILIAL = %xFilial:ZA2%
          AND ZA2_IDCH   = %Exp:cIdCh%
          AND %NotDel%
    EndSql
    If !(cAlias)->(Eof()) .And. !Empty(AllTrim((cAlias)->MAXGRID))
        nSeq := Val(AllTrim((cAlias)->MAXGRID)) + 1
    EndIf
    (cAlias)->(DbCloseArea())

Return nSeq

/*/{Protheus.doc} CH_CONSULTA
Consultas usadas em mais de um lugar - uma opcao por Case.
  AGENDA (nCham, cDataPadrao)  -> {cData, cHmini, cHmfim} da agenda (SZ6) do chamado
  TAREFA (cProjeto, cTarefa)   -> descricao da tarefa (AF9), mesma regra do OS_NOMETAREFA (CNSA002)
/*/
Static Function CH_CONSULTA(cTipo, x1, x2)
    Local xRet     := Nil
    Local cAlias   := ""
    Local nCham    := 0
    Local cProjeto := ""
    Local cTarefa  := ""
    Local cRevisa  := ""

    Do Case
    Case cTipo == "AGENDA"
        // Chamado sem numero: -1 (Val("") = 0 casaria com toda agenda sem chamado).
        nCham  := If(x1 > 0, x1, -1)
        xRet   := {x2, "00:00", "00:00"}
        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT Z6_DTAGE, Z6_HMINI, Z6_HMFIM
            FROM %Table:SZ6% SZ6
            WHERE Z6_FILIAL  = %xFilial:SZ6%
              AND Z6_CHAMADO = %Exp:nCham%
              AND %NotDel%
        EndSql
        If !(cAlias)->(Eof())
            If ValType((cAlias)->Z6_DTAGE) == "D"
                xRet[1] := DToC((cAlias)->Z6_DTAGE)
            Else
                xRet[1] := AllTrim((cAlias)->Z6_DTAGE)
                If Len(xRet[1]) == 8
                    xRet[1] := SubStr(xRet[1],7,2) + "/" + SubStr(xRet[1],5,2) + "/" + SubStr(xRet[1],1,4)
                EndIf
            EndIf
            xRet[2] := If(Empty((cAlias)->Z6_HMINI), "00:00", AllTrim((cAlias)->Z6_HMINI))
            xRet[3] := If(Empty((cAlias)->Z6_HMFIM), "00:00", AllTrim((cAlias)->Z6_HMFIM))
        EndIf
        (cAlias)->(DbCloseArea())

    Case cTipo == "TAREFA"
        cProjeto := AllTrim(x1)
        cTarefa  := AllTrim(x2)
        xRet     := ""
        If Empty(cProjeto) .Or. Empty(cTarefa)
            Return xRet
        EndIf
        // AF9 ordem 1 = FILIAL+PROJET+REVISA+TAREFA: revisao atual do projeto (AF8_REVISA).
        cRevisa := Posicione("AF8", 1, xFilial("AF8") + PadR(cProjeto, TamSX3("AF8_PROJET")[1]), "AF8_REVISA")
        xRet    := AllTrim(Posicione("AF9", 1, xFilial("AF9") + PadR(cProjeto, TamSX3("AF9_PROJET")[1]) + ;
            PadR(AllTrim(cRevisa), TamSX3("AF9_REVISA")[1]) + PadR(cTarefa, TamSX3("AF9_TAREFA")[1]), "AF9_DESCRI"))
        // Revisao sem a tarefa: a revisao mais recente que tenha a tarefa.
        If Empty(xRet)
            cAlias := GetNextAlias()
            BeginSql Alias cAlias
                SELECT AF9_DESCRI
                FROM %Table:AF9% AF9
                WHERE AF9_FILIAL = %xFilial:AF9%
                  AND TRIM(AF9_PROJET) = %Exp:cProjeto%
                  AND TRIM(AF9_TAREFA) = %Exp:cTarefa%
                  AND AF9.%NotDel%
                ORDER BY AF9_REVISA DESC
            EndSql
            If !(cAlias)->(Eof())
                xRet := AllTrim((cAlias)->AF9_DESCRI)
            EndIf
            (cAlias)->(DbCloseArea())
        EndIf
    EndCase

Return xRet

/*/{Protheus.doc} CH_PARAMS
Parametros do POST: query string com o corpo JSON por cima (o portal novo manda no corpo - URL longa;
o antigo, na query - aceita os dois). Corpo invalido e ignorado.
@return jPar   JsonObject com os parametros
/*/
Static Function CH_PARAMS()
    Local jPar   := oRest:getQueryRequest()
    Local jBody  := JsonObject():New()
    Local cBody  := oRest:getBodyRequest()
    Local aNomes := {}
    Local xVal   := Nil
    Local nI     := 0

    If ValType(jPar) != "J"
        jPar := JsonObject():New()
    EndIf
    If ValType(cBody) == "C" .And. !Empty(cBody) .And. Empty(jBody:FromJson(cBody))
        aNomes := jBody:GetNames()
        For nI := 1 To Len(aNomes)
            // Logico/numero no corpo vira texto como na query ("1"/"0").
            xVal := jBody[aNomes[nI]]
            jPar[aNomes[nI]] := If(ValType(xVal) == "L", If(xVal, "1", "0"), If(ValType(xVal) == "N", cValToChar(xVal), xVal))
        Next nI
    EndIf

Return jPar

/*/{Protheus.doc} CNS001POS
Evento do model do chamado: AfterTTS (depois de gravar) chama o CH_POSGRAVACAO.
/*/
// TLPP: membro sem visibilidade e PRIVATE.
Class CNS001POS From FWModelEvent
    Public Method New() Constructor
    Public Method AfterTTS(oModel, cModelId)
EndClass

Method New() Class CNS001POS
Return Self

Method AfterTTS(oModel, cModelId) Class CNS001POS
    CH_POSGRAVACAO(oModel)
Return

/*/{Protheus.doc} CH_TEMACESSOGRUPO
Administrador = tecnico do usuario com AA1_RSPMNT = 1.
@return .T. se o tecnico e responsavel (AA1_RSPMNT == "1"), .F. caso contrario
/*/
Static Function CH_TEMACESSOGRUPO()
    Local cRspMnt := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_RSPMNT"))

Return cRspMnt == "1"

/*/{Protheus.doc} CH_PERGUNTAEMAIL
Janela com checkbox: enviar e-mail ao analista e/ou ao cliente (fechar = nao envia).
@param  cTitulo      Titulo da janela (ex: "Alteracao do Chamado 000250")
@param  lOfereceCli  .T. mostra a opcao "Cliente"
@param  lOfereceTec  .T. mostra a opcao "Analista (tecnico)"
@return aRet         {lEnviarCliente, lEnviarTecnico}
/*/
Static Function CH_PERGUNTAEMAIL(cTitulo, lOfereceCli, lOfereceTec)
    Local oDlg     := Nil
    Local oChkTec  := Nil
    Local oChkCli  := Nil
    Local oBtnOk   := Nil
    Local nLin     := 28

    Private lChkTec  := .T.
    Private lChkCli  := .T.
    Private lConfEml := .F.

    Default lOfereceCli := .F.
    Default lOfereceTec := .F.

    If !lOfereceCli .And. !lOfereceTec
        Return {.F., .F.}
    EndIf

    DEFINE MSDIALOG oDlg TITLE cTitulo FROM 0,0 TO 200,420 PIXEL

        @ 10,10 SAY "Notificações por e-mail:" SIZE 200,10 PIXEL OF oDlg

        If lOfereceTec
            @ nLin,14 CHECKBOX oChkTec VAR lChkTec PROMPT "Enviar e-mail para o técnico" SIZE 180,10 PIXEL OF oDlg
            nLin += 16
        EndIf
        If lOfereceCli
            @ nLin,14 CHECKBOX oChkCli VAR lChkCli PROMPT "Enviar e-mail para o cliente" SIZE 180,10 PIXEL OF oDlg
            nLin += 16
        EndIf

        oBtnOk := TButton():New(nLin + 12, 80, "Confirmar", oDlg, {|| lConfEml := .T., oDlg:End()}, 60,14,,,.F.,.T.,.F.,,.F.,,,.F.)

    ACTIVATE MSDIALOG oDlg CENTERED

    If !lConfEml
        Return {.F., .F.}
    EndIf

Return {lOfereceCli .And. lChkCli, lOfereceTec .And. lChkTec}

/*/{Protheus.doc} CH_TELA
Menu Visualizar/Incluir/Alterar/Excluir (igual ao OS_TELA da OS), cada um com a sua regra no Do Case.
Visualizar/Incluir/Alterar: monta e ativa o model aqui e abre a View. Excluir: motivo e CH_NUCLEOEXCLUIR.
@param  nOper  MODEL_OPERATION_VIEW (1), INSERT (3), UPDATE (4) ou DELETE (5)
/*/
User Function CH_TELA(nOper)
    Local lGrava     := nOper == MODEL_OPERATION_INSERT .Or. nOper == MODEL_OPERATION_UPDATE
    Local lGravou    := .F.
    Local lNumerou   := .F.
    Local aTela      := {.F., .F.}
    Local oModel     := Nil
    Local aCpos      := {}
    Local cCpo       := ""
    Local nI         := 0
    Local aEnvio     := {}
    Local cIdCh      := AllTrim(ZA1->ZA1_IDCH)
    Local cMotivo    := ""
    Local aResultado := {}
    Local oDialog    := Nil
    Local oBtnOk     := Nil
    Local oBtnCan    := Nil
    Local oGetMotivo := Nil
    Local oCombo     := Nil
    Local lNotificarCliente := .F.
    Local lNotificarTecnico := .F.

    Do Case
    Case nOper == MODEL_OPERATION_UPDATE
        // Admin altera qualquer chamado; quem nao e admin, so o proprio (sem tecnico: assumir antes).
        If !CH_TEMACESSOGRUPO() .And. ;
            (Empty(AllTrim(ZA1->ZA1_CONSUL)) .Or. AllTrim(ZA1->ZA1_CONSUL) != AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC")))
            If Empty(AllTrim(ZA1->ZA1_CONSUL))
                MsgAlert("Este chamado ainda nao tem tecnico. Use a opcao Assumir para atende-lo.", "Alterar")
            Else
                MsgAlert("Voce so pode alterar os seus chamados.", "Alterar")
            EndIf
            Return
        EndIf

    Case nOper == MODEL_OPERATION_DELETE
        // Excluir: pede o motivo (quando ja tem tecnico) e chama o CH_NUCLEOEXCLUIR.
        If ZA1->(Eof()) .Or. ZA1->(Bof())
            MsgAlert("Nenhum chamado selecionado.", "Excluir")
            Return
        EndIf

        If !MsgYesNo("Confirma excluir o chamado " + cIdCh + "?", "Excluir")
            Return
        EndIf

        aEnvio := CH_PERGUNTAEMAIL("Excluir Chamado " + cIdCh, !Empty(AllTrim(ZA1->ZA1_EMAIL)), !Empty(AllTrim(ZA1->ZA1_CONSUL)))
        lNotificarCliente := aEnvio[1]
        lNotificarTecnico := aEnvio[2]

        If Empty(AllTrim(ZA1->ZA1_CONSUL))
            aResultado := CH_NUCLEOEXCLUIR(cIdCh, "", lNotificarCliente, .F.)
            If aResultado[1] != 200
                MsgAlert(aResultado[2], "Excluir")
            EndIf
            Return
        EndIf

        Private aMotivos := {"Encerramento pela Apia", "Encerramento pelo Cliente", "Outro motivo"}
        Private cMotivoSel := aMotivos[1]
        Private cOutroMotivo := Space(100)
        Private lMotConfirm  := .F.

        DEFINE MSDIALOG oDialog TITLE "Motivo da Exclusao" FROM 0,0 TO 300,600 PIXEL

            @ 10,10  SAY "Selecione o motivo do Encerramento:" SIZE 250,12 PIXEL OF oDialog
            @ 25,10  COMBOBOX oCombo VAR cMotivoSel ITEMS aMotivos SIZE 250,12 PIXEL OF oDialog

            @ 60,10  SAY "Descricao: " SIZE 300,12 PIXEL OF oDialog
            @ 75,10  MSGET oGetMotivo VAR cOutroMotivo PICTURE "@!" SIZE 240,12 PIXEL OF oDialog

            oBtnOk  := TButton():New(100, 90,  "OK",       oDialog, {|| lMotConfirm:=.T., oDialog:End()}, 50,14,,,.F.,.T.,.F.,,.F.,,,.F.)
            oBtnCan := TButton():New(100, 145, "Cancelar", oDialog, {|| oDialog:End()},                   50,14,,,.F.,.T.,.F.,,.F.,,,.F.)

        ACTIVATE MSDIALOG oDialog CENTERED

        If !lMotConfirm
            Return
        EndIf

        Do Case
            Case cMotivoSel == "Encerramento pela Apia"
                cMotivo := If(Empty(AllTrim(cOutroMotivo)), "Encerramento pela Apia", "Encerramento pela Apia - " + AllTrim(cOutroMotivo))
            Case cMotivoSel == "Encerramento pelo Cliente"
                cMotivo := If(Empty(AllTrim(cOutroMotivo)), "Encerramento pelo Cliente", "Encerramento pelo Cliente - " + AllTrim(cOutroMotivo))
            Case cMotivoSel == "Outro motivo"
                If Empty(AllTrim(cOutroMotivo))
                    MsgAlert("Informe o motivo para a opcao 'Outro'.", "Motivo")
                    Return
                EndIf
                cMotivo := AllTrim(cOutroMotivo)
        EndCase

        aResultado := CH_NUCLEOEXCLUIR(cIdCh, cMotivo, lNotificarCliente, lNotificarTecnico)
        If aResultado[1] != 200
            MsgAlert(aResultado[2], "Excluir")
        EndIf
        Return
    EndCase

    // M->ZA1_* no frame que fica vivo com a tela aberta (lupas/F3). Pelo dicionario (.T.): inclui os campos
    // virtuais (nome do cliente etc.) - sem eles a lupa tentava criar o M-> e dava "owner private environment not found".
    If lGrava
        RegToMemory("ZA1", nOper == MODEL_OPERATION_INSERT, .T.)
        // Campo que ficou sem M-> (ou com Nil) quebrava o fechamento da lupa - cria vazio e avisa no console.
        aCpos := FWFormStruct(1, "ZA1"):GetFields()
        For nI := 1 To Len(aCpos)
            cCpo := aCpos[nI][MODEL_FIELD_IDFIELD]
            If Type("M->" + cCpo) == "U"
                ConOut("CH_TELA: M->" + cCpo + " sem valor (Nil) - criado vazio")
                &("M->" + cCpo) := CriaVar(cCpo, .F.)
            EndIf
        Next nI
    EndIf
    // A tela abre DENTRO do CH_MONTARMODEL (bTela): fora dele o FWInitCpo dava "owner private environment not found".
    oModel := CH_MONTARMODEL(nOper, {|oMdl| aTela := CH_ABRIRTELA(oMdl, nOper)})
    lGravou  := aTela[1] .And. lGrava
    lNumerou := aTela[2]
    // Fecha o model desta tela: senao ele fica ativo (FWModelActive) depois que a tela fechou.
    oModel:DeActivate()
    If lNumerou
        If lGravou
            ConfirmSX8()
        Else
            RollBackSX8()
        EndIf
    EndIf

    // Incluir gravado: mesma escolha do portal, tecnico (designacao) e cliente ("Chamado Aberto").
    If lGravou .And. nOper == MODEL_OPERATION_INSERT
        aEnvio := CH_PERGUNTAEMAIL("Inclusao do Chamado " + AllTrim(ZA1->ZA1_IDCH), ;
            !Empty(AllTrim(ZA1->ZA1_EMAIL)), !Empty(AllTrim(ZA1->ZA1_CONSUL)))
        If aEnvio[2]
            CH_EMAIL("DESIGNA", "", AllTrim(ZA1->ZA1_IDCH), AllTrim(ZA1->ZA1_CONSUL), .F., .T.)
        EndIf
        If aEnvio[1]
            CH_EMAIL("CHAMADOCRIADO", AllTrim(ZA1->ZA1_EMAIL), AllTrim(ZA1->ZA1_IDCH))
        EndIf
    EndIf
Return

/*/{Protheus.doc} CH_ABRIRTELA
Abre a View do chamado com o model ja ativo (chamada de dentro do CH_MONTARMODEL, ver bTela).
@param  oModel     Model ativo
@param  nOper      MODEL_OPERATION_*
@return aRet       {lConfirmou (FWExecView devolveu 0), lNumerou (numerou o ZA1_IDCH aqui)}
/*/
Static Function CH_ABRIRTELA(oModel, nOper)
    Local lNumerou := .F.

    // O dicionario nao inicializa ZA1_IDCH: sem isto o chamado gravava sem ID.
    If nOper == MODEL_OPERATION_INSERT .And. Empty(oModel:GetValue("ZA1MASTER", "ZA1_IDCH"))
        oModel:GetModel("ZA1MASTER"):LoadValue("ZA1_IDCH", GetSxeNum("ZA1", "ZA1_IDCH"))
        lNumerou := .T.
    EndIf

    // Model desta tela como ativo (o ViewDef usa o ativo).
    FWModelActive(oModel)
Return {FWExecView("Registro de Chamados", "apia.cnsa001.u_cns001", nOper, , {|| .T.}, NIL, NIL, NIL, NIL, NIL, NIL, oModel) == 0, lNumerou}

/*/{Protheus.doc} GETIDGRID
Proxima sequencia do grid ZA2DETAIL. Chamada pelo dicionario: nao mudar o nome.
@return Sequencia formatada em 3 digitos (StrZero)
/*/
User Function GETIDGRID()
    Local oModel  := FWModelActive()
    Local l_oZA2  := Nil
    Local nLines  := 0
    Local nLinAtu := 0
    Local nI      := 0
    Local nSeq    := 1

    If oModel == Nil
        Return StrZero(1, 3)
    EndIf

    l_oZA2 := oModel:GetModel("ZA2DETAIL")

    If l_oZA2 == Nil
        Return StrZero(1, 3)
    EndIf

    nLines  := l_oZA2:Length()
    nLinAtu := l_oZA2:GetLine()

    // Maior sequencia + 1 (contar linhas repetia o numero depois de excluir uma; apagadas entram no maximo).
    For nI := 1 To nLines
        l_oZA2:GoLine(nI)
        nSeq := Max(nSeq, Val(l_oZA2:GetValue("ZA2_IDGRID")) + 1)
    Next nI

    l_oZA2:GoLine(nLinAtu)
Return StrZero(nSeq, 3)

/*/{Protheus.doc} CNSA_LEG
Exibe a legenda de cores/status do chamado (BrwLegenda).
/*/
User Function CNSA_LEG()
    BrwLegenda("Legenda de Status", "Status do Chamado", ;
        { ;
            { "BR_AZUL",      "Aberto"        }, ;
            { "BR_AMARELO",   "Pendente Apia" }, ;
            { "BR_PINK",      "Pendente Cli." }, ;
            { "BR_VERDE",     "Fechado"       }, ;
            { "BR_CINZA",     "Incompleto"    }  ;
        })
Return

/*/{Protheus.doc} CNSA_CRIAAGENDA
Menu Agendar: agenda padrao (hoje, 08:00-09:00) pro tecnico do chamado.
/*/
User Function CNSA_CRIAAGENDA()
    Local cIdCh    := AllTrim(ZA1->ZA1_IDCH)
    Local cTecnico := AllTrim(ZA1->ZA1_CONSUL)
    Local cCliente := AllTrim(ZA1->ZA1_CLIENT)
    Local cLoja    := AllTrim(ZA1->ZA1_LOJA)

    If ZA1->(Eof()) .Or. ZA1->(Bof())
        MsgAlert("Nenhum chamado selecionado.", "Agendar")
        Return
    EndIf

    If Empty(cTecnico)
        MsgAlert("O chamado precisa ter um tecnico designado antes de agendar.", "Agendar")
        Return
    EndIf

    CH_MONTAAGENDA(cTecnico, Date(), "08:00", "09:00", ;
        cCliente, cLoja, ;
        AllTrim(ZA1->ZA1_ASSUNT), AllTrim(ZA1->ZA1_PROJ), ;
        AllTrim(ZA1->ZA1_TAREFA), cIdCh)

    // E-mail ao tecnico sai do evento da Agenda (CNS003OUTL, CNSA003), com o Outlook.

Return

/*/{Protheus.doc} CNSA_INTERAGIR
Menu Interagir: valida o chamado e abre a inclusao de interacao (CNSAZA2VIEW).
/*/
User Function CNSA_INTERAGIR()
    Local cConsul    := AllTrim(ZA1->ZA1_CONSUL)
    Local cStatus    := AllTrim(ZA1->ZA1_STATUS)
    Local cCliente   := AllTrim(ZA1->ZA1_CLIENT)
    Local cIdCh      := AllTrim(ZA1->ZA1_IDCH)
    Local cEmailCli  := AllTrim(ZA1->ZA1_EMAIL)
    Local oModel     := Nil
    Local cAlias     := GetNextAlias()
    Local nSeq       := 1
    Local cSeqGrav   := ""
    Local cTextoInteracao := ""
    Local aEnvio     := {}

    If ZA1->(Eof()) .Or. ZA1->(Bof())
        MsgAlert("Nenhum chamado selecionado.", "Interagir")
        Return
    EndIf

    If cStatus == "4"
        MsgAlert("Chamado fechado nao pode receber interacoes.", "Interagir")
        Return
    EndIf

    If Empty(cConsul)
        MsgAlert("O chamado precisa ter um tecnico designado para Interagir.", "Interagir")
        Return
    EndIf

    If Empty(cCliente)
        MsgAlert("O chamado precisa ter um cliente designado para Interagir.", "Interagir")
        Return
    EndIf

    If AllTrim(cConsul) <> AllTrim(cConsultor) .And. !CH_TEMACESSOGRUPO()
        MsgAlert("Voce nao tem permissao para interagir neste chamado.", "Interagir")
        Return
    EndIf

    nSeq := CH_PROXZA2(cIdCh)

    oModel := FWLoadModel("CNSAZA2VIEW")
    If oModel == Nil
        MsgAlert("Nao foi possivel carregar o modelo CNSAZA2VIEW.", "Interagir")
        Return
    EndIf
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    oModel:SetValue("ZA2MASTER", "ZA2_IDCH",   cIdCh)
    oModel:SetValue("ZA2MASTER", "ZA2_CONSUL", cConsultor)
    oModel:SetValue("ZA2MASTER", "ZA2_DATA",   CToD(DToC(Date())))
    oModel:SetValue("ZA2MASTER", "ZA2_IDGRID", StrZero(nSeq, 3))

    FWExecView("Nova Interacao - Chamado " + cIdCh, ;
               "CNSAZA2VIEW", ;
               MODEL_OPERATION_INSERT, ;
               , ;
               {|| .T.}, ;
               NIL, NIL, NIL, NIL, NIL, NIL, ;
               oModel)

    oModel:DeActivate()

    // CNSAZA2VIEW nao diz se salvou: confere se a interacao foi gravada antes de notificar.
    cSeqGrav := StrZero(nSeq, 3)
    cAlias   := GetNextAlias()
    BeginSql Alias cAlias
        SELECT ZA2_DESCRI
        FROM %Table:ZA2% ZA2
        WHERE ZA2_FILIAL = %xFilial:ZA2%
          AND ZA2_IDCH   = %Exp:cIdCh%
          AND ZA2_IDGRID = %Exp:cSeqGrav%
          AND %NotDel%
    EndSql
    If !(cAlias)->(Eof())
        cTextoInteracao := U_CNSOUTL("UTF8", AllTrim((cAlias)->ZA2_DESCRI))
    EndIf
    (cAlias)->(DbCloseArea())

    // Cliente e tecnico do chamado (o tecnico so se nao foi ele quem interagiu).
    If !Empty(cTextoInteracao)
        aEnvio := CH_PERGUNTAEMAIL("Nova Interacao - Chamado " + cIdCh, !Empty(cEmailCli), cConsul <> AllTrim(cConsultor))
        If aEnvio[1]
            CH_EMAIL("INTERACAO", cEmailCli, cIdCh, cTextoInteracao, "incluida", "Nova Interacao")
        EndIf
        If aEnvio[2]
            CH_EMAIL("INTERACAO", AllTrim(Posicione("AA1", 1, xFilial("AA1") + cConsul, "AA1_EMAIL")), cIdCh, cTextoInteracao, "incluida", "Nova Interacao")
        EndIf
    EndIf

Return

/*/{Protheus.doc} CNSA_CLIENTE
Gatilho SX7 do ZA1_CLIENT: nome do cliente em ZA1_NOME. Chamada pelo dicionario: nao mudar o nome.
@return cNome   Nome do cliente encontrado (ou vazio)
/*/
User Function CNSA_CLIENTE()
    Local oModel := FWModelActive()
    Local cCod   := ""
    Local cLoja  := ""
    Local cNome  := ""

    cCod  := AllTrim(oModel:GetValue("ZA1MASTER", "ZA1_CLIENT"))
    cLoja := AllTrim(oModel:GetValue("ZA1MASTER", "ZA1_LOJA"))

    // Codigo vazio: Posicione cairia no 1o registro da SA1 (soft-seek).
    If Empty(cCod)
        cNome := ""
    Else
        cNome := Posicione("SA1", 1, xFilial("SA1") + cCod + cLoja, "A1_NREDUZ")
    EndIf

    oModel:LoadValue("ZA1MASTER", "ZA1_NOME", SubStr(cNome, 1, TamSX3("ZA1_NOME")[1]))

Return cNome

/*/{Protheus.doc} CNSA_TECNICO
Gatilho SX7 do ZA1_CONSUL: nome do tecnico em ZA1_NOMTEC. Chamada pelo dicionario: nao mudar o nome.
@return cNome   Nome do tecnico encontrado (ou vazio)
/*/
User Function CNSA_TECNICO()
    Local oModel := FWModelActive()
    Local cCod   := ""
    Local cNome  := ""

    cCod  := AllTrim(oModel:GetValue("ZA1MASTER", "ZA1_CONSUL"))
    // Codigo vazio: Posicione cairia no 1o tecnico da AA1.
    cNome := If(Empty(cCod), "", Posicione("AA1", 1, xFilial("AA1") + cCod, "AA1_NOMTEC"))

    oModel:LoadValue("ZA1MASTER", "ZA1_NOMTEC", SubStr(cNome, 1, TamSX3("ZA1_NOMTEC")[1]))

Return cNome

/*/{Protheus.doc} ABREAGENDA
Ver Agendas antigo: era FwCallApp("cnsaagenda") (app do portal dentro do Protheus); hoje so carrega o model CNSA003.
/*/
User Function ABREAGENDA()
    FWLoadModel("CNSA003")
Return

User Function PROTHEUS_ABREAGENDA()
    Local oBrowse := Nil
    Local cIdCh   := AllTrim(ZA1->ZA1_IDCH)
    Private aRotina := FWMVCMenu('CNSA003')

    oBrowse := FWMBrowse():New()
    oBrowse:SetDescription("Agendas do Chamado " + cIdCh)
    oBrowse:SetAlias('SZ6')
    oBrowse:SetFilterDefault("Z6_CHAMADO == " + cValToChar(Val(cIdCh)))
    oBrowse:Activate()
Return

/*/{Protheus.doc} CH_MONTAAGENDA
Monta e grava um agendamento (SZ6) pelo model CNSA003.
@param  cTecnico   Codigo do tecnico (AA1)
@param  dData      Data do agendamento
@param  cHmini     Hora inicial (HH:MM)
@param  cHmfim     Hora final (HH:MM)
@param  cCliente   Codigo do cliente (SA1)
@param  cLoja      Loja do cliente
@param  cDescri    Descricao/servico do agendamento
@param  cProjeto   Codigo do projeto
@param  cTarefa    Codigo da tarefa
@param  cChamado   Id do chamado (ZA1_IDCH)
@return aRet       {lGravou, dData, cHmini, cHmfim} - valores que ficaram gravados (usuario pode mudar na tela)
/*/
Static Function CH_MONTAAGENDA(cTecnico, dData, cHmini, cHmfim, ;
                                 cCliente, cLoja, cDescri, cProjeto, ;
                                 cTarefa, cChamado)
    Local oModel := Nil
    // Consultor pelo usuario logado (no REST nao existe o Private da tela).
    Local cCodConsultorSessao := Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC")
    // Usuario sem tecnico: Posicione com codigo vazio cairia no 1o tecnico da AA1.
    Local cNomeGravou := If(Empty(cCodConsultorSessao), "", AllTrim(Posicione("AA1", 1, xFilial("AA1") + cCodConsultorSessao, "AA1_NOMTEC")))
    Local lGravou     := .F.
    Local aRet        := {}

    oModel := FWLoadModel("CNSA003")
    If oModel == Nil
        MsgAlert("Nao foi possivel carregar o modelo CNSA003.", "Agenda")
        Return {.F., dData, cHmini, cHmfim}
    EndIf

    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    oModel:SetValue("ModelSZ6_Main", "Z6_FILIAL",  xFilial("SZ6"))
    oModel:SetValue("ModelSZ6_Main", "Z6_DTAGE",   dData)
    oModel:SetValue("ModelSZ6_Main", "Z6_TECNICO", cTecnico)
    oModel:SetValue("ModelSZ6_Main", "Z6_HMINI",   cHmini)
    oModel:SetValue("ModelSZ6_Main", "Z6_HMFIM",   cHmfim)
    oModel:SetValue("ModelSZ6_Main", "Z6_CLIENTE", cCliente)
    oModel:SetValue("ModelSZ6_Main", "Z6_LOJA",    cLoja)
    oModel:SetValue("ModelSZ6_Main", "Z6_SERVICO", cDescri)
    oModel:SetValue("ModelSZ6_Main", "Z6_PROJET",  cProjeto)
    oModel:SetValue("ModelSZ6_Main", "Z6_TAREFA",  cTarefa)
    oModel:SetValue("ModelSZ6_Main", "Z6_CHAMADO", Val(cChamado))
    oModel:SetValue("ModelSZ6_Main", "Z6_QGRAVOU", cNomeGravou)

    // FWExecView devolve 0 quando o usuario confirma (OK) e grava.
    lGravou := FWExecView("Nova Agenda - Chamado " + cChamado, ;
               "CNSA003", ;
               MODEL_OPERATION_INSERT, ;
               , ;
               {|| .T.}, ;
               NIL, NIL, NIL, NIL, NIL, NIL, ;
               oModel) == 0

    aRet := {lGravou, ;
             oModel:GetValue("ModelSZ6_Main", "Z6_DTAGE"), ;
             AllTrim(oModel:GetValue("ModelSZ6_Main", "Z6_HMINI")), ;
             AllTrim(oModel:GetValue("ModelSZ6_Main", "Z6_HMFIM"))}

    oModel:DeActivate()

Return aRet

/*/{Protheus.doc} CH_ASSUMIRTELA
Menu Assumir.
/*/
User Function CH_ASSUMIRTELA()
    Local aResultado      := {}
    Local lNotificarCliente := .F.
    Local lNotificarTecnico := .F.
    Local aEnvio            := {}

    If ZA1->(Eof()) .Or. ZA1->(Bof())
        MsgAlert("Nenhum chamado selecionado.", "Assumir")
        Return
    EndIf

    If !MsgYesNo("Deseja assumir o chamado " + AllTrim(ZA1->ZA1_IDCH) + "?", "Assumir Chamado")
        Return
    EndIf

    aEnvio := CH_PERGUNTAEMAIL("Assumir Chamado " + AllTrim(ZA1->ZA1_IDCH), !Empty(AllTrim(ZA1->ZA1_EMAIL)), .T.)
    lNotificarCliente := aEnvio[1]
    lNotificarTecnico := aEnvio[2]

    aResultado := CH_NUCLEOASSUMIR(AllTrim(ZA1->ZA1_IDCH), lNotificarCliente, lNotificarTecnico)

    If aResultado[1] == 200
        MsgInfo("Chamado assumido com sucesso!", "Assumir Chamado")
    Else
        MsgAlert(aResultado[2], "Assumir")
    EndIf

Return

/*/{Protheus.doc} CH_EXCLUIRINTERACAOTELA
Menu Excluir Interacao: escolhe a interacao e chama o CH_NUCLEOEXCLUIRINTERACAO.
/*/
User Function CH_EXCLUIRINTERACAOTELA()
    Local cIdCh      := ""
    Local cAlias     := GetNextAlias()
    Local aSeqs      := {}
    Local aExibicao  := {}
    Local nOpcao     := 0
    Local aEnvio     := {}
    Local aResultado := {}
    Local oDlg       := Nil
    Local oLista     := Nil
    Private nOpcLista := 1
    Private lEscolheu := .F.

    If ZA1->(Eof()) .Or. ZA1->(Bof())
        MsgAlert("Nenhum chamado selecionado.", "Excluir Interação")
        Return
    EndIf

    cIdCh := AllTrim(ZA1->ZA1_IDCH)

    BeginSql Alias cAlias
        SELECT ZA2_IDGRID, ZA2_DESCRI
        FROM %Table:ZA2% ZA2
        WHERE ZA2_FILIAL = %xFilial:ZA2%
          AND ZA2_IDCH   = %Exp:cIdCh%
          AND %NotDel%
        ORDER BY ZA2_IDGRID
    EndSql

    While !(cAlias)->(Eof())
        AAdd(aSeqs, AllTrim((cAlias)->ZA2_IDGRID))
        AAdd(aExibicao, AllTrim((cAlias)->ZA2_IDGRID) + " - " + Left(U_CNSOUTL("UTF8", AllTrim((cAlias)->ZA2_DESCRI)), 60))
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

    If Len(aSeqs) == 0
        MsgAlert("Este chamado nao tem interacoes.", "Excluir Interação")
        Return
    EndIf

    DEFINE MSDIALOG oDlg TITLE "Excluir Interação - Chamado " + cIdCh FROM 0,0 TO 320,520 PIXEL
        @ 05,05 LISTBOX oLista VAR nOpcLista ITEMS aExibicao SIZE 250,130 PIXEL OF oDlg
        TButton():New(140, 140, "Excluir",  oDlg, {|| lEscolheu := .T., oDlg:End()}, 55,14,,,.F.,.T.,.F.,,.F.,,,.F.)
        TButton():New(140, 200, "Cancelar", oDlg, {|| oDlg:End()},                   55,14,,,.F.,.T.,.F.,,.F.,,,.F.)
    ACTIVATE MSDIALOG oDlg CENTERED
    If !lEscolheu .Or. nOpcLista < 1 .Or. nOpcLista > Len(aSeqs)
        Return
    EndIf
    nOpcao := nOpcLista

    If !MsgYesNo("Confirma excluir a Interação " + aSeqs[nOpcao] + "?", "Excluir Interação")
        Return
    EndIf

    aEnvio := CH_PERGUNTAEMAIL("Excluir Interacao - Chamado " + cIdCh, !Empty(AllTrim(ZA1->ZA1_EMAIL)), !Empty(AllTrim(ZA1->ZA1_CONSUL)))

    aResultado := CH_NUCLEOEXCLUIRINTERACAO(cIdCh, aSeqs[nOpcao], aEnvio[1], aEnvio[2])

    If aResultado[1] == 200
        MsgInfo("Interação excluida com sucesso!", "Excluir Interação")
    Else
        MsgAlert(aResultado[2], "Excluir Interação")
    EndIf

Return

/*/{Protheus.doc} CH_NUCLEOINCLUIR
Inclui o chamado pelo model (tela, REST e importacao de e-mail). Nasce sem tecnico (so Assumir ou
atribuicao do admin preenchem); com tecnico, avisa por e-mail.
@param  cAssunto           Assunto do chamado
@param  cDtAbertura        Data de abertura (AAAAMMDD ou AAAA-MM-DD)
@param  cTipo              Tipo do chamado
@param  cCodCliente        Codigo do cliente (SA1)
@param  cLojaCliente       Loja do cliente (default "01")
@param  cEmailCliente      E-mail do cliente
@param  cCodConsultor      Codigo do tecnico (AA1), se ja nascer atribuido
@param  cProjeto           Codigo do projeto
@param  cTarefa            Codigo da tarefa
@param  cMailId             Id do e-mail de origem (importacao Graph), dedup
@param  lExigirCompletos   Exige tipo/projeto/tarefa preenchidos (.F. no caminho de e-mail)
@param  lNotificarTecnico  .F. pra NAO enviar o e-mail de designacao ao analista (default .T.)
@param  cDescricao         Descricao do chamado (ZA1_ANOT, cortada no tamanho do campo)
@return Array {nStatusHTTP, cCorpoJsonOuMensagem, cIdCh}
/*/
Static Function CH_NUCLEOINCLUIR(cAssunto, cDtAbertura, cTipo, cCodCliente, cLojaCliente, cEmailCliente, cCodConsultor, cProjeto, cTarefa, cMailId, lExigirCompletos, lNotificarTecnico, cDescricao)
    Local cIdCh       := ""
    Local oJson       := JsonObject():New()
    Local oErro       := Nil
    Local oModel      := Nil
    Local oModelZA1   := Nil
    Local oErroModel  := Nil
    Local lOk         := .F.
    Local aRet        := {500, CH_ERRO("Erro desconhecido."), ""}
    // Erro de execucao cai no Recover (limpa as flags Public) em vez de derrubar a thread.
    Local bErro       := ErrorBlock({|e| Break(e)})

    Default cMailId          := ""
    Default lExigirCompletos := .T.
    Default lNotificarTecnico := .T.
    Default cDescricao        := ""

    Begin Sequence

        // Obrigatorios: CH_PREVALIDA (lCnsaIncluirIncompleto libera tipo/projeto/tarefa pro e-mail).
        If Empty(cLojaCliente) .And. !Empty(cCodCliente)
            cLojaCliente := "01"
        EndIf

        If Empty(cDtAbertura)
            cDtAbertura := DTOS(Date())
        Else
            cDtAbertura := StrTran(cDtAbertura, "-", "")
        EndIf

        cIdCh := GetSxeNum("ZA1", "ZA1_IDCH")

        Public lCnsaViaRest          := .T.
        Public lCnsaIncluirIncompleto := !lExigirCompletos

        // Monta e ativa na mesma funcao (owner private environment).
        oModel := CH_MONTARMODEL(MODEL_OPERATION_INSERT)

        oModelZA1 := oModel:GetModel("ZA1MASTER")

        oModelZA1:LoadValue("ZA1_FILIAL", xFilial("ZA1"))
        oModelZA1:LoadValue("ZA1_IDCH",   cIdCh)
        // Assunto cortado no tamanho do campo (assunto de e-mail vem longo e travava o CommitData).
        oModelZA1:LoadValue("ZA1_ASSUNT", SubStr(cAssunto, 1, TamSX3("ZA1_ASSUNT")[1]))
        oModelZA1:LoadValue("ZA1_DATA",   STOD(cDtAbertura))
        // Sem cliente nasce Incompleto (5).
        oModelZA1:LoadValue("ZA1_STATUS", If(Empty(cCodCliente), "5", "1"))
        oModelZA1:LoadValue("ZA1_TIPO",   cTipo)

        // Cliente antes do gatilho CNSA_CLIENTE (o REST nao dispara SX7: chamado explicito).
        oModelZA1:LoadValue("ZA1_CLIENT", cCodCliente)
        oModelZA1:LoadValue("ZA1_LOJA",   cLojaCliente)
        U_CNSA_CLIENTE()

        oModelZA1:LoadValue("ZA1_EMAIL",  cEmailCliente)
        // ZA1_CONSUL tem inicializador com o tecnico logado: sem consultor, limpa.
        If !Empty(cCodConsultor)
            oModelZA1:LoadValue("ZA1_CONSUL", cCodConsultor)
            U_CNSA_TECNICO()
        Else
            // Codigo vazio: o gatilho cairia no 1o registro da AA1 (soft-seek) - limpa o nome direto.
            oModelZA1:LoadValue("ZA1_CONSUL", "")
            oModelZA1:LoadValue("ZA1_NOMTEC", "")
        EndIf

        oModelZA1:LoadValue("ZA1_PROJ",   cProjeto)
        oModelZA1:LoadValue("ZA1_TAREFA", cTarefa)
        If !Empty(cDescricao)
            oModelZA1:LoadValue("ZA1_ANOT", SubStr(cDescricao, 1, TamSX3("ZA1_ANOT")[1]))
        EndIf
        oModelZA1:LoadValue("ZA1_MOD",    Date())
        If !Empty(cMailId)
            oModelZA1:LoadValue("ZA1_MAILID", cMailId)
        EndIf

        lOk := oModel:VldData() .And. oModel:CommitData()

        oModel:DeActivate(lOk)
        CH_LIMPAFLAGS()

        If lOk
            ConfirmSX8()
            oJson['sucesso']  := .T.
            oJson['idCh']     := cIdCh
            oJson['mensagem'] := "Chamado incluido com sucesso."
            aRet := {200, oJson:ToJson(), cIdCh}
        Else
            oErroModel := oModel:GetErrorMessage()
            RollBackSX8()
            aRet := {400, CH_ERRO(FwJsonSerialize(oErroModel)), ""}
        EndIf

    Recover Using oErro
        CH_LIMPAFLAGS()
        If oModel <> Nil .And. oModel:IsActive()
            oModel:DeActivate()
        EndIf
        // Erro depois do commit (ex.: AfterTTS) com o chamado ja gravado: confirma o numero (devolver
        // repetiria o ZA1_IDCH) e responde sucesso - 500 faria o usuario incluir de novo (duplicado).
        If lOk .Or. (!Empty(cIdCh) .And. CH_ACHARZA1(cIdCh))
            ConfirmSX8()
            ConOut("CH_NUCLEOINCLUIR: chamado " + cIdCh + " gravado, erro depois do commit: " + oErro:Description)
            oJson['sucesso']  := .T.
            oJson['idCh']     := cIdCh
            oJson['mensagem'] := "Chamado incluido com sucesso."
            aRet := {200, oJson:ToJson(), cIdCh}
        Else
            RollBackSX8()
            aRet := {500, CH_ERRO(oErro:Description), ""}
        EndIf
    End Sequence
    ErrorBlock(bErro)

    // E-mail de designacao so se ja nasce com tecnico (depois de gravar).
    If aRet[1] == 200 .And. !Empty(cCodConsultor)
        CH_EMAIL("DESIGNA", "", cIdCh, cCodConsultor, .F., lNotificarTecnico)
    EndIf

Return aRet

/*/{Protheus.doc} CH_APIINCLUIR
Endpoint REST POST /CNSACHAMADOSINCLUIR: inclui um chamado a partir dos
parametros da query string, chamando CH_NUCLEOINCLUIR.
@return Logical - resposta HTTP com o resultado da inclusao
/*/
@Post(endpoint="/CNSACHAMADOSINCLUIR")
User Function CH_APIINCLUIR() As Logical
    Local jQuery     := CH_PARAMS() As Json
    Local aResultado := {}
    Local cEmailCli  := ""

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return oRest:setStatusResponse(403, CH_ERRO("Usuario sem acesso a este recurso."))
    EndIf

    aResultado := CH_NUCLEOINCLUIR(AllTrim(CH_LERJSONTXT(jQuery,"assunto")), AllTrim(CH_LERJSONTXT(jQuery,"dtAbertura")), AllTrim(CH_LERJSONTXT(jQuery,"tipo")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"codCliente")), AllTrim(CH_LERJSONTXT(jQuery,"lojaCliente")), AllTrim(CH_LERJSONTXT(jQuery,"emailCliente")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"codConsultor")), AllTrim(CH_LERJSONTXT(jQuery,"projeto")), AllTrim(CH_LERJSONTXT(jQuery,"tarefa")), ;
        "", .T., AllTrim(CH_LERJSONTXT(jQuery,"notificarTecnico")) != "0", AllTrim(CH_LERJSONTXT(jQuery,"descricao")))

    // Informar o cliente: mesmo e-mail "Chamado Aberto" do chamado aberto por e-mail.
    If aResultado[1] == 200 .And. AllTrim(CH_LERJSONTXT(jQuery,"notificarCliente")) == "1"
        cEmailCli := AllTrim(Posicione("ZA1", 1, xFilial("ZA1") + aResultado[3], "ZA1_EMAIL"))
        If !Empty(cEmailCli)
            CH_EMAIL("CHAMADOCRIADO", cEmailCli, aResultado[3])
        EndIf
    EndIf

Return oRest:setStatusResponse(aResultado[1], aResultado[2])

/*/{Protheus.doc} CH_NUCLEOALTERAR
Altera o chamado pelo model (tela e REST): CH_PREVALIDA e CH_POSGRAVACAO sempre rodam.
@param  cIdCh               Id do chamado a alterar
@param  cAssunto            Novo assunto (vazio = nao altera)
@param  cDtAbertura         Nova data de abertura (vazio = nao altera)
@param  cTipo               Novo tipo (vazio = nao altera)
@param  cCodCliente         Novo codigo do cliente (vazio = nao altera)
@param  cLojaCliente        Nova loja do cliente
@param  cEmailCliente       Novo e-mail do cliente (vazio = nao altera)
@param  cCodConsultor       Novo codigo do tecnico (vazio = nao altera)
@param  cProjeto            Novo projeto (vazio = nao altera)
@param  cTarefa             Nova tarefa (vazio = nao altera)
@param  lLimparCliente      Limpa o cliente do chamado
@param  lLimparConsultor    Limpa o tecnico do chamado
@param  cStatus             Novo status (1/2/3/4/5, vazio = nao altera) - so admin (CH_TEMACESSOGRUPO), inclusive pra reabrir/fechar chamado ja fechado
@param  lNotificarCliente   .T. pra tambem enviar e-mail ao cliente sobre as mudancas (ver CH_POSGRAVACAO/CH_EMAIL) - decisao do front (dialogo "deseja informar o cliente?")
@return Array {nStatusHTTP, cCorpoJsonOuMensagem}
@param  lNotificarTecnico   .F. pra NAO enviar os e-mails de designacao/remocao ao analista (default .T.)
@param  cDescricao          Nova descricao (ZA1_ANOT, vazio = nao altera) - Alterar ja e restrito a admin (CH_PREVALIDA)
@param  lLimparDescricao    Limpa a descricao do chamado
/*/
Static Function CH_NUCLEOALTERAR(cIdCh, cAssunto, cDtAbertura, cTipo, cCodCliente, cLojaCliente, ;
    cEmailCliente, cCodConsultor, cProjeto, cTarefa, lLimparCliente, lLimparConsultor, cStatus, lNotificarCliente, lNotificarTecnico, cDescricao, lLimparDescricao)
    Local oJson              := JsonObject():New()
    Local oErro              := Nil
    Local oErroModel         := Nil
    Local oModel             := Nil
    Local oModelZA1          := Nil
    Local lOk                := .F.
    Local cStatusAtual       := ""
    Local aRet               := {500, CH_ERRO("Erro desconhecido.")}
    Local bErro              := Nil

    Default cStatus := ""
    Default lNotificarCliente := .F.
    Default lNotificarTecnico := .T.
    Default cDescricao        := ""
    Default lLimparDescricao  := .F.

    If !Empty(cStatus)
        If Len(cStatus) != 1 .Or. !(cStatus $ "12345")
            Return {400, CH_ERRO("Status invalido.")}
        EndIf
        If !CH_TEMACESSOGRUPO()
            Return {403, CH_ERRO("Somente administradores podem alterar o status do chamado.")}
        EndIf
    EndIf

    If !CH_ACHARZA1(cIdCh)
        Return {404, CH_ERRO("Chamado nao encontrado.")}
    EndIf

    // Erro de execucao cai no Recover (limpa as flags Public) em vez de derrubar a thread.
    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        cStatusAtual := AllTrim(ZA1->ZA1_STATUS)

        Public lCnsaViaRest := .T.
        // Libera o Alterar em chamado fechado so pra troca de status pedida aqui.
        Public lCnsaAlterandoStatus := !Empty(cStatus)
        // Decisao de notificar vinda do REST (no lugar do MsgYesNo da tela).
        Public lCnsaNotificarCliente := lNotificarCliente
        Public lCnsaNotificarTecnico := lNotificarTecnico

        // Monta e ativa na mesma funcao (owner private environment).
        oModel := CH_MONTARMODEL(MODEL_OPERATION_UPDATE)

        oModelZA1 := oModel:GetModel("ZA1MASTER")

        If !Empty(cAssunto)
            oModelZA1:LoadValue("ZA1_ASSUNT", cAssunto)
        EndIf
        If !Empty(cDtAbertura)
            oModelZA1:LoadValue("ZA1_DATA", STOD(StrTran(cDtAbertura, "-", "")))
        EndIf
        If !Empty(cTipo)
            oModelZA1:LoadValue("ZA1_TIPO", cTipo)
        EndIf

        If lLimparCliente
            oModelZA1:LoadValue("ZA1_CLIENT", "")
            oModelZA1:LoadValue("ZA1_LOJA",   "")
            oModelZA1:LoadValue("ZA1_NOME",   "")
        ElseIf !Empty(cCodCliente)
            oModelZA1:LoadValue("ZA1_CLIENT", cCodCliente)
            oModelZA1:LoadValue("ZA1_LOJA",   If(Empty(cLojaCliente), "01", cLojaCliente))
            U_CNSA_CLIENTE()

            // Incompleto que ganha cliente volta a Aberto.
            If cStatusAtual == "5"
                oModelZA1:LoadValue("ZA1_STATUS", "1")
            EndIf
        EndIf

        If !Empty(cEmailCliente)
            oModelZA1:LoadValue("ZA1_EMAIL", cEmailCliente)
        EndIf

        If lLimparConsultor
            oModelZA1:LoadValue("ZA1_CONSUL", "")
            oModelZA1:LoadValue("ZA1_NOMTEC", "")
        ElseIf !Empty(cCodConsultor)
            oModelZA1:LoadValue("ZA1_CONSUL", cCodConsultor)
            U_CNSA_TECNICO()
        EndIf

        If !Empty(cProjeto)
            oModelZA1:LoadValue("ZA1_PROJ", cProjeto)
        EndIf
        If !Empty(cTarefa)
            oModelZA1:LoadValue("ZA1_TAREFA", cTarefa)
        EndIf

        If lLimparDescricao
            oModelZA1:LoadValue("ZA1_ANOT", "")
        ElseIf !Empty(cDescricao)
            oModelZA1:LoadValue("ZA1_ANOT", SubStr(cDescricao, 1, TamSX3("ZA1_ANOT")[1]))
        EndIf

        // Troca explicita de status (admin) - depois do ajuste 5->1, pra prevalecer.
        If !Empty(cStatus)
            oModelZA1:LoadValue("ZA1_STATUS", cStatus)
        EndIf

        oModelZA1:LoadValue("ZA1_MOD", Date())

        lOk := oModel:VldData() .And. oModel:CommitData()

        oModel:DeActivate(lOk)
        CH_LIMPAFLAGS()

        // E-mails de redesignacao e alteracao saem no CH_POSGRAVACAO (nao duplicar).
        If lOk
            oJson['sucesso']  := .T.
            oJson['idCh']     := cIdCh
            oJson['mensagem'] := "Chamado alterado com sucesso."
            aRet := {200, oJson:ToJson()}
        Else
            oErroModel := oModel:GetErrorMessage()
            aRet := {400, CH_ERRO(FwJsonSerialize(oErroModel))}
        EndIf

    Recover Using oErro
        CH_LIMPAFLAGS()
        If oModel <> Nil .And. oModel:IsActive()
            oModel:DeActivate()
        EndIf
        aRet := {500, CH_ERRO(oErro:Description)}
    End Sequence
    ErrorBlock(bErro)

Return aRet

/*/{Protheus.doc} CH_APIALTERAR
Endpoint REST POST /CNSACHAMADOSALTERAR: altera um chamado a partir dos
parametros da query string, chamando CH_NUCLEOALTERAR.
@return Logical - resposta HTTP com o resultado da alteracao
/*/
@Post(endpoint="/CNSACHAMADOSALTERAR")
User Function CH_APIALTERAR() As Logical
    Local jQuery     := CH_PARAMS() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return oRest:setStatusResponse(403, CH_ERRO("Usuario sem acesso a este recurso."))
    EndIf

    aResultado := CH_NUCLEOALTERAR(AllTrim(CH_LERJSONTXT(jQuery,"idCh")), AllTrim(CH_LERJSONTXT(jQuery,"assunto")), AllTrim(CH_LERJSONTXT(jQuery,"dtAbertura")), AllTrim(CH_LERJSONTXT(jQuery,"tipo")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"codCliente")), AllTrim(CH_LERJSONTXT(jQuery,"lojaCliente")), AllTrim(CH_LERJSONTXT(jQuery,"emailCliente")), AllTrim(CH_LERJSONTXT(jQuery,"codConsultor")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"projeto")), AllTrim(CH_LERJSONTXT(jQuery,"tarefa")), AllTrim(CH_LERJSONTXT(jQuery,"limparCliente")) == "1", AllTrim(CH_LERJSONTXT(jQuery,"limparConsultor")) == "1", ;
        AllTrim(CH_LERJSONTXT(jQuery,"status")), AllTrim(CH_LERJSONTXT(jQuery,"notificarCliente")) == "1", ;
        AllTrim(CH_LERJSONTXT(jQuery,"notificarTecnico")) != "0", ;
        AllTrim(CH_LERJSONTXT(jQuery,"descricao")), AllTrim(CH_LERJSONTXT(jQuery,"limparDescricao")) == "1")

Return oRest:setStatusResponse(aResultado[1], aResultado[2])

/*/{Protheus.doc} CH_NUCLEOASSUMIR
Assume o chamado pelo model: tecnico da sessao e status 2. Regras em CH_PREVALIDA (lCnsaAssumindo).
@param  cIdCh               Id do chamado (ZA1_IDCH)
@param  lNotificarCliente   .T. pra tambem enviar e-mail ao cliente sobre o tecnico designado (ver CH_POSGRAVACAO/CH_EMAIL) - decisao do front (dialogo "deseja informar o cliente?")
@return Array {nStatusHTTP, cMensagemErro, cNomeTecnico}
@param  lNotificarTecnico   .F. pra NAO enviar o e-mail de designacao/remocao ao analista (default .T.)
/*/
Static Function CH_NUCLEOASSUMIR(cIdCh, lNotificarCliente, lNotificarTecnico)
    Local cConsultorSessao := ""
    Local cNomeTec         := ""
    Local oModel           := Nil
    Local lOk              := .F.
    Local oErroModel       := Nil
    Local oErroExcpt       := Nil
    Local cErro            := ""
    Local aRet             := {500, "Erro desconhecido.", ""}
    Local bErro            := Nil

    Default lNotificarCliente := .F.
    Default lNotificarTecnico := .T.

    // AllTrim: Posicione devolve no tamanho do AA1_CODTEC (FWNOWIDTH se o ZA1_CONSUL for diferente).
    cConsultorSessao := AllTrim(Posicione("AA1",4,xFilial("AA1")+__cUserId,"AA1_CODTEC"))
    If Empty(cConsultorSessao)
        Return {403, "Seu usuario nao esta vinculado a nenhum consultor (AA1).", ""}
    EndIf

    If !CH_ACHARZA1(cIdCh)
        Return {404, "Chamado nao encontrado.", ""}
    EndIf

    // Erro de execucao cai no Recover (limpa as flags Public) em vez de derrubar a thread.
    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        // Valor atual antes do model sobrescrever (CH_PREVALIDA so veria o novo).
        Public cAssumirConsulAnt := AllTrim(ZA1->ZA1_CONSUL)
        Public cAssumirStatusAnt := AllTrim(ZA1->ZA1_STATUS)
        Public lCnsaAssumindo    := .T.
        Public lCnsaViaRest      := .T.
        Public lCnsaNotificarCliente := lNotificarCliente
        Public lCnsaNotificarTecnico := lNotificarTecnico

        // Monta e ativa na mesma funcao (owner private environment).
        oModel := CH_MONTARMODEL(MODEL_OPERATION_UPDATE)

        oModel:GetModel("ZA1MASTER"):LoadValue("ZA1_CONSUL", cConsultorSessao)
        oModel:GetModel("ZA1MASTER"):LoadValue("ZA1_STATUS", "2")
        U_CNSA_TECNICO()

        lOk := oModel:VldData() .And. oModel:CommitData()

        If !lOk
            oErroModel := oModel:GetErrorMessage()
            cErro := FwJsonSerialize(oErroModel)
        EndIf

        oModel:DeActivate(lOk)
        CH_LIMPAFLAGS()

        // E-mail de designacao sai no CH_POSGRAVACAO (nao duplicar).
        If lOk
            cNomeTec := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cConsultorSessao, "AA1_NOMTEC"))
            aRet := {200, "", cNomeTec}
        Else
            aRet := {400, "Falha ao assumir o chamado: " + cErro, ""}
        EndIf

    Recover Using oErroExcpt
        CH_LIMPAFLAGS()
        If oModel <> Nil .And. oModel:IsActive()
            oModel:DeActivate()
        EndIf
        aRet := {500, "Erro interno: " + oErroExcpt:Description, ""}
    End Sequence
    ErrorBlock(bErro)

Return aRet

/*/{Protheus.doc} CH_APIASSUMIR
POST /CNSACHAMADOSASSUMIR - assume o chamado.
@return Logical - resposta HTTP (200 com idCh/status/tecnico, ou erro)
/*/
@Post(endpoint="/CNSACHAMADOSASSUMIR")
User Function CH_APIASSUMIR() As Logical
    Local jQuery     := CH_PARAMS() As Json
    Local cIdCh      := AllTrim(CH_LERJSONTXT(jQuery,"idCh"))
    Local aResultado := {}
    Local oJson      := JsonObject():New()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return oRest:setStatusResponse(403, CH_ERRO("Usuario sem acesso a este recurso."))
    EndIf

    aResultado := CH_NUCLEOASSUMIR(cIdCh, AllTrim(CH_LERJSONTXT(jQuery,"notificarCliente")) == "1", AllTrim(CH_LERJSONTXT(jQuery,"notificarTecnico")) != "0")

    If aResultado[1] == 200
        // idCh na resposta (o front exige).
        oJson['sucesso'] := .T.
        oJson['idCh']    := cIdCh
        oJson['status']  := "2"
        oJson['tecnico'] := aResultado[3]
        Return oRest:setStatusResponse(200, oJson:ToJson())
    EndIf

Return oRest:setStatusResponse(aResultado[1], CH_ERRO(aResultado[2]))

/*/{Protheus.doc} CH_NUCLEOEXCLUIR
Exclui o chamado e as agendas (RecLock direto, sem model, numa transacao) e avisa por e-mail.
@param  cIdCh     Id do chamado (ZA1_IDCH)
@param  cMotivo   Motivo do cancelamento (usado no e-mail de notificacao)
@return Array {nStatusHTTP, cMensagem}
/*/
Static Function CH_NUCLEOEXCLUIR(cIdCh, cMotivo, lNotificarCliente, lNotificarTecnico)
    Local cConsulAnt  := ""
    Local cClienteAnt := ""
    Local cLojaAnt    := ""
    Local cNomeCli    := ""
    Local cEmailTec   := ""
    Local cEmailCli   := ""
    Local cExclPor    := ""
    Local aAgenda     := {}
    Local aOutlook    := {}
    Local cAlias      := ""
    Local nCham       := 0
    Local nI          := 0
    Local lOk         := .T.
    Local aRet        := {500, "Erro desconhecido."}
    Local oErro       := Nil
    Local bErro       := Nil

    Default lNotificarCliente := .F.
    Default lNotificarTecnico := .T.

    // Sem model (RecLock direto, de proposito): obrigatorios ficam no front.
    If !CH_ACHARZA1(cIdCh)
        Return {404, "Chamado nao encontrado."}
    EndIf

    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        cConsulAnt  := AllTrim(ZA1->ZA1_CONSUL)
        cClienteAnt := AllTrim(ZA1->ZA1_CLIENT)
        cLojaAnt    := AllTrim(ZA1->ZA1_LOJA)
        // E-mail do chamado (ZA1_EMAIL); sem ele, o do cadastro (A1_EMAIL).
        cEmailCli   := AllTrim(ZA1->ZA1_EMAIL)
        If Empty(cEmailCli) .And. !Empty(cClienteAnt)
            cEmailCli := AllTrim(Posicione("SA1", 1, xFilial("SA1") + cClienteAnt + cLojaAnt, "A1_EMAIL"))
        EndIf

        cExclPor := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_NOMTEC"))
        // Cliente vazio: Posicione cairia no 1o registro da SA1.
        cNomeCli := If(Empty(cClienteAnt), "", AllTrim(Posicione("SA1", 1, xFilial("SA1") + cClienteAnt + cLojaAnt, "A1_NREDUZ")))

        // Chamado sem numero: -1 (Val("") = 0 casaria com toda agenda sem chamado e apagaria todas).
        nCham   := If(Val(cIdCh) > 0, Val(cIdCh), -1)
        aAgenda := CH_CONSULTA("AGENDA", nCham, DToC(Date()))

        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT SZ6.R_E_C_N_O_ RECNO
            FROM %Table:SZ6% SZ6
            WHERE SZ6.Z6_FILIAL  = %xFilial:SZ6%
              AND SZ6.Z6_CHAMADO = %Exp:nCham%
              AND %NotDel%
        EndSql

        // Chamado e agendas na mesma transacao: registro travado ou erro desfaz tudo.
        Begin Transaction
            Begin Sequence
                lOk := RecLock("ZA1", .F.)
                If lOk
                    ZA1->(DbDelete())
                    ZA1->(MsUnlock())
                EndIf
                dbSelectArea("SZ6")
                While lOk .And. !(cAlias)->(Eof())
                    SZ6->(DbGoto((cAlias)->RECNO))
                    If !SZ6->(Eof())
                        lOk := RecLock("SZ6", .F.)
                        If lOk
                            // Evento do Outlook sai depois da transacao (esta exclusao nao passa pelo model do CNSA003).
                            If !Empty(AllTrim(SZ6->Z6_IDOUTL))
                                AAdd(aOutlook, {U_CNSOUTL("EMAIL", SZ6->Z6_TECNICO), SZ6->Z6_IDOUTL})
                            EndIf
                            SZ6->(DbDelete())
                            SZ6->(MsUnlock())
                        EndIf
                    EndIf
                    (cAlias)->(DbSkip())
                EndDo
            Recover Using oErro
                lOk := .F.
            End Sequence
            If !lOk
                DisarmTransaction()
            EndIf
        End Transaction
        (cAlias)->(DbCloseArea())

        Do Case
        Case oErro != Nil
            aRet := {500, "Erro interno: " + oErro:Description}
        Case !lOk
            aRet := {409, "Chamado ou agenda em uso por outro usuario. Tente novamente."}
        OtherWise
            aRet := {200, "Chamado excluido com sucesso."}
        EndCase

    Recover Using oErro
        If !Empty(cAlias) .And. Select(cAlias) > 0
            (cAlias)->(DbCloseArea())
        EndIf
        aRet := {500, "Erro interno: " + oErro:Description}
    End Sequence
    ErrorBlock(bErro)

    // Depois de excluir: eventos do Outlook e e-mails (analista e cliente independentes, cada um so se o usuario escolheu).
    If aRet[1] == 200
        For nI := 1 To Len(aOutlook)
            U_CNSOUTL("EXCLUIR", aOutlook[nI][1], aOutlook[nI][2])
        Next nI
        If lNotificarTecnico .And. !Empty(cConsulAnt)
            cEmailTec := U_CNSOUTL("EMAIL", cConsulAnt)
            If !Empty(cEmailTec)
                CH_EMAIL("ENCERRAMENTO", cEmailTec, cIdCh, cNomeCli, aAgenda, cMotivo, cExclPor)
            EndIf
        EndIf
        If lNotificarCliente .And. !Empty(cEmailCli)
            CH_EMAIL("ENCERRAMENTO", cEmailCli, cIdCh, cNomeCli, aAgenda, cMotivo, cExclPor)
        EndIf
    EndIf

Return aRet

/*/{Protheus.doc} CH_APIEXCLUIR
POST /CNSACHAMADOSEXCLUIR - exclui o chamado.
@return Logical - resposta HTTP (200 com idCh/mensagem, ou erro)
/*/
@Post(endpoint="/CNSACHAMADOSEXCLUIR")
User Function CH_APIEXCLUIR() As Logical
    Local jQuery     := CH_PARAMS() As Json
    Local cIdCh      := AllTrim(CH_LERJSONTXT(jQuery,"idCh"))
    Local aResultado := {}
    Local oJson      := JsonObject():New()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return oRest:setStatusResponse(403, CH_ERRO("Usuario sem acesso a este recurso."))
    EndIf

    aResultado := CH_NUCLEOEXCLUIR(cIdCh, AllTrim(CH_LERJSONTXT(jQuery,"motivo")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"notificarCliente")) == "1", AllTrim(CH_LERJSONTXT(jQuery,"notificarTecnico")) != "0")

    If aResultado[1] == 200
        // idCh na resposta (o front exige).
        oJson['sucesso']  := .T.
        oJson['idCh']     := cIdCh
        oJson['mensagem'] := aResultado[2]
        Return oRest:setStatusResponse(200, oJson:ToJson())
    EndIf

Return oRest:setStatusResponse(aResultado[1], CH_ERRO(aResultado[2]))

/*/{Protheus.doc} CH_DATAISOZA1
AAAAMMDD -> AAAA-MM-DD (ZA1_DATA pode vir Character).
@param  cData   Data no formato AAAAMMDD
@return Data no formato ISO (AAAA-MM-DD), ou "" se invalida
/*/
Static Function CH_DATAISOZA1(cData)
    Local cAno := ""
    Local cMes := ""
    Local cDia := ""

    cData := AllTrim(cData)

    If Len(cData) == 8
        cAno := SubStr(cData, 1, 4)
        cMes := SubStr(cData, 5, 2)
        cDia := SubStr(cData, 7, 2)

        If Val(cMes) >= 1 .And. Val(cMes) <= 12 .And. Val(cDia) >= 1 .And. Val(cDia) <= 31
            Return cAno + "-" + cMes + "-" + cDia
        EndIf
    EndIf

Return ""

/*/{Protheus.doc} CH_APICHAMADOS
GET /CNSACHAMADOS - lista paginada (mais recente primeiro). Filtros: idCh, texto (busca livre),
tecnico, cliente e periodo; status e "meus chamados" ficam no portal.
@return Logical - resposta HTTP 200 com JSON paginado (total/items), ou erro
/*/
@Get(endpoint="/CNSACHAMADOS")
User Function CH_APICHAMADOS() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local oJson      := JsonObject():New()
    Local aTodos     := {}
    Local aRetorno   := {}
    Local oLinha     := Nil
    Local nPagina    := 1
    Local nTamanho   := 10
    Local nStartIdx  := 1
    Local nTotal     := 0
    Local nI         := 0
    Local nFim       := 0
    Local aCacheTec  := {}
    Local aCacheCli  := {}
    Local aCacheProj := {}
    Local aCacheTaf  := {}
    Local nPosCache  := 0
    Local cCodConsul := ""
    Local cCodCli    := ""
    Local cLoja      := ""
    Local cNomeTec   := ""
    Local cNomeCli   := ""
    Local cTipo      := ""
    Local cProjeto   := ""
    Local cTarefa    := ""
    Local cEmailCli  := ""
    Local cNomeProj  := ""
    Local cNomeTaf   := ""
    Local oErro      := Nil
    Local cFilAtu    := xFilial("ZA1")
    Local cIdChParam := ""
    Local cTextoParam := ""
    Local lIncluirLinha := .T.
    Local lAchou     := .F.
    Local cFTec      := ""
    Local cFCli      := ""
    Local dFDataDe   := CToD("")
    Local dFDataAte  := CToD("")
    Local aRet       := {500, CH_ERRO("Erro desconhecido.")}
    Local bErro      := Nil

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return oRest:setStatusResponse(403, CH_ERRO("Usuario sem acesso a este recurso."))
    EndIf

    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        nPagina   := CH_LERJSONNUM(jQuery, "pagina")
        nPagina   := If(nPagina < 1, 1, nPagina)
        nTamanho  := CH_LERJSONNUM(jQuery, "tamanho")
        nTamanho  := If(nTamanho < 1 .Or. nTamanho > 100, 10, nTamanho)
        nStartIdx := (nPagina - 1) * nTamanho + 1

        // idCh tem prioridade (Visualizar e lupa de chamado do CNS009).
        cIdChParam  := AllTrim(CH_LERJSONTXT(jQuery, "idCh"))
        // Busca livre (numero, assunto, cliente, tecnico) no backend: a lista e paginada.
        cTextoParam := Upper(AllTrim(CH_LERJSONTXT(jQuery, "texto")))

        // Busca avancada (tecnico/cliente/periodo) tambem no backend; vazio = nao filtra.
        cFTec     := AllTrim(CH_LERJSONTXT(jQuery, "tecnico"))
        cFCli     := AllTrim(CH_LERJSONTXT(jQuery, "cliente"))
        dFDataDe  := SToD(StrTran(AllTrim(CH_LERJSONTXT(jQuery, "dataDe")), "-", ""))
        dFDataAte := SToD(StrTran(AllTrim(CH_LERJSONTXT(jQuery, "dataAte")), "-", ""))

        dbSelectArea("ZA1")
        ZA1->(DbSetOrder(1))
        // Com idCh: so ele, sem filtros; sem: a filial inteira.
        If !Empty(cIdChParam)
            lAchou := ZA1->(DbSeek(cFilAtu + PadR(cIdChParam, TamSX3("ZA1_IDCH")[1])))
        Else
            lAchou := ZA1->(DbSeek(cFilAtu))
        EndIf
        While lAchou .And. !ZA1->(Eof()) .And. ZA1->ZA1_FILIAL == cFilAtu
            If Empty(cIdChParam)
                // Filtros de campo direto antes da busca livre (que resolve nomes via Posicione).
                lIncluirLinha := (Empty(cFTec) .Or. AllTrim(ZA1->ZA1_CONSUL) == cFTec) .And. ;
                    (Empty(cFCli) .Or. AllTrim(ZA1->ZA1_CLIENT) == cFCli) .And. ;
                    (Empty(dFDataDe) .Or. ZA1->ZA1_DATA >= dFDataDe) .And. ;
                    (Empty(dFDataAte) .Or. ZA1->ZA1_DATA <= dFDataAte)

                If lIncluirLinha .And. !Empty(cTextoParam)
                    cCodConsul := AllTrim(ZA1->ZA1_CONSUL)
                    cCodCli    := AllTrim(ZA1->ZA1_CLIENT)
                    cNomeTec   := If(Empty(cCodConsul), "", AllTrim(Posicione("AA1", 1, xFilial("AA1") + cCodConsul, "AA1_NOMTEC")))
                    cNomeCli   := If(Empty(cCodCli), "", AllTrim(Posicione("SA1", 1, xFilial("SA1") + cCodCli + AllTrim(ZA1->ZA1_LOJA), "A1_NREDUZ")))

                    lIncluirLinha := (cTextoParam $ Upper(AllTrim(ZA1->ZA1_IDCH))) .Or. ;
                        (cTextoParam $ Upper(U_CNSOUTL("UTF8", AllTrim(ZA1->ZA1_ASSUNT)))) .Or. ;
                        (cTextoParam $ Upper(cNomeCli)) .Or. ;
                        (cTextoParam $ Upper(cNomeTec))
                EndIf
            EndIf

            If lIncluirLinha
                AAdd(aTodos, {;
                    AllTrim(ZA1->ZA1_IDCH), ;
                    U_CNSOUTL("UTF8", AllTrim(ZA1->ZA1_ASSUNT)), ;
                    AllTrim(ZA1->ZA1_STATUS), ;
                    AllTrim(ZA1->ZA1_CONSUL), ;
                    AllTrim(ZA1->ZA1_CLIENT), ;
                    AllTrim(ZA1->ZA1_LOJA), ;
                    AllTrim(ZA1->ZA1_TIPO), ;
                    AllTrim(ZA1->ZA1_PROJ), ;
                    AllTrim(ZA1->ZA1_TAREFA), ;
                    AllTrim(ZA1->ZA1_EMAIL), ;
                    ZA1->ZA1_DATA, ;
                    U_CNSOUTL("UTF8", AllTrim(ZA1->ZA1_ANOT)) ;
                })
            EndIf

            If !Empty(cIdChParam)
                Exit
            EndIf
            ZA1->(DbSkip())
        EndDo

        nTotal := Len(aTodos)

        // Ordem 1 e ascendente: percorre de tras pra frente (mais recente primeiro).
        nI   := nTotal - nStartIdx + 1
        nFim := Max(nTotal - (nStartIdx + nTamanho - 1) + 1, 1)

        While nI >= nFim .And. nI >= 1
            cCodConsul := aTodos[nI][4]
            cCodCli    := aTodos[nI][5]
            cLoja      := aTodos[nI][6]

            nPosCache := AScan(aCacheTec, {|x| x[1] == cCodConsul})
            If nPosCache > 0
                cNomeTec := aCacheTec[nPosCache][2]
            ElseIf Empty(cCodConsul)
                cNomeTec := ""
            Else
                cNomeTec := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cCodConsul, "AA1_NOMTEC"))
                AAdd(aCacheTec, {cCodConsul, cNomeTec})
            EndIf

            nPosCache := AScan(aCacheCli, {|x| x[1] == cCodCli + cLoja})
            If nPosCache > 0
                cNomeCli := aCacheCli[nPosCache][2]
            ElseIf Empty(cCodCli)
                cNomeCli := ""
            Else
                cNomeCli := AllTrim(Posicione("SA1", 1, xFilial("SA1") + cCodCli + cLoja, "A1_NREDUZ"))
                AAdd(aCacheCli, {cCodCli + cLoja, cNomeCli})
            EndIf

            cTipo     := aTodos[nI][7]
            cProjeto  := aTodos[nI][8]
            cTarefa   := aTodos[nI][9]
            cEmailCli := aTodos[nI][10]

            nPosCache := AScan(aCacheProj, {|x| x[1] == cProjeto})
            If nPosCache > 0
                cNomeProj := aCacheProj[nPosCache][2]
            ElseIf Empty(cProjeto)
                cNomeProj := ""
            Else
                cNomeProj := AllTrim(Posicione("AF8", 1, xFilial("AF8") + cProjeto, "AF8_DESCRI"))
                AAdd(aCacheProj, {cProjeto, cNomeProj})
            EndIf

            // AF9 tem revisao na chave: CH_CONSULTA usa a do projeto (antes o nome vinha sempre vazio).
            nPosCache := AScan(aCacheTaf, {|x| x[1] == cProjeto + "|" + cTarefa})
            If nPosCache > 0
                cNomeTaf := aCacheTaf[nPosCache][2]
            Else
                cNomeTaf := CH_CONSULTA("TAREFA", cProjeto, cTarefa)
                AAdd(aCacheTaf, {cProjeto + "|" + cTarefa, cNomeTaf})
            EndIf

            oLinha := JsonObject():New()
            oLinha['idCh']         := aTodos[nI][1]
            oLinha['assunto']      := aTodos[nI][2]
            oLinha['status']       := aTodos[nI][3]
            oLinha['tecnico']      := cNomeTec
            oLinha['codConsultor'] := cCodConsul
            oLinha['cliente']      := cNomeCli
            oLinha['codCliente']   := cCodCli
            oLinha['lojaCliente']  := cLoja
            oLinha['tipo']         := cTipo
            oLinha['projeto']      := cProjeto
            oLinha['nomeProjeto']  := cNomeProj
            oLinha['tarefa']       := cTarefa
            oLinha['nomeTarefa']   := cNomeTaf
            oLinha['emailCliente'] := cEmailCli
            // Descricao = ZA1_ANOT (antigas anotacoes, hoje no historico ZA2).
            oLinha['descricao']    := aTodos[nI][12]
            oLinha['data']         := CH_DATAISOZA1(If(ValType(aTodos[nI][11]) == "D", DToS(aTodos[nI][11]), cValToChar(aTodos[nI][11])))
            AAdd(aRetorno, oLinha)

            nI--
        EndDo

        oJson['total']        := nTotal
        oJson['totalPaginas'] := If(nTotal == 0, 0, Ceiling(nTotal / nTamanho))
        oJson['pagina']       := nPagina
        oJson['tamanho']      := nTamanho
        // So admin altera status (o backend tambem bloqueia).
        oJson['podeAlterarStatus'] := CH_TEMACESSOGRUPO()
        oJson['items']        := aRetorno

        aRet := {200, oJson:ToJson()}

    Recover Using oErro
        aRet := {500, CH_ERRO(oErro:Description)}
    End Sequence
    ErrorBlock(bErro)

Return oRest:setStatusResponse(aRet[1], aRet[2])

/*/{Protheus.doc} CH_APIMEUCONSULTOR
GET /CNSACHAMADOSMEU - tecnico (AA1) do usuario logado e se e administrador.
@return Logical - resposta HTTP 200 com codConsultor/nomeTecnico
/*/
@Get(endpoint="/CNSACHAMADOSMEU")
User Function CH_APIMEUCONSULTOR() As Logical
    Local oJson      := JsonObject():New()
    Local cConsultor := Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC")
    Local cNomeTec   := ""

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return oRest:setStatusResponse(403, CH_ERRO("Usuario sem acesso a este recurso."))
    EndIf

    If !Empty(cConsultor)
        cNomeTec := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cConsultor, "AA1_NOMTEC"))
    EndIf

    oJson['codConsultor'] := AllTrim(cConsultor)
    oJson['nomeTecnico']  := cNomeTec
    // Admin pelo usuario da sessao (mesma regra do CH_TEMACESSOGRUPO).
    oJson['rspmnt']       := If(CH_TEMACESSOGRUPO(), "1", "2")

Return oRest:setStatusResponse(200, oJson:ToJson())

/*/{Protheus.doc} CH_GRAVARINTERACAO
Grava uma interacao (ZA2) pelo model CNSAZA2VIEW (o mesmo da tela).
@param  cIdCh        Id do chamado (ZA1_IDCH)
@param  cConsultor   Codigo do consultor autor da interacao
@param  cTexto       Texto da interacao
@param  cOs          Numero da OS que gerou a interacao (ZA2_OS) - opcional
@param  cErro        (referencia) mensagem de erro do Model quando a gravacao falha
@return cSeq   Sequencia (3 digitos) da interacao gravada - vazio se falhou
/*/
Static Function CH_GRAVARINTERACAO(cIdCh, cConsultor, cTexto, cOs, cErro)
    Local nSeq        := 1
    Local oModel      := Nil
    Local oModelZA2   := Nil
    Local lOk         := .F.
    Local oErroModel  := Nil
    Local oErro       := Nil
    Local bErro       := Nil
    Local jMot        := JsonObject():New()
    Local cTrava      := "CNSAZA2_" + AllTrim(cIdCh)
    Local nI          := 0

    Default cOs := ""

    cErro := ""

    // MAX+1 da ZA2_IDGRID ate o commit sob trava (ate ~5 s): duas interacoes juntas pegavam a mesma sequencia.
    For nI := 1 To 25
        If LockByName(cTrava, .T., .F.)
            Exit
        EndIf
        Sleep(200)
    Next nI
    If nI > 25
        cErro := "Chamado em uso por outra interacao. Tente novamente."
        Return ""
    EndIf

    // Erro de execucao cai no Recover (solta a trava) em vez de derrubar a thread.
    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        // ZA2_IDCH e Character: comparar com Character (numero da ORA-01722) - nao usar Val().
        nSeq := CH_PROXZA2(cIdCh)

        oModel := FWLoadModel("CNSAZA2VIEW")
        If oModel == Nil
            cErro := "Nao foi possivel carregar o modelo CNSAZA2VIEW."
        Else
            oModel:SetOperation(MODEL_OPERATION_INSERT)
            oModel:Activate()
            oModelZA2 := oModel:GetModel("ZA2MASTER")

            oModelZA2:SetValue("ZA2_IDCH",   cIdCh)
            oModelZA2:SetValue("ZA2_CONSUL", cConsultor)
            oModelZA2:SetValue("ZA2_DATA",   Date())
            oModelZA2:SetValue("ZA2_IDGRID", StrZero(nSeq, 3))
            oModelZA2:SetValue("ZA2_HORA",   Left(Time(), 5))
            oModelZA2:SetValue("ZA2_DESCRI", cTexto)
            If !Empty(cOs)
                oModelZA2:SetValue("ZA2_OS", cOs)
            EndIf

            lOk := oModel:VldData() .And. oModel:CommitData()

            If !lOk
                oErroModel := oModel:GetErrorMessage()
                ConOut("CH_GRAVARINTERACAO: falha ao gravar via Model CNSAZA2VIEW: " + FwJsonSerialize(oErroModel))
                // Falha devolve vazio (antes o REST dizia sucesso sem gravar).
                If ValType(oErroModel) == "A" .And. Len(oErroModel) >= 6 .And. !Empty(oErroModel[6])
                    cErro := AllTrim(cValToChar(oErroModel[6]))
                Else
                    cErro := "Falha ao gravar a interacao."
                EndIf
            EndIf

            oModel:DeActivate(lOk)
        EndIf

    Recover Using oErro
        If !lOk
            cErro := "Erro ao gravar a interacao: " + oErro:Description
        EndIf
        If oModel <> Nil .And. oModel:IsActive()
            oModel:DeActivate()
        EndIf
    End Sequence
    ErrorBlock(bErro)
    UnLockByName(cTrava, .T., .F.)

    // Interacao da OS: OS enviada e sem resposta perde o link (o cliente recebe outro).
    If lOk .And. !Empty(cOs)
        jMot["motivo"] := "interacao nova"
        apia.cnsa004.U_CNSAPR("INV", cOs, "", jMot)
    EndIf

Return If(lOk, StrZero(nSeq, 3), "")

/*/{Protheus.doc} CH_LISTARINTERACOES
Monta o JSON com as interacoes (ZA2) de um chamado, ordenadas por
sequencia, com consultor resolvido por nome.
@param  cIdCh   Id do chamado (ZA1_IDCH)
@return Array {nStatusHTTP, cCorpoJson}
/*/
Static Function CH_LISTARINTERACOES(cIdCh)
    Local oJson     := JsonObject():New()
    Local aItens    := {}
    Local oLinha    := Nil
    Local cAlias    := ""
    Local cNomeCons := ""
    Local oErro     := Nil
    Local aRet      := {500, CH_ERRO("Erro desconhecido.")}
    Local bErro     := Nil

    If !CH_ACHARZA1(cIdCh)
        Return {404, CH_ERRO("Chamado nao encontrado.")}
    EndIf

    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        cAlias := GetNextAlias()

        // ZA2_DESCRI (Memo) tem que ser a ultima coluna do SELECT (DBAccess).
        BeginSql Alias cAlias
            SELECT ZA2_IDGRID, ZA2_CONSUL, ZA2_DATA, ZA2_HORA, ZA2_OS, ZA2_DESCRI
            FROM %Table:ZA2% ZA2
            WHERE ZA2_FILIAL = %xFilial:ZA2%
              AND ZA2_IDCH   = %Exp:cIdCh%
              AND %NotDel%
            ORDER BY ZA2_IDGRID
        EndSql

        While !(cAlias)->(Eof())
            // Codigo vazio: Posicione cairia no 1o registro da AA1 (soft-seek).
            If Empty(AllTrim((cAlias)->ZA2_CONSUL))
                cNomeCons := ""
            Else
                cNomeCons := AllTrim(Posicione("AA1", 1, xFilial("AA1") + AllTrim((cAlias)->ZA2_CONSUL), "AA1_NOMTEC"))
            EndIf

            oLinha := JsonObject():New()
            oLinha['seq']       := AllTrim((cAlias)->ZA2_IDGRID)
            oLinha['consultor'] := cNomeCons
            oLinha['data']      := CH_DATAISOZA1(If(ValType((cAlias)->ZA2_DATA) == "D", DToS((cAlias)->ZA2_DATA), (cAlias)->ZA2_DATA))
            oLinha['hora']      := AllTrim((cAlias)->ZA2_HORA)
            oLinha['texto']     := U_CNSOUTL("UTF8", AllTrim((cAlias)->ZA2_DESCRI))
            oLinha['os']        := AllTrim((cAlias)->ZA2_OS)
            AAdd(aItens, oLinha)

            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())

        oJson['idCh']  := cIdCh
        oJson['items'] := aItens

        aRet := {200, oJson:ToJson()}

    Recover Using oErro
        If !Empty(cAlias) .And. Select(cAlias) > 0
            (cAlias)->(DbCloseArea())
        EndIf
        aRet := {500, CH_ERRO(oErro:Description)}
    End Sequence
    ErrorBlock(bErro)

Return aRet

/*/{Protheus.doc} CH_APILISTAINTERACOES
Endpoint REST GET /CNSACHAMADOSINTERACOES: lista as interacoes de um
chamado (idCh via query), chamando CH_LISTARINTERACOES.
@return Logical - resposta HTTP com o JSON de interacoes
/*/
@Get(endpoint="/CNSACHAMADOSINTERACOES")
User Function CH_APILISTAINTERACOES() As Logical
    Local jQuery     := oRest:getQueryRequest() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return oRest:setStatusResponse(403, CH_ERRO("Usuario sem acesso a este recurso."))
    EndIf

    aResultado := CH_LISTARINTERACOES(AllTrim(CH_LERJSONTXT(jQuery,"idCh")))

Return oRest:setStatusResponse(aResultado[1], aResultado[2])

/*/{Protheus.doc} CH_INCLUIRINTERACAO
Inclui interacao pelo REST e avisa o cliente (ZA1_EMAIL) se pedido.
@param  cIdCh               Id do chamado (ZA1_IDCH)
@param  cTexto              Texto da interacao (pode vir em HTML do editor do portal)
@param  lNotificarCliente   .T. pra tambem enviar e-mail ao cliente sobre a interacao
@param  cOs                 Numero da OS que gerou a interacao (ZA2_OS) - opcional
@return Array {nStatusHTTP, cCorpoJson}
@param  lNotificarTecnico   .T. pra enviar o texto ao tecnico do chamado (nao vai pra quem interagiu)
/*/
Static Function CH_INCLUIRINTERACAO(cIdCh, cTexto, lNotificarCliente, cOs, lNotificarTecnico)
    Local oJson      := JsonObject():New()
    Local oErro      := Nil
    Local cConsultor := ""
    Local cSeq       := ""
    Local cEmailCli  := ""
    Local cErroGrv   := ""
    Local cConsulCh  := ""
    Local aRet       := {500, CH_ERRO("Erro desconhecido.")}
    Local bErro      := Nil

    Default lNotificarCliente := .F.
    Default cOs               := ""
    Default lNotificarTecnico := .F.

    // Editor rico do portal manda HTML: grava texto puro (igual a interacao da OS).
    cTexto := AllTrim(U_CNSOUTL("TEXTOPURO", cTexto))

    If !CH_ACHARZA1(cIdCh)
        Return {404, CH_ERRO("Chamado nao encontrado.")}
    EndIf

    // Mesmas travas da tela classica (CNSA_INTERAGIR)
    If AllTrim(ZA1->ZA1_STATUS) == "4"
        Return {400, CH_ERRO("Chamado fechado nao pode receber interacoes.")}
    EndIf
    If Empty(AllTrim(ZA1->ZA1_CONSUL))
        Return {400, CH_ERRO("O chamado precisa ter um tecnico designado para receber interacoes.")}
    EndIf
    If Empty(AllTrim(ZA1->ZA1_CLIENT))
        Return {400, CH_ERRO("O chamado precisa ter um cliente designado para receber interacoes.")}
    EndIf
    If AllTrim(ZA1->ZA1_CONSUL) <> AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC")) .And. !CH_TEMACESSOGRUPO()
        Return {403, CH_ERRO("Voce nao tem permissao para interagir neste chamado.")}
    EndIf

    cEmailCli := AllTrim(ZA1->ZA1_EMAIL)
    cConsulCh := AllTrim(ZA1->ZA1_CONSUL)

    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        cConsultor := Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC")
        cSeq       := CH_GRAVARINTERACAO(cIdCh, cConsultor, cTexto, cOs, @cErroGrv)

        If Empty(cSeq)
            // Validacao do model/trava: erro do pedido, nao do servidor.
            aRet := {400, CH_ERRO("Interacao nao gravada: " + cErroGrv)}
        Else
            oJson['sucesso']  := .T.
            oJson['idCh']     := cIdCh
            oJson['seq']      := cSeq
            oJson['mensagem'] := "Interacao adicionada com sucesso."
            aRet := {200, oJson:ToJson()}
        EndIf

    Recover Using oErro
        aRet := {500, CH_ERRO(oErro:Description)}
    End Sequence
    ErrorBlock(bErro)

    // E-mails depois de gravar.
    If aRet[1] == 200
        If lNotificarCliente .And. !Empty(cEmailCli)
            CH_EMAIL("INTERACAO", cEmailCli, cIdCh, cTexto, "incluida", "Nova Interacao")
        EndIf
        // Tecnico do chamado - nao manda pra ele mesmo (quem interagiu).
        If lNotificarTecnico .And. cConsulCh <> AllTrim(cConsultor)
            CH_EMAIL("INTERACAO", U_CNSOUTL("EMAIL", cConsulCh), cIdCh, cTexto, "incluida", "Nova Interacao")
        EndIf
    EndIf

Return aRet

/*/{Protheus.doc} CH_APINOVAINTERACAO
Endpoint REST POST /CNSACHAMADOSINTERACOESINCLUIR: inclui uma interacao
para um chamado (idCh/texto no corpo ou na query), chamando CH_INCLUIRINTERACAO.
@return Logical - resposta HTTP com o resultado da inclusao
/*/
@Post(endpoint="/CNSACHAMADOSINTERACOESINCLUIR")
User Function CH_APINOVAINTERACAO() As Logical
    Local jQuery     := CH_PARAMS() As Json
    Local aResultado := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return oRest:setStatusResponse(403, CH_ERRO("Usuario sem acesso a este recurso."))
    EndIf

    aResultado := CH_INCLUIRINTERACAO(AllTrim(CH_LERJSONTXT(jQuery,"idCh")), CH_LERJSONTXT(jQuery,"texto"), AllTrim(CH_LERJSONTXT(jQuery,"notificarCliente")) == "1", AllTrim(CH_LERJSONTXT(jQuery,"os")), ;
        AllTrim(CH_LERJSONTXT(jQuery,"notificarTecnico")) == "1")

Return oRest:setStatusResponse(aResultado[1], aResultado[2])

/*/{Protheus.doc} CH_NUCLEOEXCLUIRINTERACAO
Exclui uma interacao (RecLock direto): so o autor ou o admin, com o chamado aberto. Avisa o cliente se pedido.
@param  cIdCh               Id do chamado (ZA1_IDCH)
@param  cSeq                Sequencia da interacao (ZA2_IDGRID, 3 digitos)
@param  lNotificarCliente   .T. pra tambem enviar e-mail ao cliente avisando da remocao
@param  lNotificarTecnico   .T. pra avisar o tecnico do chamado (nao vai pra quem excluiu)
@return Array {nStatusHTTP, cMensagem}
/*/
Static Function CH_NUCLEOEXCLUIRINTERACAO(cIdCh, cSeq, lNotificarCliente, lNotificarTecnico)
    Local oErro      := Nil
    Local cAlias     := ""
    Local nRecno     := 0
    Local cConsultor := ""
    Local cAutorInteracao := ""
    Local cTexto     := ""
    Local cEmailCli  := ""
    Local cConsulCh  := ""
    Local cOsInt     := ""
    Local jMot       := JsonObject():New()
    Local aRet       := {500, "Erro desconhecido."}
    Local bErro      := Nil

    Default lNotificarCliente := .F.
    Default lNotificarTecnico := .F.

    If !CH_ACHARZA1(cIdCh)
        Return {404, "Chamado nao encontrado."}
    EndIf

    If AllTrim(ZA1->ZA1_STATUS) == "4"
        Return {400, "Chamado fechado nao pode ter interacoes excluidas."}
    EndIf

    cEmailCli := AllTrim(ZA1->ZA1_EMAIL)
    cConsulCh := AllTrim(ZA1->ZA1_CONSUL)

    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        cAlias := GetNextAlias()
        BeginSql Alias cAlias
            SELECT ZA2.R_E_C_N_O_ RECNO, ZA2_CONSUL, ZA2_OS, ZA2_DESCRI
            FROM %Table:ZA2% ZA2
            WHERE ZA2.ZA2_FILIAL = %xFilial:ZA2%
              AND ZA2.ZA2_IDCH   = %Exp:cIdCh%
              AND ZA2.ZA2_IDGRID = %Exp:cSeq%
              AND %NotDel%
        EndSql

        If !(cAlias)->(Eof())
            nRecno          := (cAlias)->RECNO
            cAutorInteracao := AllTrim((cAlias)->ZA2_CONSUL)
            cOsInt          := AllTrim((cAlias)->ZA2_OS)
            cTexto          := U_CNSOUTL("UTF8", AllTrim((cAlias)->ZA2_DESCRI))
        EndIf
        (cAlias)->(DbCloseArea())

        cConsultor := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_CODTEC"))

        Do Case
        Case nRecno == 0
            aRet := {404, "Interacao nao encontrada."}
        Case cAutorInteracao <> cConsultor .And. !CH_TEMACESSOGRUPO()
            aRet := {403, "Voce nao tem permissao para excluir esta interacao."}
        OtherWise
            dbSelectArea("ZA2")
            ZA2->(DbGoTo(nRecno))
            If RecLock("ZA2", .F.)
                ZA2->(DbDelete())
                ZA2->(MsUnlock())
                aRet := {200, "Interacao excluida com sucesso."}
            Else
                aRet := {409, "Interacao em uso por outro usuario. Tente novamente."}
            EndIf
        EndCase

    Recover Using oErro
        If !Empty(cAlias) .And. Select(cAlias) > 0
            (cAlias)->(DbCloseArea())
        EndIf
        aRet := {500, "Erro interno: " + oErro:Description}
    End Sequence
    ErrorBlock(bErro)

    If aRet[1] == 200
        // Interacao da OS: OS enviada e sem resposta perde o link (o cliente recebe outro).
        If !Empty(cOsInt)
            jMot["motivo"] := "interacao excluida"
            apia.cnsa004.U_CNSAPR("INV", cOsInt, "", jMot)
        EndIf

        If lNotificarCliente .And. !Empty(cEmailCli)
            CH_EMAIL("INTERACAO", cEmailCli, cIdCh, cTexto, "removida", "Interacao Removida")
        EndIf
        If lNotificarTecnico .And. cConsulCh <> cConsultor
            CH_EMAIL("INTERACAO", U_CNSOUTL("EMAIL", cConsulCh), cIdCh, cTexto, "removida", "Interacao Removida")
        EndIf
    EndIf

Return aRet

/*/{Protheus.doc} CH_APIEXCLUIRINTERACAO
Endpoint REST POST /CNSACHAMADOSINTERACOESEXCLUIR: exclui uma interacao de
um chamado (idCh/seq no corpo ou na query), chamando CH_NUCLEOEXCLUIRINTERACAO.
@return Logical - resposta HTTP com o resultado da exclusao
/*/
@Post(endpoint="/CNSACHAMADOSINTERACOESEXCLUIR")
User Function CH_APIEXCLUIRINTERACAO() As Logical
    Local jQuery     := CH_PARAMS() As Json
    Local cIdCh      := AllTrim(CH_LERJSONTXT(jQuery,"idCh"))
    Local cSeq       := AllTrim(CH_LERJSONTXT(jQuery,"seq"))
    Local aResultado := {}
    Local oJson      := JsonObject():New()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return oRest:setStatusResponse(403, CH_ERRO("Usuario sem acesso a este recurso."))
    EndIf

    aResultado := CH_NUCLEOEXCLUIRINTERACAO(cIdCh, cSeq, AllTrim(CH_LERJSONTXT(jQuery,"notificarCliente")) == "1", ;
        AllTrim(CH_LERJSONTXT(jQuery,"notificarTecnico")) == "1")

    If aResultado[1] == 200
        oJson['sucesso']  := .T.
        oJson['idCh']     := cIdCh
        oJson['seq']      := cSeq
        oJson['mensagem'] := aResultado[2]
        Return oRest:setStatusResponse(200, oJson:ToJson())
    EndIf

Return oRest:setStatusResponse(aResultado[1], CH_ERRO(aResultado[2]))

/*/{Protheus.doc} CH_ERRO
JSON de erro: {"erro": cMsg}.
/*/
Static Function CH_ERRO(cMsg)
Return '{"erro":"' + CH_ESCAPARJSON(cMsg) + '"}'

/*/{Protheus.doc} CH_ESCAPARJSON
Escapa caracteres especiais (barra invertida, aspas, quebras de linha,
tabulacao) de um texto para uso seguro dentro de uma string JSON.
@param  cTexto   Texto a escapar
@return cRet   Texto com os caracteres especiais escapados
/*/
Static Function CH_ESCAPARJSON(cTexto)
    Local cRet := cTexto
    cRet := StrTran(cRet, '\',  '\\')
    cRet := StrTran(cRet, '"',  '\"')
    cRet := StrTran(cRet, Chr(13)+Chr(10), '\n')
    cRet := StrTran(cRet, Chr(10), '\n')
    cRet := StrTran(cRet, Chr(13), '\n')
    cRet := StrTran(cRet, Chr(9),  '\t')
Return cRet

/*/{Protheus.doc} CH_LERJSONNUM
Le um campo numerico de um JsonObject, com fallback seguro para 0 quando
o campo esta ausente.
@param  jDados   JsonObject de origem (ex: query string da requisicao)
@param  cCampo   Nome do campo a ler
@return Valor numerico do campo, ou 0 se ausente
/*/
Static Function CH_LERJSONNUM(jDados, cCampo)
    Local xVal := jDados[cCampo]
    If xVal == Nil
        Return 0
    EndIf
Return Val(cValToChar(xVal))

/*/{Protheus.doc} CH_LERJSONTXT
Campo texto da query/corpo, UTF-8 decodificado uma vez (U_CNSOUTL "UTF8"); "" se ausente.
@param  jDados   JsonObject de origem (ex: query string da requisicao)
@param  cCampo   Nome do campo a ler
@return cTexto   Valor do campo, decodificado, ou "" se ausente/invalido
/*/
Static Function CH_LERJSONTXT(jDados, cCampo)
    Local xVal := jDados[cCampo]
    If xVal == Nil .Or. ValType(xVal) != "C"
        Return ""
    EndIf
Return U_CNSOUTL("UTF8", xVal)

/*/{Protheus.doc} CH_JOBFECHA30
Schedule: fecha (status 4) chamado aberto (1) sem alteracao (ZA1_MOD) ha 30 dias ou mais.
/*/
User Function CH_JOBFECHA30()
    Local cEmpAnt      := "01"
    Local cFilAnt      := "01"
    Local dLimite      := Date() - 30
    Local nFechados    := 0
    Local cAlias       := "ZA1FECHA"
    Local oErro        := Nil
    Local bErro        := Nil

    RpcSetType(3)
    If !RpcSetEnv(cEmpAnt, cFilAnt, , , "SIGAFAT", , {"ZA1"})
        ConOut("CH_JOBFECHA30: falha no RpcSetEnv - job abortado.")
        Return
    EndIf

    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence

        BeginSql Alias cAlias
            SELECT ZA1.R_E_C_N_O_ RECNO
            FROM %Table:ZA1% ZA1
            WHERE ZA1.ZA1_FILIAL = %xFilial:ZA1%
              AND ZA1.ZA1_STATUS = '1'
              AND ZA1.ZA1_MOD < %Exp:dLimite%
              AND ZA1.%NotDel%
        EndSql

        While !(cAlias)->(Eof())
            ZA1->(DbGoTo((cAlias)->RECNO))

            RecLock("ZA1", .F.)
                ZA1->ZA1_STATUS := "4"
                ZA1->ZA1_MOD    := Date()
            ZA1->(MsUnlock())

            nFechados++
            ConOut("CH_JOBFECHA30: chamado " + AllTrim(ZA1->ZA1_IDCH) + " fechado automaticamente (30 dias sem modificacao).")

            If !Empty(AllTrim(ZA1->ZA1_EMAIL))
                CH_EMAIL("ENCERRADO", AllTrim(ZA1->ZA1_EMAIL), AllTrim(ZA1->ZA1_IDCH), AllTrim(ZA1->ZA1_ASSUNT))
            EndIf

            (cAlias)->(DbSkip())
        EndDo

        (cAlias)->(DbCloseArea())

    Recover Using oErro
        ConOut("CH_JOBFECHA30: erro durante execucao: " + oErro:Description)
        If Select(cAlias) > 0
            (cAlias)->(DbCloseArea())
        EndIf
    End Sequence
    ErrorBlock(bErro)


    ConOut("CH_JOBFECHA30: finalizado - " + AllTrim(Str(nFechados)) + " chamado(s) fechado(s).")

    RpcClearEnv()

Return

/*/{Protheus.doc} CH_ENVIAREMAIL
Envia um e-mail HTML via Microsoft Graph (sendMail) pelo U_CNSOUTL("HTTP") da cnslib (token e chamada).
@param  cPara       E-mail do destinatario
@param  cAssunto    Assunto do e-mail
@param  cCorpo      Corpo HTML do e-mail
@param  cDe         Caixa remetente (mailbox do Graph)
@return lOk   .T. se o Graph aceitou (202 Accepted), .F. caso contrario
/*/
Static Function CH_ENVIAREMAIL(cPara, cAssunto, cCorpo, cDe)
    Local cJson   := ""
    Local cUtf8   := ""
    Local aResp   := {}
    Local lOk     := .F.

    If Empty(cPara)
        ConOut("CH_ENVIAREMAIL: nao enviado - destinatario (cPara) vazio - AA1_EMAIL nao cadastrado?")
        Return .F.
    EndIf

    cJson := '{'
    cJson +=   '"message": {'
    cJson +=     '"subject": "' + CH_ESCAPARJSON(cAssunto) + '",'
    cJson +=     '"body": {'
    cJson +=       '"contentType": "HTML",'
    cJson +=       '"content": "' + CH_ESCAPARJSON(cCorpo) + '"'
    cJson +=     '},'
    cJson +=     '"toRecipients": [{'
    cJson +=       '"emailAddress": {'
    cJson +=         '"address": "' + CH_ESCAPARJSON(cPara) + '"'
    cJson +=       '}'
    cJson +=     '}]'
    cJson +=   '},'
    cJson +=   '"saveToSentItems": "true"'
    cJson += '}'

    // Graph le o corpo como UTF-8 (o fonte e CP1252: acento chegava quebrado). Sem token: {0, motivo}.
    cUtf8 := EncodeUTF8(cJson)
    aResp := U_CNSOUTL("HTTP", "POST", "https://graph.microsoft.com/v1.0/users/" + cDe + "/sendMail", If(ValType(cUtf8) == "C", cUtf8, cJson))

    lOk := (aResp[1] == 202)
    If !lOk
        ConOut("CH_ENVIAREMAIL: falha no POST sendMail (Graph) para " + cPara + ": HTTP " + cValToChar(aResp[1]) + " | " + aResp[2])
    EndIf

Return lOk

/*/{Protheus.doc} CH_HTMLEMAIL
Layout unico dos e-mails do chamado: logo + numero, alerta, saudacao, cartao de dados, texto opcional e
rodape. Estilo inline (Outlook) e acentos como entidade HTML (fonte CP1252).
@param  cIdCh        Numero do chamado (vazio = sem selo)
@param  cAlerta      Texto do alerta em vermelho
@param  cNome        Nome pra saudacao ("Ola, <nome>,") - vazio = "Ola,"
@param  cIntro       Frase de introducao
@param  aLinhas      Array de {rotulo, valorHtml} do cartao (vazio = sem cartao)
@param  cTituloTexto Titulo do bloco de texto (ex: "Descricao")
@param  cTexto       Texto do bloco (vazio = sem bloco)
@param  cObs         Linha extra antes do rodape (ex: contato) - opcional
@return cHtml   Corpo HTML do e-mail
/*/
Static Function CH_HTMLEMAIL(cIdCh, cAlerta, cNome, cIntro, aLinhas, cTituloTexto, cTexto, cObs)
    Local cHtml   := ""
    Local nI      := 0
    Local cBorda  := "border-bottom:1px solid #e6e9ef;"
    Local cRot    := ""
    Local cVal    := ""

    Default cIdCh        := ""
    Default cNome        := ""
    Default aLinhas      := {}
    Default cTituloTexto := ""
    Default cTexto       := ""
    Default cObs         := ""

    cHtml := '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f9;font-family:Arial,Helvetica,sans-serif">'
    cHtml += '<tr><td align="center" style="padding:16px 8px">'
    cHtml += '<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background-color:#ffffff">'

    // Cabecalho branco: logo da Apia (publicado no portal) + selo com o numero do chamado
    cHtml += '<tr><td style="background-color:#ffffff;padding:18px 28px">'
    cHtml += '<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>'
    cHtml += '<td align="left"><img src="https://www.apia.com.br/apia_cs/logo-apia-completa.png" alt="&Aacute;pia Consultoria e Sistemas" height="48" style="display:block;border:0;height:48px"></td>'
    If !Empty(cIdCh)
        cHtml += '<td align="right"><span style="display:inline-block;background-color:#1a7fc1;color:#ffffff;font-size:14px;font-weight:bold;letter-spacing:1px;padding:8px 14px;border-radius:6px">CHAMADO #' + cIdCh + '</span></td>'
    EndIf
    cHtml += '</tr></table>'
    cHtml += '</td></tr>'
    cHtml += '<tr><td style="background-color:#1a7fc1;height:4px;line-height:4px;font-size:0">&nbsp;</td></tr>'

    // Alerta: sem fundo, texto em vermelho, centralizado
    cHtml += '<tr><td align="center" style="background-color:#ffffff;padding:16px 28px;color:#c62828;font-size:16px;font-weight:bold;text-align:center">&#9888; ' + cAlerta + '</td></tr>'

    // Saudacao
    cHtml += '<tr><td style="background-color:#f4f6f9;padding:24px 28px 8px 28px">'
    cHtml += '<div style="color:#374151;font-size:15px;line-height:1.5">Ol&aacute;' + If(Empty(cNome), "", ", " + cNome) + ',<br>' + cIntro + '</div>'
    cHtml += '</td></tr>'

    // Cartao com os dados + bloco de texto
    If Len(aLinhas) > 0 .Or. !Empty(cTexto)
        cHtml += '<tr><td style="background-color:#f4f6f9;padding:12px 28px">'
        cHtml += '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#ffffff">'
        If Len(aLinhas) > 0
            cHtml += '<tr><td style="padding:20px 28px 4px 28px"><div style="color:#0d5a8a;font-size:18px;font-weight:bold;padding-bottom:12px;border-bottom:1px solid #e6e9ef">Chamado</div>'
            cHtml += '<table role="presentation" width="100%" cellpadding="0" cellspacing="0">'
            For nI := 1 To Len(aLinhas)
                // ultima linha sem borda embaixo
                cRot := 'style="padding:14px 0;' + If(nI < Len(aLinhas), cBorda, "") + 'color:#6b7280;font-size:14px;width:38%;vertical-align:top"'
                cVal := 'style="padding:14px 0;' + If(nI < Len(aLinhas), cBorda, "") + 'color:#111827;font-size:15px;font-weight:bold;vertical-align:top"'
                cHtml += '<tr><td ' + cRot + '>' + aLinhas[nI][1] + '</td><td ' + cVal + '>' + aLinhas[nI][2] + '</td></tr>'
            Next nI
            cHtml += '</table>'
            cHtml += '</td></tr>'
        EndIf
        If !Empty(cTexto)
            cHtml += '<tr><td style="padding:18px 28px 20px 28px;' + If(Len(aLinhas) > 0, 'border-top:1px solid #e6e9ef', '') + '">'
            If !Empty(cTituloTexto)
                cHtml += '<div style="color:#0d5a8a;font-size:18px;font-weight:bold;padding-bottom:8px">' + cTituloTexto + '</div>'
            EndIf
            cHtml += '<div style="color:#374151;font-size:15px;line-height:1.5">' + cTexto + '</div>'
            cHtml += '</td></tr>'
        EndIf
        cHtml += '</table>'
        cHtml += '</td></tr>'
    EndIf

    If !Empty(cObs)
        cHtml += '<tr><td align="center" style="background-color:#f4f6f9;padding:12px 28px 0 28px;color:#374151;font-size:14px">' + cObs + '</td></tr>'
    EndIf

    cHtml += '<tr><td align="center" style="background-color:#f4f6f9;padding:16px 28px 20px 28px;color:#9ca3af;font-size:13px">--- Mensagem autom&aacute;tica, por favor n&atilde;o responda ---</td></tr>'

    // Rodape no padrao da Apia
    cHtml += '<tr><td align="center" style="background-color:#0d5a8a;padding:12px 28px;color:#ffffff;font-size:12px">&Aacute;pia Consultoria e Sistemas - TOTVS Business Partner</td></tr>'

    cHtml += '</table>'
    cHtml += '</td></tr>'
    cHtml += '</table>'

Return cHtml

/*/{Protheus.doc} CH_STATUSLABEL
Traduz o codigo de status (ZA1_STATUS) pro rotulo exibido na legenda da
tela classica (ver AddLegend no BrowseDef).
@param  cStatus   Codigo do status (1 a 5)
@return cLabel    Rotulo do status, ou o proprio codigo se desconhecido
/*/
Static Function CH_STATUSLABEL(cStatus)
    Local cLabel := cStatus

    Do Case
        Case cStatus == "1" ; cLabel := "Aberto"
        Case cStatus == "2" ; cLabel := "Pendente Apia"
        Case cStatus == "3" ; cLabel := "Pendente Cliente"
        Case cStatus == "4" ; cLabel := "Fechado"
        Case cStatus == "5" ; cLabel := "Incompleto"
    EndCase

Return cLabel

/*/{Protheus.doc} CH_EMAIL
E-mails do chamado - uma opcao por Case, todos no layout CH_HTMLEMAIL, enviados pelo CH_ENVIAREMAIL.
Texto livre (nomes, assunto, motivo, descricao, interacao) passa pelo U_CNSOUTL("TEXTO"): escapa o HTML.
  CANCELA       (cPara, cIdCh, cCliente, aAgenda, cMotivo, cAlteradoPor)  analista removido (troca de tecnico)
  ENCERRAMENTO  (cPara, cIdCh, cCliente, aAgenda, cMotivo, cExcluidoPor)  chamado excluido
  DESIGNA       ("", cIdCh, cCodTec, lNotificarCliente, lNotificarTecnico) analista designado (e o cliente, se pedido)
  ALTERACAO     (cPara, cIdCh, aMudancas)                       cliente: campos alterados {rotulo, de, para}
  INTERACAO     (cPara, cIdCh, cTexto, cAcaoLabel, cAssuntoBase) interacao incluida/removida
  SEMCONTATO    (cPara, "")                                     remetente sem contato cadastrado (SU5)
  CHAMADOCRIADO (cPara, cIdCh)                                  confirmacao do chamado aberto
  ENCERRADO     (cPara, cIdCh, cAssunto)                        fechado pelo job de 30 dias
aAgenda = {cData, cHmini, cHmfim} do CH_CONSULTA("AGENDA").
@return lOk   .T. se enviou (no DESIGNA, o e-mail do analista)
/*/
Static Function CH_EMAIL(cTipo, cPara, cIdCh, x1, x2, x3, x4)
    Local cAssMail    := ""
    Local cHtml       := ""
    Local aLinhas     := {}
    Local cNumero     := '<span style="color:#1a7fc1">' + cIdCh + '</span>'
    Local cContato    := "Qualquer d&uacute;vida, entre em contato: <b>pericles@apia.com.br</b>"
    // Texto livre -> HTML escapado, quebra de linha vira <br>.
    Local bHtml       := {|c| StrTran(StrTran(U_CNSOUTL("TEXTO", c), CRLF, "<br>"), Chr(10), "<br>")}
    Local cCliente    := ""
    Local aAgenda     := {}
    Local cMotivo     := ""
    Local cPor        := ""
    Local cTexto      := ""
    Local cAcao       := ""
    Local aMudancas   := {}
    Local cCodTec     := ""
    Local lNotCli     := .F.
    Local lNotTec     := .T.
    Local cNomeTec    := ""
    Local cNomeDe     := ""
    Local cEmailCli   := ""
    Local cAssunto    := ""
    Local cDescricao  := ""
    Local cDataPadrao := DToC(Date())
    Local cCliLinha   := ""
    Local nI          := 0

    Do Case
    Case cTipo == "CANCELA" .Or. cTipo == "ENCERRAMENTO"
        cCliente := x1
        aAgenda  := x2
        cMotivo  := x3
        cPor     := x4
        AAdd(aLinhas, {"N&uacute;mero", cNumero})
        AAdd(aLinhas, {"Cliente", Eval(bHtml, cCliente)})
        AAdd(aLinhas, {"Data", aAgenda[1]})
        AAdd(aLinhas, {"Hor&aacute;rio", aAgenda[2] + " &agrave;s " + aAgenda[3]})
        If cTipo == "CANCELA"
            AAdd(aLinhas, {"Alterado por", Eval(bHtml, cPor)})
            cAssMail := "Remocao do Chamado " + cIdCh
            cHtml    := CH_HTMLEMAIL(cIdCh, "Voc&ecirc; foi removido de um chamado", "", ;
                "Este chamado foi designado para outro analista.", ;
                aLinhas, "Motivo", Eval(bHtml, cMotivo), "")
        Else
            AAdd(aLinhas, {"Encerrado por", Eval(bHtml, cPor)})
            cAssMail := "Encerramento do Chamado " + cIdCh
            cHtml    := CH_HTMLEMAIL(cIdCh, "Chamado encerrado", "", ;
                "Este chamado foi encerrado e o agendamento vinculado a ele foi removido.", ;
                aLinhas, "Motivo", Eval(bHtml, cMotivo), "")
        EndIf

    Case cTipo == "DESIGNA"
        cCodTec := x1
        lNotCli := x2
        lNotTec := x3
        If Empty(cCodTec)
            Return .F.
        EndIf
        cNomeTec := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cCodTec, "AA1_NOMTEC"))
        cPara    := AllTrim(Posicione("AA1", 1, xFilial("AA1") + cCodTec, "AA1_EMAIL"))
        // "Designado por" = quem executa a acao (usuario logado), nao o tecnico.
        cNomeDe  := AllTrim(Posicione("AA1", 4, xFilial("AA1") + __cUserId, "AA1_NOMTEC"))
        If Empty(cPara)
            ConOut("CH_EMAIL: tecnico " + cCodTec + " sem AA1_EMAIL cadastrado - e-mail de designacao nao enviado ao tecnico.")
        EndIf
        If CH_ACHARZA1(cIdCh)
            cAssunto   := AllTrim(ZA1->ZA1_ASSUNT)
            cEmailCli  := AllTrim(ZA1->ZA1_EMAIL)
            cDescricao := AllTrim(ZA1->ZA1_ANOT)
            // Cliente vazio: Posicione cairia no 1o registro da SA1.
            cCliente   := If(Empty(ZA1->ZA1_CLIENT), "", AllTrim(Posicione("SA1", 1, xFilial("SA1") + AllTrim(ZA1->ZA1_CLIENT) + AllTrim(ZA1->ZA1_LOJA), "A1_NREDUZ")))
            If ValType(ZA1->ZA1_DATA) == "D" .And. !Empty(ZA1->ZA1_DATA)
                cDataPadrao := DToC(ZA1->ZA1_DATA)
            ElseIf ValType(ZA1->ZA1_DATA) == "C" .And. Len(AllTrim(ZA1->ZA1_DATA)) == 8
                cDataPadrao := DToC(STOD(AllTrim(ZA1->ZA1_DATA)))
            EndIf
        EndIf
        // Horario do agendamento (SZ6) real do chamado.
        aAgenda := CH_CONSULTA("AGENDA", Val(cIdCh), cDataPadrao)

        // Cliente so recebe com ZA1_EMAIL e se pediram notificar.
        If lNotCli .And. !Empty(cEmailCli)
            AAdd(aLinhas, {"N&uacute;mero", cNumero})
            AAdd(aLinhas, {"T&eacute;cnico", Eval(bHtml, cNomeTec)})
            AAdd(aLinhas, {"Assunto", Eval(bHtml, cAssunto)})
            AAdd(aLinhas, {"Data", aAgenda[1]})
            AAdd(aLinhas, {"Hor&aacute;rio", aAgenda[2] + " &agrave;s " + aAgenda[3]})
            CH_ENVIAREMAIL(cEmailCli, "Tecnico Designado - Chamado " + cIdCh, ;
                CH_HTMLEMAIL(cIdCh, "Um t&eacute;cnico foi designado para o seu chamado", "", ;
                    "Seu chamado j&aacute; tem um t&eacute;cnico respons&aacute;vel. Confira os dados do atendimento abaixo.", ;
                    aLinhas, "", "", cContato), "apia@apia.com.br")
            aLinhas := {}
        EndIf

        If lNotTec .And. !Empty(cPara)
            cCliLinha := Eval(bHtml, cCliente)
            If !Empty(cEmailCli)
                cCliLinha += '<br><span style="font-size:13px;font-weight:normal;color:#1a7fc1">' + Eval(bHtml, cEmailCli) + '</span>'
            EndIf
            AAdd(aLinhas, {"N&uacute;mero", cNumero})
            AAdd(aLinhas, {"Cliente", cCliLinha})
            AAdd(aLinhas, {"Assunto", Eval(bHtml, cAssunto)})
            AAdd(aLinhas, {"Data", aAgenda[1]})
            AAdd(aLinhas, {"Hor&aacute;rio", aAgenda[2] + " &agrave;s " + aAgenda[3]})
            AAdd(aLinhas, {"Designado por", Eval(bHtml, cNomeDe)})
            cAssMail := "Chamado Designado " + cIdCh
            cHtml    := CH_HTMLEMAIL(cIdCh, "Voc&ecirc; foi designado para um chamado", Eval(bHtml, cNomeTec), ;
                "Um chamado foi designado para voc&ecirc;. Verifique os dados abaixo e acompanhe o atendimento.", ;
                aLinhas, "Descri&ccedil;&atilde;o", Eval(bHtml, cDescricao), "")
        EndIf

    Case cTipo == "ALTERACAO"
        aMudancas := x1
        AAdd(aLinhas, {"N&uacute;mero", cNumero})
        // De -> Para: valor antigo riscado em cinza, novo em destaque
        For nI := 1 To Len(aMudancas)
            AAdd(aLinhas, {aMudancas[nI][1], ;
                '<span style="color:#9ca3af;font-weight:normal;text-decoration:line-through">' + Eval(bHtml, aMudancas[nI][2]) + '</span>' + ;
                ' &rarr; ' + Eval(bHtml, aMudancas[nI][3])})
        Next nI
        cAssMail := "Chamado Alterado " + cIdCh
        cHtml    := CH_HTMLEMAIL(cIdCh, "Seu chamado foi alterado", "", ;
            "As informa&ccedil;&otilde;es abaixo foram atualizadas no seu chamado.", ;
            aLinhas, "", "", cContato)

    Case cTipo == "INTERACAO"
        cTexto   := x1
        cAcao    := If(Lower(AllTrim(x2)) == "incluida", "inclu&iacute;da", x2)
        AAdd(aLinhas, {"N&uacute;mero", cNumero})
        cAssMail := x3 + " - Chamado " + cIdCh
        cHtml    := CH_HTMLEMAIL(cIdCh, "Uma intera&ccedil;&atilde;o foi " + cAcao + " no seu chamado", "", ;
            "Confira abaixo o texto da intera&ccedil;&atilde;o.", ;
            aLinhas, "Intera&ccedil;&atilde;o", Eval(bHtml, cTexto), cContato)

    Case cTipo == "SEMCONTATO"
        cAssMail := "Seu e-mail nao esta cadastrado"
        cHtml    := CH_HTMLEMAIL("", "N&atilde;o foi poss&iacute;vel abrir um chamado a partir do seu e-mail", "", ;
            "O e-mail <b>" + Eval(bHtml, cPara) + "</b> n&atilde;o est&aacute; cadastrado entre os contatos autorizados a abrir chamados.", ;
            {}, "", "", "Entre em contato com o administrador e informe este e-mail para cadastro: <b>pericles@apia.com.br</b>")

    Case cTipo == "CHAMADOCRIADO"
        AAdd(aLinhas, {"N&uacute;mero", cNumero})
        cAssMail := "Chamado Aberto " + cIdCh
        cHtml    := CH_HTMLEMAIL(cIdCh, "Seu chamado foi aberto com sucesso", "", ;
            "Seu chamado foi aberto a partir do seu e-mail. Em breve nossa equipe entrar&aacute; em contato.", ;
            aLinhas, "", "", cContato)

    Case cTipo == "ENCERRADO"
        cAssunto := x1
        AAdd(aLinhas, {"N&uacute;mero", cNumero})
        AAdd(aLinhas, {"Assunto", Eval(bHtml, cAssunto)})
        cAssMail := "Chamado Encerrado " + cIdCh
        cHtml    := CH_HTMLEMAIL(cIdCh, "Seu chamado foi encerrado", "", ;
            "Seu chamado foi encerrado.", ;
            aLinhas, "", "", cContato)
    EndCase

    If Empty(cHtml)
        Return .F.
    EndIf

Return CH_ENVIAREMAIL(cPara, cAssMail, cHtml, "apia@apia.com.br")

/*/{Protheus.doc} CH_EMAILJAPROCESSADO
Verifica se um e-mail (pelo Id do Graph) ja gerou um chamado, usado como
dedup contra reprocesso no import (CH_CRIARCHAMADOEMAIL).
@param  cMailId   Id do e-mail (Graph)
@return .T. se o e-mail ja gerou chamado (ZA1_MAILID), .F. caso contrario
/*/
Static Function CH_EMAILJAPROCESSADO(cMailId)
    Local lExiste := .F.
    Local cAlias  := GetNextAlias()

    BeginSql Alias cAlias
        SELECT ZA1_IDCH
        FROM %Table:ZA1% ZA1
        WHERE ZA1_FILIAL = %xFilial:ZA1%
          AND ZA1_MAILID = %Exp:cMailId%
          AND %NotDel%
    EndSql

    lExiste := !(cAlias)->(Eof())
    (cAlias)->(DbCloseArea())
Return lExiste

/*/{Protheus.doc} CH_BUSCARCLIENTE
Cliente (SA1) do e-mail, so por contato cadastrado (SU5 -> AC8); confere cada e-mail da lista do contato.
@param  cEmail   E-mail do remetente
@return Array {cCod, cLoja} do cliente encontrado (vazio se nao encontrado)
/*/
Static Function CH_BUSCARCLIENTE(cEmail)
    Local cAlias   := GetNextAlias()
    Local cCod     := ""
    Local cLoja    := ""
    Local cContat  := ""

    cEmail := Upper(AllTrim(cEmail))

    If Empty(cEmail)
        Return {"", ""}
    EndIf

    // Candidatos por LIKE ("%" no SQL, nunca no %Exp%); confirmacao exata e-mail a e-mail (CH_EMAILNALISTA).
    BeginSql Alias cAlias
        SELECT U5_CODCONT, U5_EMAIL
        FROM %Table:SU5% SU5
        WHERE U5_FILIAL = %xFilial:SU5%
          AND Upper(U5_EMAIL) LIKE '%' || %Exp:cEmail% || '%'
          AND %NotDel%
    EndSql
    While !(cAlias)->(Eof())
        If CH_EMAILNALISTA(cEmail, (cAlias)->U5_EMAIL)
            cContat := AllTrim((cAlias)->U5_CODCONT)
            Exit
        EndIf
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

    If Empty(cContat)
        Return {"", ""}
    EndIf

    cAlias := GetNextAlias()
    BeginSql Alias cAlias
        SELECT AC8_CODENT
        FROM %Table:AC8% AC8
        WHERE AC8_FILIAL = %xFilial:AC8%
          AND AC8_CODCON = %Exp:cContat%
          AND AC8_ENTIDA = 'SA1'
          AND %NotDel%
    EndSql
    // AC8_CODENT = A1_COD + A1_LOJA, nos tamanhos do dicionario.
    If !(cAlias)->(Eof())
        cCod  := AllTrim(Left((cAlias)->AC8_CODENT, TamSX3("A1_COD")[1]))
        cLoja := AllTrim(SubStr((cAlias)->AC8_CODENT, TamSX3("A1_COD")[1] + 1, TamSX3("A1_LOJA")[1]))
    EndIf

    (cAlias)->(DbCloseArea())

Return {cCod, cLoja}

/*/{Protheus.doc} CH_EMAILNALISTA
O e-mail esta na lista do contato (U5_EMAIL, separada por ";" ou ",")? Comparacao exata, sem caixa/espacos.
@param  cEmail   E-mail procurado (remetente)
@param  cLista   Conteudo do campo de e-mail do contato
@return .T. se algum e-mail da lista for igual ao procurado
/*/
Static Function CH_EMAILNALISTA(cEmail, cLista)
    Local aEmails := StrTokArr2(StrTran(AllTrim(cLista), ",", ";"), ";", .F.)
    Local nI      := 0

    cEmail := Upper(AllTrim(cEmail))

    For nI := 1 To Len(aEmails)
        If Upper(AllTrim(aEmails[nI])) == cEmail
            Return .T.
        EndIf
    Next nI

Return .F.

/*/{Protheus.doc} CH_AVISOJAENVIADO
Aviso de "e-mail nao cadastrado" ja enviado ao endereco nos ultimos 7 dias? (\system\cnsa_email_semcontato.dat)
@param  cEmail   Endereco do remetente
@return .T. se ja avisou ha menos de 7 dias, .F. caso contrario
/*/
Static Function CH_AVISOJAENVIADO(cEmail)
    Local cArq   := "\system\cnsa_email_semcontato.dat"
    Local cChave := "|" + Lower(AllTrim(cEmail)) + "|"
    Local cTexto := ""
    Local nPos   := 0
    Local dUlt   := CToD("")

    If !File(cArq)
        Return .F.
    EndIf

    // Ultimo aviso = ultima ocorrencia do endereco no arquivo (gravado em ordem).
    cTexto := MemoRead(cArq)
    nPos   := RAt(cChave, cTexto)
    If nPos > 0
        dUlt := SToD(SubStr(cTexto, nPos + Len(cChave), 8))
    EndIf

Return !Empty(dUlt) .And. Date() - dUlt < 7

/*/{Protheus.doc} CH_MARCARAVISOENVIADO
Registra o aviso de hoje no arquivo do CH_AVISOJAENVIADO.
@param  cEmail   Endereco do remetente
/*/
Static Function CH_MARCARAVISOENVIADO(cEmail)
    Local cArq    := "\system\cnsa_email_semcontato.dat"
    Local aLinhas := StrTokArr2(If(File(cArq), MemoRead(cArq), ""), CRLF, .F.)
    Local cTexto  := ""
    Local nI      := 0

    AAdd(aLinhas, "|" + Lower(AllTrim(cEmail)) + "|" + DToS(Date()) + "|")
    // So as ultimas 500 linhas (o arquivo crescia sem fim e e lido inteiro no CH_AVISOJAENVIADO).
    For nI := Max(1, Len(aLinhas) - 499) To Len(aLinhas)
        cTexto += aLinhas[nI] + CRLF
    Next nI
    MemoWrite(cArq, cTexto)

Return

/*/{Protheus.doc} CH_CRIARCHAMADOEMAIL
Le os e-mails nao lidos de apia@ (Graph) e cria um chamado por e-mail novo (dedup por ZA1_MAILID); marca
como lido o que tratou. Chamado pelo job, pelo Recarregar do portal e pela tela (CH_TRAVAREMAIL: um por vez).
@return nCriados   Quantidade de chamados criados (-1 em falha de token/Graph)
/*/
Static Function CH_CRIARCHAMADOEMAIL()
    Local cToken := ""
    Local oRest, oJson, oArr, oMsg, oFrom, oEnd
    Local cPath, cId, cAssunto, cNome, cEmail, cNewId
    Local nI, nCriados := 0
    Local aCliente   := {}
    Local cCodCli    := ""
    Local cLojaCli   := ""
    Local cCorpo     := ""
    Local oBody      := Nil
    Local aResultado := {}
    Local nLock      := -1
    Local aLido      := {}
    // Marca o e-mail como lido (Graph, Mail.ReadWrite) - mesma chamada HTTP do Outlook (cnslib).
    Local bLido      := {|c| aLido := U_CNSOUTL("HTTP", "PATCH", "https://graph.microsoft.com/v1.0/users/apia@apia.com.br/messages/" + ;
                            StrTran(StrTran(StrTran(c, "/", "%2F"), "+", "%2B"), "=", "%3D"), '{"isRead":true}'), ;
                            If(aLido[1] == 200, Nil, ConOut("CH_CRIARCHAMADOEMAIL: nao marcou como lido (" + cValToChar(aLido[1]) + "): " + aLido[2]))}

    // Outra importacao ainda rodando: pula esta (a outra ja le a caixa).
    nLock := CH_TRAVAREMAIL()
    If nLock == -1
        ConOut("CH_CRIARCHAMADOEMAIL: outra importacao em andamento - leitura pulada.")
        Return 0
    EndIf

    cToken := U_CNSOUTL("TOKEN")
    If Empty(cToken)
        CH_DESTRAVAREMAIL(nLock)
        Return -1
    EndIf

    cPath := "/v1.0/users/apia@apia.com.br/mailFolders/inbox/messages"
    cPath += "?$filter=isRead%20eq%20false"
    cPath += "&$select=id,subject,from,receivedDateTime,body"
    cPath += "&$orderby=receivedDateTime%20desc"
    cPath += "&$top=50"

    oRest := FWRest():New("https://graph.microsoft.com")
    oRest:setPath(cPath)
    If !oRest:Get({"Authorization: Bearer " + cToken, "Accept: application/json", 'Prefer: outlook.body-content-type="text"'})
        ConOut("CH_CRIARCHAMADOEMAIL: falha no GET de mensagens (Graph): " + oRest:GetLastError())
        CH_DESTRAVAREMAIL(nLock)
        Return -1
    EndIf

    oJson := JsonObject():New()
    If !Empty(oJson:FromJson(oRest:GetResult()))
        ConOut("CH_CRIARCHAMADOEMAIL: resposta do Graph invalida: " + oRest:GetResult())
        FreeObj(oJson)
        CH_DESTRAVAREMAIL(nLock)
        Return -1
    EndIf

    oArr := oJson:GetJsonObject("value")
    If ValType(oArr) <> "A"
        FreeObj(oJson)
        CH_DESTRAVAREMAIL(nLock)
        Return -1
    EndIf

    For nI := 1 To Len(oArr)
        oMsg     := oArr[nI]
        cId      := ""
        cAssunto := "(sem assunto)"
        cNome    := ""
        cEmail   := ""
        cCodCli  := ""
        cLojaCli := ""
        cCorpo   := ""
        oBody    := Nil

        If ValType(oMsg:GetJsonObject("id")) == "C"
            cId := oMsg:GetJsonObject("id")
        EndIf

        If ValType(oMsg:GetJsonObject("subject")) == "C"
            cAssunto := U_CNSOUTL("UTF8", oMsg:GetJsonObject("subject"))
            cAssunto := AllTrim(cAssunto)
            While .T.
                If Upper(Left(cAssunto, 4)) == "RES:" .Or. Upper(Left(cAssunto, 4)) == "ENC:" .Or. Upper(Left(cAssunto, 4)) == "FWD:"
                    cAssunto := AllTrim(SubStr(cAssunto, 5))
                ElseIf Upper(Left(cAssunto, 3)) == "RE:" .Or. Upper(Left(cAssunto, 3)) == "FW:"
                    cAssunto := AllTrim(SubStr(cAssunto, 4))
                Else
                    Exit
                EndIf
            EndDo
        EndIf

        oBody := oMsg:GetJsonObject("body")
        If ValType(oBody) $ "O|J" .And. ValType(oBody:GetJsonObject("content")) == "C"
            cCorpo := U_CNSOUTL("UTF8", oBody:GetJsonObject("content"))
            cCorpo := AllTrim(cCorpo)
        EndIf

        oFrom := Nil
        oEnd  := Nil
        oFrom := oMsg:GetJsonObject("from")
        If ValType(oFrom) $ "O|J"
            oEnd := oFrom:GetJsonObject("emailAddress")
            If ValType(oEnd) $ "O|J"
                If ValType(oEnd:GetJsonObject("name")) == "C"
                    cNome := oEnd:GetJsonObject("name")
                EndIf
                If ValType(oEnd:GetJsonObject("address")) == "C"
                    cEmail := oEnd:GetJsonObject("address")
                EndIf
                aCliente := CH_BUSCARCLIENTE(cEmail)
                cCodCli  := aCliente[1]
                cLojaCli := aCliente[2]
            EndIf
        EndIf

        If Empty(cId)
            Loop
        EndIf

        If CH_EMAILJAPROCESSADO(cId)
            Eval(bLido, cId)
            Loop
        EndIf

        // Anti-loop: nunca responde a si mesmo, a remetente de sistema nem a resposta automatica.
        If "apia@apia.com.br" $ Lower(cEmail) .Or. "postmaster" $ Lower(cEmail) .Or. ;
                "mailer-daemon" $ Lower(cEmail) .Or. "noreply" $ Lower(cEmail) .Or. "no-reply" $ Lower(cEmail) .Or. ;
                "microsoftexchange" $ Lower(cEmail) .Or. ;
                CH_EHRESPOSTAAUTO(cAssunto)
            ConOut("CH_CRIARCHAMADOEMAIL: e-mail ignorado (anti-loop) de " + cEmail + " - " + cAssunto)
            Eval(bLido, cId)
            Loop
        EndIf

        // Sem contato cadastrado (SU5): nao abre chamado - avisa o remetente no maximo 1 vez a cada 7 dias.
        If Empty(cCodCli)
            If !Empty(cEmail) .And. !CH_AVISOJAENVIADO(cEmail)
                CH_EMAIL("SEMCONTATO", cEmail, "")
                CH_MARCARAVISOENVIADO(cEmail)
            EndIf
            ConOut("CH_CRIARCHAMADOEMAIL: e-mail " + cEmail + " nao cadastrado em SU5 (contatos) - chamado nao criado.")
            Eval(bLido, cId)
            Loop
        EndIf

        // Mesmo nucleo do Incluir; nasce sem tipo/projeto/tarefa e sem tecnico.
        aResultado := CH_NUCLEOINCLUIR(cAssunto, DTOS(Date()), "", ;
            cCodCli, cLojaCli, ;
            cEmail, "", "", "", cId, .F.)

        If aResultado[1] != 200
            ConOut("CH_CRIARCHAMADOEMAIL: falha ao criar chamado do e-mail " + cId + ": " + aResultado[2])
            Loop
        EndIf

        cNewId := aResultado[3]

        // ZA2_DESCRI e Memo (TamSX3 = 10 e o ponteiro): texto completo.
        If !Empty(cCorpo)
            CH_GRAVARINTERACAO(cNewId, "", cCorpo)
        EndIf

        // Confirma ao cliente o numero do chamado aberto.
        If !Empty(cEmail)
            CH_EMAIL("CHAMADOCRIADO", cEmail, cNewId)
        EndIf
        Eval(bLido, cId)

        nCriados++
    Next nI

    FreeObj(oJson)
    CH_DESTRAVAREMAIL(nLock)
Return nCriados

/*/{Protheus.doc} CH_EHRESPOSTAAUTO
Assunto de resposta automatica/devolucao (ausencia, nao entregue) - o job
nao responde nem abre chamado para esses e-mails (anti-loop).
@param  cAssunto  Assunto do e-mail
@return .T. se for resposta automatica
/*/
Static Function CH_EHRESPOSTAAUTO(cAssunto)
    Local cAss  := Upper(FwNoAccent(AllTrim(cAssunto)))
    Local aTerm := {"RESPOSTA AUTOMATICA", "AUTOMATIC REPLY", "AUTO-REPLY", "AUTOREPLY", "FORA DO ESCRITORIO", ;
                    "OUT OF OFFICE", "UNDELIVERABLE", "NAO E POSSIVEL ENTREGAR", "NAO FOI POSSIVEL ENTREGAR", ;
                    "DELIVERY STATUS", "MAIL DELIVERY", "RETORNADO", "SEU E-MAIL NAO ESTA CADASTRADO", "CHAMADO ABERTO", ;
                    "APROVACAO DA ORDEM DE SERVICO", "APROVADA O.S.", "RECUSADA O.S."}
    Local nI    := 0

    For nI := 1 To Len(aTerm)
        If aTerm[nI] $ cAss
            Return .T.
        EndIf
    Next nI

Return .F.

/*/{Protheus.doc} CH_TRAVAREMAIL
Trava exclusiva (arquivo) da importacao de e-mail; espera ate ~10 s (50 x 200 ms) pela outra importacao.
@return nHandle   Handle do arquivo travado - usar em CH_DESTRAVAREMAIL (-1 = nao travou)
/*/
Static Function CH_TRAVAREMAIL()
    Local cArqLock := "\system\cnsa_email_import.lck"
    Local nHandle  := -1
    Local nI       := 0

    If !File(cArqLock)
        nHandle := FCreate(cArqLock)
        If nHandle != -1
            FClose(nHandle)
        EndIf
    EndIf

    nHandle := FOpen(cArqLock, FO_READWRITE + FO_EXCLUSIVE)
    While nHandle == -1 .And. nI < 50
        Sleep(200)
        nHandle := FOpen(cArqLock, FO_READWRITE + FO_EXCLUSIVE)
        nI++
    EndDo

Return nHandle

/*/{Protheus.doc} CH_DESTRAVAREMAIL
Libera a trava obtida em CH_TRAVAREMAIL.
@param  nHandle   Handle devolvido por CH_TRAVAREMAIL
/*/
Static Function CH_DESTRAVAREMAIL(nHandle)
    If nHandle != Nil .And. nHandle != -1
        FClose(nHandle)
    EndIf
Return

/*/{Protheus.doc} CH_APIVERIFICAEMAIL
GET /CNSACHAMADOSVERIFICAREMAIL - le a caixa de e-mail agora (botao Recarregar do portal).
@return Logical - resposta HTTP com a quantidade de chamados criados
/*/
@Get(endpoint="/CNSACHAMADOSVERIFICAREMAIL")
User Function CH_APIVERIFICAEMAIL() As Logical
    Local oJson    := JsonObject():New()
    Local nCriados := 0

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Usuario de servico (pagina do cliente) so acessa /CNSAAPROVA.
    If U_CNSSERVICO()
        Return oRest:setStatusResponse(403, CH_ERRO("Usuario sem acesso a este recurso."))
    EndIf

    nCriados := CH_CRIARCHAMADOEMAIL()

    If nCriados < 0
        oJson['sucesso'] := .F.
        oJson['erro']    := "Falha ao consultar a caixa de e-mail (token/Graph)."
        Return oRest:setStatusResponse(500, oJson:ToJson())
    EndIf

    oJson['sucesso'] := .T.
    oJson['criados']  := nCriados

Return oRest:setStatusResponse(200, oJson:ToJson())

/*/{Protheus.doc} CH_JOBEMAIL
Schedule: importa os e-mails novos da caixa apia@ (CH_CRIARCHAMADOEMAIL).
/*/
User Function CH_JOBEMAIL()
    Local cEmpAnt   := "01"
    Local cFilAnt   := "01"
    Local nCriados  := 0
    Local oErro     := Nil
    Local bErro     := Nil

    RpcSetType(3)
    If !RpcSetEnv(cEmpAnt, cFilAnt, , , "SIGAFAT", , {"ZA1"})
        ConOut("CH_JOBEMAIL: falha no RpcSetEnv - job abortado.")
        Return
    EndIf

    bErro := ErrorBlock({|e| Break(e)})
    Begin Sequence
        nCriados := CH_CRIARCHAMADOEMAIL()
    Recover Using oErro
        ConOut("CH_JOBEMAIL: erro durante execucao: " + oErro:Description)
    End Sequence
    ErrorBlock(bErro)

    ConOut("CH_JOBEMAIL: " + AllTrim(Str(nCriados)) + " chamado(s) criado(s) a partir de e-mail(s) novo(s) em apia@apia.com.br.")

    RpcClearEnv()

Return

/*/{Protheus.doc} CH_HTMLPUB
Layout de e-mail (CH_HTMLEMAIL) para fora do namespace - cnslib e CNSA004.
/*/
User Function CH_HTMLPUB(cIdCh, cAlerta, cNome, cIntro, aLinhas, cTituloTexto, cTexto, cObs)
Return CH_HTMLEMAIL(cIdCh, cAlerta, cNome, cIntro, aLinhas, cTituloTexto, cTexto, cObs)

/*/{Protheus.doc} CH_MAILPUB
Envio via Graph (CH_ENVIAREMAIL) para fora do namespace - cnslib e CNSA004.
/*/
User Function CH_MAILPUB(cPara, cAssunto, cCorpo)
Return CH_ENVIAREMAIL(cPara, cAssunto, cCorpo, "apia@apia.com.br")
