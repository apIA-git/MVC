#include "PROTHEUS.CH"
#include "TOPCONN.CH"
#include "TOTVS.CH"
#include "tlpp-core.th"
#INCLUDE 'tlpp-rest.th'


@Get(endpoint="/CNSLIBCOMPONENTES")
User Function CNS001_COMPONENTES_LISTAR() As Logical
    Local jQuery        := oRest:getQueryRequest() As Json
    Local cTipoParam    := ""
    Local cFiltroParam  := ""
    Local cProjetoParam := ""
    Local cClienteParam := ""
    Local cLojaParam    := ""
    Local aAgendaParam  := {}
    Local aItens        := {}
    Local cItensJson    := ""
    Local cResposta     := ""
    Local nI            := 0
    Local oErro         := Nil

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    Begin Sequence

        // Busca por nome acentuado (ex "Joao") - DecodeUTF8 no filtro digitado
        // antes de montar o LIKE - mesmo tratamento ANSI/UTF-8 do restante do app.
        cTipoParam    := Lower(AllTrim(CNS001_LUPA_JSONSTR(jQuery,"tipo")))
        cFiltroParam  := CNS001_LUPA_DECODESAFE(AllTrim(CNS001_LUPA_JSONSTR(jQuery,"filtro")))
        // "?" (acento que chegou mal decodificado), acento ou apostrofo no filtro
        // quebrava o %Exp% do BeginSql: o "?" vira placeholder de bind e a query
        // sai corrompida (ORA-00907, ex: motivo "COORDENAC?O"). Vira "_" (curinga
        // de 1 caractere no LIKE), que continua achando com ou sem acento.
        cFiltroParam  := CNS001_LUPA_FILTROSQL(cFiltroParam)
        cProjetoParam := AllTrim(CNS001_LUPA_JSONSTR(jQuery,"projeto"))
        cClienteParam := AllTrim(CNS001_LUPA_JSONSTR(jQuery,"cliente"))
        cLojaParam    := AllTrim(CNS001_LUPA_JSONSTR(jQuery,"lojaCliente"))
        // Lupa de Cod Servico: dados da OS pra achar o agendamento (Nao Cobrar).
        aAgendaParam  := {AllTrim(CNS001_LUPA_JSONSTR(jQuery,"tecnico")), ;
                          StrTran(AllTrim(CNS001_LUPA_JSONSTR(jQuery,"data")), "-", ""), ;
                          AllTrim(CNS001_LUPA_JSONSTR(jQuery,"horaInicial")), ;
                          AllTrim(CNS001_LUPA_JSONSTR(jQuery,"horaFinal"))}

        Do Case
            Case cTipoParam == "tecnico"
                aItens := CNS001_TECLUPA(cFiltroParam)
            Case cTipoParam == "cliente"
                aItens := CNS001_CLILUPA(cFiltroParam)
            Case cTipoParam == "projeto"
                If Empty(cClienteParam)
                    Return oRest:setStatusResponse(400, '{"resultado":false,"erro":"Informe o cliente (?cliente=000001) antes de buscar o projeto."}')
                EndIf
                aItens := CNS001_PROJLUPA(cFiltroParam, cClienteParam, If(Empty(cLojaParam), "01", cLojaParam))
            Case cTipoParam == "tarefa"
                If Empty(cProjetoParam)
                    Return oRest:setStatusResponse(400, '{"resultado":false,"erro":"Informe o projeto (?projeto=000001) antes de buscar a tarefa."}')
                EndIf
                aItens := CNS001_TARLUPA(cFiltroParam, cProjetoParam)
            Case cTipoParam == "modulo"
                aItens := CNS001_MODULUPA(cFiltroParam)
            Case cTipoParam == "motivo"
                aItens := CNS001_MOTIVLUPA(cFiltroParam)
            Case cTipoParam == "servico"
                // Cliente/loja: so os servicos do cliente (SA7 - Produto x Cliente).
                aItens := CNS001_SERVLUPA(cFiltroParam, cClienteParam, cLojaParam, aAgendaParam)
            Case cTipoParam == "proposta"
                If Empty(cClienteParam)
                    Return oRest:setStatusResponse(400, '{"resultado":false,"erro":"Informe o cliente (?cliente=000001) antes de buscar a proposta."}')
                EndIf
                aItens := CNS001_PROPLUPA(cFiltroParam, cClienteParam, If(Empty(cLojaParam), "01", cLojaParam))
            Case cTipoParam == "chamado"
                // Cliente opcional: a OS pode vincular o chamado antes de escolher o cliente.
                aItens := CNS001_CHAMLUPA(cFiltroParam, cClienteParam, If(Empty(cLojaParam), "01", cLojaParam))
            OtherWise
                Return oRest:setStatusResponse(400, '{"resultado":false,"erro":"Informe um tipo valido (?tipo=tecnico, cliente, projeto, tarefa, modulo, motivo, servico, proposta ou chamado)."}')
        EndCase

        // Monta o array "items" na mao (nao aninha JsonObject dentro de
        // JsonObject) - funciona igual com 0, 1 ou N linhas.
        cItensJson := "["
        For nI := 1 To Len(aItens)
            If nI > 1
                cItensJson += ","
            EndIf
            cItensJson += aItens[nI]:ToJson()
        Next nI
        cItensJson += "]"

        cResposta := '{"resultado":' + If(Len(aItens) > 0, "true", "false") + ',"items":' + cItensJson + '}'

        Return oRest:setStatusResponse(200, cResposta)

    Recover Using oErro
        If oErro != Nil
            Return oRest:setStatusResponse(500, '{"resultado":false,"erro":"' + CNS001_LUPA_JSONESC(oErro:Description) + '"}')
        EndIf
    End Sequence

Return oRest:setStatusResponse(500, '{"resultado":false,"erro":"Erro desconhecido."}')

////////////////////////////////////////////////////////////////////////////////
//                                                                            //
//                 LUPAS COMPARTILHADAS - tecnico/cliente/projeto/tarefa     //
//                                                                            //
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// Erro na query propaga sozinho pro Recover do @Get (que monta o 500 com
// a descricao real) - nao precisa de Begin/Recover proprio aqui.
////////////////////////////////////////////////////////////////////////////////
Static Function CNS001_TECLUPA(cFiltro)
    Local aRet    := {}
    Local oLinha  := Nil
    Local cAlias  := GetNextAlias()
    // Oracle e case-sensitive em LIKE por padrao - UPPER() nos dois lados
    // (coluna e valor) resolve "joao" batendo com "JOAO SILVA" cadastrado
    // em maiusculo.
    // FIX (ORA-00936 com filtro vazio): passar o valor JA com "%" embutido
    // via %Exp:cLike% saia em branco na query gerada (SQL virava "LIKE OR
    // LIKE", sem valor) - o "%" DENTRO do valor colide com o delimitador de
    // macro do BeginSql (%Exp:%, %Table:%...). Fix: o valor que vai pro
    // %Exp:% NUNCA contem "%" - o wildcard e montado no proprio SQL via
    // concatenacao ('%' || valor).
    Local cFiltroUp  := Upper(cFiltro)
    Local cFiltroUp2 := cFiltroUp

    BeginSql Alias cAlias
        SELECT AA1_CODTEC,
            AA1_NOMTEC,
            AA1_RSPMNT,
            USR_CODIGO
        FROM %Table:AA1% AA1
        LEFT JOIN SYS_USR USR
            ON AA1_CODUSR = USR_ID
            AND USR.%NotDel%
        WHERE AA1_FILIAL = %xFilial:AA1%
        AND AA1.%NotDel%
        AND (UPPER(AA1_CODTEC) LIKE '%' || %Exp:cFiltroUp% || '%'
        OR UPPER(AA1_NOMTEC) LIKE '%' || %Exp:cFiltroUp2% || '%')
        ORDER BY AA1_NOMTEC
    EndSql

    While !(cAlias)->(Eof())
        oLinha := JsonObject():New()
        oLinha['codigo']     := CNS001_LUPA_COMPSTR((cAlias)->AA1_CODTEC)
        oLinha['complemento'] := ""
        oLinha['descricao']  := CNS001_LUPA_COMPSTR((cAlias)->AA1_NOMTEC)
        oLinha['rspmnt']     := CNS001_LUPA_COMPSTR((cAlias)->AA1_RSPMNT)
        oLinha['usrCodigo']  := CNS001_LUPA_COMPSTR((cAlias)->USR_CODIGO)

        AAdd(aRet, oLinha)
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

Return aRet

////////////////////////////////////////////////////////////////////////////////
Static Function CNS001_CLILUPA(cFiltro)
    Local aRet    := {}
    Local oLinha  := Nil
    Local cAlias  := GetNextAlias()
    // Idem CNS001_TECLUPA - UPPER() case-insensitive, wildcard montado no SQL
    // via concatenacao (ver FIX ORA-00936 no comentario de CNS001_TECLUPA).
    Local cFiltroUp  := Upper(cFiltro)
    Local cFiltroUp2 := cFiltroUp

    BeginSql Alias cAlias
        SELECT A1_COD, A1_LOJA, A1_NOME, A1_NREDUZ, A1_CONTATO, A1_EMAIL
        FROM %Table:SA1% SA1
        WHERE A1_FILIAL = %xFilial:SA1%
          AND %NotDel%
          AND (UPPER(A1_COD) LIKE '%' || %Exp:cFiltroUp% || '%' OR UPPER(A1_NOME) LIKE '%' || %Exp:cFiltroUp2% || '%' OR UPPER(A1_NREDUZ) LIKE '%' || %Exp:cFiltroUp2% || '%')
        ORDER BY A1_NOME
    EndSql

    While !(cAlias)->(Eof())
        oLinha := JsonObject():New()
        oLinha['codigo']      := CNS001_LUPA_COMPSTR((cAlias)->A1_COD)
        oLinha['complemento'] := CNS001_LUPA_COMPSTR((cAlias)->A1_LOJA)
        oLinha['descricao']   := CNS001_LUPA_COMPSTR((cAlias)->A1_NOME)
        // Nome reduzido (A1_NREDUZ) - mesmo nome que o chamado mostra (ZA1_NOME).
        oLinha['nomeReduzido'] := CNS001_LUPA_COMPSTR((cAlias)->A1_NREDUZ)
        // Representante da empresa (A1_CONTATO) - pre-preenche o Usuario (Z1_USR) da OS.
        oLinha['contato']      := CNS001_LUPA_COMPSTR((cAlias)->A1_CONTATO)
        // E-mail do cliente (A1_EMAIL) - pre-preenche o Email Cliente (ZA1_EMAIL) do chamado.
        oLinha['email']        := CNS001_LUPA_COMPSTR((cAlias)->A1_EMAIL)
        AAdd(aRet, oLinha)
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

Return aRet

////////////////////////////////////////////////////////////////////////////////
// Lupa de Projeto (AF8) - campos confirmados por Henrique (print do
// dicionario SX3): AF8_PROJET (codigo), AF8_DESCRI (descricao). Devolve
// tambem AF8_REVISA (versao/revisao do projeto) no campo "complemento" - o
// front nao precisa exibir isso, mas o CNS001_TARLUPA abaixo usa a mesma
// logica de revisao mais recente, entao deixamos disponivel caso o front
// queira mostrar no futuro.
//
// FIX (filtro por empresa/status - confirmado por Henrique): so mostra
// projetos do cliente selecionado (AF8_CLIENT + AF8_LOJA) e SO os ativos
// (AF8_FASE = "03"). cCliente/cLoja SEMPRE preenchidos aqui (@Get ja
// bloqueia tipo=projeto sem cliente antes de chegar nesta funcao).
////////////////////////////////////////////////////////////////////////////////
Static Function CNS001_PROJLUPA(cFiltro, cCliente, cLoja)
    Local aRet    := {}
    Local oLinha  := Nil
    Local cAlias  := GetNextAlias()
    // Idem CNS001_TECLUPA - UPPER() case-insensitive, wildcard montado no SQL
    // via concatenacao (ver FIX ORA-00936 no comentario de CNS001_TECLUPA).
    Local cFiltroUp  := Upper(cFiltro)
    Local cFiltroUp2 := cFiltroUp

    BeginSql Alias cAlias
        SELECT AF8_PROJET, AF8_DESCRI, AF8_REVISA
        FROM %Table:AF8% AF8
        WHERE AF8_FILIAL = %xFilial:AF8%
          AND %NotDel%
          AND AF8_CLIENT = %Exp:cCliente%
          AND AF8_LOJA   = %Exp:cLoja%
          AND AF8_FASE   = '03'
          AND (UPPER(AF8_PROJET) LIKE '%' || %Exp:cFiltroUp% || '%' OR UPPER(AF8_DESCRI) LIKE '%' || %Exp:cFiltroUp2% || '%')
        ORDER BY AF8_DESCRI
    EndSql

    While !(cAlias)->(Eof())
        oLinha := JsonObject():New()
        oLinha['codigo']      := CNS001_LUPA_COMPSTR((cAlias)->AF8_PROJET)
        oLinha['complemento'] := CNS001_LUPA_COMPSTR((cAlias)->AF8_REVISA)
        oLinha['descricao']   := CNS001_LUPA_COMPSTR((cAlias)->AF8_DESCRI)
        AAdd(aRet, oLinha)
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

Return aRet

////////////////////////////////////////////////////////////////////////////////
// Lupa de Tarefa (AF9) - SEMPRE filtrada por projeto (AF9_PROJET),
// confirmado por Henrique: a tarefa e sempre filha de um projeto especifico.
// campos: AF9_TAREFA (codigo), AF9_DESCRI (descricao).
//
// SIMPLIFICACAO ASSUMIDA (Henrique, confere): a AF9 tambem tem AF9_REVISA
// (o projeto pode ter mais de uma revisao/versao, cada uma com seu proprio
// conjunto de tarefas) - aqui NAO filtramos por revisao, trazemos todas as
// tarefas do projeto independente da versao.
////////////////////////////////////////////////////////////////////////////////
Static Function CNS001_TARLUPA(cFiltro, cProjeto)
    Local aRet    := {}
    Local oLinha  := Nil
    Local cAlias  := GetNextAlias()
    // Idem CNS001_TECLUPA - UPPER() case-insensitive, wildcard montado no SQL
    // via concatenacao (ver FIX ORA-00936 no comentario de CNS001_TECLUPA).
    Local cFiltroUp  := Upper(cFiltro)
    Local cFiltroUp2 := cFiltroUp

    BeginSql Alias cAlias
        SELECT AF9_TAREFA, AF9_DESCRI
        FROM %Table:AF9% AF9
        WHERE AF9_FILIAL = %xFilial:AF9%
          AND %NotDel%
          AND AF9_PROJET = %Exp:cProjeto%
          AND (UPPER(AF9_TAREFA) LIKE '%' || %Exp:cFiltroUp% || '%' OR UPPER(AF9_DESCRI) LIKE '%' || %Exp:cFiltroUp2% || '%')
        ORDER BY AF9_TAREFA
    EndSql

    While !(cAlias)->(Eof())
        oLinha := JsonObject():New()
        oLinha['codigo']      := CNS001_LUPA_COMPSTR((cAlias)->AF9_TAREFA)
        oLinha['complemento'] := ""
        oLinha['descricao']   := CNS001_LUPA_COMPSTR((cAlias)->AF9_DESCRI)
        AAdd(aRet, oLinha)
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

Return aRet

////////////////////////////////////////////////////////////////////////////////
//                                                                            //
//               LUPAS EXCLUSIVAS DO POUIOS (modulo/motivo/servico/proposta) //
//                                                                            //
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// Lupa de Modulo (SX5 generica, tipo "Z2") - usada no campo Z1_MODULO da OS
// (pouios). Confirmado via "Visualizar Campo - Z1_MODULO" no dicionario:
// Cons. Padrao "Z2 - Modulos Para Os's".
////////////////////////////////////////////////////////////////////////////////
Static Function CNS001_MODULUPA(cFiltro)
Return CNS001_GENERICALUPA(cFiltro, "Z2")

////////////////////////////////////////////////////////////////////////////////
// Lupa de Motivo (SX5 generica, tipo "Z1") - usada no campo Z1_MOTIV da OS
// (pouios). Confirmado via "Visualizar Campo - Z1_MOTIV": Cons. Padrao
// "Z1 - Motivos de Os's".
////////////////////////////////////////////////////////////////////////////////
Static Function CNS001_MOTIVLUPA(cFiltro)
Return CNS001_GENERICALUPA(cFiltro, "Z1")

////////////////////////////////////////////////////////////////////////////////
// Consulta comum as tabelas genericas (SX5) - Modulo e Motivo da OS
// compartilham o mesmo formato (X5_CHAVE/X5_DESCRI), so muda X5_TABELA.
////////////////////////////////////////////////////////////////////////////////
Static Function CNS001_GENERICALUPA(cFiltro, cTabelaX5)
    Local aRet    := {}
    Local oLinha  := Nil
    Local cAlias  := GetNextAlias()
    Local cFiltroUp  := Upper(cFiltro)
    Local cFiltroUp2 := cFiltroUp

    BeginSql Alias cAlias
        SELECT X5_CHAVE, X5_DESCRI
        FROM %Table:SX5% SX5
        WHERE X5_FILIAL = %xFilial:SX5%
          AND %NotDel%
          AND X5_TABELA = %Exp:cTabelaX5%
          AND (UPPER(X5_CHAVE) LIKE '%' || %Exp:cFiltroUp% || '%' OR UPPER(X5_DESCRI) LIKE '%' || %Exp:cFiltroUp2% || '%')
        ORDER BY X5_DESCRI
    EndSql

    While !(cAlias)->(Eof())
        oLinha := JsonObject():New()
        oLinha['codigo']      := CNS001_LUPA_COMPSTR((cAlias)->X5_CHAVE)
        oLinha['complemento'] := ""
        oLinha['descricao']   := CNS001_LUPA_COMPSTR((cAlias)->X5_DESCRI)
        AAdd(aRet, oLinha)
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

Return aRet

////////////////////////////////////////////////////////////////////////////////
// Lupa de Servico (SB1 - Produto) - usada nos campos Z1_TIPO/Z1_NMTIPO
// ("Cod Servico") da OS (pouios). Confirmado via "Visualizar Campo -
// Z1_TIPO": Cons. Padrao "SB1 - Produto".
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
// Lupa de Cod Servico (Z1_TIPO da OS).
// Henrique - 05/10/2026 - antes trazia TODOS os produtos da SB1 (query antiga
//   comentada abaixo). Agora:
//   - com cliente: so os servicos do cliente selecionado - SA7 (Produto x
//     Cliente) + SB1/SBM (grupo) + VE1 (marca), marca BM_CODMAR = '005';
//   - sem cliente: catalogo SB1 + grupo (SBM) + marca (VE1).
//   Selects passados pelo usuario, adaptados ao BeginSql (filial, %NotDel%,
//   filtro da caixa de pesquisa).
////////////////////////////////////////////////////////////////////////////////
Static Function CNS001_SERVLUPA(cFiltro, cCliente, cLoja, aAgenda)
    Local aRet    := {}
    Local oLinha  := Nil
    Local cAlias  := GetNextAlias()
    Local cFiltroUp  := Upper(cFiltro)
    Local cFiltroUp2 := cFiltroUp
    Local cSemLoja   := ""
    Local cSoNaoCob  := "N"

    Default cCliente := ""
    Default cLoja    := ""
    Default aAgenda  := {"", "", "", ""}

    // Agendamento da OS marcado "Nao Cobrar" (Z6_COBRAR): so servico nao
    // cobravel - grupo com BM_TIPGRU = '2'. O Protheus tambem recusa gravar
    // (OS_VALIDACOBRAR no CNSA002).
    If CNS001_AGENDANAOCOBRA(aAgenda[1], cCliente, cLoja, aAgenda[2], aAgenda[3], aAgenda[4])
        cSoNaoCob := "S"
    EndIf

    // Oracle trata '' como NULL ("'' = ''" nao e verdadeiro) - flag S/N pra
    // "loja nao informada" em vez de comparar string vazia no SQL.
    cSemLoja := If(Empty(cLoja), "S", "N")

    // --- Query antiga (todos os produtos da SB1) - mantida comentada ---------
    // BeginSql Alias cAlias
    //     SELECT B1_COD, B1_DESC
    //     FROM %Table:SB1% SB1
    //     WHERE B1_FILIAL = %xFilial:SB1%
    //       AND %NotDel%
    //       AND (UPPER(B1_COD) LIKE '%' || %Exp:cFiltroUp% || '%' OR UPPER(B1_DESC) LIKE '%' || %Exp:cFiltroUp2% || '%')
    //     ORDER BY B1_DESC
    // EndSql

    If !Empty(cCliente)
        // Servicos do cliente (SA7). Loja so filtra se vier informada.
        BeginSql Alias cAlias
            SELECT A7_CLIENTE, A7_LOJA, A7_PRODUTO B1_COD, A7_DESCCLI, B1_DESC,
                   BM_TIPGRU, BM_CODMAR, VE1_DESMAR, BM_GRUPO, BM_DESC
            FROM %Table:SA7% SA7
            INNER JOIN %Table:SB1% SB1
                ON  B1_FILIAL = %xFilial:SB1%
                AND B1_COD    = A7_PRODUTO
                AND SB1.%NotDel%
            INNER JOIN %Table:SBM% SBM
                ON  BM_FILIAL = %xFilial:SBM%
                AND BM_GRUPO  = B1_GRUPO
                AND SBM.%NotDel%
            LEFT JOIN %Table:VE1% VE1
                ON  VE1_FILIAL = %xFilial:VE1%
                AND VE1_CODMAR = BM_CODMAR
                AND VE1.%NotDel%
            WHERE A7_FILIAL  = %xFilial:SA7%
              AND SA7.%NotDel%
              AND A7_CLIENTE = %Exp:cCliente%
              AND (%Exp:cSemLoja% = 'S' OR A7_LOJA = %Exp:cLoja%)
              AND BM_CODMAR  = '005'
              AND (%Exp:cSoNaoCob% = 'N' OR BM_TIPGRU = '2')
              AND (UPPER(A7_PRODUTO) LIKE '%' || %Exp:cFiltroUp% || '%' OR UPPER(B1_DESC) LIKE '%' || %Exp:cFiltroUp2% || '%')
            ORDER BY A7_CLIENTE, A7_LOJA, VE1_DESMAR
        EndSql
    Else
        // Sem cliente: catalogo de produtos com grupo e marca.
        BeginSql Alias cAlias
            SELECT BM_CODMAR, VE1_DESMAR, BM_TIPGRU, BM_GRUPO, BM_DESC, B1_COD, B1_DESC
            FROM %Table:SB1% SB1
            INNER JOIN %Table:SBM% SBM
                ON  BM_FILIAL = %xFilial:SBM%
                AND BM_GRUPO  = B1_GRUPO
                AND SBM.%NotDel%
            LEFT JOIN %Table:VE1% VE1
                ON  VE1_FILIAL = %xFilial:VE1%
                AND VE1_CODMAR = BM_CODMAR
                AND VE1.%NotDel%
            WHERE B1_FILIAL = %xFilial:SB1%
              AND SB1.%NotDel%
              AND (UPPER(B1_COD) LIKE '%' || %Exp:cFiltroUp% || '%' OR UPPER(B1_DESC) LIKE '%' || %Exp:cFiltroUp2% || '%')
            ORDER BY BM_CODMAR, BM_TIPGRU, B1_DESC
        EndSql
    EndIf

    While !(cAlias)->(Eof())
        oLinha := JsonObject():New()
        oLinha['codigo']      := CNS001_LUPA_COMPSTR((cAlias)->B1_COD)
        oLinha['complemento'] := CNS001_LUPA_COMPSTR((cAlias)->BM_DESC)
        oLinha['descricao']   := CNS001_LUPA_COMPSTR((cAlias)->B1_DESC)
        AAdd(aRet, oLinha)
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

Return aRet

//-------------------------------------------------------------------
/*/{Protheus.doc} CNS001_AGENDANAOCOBRA
Diz se o agendamento (SZ6) que corresponde a uma OS esta marcado como
"Nao Cobrar" (Z6_COBRAR = "NAO"). Casa OS x agendamento pelo mesmo criterio
do Z6_TEMOS / localizarPorAgendamento do portal: tecnico + cliente (+ loja,
se informada) + data + horario inicial e final com tolerancia de 15 min.
Mesma regra de OS_AGENDANAOCOBRA (CNSA002, validacao ao gravar a OS).
@param  cTec     Tecnico (AA1_CODTEC)
@param  cCli     Cliente (A1_COD)
@param  cLoja    Loja do cliente (vazia = qualquer loja)
@param  cData    Data AAAAMMDD
@param  cHrIni   Hora inicial (HH:MM ou HHMM)
@param  cHrFim   Hora final (HH:MM ou HHMM)
@return lNaoCob  .T. se achou agendamento correspondente com Z6_COBRAR = "NAO"
@author Henrique
@since 05/10/2026
@version P12
/*/
//-------------------------------------------------------------------
Static Function CNS001_AGENDANAOCOBRA(cTec, cCli, cLoja, cData, cHrIni, cHrFim)
    Local cAlias  := ""
    Local lNaoCob := .F.
    Local nIni    := 0
    Local nFim    := 0

    cTec   := AllTrim(cTec)
    cCli   := AllTrim(cCli)
    cLoja  := AllTrim(cLoja)
    cData  := AllTrim(cData)
    nIni   := CNS001_AGENDANAOCOBRA_MIN(cHrIni)
    nFim   := CNS001_AGENDANAOCOBRA_MIN(cHrFim)

    If Empty(cTec) .Or. Empty(cCli) .Or. Len(cData) != 8 .Or. nIni < 0 .Or. nFim < 0
        Return .F.
    EndIf

    cAlias := GetNextAlias()
    BeginSql Alias cAlias
        SELECT Z6_LOJA, Z6_HMINI, Z6_HMFIM, Z6_COBRAR
        FROM %Table:SZ6% SZ6
        WHERE Z6_FILIAL  = %xFilial:SZ6%
          AND Z6_TECNICO = %Exp:cTec%
          AND Z6_CLIENTE = %Exp:cCli%
          AND Z6_DTAGE   = %Exp:cData%
          AND %NotDel%
    EndSql
    While !(cAlias)->(Eof())
        If (Empty(cLoja) .Or. Empty(AllTrim((cAlias)->Z6_LOJA)) .Or. AllTrim((cAlias)->Z6_LOJA) == cLoja) .And. ;
                Abs(CNS001_AGENDANAOCOBRA_MIN((cAlias)->Z6_HMINI) - nIni) <= 15 .And. ;
                Abs(CNS001_AGENDANAOCOBRA_MIN((cAlias)->Z6_HMFIM) - nFim) <= 15
            If Upper(AllTrim((cAlias)->Z6_COBRAR)) == "NAO"
                lNaoCob := .T.
                Exit
            EndIf
        EndIf
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

Return lNaoCob

// "HH:MM"/"HHMM" -> minutos do dia (-1 se invalido)
Static Function CNS001_AGENDANAOCOBRA_MIN(cHora)
    Local cDig := ""
    Local nI   := 0

    cHora := AllTrim(cHora)
    For nI := 1 To Len(cHora)
        If IsDigit(SubStr(cHora, nI, 1))
            cDig += SubStr(cHora, nI, 1)
        EndIf
    Next nI
    If Len(cDig) < 3
        Return -1
    EndIf
    cDig := PadL(cDig, 4, "0")

Return Val(Left(cDig, 2)) * 60 + Val(SubStr(cDig, 3, 2))

////////////////////////////////////////////////////////////////////////////////
// Lupa de Proposta (SZ3 - Cabecalho de Propostas) - usada no campo
// Z1_NUMPRO da OS (pouios). Confirmado via "Visualizar Campo - Z1_NUMPRO":
// Cons. Padrao "SZ3 - Proposta", campos Z3_NUM/Z3_CODCLI/Z3_LOJA/Z3_DESC.
// Cascata por cliente, mesma logica de CNS001_PROJLUPA (AF8) - so mostra
// propostas do cliente selecionado.
////////////////////////////////////////////////////////////////////////////////
Static Function CNS001_PROPLUPA(cFiltro, cCliente, cLoja)
    Local aRet    := {}
    Local oLinha  := Nil
    Local cAlias  := GetNextAlias()
    Local cFiltroUp  := Upper(cFiltro)
    Local cFiltroUp2 := cFiltroUp

    // FIX (mesmo bug de total sempre 0 do SZ1/ZA1): xFilial("SZ3") devolve
    // branco no contexto de rota @Get/@Post do motor REST TLPP - SZ3 e
    // tabela customizada por filial (mesma familia Z1/ZA1), usa cFilAnt
    // direto em vez de xFilial().
    BeginSql Alias cAlias
        SELECT Z3_NUM, Z3_DESC
        FROM %Table:SZ3% SZ3
        WHERE Z3_FILIAL = %Exp:cFilAnt%
          AND %NotDel%
          AND Z3_CODCLI = %Exp:cCliente%
          AND Z3_LOJA   = %Exp:cLoja%
          AND (UPPER(Z3_NUM) LIKE '%' || %Exp:cFiltroUp% || '%' OR UPPER(Z3_DESC) LIKE '%' || %Exp:cFiltroUp2% || '%')
        ORDER BY Z3_NUM
    EndSql

    While !(cAlias)->(Eof())
        oLinha := JsonObject():New()
        oLinha['codigo']      := CNS001_LUPA_COMPSTR((cAlias)->Z3_NUM)
        oLinha['complemento'] := ""
        oLinha['descricao']   := CNS001_LUPA_COMPSTR((cAlias)->Z3_DESC)
        AAdd(aRet, oLinha)
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

Return aRet

////////////////////////////////////////////////////////////////////////////////
// Lupa de Chamado (ZA1) - usada pela tela de OS (cns003) pra vincular
// Z1_CHHDK a um chamado, cascata por cliente (mesmo padrao de Projeto/
// Proposta). Sem filtro de status - lista chamados do cliente em qualquer
// status (confirmado com o usuario). Sem cliente, lista chamados de todos
// os clientes (campo Chamado da OS fica sempre habilitado).
////////////////////////////////////////////////////////////////////////////////
Static Function CNS001_CHAMLUPA(cFiltro, cCliente, cLoja)
    Local aRet    := {}
    Local oLinha  := Nil
    Local cAlias  := GetNextAlias()
    Local cFiltroUp  := Upper(cFiltro)
    Local cFiltroUp2 := cFiltroUp

    // %xFilial:ZA1% - mesmo filtro da listagem de chamados (CNSA001.TLPP,
    // CNSACHAMADOS). cFilAnt aqui nao batia com ZA1_FILIAL e a lupa
    // voltava vazia sem erro.
    If Empty(cCliente)
        BeginSql Alias cAlias
            SELECT ZA1_IDCH, ZA1_ASSUNT
            FROM %Table:ZA1% ZA1
            WHERE ZA1_FILIAL = %xFilial:ZA1%
              AND %NotDel%
              AND (UPPER(ZA1_IDCH) LIKE '%' || %Exp:cFiltroUp% || '%' OR UPPER(ZA1_ASSUNT) LIKE '%' || %Exp:cFiltroUp2% || '%')
            ORDER BY ZA1_DATA DESC
        EndSql
    Else
        BeginSql Alias cAlias
            SELECT ZA1_IDCH, ZA1_ASSUNT
            FROM %Table:ZA1% ZA1
            WHERE ZA1_FILIAL = %xFilial:ZA1%
              AND %NotDel%
              AND ZA1_CLIENT = %Exp:cCliente%
              AND ZA1_LOJA   = %Exp:cLoja%
              AND (UPPER(ZA1_IDCH) LIKE '%' || %Exp:cFiltroUp% || '%' OR UPPER(ZA1_ASSUNT) LIKE '%' || %Exp:cFiltroUp2% || '%')
            ORDER BY ZA1_DATA DESC
        EndSql
    EndIf

    While !(cAlias)->(Eof())
        oLinha := JsonObject():New()
        oLinha['codigo']      := CNS001_LUPA_COMPSTR((cAlias)->ZA1_IDCH)
        oLinha['complemento'] := ""
        oLinha['descricao']   := CNS001_LUPA_COMPSTR((cAlias)->ZA1_ASSUNT)
        AAdd(aRet, oLinha)
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

Return aRet

////////////////////////////////////////////////////////////////////////////////
//                                                                            //
//                       UTILITARIOS (usados por todas as lupas acima)       //
//                                                                            //
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// AllTrim direto quebra se o campo vier NIL/tipo diferente de Character (por
// exemplo linha com valor nulo no banco) - com filtro vazio a query varre
// muito mais linhas de uma vez, entao qualquer linha "suja" faz o endpoint
// inteiro cair (erro nao capturavel pelo Begin/Recover). Blinda cada valor
// antes de expor no JSON.
////////////////////////////////////////////////////////////////////////////////
Static Function CNS001_LUPA_COMPSTR(xValor)
    If ValType(xValor) == "C"
        Return AllTrim(xValor)
    EndIf
Return ""

////////////////////////////////////////////////////////////////////////////////
// FIX (mesmo bug de total sempre 0 do Apia-OS.tlpp/Apia-Chamados.tlpp):
// GetJsonText(jDados,"campo") devolve a STRING literal "null" quando o
// parametro nao veio na querystring, em vez de string vazia -
// AllTrim(GetJsonText(...)) nunca fica Empty(). Indexacao direta
// jDados[cCampo] devolve Nil de verdade pra campo ausente - usar sempre
// isso em vez de GetJsonText().
////////////////////////////////////////////////////////////////////////////////
Static Function CNS001_LUPA_JSONSTR(jDados, cCampo)
    Local xVal := jDados[cCampo]
    If xVal == Nil .Or. ValType(xVal) != "C"
        Return ""
    EndIf
Return xVal

// Reconstrucao manual byte a byte do bug "UTF-8 lido como CP1252" (mesmo
// algoritmo do CH_DECODESAFE em CNS001.TLPP) - remonta o par de bytes UTF-8
// (0xC2/0xC3 + continuacao) que apareceu como 2 chars CP1252 separados.
// Nunca lanca erro (so Asc/Chr/SubStr).
Static Function CNS001_LUPA_DECODESAFE(cTexto)
    Local cRet  := ""
    Local nLen  := Len(cTexto)
    Local nI    := 1
    Local nB1, nB2

    While nI <= nLen
        nB1 := Asc(SubStr(cTexto, nI, 1))
        If (nB1 == 195 .Or. nB1 == 194) .And. nI < nLen
            nB2 := Asc(SubStr(cTexto, nI + 1, 1))
            If nB2 >= 128 .And. nB2 <= 191
                cRet += Chr(((nB1 - 192) * 64) + (nB2 - 128))
                nI   += 2
                Loop
            EndIf
        EndIf
        cRet += SubStr(cTexto, nI, 1)
        nI++
    EndDo

Return cRet

Static Function CNS001_LUPA_FILTROSQL(cTexto)
    Local cRet := ""
    Local cCar := ""
    Local nI   := 0

    For nI := 1 To Len(cTexto)
        cCar := SubStr(cTexto, nI, 1)
        If Asc(cCar) > 127 .Or. cCar $ "'?"
            cRet += "_"
        Else
            cRet += cCar
        EndIf
    Next nI

Return cRet

Static Function CNS001_LUPA_JSONESC(cTexto)
    Local cRet := cTexto
    cRet := StrTran(cRet, '\',  '\\')
    cRet := StrTran(cRet, '"',  '\"')
    cRet := StrTran(cRet, Chr(13)+Chr(10), '\n')
    cRet := StrTran(cRet, Chr(10), '\n')
    cRet := StrTran(cRet, Chr(13), '\n')
    cRet := StrTran(cRet, Chr(9),  '\t')
Return cRet

////////////////////////////////////////////////////////////////////////////////
// GATILHOS DO DICIONARIO (SX7) - funcoes globais
//
// Os gatilhos guardam a regra como texto sem namespace (U_CNSA_CLIENTE(),
// U_CNSA_TECNICO()). As funcoes de verdade ficam no CNSA001.TLPP, dentro do
// Namespace apia.cnsa001 (no RPO: apia.cnsa001.U_...), e o gatilho dava
// "cannot find function U_CNSA_CLIENTE in AppMap". Aqui (fonte sem Namespace)
// elas existem com o nome global e so repassam a chamada - no proprio
// CNSA001.TLPP o compilador acusava "Redefinition of function".
////////////////////////////////////////////////////////////////////////////////

/*/{Protheus.doc} CNSA_CLIENTE
Gatilho SX7 do ZA1_CLIENT (seq 001, contra-dominio ZA1_NOME) - repassa pra
apia.cnsa001.U_CNSA_CLIENTE (CNSA001.TLPP).
@return cNome   Nome reduzido do cliente
@author Henrique
@since 28/09/2026
@version P12
/*/
User Function CNSA_CLIENTE()
Return apia.cnsa001.U_CNSA_CLIENTE()

/*/{Protheus.doc} CNSA_TECNICO
Gatilho SX7 do ZA1_CONSUL (seq 001, contra-dominio ZA1_NOMTEC) - repassa pra
apia.cnsa001.U_CNSA_TECNICO (CNSA001.TLPP).
@return cNome   Nome do tecnico
@author Henrique
@since 28/09/2026
@version P12
/*/
User Function CNSA_TECNICO()
Return apia.cnsa001.U_CNSA_TECNICO()

////////////////////////////////////////////////////////////////////////////////
// AGENDA NO CALENDARIO DO OUTLOOK DO TECNICO (Microsoft Graph)
// Henrique - 05/10/2026 - spec docs/superpowers/specs/2026-10-05-agenda-outlook-design.md
//
// Uma funcao so - U_CNSOUTL(cAcao, ...) - com uma opcao por acao (Do Case).
// Nome curto (9 caracteres com U_): o CNSA003 e .prw e so enxerga 10.
//   U_CNSOUTL("AGENDA", oModel)                   evento do modelo da Agenda
//                                                 (CNS003OUTL, CNSA003)
//   U_CNSOUTL("EXCLUIR", cEmailTec, cIdEvento)    exclusao do chamado (CNSA001)
// As demais opcoes sao internas (a funcao chama ela mesma).
//
// Depende de: Z6_IDOUTL (C 250); AA1_EMAIL do tecnico; MV_CNSATEN/MV_CNSACLI/
// MV_CNSASEC; permissao de aplicativo Calendars.ReadWrite no Azure;
// apia.cnsa001.U_CH_HTMLPUB/U_CH_MAILPUB. Falha nunca impede gravar a agenda.
////////////////////////////////////////////////////////////////////////////////

#define OUTL_GRAPH  "https://graph.microsoft.com/v1.0/users/"
#define OUTL_FUSO   "E. South America Standard Time"
#define OUTL_ALTERAR 4
#define OUTL_EXCLUIR 5

// Posicoes do array de dados da agenda (opcao "DADOS")
#define AG_TECNICO    1
#define AG_TITULO     2
#define AG_IDCH       3
#define AG_QUANDO     4
#define AG_LINHAS     5
#define AG_CARTAO     6
#define AG_LOCAL      7
#define AG_CONVIDADOS 8
#define AG_DATA       9
#define AG_HRINI      10
#define AG_HRFIM      11
#define AG_COBRAR     12

//-------------------------------------------------------------------
/*/{Protheus.doc} CNSOUTL
Agenda no Outlook do tecnico - uma funcao, varias opcoes:
  AGENDA  (oModel)                   sincroniza o agendamento gravado
  EXCLUIR (cEmailTec, cIdEvento)     apaga o evento (cancela se tem convidado)
  SALVAR  (cEmailTec, cIdEvento, aAg) cria/atualiza o evento -> id
  DADOS   (oSZ6)                     dados da agenda (posicoes AG_*)
  JSON    (aAg)                      JSON do evento (UTF-8)
  AVISO   (cTec, aAg, cAlerta, cIntro) e-mail ao tecnico
  GRAVAID (oSZ6, cId)                grava Z6_IDOUTL
  EMAIL   (cTec)                     AA1_EMAIL do tecnico
  HTTP    (cMetodo, cUrl, cCorpo)    Graph -> {nStatus, cResposta}
  TOKEN   ()                         token do Graph
@author Henrique
@since 05/10/2026
@version P12
/*/
//-------------------------------------------------------------------
User Function CNSOUTL(cAcao, x1, x2, x3, x4)
    Local xRet    := Nil
    Local oSZ6    := Nil
    Local oJson   := Nil
    Local oErro   := Nil
    Local bErro   := Nil
    Local aAg     := {}
    Local aResp   := {}
    Local aLin    := {}
    Local aCli    := {}
    Local aAux    := {}
    Local cAux    := ""
    Local cHead   := ""
    Local cEnc    := ""
    Local cAssunto := ""
    Local cTec    := ""
    Local cId     := ""
    Local nOper   := 0
    Local nI      := 0
    Local lCria   := .F.
    // Linha {rotulo, valor} - vazia nao entra; lCli = o cliente tambem ve.
    Local bLinha  := {|lCli, cRot, cVal| If(Empty(cVal), Nil, ;
                        (AAdd(aLin, {cRot, cVal}), If(lCli, AAdd(aCli, {cRot, cVal}), Nil)))}
    Local bHtml   := {|aL| cAux := "", AEval(aL, {|l| cAux += "<p><b>" + l[1] + ":</b> " + l[2] + "</p>"}), cAux}
    // Percent-encoding (x-www-form-urlencoded) do corpo do token.
    Local bUrl    := {|cT| cEnc := "", AEval(Array(Len(cT)), {|x, n| cEnc += If(IsAlpha(SubStr(cT, n, 1)) .Or. ;
                        IsDigit(SubStr(cT, n, 1)) .Or. SubStr(cT, n, 1) $ "-_.~", SubStr(cT, n, 1), ;
                        "%" + SubStr("0123456789ABCDEF", Int(Asc(SubStr(cT, n, 1)) / 16) + 1, 1) + ;
                        SubStr("0123456789ABCDEF", (Asc(SubStr(cT, n, 1)) % 16) + 1, 1))}), cEnc}
    Local bHora   := {|dD, cH| cH := PadL(Left(StrTran(AllTrim(cH), ":", ""), 4), 4, "0"), ;
                        Transform(DToS(dD), "@R 9999-99-99") + "T" + Left(cH, 2) + ":" + Right(cH, 2) + ":00"}

    cAcao := Upper(AllTrim(cAcao))

    Do Case
    Case cAcao == "AGENDA"
        bErro := ErrorBlock({|e| Break(e)})
        Begin Sequence
            nOper  := x1:GetOperation()
            oSZ6   := x1:GetModel("ModelSZ6_Main")
            aAg    := U_CNSOUTL("DADOS", oSZ6)
            cTec   := aAg[AG_TECNICO]
            // Id do evento ja vinculado - o modelo ainda tem o valor (agenda nao troca tecnico).
            x2     := AllTrim(oSZ6:GetValue("Z6_IDOUTL"))

            If nOper == OUTL_EXCLUIR
                U_CNSOUTL("EXCLUIR", U_CNSOUTL("EMAIL", cTec), x2)
                U_CNSOUTL("AVISO", cTec, aAg, "Agendamento cancelado", ;
                    "O agendamento abaixo foi cancelado e removido do seu calend&aacute;rio.")
                Break
            EndIf

            // Incluir cria, Alterar atualiza o evento (agenda nao troca tecnico).
            cId := U_CNSOUTL("SALVAR", U_CNSOUTL("EMAIL", cTec), x2, aAg)
            // Vinculo gravado ANTES do e-mail: falha no e-mail nao duplica evento.
            If cId != x2
                U_CNSOUTL("GRAVAID", oSZ6, cId)
            EndIf

            // E-mail ao tecnico so na inclusao (alteracao so atualiza o calendario).
            If nOper != OUTL_ALTERAR
                U_CNSOUTL("AVISO", cTec, aAg, "Novo agendamento", ;
                    "Um atendimento foi agendado para voc&ecirc; e j&aacute; est&aacute; no seu calend&aacute;rio.")
            EndIf
        Recover Using oErro
            If oErro != Nil
                ConOut("CNSOUTLOOK: erro ao sincronizar a agenda: " + oErro:Description)
            EndIf
        End Sequence
        ErrorBlock(bErro)

    Case cAcao == "EXCLUIR"
        xRet := .T.
        If !Empty(AllTrim(x2))
            cAux  := OUTL_GRAPH + AllTrim(x1) + "/events/" + AllTrim(x2)
            // Com convidados (cliente) "cancel" apaga e avisa; sem convidados o Graph recusa - DELETE.
            aResp := U_CNSOUTL("HTTP", "POST", cAux + "/cancel", '{"comment":"Agendamento cancelado."}')
            If aResp[1] != 202 .And. aResp[1] != 404
                aResp := U_CNSOUTL("HTTP", "DELETE", cAux, "")
            EndIf
            xRet := AScan({202, 204, 404}, aResp[1]) > 0
            If !xRet
                ConOut("CNSOUTLOOK: falha ao apagar evento (HTTP " + cValToChar(aResp[1]) + "): " + aResp[2])
            EndIf
        EndIf

    Case cAcao == "SALVAR"
        xRet := x2
        If Empty(x1)
            ConOut("CNSOUTLOOK: tecnico sem e-mail (AA1_EMAIL) - evento nao gravado.")
        Else
            cAux  := U_CNSOUTL("JSON", x3)
            lCria := Empty(x2)
            If !lCria
                aResp := U_CNSOUTL("HTTP", "PATCH", OUTL_GRAPH + x1 + "/events/" + x2, cAux)
                lCria := aResp[1] == 404   // apagado a mao no Outlook: cria de novo
            EndIf
            If lCria
                aResp := U_CNSOUTL("HTTP", "POST", OUTL_GRAPH + x1 + "/events", cAux)
                oJson := JsonObject():New()
                xRet  := If(aResp[1] == 201 .And. Empty(oJson:FromJson(aResp[2])), oJson["id"], "")
                FreeObj(oJson)
            EndIf
            If aResp[1] != 200 .And. aResp[1] != 201
                ConOut("CNSOUTLOOK: falha ao gravar evento de " + x1 + " (HTTP " + cValToChar(aResp[1]) + "): " + aResp[2])
            EndIf
        EndIf

    Case cAcao == "DADOS"
        cTec := AllTrim(x1:GetValue("Z6_TECNICO"))
        cId  := AllTrim(x1:GetValue("Z6_IDCH"))
        If Empty(cId) .And. ValType(x1:GetValue("Z6_CHAMADO")) == "N" .And. x1:GetValue("Z6_CHAMADO") > 0
            cId := StrZero(x1:GetValue("Z6_CHAMADO"), 6)
        EndIf
        cAux := AllTrim(Posicione("SA1", 1, xFilial("SA1") + x1:GetValue("Z6_CLIENTE") + x1:GetValue("Z6_LOJA"), "A1_NREDUZ"))

        // Assunto: o do chamado; sem chamado, o servico da agenda.
        cAssunto := If(Empty(cId), "", AllTrim(Posicione("ZA1", 1, xFilial("ZA1") + cId, "ZA1_ASSUNT")))
        cAssunto := If(Empty(cAssunto), AllTrim(x1:GetValue("Z6_SERVICO")), cAssunto)

        // .T. = entra tambem no cartao do evento (Outlook). Data/hora o Outlook ja mostra.
        Eval(bLinha, .F., "Data", DToC(x1:GetValue("Z6_DTAGE")))
        Eval(bLinha, .F., "Hor&aacute;rio", AllTrim(x1:GetValue("Z6_HMINI")) + " &agrave;s " + AllTrim(x1:GetValue("Z6_HMFIM")))
        Eval(bLinha, .F., "T&eacute;cnico", AllTrim(Posicione("AA1", 1, xFilial("AA1") + cTec, "AA1_NOMTEC")))
        Eval(bLinha, .T., "Chamado", If(Empty(cId), "", "#" + cId))
        Eval(bLinha, .T., "Assunto", cAssunto)
        Eval(bLinha, .T., "Cliente", cAux + If(Empty(x1:GetValue("Z6_LOJA")), "", " (Loja " + AllTrim(x1:GetValue("Z6_LOJA")) + ")"))
        If !Empty(x1:GetValue("Z6_PROJET"))
            Eval(bLinha, .T., "Projeto", AllTrim(x1:GetValue("Z6_PROJET")) + " - " + ;
                AllTrim(Posicione("AF8", 1, xFilial("AF8") + x1:GetValue("Z6_PROJET"), "AF8_DESCRI")))
        EndIf
        If !Empty(x1:GetValue("Z6_TAREFA"))
            Eval(bLinha, .T., "Tarefa", AllTrim(x1:GetValue("Z6_TAREFA")) + " - " + ;
                AllTrim(Posicione("AF9", 1, xFilial("AF9") + AllTrim(x1:GetValue("Z6_PROJET")) + AllTrim(x1:GetValue("Z6_TAREFA")), "AF9_DESCRI")))
        EndIf
        // Campos de lista da agenda (so pro tecnico): titulo e opcao do dicionario.
        aResp := {"Z6_TIPOAG", "Z6_LOCAL", "Z6_CONFIRM", "Z6_INTERNO", "Z6_COBRAR"}
        For nI := 1 To Len(aResp)
            cHead := AllTrim(cValToChar(x1:GetValue(aResp[nI])))
            Eval(bLinha, .F., AllTrim(RetTitle(aResp[nI])), ;
                If(Empty(X3Combo(aResp[nI], cHead)), cHead, AllTrim(X3Combo(aResp[nI], cHead))))
        Next nI
        Eval(bLinha, .T., "Agendado por", AllTrim(x1:GetValue("Z6_QGRAVOU")))

        // Convidados: Cliente Participa? = Sim (Z6_INTERNO = "NAO", pergunta
        // invertida) -> todos os e-mails do chamado e do cadastro, sem repetir.
        If Upper(AllTrim(x1:GetValue("Z6_INTERNO"))) == "NAO"
            aResp := StrTokArr2(StrTran(If(Empty(cId), "", Posicione("ZA1", 1, xFilial("ZA1") + cId, "ZA1_EMAIL")) + ";" + ;
                Posicione("SA1", 1, xFilial("SA1") + x1:GetValue("Z6_CLIENTE") + x1:GetValue("Z6_LOJA"), "A1_EMAIL"), ",", ";"), ";", .F.)
            AEval(aResp, {|e| e := Lower(AllTrim(e)), If("@" $ e .And. AScan(aAux, e) == 0, AAdd(aAux, e), Nil)})
        EndIf

        // Titulo "CLIENTE - Assunto"; cartao enxuto (aCli) pro evento; aLin completo pro e-mail.
        xRet := {cTec, ;
                 If(Empty(cAux), "Agendamento", cAux) + If(Empty(cAssunto), "", " - " + cAssunto), ;
                 cId, ;
                 DToC(x1:GetValue("Z6_DTAGE")) + " " + AllTrim(x1:GetValue("Z6_HMINI")) + "-" + AllTrim(x1:GetValue("Z6_HMFIM")), ;
                 aLin, Eval(bHtml, aCli), ;
                 AllTrim(X3Combo("Z6_LOCAL", AllTrim(x1:GetValue("Z6_LOCAL")))), ;
                 aAux, x1:GetValue("Z6_DTAGE"), AllTrim(x1:GetValue("Z6_HMINI")), AllTrim(x1:GetValue("Z6_HMFIM")), ;
                 Upper(AllTrim(x1:GetValue("Z6_COBRAR")))}

    Case cAcao == "JSON"
        // Evento enxuto: titulo, local, categoria (Cobravel/Nao Cobravel) e cartao
        // curto - o mesmo pro cliente convidado (nao tem campo interno). Convidados
        // sempre vao (vazio tambem: no PATCH a lista substitui a anterior).
        oJson := JsonObject():New()
        oJson["subject"] := x1[AG_TITULO]
        oJson["body"]    := JsonObject():New()
        oJson["body"]["contentType"] := "HTML"
        oJson["body"]["content"]     := x1[AG_CARTAO]
        oJson["location"] := JsonObject():New()
        oJson["location"]["displayName"] := x1[AG_LOCAL]
        oJson["categories"] := {If(x1[AG_COBRAR] == "NAO", "N" + Chr(227) + "o Cobr" + Chr(225) + "vel", "Cobr" + Chr(225) + "vel")}
        oJson["start"]   := JsonObject():New()
        oJson["start"]["dateTime"]   := Eval(bHora, x1[AG_DATA], x1[AG_HRINI])
        oJson["start"]["timeZone"]   := OUTL_FUSO
        oJson["end"]     := JsonObject():New()
        oJson["end"]["dateTime"]     := Eval(bHora, x1[AG_DATA], x1[AG_HRFIM])
        oJson["end"]["timeZone"]     := OUTL_FUSO
        oJson["showAs"]  := "busy"
        oJson["isReminderOn"] := .T.
        oJson["reminderMinutesBeforeStart"] := 15
        oJson["responseRequested"] := .T.
        For nI := 1 To Len(x1[AG_CONVIDADOS])
            AAdd(aAux, JsonObject():New())
            aAux[nI]["type"] := "required"
            aAux[nI]["emailAddress"] := JsonObject():New()
            aAux[nI]["emailAddress"]["address"] := x1[AG_CONVIDADOS][nI]
        Next nI
        oJson["attendees"] := aAux
        cAux := oJson:ToJson()
        FreeObj(oJson)
        // Base em CP1252 - o Graph espera UTF-8.
        xRet := EncodeUTF8(cAux)
        xRet := If(ValType(xRet) == "C", xRet, cAux)

    Case cAcao == "AVISO"
        cAux := U_CNSOUTL("EMAIL", x1)
        If !Empty(cAux)
            apia.cnsa001.U_CH_MAILPUB(cAux, x3 + " - " + x2[AG_TITULO] + " - " + x2[AG_QUANDO], ;
                apia.cnsa001.U_CH_HTMLPUB(x2[AG_IDCH], x3, AllTrim(Posicione("AA1", 1, xFilial("AA1") + x1, "AA1_NOMTEC")), ;
                    x4, x2[AG_LINHAS], "", "", ""))
        EndIf

    Case cAcao == "GRAVAID"
        aAux := SZ6->(GetArea())
        cAux := GetNextAlias()
        cHead := DToS(x1:GetValue("Z6_DTAGE"))
        cTec  := x1:GetValue("Z6_TECNICO")
        cId   := x1:GetValue("Z6_SEQ")
        BeginSql Alias cAux
            SELECT SZ6.R_E_C_N_O_ RECNO
            FROM %Table:SZ6% SZ6
            WHERE Z6_FILIAL  = %xFilial:SZ6%
              AND Z6_DTAGE   = %Exp:cHead%
              AND Z6_TECNICO = %Exp:cTec%
              AND Z6_SEQ     = %Exp:cId%
              AND %NotDel%
        EndSql
        If !(cAux)->(Eof())
            SZ6->(DbGoTo((cAux)->RECNO))
            RecLock("SZ6", .F.)
                SZ6->Z6_IDOUTL := x2
            SZ6->(MsUnlock())
        EndIf
        (cAux)->(DbCloseArea())
        RestArea(aAux)

    Case cAcao == "EMAIL"
        xRet := If(Empty(x1), "", AllTrim(Posicione("AA1", 1, xFilial("AA1") + AllTrim(x1), "AA1_EMAIL")))

    Case cAcao == "HTTP"
        // FWRest nao tem PATCH - HttpQuote. Status na 1a linha do cabecalho ("HTTP/1.1 201 Created").
        cAux := U_CNSOUTL("TOKEN")
        If Empty(cAux)
            Return {0, "sem token do Graph"}
        EndIf
        xRet := HttpQuote(x2, x1, "", x3, 60, {"Authorization: Bearer " + cAux, "Content-Type: application/json; charset=utf-8"}, @cHead)
        xRet := {If(ValType(cHead) == "C" .And. At(" ", cHead) > 0, Val(SubStr(cHead, At(" ", cHead) + 1, 3)), 0), ;
                 If(ValType(xRet) == "C", xRet, "")}

    Case cAcao == "TOKEN"
        // Client credentials - mesma logica do CH_TOKENGRAPH (CNSA001).
        xRet := ""
        aAux := {AllTrim(GetMV("MV_CNSATEN")), AllTrim(GetMV("MV_CNSACLI")), AllTrim(GetMV("MV_CNSASEC"))}
        If AScan(aAux, {|c| Empty(c)}) > 0
            ConOut("CNSOUTLOOK: MV_CNSATEN/MV_CNSACLI/MV_CNSASEC nao configurados.")
            Return ""
        EndIf
        cAux := HttpQuote("https://login.microsoftonline.com/" + aAux[1] + "/oauth2/v2.0/token", "POST", "", ;
            "grant_type=client_credentials&client_id=" + Eval(bUrl, aAux[2]) + "&client_secret=" + Eval(bUrl, aAux[3]) + ;
            "&scope=" + Eval(bUrl, "https://graph.microsoft.com/.default"), 60, {"Content-Type: application/x-www-form-urlencoded"}, @cHead)
        oJson := JsonObject():New()
        If ValType(cAux) == "C" .And. Empty(oJson:FromJson(cAux)) .And. ValType(oJson["access_token"]) == "C"
            xRet := oJson["access_token"]
        Else
            ConOut("CNSOUTLOOK: falha ao obter token do Graph: " + cValToChar(cAux))
        EndIf
        FreeObj(oJson)

    OtherWise
        ConOut("CNSOUTLOOK: acao invalida - " + cAcao)
    EndCase

Return xRet
