<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- REST_USUARIO e REST_SENHA vem do config.local.config (so no servidor, fora do git). -->
    <appSettings file="config.local.config">
        <add key="REST_BASE" value="https://10.0.0.3:8624" />
        <add key="TELEFONE_APIA" value="(24) 2103-7474" />
        <add key="EMAIL_APIA" value="pericles@apia.com.br" />
    </appSettings>
    <system.web>
        <!-- Observacao do cliente pode ter "<": a pagina escapa tudo ao mostrar. -->
        <httpRuntime requestValidationMode="2.0" />
        <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
        <!-- Erro nunca mostra detalhes (caminho, codigo) pro cliente. -->
        <customErrors mode="On" />
    </system.web>
    <system.webServer>
        <defaultDocument>
            <files>
                <clear />
                <add value="default.aspx" />
            </files>
        </defaultDocument>
    </system.webServer>
</configuration>
