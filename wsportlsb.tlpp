                    ZZ5->ZZ5_NMCOLE := jBody:GetJsonText("nomeColetivo")//jBody["coletivo"][nCont]["nomeCole"]
                    ZZ5->ZZ5_NACION := jBody:GetJsonText("coletivoNacional")//jBody["coletivo"][nCont]["nacional"]
                    ZZ5->ZZ5_CODCAE := ""//jBody["coletivo"][nCont]["idCAE"]
                    ZZ5->ZZ5_NMPSCO := ""//jBody["coletivo"][nCont]["pseudonimo"]
                    ZZ5->ZZ5_DSCOMP := ""//jBody["coletivo"][nCont]["descricao"]
                    ZZ5->(MsUnlock())
                    ZZ5->(ConfirmSx8())
                ELSEIF  dbSeek(xFilial("ZZ5")+cIdFono) .AND. cOper == "A"

                    cSql := " UPDATE " + RetSqlName("ZZ5") + " " + CRLF
                    cSql += " SET " + CRLF
                    iif(!empty(jBody["coletivo"][nCont]["idSocCol"] ),cSql += " ZZ5_CDSOCO = '"+jBody["coletivo"][nCont]["idSocCol"] +"', " + CRLF,"")
                    iif(!empty(jBody["coletivo"][nCont]["siglaPCole"] ),cSql += " ZZ5_SIGPAI = '"+jBody["coletivo"][nCont]["siglaPCole"] +"', " + CRLF,"")
                    iif(!empty(jBody["coletivo"][nCont]["tipoCole"]),cSql += " ZZ5_TPCOLE = '"+jBody["coletivo"][nCont]["tipoCole"] +"', " + CRLF,"")
                    iif(!empty(jBody["coletivo"][nCont]["nomeCole"] ),cSql += " ZZ5_NMCOLE = '"+jBody["coletivo"][nCont]["nomeCole"] +"', " + CRLF,"")
                    iif(!empty(jBody["coletivo"][nCont]["nacional"]),cSql += " ZZ5_NACION = '"+jBody["coletivo"][nCont]["nacional"] +"', " + CRLF,"")
                    iif(!empty(jBody["coletivo"][nCont]["idCAE"] ),cSql += " ZZ5_CODCAE = '"+jBody["coletivo"][nCont]["idCAE"] +"', " + CRLF,"")
                    iif(!empty(jBody["coletivo"][nCont]["pseudonimo"] ),cSql += " ZZ5_NMPSCO = '"+jBody["coletivo"][nCont]["pseudonimo"] +"', " + CRLF,"")
                    iif(!empty(jBody["coletivo"][nCont]["descricao"] ),cSql += " ZZ5_DSCOMP = '"+jBody["coletivo"][nCont]["descricao"] +"', " + CRLF,"")
                    cSql += " ZZ5_DTUALT = '"+cvaltochar(dDatabase)+"' "+ CRLF
                    cSql += "WHERE " + CRLF
                    cSql += "    ZZ5_FILIAL = '" + xFilial("ZZ5") + "' AND " + CRLF
                    cSql += "    ZZ5_IDFONO = '" + cIdFono + "' AND " + CRLF
                    cSql += "    D_E_L_E_T_ = ' ' "
                    If (TcSqlExec(cSql) < 0)
                        ConOut("TCSQLError() " + CRLF + TCSQLError())
                    EndIf
                    cDsOper := "ALTERAR"
                    cStatus := "OK"
                    cMsg    := "ALTERAÇÃO DO FONOGRAMA EXECUTADA COM SUCESSO!"
                ELSE
                    //lErro :=.T.
                ENDIF
                //	Next nCont
                iif(jBody["participantesColetivo"] == Nil,nTot := 0,nTot := Len(jBody["participantesColetivo"]))
                For nCont := 1 To nTot
                    codigoECAD :=PADL(jBody["participantesColetivo"][nCont]["codigoECAD"], TamSX3("ZZ3_CDECAD")[1], '0')
                    CONOUT( "codigoECAD"+codigoECAD)
                    DbSelectArea("ZZ3")
                    DbSetOrder(3) // INDICE DE BUSCA É PELO ECAD NESSE CASO POIS ELE PODE PARTICIPAR DA OBRA TBEM. AI ALTERO E INCLUO O ID FONOGRAMA
                    iF cOper == "I"
                        IIf(codigoECAD<>"0000000000000", !DbSeek(xFilial("ZZ3") + codigoECAD),"")
                        cDsOper := "INCLUIR"
                        RecLock("ZZ3", .T.)
                        ZZ3->ZZ3_FILIAL := xFilial("ZZ3")
                        ZZ3->ZZ3_IDPART := GetSxeNum("ZZ3", "ZZ3_IDPART")
                        ZZ3->ZZ3_IDFONO 	:= cIdFono
                        ZZ3->ZZ3_CODTIT := Posicione("SA2", 3, xFilial("SA2") + AllTrim(jBody["participantes"][nCont]["cpfCnpj"]), "A2_COD")
                        ZZ3->ZZ3_LOJATI := Posicione("SA2", 3, xFilial("SA2") + AllTrim(jBody["participantes"][nCont]["cpfCnpj"]), "A2_LOJA")
                        ZZ3->ZZ3_NMTIT  := jBody["participantes"][nCont]["nome"]
                        ZZ3->ZZ3_CPFCNP := jBody["participantes"][nCont]["cpfCnpj"]
                        ZZ3->ZZ3_CDECAD := codigoECAD
                        ZZ3->ZZ3_PSEUDO := jBody["participantes"][nCont]["pseudonimo"]
                        ZZ3->ZZ3_TIPO   := jBody["participantes"][nCont]["tipoSbacem"]
                        ZZ3->ZZ3_PERCEN := jBody["participantes"][nCont]["percentual"]
                        ZZ3->ZZ3_CATEGO := jBody["participantes"][nCont]["cdCateg"]
                        ZZ3->ZZ3_LINK   := jBody["participantes"][nCont]["link"]
                        ZZ3->(MsUnlock())
                        ZZ3->(ConfirmSx8())

                        cStatus := "OK"
                        cMsg    := "INCLUSÃO DO NOVO FONOGRAMA EXECUTADO COM SUCESSO!"
                    Else  //ALTERAÇÃO
                        cEcadFono:=cvaltochar(jBody["participantes"][nCont]["codigoECAD"] )
                        IF codigoECAD<>"0000000000000"
                            cSql := " UPDATE " + RetSqlName("ZZ3") + " " + CRLF
                            cSql += " SET " + CRLF
                            cSql += " ZZ3_NMTIT  = '" + jBody["participantes"][nCont]["nome"] + "', " + CRLF
                            cSql += " ZZ3_CPFCNP = '" + jBody["participantes"][nCont]["cpfCnpj"] + "'," + CRLF
                            cSql += " ZZ3_PSEUDO = '"  +jBody["participantes"][nCont]["pseudonimo"] + "', " + CRLF
                            cSql += " ZZ3_TIPO   = '" +jBody["participantes"][nCont]["tipoSbacem"] + "', " + CRLF
                            cSql += " ZZ3_PERCEN = '" + cValtoChar(jBody["participantes"][nCont]["percentual"]) + "', " + CRLF
                            cSql += " ZZ3_CATEGO = '" + cvaltochar(jBody["participantes"][nCont]["cdCategAut"]) + "', " + CRLF
                            cSql += " ZZ3_LINK = '" + cvaltochar(jBody["participantes"][nCont]["link"]) + "' " + CRLF
                            cSql += "WHERE " + CRLF
                            cSql += "    ZZ3_FILIAL = '" + xFilial("ZZ3") + "' AND " + CRLF
                            cSql += "    ZZ3_IDFONO = '" + cIdFono + "' AND " + CRLF
                            cSql += "    ZZ3_CDECAD = '" + codigoECAD + "' AND " + CRLF
                            cSql += "    D_E_L_E_T_ = ' ' "

                            CONOUT("SQLALZZ3"+cSql)
                            If (TcSqlExec(cSql) < 0)
                                ConOut("TCSQLError() " + CRLF + TCSQLError())
                            EndIf
                        ENDIF
                        cStatus := "OK"
                        cMsg    := "ALTERAÇÃO DO FONOGRAMA EXECUTADO COM SUCESSO!"
                    EndIf
                Next nCont
                iif(jBody["referencias"] == Nil,nTot := 0,nTot := Len(jBody["referencias"]))
                For nCont := 1 To nTot

                    dbSelectArea("ZZ7")
                    dbSetOrder(2)
                    if !dbSeek(xFilial("ZZ7")+cIdFono) .AND. cOper == "I"
                        cDsOper := "INCLUIR"
                        RecLock("ZZ7", .T.)
                        ZZ7->ZZ7_FILIAL := xFilial("ZZ7")
                        ZZ7->ZZ7_IDFONO := cIdFono
                        ZZ7->ZZ7_ECADFO := PadL(cCdEcad, TamSX3("ZZ4_CODECA")[1], '0')
                        ZZ7->ZZ7_CDSOCI := ""
                        ZZ7->ZZ7_TPCATE := ""//jBody["referencias"][nCont]["cdCateg"]
                        ZZ7->ZZ7_DESCRI := ""//jBody["referencias"][nCont]["categAut"]
                        ZZ7->(MsUnlock())
                        ZZ7->(ConfirmSx8())

                    ELSEIF cOper == "A"  // ALTERAR EPV
                        cSql := " UPDATE " + RetSqlName("ZZ7") + " " + CRLF
                        cSql += " SET " + CRLF
                        cSql += " ZZ7_CDSOCI = '"+jBody["referencias"][nCont]["cdSociRef"]+"' ,   " + CRLF
                        cSql += " ZZ7_TPCATE = '"+jBody["referencias"][nCont]["tipoCategoria"]+"' ,   " + CRLF
                        cSql += " ZZ7_DESCRI = '"+jBody["referencias"][nCont]["nome"]+"' " + CRLF
                        cSql += "WHERE " + CRLF
                        cSql += "    ZZ7_FILIAL = '" + xFilial("ZZ7") + "' AND " + CRLF
                        cSql += "    ZZ7_IDFONO = '" + cIdFono + "' AND " + CRLF
                        cSql += "    D_E_L_E_T_ = ' ' "
                        If (TcSqlExec(cSql) < 0)
                            ConOut("TCSQLError() " + CRLF + TCSQLError())
                        EndIf
                        cDsOper := "ALTERAR"
                        cStatus := "OK"
                        cMsg    := "ALTERAÇÃO DO FONOGRAMA EXECUTADA COM SUCESSO!"
                    ENDIF
                Next nCont
                
                If cOper == "D"
                    cDsOper := "EXCLUIR"
                    // Remove a Fonograma
                    cSql := "UPDATE " + RetSqlName("ZZ4") + " " + CRLF
                    cSql += "SET " + CRLF
                    cSql += "    D_E_L_E_T_ = '*' " + CRLF
                    cSql += "WHERE " + CRLF
                    cSql += "    ZZ4_FILIAL = '" + xFilial("ZZ4") + "' " + CRLF
                    cSql += "    AND ZZ4_IDFONO = '" + cIdFono + "' " + CRLF
                    cSql += "    AND D_E_L_E_T_ = ' '"

                    If (TcSqlExec(cSql) < 0)
                        ConOut("TCSQLError() " + CRLF + TCSQLError())
                        //lErro :=.T.
                    EndIf

                    cSql := "UPDATE " + RetSqlName("ZZ5") + " " + CRLF
                    cSql += "SET " + CRLF
                    cSql += "    D_E_L_E_T_ = '*' " + CRLF
                    cSql += "WHERE " + CRLF
                    cSql += "    ZZ5_FILIAL = '" + xFilial("ZZ5") + "' " + CRLF
                    cSql += "    AND ZZ5_IDFONO = '" + cIdFono + "' " + CRLF
                    cSql += "    AND D_E_L_E_T_ = ' '"

                    If (TcSqlExec(cSql) < 0)
                        ConOut("TCSQLError() " + CRLF + TCSQLError())
                        //lErro :=.T.
                    EndIf
                    cSql := "UPDATE " + RetSqlName("ZZ7") + " " + CRLF
                    cSql += "SET " + CRLF
                    cSql += "    D_E_L_E_T_ = '*' " + CRLF
                    cSql += "WHERE " + CRLF
                    cSql += "    ZZ7_FILIAL = '" + xFilial("ZZ7") + "' " + CRLF
                    cSql += "    AND ZZ7_IDFONO = '" + cIdFono + "' " + CRLF
                    cSql += "    AND D_E_L_E_T_ = ' '"

                    If (TcSqlExec(cSql) < 0)
                        ConOut("TCSQLError() " + CRLF + TCSQLError())
                        //lErro :=.T.
                    EndIf

                    cStatus := "OK"
                    cMsg    := "EXCLUSÃO DO FONOGRAMA EXECUTADA COM SUCESSO!"
                EndIf
                
                If lErro
                    cJSonRet := '{"REGISTROS":' + CRLF
                    cJSonRet += '[{"CDECAD": "NO", ' + CRLF
                    cJSonRet += '"TITULO": "NO", ' + CRLF
                    cJSonRet += '"IDFONO":  "NO", ' + CRLF
                    cJSonRet += '"codECADObra":  "NO", ' + CRLF
                    cJSonRet += '"cCDcdSoci":   "NO", ' + CRLF
                    cJSonRet += '"cdSociObra":   "NO", ' + CRLF
                    cJSonRet += '"cdECADPP":  "NO", ' + CRLF
                    cJSonRet += '"cdSocPP":  "NO", ' + CRLF
                    cJSonRet += '"cdGRA":  "NO", ' + CRLF
                    cJSonRet += '"cdISRC":  "NO", ' + CRLF
                    cJSonRet += '"dtGRavaOri":  "NO", ' + CRLF
                    cJSonRet += '"dtLancamento": "NO", ' + CRLF
                    cJSonRet += '"dtEmissao":  "NO", ' + CRLF
                    cJSonRet += '"instrumental":  "NO", ' + CRLF
                    cJSonRet += '"duracaoArquivo":  "NO", ' + CRLF
                    cJSonRet += '"cdCrowley":  "NO", ' + CRLF
                    cJSonRet += '"nacional":  "NO", ' + CRLF
                    cJSonRet += '"SiglaPais":  "NO", ' + CRLF
                    cJSonRet += '"idGenero":  "NO", ' + CRLF
                    cJSonRet += '"ClassicFono":  "NO", ' + CRLF
                    cJSonRet += '"cdSelo":  "NO", ' + CRLF
                    cJSonRet += '"idColetivo":  "NO", ' + CRLF
                    cJSonRet += '"siglaPPubl":  "NO", ' + CRLF
                    cJSonRet += '"rotulo":  "NO", ' + CRLF
                    cJSonRet += '"tipoMidia":  "NO", ' + CRLF
                    cJSonRet += '"bloqueio":  "NO", ' + CRLF
                    cJSonRet += '"motBlq":  "NO", ' + CRLF
                    cJSonRet += '"sitCadastro":  "NO", ' + CRLF
                    cJSonRet += '"cPublSim":  "NO", ' + CRLF
                    cJSonRet += '"domPublic":  "NO", ' + CRLF
                    cJSonRet += '"dtDocto":  "NO", ' + CRLF
                    cJSonRet += '"RotMusAc":  "NO", ' + CRLF
                    cJSonRet += '"cdArranjo":  "NO", ' + CRLF
                    cJSonRet += '"descrArran":  "NO", ' + CRLF
                    cJSonRet += '"cdPacote":  "NO", ' + CRLF
                    cJSonRet += '"fonoPendFic":  "NO", ' + CRLF
                    cJSonRet += '"fonoTemAudio":  "NO", ' + CRLF
                    cJSonRet += '"cdAgrega": "NO"}], ' + CRLF
                    cJSonRet += '"STATUS": "NO", ' + CRLF
                    IF cOper == "I"
                        cJSonRet += '"MSG": "ERRO NA INCLUSAO."}'
                    ELSEIF  cOper == "A"
                        cJSonRet += '"MSG": "ERRO NA ALTERAÇÃO."}'
                    eNDIF
                Else
                */
                    cJSonRet := '{"STATUS": "' + cStatus + '", ' + CRLF
                    cJSonRet += '"IDFONO": "' + cIdFono + '", ' + CRLF
                    cJSonRet += '"MSG": "' + cMsg + '"}'
                //Endif
            END TRANSACTION
        EndIf

    Else
        cJSonRet := '{"STATUS": "NO", ' + CRLF
        cJSonRet += '"IDFONO": "NO", ' + CRLF
        cJSonRet += '"MSG": "BODY INVÁLIDO"}'
    EndIf

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
    oRest:SetResponse(UPPER(cJsonRet))

Return(.T.)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Consulta do acervo de fonogramas do usuário logado
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

@Post("/sblsfonou")
User Function sblsfonou() As Logical

    Local cCDTit  := "" As Character
    Local jBody    := JsonObject():New() As Json
    Local cJSonRet := "" As Character
    Local cSql     := "" As Character
    Local cAlZZ4   := GetNextAlias() As Character
    Local cAlZZ3   := GetNextAlias() As Character
    Local cDsGener := "" As Character

    // {"CDTIT":"0511770000"}

    jBody:fromJson(oRest:GetBodyRequest())

    If jBody <> Nil
        cCDTit := jBody:GetJsonText("CDTIT")
        If CheckVar(cCDTit)
            /*
            cSql := "SELECT DISTINCT" + CRLF 
            cSql += "	ZZ3_IDFONO IDFONO " + CRLF 
            cSql += "FROM " + CRLF 
            cSql += "    " + RetSqlName("ZZ3") + " " + CRLF 
            cSql += "WHERE " + CRLF
            cSql += "	ZZ3_CODTIT+ZZ3_LOJATI = '" + cCDTit + "' AND " + CRLF
            cSql += "	D_E_L_E_T_ =' '"
            */
            cSql := "SELECT DISTINCT" + CRLF 
            cSql += "	ZZ4_IDFONO IDFONO " + CRLF 
            cSql += "FROM " + CRLF 
            cSql += "    " + RetSqlName("ZZ4") + " " + CRLF 
            cSql += "WHERE " + CRLF
            cSql += "	ZZ4_CODTIT = '" + cCDTit + "' AND " + CRLF
            cSql += "	D_E_L_E_T_ =' '"

            If Select(cAlZZ3) > 0
                (cAlZZ3)->(DbCloseArea())
            EndIf
            DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZ3, .F., .T.)
            (cAlZZ3)->(DbGoTop())
            If !(cAlZZ3)->(Eof())
			    //cJSonRet := '{"FONOGRAMA":' + CRLF
				//cJSonRet += '[' + CRLF
				While !(cAlZZ3)->(Eof())
				    cSql := "SELECT " + CRLF 
                    cSql += "	ZZ4_CODECA CDECAD, " + CRLF 
                    cSql += "	ZZ4_TITULO TITULO, " + CRLF 
                    cSql += "	ZZ4_CDGENM IDGEN, " + CRLF          
                    cSql += "	ZZ4_GENERO GENERO, " + CRLF          
                    cSql += "	ZZ4_SITCAD SITUA " + CRLF 
                    cSql += "FROM " + CRLF 
                    cSql += "    " + RetSqlName("ZZ4") + " " + CRLF 
                    cSql += "WHERE " + CRLF
                    cSql += "	ZZ4_IDFONO = '" + (cAlZZ3)->IDFONO + "' AND " + CRLF
                    cSql += "	D_E_L_E_T_ =' '"
                    If Select(cAlZZ4) > 0
                        (cAlZZ4)->(DbCloseArea())
                    EndIf
                    DbUseArea(.T., 	'TOPCONN', TCGENQRY(,, cSql), cAlZZ4, .F., .T.)
                    (cAlZZ4)->(DbGoTop())
                    if !(cAlZZ4)->(Eof())
                        cJSonRet := '{"FONOGRAMA":' + CRLF
                        cJSonRet += '[' + CRLF
                        While !(cAlZZ4)->(Eof())
                            cDsGener := alltrim((cAlZZ4)->GENERO) // Posicione("SX5", 1, xFilial('SX5') + "ZZ" + (cAlZZ4)->IDGEN, "X5_DESCRI")

                            cJSonRet += '{"IDFONO": "' + alltrim((cAlZZ3)->IDFONO) + '", '
                            cJSonRet += '"CDECAD": "' + alltrim((cAlZZ4)->CDECAD) + '", ' + CRLF
                            cJSonRet += '"TITULO": "' + alltrim((cAlZZ4)->TITULO) + '", ' + CRLF
                            cJSonRet += '"DSGEN": "' + cDsGener + '", ' + CRLF
                            cJSonRet += '"SITUA": "' +alltrim((cAlZZ4)->SITUA) + '"}' //+ CRLF

                            (cAlZZ4)->(DbSkip())
                            if !(cAlZZ4)->(Eof())
                                cJSonRet += ',' + CRLF
                            endif
                        EndDo
                        cJSonRet += '], ' + CRLF		
                        cJSonRet += '"STATUS": "OK", ' + CRLF		
                        cJSonRet += '"MSG": "CONSULTA EXECUTADA COM SUCESSO!."}'
                    else
                        cJSonRet := '{"REGISTROS":' + CRLF
                        cJSonRet += '[{"CDECAD": "NO", ' + CRLF
                        cJSonRet += '"TITULO": "NO", ' + CRLF
                        cJSonRet += '"DSGEN": "NO", ' + CRLF
                        cJSonRet += '"SITUA": "NO"}], ' + CRLF
                        cJSonRet += '"STATUS": "NO", ' + CRLF		
                        cJSonRet += '"MSG": "DADOS NAO ENCONTRADO."}'
                    endif
                    (cAlZZ4)->(DbCloseArea())																		
                (cAlZZ3)->(DbSkip())
                EndDo
                (cAlZZ3)->(DbCloseArea())

                //cJSonRet += substr(cJSonRet,1,len(cJSonRet)-3) + CRLF	
                //cJSonRet += '], ' + CRLF		
                //cJSonRet += '"STATUS": "OK", ' + CRLF		
                //cJSonRet += '"MSG": "CONSULTA EXECUTADA COM SUCESSO!."}'
            Else
                cJSonRet := '{"REGISTROS":' + CRLF
                cJSonRet += '[{"CDECAD": "NO", ' + CRLF
                cJSonRet += '"TITULO": "NO", ' + CRLF
                cJSonRet += '"DSGEN": "NO", ' + CRLF
                cJSonRet += '"SITUA": "NO"}], ' + CRLF
                cJSonRet += '"STATUS": "NO", ' + CRLF		
                cJSonRet += '"MSG": "DADOS NAO ENCONTRADO."}'
            EndIf
		Else 
            cJSonRet := '{"REGISTROS":' + CRLF
            cJSonRet += '[{"CDECAD": "NO", ' + CRLF
            cJSonRet += '"TITULO": "NO", ' + CRLF
            cJSonRet += '"DSGEN": "NO", ' + CRLF
            cJSonRet += '"SITUA": "NO"}], ' + CRLF
            cJSonRet += '"STATUS": "NO", ' + CRLF		
            cJSonRet += '"MSG": "BODY INVÁLIDO."}' 
        EndIf
	EndIf

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
    oRest:SetResponse(UPPER(cJsonRet))

Return(.T.)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Retorna todos os dados de um fonograma selecionado
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

@Post("/sbgetfono")
User Function sbgetfono() As Logical

    //Local cIdECAD  := "" As Character
    Local cIdFono  := "" As Character
    Local jBody    := JsonObject():New() As Json
    Local cJSonRet := "" As Character
    Local cAlZZ4   := GetNextAlias() As Character
    Local cAlZZ5   := GetNextAlias() As Character
    Local cAlZZ7   := GetNextAlias() As Character

    // { }"IDFONO":"0000000000013" }

    jBody:fromJson(oRest:GetBodyRequest())

    If jBody <> Nil
        //cIdECAD := jBody:GetJsonText("idECAD")
        cIdFono := jBody:GetJsonText("IDFONO")

    //        If CheckVar(cIdECAD) .or. CheckVar(cIdFono)
        If CheckVar(cIdFono)
            cSql := "SELECT " + CRLF 
            cSql += "   ZZ4_IDFONO, ZZ4_CODECA, ZZ4_CDSOCI, ZZ4_ECOBRA, ZZ4_CDSOBR, ZZ4_CDECPO, ZZ4_CDSPOU, ZZ4_CDGRA, " + CRLF
            cSql += "   ZZ4_CDISRC, ZZ4_DTGROR, ZZ4_DTLANC, ZZ4_DTEMIS, ZZ4_INSTRU, ZZ4_DURACA, ZZ4_CDCROW, ZZ4_NACION, ZZ4_SIGLPA, " + CRLF
            cSql += "   ZZ4_CODTIT, ZZ4_NOMTIT, ZZ4_CGCTIT, ZZ4_ECATIT, " + CRLF
            cSql += "   ZZ4_CDGENM, ZZ4_CLFONO, ZZ4_CDSELO, ZZ4_IDCOLE, ZZ4_SIPPUB, ZZ4_ROTULO, ZZ4_TPMIDI, ZZ4_BLOQUE, ZZ4_MOTBLQ, " + CRLF
            cSql += "   ZZ4_SITCAD, ZZ4_PUBSIM, ZZ4_DOMPUB, ZZ4_DTDOCU, ZZ4_ROTMUA, ZZ4_DTUALT, ZZ4_CDARRA, ZZ4_DSCARR, ZZ4_CDPACO, " + CRLF
            cSql += "   ZZ4_FONPIF, ZZ4_FONTAU, ZZ4_CODAGR ,ZZ4_TITULO, ZZ4_TERRIT, ZZ4_GENERO, ZZ4_PUBLIC, ZZ4_CLASSI, ZZ4_TIPMID, " + CRLF
            cSql += "   ZZ4_PACOTE, ZZ4_IDARQU " + CRLF
            cSql += "FROM " + CRLF 
            cSql += "    " + RetSqlName("ZZ4") + " (NOLOCK) " + CRLF 
            cSql += "WHERE " + CRLF
            cSql += "	ZZ4_IDFONO = '" + cIdFono + "' AND " + CRLF
            //cSql += "	ZZ4_CODECA = '" + cIdECAD + "' OR ZZ4_IDFONO = '" + cIdFono + "' " + CRLF
            cSql += "   D_E_L_E_T_ =' '"
            If Select(cAlZZ4) > 0
                (cAlZZ4)->(DbCloseArea())
            EndIf
            DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZ4, .F., .T.)

			(cAlZZ4)->(DbGoTop())
            cJSonRet := '{"FONOGRAMA":' + CRLF
//          cJSonRet += '[' + CRLF
            If !(cAlZZ4)->(Eof())
                While !(cAlZZ4)->(Eof())
               		cJSonRet += '{' + CRLF
                    cJSonRet += '"IDFONO": "' + AllTrim((cAlZZ4)->ZZ4_IDFONO) + '", ' + CRLF
                    cJSonRet += '"TITULO": "' + AllTrim((cAlZZ4)->ZZ4_TITULO) + '", ' + CRLF
                    cJSonRet += '"CODECADOBRA": "' + AllTrim((cAlZZ4)->ZZ4_CODECA) + '", ' + CRLF
                    cJSonRet += '"cCDcdSoci": "' + AllTrim((cAlZZ4)->ZZ4_CDSOCI) + '", ' + CRLF
                    cJSonRet += '"cdSociObra": "' + AllTrim((cAlZZ4)->ZZ4_CDSOBR) + '", ' + CRLF
                    cJSonRet += '"cdECADPP":"' + AllTrim((cAlZZ4)->ZZ4_CDECPO) + '", ' + CRLF
                    cJSonRet += '"cdSocPP":"' + AllTrim((cAlZZ4)->ZZ4_CDSPOU) + '", ' + CRLF
                    cJSonRet += '"cdGRA":"' + AllTrim((cAlZZ4)->ZZ4_CDGRA) + '", ' + CRLF
                    cJSonRet += '"cdISRC":"' + AllTrim((cAlZZ4)->ZZ4_CDISRC) + '", ' + CRLF
                    cJSonRet += '"CODTIT":"' + AllTrim((cAlZZ4)->ZZ4_CODTIT) + '", ' + CRLF
                    cJSonRet += '"NOMTIT":"' + AllTrim((cAlZZ4)->ZZ4_NOMTIT) + '", ' + CRLF
                    cJSonRet += '"CPFCNPJTIT":"' + AllTrim((cAlZZ4)->ZZ4_CGCTIT) + '", ' + CRLF
                    cJSonRet += '"ECADTIT":"' + AllTrim((cAlZZ4)->ZZ4_ECATIT) + '", ' + CRLF
                    cJSonRet += '"dtGRavaOri":"' + dtoc(stod((cAlZZ4)->ZZ4_DTGROR)) + '", ' + CRLF
                    cJSonRet += '"dtLancamento":"' + dtoc(stod((cAlZZ4)->ZZ4_DTLANC)) + '", ' + CRLF
                    cJSonRet += '"dtEmissao":"' + dtoc(stod((cAlZZ4)->ZZ4_DTEMIS)) + '", ' + CRLF
                    cJSonRet += '"instrumental":"' + AllTrim((cAlZZ4)->ZZ4_INSTRU) + '", ' + CRLF
                    cJSonRet += '"duracaoArquivo":"' + AllTrim((cAlZZ4)->ZZ4_DURACA) + '", ' + CRLF
                    cJSonRet += '"cdCrowley":"' + AllTrim((cAlZZ4)->ZZ4_CDCROW) + '", ' + CRLF
                    cJSonRet += '"nacional":"' + AllTrim((cAlZZ4)->ZZ4_NACION) + '", ' + CRLF
                    cJSonRet += '"SiglaPais":"' + AllTrim((cAlZZ4)->ZZ4_SIGLPA) + '", ' + CRLF
                    cJSonRet += '"TERRITORIO":"' + AllTrim((cAlZZ4)->ZZ4_TERRIT) + '", ' + CRLF
                    cJSonRet += '"idGenero":"' + AllTrim((cAlZZ4)->ZZ4_CDGENM) + '", ' + CRLF
                    cJSonRet += '"GENERO":"' + AllTrim((cAlZZ4)->ZZ4_GENERO) + '", ' + CRLF
                    cJSonRet += '"PUBLICACAO":"' + AllTrim((cAlZZ4)->ZZ4_PUBLIC) + '", ' + CRLF
                    cJSonRet += '"ClassicFono":"' + AllTrim((cAlZZ4)->ZZ4_CLFONO) + '", ' + CRLF
                    cJSonRet += '"CLASSIFICACAO":"' + AllTrim((cAlZZ4)->ZZ4_CLASSI) + '", ' + CRLF
                    cJSonRet += '"cdSelo":"' + AllTrim((cAlZZ4)->ZZ4_CDSELO) + '", ' + CRLF
                    cJSonRet += '"idColetivo":"' + AllTrim((cAlZZ4)->ZZ4_IDCOLE) + '", ' + CRLF
                    cJSonRet += '"siglaPPubl":"' + AllTrim((cAlZZ4)->ZZ4_SIPPUB) + '", ' + CRLF
                    cJSonRet += '"rotulo":"' + AllTrim((cAlZZ4)->ZZ4_ROTULO) + '", ' + CRLF
                    cJSonRet += '"tipoMidia":"' + AllTrim((cAlZZ4)->ZZ4_TPMIDI) + '", ' + CRLF
                    cJSonRet += '"DESCTIPOMIDIA":"' + AllTrim((cAlZZ4)->ZZ4_TIPMID) + '", ' + CRLF
                    cJSonRet += '"bloqueio":"' + AllTrim((cAlZZ4)->ZZ4_BLOQUE) + '", ' + CRLF
                    cJSonRet += '"motBlq":"' + AllTrim((cAlZZ4)->ZZ4_MOTBLQ) + '", ' + CRLF
                    cJSonRet += '"sitCadastro":"' + AllTrim((cAlZZ4)->ZZ4_SITCAD) + '", ' + CRLF
                    cJSonRet += '"cPublSim":"' + AllTrim((cAlZZ4)->ZZ4_PUBSIM) + '", ' + CRLF
                    cJSonRet += '"domPublic":"' + AllTrim((cAlZZ4)->ZZ4_DOMPUB) + '", ' + CRLF
                    cJSonRet += '"dtDocto":"' + dtoc(stod((cAlZZ4)->ZZ4_DTDOCU)) + '", ' + CRLF
                    cJSonRet += '"dtultalter":"' + dtoc(stod((cAlZZ4)->ZZ4_DTUALT)) + '", ' + CRLF
                    cJSonRet += '"RotMusAc":"' + AllTrim((cAlZZ4)->ZZ4_ROTMUA) + '", ' + CRLF
                    cJSonRet += '"cdArranjo":"' + AllTrim((cAlZZ4)->ZZ4_CDARRA) + '", ' + CRLF
                    cJSonRet += '"descrArran":"' + AllTrim((cAlZZ4)->ZZ4_DSCARR) + '", ' + CRLF
                    cJSonRet += '"cdPacote":"' + AllTrim((cAlZZ4)->ZZ4_CDPACO) + '", ' + CRLF
                    cJSonRet += '"PACOTE":"' + AllTrim((cAlZZ4)->ZZ4_PACOTE) + '", ' + CRLF
                    cJSonRet += '"IDARQUIVO":"' + AllTrim((cAlZZ4)->ZZ4_IDARQU) + '", ' + CRLF
                    cJSonRet += '"fonoPendFic":"' + AllTrim((cAlZZ4)->ZZ4_FONPIF) + '", ' + CRLF
                    cJSonRet += '"fonoTemAudio":"' + AllTrim((cAlZZ4)->ZZ4_FONTAU) + '", ' + CRLF
//                  cJSonRet += '"cdAgrega":"' + AllTrim((cAlZZ4)->ZZ4_CODAGR) + '"}, ' + CRLF
                    cJSonRet += '"cdAgrega":"' + AllTrim((cAlZZ4)->ZZ4_CODAGR) + '", ' + CRLF
                    cJSonRet += '"PARTICIPANTES":[' + GetPartic(cIdFono, "F","N") + '],' + CRLF
                    cJSonRet += '"PARTICIPANTESCOLETIVO":[' + GetPartic(cIdFono, "F","S") + '],' + CRLF
//					cJSonRet += '],' + CRLF

                    // Busca Coletivo
                    cSql := " SELECT 
                    cSql += "   ZZ5_IDFONO, " + CRLF 
                    cSql += "   ZZ5_ECADFO, " + CRLF
                    cSql += "   ZZ5_IDCOLE, " + CRLF
                    cSql += "   ZZ5_CDECAD, " + CRLF
                    cSql += "   ZZ5_CDSOCO, " + CRLF
                    cSql += "   ZZ5_SIGPAI, " + CRLF
                    cSql += "   ZZ5_TPCOLE, " + CRLF 
                    cSql += "   ZZ5_TIPCOL, " + CRLF 
                    cSql += "   ZZ5_NMCOLE, " + CRLF
                    cSql += "   ZZ5_NACION, " + CRLF
                    cSql += "   ZZ5_CODCAE, " + CRLF
                    cSql += "   ZZ5_NMPSCO, " + CRLF
                    cSql += "   ZZ5_DSCOMP, " + CRLF
                    cSql += "   ZZ5_DTUALT " + CRLF
                    cSql += "FROM " + CRLF 
                    cSql += "    " + RetSqlName("ZZ5") + " (NOLOCK) " + CRLF 
                    cSql += "WHERE " + CRLF
                    cSql += "	ZZ5_IDFONO = '" + cIdFono + "' " + CRLF
                    //cSql += "	ZZ5_ECADFO = '" + cIdECAD + "' OR ZZ5_IDFONO = '" + cIdFono + "' " + CRLF
                    cSql += "	AND D_E_L_E_T_ =' '"
                    If Select(cAlZZ5) > 0
                        (cAlZZ5)->(DbCloseArea())
                    EndIf
                    DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZ5, .F., .T.)
                    (cAlZZ5)->(DbGoTop())
                    cJSonRet += '"coletivo":[' + CRLF
                    While !(cAlZZ5)->(Eof())
                        cJSonRet += '{' + CRLF
                        cJSonRet += '"IdFono": "' + AllTrim((cAlZZ5)->ZZ5_IDFONO) + '", ' + CRLF
                        cJSonRet += '"IdColetivo": "' + AllTrim((cAlZZ5)->ZZ5_IDCOLE) + '", ' + CRLF
                        cJSonRet += '"ECADCole": "' + AllTrim((cAlZZ5)->ZZ5_CDECAD) + '", ' + CRLF
                        cJSonRet += '"idSocCol": "' + AllTrim((cAlZZ5)->ZZ5_IDFONO) + '", ' + CRLF
                        cJSonRet += '"siglaPCole": "' + AllTrim((cAlZZ5)->ZZ5_SIGPAI) + '", ' + CRLF
                        cJSonRet += '"tipoCole": "' + AllTrim((cAlZZ5)->ZZ5_TPCOLE) + '", ' + CRLF
                        cJSonRet += '"desctipoCole": "' + AllTrim((cAlZZ5)->ZZ5_TIPCOL) + '", ' + CRLF
                        cJSonRet += '"nomeCole": "' + AllTrim((cAlZZ5)->ZZ5_NMCOLE) + '", ' + CRLF
                        cJSonRet += '"nacional": "' + AllTrim((cAlZZ5)->ZZ5_NACION) + '", ' + CRLF
                        cJSonRet += '"idCAE": "' + AllTrim((cAlZZ5)->ZZ5_CODCAE) + '", ' + CRLF
                        cJSonRet += '"pseudonimo": "' + AllTrim((cAlZZ5)->ZZ5_NMPSCO) + '", ' + CRLF
                        cJSonRet += '"dtultalter": "' + AllTrim((cAlZZ5)->ZZ5_DTUALT) + '", ' + CRLF
                        cJSonRet += '"ZZ5_DSCOMP": "' + AllTrim((cAlZZ5)->ZZ5_DSCOMP) + '" },' + CRLF

                        (cAlZZ5)->(DbSkip())
                        cJSonRet := substr(cJSonRet,1,len(cJSonRet)-3) + CRLF
                    EndDo
                    cJSonRet += '],' + CRLF
                    (cAlZZ5)->(DbCloseArea())
			
                    // Referências
                    cSql := "SELECT " + CRLF
                    cSql += "   ZZ7_CDECAD, " + CRLF
                    cSql += "   ZZ7_CDSOCI, " + CRLF
                    cSql += "   ZZ7_DESCRI, " + CRLF
                    cSql += "   ZZ7_TPCATE, " + CRLF
                    cSql += "   ZZ7_IDOBRA, " + CRLF
                    cSql += "   ZZ7_ECADFO, " + CRLF
                    cSql += "   ZZ7_IDFONO " + CRLF 
                    cSql += "FROM " + RetSqlName("ZZ7") + " (NOLOCK) " + CRLF   
                    cSql += "WHERE " + CRLF 
                    //cSql += "   ZZ7_ECADFO = '" + cidECAD + "' OR ZZ7_IDFONO = '" + cIdFono + "' AND " + CRLF
                    cSql += "   ZZ7_IDFONO = '" + cIdFono + "' AND " + CRLF
                    cSql += "D_E_L_E_T_ = ' '"
                    If Select(cAlZZ7) > 0
                        (cAlZZ7)->(DbCloseArea())
                    EndIf
                    DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZ7, .F., .T.)
                    (cAlZZ7)->(DbGoTop())

                    cJSonRet += '"referencia":['+ CRLF            
                    While !(cAlZZ7)->(Eof())
                        cJSonRet += '{' + CRLF
                        cJSonRet += '"IdFono": "' + ALLTRIM((cAlZZ7)->ZZ7_IDFONO) + '", ' + CRLF
                        cJSonRet += '"ECADFONO": "' + ALLTRIM((cAlZZ7)->ZZ7_ECADFO) + '", ' + CRLF
                        cJSonRet += '"cdSociRef": "' + ALLTRIM((cAlZZ7)->ZZ7_CDSOCI) + '", ' + CRLF
                        cJSonRet += '"cdTipoCategoria": "' + ALLTRIM((cAlZZ7)->ZZ7_TPCATE) + '", ' + CRLF
                        cJSonRet += '"nome": "' + ALLTRIM((cAlZZ7)->ZZ7_DESCRI) + '"}, ' + CRLF

                        (cAlZZ7)->(DbSkip())
                        cJSonRet := SubStr(cJSonRet, 1, Len(cJSonRet) - 3) + CRLF	
                    EndDo
                    cJSonRet += '],' + CRLF
                    (cAlZZ7)->(DbCloseArea())

                    (cAlZZ4)->(DbSkip())
                EndDo
                (cAlZZ4)->(DbCloseArea())
        
                //cJSonRet += '{' + CRLF				
                cJSonRet += '"STATUS": "OK", ' + CRLF		
                cJSonRet += '"MSG": "CONSULTA EFETUADA COM SUCESSO!."}}'
            Else
                cJSonRet := '{"REGISTROS":' + CRLF
                cJSonRet += '[{"CDECAD": "NO", ' + CRLF
                cJSonRet += '"TITULO": "NO", ' + CRLF
                cJSonRet += '"IDFONO":  "NO", ' + CRLF
                cJSonRet += '"codECADObra":  "NO", ' + CRLF
                cJSonRet += '"cCDcdSoci":   "NO", ' + CRLF
                cJSonRet += '"cdSociObra":   "NO", ' + CRLF
                cJSonRet += '"cdECADPP":  "NO", ' + CRLF
                cJSonRet += '"cdSocPP":  "NO", ' + CRLF
                cJSonRet += '"cdGRA":  "NO", ' + CRLF
                cJSonRet += '"cdISRC":  "NO", ' + CRLF
                cJSonRet += '"CODTIT":  "NO", ' + CRLF
                cJSonRet += '"NOMTIT":  "NO", ' + CRLF
                cJSonRet += '"CPFCNPJTIT":  "NO", ' + CRLF
                cJSonRet += '"ECADTIT":  "NO", ' + CRLF
                cJSonRet += '"dtGRavaOri":  "NO", ' + CRLF
                cJSonRet += '"dtLancamento" : "NO", ' + CRLF
                cJSonRet += '"dtEmissao":  "NO", ' + CRLF
                cJSonRet += '"instrumental":  "NO", ' + CRLF
                cJSonRet += '"duracaoArquivo":  "NO", ' + CRLF
                cJSonRet += '"cdCrowley":  "NO", ' + CRLF
                cJSonRet += '"nacional":  "NO", ' + CRLF
                cJSonRet += '"SiglaPais":  "NO", ' + CRLF
                cJSonRet += '"idGenero":  "NO", ' + CRLF
                cJSonRet += '"ClassicFono":  "NO", ' + CRLF
                cJSonRet += '"cdSelo":  "NO", ' + CRLF
                cJSonRet += '"idColetivo":  "NO", ' + CRLF
                cJSonRet += '"siglaPPubl":  "NO", ' + CRLF
                cJSonRet += '"rotulo":  "NO", ' + CRLF
                cJSonRet += '"tipoMidia":  "NO", ' + CRLF
                cJSonRet += '"bloqueio":  "NO", ' + CRLF
                cJSonRet += '"motBlq":  "NO", ' + CRLF
                cJSonRet += '"sitCadastro":  "NO", ' + CRLF
                cJSonRet += '"cPublSim":  "NO", ' + CRLF
                cJSonRet += '"domPublic":  "NO", ' + CRLF
                cJSonRet += '"dtDocto":  "NO", ' + CRLF
                cJSonRet += '"RotMusAc":  "NO", ' + CRLF
                cJSonRet += '"cdArranjo":  "NO", ' + CRLF
                cJSonRet += '"descrArran":  "NO", ' + CRLF
                cJSonRet += '"cdPacote":  "NO", ' + CRLF
                cJSonRet += '"fonoPendFic":  "NO", ' + CRLF
                cJSonRet += '"fonoTemAudio":  "NO", ' + CRLF
                cJSonRet += '"cdAgrega": "NO"}], ' + CRLF
                cJSonRet += '"STATUS": "NO", ' + CRLF		
                cJSonRet += '"MSG": "DADOS NAO ENCONTRADO."}'
            EndIf
        EndIf
    Else 
		cJSonRet := '{"REGISTROS":' + CRLF
		cJSonRet += '[{"CDECAD": "NO", ' + CRLF
		cJSonRet += '"TITULO": "NO", ' + CRLF
		cJSonRet += '"SITUA": "NO"}], ' + CRLF
		cJSonRet += '"STATUS": "NO", ' + CRLF		
		cJSonRet += '"MSG": "BODY INVÁLIDO."}' 
	EndIf

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
    oRest:SetResponse(UPPER(cJsonRet))

Return(.T.)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 02/01/2024 - Adriano Ferreira - Ápia Consultoria e Sistemas
Descr. : Inteface para exibição do extrato com novo padrão
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */
@Post("/sbnewextr")
User Function sbnewextr() As Logical

    Local cCpfCnpj  := "" As Character
    Local cCompIni  := "" As Character
    Local cCompFim  := "" As Character
    Local jBody     := JsonObject():New() As Json
    Local cSql      := "" As Character
    Local cAlSA2    := GetNextAlias() As Character
    Local cJSonRet  := "" As Character
	Local cAlExtrat := GetNextAlias() As Character
	Local cAlSaldo  := GetNextAlias() As Character

    Local cAlZZ0    := GetNextAlias() As Character
    Local cAlZZ1    := GetNextAlias() As Character
    Local cAlSX3    := GetNextAlias() As Character
	Local aColEcad  := {} As Array
	Local F         := 0 As Integer
	Local cTxtCols  := "" As Character
	Local nPos      := 0 As Integer
	Local cTipo     := "" As Character
	Local cValor    := "" As Character
	Local nValor    := 0 As Double
	Local nSaldo    := 0 As Double
//	Local nPagto    := 0 As Double  
	Local aExtrato  := {} As Array
	Local aPrefix   := StrTokArr(getmv("MV_PREFEXT"),",")	// Adriano 13/03/2024
	Local cPrefix   := "" As Character
	Local cVenc, dVenc					// Adriano 07/06/2024
	Local aCreditos := {} As Array		// Adriano 11/06/2024
	Local aAcima    := {} As Array		// Adriano 11/06/2024
	Local aTemp     := {} As Array		// Adriano 18/06/2024
	Local cAnoMes   := "" as Character	// Adriano 08/08/2024
	Local nSaldoQuery := 0 As Double	// Adriano 11/10/2024
    Local nCont
//	Local aRet      := {} As Array				// Adriano 10/01/2025
//	Local cCPFacima := "" As Character			// Adriano 10/01/2025
//	Local dDtProc   := ctod("  /  /  ") As Date	// Adriano 10/01/2025
//	Local aTmp      := {} As Array				// Adriano 10/01/2025
	Private nNivel  := 0 As Integer		// Adriano 14/01/2025

    /*
    {"CPFCNPJ": "07891080704",
    "COMPET_INI": "202401",
    "COMPET_FIM": "202403",
    "ORIGEM": "ADM"}
    */

    jBody:fromJson(oRest:GetBodyRequest())

    If jBody <> Nil .and. SuperGetMV("MV_XEXTON",.F.,"S") == "S"
        cCpfCnpj := jBody:GetJsonText("CPFCNPJ")
        cCompIni := jBody:GetJsonText("COMPET_INI")
        cCompFim := jBody:GetJsonText("COMPET_FIM")
		if empty(cCompFim)
			cCompFim := cCompIni
		endif
        cOrigem := jBody:GetJsonText("ORIGEM")

        If CheckVar(cCpfCnpj) .And. CheckVar(cCompIni) .And. ;
            CheckVar(cCompFim) .And. CheckVar(cOrigem)
            cSql := "SELECT " + CRLF 
            cSql += "	A2_COD CODIGO, " + CRLF 
            cSql += "   A2_LOJA LOJA, " + CRLF 
            cSql += "   A2_XBLQEXT, " + CRLF 
            cSql += "	CASE WHEN A2_MSBLQL = '1' THEN 'S' ELSE 'N' END BLOQ " + CRLF 
            cSql += "FROM " + CRLF 
            cSql += "	" + RetSqlName("SA2") + " " + CRLF 
            cSql += "WHERE " + CRLF 
            cSql += "	A2_FILIAL = '" + xFilial("SA2") + "' AND " + CRLF 
            cSql += "	A2_CGC = '" + cCpfCnpj + "' AND " + CRLF 
            cSql += "	D_E_L_E_T_ = ' ' "
            memowrite("\tmp\sbnewextr1.txt",cSql)
            If Select(cAlSA2) > 0
                (cAlSA2)->(DbCloseArea())
            EndIf
            DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlSA2, .F., .T.)
            (cAlSA2)->(DbGoTop())
            If !(cAlSA2)->(Eof())
                If (cAlSA2)->BLOQ == "S"
                    cStatus = "BL"
                    cMensagem := "FALHA NO LOGIN. USUARIO BLOQUEADO"

                    cJSonRet += '{"TIPO": "NO", ' + CRLF
                    cJSonRet += '"DATA": "NO", ' + CRLF
                    cJSonRet += '"HISTORICO": "NO", ' + CRLF
                    cJSonRet += '"VALOR": "NO", ' + CRLF                
                elseIf (cAlSA2)->A2_XBLQEXT == "S" .and. cOrigem == "NOR" // NOR ADM
                    cStatus = "BL"
                    cMensagem := "EXTRATO INDISPONIVEL"

                    cJSonRet += '{"TIPO": "NO", ' + CRLF
                    cJSonRet += '"COMPET": "NO", ' + CRLF
                    cJSonRet += '"HISTORICO": "NO", ' + CRLF
                    cJSonRet += '"VALOR": "NO", ' + CRLF
                Else

					// Colunas da distribuição Ecad
					aColEcad := {	{"ZZ0_VLDIST","",""},;
									{"ZZ0_VLINCO","",""},;
									{"ZZ0_VLLRET","",""},;
									{"ZZ0_VLLPEN","",""},;
									{"ZZ0_VLLPAR","",""},;
									{"ZZ0_DESCMN","",""},;
									{"ZZ0_CREDMN","",""};
								}
					
					// Identifica os prefixos a serem considerados no extrato
					for F := 1 to len(aPrefix)
						cPrefix += "'"+aPrefix[F]+"',"
					next
					cPrefix := left(cPrefix,len(cPrefix)-1)

					conout("----------------------------")
					conout("cCompIni = "+cCompIni)

					cSql := ""
					
					//////////////////////////////////////////////////////////////////////////
					// Busca o saldo anterior do usuário logado (associado ou herdeiro)
					nSaldo := 0
//					cSql += "SELECT SUM(VALOR) as VALOR " + CRLF
					// Incluidas as datas nas várias unions da query abaixo para identificação da versão de relacionamento
					// Adriano 25/02/2025
					// Incluida coluna com a Origem dos dados, visando tratar os dados de ZZE separados na rotina mais abaixo 
					// que abate os pagamentos individualizados para os dependentes
					// Adriano 20/05/2025	
					cSql += "SELECT VALOR, DTA, ORIGEM " + CRLF
					cSql += "  FROM (" + CRLF

					/* Trecho comentado em 29/05/2025 pois só deve pegar o valor depois de efetivamente pago (SE5)
//					cSql += "        SELECT E2_VALOR * -1 VALOR, E2_BAIXA DTA, 'SE2' ORIGEM " + CRLF
					cSql += "        SELECT E2_SALDO * -1 VALOR, E2_BAIXA DTA, 'SE2' ORIGEM " + CRLF	// Adriano 29/05/2025
					cSql += "          FROM " + RetSqlName("SE2") + CRLF 
					cSql += "         WHERE E2_FILIAL  = '" + xFilial("SE2") + "' " + CRLF 
					cSql += "           AND E2_FORNECE = '" + AllTrim((cAlSA2)->CODIGO) + "' " + CRLF 
					cSql += "           AND E2_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "' " + CRLF 
					cSql += "           AND SUBSTRING(E2_BAIXA, 1, 6) < '" + cCompIni + "' " + CRLF 
					cSql += "           AND E2_BAIXA  <> '        ' " + CRLF 
					cSql += "           AND E2_PREFIXO in ("+cPrefix+") " + CRLF 
//					cSql += "           AND E2_FATURA  <> 'NOTFAT' " + CRLF	// Adriano 07/05/2024
					cSql += "           AND E2_FATPREF  = ' '  " + CRLF								// Adriano 07/06/2024
					cSql += "           AND (E2_FATURA  = 'NOTFAT' or E2_FATURA = ' ')  " + CRLF	// Adriano 07/06/2024
					cSql += "           AND D_E_L_E_T_ = ' ' " + CRLF 
					// Desconsidera quando houver compensação do título em SE5 - Adriano 19/09/2024
                    cSql += "	        AND NOT EXISTS (select E5_NUMERO                       " + CRLF
                    cSql += "                             from "+RetSqlName("SE5")+" t5         " + CRLF
                    cSql += "                            where t5.E5_FILIAL  = '"+xFilial("SE5")+"' " + CRLF 
                    cSql += "                              and t5.E5_CLIFOR  = E2_FORNECE       " + CRLF
                    cSql += "                              and t5.E5_LOJA    = E2_LOJA          " + CRLF
                    cSql += "                              and t5.E5_NUMERO  = E2_NUM           " + CRLF
                    cSql += "                              and (t5.E5_TIPODOC = 'CP'  or t5.E5_TIPODOC = 'VL') " + CRLF		// Adriano 29/10/2024
                    cSql += "                              and (t5.E5_MOTBX   = 'CMP' or t5.E5_MOTBX   = 'DEB') " + CRLF	// Adriano 29/10/2024
                    cSql += "                              and t5.D_E_L_E_T_ = ' ')             " + CRLF
                    cSql += "         UNION ALL " + CRLF
					*/

					// Considerar as baixas após compensação - Adriano 19/09/2024
                    cSql += "         SELECT E5_VALOR * -1 VALOR, E2_BAIXA DTA, 'BXCOMP' ORIGEM  " + CRLF 
                    cSql += "         FROM "+RetSqlName("SE5")+" t5, "+RetSqlName("SE2")+" t2 " + CRLF 
                    cSql += "         WHERE E2_FILIAL  = '" + xFilial("SE2") + "'            " + CRLF 
                    cSql += "         	and E2_FORNECE = '" + AllTrim((cAlSA2)->CODIGO) + "' " + CRLF
                    cSql += "         	and E2_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "'   " + CRLF
					cSql += "           and SUBSTRING(E2_BAIXA, 1, 6) < '" + cCompIni + "' " + CRLF 
                    cSql += "           and E2_BAIXA  <> '        '                          " + CRLF 
					cSql += "           and E2_PREFIXO in ("+cPrefix+")                      " + CRLF 
					cSql += "           and E2_FATPREF  = ' '                                " + CRLF
					cSql += "           and (E2_FATURA  = 'NOTFAT' or E2_FATURA = ' ')       " + CRLF
                    cSql += "           and t2.D_E_L_E_T_ = ' '                              " + CRLF
					cSql += "           and t5.E5_FILIAL  = '"+xFilial("SE5")+"' " + CRLF 
                    cSql += "           and t5.E5_CLIFOR  = E2_FORNECE           " + CRLF
                    cSql += "           and t5.E5_LOJA    = E2_LOJA              " + CRLF
                    cSql += "           and t5.E5_NUMERO  = E2_NUM               " + CRLF
                    cSql += "           and t5.E5_TIPODOC = 'VL'                 " + CRLF
                    cSql += "           and t5.E5_MOTBX  <> 'CMP'                " + CRLF
                    cSql += "           and t5.E5_DTCANBX = ' '                  " + CRLF
                    cSql += "           and t5.D_E_L_E_T_ = ' '                  " + CRLF

					cSql += "         UNION ALL " + CRLF 
					cSql += "        SELECT E1_VALOR VALOR, E1_BAIXA DTA, 'SE1' ORIGEM " + CRLF 
					cSql += "          FROM " + RetSqlName("SE1") + CRLF 
					cSql += "         WHERE E1_FILIAL  = '" + xFilial("SE1") + "' " + CRLF 
					cSql += "           AND E1_CLIENTE = '" + AllTrim((cAlSA2)->CODIGO) + "' " + CRLF 
					cSql += "           AND E1_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "' " + CRLF 
					cSql += "           AND SUBSTRING(E1_BAIXA, 1, 6) < '"  + cCompIni + "' " + CRLF 
					cSql += "           AND E1_BAIXA  <> '        ' " + CRLF
					cSql += "           AND E1_PREFIXO in ("+cPrefix+") " + CRLF 
					cSql += "           AND D_E_L_E_T_ = ' ' " + CRLF

					// Considerar saldo do sistema legado no saldo anterior quando o início for posterior a 09/2023
					if cCompIni > "202309"
						cSql += "     UNION ALL " + CRLF 
						cSql += "    SELECT E1_VALOR VALOR, E1_EMISSAO DTA, 'LEGADO' ORIGEM  " + CRLF 
						cSql += "      FROM " + RetSqlName("SE1") + " " + CRLF 
						cSql += "     WHERE E1_FILIAL  = '" + xFilial("SE1") + "' " + CRLF 
						cSql += "       AND E1_CLIENTE = '" + AllTrim((cAlSA2)->CODIGO) + "' " + CRLF 
						cSql += "       AND E1_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "' " + CRLF 
						cSql += "       AND SUBSTRING(E1_EMISSAO, 1, 6) = '202309' " + CRLF 
						cSql += "       AND E1_PREFIXO = 'SLD' " + CRLF 
						cSql += "       AND D_E_L_E_T_ = ' ' " + CRLF

						cSql += "     UNION ALL " + CRLF 
						cSql += "    SELECT E2_VALOR VALOR, E2_EMISSAO DTA, 'LEGADO' ORIGEM  " + CRLF 
						cSql += "      FROM " + RetSqlName("SE2") + " " + CRLF 
						cSql += "     WHERE E2_FILIAL  = '" + xFilial("SE2") + "' " + CRLF 
						cSql += "       AND E2_FORNECE = '" + AllTrim((cAlSA2)->CODIGO) + "' " + CRLF 
						cSql += "       AND E2_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "' " + CRLF 
						cSql += "       AND SUBSTRING(E2_EMISSAO, 1, 6) = '202309' " + CRLF 
						cSql += "       AND E2_PREFIXO = 'SLD' " + CRLF 
						cSql += "       AND D_E_L_E_T_ = ' ' " + CRLF

					endif

					// Considerar os recebimentos/pagamentos do Ecad do próprio no saldo anterior
					if len(alltrim(cCpfCnpj)) <> 14
						cCpfCnpj := padl(cCpfCnpj,14,"0")
					endif
					cSql += "         UNION ALL " + CRLF 
					cSql += "        SELECT (ZZ0_VLDIST + ZZ0_VLINCO + ZZ0_VLLRET + ZZ0_VLLPEN + ZZ0_VLLPAR - ZZ0_DESCMN + ZZ0_CREDMN) as VALOR, ZZ0_IDLOTE + '01' DTA, 'ZZ0' ORIGEM  " + CRLF
					cSql += "          FROM "+RetSqlName("ZZ0") + CRLF
					cSql += "         WHERE ZZ0_FILIAL = '"+xFilial("ZZ0")+"' " + CRLF
					cSql += "           AND ZZ0_CPFCGC = '"+cCpfCnpj+"' " + CRLF
					cSql += "           AND ZZ0_IDLOTE < '"+cCompIni+"' " + CRLF
					cSql += "           AND D_E_L_E_T_ = ' ' " + CRLF

					/* Revome as mensalidades não baixadas do extrato - 20/05/2025	
					// Considerar as mensalidades não baixadas no saldo anterior
					cSql += "         UNION ALL " + CRLF 
					cSql += "        SELECT E1_VALOR * -1 as VALOR, E1_VENCREA DTA, 'MENNAOBX' ORIGEM  " + CRLF
					cSql += "          FROM " + RetSqlName("SE1") + " " + CRLF 
					cSql += "         WHERE E1_FILIAL  = '" + xFilial("SE1") + "' " + CRLF 
					cSql += "           AND E1_CLIENTE = '" + AllTrim((cAlSA2)->CODIGO) + "' " + CRLF
					cSql += "           AND E1_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "' " + CRLF
					cSql += "           AND SUBSTRING(E1_VENCREA, 1, 6) < '" + cCompIni + "' " + CRLF
					cSql += "           AND E1_PREFIXO =  'MEN' " + CRLF 
					cSql += "           AND E1_BAIXA   =  '        ' " + CRLF 
					cSql += "           AND D_E_L_E_T_ = ' ' " + CRLF
					*/

					// Considerar as mensalidades BAIXADAS no saldo anterior - Adriano 04/02/2025
					cSql += "         UNION ALL " + CRLF 
                    // Amaral 05/08/2025
                    cSql += "         SELECT E5_VALOR * -1 VALOR, E1_BAIXA DTA, 'MENBX' ORIGEM  " + CRLF 
                    cSql += "         FROM "+RetSqlName("SE5")+" t5, "+RetSqlName("SE1")+" t1 " + CRLF 
                    cSql += "         WHERE E1_FILIAL  = '" + xFilial("SE1") + "'            " + CRLF 
                    cSql += "         	and E1_CLIENTE = '" + AllTrim((cAlSA2)->CODIGO) + "' " + CRLF
                    cSql += "         	and E1_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "'   " + CRLF
					cSql += "           and SUBSTRING(E1_BAIXA, 1, 6) < '" + cCompIni + "' " + CRLF 
                    cSql += "           and E1_BAIXA  <> '        '                          " + CRLF 
					cSql += "           and E1_PREFIXO = 'MEN'								 " + CRLF 
                    cSql += "           and t1.D_E_L_E_T_ = ' '                              " + CRLF
					cSql += "           and t5.E5_FILIAL  = '"+xFilial("SE5")+"' " + CRLF 
                    cSql += "           and t5.E5_CLIFOR  = E1_CLIENTE           " + CRLF
                    cSql += "           and t5.E5_LOJA    = E1_LOJA              " + CRLF
                    cSql += "           and t5.E5_NUMERO  = E1_NUM               " + CRLF
                    cSql += "           and t5.E5_MOTBX  <> 'CAN'                " + CRLF
                    cSql += "           and t5.E5_DTCANBX = ' '                  " + CRLF
                    cSql += "           and t5.D_E_L_E_T_ = ' '                  " + CRLF
                    /*
					cSql += "        SELECT E1_VALOR * -1 as VALOR, E1_BAIXA DTA, 'MENBX' ORIGEM  " + CRLF
					cSql += "          FROM " + RetSqlName("SE1") + " " + CRLF 
					cSql += "         WHERE E1_FILIAL  = '" + xFilial("SE1") + "' " + CRLF 
					cSql += "           AND E1_CLIENTE = '" + AllTrim((cAlSA2)->CODIGO) + "' " + CRLF
					cSql += "           AND E1_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "' " + CRLF
					cSql += "           AND SUBSTRING(E1_BAIXA, 1, 6) < '"  + cCompIni + "' " + CRLF 
					cSql += "           AND E1_BAIXA  <> '        ' " + CRLF
					cSql += "           AND E1_PREFIXO =  'MEN' " + CRLF 
					cSql += "           AND D_E_L_E_T_ = ' ' " + CRLF
					// Desconsidera a mensalidade quando houver CANcelamento em SE5 - Adriano 20/05/2025
                    cSql += "	        AND NOT EXISTS (select E5_NUMERO " + CRLF
                    cSql += "                             from "+RetSqlName("SE5")+" t5 " + CRLF
                    cSql += "                            where t5.E5_FILIAL  = '"+xFilial("SE5")+"' " + CRLF 
                    cSql += "                              and t5.E5_CLIFOR  = E1_CLIENTE " + CRLF
                    cSql += "                              and t5.E5_LOJA    = E1_LOJA " + CRLF
					cSql += "                              and t5.E5_PREFIXO = 'MEN' " + CRLF 
                    cSql += "                              and t5.E5_NUMERO  = E1_NUM " + CRLF
                    cSql += "                              and t5.E5_MOTBX   = 'CAN' " + CRLF
                    cSql += "                              and t5.D_E_L_E_T_ = ' ') " + CRLF
                    */
					// Considerar o IRF no saldo anterior - Adriano 21/05/2024
                    cSql += "         UNION ALL " + CRLF
					cSql += "        SELECT E2_VALOR * -1 VALOR, " + CRLF
					cSql += "               (select E2_BAIXA " + CRLF
					cSql += "                  from "+RetSqlName("SE2")+" t6 " + CRLF
					cSql += "                 where CONCAT(E2_PREFIXO, E2_NUM, E2_PARCELA, E2_TIPO, E2_FORNECE, E2_LOJA) = t4.E2_TITPAI " + CRLF
					cSql += "                   and t6.E2_FILIAL  = '" + xFilial("SE2") + "' " + CRLF
					cSql += "                   and t6.E2_FORNECE = '" + AllTrim((cAlSA2)->CODIGO) + "' " + CRLF
					cSql += "                   and t6.E2_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "' " + CRLF
					cSql += "                   and SUBSTRING(t6.E2_BAIXA, 1, 6) < '" + cCompIni + "' " + CRLF 
					cSql += "                   and t6.E2_BAIXA   <> '        ' " + CRLF
					cSql += "                   and t6.E2_PREFIXO in ("+cPrefix+") " + CRLF
					cSql += "                   and t6.E2_IRRF    = t4.E2_VALOR " + CRLF 
					cSql += "                   and t6.D_E_L_E_T_ = ' ') as DTA, 'IRF' ORIGEM  " + CRLF
					cSql += "          FROM " + RetSqlName("SE2") + " t4 " + CRLF 
					cSql += "         WHERE E2_FILIAL  = '" + xFilial("SE2") + "' " + CRLF 
					cSql += "           AND E2_NATUREZ = 'IRF' " + CRLF 
					cSql += "           AND E2_TIPO    in ('TX','TXA') " + CRLF 
					cSql += "           AND E2_TITPAI  = (select CONCAT(E2_PREFIXO, E2_NUM, E2_PARCELA, E2_TIPO, E2_FORNECE, E2_LOJA) as TITPAI " + CRLF 
					cSql += "                               from "+RetSqlName("SE2")+" t5 " + CRLF
					cSql += "                              where t5.E2_FILIAL  = '" + xFilial("SE2") + "' " + CRLF
					cSql += "                                and t5.E2_FORNECE = '" + AllTrim((cAlSA2)->CODIGO) + "' " + CRLF
					cSql += "                                and t5.E2_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "' " + CRLF
					cSql += "                                and SUBSTRING(t5.E2_BAIXA, 1, 6) < '" + cCompIni + "' " + CRLF
					cSql += "                                and t5.E2_BAIXA   <> '        ' " + CRLF 
					cSql += "                                and t5.E2_PREFIXO in ("+cPrefix+") " + CRLF 
					cSql += "                                and t5.E2_IRRF    = t4.E2_VALOR " + CRLF
					cSql += "                                and t5.D_E_L_E_T_ = ' ') " + CRLF 
					cSql += "           AND D_E_L_E_T_ = ' ' " + CRLF 

					// Considerar os lançamentos do extrato em ZZE no saldo anterior - Adriano 08/03/2024
					cSql += "         UNION ALL " + CRLF 
                    cSql += "        SELECT CASE WHEN ZZE_TIPO = 'C' " + CRLF 
					cSql += "               THEN ZZE_VALOR " + CRLF 
					cSql += "               ELSE ZZE_VALOR * -1 " + CRLF 
					cSql += "               END as VALOR, ZZE_DATA DTA, 'ZZE' ORIGEM  " + CRLF
                    cSql += "          FROM " + RetSqlName("ZZE") + " " + CRLF 
                    cSql += "         WHERE ZZE_FILIAL  = '" + xFilial("ZZE") + "' " + CRLF 
                    cSql += "           AND ZZE_COD     = '" + AllTrim((cAlSA2)->CODIGO) + "' " + CRLF
                    cSql += "           AND ZZE_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "' " + CRLF
                    cSql += "           AND SUBSTRING(ZZE_DATA, 1, 6) < '" + cCompIni + "' " + CRLF
                    cSql += "           AND D_E_L_E_T_ = ' ' " + CRLF

					/*	Esses valores já estão sendo apurados na função SaldoRecursivo, então
						esse trecho foi removido dessa query - Adriano 22/07/2024
					// Considerar os recebimentos como herdeiro no saldo anterior - Adriano 07/06/2024
					cSql += "         UNION ALL " + CRLF 
					cSql += "        select E2_VALOR as VALOR " + CRLF
					cSql += "          from "+RetSqlName("ZZ1")+" t1, " + CRLF
					cSql += "               "+RetSqlName("SE2")+" t2 " + CRLF
					cSql += "         where t1.ZZ1_FILIAL = '"+xFilial("ZZ1")+"' " + CRLF
					cSql += "           and t1.ZZ1_CDRPCE = '"+AllTrim((cAlSA2)->CODIGO)+"' " + CRLF
					cSql += "           and t1.ZZ1_LJRPCE = '"+AllTrim((cAlSA2)->LOJA)+"' " + CRLF
					cSql += "           and t1.ZZ1_TIPO   <> 'R' "	// Desconsidera os representantes - Adriano 21/05/2024
					cSql += "           and t2.E2_FILIAL  = '"+xFilial("SE2")+"' " + CRLF
					cSql += "           and t2.E2_FORNECE = t1.ZZ1_CDRPCE " + CRLF
					cSql += "           and t2.E2_LOJA    = t1.ZZ1_LJRPCE " + CRLF
					cSql += "           and t2.E2_SBCDTIT = t1.ZZ1_CDTIHE " + CRLF
					cSql += "           and t2.E2_BAIXA   <> '        ' " + CRLF 
					cSql += "           and SUBSTRING(t2.E2_BAIXA, 1, 6) < '"+cCompIni+"' " + CRLF
					cSql += "           and t2.E2_PREFIXO in ("+cPrefix+") " + CRLF 
					cSql += "           and t2.E2_FATPREF = ' ' " + CRLF								// Adriano 07/06/2024
					cSql += "           and (t2.E2_FATURA = 'NOTFAT' or t2.E2_FATURA = ' ') " + CRLF	// Adriano 07/06/2024
					cSql += "           and t1.D_E_L_E_T_ = ' ' " + CRLF
					cSql += "           and t2.D_E_L_E_T_ = ' ' " + CRLF
					*/

					// Considerar os adiantamentos no saldo anterior - Adriano 12/07/2024
					cSql += "         UNION ALL " + CRLF 
					cSql += "        SELECT E2_VALOR * -1 VALOR, E2_EMISSAO DTA, 'ADIANT' ORIGEM  " + CRLF 
					cSql += "          FROM " + RetSqlName("SE2") + CRLF 
					cSql += "         WHERE E2_FILIAL  = '" + xFilial("SE2") + "' " + CRLF 
					cSql += "           AND E2_FORNECE = '" + AllTrim((cAlSA2)->CODIGO) + "' " + CRLF 
					cSql += "           AND E2_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "' " + CRLF 
					cSql += "           AND SUBSTRING(E2_EMISSAO, 1, 6) < '" + cCompIni + "' " + CRLF 
					cSql += "           AND E2_EMISSAO  <> '        ' " + CRLF 
					cSql += "           AND E2_PREFIXO  = 'ADT' " + CRLF 
					cSql += "           AND E2_FATPREF  = ' '  " + CRLF
					cSql += "           AND (E2_FATURA  = 'NOTFAT' or E2_FATURA = ' ')  " + CRLF
					cSql += "           AND D_E_L_E_T_ = ' ' " + CRLF 

					/*
					// Considerar os pagamentos aos herdeiros no saldo anterior - Adriano 07/06/2024
					cSql += "         UNION ALL " + CRLF 
					cSql += "        select E2_VALOR * -1 as VALOR " + CRLF
					cSql += "          from "+RetSqlName("ZZ1")+" t1, " + CRLF
					cSql += "               "+RetSqlName("SE2")+" t2 " + CRLF
					cSql += "         where t1.ZZ1_FILIAL = '"+xFilial("ZZ1")+"' " + CRLF
					cSql += "           and t1.ZZ1_CDTIHE = '"+AllTrim((cAlSA2)->CODIGO)+"' " + CRLF
					cSql += "           and t1.ZZ1_LJTIHE = '"+AllTrim((cAlSA2)->LOJA)+"' " + CRLF
					cSql += "           and t1.ZZ1_TIPO   <> 'R' " + CRLF	// Desconsidera os representantes - Adriano 21/05/2024
					cSql += "           and t2.E2_FILIAL  = '"+xFilial("SE2")+"' " + CRLF
					cSql += "           and t2.E2_FORNECE = t1.ZZ1_CDRPCE " + CRLF
					cSql += "           and t2.E2_LOJA    = t1.ZZ1_LJRPCE " + CRLF
					cSql += "           and t2.E2_SBCDTIT = t1.ZZ1_CDTIHE " + CRLF
					cSql += "           and SUBSTRING(t2.E2_VENCTO, 1, 6) < '"+cCompIni+"' " + CRLF
					cSql += "           and t2.E2_PREFIXO in ("+cPrefix+") " + CRLF 
					cSql += "           and t2.E2_FATPREF = ' ' " + CRLF								// Adriano 07/06/2024
					cSql += "           and (t2.E2_FATURA = 'NOTFAT' or t2.E2_FATURA = ' ') " + CRLF	// Adriano 07/06/2024
					cSql += "           and t1.D_E_L_E_T_ = ' ' " + CRLF
					cSql += "           and t2.D_E_L_E_T_ = ' ' " + CRLF
					*/

					cSql += "       ) TAB "

					nSaldoQuery := 0  

					memowrite("\tmp\sbnewextr2.txt",cSql)
					If Select(cAlSaldo) > 0
						(cAlSaldo)->(DbCloseArea())
					EndIf
					DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlSaldo, .F., .T.)
					(cAlSaldo)->(DbGoTop())
					If !(cAlSaldo)->(Eof())

						// Abate os pagamentos individualizados para os dependentes em cada valor POSITIVO no saldo anterior
						// Adriano 29/10/2024
						while !(cAlSaldo)->(Eof())

							conout("(cAlSaldo)->VALOR = "+str((cAlSaldo)->VALOR))

							nSaldoQuery += (cAlSaldo)->VALOR

							// Somente valores positivos - Adriano 10/09/2024
							// e que não venha de ZZE - Adriano 20/05/2025
							if (cAlSaldo)->VALOR > 0 .and. (cAlSaldo)->ORIGEM <> "ZZE"
								// Apura os pagamentos aos herdeiros/cessionários/...
								nPagto := 0
								cSql := "select ZZ1_CDRPCE, ZZ1_LJRPCE, ZZ1_PERCEN, ZZ1_NMRPCE " + CRLF
								cSql += "  from "+RetSqlName("ZZ1")+" t1 " + CRLF
								cSql += " where t1.ZZ1_FILIAL = '"+xFilial("ZZ1")+"' " + CRLF
								cSql += "   and t1.ZZ1_CDTIHE = '"+AllTrim((cAlSA2)->CODIGO)+"' " + CRLF
								cSql += "   and t1.ZZ1_LJTIHE = '"+AllTrim((cAlSA2)->LOJA)+"' " + CRLF
								cSql += "   and t1.ZZ1_TIPO   <> 'R' "	// Desconsidera os representantes - Adriano 21/05/2024
								cSql += "   and t1.ZZ1_CDRPCE + t1.ZZ1_LJRPCE <> t1.ZZ1_CDTIHE + t1.ZZ1_LJTIHE " + CRLF	// Adriano 13/01/2025
								// Acessa dados da versão de relacionamento válida na data epecífica - Adriano 25/02/2025
								cSql += "   and ((ZZ1_INICIO <= '"+(cAlSaldo)->DTA+"' and ZZ1_VENCTO = '        ') or " + CRLF
								cSql += "        (ZZ1_INICIO <= '"+(cAlSaldo)->DTA+"' and ZZ1_VENCTO >= '"+(cAlSaldo)->DTA+"')) " + CRLF
								cSql += "   and t1.D_E_L_E_T_ = ' ' " + CRLF
								cSql += " order by t1.ZZ1_CDRPCE "
								memowrite("\tmp\sbnewextr2_2.txt",cSql)
								DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZ1, .F., .T.)
								(cAlZZ1)->(DbGoTop())
								while !(cAlZZ1)->(eof())

									// Calcula a parte paga a cada herdeiro no nivel atual (atual como titular)
									nValor := round(((cAlSaldo)->VALOR * (cAlZZ1)->ZZ1_PERCEN) / 100,2)
									nPagto += nValor

									conout((cAlZZ1)->ZZ1_NMRPCE+" "+str((cAlZZ1)->ZZ1_PERCEN)+" % "+str(nValor))

									(cAlZZ1)->(DbSkip())
								enddo
								(cAlZZ1)->(DbCloseArea())

								conout("nPagto = "+str(nPagto))

								// Abate o pagamento total aos dependentes do saldo
								nSaldoQuery -= nPagto
							endif

							(cAlSaldo)->(dbSkip())
						enddo

						/*
						// Somente valores positivos - Adriano 10/09/2024
						if nSaldo > 0
							// Apura os pagamentos aos herdeiros/cessionários/...
							nPagto := 0
							cSql := "select ZZ1_CDRPCE, ZZ1_LJRPCE, ZZ1_PERCEN " + CRLF
							cSql += "  from "+RetSqlName("ZZ1")+" t1 " + CRLF
							cSql += " where t1.ZZ1_FILIAL = '"+xFilial("ZZ1")+"' " + CRLF
							cSql += "   and t1.ZZ1_CDTIHE = '"+AllTrim((cAlSA2)->CODIGO)+"' " + CRLF
							cSql += "   and t1.ZZ1_LJTIHE = '"+AllTrim((cAlSA2)->LOJA)+"' " + CRLF
							cSql += "   and t1.ZZ1_TIPO   <> 'R' "	// Desconsidera os representantes - Adriano 21/05/2024
							cSql += "   and t1.D_E_L_E_T_ = ' ' " + CRLF
							cSql += " order by t1.ZZ1_CDRPCE "
							memowrite("\tmp\sbnewextr2_2.txt",cSql)
							DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZ1, .F., .T.)
							(cAlZZ1)->(DbGoTop())
							while !(cAlZZ1)->(eof())

								// Calcula a parte paga a cada herdeiro no nivel atual (atual como titular)
								nPagto += round((nSaldo * (cAlZZ1)->ZZ1_PERCEN) / 100,2)

								(cAlZZ1)->(DbSkip())
							enddo
							(cAlZZ1)->(DbCloseArea())

							conout("nPagto = "+str(nPagto))

							// Abate o pagamento total aos dependentes do saldo
							nSaldo -= nPagto
						endif
						conout("nSaldo após pagtos herdeiros = "+str(nSaldo))
						*/

                    EndIf
                    (cAlSaldo)->(DbCloseArea())

					conout("nSaldoQuery apos query do saldo = "+str(nSaldoQuery))

					// Adriano 19/06/2024
					// Loop nos meses de 01/2023 até um mes antes do início do extrato
					nSaldo := 0
					cAnoMes := "202301"
					while cAnoMes < cCompIni

						nNivel := 0
						nSaldo += SaldoRecursivo((cAlSA2)->CODIGO, (cAlSA2)->LOJA, aColEcad, cAnoMes)

						// Muda para o próximo mês
						cMes := strzero(val(right(cAnoMes,2))+1,2)
						if cMes > "12"
							cMes := "01"
							cAno := strzero(val(left(cAnoMes,4))+1,4)
						else
							cAno := left(cAnoMes,4)
						endif
						cAnoMes := cAno+cMes

					enddo
					conout("nSaldo apos recursivos = "+str(nSaldo))

					// Soma o saldo anterior vindo da query
					// Adriano 11/10/2024
					nSaldo += nSaldoQuery

					cTipo := iif(nSaldo < 0, "D", "C")
					aAdd(aExtrato,{	cTipo,;
									"00000000",;
									"SALDO ANTERIOR",;
									AllTrim(Str(abs(nSaldo))),;
									"0" })

                    //////////////////////////////////////////////////////////////////////////
					// Saldo do sistema legado
					if cCompIni <= "202309" .and. cCompFim >= "202309"

						cSql := "SELECT " + CRLF 
						cSql += "	'S'              TIPO, " + CRLF 
						cSql += "	'20230917'       COMPET, " + CRLF 
						cSql += "	'SALDO SISTEMA ANTERIOR' HISTORICO, " + CRLF
						cSql += "	SUM(VALOR)       VALOR " + CRLF
						cSql += "FROM " + CRLF 
						cSql += "	(SELECT " + CRLF 
						cSql += "		E1_VALOR VALOR " + CRLF 
						cSql += "	FROM " + CRLF 
						cSql += "		" + RetSqlName("SE1") + " " + CRLF 
						cSql += "	WHERE " + CRLF 
						cSql += "		E1_FILIAL  = '" + xFilial("SE1") + "'            AND " + CRLF 
						cSql += "		E1_CLIENTE = '" + AllTrim((cAlSA2)->CODIGO) + "' AND " + CRLF 
						cSql += "		E1_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "'   AND " + CRLF 
						cSql += "		SUBSTRING(E1_EMISSAO, 1, 6) = '202309'           AND " + CRLF 
						cSql += "		E1_PREFIXO = 'SLD'                               AND " + CRLF 
						cSql += "		D_E_L_E_T_ = ' ' " 
						cSql += "UNION ALL " + CRLF 
						cSql += "	SELECT " + CRLF 
						cSql += "		E2_VALOR VALOR " + CRLF 
						cSql += "	FROM " + CRLF 
						cSql += "		" + RetSqlName("SE2") + " " + CRLF 
						cSql += "	WHERE " + CRLF 
						cSql += "		E2_FILIAL  = '" + xFilial("SE2") + "'            AND " + CRLF 
						cSql += "		E2_FORNECE = '" + AllTrim((cAlSA2)->CODIGO) + "' AND " + CRLF 
						cSql += "		E2_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "'   AND " + CRLF 
						cSql += "		SUBSTRING(E2_EMISSAO, 1, 6) = '202309'           AND " + CRLF 
						cSql += "		E2_PREFIXO = 'SLD'                               AND " + CRLF 
						cSql += "		D_E_L_E_T_ = ' ' ) TAB " 

						memowrite("\tmp\sbnewextr3.txt",cSql)
						If Select(cAlSaldo) > 0
							(cAlSaldo)->(DbCloseArea())
						EndIf
						DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlSaldo, .F., .T.)
						(cAlSaldo)->(DbGoTop())
						If !(cAlSaldo)->(Eof())
							cTipo := iif((cAlSaldo)->VALOR < 0, "D", "C")
							aAdd(aExtrato,{	cTipo,;
											"00000000",;
											AllTrim((cAlSaldo)->HISTORICO),;
											AllTrim(Str(abs((cAlSaldo)->VALOR))),;
											"1" })
						EndIf
						(cAlSaldo)->(DbCloseArea())

					endif

					// Nome das colunas da distribuição Ecad
					cTxtCols := "("
					for F := 1 to len(aColEcad)
						cTxtCols += "'"+aColEcad[F,1]+"',"
					next
					cTxtCols := left(cTxtCols,len(cTxtCOls)-1)+")"
					cSql := "select X3_CAMPO, X3_DESCRIC, X3_ORDEM " + CRLF
					cSql += "  from "+RetSqlName("SX3") + CRLF
					cSql += " where X3_CAMPO in "+cTxtCols + CRLF
					cSql += " order by X3_ORDEM "
					memowrite("\tmp\sbnewextr4.txt",cSql)
					If Select(cAlSX3) > 0
						(cAlSX3)->(DbCloseArea())
					EndIf
					DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlSX3, .F., .T.)
					(cAlSX3)->(DbGoTop())
					while !(cAlSX3)->(eof())
						nPos := aScan(aColEcad, { |x| x[1] == (cAlSX3)->X3_CAMPO })
						if nPos <> 0
							aColEcad[nPos,2] := (cAlSX3)->X3_DESCRIC
							aColEcad[nPos,3] := (cAlSX3)->X3_ORDEM
						endif
						(cAlSX3)->(DbSkip())
					enddo
					(cAlSX3)->(DbCloseArea())

                    nPos := aScan(aColEcad, { |x| x[1] == "ZZ0_VLDIST" })
                    if nPos <> 0
                        aColEcad[nPos,2] := SuperGetMV("MV_XVLDIST",.F.,"Valor Total de Distribuição")
                    endif

                    nPos := aScan(aColEcad, { |x| x[1] == "ZZ0_VLINCO" })
                    if nPos <> 0
                        aColEcad[nPos,2] := SuperGetMV("MV_XVLINCO",.F.,"Valor Total de Incorporação")
                    endif

                    nPos := aScan(aColEcad, { |x| x[1] == "ZZ0_VLLRET" })
                    if nPos <> 0
                        aColEcad[nPos,2] := SuperGetMV("MV_XVLLRET",.F.,"Valor Total de Liberação Retido")
                    endif

                    nPos := aScan(aColEcad, { |x| x[1] == "ZZ0_VLLPEN" })
                    if nPos <> 0
                        aColEcad[nPos,2] := SuperGetMV("MV_XVLLPEN",.F.,"Valor Total de Liberação Pendente")
                    endif

                    nPos := aScan(aColEcad, { |x| x[1] == "ZZ0_VLLPAR" })
                    if nPos <> 0
                        aColEcad[nPos,2] := SuperGetMV("MV_XVLLPAR",.F.,"Valor Total de Liberação Parâmetro")
                    endif

                    nPos := aScan(aColEcad, { |x| x[1] == "ZZ0_DESCMN" })
                    if nPos <> 0
                        aColEcad[nPos,2] := SuperGetMV("MV_XDESCMN",.F.,"Valor Total de Descontos Manuais")
                    endif

                    nPos := aScan(aColEcad, { |x| x[1] == "ZZ0_CREDMN" })
                    if nPos <> 0
                        aColEcad[nPos,2] := SuperGetMV("MV_XCREDMN",.F.,"Valor Total de Créditos Manuais")
                    endif

					// Ajusta ordem dos campos no array
					aColEcad := aSort(aColEcad,,,{ |x,y| x[3] < y[3] })

					//////////////////////////////////////////////////////////////////////////
					// Distribuição Ecad do titular
					cSql := "select ZZ0_DTREPA, ZZ0_NMTIT, ZZ0_VLDIST, ZZ0_VLINCO, ZZ0_VLLRET, " + CRLF
					cSql += "        ZZ0_VLLPEN, ZZ0_VLLPAR, ZZ0_DESCMN, ZZ0_CREDMN, ZZ0_DTPROC, " + CRLF
					cSql += "        (select min(E2_VENCTO) " + CRLF
					cSql += "           from "+RetSqlName("SE2")+" t2 "+ CRLF
					cSql += "          where t2.E2_FILIAL  = '"+xFilial("SE2")+"' " + CRLF
					cSql += "            and t2.E2_SBCDTIT = '"+AllTrim((cAlSA2)->CODIGO)+"' " + CRLF
					cSql += "            and t2.E2_VENCTO >= ZZ0_DTREPA " + CRLF
					cSql += "            and t2.D_E_L_E_T_ = ' ') as VENCTO " + CRLF
					cSql += "  from "+RetSqlName("ZZ0") + CRLF
					cSql += "  where ZZ0_FILIAL  = '"+xFilial("ZZ0")+"' " + CRLF
					cSql += "    and ZZ0_CPFCGC  = '"+cCpfCnpj+"' " + CRLF
					cSql += "    and ZZ0_IDLOTE >= '"+cCompIni+"' " + CRLF
					cSql += "    and ZZ0_IDLOTE <= '"+cCompFim+"' " + CRLF
					cSql += "    and D_E_L_E_T_  = ' ' " + CRLF
					cSql += "  order by ZZ0_IDLOTE "
					memowrite("\tmp\sbnewextr5_1.txt",cSql)
					If Select(cAlZZ0) > 0
						(cAlZZ0)->(DbCloseArea())
					EndIf
					DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZ0, .F., .T.)
					(cAlZZ0)->(DbGoTop())
					if !(cAlZZ0)->(eof())
						while !(cAlZZ0)->(eof())

							if !empty((cAlZZ0)->ZZ0_DTPROC)
								cVenc := (cAlZZ0)->ZZ0_DTPROC
							else
								dVenc := stod((cAlZZ0)->VENCTO) - 6	// Retorna 6 dias do vencimento
								cVenc := dtos(dVenc)
							endif

							for F := 1 to len(aColEcad)
								cTipo  := iif(alltrim(aColEcad[F,1]) <> "ZZ0_DESCMN", "C", "D")
								cValor := (cAlZZ0)->(aColEcad[F,1])
								nValor := &(cValor)
								aAdd(aExtrato,{	cTipo,;
												AllTrim(cVenc),;
												AllTrim(aColEcad[F,2]),;
												AllTrim(Str(nValor)),;
												aColEcad[F,3] })

								// Adriano 11/06/2024
								nValor := iif(cTipo=="C", nValor, nValor*-1)
								nPos := aScan(aCreditos, { |x| x[1] == left(cVenc,6) })
								if nPos <> 0
									aCreditos[nPos,2] += nValor
								else
									aAdd(aCreditos, {left(cVenc,6), nValor, cVenc})
								endif

							next
							(cAlZZ0)->(DbSkip())
						enddo

					endif
					(cAlZZ0)->(DbCloseArea())

					// Busca outros créditos recursivamente acima até atingir o titular inicial
					// Adriano 18/06/2024
					cAnoMes := cCompIni
					while cAnoMes <= cCompFim

// Chamada substituida pelo trecho em seguida:
						nNivel := 0
						aTemp := CredRecursivo((cAlSA2)->CODIGO, (cAlSA2)->LOJA, aColEcad, cAnoMes)
/*
						aTemp := {}

