									aRet[nPos,2] := round((aRet[nPos,2] * (cAlZZ1)->ZZ1_PERCEN) / 100,2)
								endif
							endif

							(cAlZZ1)->(dbSkip())
						enddo
						(cAlZZ1)->(DbCloseArea())

						aTemp := aRet
*/
						if len(aTemp) > 0
							for F := 1 to len(aTemp)
								aAdd(aAcima, aTemp[F])
							next
						endif

						cMes := strzero(val(right(cAnoMes,2))+1,2)
						if cMes > "12"
							cMes := "01"
							cAno := strzero(val(left(cAnoMes,4))+1,4)
						else
							cAno := left(cAnoMes,4)
						endif
						cAnoMes := cAno+cMes

					enddo

					// Ordena o array de créditos do nível acima por competência - Adriano 11/06/2024
					if len(aAcima) > 0
						aAcima := aSort(aAcima,,,{ |x,y| x[1]+x[4] < y[1]+y[4] })
					endif

					varinfo("aAcima",aAcima)

					//////////////////////////////////////////////////////////////////////////
					// Pagamentos aos herdeiros, cessionários, etc.
					aTipo := {}	// Adriano 07/05/2024
					aAdd(aTipo, {"H","Herdeiro(a)"})
					aAdd(aTipo, {"C","Cessão"})
					aAdd(aTipo, {"E","Espolio"})
					aAdd(aTipo, {"R","Representante"})
					aAdd(aTipo, {"P","Procuração"})
					aAdd(aTipo, {"J","Pagto em Juizo"})

					// Operação invertida neste ponto: primeiro loop nos meses, depois busca em ZZ1 conforme o mes
					// Adriano 25/02/2025
					// Loop nos meses com crédito
					for F := 1 to len(aAcima)

						// Relaciona no extrato os créditos do nivel acima, com valores acumulados dos níveis superiores
						// Adriano 18/06/2024
						cSql := "select ZZ1_CDTIHE, ZZ1_LJTIHE, ZZ1_NMTIHE, ZZ1_TIPO " + CRLF
						cSql += "  from "+RetSqlName("ZZ1")+" t1 " + CRLF
						cSql += " where t1.ZZ1_FILIAL = '"+xFilial("ZZ1")+"' " + CRLF
						cSql += "   and t1.ZZ1_CDRPCE = '"+AllTrim((cAlSA2)->CODIGO)+"' " + CRLF
						cSql += "   and t1.ZZ1_LJRPCE = '"+AllTrim((cAlSA2)->LOJA)+"' " + CRLF
						// Não desconsidera o representante quando é ele que está consultando o extrato
						// Adriano 09/01/2025
	//					cSql += "   and t1.ZZ1_TIPO   <> 'R' "	// Desconsidera os representantes - Adriano 21/05/2024
						cSql += "   and t1.ZZ1_CDRPCE + t1.ZZ1_LJRPCE <> t1.ZZ1_CDTIHE + t1.ZZ1_LJTIHE " + CRLF	// Adriano 13/01/2025
						// Acessa dados da versão de relacionamento válida no mês de processamento - Adriano 25/02/2025
						// aAcima = {ZZ0_IDLOTE, nValor, ZZ0_DTPROC, ZZ1_CDTIHE, ZZ1_LJTIHE}
						cSql += "   and ((t1.ZZ1_INICIO <= '"+aAcima[F,1]+"31' and t1.ZZ1_VENCTO = '        ') or " + CRLF
						cSql += "        (t1.ZZ1_INICIO <= '"+aAcima[F,1]+"31' and t1.ZZ1_VENCTO >= '"+aAcima[F,1]+"01')) " + CRLF
						cSql += "   and t1.D_E_L_E_T_ = ' ' " + CRLF
						cSql += " order by t1.ZZ1_CDRPCE "
						memowrite("\tmp\sbnewextr5_4.txt",cSql)
						If Select(cAlZZ1) > 0
							(cAlZZ1)->(DbCloseArea())
						EndIf
						DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZ1, .F., .T.)
						(cAlZZ1)->(DbGoTop())
						while !(cAlZZ1)->(eof())

							if aAcima[F,4] = (cAlZZ1)->ZZ1_CDTIHE .and. aAcima[F,5] = (cAlZZ1)->ZZ1_LJTIHE .and. aAcima[F,6] = (cAlZZ1)->ZZ1_TIPO

								cTipo := ""
								nPos := aScan(aTipo, { |x| x[1] == (cAlZZ1)->ZZ1_TIPO })
								if nPos <> 0
									cTipo := aTipo[nPos,2]
								endif

								nValor := aAcima[F,2]
								if nValor <> 0
									aAdd(aExtrato,{	"C",;
													AllTrim(aAcima[F,3]),;
													"Transferência por "+cTipo+" do titular "+AllTrim((cAlZZ1)->ZZ1_NMTIHE),;
													AllTrim(Str(nValor)),;
													"99" })
									// Acumula o valor nos créditos do usuário atual
									nPos := aScan(aCreditos, { |x| x[1] == aAcima[F,1] })
									if nPos <> 0
										aCreditos[nPos,2] += nValor
									else
										aAdd(aCreditos, {aAcima[F,1], nValor, aAcima[F,3]})
									endif
								endif

							endif

							(cAlZZ1)->(dbSkip())
						enddo
						(cAlZZ1)->(DbCloseArea())

					next

					// Ordena o array de créditos por competência - Adriano 11/06/2024
					if len(aCreditos) > 0
						aCreditos := aSort(aCreditos,,,{ |x,y| x[1] < y[1] })
					endif

					// Operação também invertida neste ponto: primeiro loop nos meses, depois busca em ZZ1 conforme o mes
					// Adriano 06/03/2025
					// Loop nos meses com crédito
					for F := 1 to len(aCreditos)

						// Adriano 11/06/2024 - ajuste para buscar as transferências com base 
						// no rateio dos créditos/débitos do titular na competência
						cSql := "select ZZ1_CDRPCE, ZZ1_LJRPCE, ZZ1_NMRPCE, ZZ1_TIPO, ZZ1_PERCEN " + CRLF
						cSql += "  from "+RetSqlName("ZZ1")+" t1 " + CRLF
						cSql += " where t1.ZZ1_FILIAL = '"+xFilial("ZZ1")+"' " + CRLF
						cSql += "   and t1.ZZ1_CDTIHE = '"+AllTrim((cAlSA2)->CODIGO)+"' " + CRLF
						cSql += "   and t1.ZZ1_LJTIHE = '"+AllTrim((cAlSA2)->LOJA)+"' " + CRLF
						cSql += "   and t1.ZZ1_TIPO   <> 'R' "	// Desconsidera os representantes - Adriano 21/05/2024
						cSql += "   and t1.ZZ1_CDRPCE + t1.ZZ1_LJRPCE <> t1.ZZ1_CDTIHE + t1.ZZ1_LJTIHE " + CRLF	// Adriano 13/01/2025
						// Acessa dados da versão de relacionamento válida no mês de processamento - Adriano 25/02/2025
						// aCreditos = {ZZ0_IDLOTE, nValor, ZZ0_DTPROC}
						cSql += "   and ((t1.ZZ1_INICIO <= '"+aCreditos[F,1]+"31' and t1.ZZ1_VENCTO = '        ') or " + CRLF
						cSql += "        (t1.ZZ1_INICIO <= '"+aCreditos[F,1]+"31' and t1.ZZ1_VENCTO >= '"+aCreditos[F,1]+"01')) " + CRLF
						cSql += "   and t1.D_E_L_E_T_ = ' ' " + CRLF
						cSql += " order by t1.ZZ1_CDRPCE "
						memowrite("\tmp\sbnewextr6_"+aCreditos[F,1]+".txt",cSql)
						If Select(cAlZZ1) > 0
							(cAlZZ1)->(DbCloseArea())
						EndIf
						DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZ1, .F., .T.)
						(cAlZZ1)->(DbGoTop())
						while !(cAlZZ1)->(eof())

							// Adriano 07/05/2024
							cTipo := ""
							nPos := aScan(aTipo, { |x| x[1] == (cAlZZ1)->ZZ1_TIPO })
							if nPos <> 0
								cTipo := aTipo[nPos,2]
							endif

							// Calcula valor com base % de repase sobre o valor de créditos do período
							cDataProc := aCreditos[F,3]
							nValor := round((aCreditos[F,2] * (cAlZZ1)->ZZ1_PERCEN) / 100,2)

							if nValor <> 0
								aAdd(aExtrato,{	"D",;
												AllTrim(cDataProc),;
												"Transferência para "+cTipo+" "+AllTrim((cAlZZ1)->ZZ1_NMRPCE),;
												AllTrim(Str(nValor)),;
												"99" })
							endif

							(cAlZZ1)->(DbSkip())
						enddo
						(cAlZZ1)->(DbCloseArea())

					next

