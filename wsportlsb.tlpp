										dDtProc := aTmp[F,3]
									endif
								next

								// Somente na última passada, saindo da recursividade:
								// Soma o valor já existente (do próprio, se houver) que está no array aRet, 
								// no Valor que será base para o cálculo da sua parte.
								// Adriano 11/10/2024
								nPos := aScan(aRet, { |x| x[1] == cAnoMes .and. x[4] == (cAlZZ1)->ZZ1_CDTIHE .and. x[5] == (cAlZZ1)->ZZ1_LJTIHE })
								if nPos <> 0
									nValor += aRet[nPos,2]
								endif

								// Aplica percentual sobre o valor obtido da função recursiva
