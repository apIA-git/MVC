                                            (cAlExtrat)->ORDEM })
                        Next

                        (cAlExtrat)->(DbSkip())
                    
                    EndDo
					
					(cAlExtrat)->(DbCloseArea())

					//////////////////////////////////////////////////////////////////////////
					// Busca os lançamentos do extrato na tabela ZZE na competência 
					// do usuário logado (associado ou herdeiro) - Adriano 08/03/2024
                    cSql := "SELECT ZZE_TIPO  TIPO, " + CRLF
                    cSql += "       ZZE_DATA  COMPET, " + CRLF
                    cSql += "       ZZE_HIST  HISTORICO, " + CRLF
                    cSql += "       ZZE_VALOR VALOR " + CRLF
                    cSql += "  FROM " + RetSqlName("ZZE") + " " + CRLF 
                    cSql += " WHERE ZZE_FILIAL  = '" + xFilial("ZZE") + "' " + CRLF 
                    cSql += "   AND ZZE_COD     = '" + AllTrim((cAlSA2)->CODIGO) + "' " + CRLF
                    cSql += "   AND ZZE_LOJA    = '" + AllTrim((cAlSA2)->LOJA) + "' " + CRLF
                    cSql += "   AND SUBSTRING(ZZE_DATA, 1, 6) >= '" + cCompIni + "' " + CRLF
                    cSql += "   AND SUBSTRING(ZZE_DATA, 1, 6) <= '" + cCompFim + "' " + CRLF
                    cSql += "   AND D_E_L_E_T_ = ' ' " + CRLF 
                    memowrite("\tmp\sbnewextr9.txt",cSql)
                    If Select(cAlExtrat) > 0
                        (cAlExtrat)->(DbCloseArea())
                    EndIf
                    DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlExtrat, .F., .T.)
                    (cAlExtrat)->(DbGoTop())
					if !(cAlExtrat)->(Eof())
						While !(cAlExtrat)->(Eof())
							cTipo := iif((cAlExtrat)->TIPO = "C", "97", "99")
							aAdd(aExtrato,{	AllTrim((cAlExtrat)->TIPO),;
											AllTrim((cAlExtrat)->COMPET),;
											AllTrim((cAlExtrat)->HISTORICO),;
											AllTrim(Str((cAlExtrat)->VALOR)),;
											cTipo })
							(cAlExtrat)->(DbSkip())
						EndDo
					endif
					(cAlExtrat)->(DbCloseArea())

					/*
					//////////////////////////////////////////////////////////////////////////
					// Saldo final
                    cJSonRet += '{"TIPO": "S", ' + CRLF
                    cJSonRet += '"DATA": "999999", ' + CRLF
                    cJSonRet += '"HISTORICO": "SALDO FINAL", ' + CRLF
                    cJSonRet += '"VALOR": "' + AllTrim(Str(nSaldo)) + '"}], ' + CRLF
					*/

					// Ordena o array por data + controle + tipo + histórico
					aExtrato := aSort(aExtrato,,,{ |x,y| x[2]+x[5]+x[1]+x[3] < y[2]+y[5]+y[1]+y[3] })

					// Gera o JSON final
                    cJSonRet := '{"REGISTROS":[' + CRLF
					for F := 1 to len(aExtrato)
						cTipo := iif(F <> len(aExtrato), ", ", "],")
						cJSonRet += '{"TIPO": "'	+ aExtrato[F,1] +	'", ' + CRLF
						cJSonRet += '"DATA": "'		+ aExtrato[F,2] +	'", ' + CRLF
						cJSonRet += '"HISTORICO": "'+ aExtrato[F,3] +	'", ' + CRLF
						cJSonRet += '"VALOR": "'	+ aExtrato[F,4] +	'"}'+cTipo + CRLF
					next

                    cStatus = "OK"
                    cMensagem := "DADOS RETORNADOS COM SUCESSO."	
                EndIf
                cJSonRet += '"STATUS": "' + cStatus + '", ' + CRLF			
                cJSonRet += '"MSG": "' + cMensagem + '"}'
            Else
                cJSonRet := '{"REGISTROS":' + CRLF
                cJSonRet += '[{"TIPO": "NO", ' + CRLF
                cJSonRet += '"DATA": "NO", ' + CRLF
                cJSonRet += '"HISTORICO": "NO", ' + CRLF
                cJSonRet += '"VALOR": "NO"}], ' + CRLF
                cJSonRet += '"STATUS": "NO", ' + CRLF		
                cJSonRet += '"MSG": "USUARIO NAO ENCONTRADO."}'
            EndIf
            (cAlSA2)->(dbCloseArea())
        EndIf
    Else 
        cJSonRet := '{"REGISTROS":' + CRLF
        cJSonRet += '[{"TIPO": "NO", ' + CRLF
        cJSonRet += '"DATA": "NO", ' + CRLF
        cJSonRet += '"HISTORICO": "NO", ' + CRLF
        cJSonRet += '"VALOR": "NO"}], ' + CRLF
        cJSonRet += '"STATUS": "BL", ' + CRLF		
        cJSonRet += '"MSG": "EXTRATO INDISPONIVEL."}' 
    EndIf

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
    oRest:SetResponse(UPPER(cJsonRet))
    memowrite("\tmp\sbnewextr10.txt",UPPER(cJsonRet))

Return(.T.)


/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 18/06/2024 - Adriano Ferreira - Ápia Consultoria e Sistemas
Descr. : Busca recursiva dos créditos de Ecad no nível superior
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */
Static Function CredRecursivo(cCod, cLoja, aColEcad, cAnoMes)

	Local F         := 0 As Integer
	Local cCPFacima := "" As Character
    Local cAlZZ0    := GetNextAlias() As Character
    Local cAlACI    := GetNextAlias() As Character
	Local aRet      := {} As Array
	Local aTmp      := {} As Array
	Local nPos      := 0 As Integer
	Local dDtProc   := ctod("  /  /  ") As Date
	Local nValor    := 0  as Double

	nNivel ++

	// Apura o total de créditos/debitos do Ecad no nível superior
	// Identifica titulares do dependente (atual) e seu percentual
	cSql := "select ZZ1_CDTIHE, ZZ1_LJTIHE, ZZ1_PERCEN, A2_CGC, A2_NOME, A2_COD, ZZ1_TIPO " + CRLF
	cSql += "  from "+RetSqlName("ZZ1")+" t1, " + CRLF
	cSql += "       "+RetSqlName("SA2")+" t2 " + CRLF
	cSql += " where t1.ZZ1_FILIAL = '"+xFilial("ZZ1")+"' " + CRLF
	cSql += "   and t1.ZZ1_CDRPCE = '"+AllTrim(cCod)+"' " + CRLF
	cSql += "   and t1.ZZ1_LJRPCE = '"+AllTrim(cLoja)+"' " + CRLF
	cSql += "   and t1.D_E_L_E_T_ = ' ' " + CRLF
	cSql += "   and t2.A2_FILIAL  = '"+xFilial("SA2")+"' " + CRLF
	cSql += "   and t2.A2_COD     = ZZ1_CDTIHE " + CRLF
	cSql += "   and t2.A2_LOJA    = ZZ1_LJTIHE " + CRLF
	cSql += "   and t1.ZZ1_CDRPCE + t1.ZZ1_LJRPCE <> t1.ZZ1_CDTIHE + t1.ZZ1_LJTIHE " + CRLF	// Adriano 13/01/2025
	// Acessa dados da versão de relacionamento válida no mês de processamento - Adriano 06/03/2025
	cSql += "   and ((t1.ZZ1_INICIO <= '"+cAnoMes+"31' and t1.ZZ1_VENCTO = '        ') or " + CRLF
	cSql += "        (t1.ZZ1_INICIO <= '"+cAnoMes+"31' and t1.ZZ1_VENCTO >= '"+cAnoMes+"01')) " + CRLF
	cSql += "   and t2.D_E_L_E_T_ = ' ' " + CRLF

	conout(cSql)

	DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlACI, .F., .T.)
	while !(cAlACI)->(eof())

//		conout("Credito Recursivo - nivel "+alltrim(str(nNivel))+": "+(cAlACI)->A2_CGC+" "+(cAlACI)->A2_NOME+" "+(cAlACI)->A2_COD)

		cCPFacima := alltrim((cAlACI)->A2_CGC)
		if len(cCPFacima) <> 14
			cCPFacima := padl(cCPFacima,14,"0")
		endif

		nPos := 0
		dDtProc := ctod("  /  /  ")

		// Recebimentos do Ecad do titular
		cSql := "select ZZ0_IDLOTE, ZZ0_NMTIT, ZZ0_VLDIST, ZZ0_VLINCO, ZZ0_VLLRET, " + CRLF
		cSql += "        ZZ0_VLLPEN, ZZ0_VLLPAR, ZZ0_DESCMN, ZZ0_CREDMN, ZZ0_DTPROC " + CRLF
		cSql += "  from "+RetSqlName("ZZ0") + CRLF
		cSql += "  where ZZ0_FILIAL = '"+xFilial("ZZ0")+"' " + CRLF
		cSql += "    and ZZ0_CPFCGC = '"+cCPFacima+"' " + CRLF
		cSql += "    and ZZ0_IDLOTE = '"+cAnoMes+"' " + CRLF
		cSql += "    and D_E_L_E_T_ = ' ' " + CRLF
//		conout(cSql)
		DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZ0, .F., .T.)
		(cAlZZ0)->(DbGoTop())
		while !(cAlZZ0)->(eof())

			for F := 1 to len(aColEcad)
				cTipo  := iif(alltrim(aColEcad[F,1]) <> "ZZ0_DESCMN", "C", "D")
				cValor := (cAlZZ0)->(aColEcad[F,1])
				nValor := &(cValor)
				nValor := iif(cTipo=="C", nValor, nValor*-1)
				nPos := aScan(aRet, { |x| x[1] == (cAlZZ0)->ZZ0_IDLOTE .and. x[4] == (cAlACI)->ZZ1_CDTIHE .and. x[5] == (cAlACI)->ZZ1_LJTIHE .and. x[6] == (cAlACI)->ZZ1_TIPO })
				if nPos <> 0
					aRet[nPos,2] += nValor
				else
					aAdd(aRet, {(cAlZZ0)->ZZ0_IDLOTE, nValor, (cAlZZ0)->ZZ0_DTPROC, (cAlACI)->ZZ1_CDTIHE, (cAlACI)->ZZ1_LJTIHE, (cAlACI)->ZZ1_TIPO})
				endif
			next
			dDtProc := (cAlZZ0)->ZZ0_DTPROC

			(cAlZZ0)->(DbSkip())
		enddo
		(cAlZZ0)->(DbCloseArea())

		varinfo("N:"+alltrim(str(nNivel))+" - aRet",aRet)

		// Chama a função novamente para buscar os crédito/débitos Ecad do nivel acima
		aTmp := CredRecursivo((cAlACI)->ZZ1_CDTIHE, (cAlACI)->ZZ1_LJTIHE, aColEcad, cAnoMes)

		varinfo("N:"+alltrim(str(nNivel))+" - aTmp",aTmp)

		if len(aTmp) > 0
			// Retornaram valores da função recursiva
			nValor := 0
			for F := 1 to len(aTmp)
				//nValor += aTmp[F,2]	// Aqui havia uma soma indevida - corrigido em 11/06/2025
				if empty(dDtProc) .and. !empty(aTmp[F,3])
					dDtProc := aTmp[F,3]
				endif
			next
//			conout("Valor-1: "+alltrim(str(nValor)))

			// Somente na última passada, saindo da recursividade:
			// Soma o valor já existente (do próprio, se houver) que está no array aRet, 
			// no Valor que será base para o cálculo da sua parte.
			// Adriano 11/10/2024
			nPos := aScan(aRet, { |x| x[1] == cAnoMes .and. x[4] == (cAlACI)->ZZ1_CDTIHE .and. x[5] == (cAlACI)->ZZ1_LJTIHE .and. x[6] == (cAlACI)->ZZ1_TIPO })
			if nPos <> 0
				nValor += aRet[nPos,2]
			endif
//			conout("Valor-2: "+alltrim(str(nValor)))

			// Aplica percentual sobre o valor obtido da função recursiva
			nValor := round((nValor * (cAlACI)->ZZ1_PERCEN) / 100,2)
//			conout("Valor-3: "+alltrim(str(nValor)))

			nPos := aScan(aRet, { |x| x[1] == cAnoMes .and. x[4] == (cAlACI)->ZZ1_CDTIHE .and. x[5] == (cAlACI)->ZZ1_LJTIHE .and. x[6] == (cAlACI)->ZZ1_TIPO })
			if nPos <> 0
   				aRet[nPos,2] := nValor	// Adriano 11/10/2024
			else
				aAdd(aRet, {cAnoMes, nValor, dDtProc, (cAlACI)->ZZ1_CDTIHE, (cAlACI)->ZZ1_LJTIHE, (cAlACI)->ZZ1_TIPO})
			endif
		else
			// Não retornaram valores da função recursiva
			// Calcula a parte do recebimento no nivel atual (dependente)
			if nPos <> 0 .and. len(aRet) >= nPos
				nValor := aRet[nPos,2]
//				conout("Valor-4: "+alltrim(str(nValor)))
				nValor := round((nValor * (cAlACI)->ZZ1_PERCEN) / 100,2)				
//				conout("Valor-5: "+alltrim(str(nValor)))
				aRet[nPos,2] := nValor
			endif
		endif
//		conout("nValor = "+alltrim(str(nValor)))

		(cAlACI)->(dbSkip())
	enddo
	(cAlACI)->(DbCloseArea())

	nNivel --

return aRet


/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 19/06/2024 - Adriano Ferreira - Ápia Consultoria e Sistemas
Descr. : Apura o saldo recursivo (créditos/débitos de níveis superiores) anterior ao mês inicial
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */
Static Function SaldoRecursivo(cCod, cLoja, aColEcad, cAnoMes)

	Local nSaldo    := 0 as Double
	Local nValor    := 0 as Double
	Local nPagto    := 0 as Double
	Local F         := 0 As Integer
	Local cAlACI    := GetNextAlias() As Character
	Local cAlZZ1    := GetNextAlias() As Character
	Local cAlZZ0    := GetNextAlias() As Character
	Local cSql
	Local cTitAcima := "" as Character
	Local cLojAcima := "" as Character
	Local nValTemp  := 0  as Double
	Local cCPFacima := "" as Character
	Local nValRet   := 0  as Double

	nNivel ++

	// Apura o total de créditos/debitos do Ecad no nível superior
	// Identifica titular do dependente (atual) e seu percentual
	cSql := "select ZZ1_CDTIHE, ZZ1_LJTIHE, ZZ1_PERCEN, A2_CGC, A2_NOME, A2_COD, ZZ1_TIPO " + CRLF
	cSql += "  from "+RetSqlName("ZZ1")+" t1, " + CRLF
	cSql += "       "+RetSqlName("SA2")+" t2 " + CRLF
	cSql += " where t1.ZZ1_FILIAL = '"+xFilial("ZZ1")+"' " + CRLF
	cSql += "   and t1.ZZ1_CDRPCE = '"+AllTrim(cCod)+"' " + CRLF
	cSql += "   and t1.ZZ1_LJRPCE = '"+AllTrim(cLoja)+"' " + CRLF
	cSql += "   and t1.D_E_L_E_T_ = ' ' " + CRLF
	cSql += "   and t2.A2_FILIAL  = '"+xFilial("SA2")+"' " + CRLF
	cSql += "   and t2.A2_COD     = ZZ1_CDTIHE " + CRLF
	cSql += "   and t2.A2_LOJA    = ZZ1_LJTIHE " + CRLF
	cSql += "   and t1.ZZ1_CDRPCE + t1.ZZ1_LJRPCE <> t1.ZZ1_CDTIHE + t1.ZZ1_LJTIHE " + CRLF	// Adriano 13/01/2025
	// Acessa dados da versão de relacionamento válida no mês de processamento - Adriano 06/03/2025
	cSql += "   and ((t1.ZZ1_INICIO <= '"+cAnoMes+"31' and t1.ZZ1_VENCTO = '        ') or " + CRLF
	cSql += "        (t1.ZZ1_INICIO <= '"+cAnoMes+"31' and t1.ZZ1_VENCTO >= '"+cAnoMes+"01')) " + CRLF
	cSql += "   and t2.D_E_L_E_T_ = ' ' " + CRLF
	DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlACI, .F., .T.)
	while !(cAlACI)->(eof())

		cTitAcima := (cAlACI)->ZZ1_CDTIHE
		cLojAcima := (cAlACI)->ZZ1_LJTIHE

		cCPFacima := alltrim((cAlACI)->A2_CGC)
		if len(cCPFacima) <> 14
			cCPFacima := padl(cCPFacima,14,"0")
		endif

		// Recebimentos do Ecad do titular
		nValTemp := 0
		cSql := "select ZZ0_IDLOTE, ZZ0_VLDIST, ZZ0_VLINCO, ZZ0_VLLRET, " + CRLF
		cSql += "        ZZ0_VLLPEN, ZZ0_VLLPAR, ZZ0_DESCMN, ZZ0_CREDMN " + CRLF
		cSql += "  from "+RetSqlName("ZZ0") + CRLF
		cSql += "  where ZZ0_FILIAL = '"+xFilial("ZZ0")+"' " + CRLF
		cSql += "    and ZZ0_CPFCGC = '"+cCPFacima+"' " + CRLF
		cSql += "    and ZZ0_IDLOTE = '"+cAnoMes+"' " + CRLF
		cSql += "    and D_E_L_E_T_ = ' ' " + CRLF
		DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZ0, .F., .T.)
		(cAlZZ0)->(DbGoTop())
		while !(cAlZZ0)->(eof())

			for F := 1 to len(aColEcad)
				cTipo  := iif(alltrim(aColEcad[F,1]) <> "ZZ0_DESCMN", "C", "D")
				cValor := (cAlZZ0)->(aColEcad[F,1])
				nValor := &(cValor)
				nValor := iif(cTipo=="C", nValor, nValor*-1)
				nValTemp += nValor
			next

			(cAlZZ0)->(DbSkip())
		enddo
		(cAlZZ0)->(DbCloseArea())

		if nValTemp <> 0
			nPagto := 0
			// Apura os pagamentos do valor atual para seus herdeiros no mes
			cSql := "select ZZ1_CDRPCE, ZZ1_LJRPCE, ZZ1_PERCEN " + CRLF
			cSql += "  from "+RetSqlName("ZZ1")+" t1 " + CRLF
			cSql += " where t1.ZZ1_FILIAL = '"+xFilial("ZZ1")+"' " + CRLF
			cSql += "   and t1.ZZ1_CDTIHE = '"+AllTrim(cCod)+"' " + CRLF
			cSql += "   and t1.ZZ1_LJTIHE = '"+AllTrim(cLoja)+"' " + CRLF
			cSql += "   and t1.ZZ1_TIPO   <> 'R' "	// Desconsidera os representantes - Adriano 21/05/2024
			cSql += "   and t1.ZZ1_CDRPCE + t1.ZZ1_LJRPCE <> t1.ZZ1_CDTIHE + t1.ZZ1_LJTIHE " + CRLF	// Adriano 13/01/2025
			// Acessa dados da versão de relacionamento válida no mês de processamento - Adriano 06/03/2025
			cSql += "   and ((t1.ZZ1_INICIO <= '"+cAnoMes+"31' and t1.ZZ1_VENCTO = '        ') or " + CRLF
			cSql += "        (t1.ZZ1_INICIO <= '"+cAnoMes+"31' and t1.ZZ1_VENCTO >= '"+cAnoMes+"01')) " + CRLF
			cSql += "   and t1.D_E_L_E_T_ = ' ' " + CRLF
			cSql += " order by t1.ZZ1_CDRPCE "
			DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZ1, .F., .T.)
			(cAlZZ1)->(DbGoTop())
			while !(cAlZZ1)->(eof())
				// Calcula a parte paga a cada herdeiro no nivel atual (atual como titular)
				nPagto += round((nValTemp * (cAlZZ1)->ZZ1_PERCEN) / 100,2)
				(cAlZZ1)->(DbSkip())
			enddo
			(cAlZZ1)->(DbCloseArea())

			// Abate o pagamento total aos dependentes, do recebimento do mes
			nValTemp -= nPagto
		endif

		// Chama a função novamente para buscar os crédito/débitos Ecad do nivel acima
		nValRet := SaldoRecursivo((cAlACI)->ZZ1_CDTIHE, (cAlACI)->ZZ1_LJTIHE, aColEcad, cAnoMes)

		if nValRet <> 0
			// Apura o percentual do retorno do saldo recursivo
			//nValRet := round((nValRet * (cAlACI)->ZZ1_PERCEN) / 100,2)
			nValTemp += nValRet
		endif

		// Calcula a parte do recebimento no nivel atual (dependente)
		nValTemp := round((nValTemp * (cAlACI)->ZZ1_PERCEN) / 100,2)

		// Acumula valor no saldo
		nSaldo += nValTemp

//		conout("SaldoRecursivo - n."+alltrim(str(nNivel))+": "+(cAlACI)->A2_COD+" "+(cAlACI)->A2_CGC+" "+(cAlACI)->A2_NOME+" "+cAnoMes+" nValTemp="+str(nValTemp)+" nSaldo="+str(nSaldo))

		(cAlACI)->(dbSkip())
	enddo
	(cAlACI)->(DbCloseArea())

	nNivel --

return nSaldo


/* ---------------------------------------------------------------------------------------------------------------- *
Data   : 19/06/2024 - Adriano Ferreira - Ápia Consultoria e Sistemas
Descr. : Ajusta texto com conteudo correto para json (quebras de linha, aspas, etc)
------------------------------------------------------------------------------------------------------------------- */
User Function EscapeJson(cTexto)

    Local oJson     := JsonObject():New()
    Local cChave    := "v"
    Local cPrefixo  := '{"' + cChave + '":"'
    Local cSufixo   := '"}'
    Local cJsonStr  := ""
    Local cEscapada := ""

    oJson[cChave] := cTexto
    cJsonStr      := oJson:ToJson()
    cEscapada     := substr(cJsonStr, len(cPrefixo)+1, len(cJsonStr)-len(cPrefixo)-len(cSufixo))

    FreeObj(oJson)

return cEscapada
