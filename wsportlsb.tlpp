								nPos := aScan(aRet, { |x| x[1] == cAnoMes .and. x[4] == (cAlZZ1)->ZZ1_CDTIHE .and. x[5] == (cAlZZ1)->ZZ1_LJTIHE })
								if nPos <> 0
									aRet[nPos,2] := nValor	// Adriano 11/10/2024
								else
									aAdd(aRet, {cAnoMes, nValor, dDtProc, (cAlZZ1)->ZZ1_CDTIHE, (cAlZZ1)->ZZ1_LJTIHE})
								endif
