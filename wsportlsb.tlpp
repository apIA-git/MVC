#INCLUDE 'tlpp-core.th'
#INCLUDE 'tlpp-rest.th'
#INCLUDE 'totvs.ch'

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Autor  : Leandro Nunes - Tecnho Logic
Tipo   : Específico
Param. : Nenhum 
Retorno: Nenhum
Descr. : Api Rest - Biblioteca de funções de integração Sbacem - Protheus x Fluig
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Integração que valida usuário e senha para que o Associado realize o login no portal Fluig
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */
@Post("/sblogin")
User Function sblogin() As Logical

    Local cCpfCnpj  := "" As Character
    Local cPass     := "" As Character
    Local jBody     := JsonObject():New() As Json
    Local cSql      := "" As Character
    Local cAlSA2    := GetNextAlias() As Character
    Local cStatus   := "" As Character
    Local cMensagem := "" As Character
    Local cJSonRet  := "" As Character

    /*
    {"CPFCNPJ":"07891080704",
    "SENHA: "07891}
    */

    jBody:fromJson(oRest:GetBodyRequest())

    If jBody <> Nil
        cCpfCnpj := jBody:GetJsonText("CPFCNPJ")
        cPass := jBody:GetJsonText("SENHA")

        If CheckVar(cCpfCnpj) .And. CheckVar(cPass)
            cSql := "SELECT " + CRLF 
            cSql += "	A2_NOME NOME, " + CRLF 
            cSql += "	A2_EMAIL EMAIL, " + CRLF 
            cSql += "	CASE WHEN A2_MSBLQL = '1' THEN 'S' ELSE 'N' END BLOQ, " + CRLF 
            cSql += "	A2_XMASTER MASTER " + CRLF 
            cSql += "FROM " + CRLF 
            cSql += "	" + RetSqlName("SA2") + " " + CRLF 
            cSql += "WHERE " + CRLF 
            cSql += "	A2_FILIAL = '" + xFilial("SA2") + "' AND " + CRLF 
            cSql += "	A2_CGC = '" + cCpfCnpj + "' AND " + CRLF 
            cSql += "	A2_SBSENHA = '" + cPass + "' AND " + CRLF 
            cSql += "	D_E_L_E_T_ = ' '"
            If Select(cAlSA2) > 0
                (cAlSA2)->(DbCloseArea())
            EndIf
            DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlSA2, .F., .T.)
            (cAlSA2)->(DbGoTop())
            If !(cAlSA2)->(Eof())
                If (cAlSA2)->BLOQ == "S"
                    cStatus = "BL"
                    cMensagem := "FALHA NO LOGIN. USUARIO BLOQUEADO"
                Else
                    cStatus = "OK"
                    cMensagem := "DADOS RETORNADOS COM SUCESSO."				
                EndIf
                cJSonRet := '{"NOME": "' + AllTrim((cAlSA2)->NOME) + '", ' + CRLF
                cJSonRet += '"STATUS": "' + cStatus + '", ' + CRLF
                cJSonRet += '"EMAIL": "' + AllTrim((cAlSA2)->EMAIL) + '", ' + CRLF
                cJSonRet += '"PRIMEIROACESSO": "' + PrimeiroAcesso(cPass, cCpfCnpj) + '", ' + CRLF
                cJSonRet += '"MASTER": "' + (cAlSA2)->MASTER + '", ' + CRLF
                cJSonRet += '"MSG": "' + cMensagem + '"}'
            Else
                cJSonRet := '{"NOME": "SN", ' + CRLF
                cJSonRet += '"STATUS": "NO", ' + CRLF
                cJSonRet += '"EMAIL": "NULL", ' + CRLF
                cJSonRet += '"PW": "NULL", ' + CRLF
                cJSonRet += '"PRIMEIROACESSO": "N", ' + CRLF	
                cJSonRet += '"MASTER": "NO", ' + CRLF
                cJSonRet += '"MSG": "USUARIO NAO ENCONTRADO."}'
            EndIf
            
            (cAlSA2)->(DbCloseArea())
        EndIf
    Else
        cJSonRet := '{"NOME": "SN", ' + CRLF
        cJSonRet += '"STATUS": "NO", ' + CRLF
        cJSonRet += '"EMAIL": "NULL", ' + CRLF
        cJSonRet += '"PW": "NULL", ' + CRLF
        cJSonRet += '"PRIMEIROACESSO": "N", ' + CRLF
        cJSonRet += '"MASTER": "NO", ' + CRLF
        cJSonRet += '"MSG": "BODY INVÁLIDO."}'
    EndIf

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
    oRest:SetResponse(UPPER(cJsonRet))

Return(.T.)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Verifica se a variável passada é nula
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

Static Function CheckVar(cVar) As Logical

    Local lOk := .T. As Logical

    If cVar == Nil .Or. Empty(cVar)
        lOk := .F.
    EndIf

Return(lOk)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Verifica se é o primeiro acesso 
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

Static Function PrimeiroAcesso(cSenha, cCPF) As Character

	Local cStatus := "N" As Character

	If AllTrim(cSenha) == SubStr(cCPF,1, 5)
		cStatus := "S"
	EndIf

Return(cStatus)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Integração que permite a alteração de senha no portal Fluig
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */
@Post("/sbatupw")
User Function sbatupw() As Logical

    Local cCpfCnpj  := "" As Character
    Local cPass     := "" As Character
    Local cNova     := "" As Character
    Local jBody     := JsonObject():New() As Json
    Local cSql      := "" As Character
    Local cAlSA2    := GetNextAlias() As Character
    Local cStatus   := "" As Character
    Local cMensagem := "" As Character
    Local cJSonRet  := "" As Character

    /*
    {"CPFCNPJ":"07891080704",
    "ATUAL": "07891",
    "NOVA": "12345"}
    */

    jBody:fromJson(oRest:GetBodyRequest())

    If jBody <> Nil
        cCpfCnpj := jBody:GetJsonText("CPFCNPJ")
        cPass := jBody:GetJsonText("ATUAL")
        cNova := jBody:GetJsonText("NOVA")

        If CheckVar(cCpfCnpj) .And. CheckVar(cPass) .And. CheckVar(cNova)
            cSql := "SELECT " + CRLF 
            cSql += "	A2_COD + A2_LOJA CODIGO, " + CRLF 
            cSql += "	CASE WHEN A2_MSBLQL = '1' THEN 'S' ELSE 'N' END BLOQ " + CRLF 
            cSql += "FROM " + CRLF 
            cSql += "	" + RetSqlName("SA2") + " " + CRLF 
            cSql += "WHERE " + CRLF 
            cSql += "	A2_FILIAL = '" + xFilial("SA2") + "' AND " + CRLF 
            cSql += "	A2_CGC = '" + cCpfCnpj + "' AND " + CRLF 
            cSql += "	A2_SBSENHA = '" + cPass + "' AND " + CRLF
            cSql += "	D_E_L_E_T_ = ' '"
            cSql := ChangeQuery(cSql)
            If Select(cAlSA2) > 0
                (cAlSA2)->(DbCloseArea())
            EndIf
            DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlSA2, .F., .T.)
            (cAlSA2)->(DbGoTop())
            If !(cAlSA2)->(Eof())
                If (cAlSA2)->BLOQ == "S"
                    cStatus = "BL"
                    cMensagem := "USUÁRIO BLOQUEADO. NÃO É POSSÍVEL ATUALIZAR A SENHA."
                Else
                    cSql := "UPDATE SA2010 " + CRLF
                    cSql += "SET A2_SBSENHA = '" + cNova + "' " + CRLF
                    cSql += "WHERE " + CRLF
                    cSql += "    A2_FILIAL = '" + "    " + "' AND " + CRLF 
                    cSql += "    A2_COD + A2_LOJA = '" + (cAlSA2)->CODIGO + "' AND " + CRLF 
                    cSql += "    D_E_L_E_T_ = ' '"
                    nErro := TcSqlExec(cSql)
                    If nErro < 0
                        cStatus = "NO"
                        cMensagem := "Erro na atualização da senha!" + CRLF
                        cMensagem += TCSQLError()
                    Else
                        cStatus = "OK"
                        cMensagem := "SENHA ALTERADA COM SUCESSO!"		
                    EndIf
                EndIf
                cJSonRet := '{"STATUS": "' + cStatus + '", ' + CRLF
                cJSonRet += '"MSG": "' + cMensagem + '"}'
            Else
                cJSonRet := '{"STATUS": "NO", ' + CRLF
                cJSonRet += '"MSG": "ERRO AO RECUPERAR USUARIO. OPERACAO INVALIDA."}'
            EndIf

            (cAlSA2)->(DbCloseArea())
        EndIf
    Else
        cJSonRet := '{"STATUS": "NO", ' + CRLF
        cJSonRet += '"MSG": "BODY INVÁLIDO."}'
    EndIf

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
    oRest:SetResponse(UPPER(cJsonRet))

Return(.T.)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Integração que retorna todos os dados do usuário com ou sem senha
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */
@Post("/sbdados")
User Function sbdados() As Logical

    Local cComSenha := "" As Character
    Local cCpfCnpj  := "" As Character
    Local cPass     := "" As Character
    Local cCodigo   := "" As Character
    Local jBody     := JsonObject():New() As Json
    Local cSql      := "" As Character
    Local cAlSA2    := GetNextAlias() As Character
    Local cStatus   := "" As Character
    Local cMensagem := "" As Character
    Local cJSonRet  := "" As Character
    Local lOk       := .F. As Logical
	Local cToken    := "" As Character	// Adriano 02/05/2025

    /*
    {
    "COMSENHA":"S",
    "CPFCNPJ":"07891080704",
    "SENHA": "07891",
    "CODIGO": "0000000000"}
    */

    jBody:fromJson(oRest:GetBodyRequest())

    If jBody <> Nil
        cComSenha := jBody:GetJsonText("COMSENHA") 
        cCpfCnpj := jBody:GetJsonText("CPFCNPJ")
        cPass := jBody:GetJsonText("SENHA")
        cCodigo := jBody:GetJsonText("CODIGO")

        ConOut(cComSenha + cCpfCnpj + cPass + cCodigo + CRLF)
        If cComSenha == "S" .And. CheckVar(cComSenha)
            If CheckVar(cCpfCnpj) .And. CheckVar(cPass)
                lOk := .T.
            EndIf
        Else
            If CheckVar(cCodigo)
                lOk := .T.                
            EndIf
        EndIf

        If lOk
            cSql := "SELECT " + CRLF 
            cSql += "	A2_COD + A2_LOJA CODIGO, " + CRLF   
            cSql += "	A2_NOME NOME, " + CRLF 
            cSql += "	A2_SBCECAD CODECAD, " + CRLF 
            cSql += "	A2_EMAIL EMAIL, " + CRLF 
            cSql += "	A2_CGC CPFCNPJ, " + CRLF 
            cSql += "	A2_SBNMMAE MAE, " + CRLF 
            cSql += "	A2_SBNMPAI PAI, " + CRLF
            cSql += "	A2_END ENDER, " + CRLF     
            cSql += "	A2_MUN MUNICIPIO, " + CRLF
            cSql += "	A2_BAIRRO BAIRRO, " + CRLF
            cSql += "	(SELECT YA_DESCR FROM " + RetSqlName("SYA") + " SYA WHERE SYA.YA_FILIAL = '" + xFilial("SYA") + "' AND SYA.YA_CODGI = A2_PAIS AND SYA.D_E_L_E_T_ = ' ') PAIS, " + CRLF
            cSql += "	A2_CEP CEP, " + CRLF
            cSql += "	A2_NR_END NUMERO, " + CRLF
            cSql += "	A2_BANCO BANCO, " + CRLF
            cSql += "	A2_AGENCIA AGENCIA, " + CRLF
            cSql += "	A2_NUMCON CONTA, " + CRLF
            cSql += "	A2_BAIRRO BAIRRO, " + CRLF
            cSql += "	A2_SBCDCAE CODCAE, " + CRLF
            cSql += "	A2_SBRIFPI RADIFPI, " + CRLF
            cSql += "	A2_SBCIFPI CODIPI, " + CRLF
            cSql += "	A2_SBSIFPI SIGIFPI, " + CRLF
            cSql += "	A2_SBPSEUD PSEUDO, " + CRLF
            cSql += "	A2_SBTPUS TIPO, " + CRLF	// Adriano 19/02/2025
            cSql += "	CASE WHEN A2_MSBLQL = '1' THEN 'S' ELSE 'N' END BLOQ, " + CRLF 
            cSql += "	A2_XTOKEN TOKEN " + CRLF	// Adriano 02/05/2025
            cSql += "FROM " + CRLF 
            cSql += "	" + RetSqlName("SA2") + " " + CRLF 
            cSql += "WHERE " + CRLF 
            cSql += "	A2_FILIAL = '" + xFilial("SA2") + "' AND " + CRLF
            If cComSenha == "S" 
                cSql += "	A2_CGC = '" + cCpfCnpj + "' AND " + CRLF 
                cSql += "	A2_SBSENHA = '" + cPass + "' AND " + CRLF 
            Else
                cSql += "	A2_COD + A2_LOJA = '" + cCodigo + "' AND " + CRLF 
            EndIf            
            cSql += "	D_E_L_E_T_ = ' '" + CRLF
            ConOut(cSql)
            If Select(cAlSA2) > 0
                (cAlSA2)->(DbCloseArea())
            EndIf
            DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlSA2, .F., .T.)
            (cAlSA2)->(DbGoTop())
            If !(cAlSA2)->(Eof())
                If (cAlSA2)->BLOQ == "S"
                    cStatus = "BL"
                    cMensagem := "FALHA NO LOGIN. USUARIO BLOQUEADO"
                Else
                    cStatus = "OK"
                    cMensagem := "DADOS RETORNADOS COM SUCESSO."				
                EndIf

                cToken := iif(!empty((cAlSA2)->TOKEN), "S", "N")	// Adriano 02/05/2025

                cJSonRet := '{"CODIGO": "' + AllTrim((cAlSA2)->CODIGO) + '", ' + CRLF
                cJSonRet += '"NOME": "' + AllTrim((cAlSA2)->NOME) + '", ' + CRLF
                cJSonRet += '"STATUS": "' + cStatus + '", ' + CRLF
                cJSonRet += '"CODECAD": "' + AllTrim((cAlSA2)->CODECAD) + '", ' + CRLF
                cJSonRet += '"EMAIL": "' + AllTrim((cAlSA2)->EMAIL) + '", ' + CRLF
                cJSonRet += '"CPFCNPJ": "' + AllTrim((cAlSA2)->CPFCNPJ) + '", ' + CRLF
                cJSonRet += '"MAE": "' + AllTrim((cAlSA2)->MAE) + '", ' + CRLF
                cJSonRet += '"PAI": "' + AllTrim((cAlSA2)->PAI) + '", ' + CRLF
                cJSonRet += '"ENDER": "' + AllTrim((cAlSA2)->ENDER) + '", ' + CRLF
                cJSonRet += '"MUNICIPIO": "' + AllTrim((cAlSA2)->MUNICIPIO) + '", ' + CRLF
                cJSonRet += '"BAIRRO": "' + AllTrim((cAlSA2)->BAIRRO) + '", ' + CRLF
                cJSonRet += '"PAIS": "' + AllTrim((cAlSA2)->PAIS) + '", ' + CRLF
                cJSonRet += '"CEP": "' + AllTrim((cAlSA2)->CEP) + '", ' + CRLF
                cJSonRet += '"NUMERO": "' + AllTrim((cAlSA2)->NUMERO) + '", ' + CRLF
                cJSonRet += '"BANCO": "' + AllTrim((cAlSA2)->BANCO) + '", ' + CRLF
                cJSonRet += '"AGENCIA": "' + AllTrim((cAlSA2)->AGENCIA) + '", ' + CRLF
                cJSonRet += '"CONTA": "' + AllTrim((cAlSA2)->CONTA) + '", ' + CRLF
                cJSonRet += '"CODCAE": "' + AllTrim((cAlSA2)->CODCAE) + '", ' + CRLF
                cJSonRet += '"CODIPI": "' + AllTrim((cAlSA2)->CODIPI) + '", ' + CRLF
                cJSonRet += '"RADIFPI": "' + AllTrim((cAlSA2)->RADIFPI) + '", ' + CRLF
                cJSonRet += '"SIGIFPI": "' + AllTrim((cAlSA2)->SIGIFPI) + '", ' + CRLF
                cJSonRet += '"PSEUDO": "' + AllTrim((cAlSA2)->PSEUDO) + '", ' + CRLF
                cJSonRet += '"TIPO": "' + AllTrim((cAlSA2)->TIPO) + '", ' + CRLF	// Adriano 19/02/2025
                cJSonRet += '"EXISTETOKEN": "' + cToken + '", ' + CRLF				// Adriano 02/05/2025
                cJSonRet += '"MSG": "' + cMensagem + '"}'
            Else
                cJSonRet := '{"CODIGO": "NULO", ' + CRLF
                cJSonRet += '"NOME": "SN", ' + CRLF
                cJSonRet += '"STATUS": "' + cStatus + '", ' + CRLF
                cJSonRet += '"CODECAD": "NULO", ' + CRLF
                cJSonRet += '"EMAIL": "NULO", ' + CRLF
                cJSonRet += '"CPFCNPJ": "NULO", ' + CRLF
                cJSonRet += '"MAE": "NULO", ' + CRLF
                cJSonRet += '"PAI": "NULO", ' + CRLF
                cJSonRet += '"ENDER": "NULO", ' + CRLF
                cJSonRet += '"MUNICIPIO": "NULO", ' + CRLF
                cJSonRet += '"BAIRRO": "NULO", ' + CRLF
                cJSonRet += '"PAIS": "NULO", ' + CRLF
                cJSonRet += '"CEP": "NULO", ' + CRLF
                cJSonRet += '"NUMERO": "NULO", ' + CRLF
                cJSonRet += '"BANCO": "NULO", ' + CRLF
                cJSonRet += '"AGENCIA": "NULO", ' + CRLF
                cJSonRet += '"CONTA": "NULO", ' + CRLF
                cJSonRet += '"CODCAE": "NULO", ' + CRLF
                cJSonRet += '"CODIPI": "NULO", ' + CRLF
                cJSonRet += '"RADIFPI": "NULO", ' + CRLF
                cJSonRet += '"SIGIFPI": "NULO", ' + CRLF
                cJSonRet += '"PSEUDO": "NULO", ' + CRLF
                cJSonRet += '"TIPO": "NULO", ' + CRLF			// Adriano 19/02/2025				
                cJSonRet += '"EXISTETOKEN": "NULO", ' + CRLF	// Adriano 02/05/2025
                cJSonRet += '"MSG": "USUARIO NAO ENCONTRADO."}'
            EndIf
            
            (cAlSA2)->(DbCloseArea())
        EndIf
    Else
        cJSonRet := '{"CODIGO": "NULO", ' + CRLF
        cJSonRet += '"NOME": "SN", ' + CRLF
        cJSonRet += '"STATUS": "' + cStatus + '", ' + CRLF
        cJSonRet += '"CODECAD": "NULO", ' + CRLF
        cJSonRet += '"EMAIL": "NULO", ' + CRLF
        cJSonRet += '"CPFCNPJ": "NULO", ' + CRLF
        cJSonRet += '"MAE": "NULO", ' + CRLF
        cJSonRet += '"PAI": "NULO", ' + CRLF
        cJSonRet += '"ENDER": "NULO", ' + CRLF
        cJSonRet += '"MUNICIPIO": "NULO", ' + CRLF
        cJSonRet += '"BAIRRO": "NULO", ' + CRLF
        cJSonRet += '"PAIS": "NULO", ' + CRLF
        cJSonRet += '"CEP": "NULO", ' + CRLF
        cJSonRet += '"NUMERO": "NULO", ' + CRLF
        cJSonRet += '"BANCO": "NULO", ' + CRLF
        cJSonRet += '"AGENCIA": "NULO", ' + CRLF
        cJSonRet += '"CONTA": "NULO", ' + CRLF
        cJSonRet += '"CODCAE": "NULO", ' + CRLF
        cJSonRet += '"CODIPI": "NULO", ' + CRLF
        cJSonRet += '"RADIFPI": "NULO", ' + CRLF
        cJSonRet += '"SIGIFPI": "NULO", ' + CRLF
        cJSonRet += '"PSEUDO": "NULO", ' + CRLF
        cJSonRet += '"TIPO": "NULO", ' + CRLF	// Adriano 19/02/2025				
        cJSonRet += '"EXISTETOKEN": "NULO", ' + CRLF	// Adriano 02/05/2025
        cJSonRet += '"MSG": "BODY INVÁLIDO."}'
    EndIf

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
    oRest:SetResponse(UPPER(cJsonRet))

Return(.T.)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Consulta de associados via filtro de no mínimo 3 letras
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

@Post("/sbassfil")
User Function sbassfil() As Logical

    Local cFiltro   := "" As Character
    Local jBody     := JsonObject():New() As Json
    Local cSql      := "" As Character
    Local cAlSA2    := GetNextAlias() As Character    
    Local cJSonRet  := "" As Character

    jBody:fromJson(oRest:GetBodyRequest())

    If jBody <> Nil
        cFiltro := jBody:GetJsonText("FILTRO")

        If CheckVar(cFiltro)
            cSql := "SELECT " + CRLF 
            cSql += "	A2_COD + A2_LOJA CODIGO, " + CRLF 
            cSql += "	A2_SBCECAD CODECAD, " + CRLF
            cSql += "	A2_CGC CPFCNPJ, " + CRLF
            cSql += "	A2_NOME NOME, " + CRLF
            cSql += "	CASE WHEN A2_MSBLQL = '1' THEN 'S' ELSE 'N' END BLOQ " + CRLF 
            cSql += "FROM " + CRLF 
            cSql += "	" + RetSqlName("SA2") + " " + CRLF 
            cSql += "WHERE " + CRLF 
            cSql += "	A2_FILIAL   = '" + xFilial("SA2") + "' AND " + CRLF 
            cSql += "	(A2_NOME    LIKE '" + cFiltro + "%' OR " + CRLF 
            cSql += "	 A2_NREDUZ  LIKE '" + cFiltro + "%' OR " + CRLF	// Adriano 13/03/2024 
            cSql += "	 A2_CGC     =    '" + cFiltro + "'  OR " + CRLF 
            cSql += "	 A2_SBCECAD =    '" + cFiltro + "') AND " + CRLF
            cSql += "	A2_LOJA    <> 'EEEE' AND " + CRLF	// Adriano 07/06/2024
            cSql += "	D_E_L_E_T_  =    ' '"
            memowrite("\tmp\sbassfil1.txt",cSql)
            cSql := ChangeQuery(cSql)
            If Select(cAlSA2) > 0
                (cAlSA2)->(DbCloseArea())
            EndIf
            DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlSA2, .F., .T.)
            (cAlSA2)->(DbGoTop())
            If !(cAlSA2)->(Eof())
                cJSonRet := '{"REGISTROS":[' + CRLF
                nCont := 0
                While !(cAlSA2)->(Eof())
                    If nCont > 0
                        cJSonRet += ', ' + CRLF
                    EndIf

                    cJSonRet += '{"NOME": "' + AllTrim((cAlSA2)->NOME) + '", ' + CRLF
                    cJSonRet += '"CODIGO": "' + AllTrim((cAlSA2)->CODIGO) + '", ' + CRLF
                    cJSonRet += '"CODECAD": "' + AllTrim((cAlSA2)->CODECAD) + '", ' + CRLF
                    cJSonRet += '"CPFCNPJ": "' + AllTrim((cAlSA2)->CPFCNPJ) + '"}'

                    nCont += 1
                    (cAlSA2)->(DbSkip())
                EndDo
                cJSonRet += '], ' + CRLF		
                cJSonRet += '"STATUS": "OK", ' + CRLF		
                cJSonRet += '"MSG": "CONSULTA EXECUTADA COM SUCESSO!."}'

                conout("sbassfil cJSonRet1 "+cJSonRet)

				// Adriano 13/03/2024
				if nCont > 1
					cJSonRet := '{"REGISTROS":' + CRLF
					cJSonRet += '[{"NOME": "NO", ' + CRLF
					cJSonRet += '"CODIGO": "NO", ' + CRLF
					cJSonRet += '"CODECAD": "NO", ' + CRLF
					cJSonRet += '"CPFCNPJ": "NO"}], ' + CRLF
					cJSonRet += '"STATUS": "NO", ' + CRLF		
					cJSonRet += '"MSG": "SUA PESQUISA POR ['+cFiltro+'] RETORNOU '+alltrim(str(nCont))+' PESSOAS. REFAÇA A CONSULTA."}'

                    conout("sbassfil cJSonRet2 "+cJSonRet)

				endif

            Else
                cJSonRet := '{"REGISTROS":' + CRLF
                cJSonRet += '[{"NOME": "NO", ' + CRLF
                cJSonRet += '"CODIGO": "NO", ' + CRLF
                cJSonRet += '"CODECAD": "NO", ' + CRLF
                cJSonRet += '"CPFCNPJ": "NO"}], ' + CRLF
                cJSonRet += '"STATUS": "NO", ' + CRLF		
                cJSonRet += '"MSG": "SEM REGISTROS A RETORNAR."}'
                
                conout("sbassfil cJSonRet3 "+cJSonRet)

            EndIf

            (cAlSA2)->(DbCloseArea())
        EndIf
    Else 
        cJSonRet := '{"REGISTROS":' + CRLF
        cJSonRet += '[{"NOME": "NO", ' + CRLF
        cJSonRet += '"CODIGO": "NO", ' + CRLF
        cJSonRet += '"CODECAD": "NO", ' + CRLF
        cJSonRet += '"CPFCNPJ": "NO"}], ' + CRLF
        cJSonRet += '"STATUS": "NO", ' + CRLF		
        cJSonRet += '"MSG": "BODY INVÁLIDO."}'
        
        conout("sbassfil cJSonRet4 "+cJSonRet)

    EndIf

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
    oRest:SetResponse(UPPER(cJsonRet))

Return(.T.)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Consulta de associados que retorna o email
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

@Post("/sbemail")
User Function sbemail() As Logical

    Local cCpfCnpj  := "" As Character
    Local jBody     := JsonObject():New() As Json
    Local cSql      := "" As Character
    Local cAlSA2    := GetNextAlias() As Character
    Local cJSonRet  := "" As Character

    /*
    {"CPFCNPJ":"07891080704"}
    */

    jBody:fromJson(oRest:GetBodyRequest())

    If jBody <> Nil
        cCpfCnpj := jBody:GetJsonText("CPFCNPJ")

        If CheckVar(cCpfCnpj)
            cSql := "SELECT " + CRLF 
            cSql += "	A2_SBCECAD CODECAD, " + CRLF 
            cSql += "	A2_EMAIL EMAIL " + CRLF 
            cSql += "FROM " + CRLF 
            cSql += "	" + RetSqlName("SA2") + " " + CRLF 
            cSql += "WHERE " + CRLF 
            cSql += "	A2_FILIAL = '" + xFilial("SA2") + "' AND " + CRLF 
            cSql += "	A2_CGC = '" + cCpfCnpj + "' AND " + CRLF 
            cSql += "	D_E_L_E_T_ = ' '"
            If Select(cAlSA2) > 0
                (cAlSA2)->(DbCloseArea())
            EndIf
            DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlSA2, .F., .T.)
            (cAlSA2)->(DbGoTop())
            If !(cAlSA2)->(Eof())
                cJSonRet := '{"EMAIL": "' + AllTrim((cAlSA2)->EMAIL) + '", "CODECAD": "' + AllTrim((cAlSA2)->CODECAD) + '"}'
            Else
                cJSonRet := '{"EMAIL": "NULL", "CODECAD": "NULL"}'
            EndIf
            
            (cAlSA2)->(DbCloseArea())
        EndIf
    Else
        cJSonRet := '{"EMAIL": "NULL", "CODECAD": "NULL"}'
    EndIf

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
    oRest:SetResponse(UPPER(cJsonRet))

Return(.T.)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Inteface para atualização da senha de acesso ao Fluig
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */
@Post("/sbatuss")
User Function sbatuss() As Logical

    Local cCpfCnpj  := "" As Character
    Local cNova     := "" As Character
    Local jBody     := JsonObject():New() As Json
    Local cSql      := "" As Character
    Local cAlSA2    := GetNextAlias() As Character
    Local cStatus   := "" As Character
    Local cMensagem := "" As Character
    Local cJSonRet  := "" As Character

    /*
    {"CPFCNPJ":"07891080704",
    "SENHA: "07891}
    */

    jBody:fromJson(oRest:GetBodyRequest())

    If jBody <> Nil
        cCpfCnpj := jBody:GetJsonText("CPFCNPJ")
        cNova := jBody:GetJsonText("NOVA")

        If CheckVar(cCpfCnpj) .And. CheckVar(cNova)
            cSql := "SELECT " + CRLF 
            cSql += "	A2_COD + A2_LOJA CODIGO, " + CRLF 
            cSql += "	CASE WHEN A2_MSBLQL = '1' THEN 'S' ELSE 'N' END BLOQ " + CRLF 
            cSql += "FROM " + CRLF 
            cSql += "	" + RetSqlName("SA2") + " " + CRLF 
            cSql += "WHERE " + CRLF 
            cSql += "	A2_FILIAL = '" + xFilial("SA2") + "' AND " + CRLF 
            cSql += "	A2_CGC = '" + cCpfCnpj + "' AND " + CRLF 
            cSql += "	D_E_L_E_T_ = ' '"
            cSql := ChangeQuery(cSql)
            If Select(cAlSA2) > 0
                (cAlSA2)->(DbCloseArea())
            EndIf
            DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlSA2, .F., .T.)
            (cAlSA2)->(DbGoTop())
            If !(cAlSA2)->(Eof())
                If (cAlSA2)->BLOQ == "S"
                    cStatus = "BL"
                    cMensagem := "USUÁRIO BLOQUEADO. NÃO É POSSÍVEL ATUALIZAR A SENHA."
                Else
                    cSql := "UPDATE " + RetSqlName("SA2") + " " + CRLF
                    cSql += "SET A2_SBSENHA = '" + cNova + "' " + CRLF
                    cSql += "WHERE " + CRLF
                    cSql += "    A2_FILIAL = '" + xFilial("SA2") + "' AND " + CRLF 
                    cSql += "    A2_COD + A2_LOJA = '" + (cAlSA2)->CODIGO + "' AND " + CRLF 
                    cSql += "    D_E_L_E_T_ = ' '"
                    nErro := TcSqlExec(cSql)
                    If nErro < 0
                        cStatus = "NO"
                        cMensagem := "Erro na atualização da senha!" + CRLF
                        cMensagem += TCSQLError()
                    Else
                        cStatus = "OK"
                        cMensagem := "SENHA ALTERADA COM SUCESSO!"		
                    EndIf
                EndIf
                cJSonRet := '{"STATUS": "' + cStatus + '", ' + CRLF
                cJSonRet += '"MSG": "' + cMensagem + '"}'
            Else
                cJSonRet := '{"STATUS": "NO", ' + CRLF
                cJSonRet += '"MSG": "ERRO AO RECUPERAR USUARIO. OPERACAO INVALIDA."}'
            EndIf

            (cAlSA2)->(DbCloseArea())
        EndIf
    Else
        cJSonRet := '{"STATUS": "NO", ' + CRLF
        cJSonRet += '"MSG": "BODY INVÁLIDO."}'
    EndIf

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
    oRest:SetResponse(UPPER(cJsonRet))

Return(.T.)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Inteface para exibição do extrato
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */
@Post("/sbextrat")
User Function sbextrat() As Logical

    Local cCpfCnpj  := "" As Character
    Local cCompet   := "" As Character
    Local jBody     := JsonObject():New() As Json
    Local cSql      := "" As Character
    Local cAlSA2    := GetNextAlias() As Character    
    Local cJSonRet  := "" As Character
	Local cAlExtrat := GetNextAlias() As Character
	Local cAlSaldo  := GetNextAlias() As Character
	Local nSaldo    := 0 As Double

    /*
    {"CPFCNPJ":"07891080704",
    "COMPET": "202301"}
    */

    jBody:fromJson(oRest:GetBodyRequest())

    If jBody <> Nil
        cCpfCnpj := jBody:GetJsonText("CPFCNPJ")
        cCompet  := jBody:GetJsonText("COMPET")

        If CheckVar(cCpfCnpj) .And. CheckVar(cCompet)
            cSql := "SELECT " + CRLF 
            cSql += "	A2_COD CODIGO, " + CRLF 
            cSql += "   A2_LOJA LOJA, " + CRLF 
            cSql += "   A2_XBLQEXT, " + CRLF 
            cSql += "	CASE WHEN A2_MSBLQL = '1' THEN 'S' ELSE 'N' END BLOQ " + CRLF 
            cSql += "FROM " + CRLF 
            cSql += "	" + RetSqlName("SA2") + " " + CRLF 
            cSql += "WHERE " + CRLF 
            cSql += "	A2_FILIAL = '" + xFilial("SA2") + "' AND " + CRLF 
            cSql += "	A2_CGC = '" + cCpfCnpj + "' AND " + CRLF 
            cSql += "	D_E_L_E_T_ = ' '"
            memowrite("c:\temp\sbextrat1.txt",cSql)
            If Select(cAlSA2) > 0
                (cAlSA2)->(DbCloseArea())
            EndIf
            DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlSA2, .F., .T.)
            (cAlSA2)->(DbGoTop())
            If !(cAlSA2)->(Eof())
                If (cAlSA2)->BLOQ == "S"
                    cStatus = "BL"
                    cMensagem := "FALHA NO LOGIN. USUARIO BLOQUEADO"

                    cJSonRet += '{"TIPO": "NO", ' + CRLF
                    cJSonRet += '{"COMPET": "NO", ' + CRLF
                    cJSonRet += '{"HISTORICO": "NO", ' + CRLF
                    cJSonRet += '{"VALOR": "NO"}, ' + CRLF
                elseIf (cAlSA2)->A2_XBLQEXT == "S"
                    cStatus = "BL"
                    cMensagem := "EXTRATO INDISPONIVEL"

                    cJSonRet += '{"TIPO": "NO", ' + CRLF
                    cJSonRet += '{"COMPET": "NO", ' + CRLF
                    cJSonRet += '{"HISTORICO": "NO", ' + CRLF
                    cJSonRet += '{"VALOR": "NO"}, ' + CRLF
                else
                    cJSonRet := '{"REGISTROS":[' + CRLF

                    // Busca o saldo anterior do associado
                    cSql := "SELECT " + CRLF 
                    cSql += "	'S' TIPO, " + CRLF 
                    cSql += "	'999999' COMPET, " + CRLF
                    cSql += "	'SALDO ANTERIOR' HISTORICO, " + CRLF
                    cSql += "	SUM(VALOR) VALOR " + CRLF
                    cSql += "FROM " + CRLF 
                    cSql += "	(SELECT " + CRLF 
                    cSql += "		E2_VALOR VALOR " + CRLF 
                    cSql += "	FROM " + CRLF 
                    cSql += "		" + RetSqlName("SE2") + " " + CRLF 
                    cSql += "	WHERE " + CRLF 
                    cSql += "		E2_FILIAL = '" + xFilial("SE2") + "' AND " + CRLF 
                    cSql += "		E2_FORNECE = '" + AllTrim((cAlSA2)->CODIGO) + "' AND " + CRLF 
                    cSql += "		E2_LOJA = '" + AllTrim((cAlSA2)->LOJA) + "' AND " + CRLF 
                    cSql += "		SUBSTRING(E2_BAIXA, 1, 6) < '"  + cCompet + "' AND " + CRLF 
                    cSql += "		E2_BAIXA <> '        ' " + CRLF 
                    cSql += "	UNION ALL " + CRLF 
                    cSql += "	SELECT " + CRLF 
                    cSql += "		E1_VALOR * -1 VALOR " + CRLF 
                    cSql += "	FROM " + CRLF 
                    cSql += "		" + RetSqlName("SE1") + " " + CRLF 
                    cSql += "	WHERE " + CRLF 
                    cSql += "		E1_FILIAL = '" + xFilial("SE1") + "' AND " + CRLF 
                    cSql += "		E1_CLIENTE = '" + AllTrim((cAlSA2)->CODIGO) + "' AND " + CRLF 
                    cSql += "		E1_LOJA = '" + AllTrim((cAlSA2)->LOJA) + "' AND " + CRLF 
                    cSql += "		SUBSTRING(E1_BAIXA, 1, 6) < '"  + cCompet + "' AND " + CRLF 
                    cSql += "		E1_BAIXA <> '        ') TAB"
                    memowrite("c:\temp\sbextrat2.txt",cSql)
                    If Select(cAlSaldo) > 0
                        (cAlSaldo)->(DbCloseArea())
                    EndIf
                    DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlSaldo, .F., .T.)
                    (cAlSaldo)->(DbGoTop())
                    If !(cAlSaldo)->(Eof())	
                        cJSonRet += '{"TIPO": "' + AllTrim((cAlSaldo)->TIPO) + '", ' + CRLF
                        cJSonRet += '"COMPET": "' + AllTrim((cAlSaldo)->COMPET) + '", ' + CRLF
                        cJSonRet += '"HISTORICO": "' + AllTrim((cAlSaldo)->HISTORICO) + '", ' + CRLF
                        cJSonRet += '"VALOR": "' + AllTrim(Str((cAlSaldo)->VALOR)) + '"}, ' + CRLF

                        nSaldo := (cAlSaldo)->VALOR
                    EndIf
                    (cAlSaldo)->(DbCloseArea())

                    // Busca os lançamentos do mês do associado
                    cSql := "SELECT " + CRLF 
                    cSql += "	'C' TIPO, " + CRLF
                    cSql += "	E2_BAIXA COMPET, " + CRLF
                    cSql += "	(CASE WHEN E2_HIST = ' ' AND E2_ORIGEM = 'FINA290M' THEN '"+;
                    SuperGetMV("MV_XHIS290",.F.,"PAGAMENTO EFETUADO")+"' ELSE E2_HIST END) HISTORICO, " + CRLF
                    cSql += "	E2_VALOR VALOR " + CRLF
                    cSql += "FROM " + CRLF
                    cSql += "    " + RetSqlName("SE2") + " " + CRLF 
                    cSql += "WHERE " + CRLF
                    cSql += "	E2_FILIAL = '" + xFilial("SE2") + "' AND " + CRLF 
                    cSql += "	E2_FORNECE = '"  + AllTrim((cAlSA2)->CODIGO) + "' AND " + CRLF
                    cSql += "	E2_LOJA = '"  + AllTrim((cAlSA2)->LOJA) + "' AND " + CRLF
                    cSql += "	SUBSTRING(E2_BAIXA, 1, 6) = '"  + cCompet + "' AND " + CRLF
                    cSql += "	E2_BAIXA <> '        ' " + CRLF
                    cSql += "UNION ALL " + CRLF
                    cSql += "SELECT " + CRLF
                    cSql += "	'D' TIPO, " + CRLF
                    cSql += "	E1_BAIXA COMPET, " + CRLF
                    cSql += "	E1_HIST HISTORICO, " + CRLF
                    cSql += "	E1_VALOR VALOR " + CRLF
                    cSql += "FROM " + CRLF
                    cSql += "		" + RetSqlName("SE1") + " " + CRLF 
                    cSql += "WHERE " + CRLF
                    cSql += "	E1_FILIAL = '" + xFilial("SE1") + "' AND " + CRLF 
                    cSql += "	E1_CLIENTE = '"  + AllTrim((cAlSA2)->CODIGO) + "' AND " + CRLF
                    cSql += "	E1_LOJA = '"  + AllTrim((cAlSA2)->LOJA) + "' AND " + CRLF
                    cSql += "	SUBSTRING(E1_BAIXA, 1, 6) = '"  + cCompet + "' AND " + CRLF
                    cSql += "	E1_BAIXA <> '        '"
                    memowrite("c:\temp\sbextrat3.txt",cSql)
                    If Select(cAlExtrat) > 0
                        (cAlExtrat)->(DbCloseArea())
                    EndIf
                    DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlExtrat, .F., .T.)
                    (cAlExtrat)->(DbGoTop())
                    While !(cAlExtrat)->(Eof())	
                        cJSonRet += '{"TIPO": "' + AllTrim((cAlExtrat)->TIPO) + '", ' + CRLF
                        cJSonRet += '"COMPET": "' + AllTrim((cAlExtrat)->COMPET) + '", ' + CRLF
                        cJSonRet += '"HISTORICO": "' + AllTrim((cAlExtrat)->HISTORICO) + '", ' + CRLF
                        cJSonRet += '"VALOR": "' + AllTrim(Str((cAlExtrat)->VALOR)) + '"}, ' + CRLF

                        If AllTrim((cAlExtrat)->TIPO) == "C"
                            nSaldo += (cAlExtrat)->VALOR
                        Else
                            nSaldo -= (cAlExtrat)->VALOR						
                        EndIf

                        (cAlExtrat)->(DbSkip())
                    EndDo
                    (cAlExtrat)->(DbCloseArea())

                    cJSonRet += '{"TIPO": "S", ' + CRLF
                    cJSonRet += '"COMPET": "999999", ' + CRLF
                    cJSonRet += '"HISTORICO": "SALDO FINAL", ' + CRLF
                    cJSonRet += '"VALOR": "' + AllTrim(Str(nSaldo)) + '"}], ' + CRLF

                    cStatus = "OK"
                    cMensagem := "DADOS RETORNADOS COM SUCESSO."	
                EndIf
                cJSonRet += '"STATUS": "' + cStatus + '", ' + CRLF			
                cJSonRet += '"MSG": "' + cMensagem + '"}'
            Else
                cJSonRet := '{"REGISTROS":' + CRLF
                cJSonRet += '[{"TIPO": "NO", ' + CRLF
                cJSonRet += '"COMPET": "NO", ' + CRLF
                cJSonRet += '"HISTORICO": "NO", ' + CRLF
                cJSonRet += '"VALOR": "NO"}], ' + CRLF
                cJSonRet += '"STATUS": "NO", ' + CRLF		
                cJSonRet += '"MSG": "USUARIO NAO ENCONTRADO."}'
            EndIf
        EndIf
    Else 
        cJSonRet := '{"REGISTROS":' + CRLF
        cJSonRet += '[{"TIPO": "NO", ' + CRLF
        cJSonRet += '"COMPET": "NO", ' + CRLF
        cJSonRet += '"HISTORICO": "NO", ' + CRLF
        cJSonRet += '"VALOR": "NO"}], ' + CRLF
        cJSonRet += '"STATUS": "NO", ' + CRLF		
        cJSonRet += '"MSG": "BODY INVÁLIDO."}' 
    EndIf

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
    oRest:SetResponse(UPPER(cJsonRet))
    memowrite("c:\temp\sbextrat4.txt",UPPER(cJsonRet))

Return(.T.)


/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Integração permite operações de Inclusão, Alteração e Exclusão de Obras Musicais
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

@Post("/sbcrudob")
User Function sbcrudob() As Logical

    Local cOper     := "" As Character
    Local cIdObra   := "" As Character
    Local jBody     := JsonObject():New() As Json
    Local cJSonRet  := "" As Character
    Local cStatus   := "" As Character
    Local cMsg      := "" As Character
    Local cCdEcad   := "" As Character
    Local cIdPartic := "" As Character
    
    /* {
        "OPER":"I",
        "IDOBRA":"",
        "CODECAD":"",
        "TITULO":"NOVA OBRA TESTE DEL",
        "NACIONAL":"S",
        "INSTRUMENTAL":"N",
        "DURACAO":"00:05:00",
        "IDSIGLAPAIS":"BR",
        "IDGENERO":"2",
        "IDIDIOMA":"PT",
        "ARQUIVO":"107924",
        "PASTA":"107923",
            "PARTICIPANTES":[{
            "NOMPART":"TESTE",
            "CPFCNPJ":"71086689470",
            "CDECADPART":"123",
            "PSEUDO":"",
            "TIPO":"F",
            "PERCEN":100.00,
            "IDCATEG":"A",
            "IDCATEGAUT":"A",
            "LINK":"001"},
            {"NOMPART":"TESTE",
            "CPFCNPJ":"71086689470",
            "CDECADPART":"123",
            "PSEUDONIMO":"",
            "TIPO":"F",
            "PERCENTUAL":100.00,
            "IDCATEG":"A",
            "IDCATEGAUT":"A",
            "LINK":"001"}],
        "SUBTITULOS":[{
                "NOMEOUTRO":"TESTE",
                "IDTPTITULO":"TA",
                "SITSUB":"S"}],
        "REFERENCIAS":[{
            "DESCRICAO":"TESTE",
            "IDTIPOCATEG":"C"}]
    }*/

    jBody:fromJson(oRest:GetBodyRequest())
    
    If jBody <> Nil //.And. CheckVar(cOper)
        cOper := jBody:GetJsonText("OPER")
        cIdObra  := jBody:GetJsonText("IDOBRA")
        
        if cIdObra == "0"
            cIdObra := "0000000000000"
        endif

        Begin Transaction
        If cOper == "I" // Criação de uma nova obra
            cIdObra := GetSxeNum("ZZ2", "ZZ2_IDOBRA")
            If jBody:GetJsonText("CODECAD") <> ""
                cCdEcad := PadL(jBody:GetJsonText("CODECAD"), TamSX3("ZZ2_CDECAD")[1], '0')
            EndIf

            DbSelectArea("ZZ2") 
            DbSetOrder(2) 
            Reclock("ZZ2", .T.)
            ZZ2->ZZ2_FILIAL := xFilial("ZZ2")
            ZZ2->ZZ2_IDOBRA := cIdObra
            ZZ2->ZZ2_CDECAD := cCdEcad
            ZZ2->ZZ2_CDSOCO := "" // VERIFICAR SE ENTRA COMO SBACEM
            ZZ2->ZZ2_TITULO := jBody:GetJsonText("TITULO")
            ZZ2->ZZ2_NACION := jBody:GetJsonText("NACIONAL")
            ZZ2->ZZ2_INSTRU := jBody:GetJsonText("INSTRUMENTAL")
            ZZ2->ZZ2_DOMPUB := "" // VERIFICAR SE TEM ESSE CAMPO NO CADASTRO
            ZZ2->ZZ2_DTREGI := dDatabase
            ZZ2->ZZ2_DTEMIS := dDatabase
            ZZ2->ZZ2_DTCRIA := dDatabase
            ZZ2->ZZ2_ISWC   := "" // VERIFICAR SE TEM ESSE CAMPO NO CADASTRO
            ZZ2->ZZ2_CODTIT := jBody:GetJsonText("CODIGOTITULAR")
            ZZ2->ZZ2_NOMTIT := jBody:GetJsonText("NOMETITULAR")
            ZZ2->ZZ2_CGCTIT := jBody:GetJsonText("CPFCNPJTITULAR")
            ZZ2->ZZ2_ECATIT := jBody:GetJsonText("CODIGOECADTITULAR")
            ZZ2->ZZ2_DURACA := jBody:GetJsonText("DURACAO")
            ZZ2->ZZ2_SIGLAP := jBody:GetJsonText("IDSIGLAPAIS") // ANEXO B
            ZZ2->ZZ2_TERRIT := jBody:GetJsonText("TERRITORIO")
            ZZ2->ZZ2_GENMUS := jBody:GetJsonText("IDGENERO") // ANEXO C
            ZZ2->ZZ2_REGVAR := "N"
            ZZ2->ZZ2_HOMONI := "N"
            ZZ2->ZZ2_OBDERI := "N"
            ZZ2->ZZ2_CECOOR := ""
            ZZ2->ZZ2_CSOOBM := ""
            ZZ2->ZZ2_SIGIDI := jBody:GetJsonText("IDIDIOMA") // ANEXO A
            ZZ2->ZZ2_OBCOMP := "N"
            ZZ2->ZZ2_TPOBCO := ""
            ZZ2->ZZ2_SOCRES := "SBACEM"
            ZZ2->ZZ2_SCRESC := "SBACEM"
            ZZ2->ZZ2_SITCAD := "ID"
            ZZ2->ZZ2_MSBLQL := "2"
            ZZ2->ZZ2_MOTBLQ := ""
            ZZ2->ZZ2_PERCES := "N"
            ZZ2->ZZ2_DTDOCU := dDatabase
            ZZ2->ZZ2_EXISWC := ""
            ZZ2->ZZ2_DTULAL := dDatabase
            ZZ2->ZZ2_IDARQ  := jBody:GetJsonText("ARQUIVO")
            ZZ2->ZZ2_IDPAST := jBody:GetJsonText("PASTA")
            ZZ2->ZZ2_LETRA  := jBody:GetJsonText("LETRA")
            ZZ2->ZZ2_OBS    := jBody:GetJsonText("OBSERVACAO")
            ZZ2->ZZ2_GENERO := jBody:GetJsonText("GENERO")
            ZZ2->ZZ2_STATUS := jBody:GetJsonText("STATUS")
            ZZ2->ZZ2_IDIOMA := jBody:GetJsonText("IDIOMA")
            ZZ2->(MsUnlock())
            ZZ2->(ConfirmSx8())

            // Inclusão de Participantes
            cIdPartic := IADPartic(cOper, jBody["PARTICIPANTES"], cIdObra)

            // Inclusão de Subtítulos
            IADSubtit(cOper, jBody["SUBTITULOS"], cIdObra)

            // Inclusão de Referências
            IADRefere(cOper, jBody["REFERENCIAS"], cIdObra)

            cStatus := "OK"
            cMsg    := "INCLUSÃO DA NOVA OBRA EXECUTADA COM SUCESSO!"
            ConOut("Inseriu")
        ElseIf cOper == "A"
            DbSelectArea("ZZ2") 
            ZZ2->(DbSetOrder(1)) 
            if ZZ2->(DbSeek(xFilial("ZZ2") + cIdObra))
                If jBody:GetJsonText("CODECAD") <> ""
                    cCdEcad := PadL(jBody:GetJsonText("CODECAD"), TamSX3("ZZ2_CDECAD")[1], '0')
                EndIf

                DbSelectArea("ZZ2") 
                DbSetOrder(2) 
                Reclock("ZZ2", .F.)
                ZZ2->ZZ2_CDECAD := cCdEcad
                ZZ2->ZZ2_CDSOCO := "" // VERIFICAR SE ENTRA COMO SBACEM
                ZZ2->ZZ2_TITULO := jBody:GetJsonText("TITULO")
                ZZ2->ZZ2_NACION := jBody:GetJsonText("NACIONAL")
                ZZ2->ZZ2_INSTRU := jBody:GetJsonText("INSTRUMENTAL")
                ZZ2->ZZ2_DOMPUB := "" // VERIFICAR SE TEM ESSE CAMPO NO CADASTRO
                //ZZ2->ZZ2_DTREGI := dDatabase
                //ZZ2->ZZ2_DTEMIS := dDatabase
                //ZZ2->ZZ2_DTCRIA := dDatabase
                ZZ2->ZZ2_ISWC   := "" // VERIFICAR SE TEM ESSE CAMPO NO CADASTRO
                ZZ2->ZZ2_CODTIT := jBody:GetJsonText("CODIGOTITULAR")
                ZZ2->ZZ2_NOMTIT := jBody:GetJsonText("NOMETITULAR")
                ZZ2->ZZ2_CGCTIT := jBody:GetJsonText("CPFCNPJTITULAR")
                ZZ2->ZZ2_ECATIT := jBody:GetJsonText("CODIGOECADTITULAR")
                ZZ2->ZZ2_DURACA := jBody:GetJsonText("DURACAO")
                ZZ2->ZZ2_SIGLAP := jBody:GetJsonText("IDSIGLAPAIS") // ANEXO B
                ZZ2->ZZ2_TERRIT := jBody:GetJsonText("TERRITORIO")
                ZZ2->ZZ2_GENMUS := jBody:GetJsonText("IDGENERO") // ANEXO C
                ZZ2->ZZ2_REGVAR := "N"
                ZZ2->ZZ2_HOMONI := "N"
                ZZ2->ZZ2_OBDERI := "N"
                ZZ2->ZZ2_CECOOR := ""
                ZZ2->ZZ2_CSOOBM := ""
                ZZ2->ZZ2_SIGIDI := jBody:GetJsonText("IDIDIOMA") // ANEXO A
                ZZ2->ZZ2_OBCOMP := "N"
                ZZ2->ZZ2_TPOBCO := ""
                ZZ2->ZZ2_SOCRES := "SBACEM"
                ZZ2->ZZ2_SCRESC := "SBACEM"
                ZZ2->ZZ2_SITCAD := "ID"
                ZZ2->ZZ2_MSBLQL := "2"
                ZZ2->ZZ2_MOTBLQ := ""
                ZZ2->ZZ2_PERCES := "N"
                //ZZ2->ZZ2_DTDOCU := dDatabase
                ZZ2->ZZ2_EXISWC := ""
                ZZ2->ZZ2_DTULAL := dDatabase
                ZZ2->ZZ2_IDARQ  := jBody:GetJsonText("ARQUIVO")
                ZZ2->ZZ2_IDPAST := jBody:GetJsonText("PASTA")
                ZZ2->ZZ2_LETRA  := jBody:GetJsonText("LETRA")
                ZZ2->ZZ2_OBS    := jBody:GetJsonText("OBSERVACAO")
                ZZ2->ZZ2_GENERO := jBody:GetJsonText("GENERO")
                ZZ2->ZZ2_STATUS := jBody:GetJsonText("STATUS")
                ZZ2->ZZ2_IDIOMA := jBody:GetJsonText("IDIOMA")
                ZZ2->(MsUnlock())

                // Alteração de Participantes
                cIdPartic := IADPartic(cOper, jBody["PARTICIPANTES"], cIdObra)

                // Alteração de Subtítulos
                IADSubtit(cOper, jBody["SUBTITULOS"], cIdObra)

                // Alteração de Referências
                IADRefere(cOper, jBody["REFERENCIAS"], cIdObra)

                cStatus := "OK"
                cMsg    := "ALTERAÇÃO DA OBRA EXECUTADA COM SUCESSO!"
            else
                cStatus := "NO"
                cMsg    := "OBRA NÃO CADASTRADA!"
            endif
        ElseIf cOper == "D"
            DbSelectArea("ZZ2") 
            ZZ2->(DbSetOrder(1)) 
            if ZZ2->(DbSeek(xFilial("ZZ2") + cIdObra))
                Reclock("ZZ2", .F.)
                ZZ2->(dbDelete())
                ZZ2->(MsUnlock())

                // Exclusão de Participantes
                IADPartic(cOper, , cIdObra)

                // Exclusão de Subtítulos
                IADSubtit(cOper, , cIdObra)

                // Exclusão de Referências
                IADRefere(cOper, , cIdObra)

                cStatus := "OK"
                cMsg    := "EXCLUSÃO DA OBRA EXECUTADA COM SUCESSO!"
            else
                cStatus := "NO"
                cMsg    := "OBRA NÃO CADASTRADA!"
            endif
        EndIf
        End Transaction
    Else
        ConOut("Json Inválido")
        cStatus = "NO"
        cMsg := "ESTRUTURA DO JSON INVÁLIDA."
    EndIf

    cJSonRet := '{"STATUS": "' + cStatus + '", ' + CRLF
    cJSonRet += '"IDOBRA": "' + cIdObra + '", ' + CRLF
    cJSonRet += '"IDPARTIC": "' + cIdPartic + '", ' + CRLF
    cJSonRet += '"MSG": "' + cMsg + '"}'

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
    oRest:SetResponse(UPPER(cJsonRet))

Return(.T.)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Insere, altera ou apaga Participantes de uma obra
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

Static Function IADPartic(cOper As Character, jPartic As Array, cIdObra As Character, cIdFono As Character, cColet As Character) As Character

    Local nTot      := 0 As Integer
    Local nCont     := 0 As Integer
    Local cCodPar   := "" As Character
    Local cLojPar   := "" As Character
    Local cNomPar   := "" As Character
    Local cIdPartic := "" As Character
    
    Default cIdObra := ""
    Default cIdFono := ""
    Default cColet := "N"

    If cOper == "I"
        nTot := Len(jPartic)

        For nCont := 1 To nTot
            cCodPar   := Posicione("SA2", 3, xFilial("SA2") + AllTrim(jPartic[nCont]["CPFCNPJ"]), "A2_COD")
            cLojPar   := Posicione("SA2", 3, xFilial("SA2") + AllTrim(jPartic[nCont]["CPFCNPJ"]), "A2_LOJA")
            If AllTrim(cCodPar) <> ""
                cNomPar := AllTrim(Posicione("SA2", 3, xFilial("SA2") + AllTrim(jPartic[nCont]["CPFCNPJ"]), "A2_NOME"))
            Else
                cNomPar := AllTrim(jPartic[nCont]["NOMPART"])
            EndIf

            cIdPartic := GetSxeNum("ZZ3", "ZZ3_IDPART")
        
            RecLock("ZZ3", .T.)
            ZZ3->ZZ3_FILIAL := xFilial("ZZ3")
            ZZ3->ZZ3_IDPART := cIdPartic
            ZZ3->ZZ3_IDOBRA := cIdObra
            ZZ3->ZZ3_IDFONO := cIdFono
            ZZ3->ZZ3_CODTIT := cCodPar
            ZZ3->ZZ3_LOJATI := cLojPar
            ZZ3->ZZ3_NMTIT  := cNomPar
            ZZ3->ZZ3_CPFCNP := jPartic[nCont]["CPFCNPJ"]
            ZZ3->ZZ3_CDECAD := jPartic[nCont]["CDECADPART"]
            ZZ3->ZZ3_PSEUDO := jPartic[nCont]["PSEUDO"]
            ZZ3->ZZ3_TIPO   := jPartic[nCont]["TIPO"]
            ZZ3->ZZ3_PERCEN := jPartic[nCont]["PERCEN"]
            ZZ3->ZZ3_CATEGO := jPartic[nCont]["IDCATEG"]
            ZZ3->ZZ3_IDSUBC := jPartic[nCont]["IDCATEGAUT"]
            ZZ3->ZZ3_LINK   := jPartic[nCont]["LINK"]
            if !empty(cIdFono)
                ZZ3->ZZ3_CDINST := jPartic[nCont]["CODINSTRUMENTO"]
            endif
            ZZ3->ZZ3_COLET := cColet
            ZZ3->(MsUnlock())
            ZZ3->(ConfirmSx8())
        Next nCont
    ElseIf cOper == "A"
        Begin Transaction
        if !empty(cIdObra)
            DbSelectArea("ZZ3") 
            ZZ3->(DbSetOrder(2)) 
            ZZ3->(DbSeek(xFilial("ZZ3") + cIdObra))
            While !ZZ3->(Eof()) .And. ZZ3->ZZ3_IDOBRA == cIdObra
                if ZZ3->ZZ3_IDFONO = Space(TamSX3("ZZ3_IDFONO")[1])
                    RecLock("ZZ3", .F.)
                    ZZ3->(dbDelete())
                    ZZ3->(MsUnlock())
                else
                    RecLock("ZZ3", .F.)
                    ZZ3->ZZ3_IDOBRA = Space(TamSX3("ZZ3_IDOBRA")[1])
                    ZZ3->(MsUnlock())
                endif
                ZZ3->(DbSkip())
            EndDo
        endif
        if !empty(cIdFono)
            DbSelectArea("ZZ3") 
            ZZ3->(DbSetOrder(4)) 
            ZZ3->(DbSeek(xFilial("ZZ3") + cIdFono))
            While !ZZ3->(Eof()) .And. ZZ3->ZZ3_IDFONO == cIdFono
                if ZZ3->ZZ3_IDOBRA = Space(TamSX3("ZZ3_IDOBRA")[1])
                    RecLock("ZZ3", .F.)
                    ZZ3->(dbDelete())
                    ZZ3->(MsUnlock())
                else
                    RecLock("ZZ3", .F.)
                    ZZ3->ZZ3_IDFONO = Space(TamSX3("ZZ3_IDFONO")[1])
                    ZZ3->(MsUnlock())
                endif
                ZZ3->(DbSkip())
            EndDo
        endif
        nTot := Len(jPartic)

        For nCont := 1 To nTot
            cCodPar   := Posicione("SA2", 3, xFilial("SA2") + AllTrim(jPartic[nCont]["CPFCNPJ"]), "A2_COD")
            cLojPar   := Posicione("SA2", 3, xFilial("SA2") + AllTrim(jPartic[nCont]["CPFCNPJ"]), "A2_LOJA")
            If AllTrim(cCodPar) <> ""
                cNomPar := AllTrim(Posicione("SA2", 3, xFilial("SA2") + AllTrim(jPartic[nCont]["CPFCNPJ"]), "A2_NOME"))
            Else
                cNomPar := AllTrim(jPartic[nCont]["NOMPART"])
            EndIf

            cIdPartic := GetSxeNum("ZZ3", "ZZ3_IDPART")
        
            RecLock("ZZ3", .T.)
            ZZ3->ZZ3_FILIAL := xFilial("ZZ3")
            ZZ3->ZZ3_IDPART := cIdPartic
            ZZ3->ZZ3_IDOBRA := cIdObra
            ZZ3->ZZ3_IDFONO := cIdFono
            ZZ3->ZZ3_CODTIT := cCodPar
            ZZ3->ZZ3_LOJATI := cLojPar
            ZZ3->ZZ3_NMTIT  := cNomPar
            ZZ3->ZZ3_CPFCNP := jPartic[nCont]["CPFCNPJ"]
            ZZ3->ZZ3_CDECAD := jPartic[nCont]["CDECADPART"]
            ZZ3->ZZ3_PSEUDO := jPartic[nCont]["PSEUDO"]
            ZZ3->ZZ3_TIPO   := jPartic[nCont]["TIPO"]
            ZZ3->ZZ3_PERCEN := jPartic[nCont]["PERCEN"]
            ZZ3->ZZ3_CATEGO := jPartic[nCont]["IDCATEG"]
            ZZ3->ZZ3_IDSUBC := jPartic[nCont]["IDCATEGAUT"]
            ZZ3->ZZ3_LINK   := jPartic[nCont]["LINK"]
            if !empty(cIdFono)
                ZZ3->ZZ3_CDINST := jPartic[nCont]["CODINSTRUMENTO"]
            endif
            ZZ3->ZZ3_COLET := cColet
            ZZ3->(MsUnlock())
            ZZ3->(ConfirmSx8())
        Next nCont

        End Transaction
    Else
        Begin Transaction
        if !empty(cIdObra)
            DbSelectArea("ZZ3") 
            ZZ3->(DbSetOrder(2)) 
            ZZ3->(DbSeek(xFilial("ZZ3") + cIdObra))
            While !ZZ3->(Eof()) .And. ZZ3->ZZ3_IDOBRA == cIdObra
                if ZZ3->ZZ3_IDFONO = Space(TamSX3("ZZ3_IDFONO")[1])
                    RecLock("ZZ3", .F.)
                    ZZ3->(dbDelete())
                    ZZ3->(MsUnlock())
                else
                    RecLock("ZZ3", .F.)
                    ZZ3->ZZ3_IDOBRA = Space(TamSX3("ZZ3_IDOBRA")[1])
                    ZZ3->(MsUnlock())
                endif
                ZZ3->(DbSkip())
            EndDo
        endif
        if !empty(cIdFono)
            DbSelectArea("ZZ3") 
            ZZ3->(DbSetOrder(4)) 
            ZZ3->(DbSeek(xFilial("ZZ3") + cIdFono))
            While !ZZ3->(Eof()) .And. ZZ3->ZZ3_IDFONO == cIdFono
                if ZZ3->ZZ3_IDOBRA = Space(TamSX3("ZZ3_IDOBRA")[1])
                    RecLock("ZZ3", .F.)
                    ZZ3->(dbDelete())
                    ZZ3->(MsUnlock())
                else
                    RecLock("ZZ3", .F.)
                    ZZ3->ZZ3_IDFONO = Space(TamSX3("ZZ3_IDFONO")[1])
                    ZZ3->(MsUnlock())
                endif
                ZZ3->(DbSkip())
            EndDo
        endif

        End Transaction
    EndIf

Return(cIdPartic)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Insere, altera ou apaga Subtítulos de uma obra
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

Static Function IADSubtit(cOper As Character, jSubtit As Array, cIdObra As Character)

    Local nTot    := 0 As Integer
    Local nCont   := 0 As Integer
    
    If cOper == "I"
        nTot := Len(jSubtit)

        For nCont := 1 To nTot
            DbSelectArea("ZZ6") 
            RecLock("ZZ6", .T.)
            ZZ6->ZZ6_FILIAL := xFilial("ZZ6")
            ZZ6->ZZ6_IDOBRA := cIdObra
            ZZ6->ZZ6_CDSOCU := "SBACEM"
            ZZ6->ZZ6_TPTITU := jSubtit[nCont]["IDTPTITULO"]
            ZZ6->ZZ6_NMOUTR := jSubtit[nCont]["NOMEOUTRO"]
            ZZ6->ZZ6_SITSUB := jSubtit[nCont]["SITSUB"]
            ZZ6->ZZ6_TIPTIT := jSubtit[nCont]["TIPOTITULO"]
            ZZ6->(MsUnlock())
        Next nCont
    ElseIf cOper == "A"
        DbSelectArea("ZZ6") 
        ZZ6->(DbSetOrder(2)) 
        ZZ6->(DbSeek(xFilial("ZZ6") + cIdObra))
        Begin Transaction
        While !ZZ6->(Eof()) .And. ZZ6->ZZ6_IDOBRA == cIdObra
            RecLock("ZZ6", .F.)
            ZZ6->(dbDelete())
            ZZ6->(MsUnlock())

            ZZ6->(DbSkip())
        EndDo

        nTot := Len(jSubtit)

        For nCont := 1 To nTot
            DbSelectArea("ZZ6") 
            RecLock("ZZ6", .T.)
            ZZ6->ZZ6_FILIAL := xFilial("ZZ6")
            ZZ6->ZZ6_IDOBRA := cIdObra
            ZZ6->ZZ6_CDSOCU := "SBACEM"
            ZZ6->ZZ6_TPTITU := jSubtit[nCont]["IDTPTITULO"]
            ZZ6->ZZ6_NMOUTR := jSubtit[nCont]["NOMEOUTRO"]
            ZZ6->ZZ6_SITSUB := jSubtit[nCont]["SITSUB"]
            ZZ6->ZZ6_TIPTIT := jSubtit[nCont]["TIPOTITULO"]
            ZZ6->(MsUnlock())
        Next nCont

        End Transaction
    Else
        DbSelectArea("ZZ6") 
        ZZ6->(DbSetOrder(2)) 
        ZZ6->(DbSeek(xFilial("ZZ6") + cIdObra))
        Begin Transaction
        While !ZZ6->(Eof()) .And. ZZ6->ZZ6_IDOBRA == cIdObra
            RecLock("ZZ6", .F.)
            ZZ6->(dbDelete())
            ZZ6->(MsUnlock())

            ZZ6->(DbSkip())
        EndDo
        End Transaction
    EndIf

Return()

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Insere, altera ou apaga Referências de uma obra
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

Static Function IADRefere(cOper As Character, jReferen As Array, cIdObra As Character, cIdFono As Character)

    Local nTot  := 0 As Integer
    Local nCont := 0 As Integer

    Default cIdObra := ""
    Default cIdFono := ""

    If cOper == "I"
        nTot := Len(jReferen)

        For nCont := 1 To nTot
            DbSelectArea("ZZ7") 
            DbSetOrder(1) 
            RecLock("ZZ7", .T.)
            ZZ7->ZZ7_FILIAL := xFilial("ZZ7")
            ZZ7->ZZ7_IDOBRA := cIdObra
            ZZ7->ZZ7_IDFONO := cIdFono
            ZZ7->ZZ7_CDSOCI := "SBACEM"
            ZZ7->ZZ7_DESCRI := jReferen[nCont]["DESCRICAO"]            
            ZZ7->ZZ7_TPCATE := jReferen[nCont]["IDTIPOCATEG"]
            ZZ7->(MsUnlock())
        Next nCont
    ElseIf cOper == "A"
        Begin Transaction
        if !empty(cIdObra)
            DbSelectArea("ZZ7") 
            ZZ7->(DbSetOrder(2)) 
            ZZ7->(DbSeek(xFilial("ZZ7") + cIdObra))
            While !ZZ7->(Eof()) .And. ZZ7->ZZ7_IDOBRA == cIdObra
                if ZZ7->ZZ7_IDFONO = Space(TamSX3("ZZ7_IDFONO")[1])
                    RecLock("ZZ7", .F.)
                    ZZ7->(dbDelete())
                    ZZ7->(MsUnlock())
                else
                    RecLock("ZZ7", .F.)
                    ZZ7->ZZ7_IDOBRA = Space(TamSX3("ZZ7_IDOBRA")[1])
                    ZZ7->(MsUnlock())
                endif

                ZZ7->(DbSkip())
            EndDo
        endif
        if !empty(cIdFono)
            DbSelectArea("ZZ7") 
            ZZ7->(DbSetOrder(4)) 
            ZZ7->(DbSeek(xFilial("ZZ7") + cIdFono))
            While !ZZ7->(Eof()) .And. ZZ7->ZZ7_IDFONO == cIdFono
                if ZZ7->ZZ7_IDOBRA = Space(TamSX3("ZZ7_IDOBRA")[1])
                    RecLock("ZZ7", .F.)
                    ZZ7->(dbDelete())
                    ZZ7->(MsUnlock())
                else
                    RecLock("ZZ7", .F.)
                    ZZ7->ZZ7_IDFONO = Space(TamSX3("ZZ7_IDFONO")[1])
                    ZZ7->(MsUnlock())
                endif

                ZZ7->(DbSkip())
            EndDo
        endif
        nTot := Len(jReferen)

        For nCont := 1 To nTot
            DbSelectArea("ZZ7") 
            DbSetOrder(1) 
            RecLock("ZZ7", .T.)
            ZZ7->ZZ7_FILIAL := xFilial("ZZ7")
            ZZ7->ZZ7_IDOBRA := cIdObra
            ZZ7->ZZ7_IDFONO := cIdFono
            ZZ7->ZZ7_CDSOCI := "SBACEM"
            ZZ7->ZZ7_DESCRI := jReferen[nCont]["DESCRICAO"]            
            ZZ7->ZZ7_TPCATE := jReferen[nCont]["IDTIPOCATEG"]
            ZZ7->(MsUnlock())
        Next nCont

        End Transaction
    Else
        if !empty(cIdObra)
            Begin Transaction
            DbSelectArea("ZZ7") 
            ZZ7->(DbSetOrder(2)) 
            ZZ7->(DbSeek(xFilial("ZZ7") + cIdObra))
            While !ZZ7->(Eof()) .And. ZZ7->ZZ7_IDOBRA == cIdObra
                if ZZ7->ZZ7_IDFONO = Space(TamSX3("ZZ7_IDFONO")[1])
                    RecLock("ZZ7", .F.)
                    ZZ7->(dbDelete())
                    ZZ7->(MsUnlock())
                else
                    RecLock("ZZ7", .F.)
                    ZZ7->ZZ7_IDOBRA = Space(TamSX3("ZZ7_IDOBRA")[1])
                    ZZ7->(MsUnlock())
                endif

                ZZ7->(DbSkip())
            EndDo
            End Transaction
        endif
        if !empty(cIdFono)
            DbSelectArea("ZZ7") 
            ZZ7->(DbSetOrder(4)) 
            ZZ7->(DbSeek(xFilial("ZZ7") + cIdFono))
            While !ZZ7->(Eof()) .And. ZZ7->ZZ7_IDFONO == cIdFono
                if ZZ7->ZZ7_IDOBRA = Space(TamSX3("ZZ7_IDOBRA")[1])
                    RecLock("ZZ7", .F.)
                    ZZ7->(dbDelete())
                    ZZ7->(MsUnlock())
                else
                    RecLock("ZZ7", .F.)
                    ZZ7->ZZ7_IDFONO = Space(TamSX3("ZZ7_IDFONO")[1])
                    ZZ7->(MsUnlock())
                endif

                ZZ7->(DbSkip())
            EndDo
        endif
    EndIf

Return()

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Verifica o Status da Obra, avaliando se pode ou não ser excluída
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

Static Function VerObra(cIdObra As Character) As Logical

    Local aArea    := GetArea() As Array
    Local cAlObra  := GetNextAlias() As Character
    Local cSql     := "" As Character 
    Local lRet     := .F. As Logical

    cSql := "SELECT ZZ2_SITCAD SITUA FROM " + RetSqlName("ZZ2") + " WHERE ZZ2_IDOBRA = '" + cIdObra + "'"
    If Select(cAlObra) > 0
        (cAlObra)->(DbCloseArea())
    EndIf
    DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlObra, .F., .T.)
    (cAlObra)->(DbGoTop())
    If !(cAlObra)->(Eof())
        If (cAlObra)->SITUA == "ID"
            lRet := .T.
        EndIf
    EndIf
    (cAlObra)->(DbCloseArea())

    RestArea(aArea)

Return(lRet)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Busca o código do associado a partir do Código ECAD
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

Static Function BuscaCod(cCodEcad)

    Local aArea    := GetArea() As Array
    Local cCodProt := "" As Character
    Local cAlSA2   := GetNextAlias() As Character
    Local cSql     := "" As Character 

    cSql := "SELECT A2_COD + A2_LOJA CODIGO FROM " + RetSqlName("SA2") + " WHERE TRIM((A2_SBCECAD) LIKE '%" + AllTrim(cCodEcad) + "%'"
    If Select(cAlSA2) > 0
        (cAlSA2)->(DbCloseArea())
    EndIf
    DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlSA2, .F., .T.)
    (cAlSA2)->(DbGoTop())
    If !(cAlSA2)->(Eof())
        cCodProt := AllTrim((cAlSA2)->CODIGO)
    EndIf
    (cAlSA2)->(DbCloseArea())

    RestArea(aArea)

Return(cCodProt)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Consulta do acervo de obras completo via filtro de 3 caracteres ou mais
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

@Post("/sblsobraf")
User Function sblsobraf() As Logical

    Local cFiltro  := "" As Character
    Local jBody    := JsonObject():New() As Json
    Local cSql     := "" As Character
    Local cAlZZ2   := GetNextAlias() As Character    
    Local cJSonRet := "" As Character
    Local cDsGener := "" As Character

    jBody:fromJson(oRest:GetBodyRequest())

    If jBody <> Nil
        cFiltro := jBody:GetJsonText("FILTRO")
    
        If CheckVar(cFiltro)
            cSql := "SELECT " + CRLF 
            cSql += "	ZZ2_IDOBRA IDOBRA, " + CRLF 
            cSql += "	ZZ2_CDECAD CDECAD, " + CRLF
            cSql += "	ZZ2_GENMUS IDGEN, " + CRLF          
            cSql += "	ZZ2_GENERO GENERO, " + CRLF          
            cSql += "	ZZ2_TITULO TITULO " + CRLF 
            cSql += "FROM " + CRLF 
            cSql += "	" + RetSqlName("ZZ2") + " " + CRLF 
            cSql += "WHERE " + CRLF 
            cSql += "	ZZ2_FILIAL = '" + xFilial("ZZ2") + "' AND " + CRLF 
            cSql += "	(ZZ2_CDECAD LIKE '%" + cFiltro + "%' OR " + CRLF 
            cSql += "	ZZ2_TITULO LIKE '%" + cFiltro + "%') AND " + CRLF 
            cSql += "	D_E_L_E_T_ = ' '"
            cSql := ChangeQuery(cSql)
            If Select(cAlZZ2) > 0
                (cAlZZ2)->(DbCloseArea())
            EndIf
            DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZ2, .F., .T.)
            (cAlZZ2)->(DbGoTop())
            If !(cAlZZ2)->(Eof())
                cJSonRet := '{"OBRAS":[' + CRLF
                nCont := 1
                While !(cAlZZ2)->(Eof())
                    If nCont > 1
                        cJSonRet += ', ' + CRLF
                    EndIf

                    cDsGener := AllTrim((cAlZZ2)->GENERO) // AllTrim(Posicione("SX5", 1, xFilial('SX5') + "ZZ" + (cAlZZ2)->IDGEN, "X5_DESCRI"))

                    cJSonRet += '{"IDOBRA": "' + AllTrim((cAlZZ2)->IDOBRA) + '", ' + CRLF
                    cJSonRet += '"CDECAD": "' + AllTrim((cAlZZ2)->CDECAD) + '", ' + CRLF
                    cJSonRet += '"DSGEN": "' + cDsGener + '", ' + CRLF
                    cJSonRet += '"TITULO": "' + AllTrim((cAlZZ2)->TITULO) + '"}'

                    nCont += 1
                    (cAlZZ2)->(DbSkip())
                EndDo
                cJSonRet += '], ' + CRLF		
                cJSonRet += '"STATUS": "OK", ' + CRLF		
                cJSonRet += '"MSG": "CONSULTA EXECUTADA COM SUCESSO!"}'
            Else
                cJSonRet := '{"OBRAS":' + CRLF
                cJSonRet += '[{"IDOBRA": "NO", ' + CRLF
                cJSonRet += '"CDECAD": "NO", ' + CRLF
                cJSonRet += '"DSGEN": "NO", ' + CRLF
                cJSonRet += '"TITULO": "NO"}], ' + CRLF
                cJSonRet += '"STATUS": "NO", ' + CRLF		
                cJSonRet += '"MSG": "NÃO FORAM ENCONRADAS OBRAS CORRESPONDENTES AO FILTRO ENVIADO!"}'
            EndIf

            (cAlZZ2)->(DbCloseArea())
        EndIf
    Else 
        cJSonRet := '{"OBRAS":' + CRLF
        cJSonRet += '[{"IDOBRA": "NO", ' + CRLF
        cJSonRet += '"CDECAD": "NO", ' + CRLF
        cJSonRet += '"DSGEN": "NO", ' + CRLF
        cJSonRet += '"TITULO": "NO"}], ' + CRLF
        cJSonRet += '"STATUS": "NO", ' + CRLF			
        cJSonRet += '"MSG": "ESTRUTURA DO JSON INVÁLIDA!"}'
    EndIf

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
    oRest:SetResponse(UPPER(cJsonRet))

Return(.T.)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Consulta do acervo de obras do usuário logado
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

@Post("/sblsobrau")
User Function sblsobrau() As Logical

    Local cCdTit   := "" As Character
    Local jBody    := JsonObject():New() As Json
    Local cJSonRet := "" As Character
    Local cSql     := "" As Character
    Local cAlZZ2   := GetNextAlias() As Character
    Local cAlZZ3   := GetNextAlias() As Character
    Local cDsGener := "" As Character
    Local lDadosOK := .F.                           // Adriano Ferreira - 30/07/2026
    Local cAlZZK   := GetNextAlias() As Character   // Adriano Ferreira - 30/07/2026

    // {"CDTIT":"0511770000"}

    jBody:fromJson(oRest:GetBodyRequest())

    If jBody <> Nil
        cCDTit := jBody:GetJsonText("CDTIT")
        If CheckVar(cCdTit)
            /*
            cSql := "SELECT " + CRLF 
            cSql += "	ZZ3_IDOBRA IDOBRA " + CRLF 
            cSql += "FROM " + CRLF 
            cSql += "    " + RetSqlName("ZZ3") + " " + CRLF 
            cSql += "WHERE " + CRLF
            cSql += "	ZZ3_CODTIT+ZZ3_LOJATI = '" + cCdTit + "' AND " + CRLF
            cSql += "	D_E_L_E_T_ =' '"
            */
            cJSonRet := '{"OBRAS":' + CRLF
            cJSonRet += '[' + CRLF
            cSql := "SELECT " + CRLF 
            cSql += "	ZZ2_IDOBRA IDOBRA " + CRLF 
            cSql += "FROM " + CRLF 
            cSql += "    " + RetSqlName("ZZ2") + " " + CRLF 
            cSql += "WHERE " + CRLF
            cSql += "	ZZ2_CODTIT = '" + cCdTit + "' AND " + CRLF
            cSql += "	D_E_L_E_T_ =' '"
            If Select(cAlZZ3) > 0
                (cAlZZ3)->(DbCloseArea())
            EndIf
            DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZ3, .F., .T.)
            (cAlZZ3)->(DbGoTop())
            If !(cAlZZ3)->(Eof())
                While !(s)->(Eof())
                    cSql := "SELECT " + CRLF 
                    cSql += "	ZZ2_CDECAD CDECAD, " + CRLF 
                    cSql += "	ZZ2_TITULO TITULO, " + CRLF 
                    cSql += "	ZZ2_GENMUS IDGEN, " + CRLF          
                    cSql += "	ZZ2_GENERO GENERO, " + CRLF          
                    cSql += "	ZZ2_SITCAD SITUA " + CRLF 
                    cSql += "FROM " + CRLF 
                    cSql += "    " + RetSqlName("ZZ2") + " " + CRLF 
                    cSql += "WHERE " + CRLF
                    cSql += "	ZZ2_IDOBRA = '" + (cAlZZ3)->IDOBRA + "' AND " + CRLF
                    cSql += "	D_E_L_E_T_ =' '"
                    If Select(cAlZZ2) > 0
                        (cAlZZ2)->(DbCloseArea())
                    EndIf
                    DbUseArea(.T., 	'TOPCONN', TCGENQRY(,, cSql), cAlZZ2, .F., .T.)
                    (cAlZZ2)->(DbGoTop())
                    While !(cAlZZ2)->(Eof())
                        cDsGener := AllTrim((cAlZZ2)->GENERO) // Alltrim(Posicione("SX5", 1, xFilial('SX5') + "ZZ" + (cAlZZ2)->IDGEN, "X5_DESCRI"))

                        cJSonRet += '{"IDOBRA": "' + AllTrim((cAlZZ3)->IDOBRA) + '", '
                        cJSonRet += '"CDECAD": "' + AllTrim((cAlZZ2)->CDECAD) + '", ' + CRLF
                        cJSonRet += '"TITULO": "' + AllTrim((cAlZZ2)->TITULO) + '", ' + CRLF
                        cJSonRet += '"DSGEN": "' + cDsGener + '", ' + CRLF
                        cJSonRet += '"PERCEN": "100", ' + CRLF
                        cJSonRet += '"SITUA": "' + AllTrim((cAlZZ2)->SITUA) + '"},' + CRLF
                        lDadosOK := .T.

                        (cAlZZ2)->(DbSkip())
                    EndDo
                    (cAlZZ2)->(DbCloseArea())

                    (cAlZZ3)->(DbSkip())
                EndDo
            EndIf
            (cAlZZ3)->(DbCloseArea())

            // Localiza obras do participante como coautor
            // Adriano Ferreira - 30/07/2026
            cSql := "SELECT ZZH_CODIGO, ZZH_ECAD, ZZH_TITULO, ZA3_DESCR, ZZH_STATUS, ZZK_PERCEN "
            cSql += "  FROM "+RetSqlName("ZZK")+" t1 "
            cSql += " INNER JOIN "+RetSqlName("ZZH")+ " t2 "
            cSql += "         ON ZZH_CODIGO = ZZK_CODOBR "
            cSql += "        AND t2.D_E_L_E_T_ = ' ' "
            cSql += " LEFT OUTER JOIN "+RetSqlName("ZA3")+" t3 "
            cSql += "         ON trim(ZA3_CODECA) = trim(ZZH_GENERO) "
            cSql += "        AND t3.D_E_L_E_T_ = ' ' "
            cSql += " WHERE ZZK_CODPAR = '"+cCdTit+"' "
            cSql += "	AND t1.D_E_L_E_T_ = ' ' "
            cSql += " ORDER BY ZZH_CODIGO "
            conout(cSql)
            if select(cAlZZK) > 0
                (cAlZZK)->(DbCloseArea())
            endif
            DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlZZK, .F., .T.)
            (cAlZZK)->(dbGoTop())
            while !(cAlZZK)->(Eof())
                cJSonRet += '{"IDOBRA": "'+alltrim((cAlZZK)->ZZH_CODIGO)+'", ' + CRLF
                cJSonRet += '"CDECAD": "'+alltrim((cAlZZK)->ZZH_ECAD)+'", ' + CRLF
                cJSonRet += '"TITULO": "'+alltrim((cAlZZK)->ZZH_TITULO)+'", ' + CRLF
                cJSonRet += '"DSGEN": "'+alltrim((cAlZZK)->ZA3_DESCR)+'", ' + CRLF
                cJSonRet += '"PERCEN": "'+alltrim(str((cAlZZK)->ZZK_PERCEN))+'", ' + CRLF
                cJSonRet += '"SITUA": "'+alltrim((cAlZZK)->ZZH_STATUS)+'"},' + CRLF
                lDadosOK := .T.
                (cAlZZK)->(dbSkip())
            enddo
            (cAlZZK)->(dbCloseArea())

            if lDadosOK
                cJSonRet := substr(cJSonRet,1,len(cJSonRet)-3) + CRLF	
                cJSonRet += '], ' + CRLF		
                cJSonRet += '"STATUS": "OK", ' + CRLF		
                cJSonRet += '"MSG": "CONSULTA EXECUTADA COM SUCESSO!"}'                
            else
                cJSonRet := '{"OBRAS":' + CRLF
                cJSonRet += '[{"CDECAD": "NO", ' + CRLF
                cJSonRet += '"TITULO": "NO", ' + CRLF
                cJSonRet += '"DSGEN": "NO", ' + CRLF
                cJSonRet += '"PERCEN": "NO", ' + CRLF
                cJSonRet += '"SITUA": "NO"}], ' + CRLF
                cJSonRet += '"STATUS": "NO", ' + CRLF		
                cJSonRet += '"MSG": "NENHUMA OBRA ENCONTRADA PARA ESTE PARTICIPANTE!"}'
            endif
        Else 
            cJSonRet := '{"OBRAS":' + CRLF
            cJSonRet += '[{"CDECAD": "NO", ' + CRLF
            cJSonRet += '"TITULO": "NO", ' + CRLF
            cJSonRet += '"DSGEN": "NO", ' + CRLF
            cJSonRet += '"PERCEN": "NO", ' + CRLF
            cJSonRet += '"SITUA": "NO"}], ' + CRLF
            cJSonRet += '"STATUS": "NO", ' + CRLF		
            cJSonRet += '"MSG": "ESTRUTURA DO JSON INVÁLIDA!"}' 
        EndIf
	EndIf

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
    oRest:SetResponse(UPPER(cJsonRet))

Return(.T.)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Retorna todos os dados de uma obra selecionada
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

@Post("/sbgetobra")
User Function sbgetobra() As Logical

    Local jBody    := JsonObject():New() As Json
    Local cJSonRet := "" As Character
    Local cIdObra  := "" As Character
    Local cSql     := "" As Character
    Local cStatus  := "" As Character
    Local cMsg     := "" As Character
    Local cAlObra  := GetNextAlias()
    Local cErro    := "" As Character

    // { "IDOBRA":"0000000000010" }

    cErro := '{"OBRAS": { ' + CRLF
    cErro += '"IDOBRA": "", ' + CRLF
    cErro += '"CDECAD": "", ' + CRLF
    cErro += '"CSOCOBR": "", ' + CRLF
    cErro += '"TITULO": "", ' + CRLF
    cErro += '"NACIONAL": "", ' + CRLF
    cErro += '"INSTRUM": "", ' + CRLF
    cErro += '"DOMPUBLI": "", ' + CRLF
    cErro += '"DTREGIST": "", ' + CRLF
    cErro += '"EMISSAO": "", ' + CRLF
