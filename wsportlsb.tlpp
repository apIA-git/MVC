    cErro += '"CDISWC": "", ' + CRLF
    cErro += '"CODTIT": "", ' + CRLF
    cErro += '"NOMTIT": "", ' + CRLF
    cErro += '"CPFCNPJTIT": "", ' + CRLF
    cErro += '"ECADTIT": "", ' + CRLF
    cErro += '"DURACAO": "", ' + CRLF
    cErro += '"SIGLAP": "", ' + CRLF
    cErro += '"IDGENERO": "", ' + CRLF
    cErro += '"GENERO": "", ' + CRLF
    cErro += '"REGVARSO": "", ' + CRLF
    cErro += '"HOMONIMA": "", ' + CRLF
    cErro += '"OBRADERI": "", ' + CRLF
    cErro += '"CDECADORI": "", ' + CRLF
    cErro += '"CDSOCOBRORI": "", ' + CRLF
    cErro += '"SIGLAIDIOMA": "", ' + CRLF
    cErro += '"DSSIGLAIDI": "", ' + CRLF
    cErro += '"OBRCOMPOST": "", ' + CRLF
    cErro += '"TPOBRCOMPOS": "", ' + CRLF
    cErro += '"DSTPOBRACOM": "", ' + CRLF
    cErro += '"SOCRESPINF": "", ' + CRLF
    cErro += '"SOCRESPCAD": "", ' + CRLF
    cErro += '"SITCADOBRA": "", ' + CRLF
    cErro += '"BLOQUEADO": "", ' + CRLF
    cErro += '"MOTBLOQ": "", ' + CRLF
    cErro += '"DSMOTBLQ": "", ' + CRLF
    cErro += '"DTDOCTO": "", ' + CRLF
    cErro += '"EXPISWC": "", ' + CRLF
    cErro += '"DTULTALT": "", ' + CRLF
    cErro += '"IDARQ": "", ' + CRLF
    cErro += '"IDPASTA": "", ' + CRLF
    cErro += '"PERCEST": "", ' + CRLF
    cErro += '"OBSERVACAO": "", ' + CRLF
    cErro += '"LETRA": "", ' + CRLF
    cErro += '"STATUS": "", ' + CRLF
    cErro += '"PARTICIPANTES": [{ ' + CRLF
    cErro += '    "IDPART": "", ' + CRLF
    cErro += '    "CODPART": "", ' + CRLF
    cErro += '    "LOJPART": "", ' + CRLF
    cErro += '    "NOMPART": "", ' + CRLF
    cErro += '    "CPFCNPJ": "", ' + CRLF
    cErro += '    "PSEUDO": "", ' + CRLF
    cErro += '    "TIPO": "", ' + CRLF
    cErro += '    "PERCEN": "", ' + CRLF
//    cErro += '    "IDCATEG: "", ' + CRLF
//    cErro += '    "DSCATEG: "", ' + CRLF
//    cErro += '    "IDCATEGAUT: "", ' + CRLF
//    cErro += '    "DSCATEGAUT: "", ' + CRLF
    cErro += '    "IDCATEG": "", ' + CRLF       // Adriano 12/08/2026
    cErro += '    "DSCATEG": "", ' + CRLF       // Adriano 12/08/2026
    cErro += '    "IDCATEGAUT": "", ' + CRLF    // Adriano 12/08/2026
    cErro += '    "DSCATEGAUT": "", ' + CRLF    // Adriano 12/08/2026
    cErro += '    "LINK": ""}], ' + CRLF
    cErro += '"SUBTITULOS": [{ ' + CRLF
    cErro += '    "CDECADSUB": "", ' + CRLF
    cErro += '   "CDSOCSUB": "", ' + CRLF
    cErro += '   "TPTITULO": "", ' + CRLF
    cErro += '    "NOMOUTR": "", ' + CRLF
    cErro += '    "SITSUB": ""}], ' + CRLF
    cErro += '"REFERENCIAS": [{ ' + CRLF
    cErro += '    "CDECADREF": "", ' + CRLF
    cErro += '    "CDSOCREF": "", ' + CRLF
    cErro += '    "DESCRI": "", ' + CRLF
    cErro += '    "TPCATEG": "", ' + CRLF
    cErro += '    "ECADFONO": ""}], ' + CRLF

    jBody:fromJson(oRest:GetBodyRequest())

    If jBody <> Nil
        cIdObra := jBody:GetJsonText("IDOBRA")
        If CheckVar(cIdObra)

            if len(alltrim(cIdObra)) > 10
                // Retorna dados da tabela ZZ2
                cSql := "SELECT "  + CRLF
                cSql += "    ZZ2_IDOBRA, " + CRLF	// Código da Obra
                cSql += "    ZZ2_CDECAD, " + CRLF	// Cod Ecad da Obra
                cSql += "    ZZ2_CDSOCO, " + CRLF	// Cod Societário da Obra
                cSql += "    ZZ2_TITULO, " + CRLF	// Título Principal da Obra
                cSql += "    ZZ2_NACION, " + CRLF	// Nacional?
                cSql += "    ZZ2_INSTRU, " + CRLF	// Instrumental
                cSql += "    ZZ2_DOMPUB, " + CRLF	// Domínio Publico
                cSql += "    ZZ2_DTREGI, " + CRLF	// Data de Registro da Obra
                cSql += "    ZZ2_DTEMIS, " + CRLF	// Data de Emissão
                cSql += "    ZZ2_DTCRIA, " + CRLF	// Data da Criação
                cSql += "    ZZ2_ISWC, "   + CRLF	// Código ISWC
                cSql += "    ZZ2_CODTIT, " + CRLF	// Código TIT
                cSql += "    ZZ2_NOMTIT, " + CRLF	// NOME TIT
                cSql += "    ZZ2_CGCTIT, " + CRLF	// CPF CNPJ TIT
                cSql += "    ZZ2_ECATIT, " + CRLF	// ECAD TIT
                cSql += "    ZZ2_DURACA, " + CRLF	// Duração
                cSql += "    ZZ2_SIGLAP, " + CRLF	// Sigla do Pais
                cSql += "    ZZ2_TERRIT, " + CRLF	// TERRITORIO
                cSql += "    ZZ2_GENMUS, " + CRLF	// Código do Genero Musical
                cSql += "    ZZ2_GENERO, " + CRLF
                cSql += "    ZZ2_REGVAR, " + CRLF	// Regra de Varsóvia
                cSql += "    ZZ2_HOMONI, " + CRLF	// Homônima
                cSql += "    ZZ2_OBDERI, " + CRLF	// Obra Derivada
                cSql += "    ZZ2_CECOOR, " + CRLF	// Cod Ecad Obra Original
                cSql += "    ZZ2_CSOOBM, " + CRLF	// Cod Soc Obra Original
                cSql += "    ZZ2_SIGIDI, " + CRLF	// Sigla do Idioma
                cSql += "    ZZ2_IDIOMA, " + CRLF
                cSql += "    ZZ2_OBCOMP, " + CRLF	// Obra Composta?
                cSql += "    ZZ2_TPOBCO, " + CRLF	// Cod Tipo Obra Composta
                cSql += "    ZZ2_SOCRES, " + CRLF	// Soc Respons Informação
                cSql += "    ZZ2_SCRESC, " + CRLF	// Soc Responsável Cadastro
                cSql += "    ZZ2_SITCAD, " + CRLF	// Situação Cadastral Obra
                cSql += "    ZZ2_MSBLQL, " + CRLF	// Registro bloqueado
                cSql += "    ZZ2_MOTBLQ, " + CRLF	// Motivo de Bloqueio
                cSql += "    ZZ2_DTDOCU, " + CRLF	// Data da Documentação
                cSql += "    ZZ2_EXISWC, " + CRLF	// Export ISWC Preferencial
                cSql += "    ZZ2_DTULAL, " + CRLF	// Data da Última Alteração
                cSql += "    ZZ2_IDARQ, " + CRLF	// Id Arquivo
                cSql += "    ZZ2_IDPAST, " + CRLF	// Id Pasta
                cSql += "    ZZ2_PERCES, " + CRLF	// Percentual Estrangeiro?
                cSql += "    ZZ2_STATUS, " + CRLF
                cSql += "    ISNULL(CAST(CAST(ZZ2_OBS AS VARBINARY(8000)) AS VARCHAR(8000)),'') AS ZZ2_OBS, " + CRLF	    // Observações
                cSql += "    ISNULL(CAST(CAST(ZZ2_LETRA AS VARBINARY(8000)) AS VARCHAR(8000)),'') AS ZZ2_LETRA " + CRLF	    // Letra
                cSql += "FROM " + RetSqlName("ZZ2") + " ZZ2 " + CRLF
                cSql += "WHERE " + CRLF
                cSql += "    ZZ2.D_E_L_E_T_ = ' ' AND " + CRLF
                cSql += "    ZZ2.ZZ2_IDOBRA = '" + cIdObra + "'"
            else
                // Retorna dados pela tabela ZZH - Adriano 12/08/2026
                cSql := "SELECT " + CRLF
                cSql += "    ZZH_CODIGO as ZZ2_IDOBRA, " + CRLF	// Código da Obra
                cSql += "    ZZH_ECAD   as ZZ2_CDECAD, " + CRLF	// Cod Ecad da Obra
                cSql += "    ''         as ZZ2_CDSOCO, " + CRLF	// Cod Societário da Obra
                cSql += "    ZZH_TITULO as ZZ2_TITULO, " + CRLF	// Título Principal da Obra
                cSql += "    ZZH_NACION as ZZ2_NACION, " + CRLF	// Nacional?
                cSql += "    ZZH_INSTRU as ZZ2_INSTRU, " + CRLF	// Instrumental
                cSql += "    ''         as ZZ2_DOMPUB, " + CRLF	// Domínio Publico
                cSql += "    ''         as ZZ2_DTREGI, " + CRLF	// Data de Registro da Obra
                cSql += "    ''         as ZZ2_DTEMIS, " + CRLF	// Data de Emissão
                cSql += "    ''         as ZZ2_DTCRIA, " + CRLF	// Data da Criação
                cSql += "    ZZH_ISWC   as ZZ2_ISWC, "   + CRLF	// Código ISWC
                cSql += "    ZZH_CODTIT as ZZ2_CODTIT, " + CRLF	// Código TIT
                cSql += "    ''         as ZZ2_NOMTIT, " + CRLF	// NOME TIT
                cSql += "    ''         as ZZ2_CGCTIT, " + CRLF	// CPF CNPJ TIT
                cSql += "    ''         as ZZ2_ECATIT, " + CRLF	// ECAD TIT
                cSql += "    ZZH_DURACA as ZZ2_DURACA, " + CRLF	// Duração
                cSql += "    ''         as ZZ2_SIGLAP, " + CRLF	// Sigla do Pais
                cSql += "    ZZH_TERRIT as ZZ2_TERRIT, " + CRLF	// TERRITORIO
                cSql += "    ''         as ZZ2_GENMUS, " + CRLF	// Código do Genero Musical
                cSql += "    ZZH_GENERO as ZZ2_GENERO, " + CRLF
                cSql += "    ''         as ZZ2_REGVAR, " + CRLF	// Regra de Varsóvia
                cSql += "    ''         as ZZ2_HOMONI, " + CRLF	// Homônima
                cSql += "    ''         as ZZ2_OBDERI, " + CRLF	// Obra Derivada
                cSql += "    ''         as ZZ2_CECOOR, " + CRLF	// Cod Ecad Obra Original
                cSql += "    ''         as ZZ2_CSOOBM, " + CRLF	// Cod Soc Obra Original
                cSql += "    ''         as ZZ2_SIGIDI, " + CRLF	// Sigla do Idioma
                cSql += "    ZZH_IDIOMA as ZZ2_IDIOMA, " + CRLF
                cSql += "    ''         as ZZ2_OBCOMP, " + CRLF	// Obra Composta?
                cSql += "    ''         as ZZ2_TPOBCO, " + CRLF	// Cod Tipo Obra Composta
                cSql += "    ''         as ZZ2_SOCRES, " + CRLF	// Soc Respons Informação
                cSql += "    ''         as ZZ2_SCRESC, " + CRLF	// Soc Responsável Cadastro
                cSql += "    ''         as ZZ2_SITCAD, " + CRLF	// Situação Cadastral Obra
                cSql += "    ''         as ZZ2_MSBLQL, " + CRLF	// Registro bloqueado
                cSql += "    ''         as ZZ2_MOTBLQ, " + CRLF	// Motivo de Bloqueio
                cSql += "    ''         as ZZ2_DTDOCU, " + CRLF	// Data da Documentação
                cSql += "    ''         as ZZ2_EXISWC, " + CRLF	// Export ISWC Preferencial
                cSql += "    ''         as ZZ2_DTULAL, " + CRLF	// Data da Última Alteração
                cSql += "    ''         as ZZ2_IDARQ, "  + CRLF	// Id Arquivo
                cSql += "    ''         as ZZ2_IDPAST, " + CRLF	// Id Pasta
                cSql += "    ''         as ZZ2_PERCES, " + CRLF	// Percentual Estrangeiro?
                cSql += "    ZZH_STATUS as ZZ2_STATUS, " + CRLF
                cSql += "    ''         as ZZ2_OBS, "    + CRLF // Observações
                cSql += "    ISNULL(CAST(CAST(ZZH_LETRA AS VARBINARY(8000)) AS VARCHAR(8000)),'') AS ZZ2_LETRA " + CRLF	    // Letra
                cSql += " FROM "+RetSqlName("ZZH")+" ZZH " + CRLF
                cSql += "WHERE ZZH.D_E_L_E_T_ = ' ' " + CRLF
                cSql += "  AND ZZH.ZZH_CODIGO = '" + cIdObra + "' "
            endif
            If Select(cAlObra) > 0
                (cAlObra)->(DbCloseArea())
            EndIf
            DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlObra, .F., .T.)
            (cAlObra)->(DbGoTop())
            If !(cAlObra)->(Eof())
                While !(cAlObra)->(Eof())

                    cLetra := u_EscapeJson((cAlObra)->ZZ2_LETRA) // Adriano 12/08/2026

                    cJSonRet := '{"OBRAS":' + CRLF
                    cJSonRet += '{"IDOBRA": "'     + AllTrim((cAlObra)->ZZ2_IDOBRA) + '", ' + CRLF
                    cJSonRet += '"CDECAD": "'      + AllTrim((cAlObra)->ZZ2_CDECAD) + '", ' + CRLF
                    cJSonRet += '"CSOCOBR": "'     + AllTrim((cAlObra)->ZZ2_CDSOCO) + '", ' + CRLF
                    cJSonRet += '"TITULO": "'      + AllTrim((cAlObra)->ZZ2_TITULO) + '", ' + CRLF
                    cJSonRet += '"NACIONAL": "'    + AllTrim((cAlObra)->ZZ2_NACION) + '", ' + CRLF
                    cJSonRet += '"INSTRUM": "'     + AllTrim((cAlObra)->ZZ2_INSTRU) + '", ' + CRLF
                    cJSonRet += '"DOMPUBLI": "'    + AllTrim((cAlObra)->ZZ2_DOMPUB) + '", ' + CRLF
                    cJSonRet += '"DTREGIST": "'    + dtoc(SToD((cAlObra)->ZZ2_DTREGI)) + '", ' + CRLF
                    cJSonRet += '"EMISSAO": "'     + dtoc(SToD((cAlObra)->ZZ2_DTEMIS)) + '", ' + CRLF
                    cJSonRet += '"DTCRIACA": "'    + dtoc(SToD((cAlObra)->ZZ2_DTCRIA)) + '", ' + CRLF
                    cJSonRet += '"CDISWC": "'      + AllTrim((cAlObra)->ZZ2_ISWC)   + '", ' + CRLF
                    cJSonRet += '"CODTIT": "'      + AllTrim((cAlObra)->ZZ2_CODTIT) + '", ' + CRLF
                    cJSonRet += '"NOMTIT": "'      + AllTrim((cAlObra)->ZZ2_NOMTIT) + '", ' + CRLF
                    cJSonRet += '"CPFCNPJTIT": "'  + AllTrim((cAlObra)->ZZ2_CGCTIT) + '", ' + CRLF
                    cJSonRet += '"ECADTIT": "'     + AllTrim((cAlObra)->ZZ2_ECATIT) + '", ' + CRLF
                    cJSonRet += '"DURACAO": "'     + AllTrim((cAlObra)->ZZ2_DURACA) + '", ' + CRLF
                    cJSonRet += '"SIGLAP": "'      + AllTrim((cAlObra)->ZZ2_SIGLAP) + '", ' + CRLF
                    cJSonRet += '"TERRIT": "'      + AllTrim((cAlObra)->ZZ2_TERRIT) + '", ' + CRLF
                    cJSonRet += '"IDGENERO": "'    + AllTrim((cAlObra)->ZZ2_GENMUS) + '", ' + CRLF
                    cJSonRet += '"GENERO": "'      + AllTrim((cAlObra)->ZZ2_GENERO) + '", ' + CRLF // AllTrim(Posicione("SX5", 1, xFilial('SX5') + "ZZ" + (cAlObra)->ZZ2_GENMUS, "X5_DESCRI")) + '", ' + CRLF
                    cJSonRet += '"REGVARSO": "'    + AllTrim((cAlObra)->ZZ2_REGVAR) + '", ' + CRLF
                    cJSonRet += '"HOMONIMA": "'    + AllTrim((cAlObra)->ZZ2_HOMONI) + '", ' + CRLF
                    cJSonRet += '"OBRADERI": "'    + AllTrim((cAlObra)->ZZ2_OBDERI) + '", ' + CRLF
                    cJSonRet += '"CDECADORI": "'   + AllTrim((cAlObra)->ZZ2_CECOOR) + '", ' + CRLF
                    cJSonRet += '"CDSOCOBRORI": "' + AllTrim((cAlObra)->ZZ2_CSOOBM) + '", ' + CRLF
                    cJSonRet += '"SIGLAIDIOMA": "' + AllTrim((cAlObra)->ZZ2_SIGIDI) + '", ' + CRLF
                    cJSonRet += '"DSSIGLAIDI": "'  + AllTrim((cAlObra)->ZZ2_IDIOMA) + '", ' + CRLF // AllTrim(Posicione("SX5", 1, xFilial('SX5') + "ZY" + (cAlObra)->ZZ2_SIGIDI, "X5_DESCRI")) + '", ' + CRLF
                    cJSonRet += '"OBRCOMPOST": "'  + AllTrim((cAlObra)->ZZ2_OBCOMP) + '", ' + CRLF
                    cJSonRet += '"TPOBRCOMPOS": "' + AllTrim((cAlObra)->ZZ2_TPOBCO) + '", ' + CRLF
                    cJSonRet += '"DSTPOBRACOM": "' + AllTrim(Posicione("SX5", 1, xFilial('SX5') + "ZW" + (cAlObra)->ZZ2_TPOBCO, "X5_DESCRI")) + '", ' + CRLF
                    cJSonRet += '"SOCRESPINF": "'  + AllTrim((cAlObra)->ZZ2_SOCRES) + '", ' + CRLF
                    cJSonRet += '"SOCRESPCAD": "'  + AllTrim((cAlObra)->ZZ2_SCRESC) + '", ' + CRLF
                    cJSonRet += '"SITCADOBRA": "'  + AllTrim((cAlObra)->ZZ2_SITCAD) + '", ' + CRLF
                    cJSonRet += '"BLOQUEADO": "'   + AllTrim((cAlObra)->ZZ2_MSBLQL) + '", ' + CRLF
                    cJSonRet += '"MOTBLOQ": "'     + AllTrim((cAlObra)->ZZ2_MOTBLQ) + '", ' + CRLF
                    cJSonRet += '"DSMOTBLQ": "'    + AllTrim(Posicione("SX5", 1, xFilial('SX5') + "ZX" + (cAlObra)->ZZ2_MOTBLQ, "X5_DESCRI")) + '", ' + CRLF
                    cJSonRet += '"DTDOCTO": "'     + dtoc(SToD((cAlObra)->ZZ2_DTDOCU)) + '", ' + CRLF
                    cJSonRet += '"EXPISWC": "'     + AllTrim((cAlObra)->ZZ2_EXISWC) + '", ' + CRLF
                    cJSonRet += '"DTULTALT": "'    + dtoc(SToD((cAlObra)->ZZ2_DTULAL)) + '", ' + CRLF
                    cJSonRet += '"IDARQ": "'       + AllTrim((cAlObra)->ZZ2_IDARQ) + '", ' + CRLF
                    cJSonRet += '"IDPASTA": "'     + AllTrim((cAlObra)->ZZ2_IDPAST)  + '", ' + CRLF
                    cJSonRet += '"PERCEST": "'     + AllTrim((cAlObra)->ZZ2_PERCES)  + '", ' + CRLF
                    cJSonRet += '"OBSERVACAO": "'  + AllTrim((cAlObra)->ZZ2_OBS)  + '", ' + CRLF
                    cJSonRet += '"LETRA": "'       + AllTrim(cLetra)  + '", ' + CRLF    // Adriano 12/08/2026
                    cJSonRet += '"STATUS": "'      + AllTrim((cAlObra)->ZZ2_STATUS)  + '", ' + CRLF
                    cJSonRet += '"PARTICIPANTES":[' + GetPartic(cIdObra, "O") + '],' + CRLF
                    cJSonRet += '"SUBTITULOS":['    + GetSubtit(cIdObra) + '],' + CRLF
                    cJSonRet += '"REFERENCIAS":['   + GetRefere(cIdObra, "O") + '],' + CRLF
                    (cAlObra)->(DbSkip())
                EndDo

                (cAlObra)->(DbCloseArea())

                cStatus = "OK"
                cMsg := "DADOS RETORNADOS COM SUCESSO."
            Else
                cStatus = "NO"
                cMsg := "OBRA NÃO ENCONTRADA."

                cJSonRet := cErro
            EndIf
        Else
            cStatus = "NO"
            cMsg := "VALOR DA TAG IDOBRA NULO OU VAZIO."

            cJSonRet := cErro
        EndIf
    Else
        cStatus = "NO"
        cMsg := "ESTRUTURA DO JSON INVÁLIDA."

        cJSonRet := cErro   
    EndIf
    cJSonRet += '"STATUS": "' + cStatus + '", ' + CRLF
    cJSonRet += '"MSG": "' + cMsg + '"}}'

    oRest:SetKeyHeaderResponse('Content-Type', 'application/json')
//    oRest:SetResponse(UPPER(cJsonRet))
    oRest:SetResponse(cJsonRet) // Adriano 12/08/2026

Return(.T.)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Monta parte do Json com os Participantes associados à obra ou fonograma
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

Static Function GetPartic(cIdObFo As Character, cTipo As Character, cColet As Character) As Character

    Local cSql     := "" As Character
    Local cAlPart  := GetNextAlias() As Character
    Local cPartic  := "" As Character
    Local cDsCateg := "" As Character
    Local cDsSubC  := "" As Character
    
    Default cColet := "N"

    if len(alltrim(cIdObFo)) > 10 .or. cTipo <> "O" // Adriano 12/08/2026
        // Busca participantes de uma obra ou fonograma
        cSql := "SELECT " + CRLF
        cSql += "    ZZ3_IDPART, " + CRLF
        cSql += "    ZZ3_IDOBRA, " + CRLF
        cSql += "    ZZ3_CODTIT, " + CRLF
        cSql += "    ZZ3_LOJATI, " + CRLF
        cSql += "    ZZ3_NMTIT, " + CRLF
        cSql += "    ZZ3_CPFCNP, " + CRLF
        cSql += "    ZZ3_CDECAD, " + CRLF
        cSql += "    ZZ3_PSEUDO, " + CRLF
        cSql += "    ZZ3_TIPO, " + CRLF
        cSql += "    ZZ3_PERCEN, " + CRLF
        cSql += "    ZZ3_CATEGO, " + CRLF
        cSql += "    ZZ3_IDSUBC, " + CRLF
        cSql += "    ZZ3_LINK, " + CRLF
        cSql += "    ZZ3_CDINST, " + CRLF
        cSql += "    ZZ3_IDFONO " + CRLF
        cSql += "FROM " + RetSqlName("ZZ3") + " ZZ3 " + CRLF
        cSql += "WHERE " + CRLF
        cSql += "    ZZ3.D_E_L_E_T_ = ' ' AND " + CRLF
        If cTipo == "O"
            cSql += "    ZZ3.ZZ3_IDOBRA = '" + cIdObFo + "' AND "        
        elseIf cTipo == "F"
            cSql += "    ZZ3.ZZ3_IDFONO = '" + cIdObFo + "' AND "        
        EndIf
        cSql += "    ZZ3.ZZ3_COLET = '" + cColet + "'"
    else
        // Busca participantes quando for obra de co-autor
        // Adriano 12/08/2026
        cSql := "SELECT " + CRLF
        cSql += "    ''         as ZZ3_IDPART, " + CRLF
        cSql += "    ZZK_CODOBR as ZZ3_IDOBRA, " + CRLF
        cSql += "    ZZK_CODPAR as ZZ3_CODTIT, " + CRLF
        cSql += "    ''         as ZZ3_LOJATI, " + CRLF
        cSql += "    (select ZZI_NOME "
        cSql += "       from "+RetSqlName("ZZI")+" ZZI "+ CRLF
        cSql += "      where ZZI.D_E_L_E_T_ = ' ' " + CRLF
        cSql += "        and ZZI.ZZI_CODIGO = ZZK.ZZK_CODPAR) as ZZ3_NMTIT, " + CRLF
        cSql += "    (select ZZI_CPF "
        cSql += "       from "+RetSqlName("ZZI")+" ZZI "+ CRLF
        cSql += "      where ZZI.D_E_L_E_T_ = ' ' " + CRLF
        cSql += "        and ZZI.ZZI_CODIGO = ZZK.ZZK_CODPAR) as ZZ3_CPFCNP, " + CRLF
        cSql += "    ''         as ZZ3_CDECAD, " + CRLF
        cSql += "    ''         as ZZ3_PSEUDO, " + CRLF
        cSql += "    ''         as ZZ3_TIPO,   " + CRLF
        cSql += "    ZZK_PERCEN as ZZ3_PERCEN, " + CRLF
        cSql += "    ZZK_CATEGO as ZZ3_CATEGO, " + CRLF
        cSql += "    ZZK_SUBCAT as ZZ3_IDSUBC, " + CRLF
        cSql += "    ZZK_LINK   as ZZ3_LINK,   " + CRLF
        cSql += "    ''         as ZZ3_CDINST, " + CRLF
        cSql += "    ''         as ZZ3_IDFONO  " + CRLF
        cSql += " FROM "+RetSqlName("ZZK")+" ZZK " + CRLF
        cSql += "WHERE ZZK.D_E_L_E_T_ = ' ' " + CRLF
        cSql += "  AND ZZK.ZZK_CODOBR = '" + cIdObFo + "' " + CRLF 
    endif
    If Select(cAlPart) > 0
        (cAlPart)->(DbCloseArea())
    EndIf
    DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlPart, .F., .T.)
    (cAlPart)->(DbGoTop())
    If !(cAlPart)->(Eof())
        While !(cAlPart)->(Eof())
            cPartic += '{"IDPART": "' + AllTrim((cAlPart)->ZZ3_IDPART) + '", ' + CRLF
            cPartic += '"CODPART": "' + AllTrim((cAlPart)->ZZ3_CODTIT) + '", ' + CRLF
            cPartic += '"LOJPART": "' + AllTrim((cAlPart)->ZZ3_LOJATI) + '", ' + CRLF
            cPartic += '"NOMPART": "' + AllTrim((cAlPart)->ZZ3_NMTIT) + '", ' + CRLF
            cPartic += '"CPFCNPJ": "' + AllTrim((cAlPart)->ZZ3_CPFCNP) + '", ' + CRLF
            cPartic += '"CDECADPART": "' + AllTrim((cAlPart)->ZZ3_CDECAD) + '", ' + CRLF
            cPartic += '"PSEUDO": "' + AllTrim((cAlPart)->ZZ3_PSEUDO) + '", ' + CRLF
            cPartic += '"TIPO": "' + AllTrim((cAlPart)->ZZ3_TIPO) + '", ' + CRLF
            cPartic += '"PERCEN": "' + CVALTOCHAR((cAlPart)->ZZ3_PERCEN) + '", ' + CRLF
            cPartic += '"IDCATEG": "' + AllTrim((cAlPart)->ZZ3_CATEGO) + '", ' + CRLF
            If AllTrim((cAlPart)->ZZ3_CATEGO) == "A"
                cDsCateg := "AUTOR"
            ElseIf AllTrim((cAlPart)->ZZ3_CATEGO) == "E"
                cDsCateg := "EDITOR"
            ElseIf AllTrim((cAlPart)->ZZ3_CATEGO) == "I"
                cDsCateg := "INTÉRPRETE"
            ElseIf AllTrim((cAlPart)->ZZ3_CATEGO) == "MA"
                cDsCateg := "MÚSICO EXECUTANTE"
            ElseIf AllTrim((cAlPart)->ZZ3_CATEGO) == "PF"
                cDsCateg := "PRODUTOR FONOGRÁFICO"
            EndIf
            cPartic += '"DSCATEG": "' + cDsCateg + '", ' + CRLF
            cPartic += '"IDCATEGAUT": "' + AllTrim((cAlPart)->ZZ3_IDSUBC) + '", ' + CRLF // Id da Subcategoria
            cDsSubC := AllTrim(Posicione("SX5", 1, xFilial('SX5') + "ZC" + (cAlPart)->ZZ3_IDSUBC, "X5_DESCRI"))
            cPartic += '"DSCATEGAUT": "' + cDsSubC + '", ' + CRLF // Descrição da Subcategoria
            If cTipo == "F" .and. cColet == "N"
                cPartic += '"CDINSTRUMENTO": "' + AllTrim((cAlPart)->ZZ3_CDINST) + '", ' + CRLF
            endif
            cPartic += '"LINK": "' + AllTrim((cAlPart)->ZZ3_LINK) + '"}, '

            (cAlPart)->(DbSkip())
        EndDo

        (cAlPart)->(DbCloseArea())
    EndIf

    cPartic := AllTrim(cPartic)
    cPartic := SubStr(cPartic, 1, Len(cPartic) - 1)

Return(cPartic)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Monta parte do Json com os Subtitulos associados à obra
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

Static Function GetSubtit(cIdObra As Character) As Character

    Local cSql    := "" As Character
    Local cAlSubt := GetNextAlias() As Character
    Local cSubtit := "" As Character

    cSql := "SELECT " + CRLF
    cSql += "    ZZ6_CDECAD, " + CRLF
    cSql += "    ZZ6_CDSOCU, " + CRLF
    cSql += "    ZZ6_TPTITU, " + CRLF
    cSql += "    ZZ6_TIPTIT, " + CRLF
    cSql += "    ZZ6_NMOUTR, " + CRLF
    cSql += "    ZZ6_SITSUB " + CRLF
    cSql += "FROM " + RetSqlName("ZZ6") + " ZZ6 " + CRLF
    cSql += "WHERE " + CRLF
    cSql += "    ZZ6.D_E_L_E_T_ = ' ' AND " + CRLF
    cSql += "    ZZ6.ZZ6_IDOBRA = '" + cIdObra + "'"        
    If Select(cAlSubt) > 0
        (cAlSubt)->(DbCloseArea())
    EndIf
    DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlSubt, .F., .T.)
    (cAlSubt)->(DbGoTop())
    If !(cAlSubt)->(Eof())
        While !(cAlSubt)->(Eof())
            cSubtit += '{"CDECADOBRA": "' + AllTrim((cAlSubt)->ZZ6_CDECAD) + '", ' + CRLF
            cSubtit += '"CDSOCSUB": "' + AllTrim((cAlSubt)->ZZ6_CDSOCU) + '", ' + CRLF
            cSubtit += '"IDTPTITULO": "' + AllTrim((cAlSubt)->ZZ6_TPTITU) + '", ' + CRLF
            cSubtit += '"DSTPTITULO": "' + AllTrim((cAlSubt)->ZZ6_TIPTIT) + '", ' + CRLF // AllTrim(Posicione("SX5", 1, xFilial('SX5') + "ZD" + (cAlSubt)->ZZ6_TPTITU, "X5_DESCRI")) + '", ' + CRLF
            cSubtit += '"NOMEOUTRO": "' + AllTrim((cAlSubt)->ZZ6_NMOUTR) + '", ' + CRLF
            cSubtit += '"SITSUB": "' + AllTrim((cAlSubt)->ZZ6_SITSUB) + '"}, '

            (cAlSubt)->(DbSkip())
        EndDo

        (cAlSubt)->(DbCloseArea())
    EndIf

    cSubtit := AllTrim(cSubtit)
    cSubtit := SubStr(cSubtit, 1, Len(cSubtit) - 1)

Return(cSubtit)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Monta parte do Json com os Referências associadas à obra ou fonograma
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

Static Function GetRefere(cIdObFo As Character, cTipo As Character) As Character

    Local cSql    := "" As Character
    Local cAlRefe := GetNextAlias() As Character
    Local cRefere := "" As Character

    cSql := "SELECT " + CRLF
    cSql += "    ZZ7_CDECAD, " + CRLF
    cSql += "    ZZ7_CDSOCI, " + CRLF
    cSql += "    ZZ7_DESCRI, " + CRLF
    cSql += "    ZZ7_TPCATE, " + CRLF
    cSql += "    ZZ7_ECADFO " + CRLF
    cSql += "FROM " + RetSqlName("ZZ7") + " ZZ7 " + CRLF
    cSql += "WHERE " + CRLF
    cSql += "    ZZ7.D_E_L_E_T_ = ' ' AND " + CRLF
    If cTipo == "O"
        cSql += "    ZZ7.ZZ7_IDOBRA = '" + cIdObFo + "'"        
    elseIf cTipo == "F"
        cSql += "    ZZ7.ZZ7_IDFONO = '" + cIdObFo + "'"        
    EndIf
    If Select(cAlRefe) > 0
        (cAlRefe)->(DbCloseArea())
    EndIf
    DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlRefe, .F., .T.)
    (cAlRefe)->(DbGoTop())
    If !(cAlRefe)->(Eof())
        While !(cAlRefe)->(Eof())
            cRefere += '{"CDECADOBRA": "' + AllTrim((cAlRefe)->ZZ7_CDECAD) + '", ' + CRLF
            cRefere += '"CDSOCREF": "' + AllTrim((cAlRefe)->ZZ7_CDSOCI) + '", ' + CRLF
            cRefere += '"DESCRICAO": "' + AllTrim((cAlRefe)->ZZ7_DESCRI) + '", ' + CRLF
            cRefere += '"IDTIPOCATEG": "' + AllTrim((cAlRefe)->ZZ7_TPCATE) + '", ' + CRLF
            cDsCateg := ""
            If AllTrim((cAlRefe)->ZZ7_TPCATE) == "A"
                cDsCateg := "AUTOR"
            ElseIf AllTrim((cAlRefe)->ZZ7_TPCATE) == "C"
                cDsCateg := "COMPOSITOR"
            ElseIf AllTrim((cAlRefe)->ZZ7_TPCATE) == "G"
                cDsCateg := "GRAVADORA"
            ElseIf AllTrim((cAlRefe)->ZZ7_TPCATE) == "I"
                cDsCateg := "INTÉRPRETE"
            ElseIf AllTrim((cAlRefe)->ZZ7_TPCATE) == "O"
                cDsCateg := "OUTROS"
            ElseIf AllTrim((cAlRefe)->ZZ7_TPCATE) == "P"
                cDsCateg := "PROGRAMA"
            ElseIf AllTrim((cAlRefe)->ZZ7_TPCATE) == "R"
                cDsCateg := "ISRC"
            ElseIf AllTrim((cAlRefe)->ZZ7_TPCATE) == "S"
                cDsCateg := "VERSIONISTA"
            ElseIf AllTrim((cAlRefe)->ZZ7_TPCATE) == "V"
                cDsCateg := "AUDIOVISUAL"
            ElseIf AllTrim((cAlRefe)->ZZ7_TPCATE) == "X"
                cDsCateg := "COLETIVO"
            EndIf
            cRefere += '"DSTIPOCATEG": "' + cDsCateg + '", ' + CRLF                 
            cRefere += '"CDECADFONO": "' + AllTrim((cAlRefe)->ZZ7_ECADFO) + '"}, '

            (cAlRefe)->(DbSkip())
        EndDo

        (cAlRefe)->(DbCloseArea())
    EndIf

    cRefere := AllTrim(cRefere)
    cRefere := SubStr(cRefere, 1, Len(cRefere) - 1)

Return(cRefere)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Monta parte do Json com os Coletivos associados ao fonograma
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

Static Function GetColeti(cIdFono As Character) As Character

    Local cSql    := "" As Character
    Local cAlCole := GetNextAlias() As Character
    Local cColeti := "" As Character

    cSql := "SELECT " + CRLF
    cSql += "    ZZ5_IDCOLE, " + CRLF
    cSql += "    ZZ5_CDECAD, " + CRLF
    cSql += "    ZZ5_CDSOCO, " + CRLF
    cSql += "    ZZ5_SIGPAI, " + CRLF
    cSql += "    ZZ5_TPCOLE, " + CRLF
    cSql += "    ZZ5_TIPCOL, " + CRLF
    cSql += "    ZZ5_NMCOLE, " + CRLF
    cSql += "    ZZ5_NACION, " + CRLF
    cSql += "    ZZ5_CODCAE, " + CRLF
    cSql += "    ZZ5_NMPSCO, " + CRLF
    cSql += "    ZZ5_DSCOMP, " + CRLF
    cSql += "    ZZ5_DTUALT, " + CRLF
    cSql += "    ZZ5_ECADFO " + CRLF
    cSql += "FROM " + RetSqlName("ZZ5") + " ZZ5 " + CRLF
    cSql += "WHERE " + CRLF
    cSql += "    ZZ5.D_E_L_E_T_ = ' ' AND " + CRLF
    cSql += "    ZZ5.ZZ5_IDFONO = '" + cIdFono + "'"        
    If Select(cAlCole) > 0
        (cAlCole)->(DbCloseArea())
    EndIf
    DbUseArea(.T., 'TOPCONN', TCGENQRY(,, cSql), cAlCole, .F., .T.)
    (cAlCole)->(DbGoTop())
    If !(cAlCole)->(Eof())
        While !(cAlCole)->(Eof())
            cColeti += '{"IDCOLET": "' + AllTrim((cAlCole)->ZZ5_IDCOLE) + '", ' + CRLF
            cColeti += '"CDECADCOLET": "' + AllTrim((cAlCole)->ZZ5_CDECAD) + '", ' + CRLF
            cColeti += '"CODSOCCOLET": "' + AllTrim((cAlCole)->ZZ5_CDSOCO) + '", ' + CRLF
            cColeti += '"SIGPAICOLET": "' + AllTrim((cAlCole)->ZZ5_SIGPAI) + '", ' + CRLF
            cColeti += '"TPCOLET": "' + AllTrim((cAlCole)->ZZ5_TPCOLE) + '", ' + CRLF
            cColeti += '"DESCTPCOLET": "' + AllTrim((cAlCole)->ZZ5_TIPCOL) + '", ' + CRLF
            cColeti += '"NMCOLET": "' + AllTrim((cAlCole)->ZZ5_NMCOLE) + '", ' + CRLF
            cColeti += '"CODCAECOLET": "' + AllTrim((cAlCole)->ZZ5_CODCAE) + '", ' + CRLF
            cColeti += '"NMPSEUDCOLET": "' + AllTrim((cAlCole)->ZZ5_NMPSCO) + '", ' + CRLF
            cColeti += '"DSCOMPLEM": "' + AllTrim((cAlCole)->ZZ5_DSCOMP) + '", ' + CRLF
            cColeti += '"DTULTALTER": "' + AllTrim((cAlCole)->ZZ5_DTUALT) + '", ' + CRLF
            cColeti += '"CDECADFONO": "' + AllTrim((cAlCole)->ZZ5_ECADFO) + '"}, '

            (cAlCole)->(DbSkip())
        EndDo

        (cAlCole)->(DbCloseArea())
    EndIf

    cColeti := AllTrim(cColeti)
    cColeti := SubStr(cColeti, 1, Len(cColeti) - 1)

Return(cColeti)

/* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ *
Data   : 09/04/2023
Descr. : Integração permite operações de Inclusão, Alteração e Exclusão de Fonogramas
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ */

@Post("/sbcrudfo")
User Function sbcrudfo() As Logical

    Local cOper     := "" As Character
    Local jBody     := JsonObject():New() As Json
    Local cJSonRet  := "" As Character      
    Local cTitulo  := "" As Character
    Local cCDArr    := "" As Character// ZZ4_CDARRA	Cod Arranjo 	Código do Arranjo        
    Local cCDCow    := "" As Character// ZZ4_CDCROW	Cod Crowley 	Código Crowley           
    Local cCdEcaPP  := "" As Character// ZZ4_CDECPO	Cd Ecad Pout	Código Ecad Pout Pourrit 
    Local cCdEcad   := "" As Character // ZZ4_CODECA	Codigo Ecad 	Codigo Ecad      
    Local cNac      := "" As Character //ZZ4_NACION	É Nacional? 	É Nacional? 
    Local cInstru   := "" As Character //ZZ4_INSTRU	Instrumental	Instrumental?  
    Local cCdGEnMu  := "" As Character// ZZ4_CDGENM	Cod Gen Musc	Código Gênero Musical    
    Local cCDGRA    := "" As Character// ZZ4_CDGRA 	Código GRA  	Código GRA               
    Local cCDISRC   := "" As Character// ZZ4_CDISRC	Código ISRC 	Código ISRC              
    Local cCDPacte  := "" As Character// ZZ4_CDPACO	Cod Pacote  	Código do Pacote         
    Local cCDSelo   := "" As Character// ZZ4_CDSELO	Cod Selo    	Código do Selo           
    Local cCDSobr   := "" As Character// ZZ4_CDSOBR	Cd Soc Obra 	Código Societário Obra   
    Local cCDSoci   := "" As Character// ZZ4_CDSOCI	Cd Societari	Código Societário        
    Local cCDSpou   := "" As Character// ZZ4_CDSPOU	Cd Soc Pout 	Cód Societário P Pourrit 
    Local cClasFono := "" As Character// ZZ4_CLFONO	Class Fonogr	Classificação Fonograma  
    Local cCDAgreg  := "" As Character// ZZ4_CODAGR	Cd Agregador	Código da Agregadora        
    Local cDomPubl  := "" As Character// ZZ4_DOMPUB	Domínio Públ	Domínio Público          
    Local cDescCArr := "" As Character// ZZ4_DSCARR	Ds Compl Arr	Descrição Compl Arranjo  
    Local cDuracao  := "" As Character// ZZ4_DURACA	Duração     	Duração                  
    Local cCDEcaObr := "" As Character// ZZ4_ECOBRA	Cd Ecad Obra	Código Ecad Obra Musical 
    Local cFonPend  := "" As Character// ZZ4_FONPIF	Fon Pend I F	É Fonog Pend Incl Ficha? 
    Local cFonTAud  := "" As Character// ZZ4_FONTAU	Tem Áudio?  	Fonograma tem Áudio?     
    Local cIdColet  := "" As Character// ZZ4_IDCOLE	Id Coletivo 	Id do Coletivo           
    Local cMotBlq   := "" As Character// ZZ4_MOTBLQ	Mot Bloqueio	Motivo de Bloqueio       
    Local cPublSim  := "" As Character// ZZ4_PUBSIM	Pub Simult? 	É Publicação Simultânea? 
    Local cRotMusAc := "" As Character// ZZ4_ROTMUA	Rot Mus Acom	Rót Músico Acomp?        
    Local cRotulo   := "" As Character// ZZ4_ROTULO	É Rótulo?   	É Rótulo?                
    Local cSiglaPa  := "" As Character// ZZ4_SIGLPA	Sigla País  	Sigla do País            
    Local cSglaPPub := "" As Character// ZZ4_SIPPUB	Sig País Pub	Sigla País Publicação    
    Local cTipMidia := "" As Character// ZZ4_TPMIDI	Tipo Midia  	Tipo de Mídia    
    Local cStatus  	:= ""  As Character
    Local cObs    	:= "" AS Character
    Local cMsg      := ""  As Character
    //Local lErro   := .F. As Logical
    Local cDsOper   := ""  As Character
    Local cIdFono   := ""  As Character //ZZ4_IDFONO	Id Fonograma	Id Fonograma   
//    Local nCont     := 0   As Integer
//    Local nTot      := 0   As Integer
    Local dGravaArq := CtoD("  /  /  ") As Date
    Local dEmisArq  := CtoD("  /  /  ") As Date
    Local dLancArq  := CtoD("  /  /  ") As Date
    Local cIdPasta  := ""  As Character 

    /*
    {
    "OPER":"I",
    "idFono":"0",
    "codigoECAD":"",
    "codigoISRC":"12",
    "obsFonograma":"teste",
    "idObra":"1",
    "titulo":"Meu Amor",
    "nacional":"S",
    "publiSimultanea":"N",
    "instrumental":"N",
    "idTerritorio":"BR",
    "territorio":"BRASIL",
    "publicacao":"TESTE",
    "idGenero":"80",
    "genero":"POP MUSIC",
    "duracaoArquivo":"00:12:00",
    "idTipoMidia":"1",
    "tipoMidia":"CD",
    "idClassificacao":"544",
    "classificacao":"TRILHA",
    "idCodigoPacote":"110",
    "pacote":"KILLER ANIMATION",
    "idArranjo":"11",
    "arranjo":"TRISTE",
    "descComplArranArquivo":"TESTE",
    "dtGravacaoOriArquivo":"29/08/2023",
    "dtEmissaoArquivo":"29/08/2023",
    "dtLancamentoArquivo":"29/08/2023",
    "idArquivo":"",
    "idPasta":"",
    "participantes":[
        {
            "codigo":0,
            "nome":"RENNAN AILTON DA SILVA COSTA",
            "cpfCnpj":"71086689470",
            "pseudonimo":"",
            "tipoSbacem":"T",
            "tipoPessoa":"F",
            "percentual":41.7,
            "cdCateg":"PF",
            "cdCategAut":"PF",
            "categAut":"PRODUTOR FONOGRÁFICO",
            "codECAD":"20338847",
            "link": "001"
        },
        {
            "codigo":0,
            "nome":"LEANDRO GALVAO DE OLIVEIRA AVILA",
            "cpfCnpj":"00004611136",
            "pseudonimo":"",
            "tipoSbacem":"T",
            "tipoPessoa":"F",
            "percentual":41.7,
            "cdCateg":"I",
            "cdCategAut":"I",
            "categAut":"INTERPRETE",
            "codECAD":"1288542",
            "link": "001"
        },
        {
            "codigo":0,
            "nome":"MARCOS MARCELO SANTOS SILVA",
            "cpfCnpj":"00003981525",
            "pseudonimo":"",
            "tipoSbacem":"T",
            "tipoPessoa":"F",
            "percentual":16.6,
            "cdCateg":"MA",
            "cdCategAut":"MA",
            "categAut":"MÚSICO EXECUTANTE",
            "codECAD":"1765220",
            "link": "001"
        }
    ],
    "nomeColetivo":"BANDINHA",
    "cdTipoColetivo":"1",
    "coletivoNacional":"S",
    "participantesColetivo":[
        {
            "nome":"PARTICIPANTE",
            "cpfCnpj":"00000000000",
            "pseudonimo":"TESTE",
            "tipoSbacem":"P",
            "tipoPessoa":"F"
        }
    ]
    }
    */

    jBody:fromJson(oRest:GetBodyRequest())
    If jBody <> Nil
        cIdFono     := jBody:GetJsonText("IDFONO")
        cTitulo     := jBody:GetJsonText("TITULO")
        cCdEcad     := jBody:GetJsonText("CODIGOECAD")
        cCDISRC		:= jBody:GetJsonText("CODIGOISRC")
        cCDEcaObr   := Posicione("ZZ2", 1, xFilial("ZZ2") + AllTrim(jBody:GetJsonText("IDOBRA")), "ZZ2_IDOBRA")
        cCDSobr     := Posicione("ZZ2", 1, xFilial("ZZ2") + AllTrim(jBody:GetJsonText("IDOBRA")), "ZZ2_CDSOCO	")
        cInstru     := jBody:GetJsonText("INSTRUMENTAL")
        cObs     	:= jBody:GetJsonText("OBSFONOGRAMA")
        cNac        := jBody:GetJsonText("NACIONAL")
        cSiglaPa    := jBody:GetJsonText("IDTERRITORIO")
        cCdGEnMu    := jBody:GetJsonText("IDGENERO")
        cDuracao    := jBody:GetJsonText("DURACAOARQUIVO")
        cClasFono   := jBody:GetJsonText("IDCLASSIFICACAO")//
        cSglaPPub   := jBody:GetJsonText("IDTERRITORIO")
        cTipMidia   := jBody:GetJsonText("IDTIPOMIDIA")
        cPublSim    := jBody:GetJsonText("PUBLISIMULTANEA")
        cCDArr      := jBody:GetJsonText("IDARRANJO")
        cDescCArr   := jBody:GetJsonText("ARRANJO")
        cOper       := jBody:GetJsonText("OPER")
        cCDPacte    := jBody:GetJsonText("IDCODIGOPACOTE")
        cIdPasta	:= jBody:GetJsonText("IDPASTA")
        dGravaArq	:= StoD(jBody:GetJsonText("DTGRAVACAOORIARQUIVO"))
        dEmisArq	:= StoD(jBody:GetJsonText("DTEMISSAOARQUIVO"))
        dLancArq	:= StoD(jBody:GetJsonText("DTLANCAMENTOARQUIVO"))

        If CheckVar(cOper)
            If cIdFono == "0"
                cIdFono := "0000000000000"
            Endif
            BEGIN TRANSACTION
                //if !dbSeek(xFilial("ZZ4")+cIdFono) .AND. cOper == "I"
                if cOper == "I"
                    cDsOper := "INCLUIR"
                    dbSelectArea("ZZ4")
                    ZZ4->(dbSetOrder(1))
                    //if !ZZ4->(dbSeek(xFilial("ZZ4")+cIdFono))
                        //conout("entrei4")

                        // Cria uma novo FONOGRAMA
                        cIdFono := GetSxeNum("ZZ4", "ZZ4_IDFONO")
                        Reclock("ZZ4", .T.)
                        ZZ4->ZZ4_FILIAL := xFilial("ZZ4")
                        ZZ4->ZZ4_IDFONO := cIdFono
                        ZZ4->ZZ4_CODECA := PadL(cCdEcad, TamSX3("ZZ4_CODECA")[1], '0')
                        ZZ4->ZZ4_CDSOCI := cCDSoci
                        ZZ4->ZZ4_ECOBRA := cCDEcaObr
                        ZZ4->ZZ4_CDSOBR := cCDSobr
                        ZZ4->ZZ4_CDECPO := cCdEcaPP
                        ZZ4->ZZ4_CDSPOU := cCDSpou
                        ZZ4->ZZ4_CDGRA  := cCDGRA
                        ZZ4->ZZ4_CDISRC := cCDISRC
                        ZZ4->ZZ4_CODTIT := jBody:GetJsonText("CODIGOTITULAR")
                        ZZ4->ZZ4_NOMTIT := jBody:GetJsonText("NOMETITULAR")
                        ZZ4->ZZ4_CGCTIT := jBody:GetJsonText("CPFCNPJTITULAR")
                        ZZ4->ZZ4_ECATIT := jBody:GetJsonText("CODIGOECADTITULAR")
                        ZZ4->ZZ4_DTGROR := dDatabase // dGravaArq
                        ZZ4->ZZ4_DTLANC := dDatabase // dLancArq
                        ZZ4->ZZ4_DTEMIS := dDatabase // dEmisArq
                        ZZ4->ZZ4_INSTRU := cInstru
                        ZZ4->ZZ4_DURACA := CDURACAO
                        ZZ4->ZZ4_CDCROW := cCDCow
                        ZZ4->ZZ4_NACION := cNac
                        ZZ4->ZZ4_SIGLPA := cSiglaPa
                        ZZ4->ZZ4_CDGENM := cCdGEnMu
                        ZZ4->ZZ4_CLFONO := cClasFono
                        ZZ4->ZZ4_CDSELO := cCDSelo
                        ZZ4->ZZ4_IDCOLE := cIdColet
                        ZZ4->ZZ4_SIPPUB := cSglaPPub
                        ZZ4->ZZ4_ROTULO := cRotulo
                        ZZ4->ZZ4_TPMIDI := cTipMidia
                        ZZ4->ZZ4_BLOQUE := "N"
                        ZZ4->ZZ4_MOTBLQ := cMotBlq
                        ZZ4->ZZ4_SITCAD := "V"
                        ZZ4->ZZ4_PUBSIM := cPublSim
                        ZZ4->ZZ4_DOMPUB := cDomPubl
                        ZZ4->ZZ4_DTDOCU := dDatabase // dDatabase
                        ZZ4->ZZ4_DTUALT := dDataBase
                        ZZ4->ZZ4_ROTMUA := cRotMusAc
                        ZZ4->ZZ4_CDARRA := cCDArr
                        ZZ4->ZZ4_DSCARR := cDescCArr
                        ZZ4->ZZ4_CDPACO := cCDPacte
                        ZZ4->ZZ4_FONPIF := cFonPend
                        ZZ4->ZZ4_FONTAU := cFonTAud
                        ZZ4->ZZ4_CODAGR := cCDAgreg
                        ZZ4->ZZ4_OBS 	:= cObs
                        ZZ4->ZZ4_IDPAST := cIdPasta
                        ZZ4->ZZ4_TITULO := cTitulo
                        ZZ4->ZZ4_TERRIT := jBody:GetJsonText("TERRITORIO")
                        ZZ4->ZZ4_GENERO := jBody:GetJsonText("GENERO")
                        ZZ4->ZZ4_PUBLIC := jBody:GetJsonText("PUBLICACAO")
                        ZZ4->ZZ4_CLASSI := jBody:GetJsonText("CLASSIFICACAO")
                        ZZ4->ZZ4_TIPMID := jBody:GetJsonText("TIPOMIDIA")
                        ZZ4->ZZ4_PACOTE := jBody:GetJsonText("PACOTE")
                        ZZ4->ZZ4_IDARQU := jBody:GetJsonText("IDARQUIVO")
                        ZZ4->(MsUnlock())
                        ZZ4->(ConfirmSx8())

                        // Inclusão de Participantes
                        cIdPartic := IADPartic(cOper, jBody["PARTICIPANTES"], , cIdFono)

                        /*
                        if jBody["PARTICIPANTES"] == Nil
                            nTot := 0
                        else
                            nTot := Len(jBody["PARTICIPANTES"])
                        endif
                        For nCont := 1 To nTot
                            codigoECAD :=PADL(jBody["PARTICIPANTES"][nCont]["CODIGOECAD"], TamSX3("ZZ3_CDECAD")[1], '0')
                            DbSelectArea("ZZ3")
                            ZZ3->(DbSetOrder(3)) // INDICE DE BUSCA É PELO ECAD NESSE CASO POIS ELE PODE PARTICIPAR DA OBRA TBEM. AI ALTERO E INCLUO O ID FONOGRAMA
                            RecLock("ZZ3", .T.)
                            ZZ3->ZZ3_FILIAL := xFilial("ZZ3")
                            ZZ3->ZZ3_IDPART := GetSxeNum("ZZ3", "ZZ3_IDPART")
                            ZZ3->ZZ3_IDFONO 	:= cIdFono
                            ZZ3->ZZ3_CODTIT := Posicione("SA2", 3, xFilial("SA2") + AllTrim(jBody["PARTICIPANTES"][nCont]["CPFCNPJ"]), "A2_COD")
                            ZZ3->ZZ3_LOJATI := Posicione("SA2", 3, xFilial("SA2") + AllTrim(jBody["PARTICIPANTES"][nCont]["CPFCNPJ"]), "A2_LOJA")
                            ZZ3->ZZ3_NMTIT  := jBody["PARTICIPANTES"][nCont]["NOME"]
                            ZZ3->ZZ3_CPFCNP := jBody["PARTICIPANTES"][nCont]["CPFCNPJ"]
                            ZZ3->ZZ3_CDECAD := codigoECAD
                            ZZ3->ZZ3_PSEUDO := jBody["PARTICIPANTES"][nCont]["PSEUDONIMO"]
                            ZZ3->ZZ3_TIPO   := jBody["PARTICIPANTES"][nCont]["TIPOSBACEM"]
                            ZZ3->ZZ3_PERCEN := jBody["PARTICIPANTES"][nCont]["PERCENTUAL"]
                            ZZ3->ZZ3_CATEGO := jBody["PARTICIPANTES"][nCont]["CDCATEG"]
                            ZZ3->ZZ3_LINK   := jBody["PARTICIPANTES"][nCont]["LINK"]
                            ZZ3->ZZ3_CDINST := jBody["PARTICIPANTES"][nCont]["CODINSTRUMENTO"]
                            ZZ3->(MsUnlock())
                            ZZ3->(ConfirmSx8())
                        Next nCont
                        */

                        // Inclusão de Participantes Coletivo
                        cIdPartic := IADPartic(cOper, jBody["PARTICIPANTESCOLETIVO"], , cIdFono, "S")

                        /*
                        if jBody["PARTICIPANTESCOLETIVO"] == Nil
                            nTot := 0
                        else
                            nTot := Len(jBody["PARTICIPANTESCOLETIVO"])
                        endif
                        For nCont := 1 To nTot
                            codigoECAD :=PADL(jBody["PARTICIPANTESCOLETIVO"][nCont]["CODIGOECAD"], TamSX3("ZZ3_CDECAD")[1], '0')
                            DbSelectArea("ZZ3")
                            DbSetOrder(3) // INDICE DE BUSCA É PELO ECAD NESSE CASO POIS ELE PODE PARTICIPAR DA OBRA TBEM. AI ALTERO E INCLUO O ID FONOGRAMA
                            RecLock("ZZ3", .T.)
                            ZZ3->ZZ3_FILIAL := xFilial("ZZ3")
                            ZZ3->ZZ3_IDPART := GetSxeNum("ZZ3", "ZZ3_IDPART")
                            ZZ3->ZZ3_IDFONO 	:= cIdFono
                            ZZ3->ZZ3_CODTIT := Posicione("SA2", 3, xFilial("SA2") + AllTrim(jBody["PARTICIPANTESCOLETIVO"][nCont]["CPFCNPJ"]), "A2_COD")
                            ZZ3->ZZ3_LOJATI := Posicione("SA2", 3, xFilial("SA2") + AllTrim(jBody["PARTICIPANTESCOLETIVO"][nCont]["CPFCNPJ"]), "A2_LOJA")
                            ZZ3->ZZ3_NMTIT  := jBody["PARTICIPANTESCOLETIVO"][nCont]["NOME"]
                            ZZ3->ZZ3_CPFCNP := jBody["PARTICIPANTESCOLETIVO"][nCont]["CPFCNPJ"]
                            ZZ3->ZZ3_CDECAD := codigoECAD
                            ZZ3->ZZ3_PSEUDO := jBody["PARTICIPANTESCOLETIVO"][nCont]["PSEUDONIMO"]
                            ZZ3->ZZ3_TIPO   := jBody["PARTICIPANTESCOLETIVO"][nCont]["TIPOSBACEM"]
                            ZZ3->ZZ3_PERCEN := jBody["PARTICIPANTESCOLETIVO"][nCont]["PERCENTUAL"]
                            ZZ3->ZZ3_CATEGO := jBody["PARTICIPANTESCOLETIVO"][nCont]["CDCATEG"]
                            ZZ3->ZZ3_LINK   := jBody["PARTICIPANTESCOLETIVO"][nCont]["LINK"]
                            ZZ3->(MsUnlock())
                            ZZ3->(ConfirmSx8())
                        Next nCont
                        */

                        dbSelectArea("ZZ5")
                        ZZ5->(dbSetOrder(3))
                        RecLock("ZZ5", .T.)
                        ZZ5->ZZ5_FILIAL := xFilial("ZZ5")
                        ZZ5->ZZ5_IDFONO := cIdFono
                        ZZ5->ZZ5_IDCOLE := GetSxeNum("ZZ5", "ZZ5_IDCOLE")
                        ZZ5->ZZ5_CDECAD := ""//PADL(jBody["coletivo"][nCont]["ECADCole"], TamSX3("ZZ5_CDECAD")[1], '0')
                        ZZ5->ZZ5_CDSOCO := ""//jBody["coletivo"][nCont]["idSocCol"]
                        ZZ5->ZZ5_SIGPAI := ""//jBody["coletivo"][nCont]["siglaPCole"]
                        ZZ5->ZZ5_TPCOLE := jBody:GetJsonText("CDTIPOCOLETIVO")//jBody["coletivo"][nCont]["tipoCole"]
                        ZZ5->ZZ5_NMCOLE := jBody:GetJsonText("NOMECOLETIVO")//jBody["coletivo"][nCont]["nomeCole"]
                        ZZ5->ZZ5_NACION := jBody:GetJsonText("COLETIVONACIONAL")//jBody["coletivo"][nCont]["nacional"]
                        ZZ5->ZZ5_CODCAE := ""//jBody["coletivo"][nCont]["idCAE"]
                        ZZ5->ZZ5_NMPSCO := ""//jBody["coletivo"][nCont]["pseudonimo"]
                        ZZ5->ZZ5_DSCOMP := ""//jBody["coletivo"][nCont]["descricao"]
                        ZZ5->ZZ5_TIPCOL := jBody:GetJsonText("TIPOCOLETIVO")
                        ZZ5->ZZ5_DTUALT := DDATABASE
                        ZZ5->(MsUnlock())
                        ZZ5->(ConfirmSx8())

                        // Inclusão de Referências
                        IADRefere(cOper, jBody["REFERENCIAS"], , cIdFono)

                        /*
                        if jBody["REFERENCIAS"] == Nil
                            nTot := 0
                        else
                            nTot := Len(jBody["REFERENCIAS"])
                        endif
                        For nCont := 1 To nTot
                            dbSelectArea("ZZ7")
                            dbSetOrder(2)
                            RecLock("ZZ7", .T.)
                            ZZ7->ZZ7_FILIAL := xFilial("ZZ7")
                            ZZ7->ZZ7_IDFONO := cIdFono
                            ZZ7->ZZ7_ECADFO := PadL(cCdEcad, TamSX3("ZZ4_CODECA")[1], '0')
                            ZZ7->ZZ7_CDSOCI := ""
                            ZZ7->ZZ7_TPCATE := ""//jBody["referencias"][nCont]["cdCateg"]
                            ZZ7->ZZ7_DESCRI := ""//jBody["referencias"][nCont]["categAut"]
                            ZZ7->(MsUnlock())
                        Next nCont
                        */

                        cStatus := "OK"
                        cMsg    := "INCLUSÃO DO NOVO FONOGRAMA EXECUTADO COM SUCESSO!"
                    /*
                    else
                        cStatus := "NO"
                        cMsg    := "FONOGRAMA JÁ CADASTRADO!"
                    endif
                    */
                ELSEIF cOper == "A" // ALTERAR EPV
                    cDsOper := "ALTERAR"
                    dbSelectArea("ZZ4")
                    ZZ4->(dbSetOrder(1))
                    iF ZZ4->(dbSeek(xFilial("ZZ4")+cIdFono))
                        /*
                        cSql := " UPDATE " + RetSqlName("ZZ4") + " " + CRLF
                        cSql += " SET " + CRLF
                        cCdEcad	:= PadL(cCdEcad, TamSX3("ZZ4_CODECA")[1], '0')

                        iif(!empty(cCDEcaObr),cSql += " ZZ4_ECOBRA  = '"+ cCDEcaObr	+"'    , " + CRLF,"")
                        iif(!empty(cInstru),cSql += " ZZ4_INSTRU  = '"+ cInstru		+"'    , " + CRLF,"")
                        iif(!empty(cNac),cSql += " ZZ4_NACION  = '"+ cNac		+"'    , " + CRLF,"")
                        iif(!empty(cSiglaPa),cSql += " ZZ4_SIGLPA  = '"+ cSiglaPa	+"'    , " + CRLF,"")
                        iif(!empty(cCdGEnMu),cSql += " ZZ4_CDGENM  = '"+ cCdGEnMu	+"'    , " + CRLF,"")
