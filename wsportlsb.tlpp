                            cSql += " ZZ3_CPFCNP = '" + jBody["participantes"][nCont]["cpfCnpj"] + "'," + CRLF
                            cSql += " ZZ3_PSEUDO = '"  +jBody["participantes"][nCont]["pseudonimo"] + "', " + CRLF
                            cSql += " ZZ3_TIPO   = '" +jBody["participantes"][nCont]["tipoSbacem"] + "', " + CRLF
                            cSql += " ZZ3_PERCEN = '" + cValtoChar(jBody["participantes"][nCont]["percentual"]) + "', " + CRLF
                            cSql += " ZZ3_CATEGO = '" + cvaltochar(jBody["participantes"][nCont]["cdCategAut"]) + "', " + CRLF
                            cSql += " ZZ3_LINK = '" + cvaltochar(jBody["participantes"][nCont]["link"]) + "' " + CRLF
                            cSql += "WHERE " + CRLF
                            cSql += "    ZZ3_FILIAL = '" + xFilial("ZZ3") + "' AND " + CRLF
                            cSql += "    ZZ3_IDFONO = '" + cIdFono + "' AND " + CRLF
                            cSql += "    ZZ3_CDECAD = '" + codigoECAD + "' AND " + CRLF
